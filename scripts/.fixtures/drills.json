      "page_title": "JOIN Queries (Q61-Q75)", "subtitle": "Queries 61 - 75", "aside": "practice makes perfect",
      "blocks": [
        { "type": "heading", "text": "Q61. Employees with manager" },
        { "type": "code", "lang": "sql", "lines": ["SELECT e.name, m.name AS boss", "FROM emp e JOIN emp m", "  ON e.mgr_id = m.id;"], "result": { "headers": ["name", "boss"], "rows": [["Ram", "Ajay"], ["Riya", "Neha"], ["Amit", "Ajay"]] } },
        { "type": "heading", "text": "Q62. Customers without orders" },
        { "type": "code", "lang": "sql", "lines": ["SELECT c.id, c.name", "FROM customers c", "LEFT JOIN orders o ON c.id = o.cid", "WHERE o.id IS NULL;"], "result": { "headers": ["id", "name"], "rows": [["105", "Pankaj"], ["106", "Sneha"]] } },
        { "type": "heading", "text": "Q63. Orders per customer" },
        { "type": "code", "lang": "sql", "lines": ["SELECT c.name, COUNT(o.id) AS n", "FROM customers c JOIN orders o", "  ON c.id = o.cid GROUP BY c.name;"], "result": { "headers": ["name", "n"], "rows": [["Ram", "3"], ["Riya", "2"]] } },
        { "type": "heading", "text": "Q64. Total spend above 1000" },
        { "type": "code", "lang": "sql", "lines": ["SELECT cid, SUM(amt) AS total", "FROM orders GROUP BY cid", "HAVING SUM(amt) > 1000;"], "result": { "headers": ["cid", "total"], "rows": [["101", "1500"], ["103", "1200"]] } },
        { "type": "heading", "text": "Q65. Avoid duplicate rows" },
        { "type": "code", "lang": "sql", "lines": ["SELECT DISTINCT c.name, p.name", "FROM orders o", "JOIN customers c ON o.cid = c.id", "JOIN products p ON o.pid = p.id;"], "result": { "headers": ["name", "product"], "rows": [["Ram", "Laptop"], ["Riya", "Shirt"], ["Amit", "Pen"]] } },
        { "type": "heading", "text": "Q66. Same city customers" },
        { "type": "code", "lang": "sql", "lines": ["SELECT a.name, b.name", "FROM customers a JOIN customers b", "  ON a.city = b.city AND a.id < b.id;"], "result": { "headers": ["a", "b"], "rows": [["Ram", "Riya"], ["Amit", "Neha"]] } },
        { "type": "callout", "style": "banner", "title": "Key takeaways:", "text": "Join on keys, filter early, and watch for fan-out duplicates." }
