            ], "style": "dot" },
            { "type": "code", "lang": "python", "lines": [
              "import asyncio",
              "async def fetch():",
              "    print('fetching…')",
              "    await asyncio.sleep(1)",
              "    return 'data'",
              "async def main():",
              "    coro = fetch()",
              "    print(type(coro).__name__, await coro)"
            ], "note": "the body of fetch() starts only at await" },
            { "type": "code", "lang": "output", "lines": ["fetching…", "coroutine data"] },
