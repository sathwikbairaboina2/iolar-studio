              ["`await time.sleep(1)`", "Loop blocked, TypeError", "`await asyncio.sleep(1)`"],
              ["`await` in a plain `def`", "SyntaxError", "Move it into a coroutine"]
            ] },
            { "type": "callout", "style": "sticky", "title": "Remember", "text": "A coroutine does nothing until something ==awaits== it or wraps it in a Task." }
