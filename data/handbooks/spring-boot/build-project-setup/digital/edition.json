    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "The main class is in `com.example.demo`. A `@RestController` sits in `com.example.api`. The app starts fine, but its endpoint returns 404. Why?",
              "a_bullets": [
                "Component scan covers only the main class's package and its sub-packages",
                "`com.example.api` is a sibling, so the controller bean is never registered",
                "Fix: move it under `com.example.demo`, or set `scanBasePackages`"
              ]
            },
            {
              "type": "qa",
              "q": "A pom uses `spring-boot-starter-parent` but declares `spring-boot-starter-web` with `<version>2.5.0</version>`. What is the bug?",
              "a_bullets": [
                "The parent's BOM already manages that version, so the pinned one overrides it",
                "It can drift from the other Boot libraries and cause mismatches",
                "Remove the `<version>` tag"
              ]
            },
            {
              "type": "qa",
              "q": "`java -jar target/demo.jar` fails with `no main manifest attribute`. What is the likely cause?",
              "a_bullets": [
                "The jar is a plain jar, not a Boot fat jar",
                "The Boot Maven plugin is missing, so it never repackaged the jar",
                "Add `spring-boot-maven-plugin`, then run `./mvnw clean package` again"
              ]
            }
          ]
        }
      ]
    }
