            {
              "type": "heading",
              "text": "2. The Wrapper",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "Always run the ==wrapper==: everyone gets the same tool version",
                "Nothing to install; it downloads the pinned version",
                "Windows uses `mvnw.cmd` / `gradlew.bat`"
              ],
              "style": "check"
            },
            {
              "type": "code",
              "lang": "bash",
              "lines": [
                "./mvnw clean package",
                "./gradlew build",
                "mvnw.cmd clean package",
                "gradlew.bat build"
              ],
              "note": "Unix first, then Windows"
            },
            {
              "type": "heading",
              "text": "3. Mistakes",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "Committing **without** the wrapper files",
                "Mixing a global `mvn`/`gradle` with the project's wrapper"
              ],
              "style": "cross",
              "frame": "dashed",
              "ink": "red"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Wrapper, not global",
              "text": "Run `./mvnw` or `./gradlew`; a global install may be a ==different version== from the one the project pins."
            }
          ]
        }
      ]
