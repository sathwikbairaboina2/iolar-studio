    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "A method calls `webClient.get().uri(\"/users/1\").retrieve().bodyToMono(User.class);` and ignores the result. What request goes out?",
              "a_bullets": [
                "None. A Mono is lazy, so nothing is sent until something subscribes.",
                "Fix: return the Mono, subscribe, or call `.block()` in non-reactive code."
              ]
            },
            {
              "type": "qa",
              "q": "Topic `orders` has two `billing` consumers and one `audit` consumer, each in its own group. One record is published. Who gets it?",
              "a_bullets": [
                "One of the two `billing` consumers, because a group splits the partitions.",
                "The `audit` consumer too, because every group gets every record."
              ]
            },
            {
              "type": "qa",
              "q": "A listener always throws. The error handler is `new DefaultErrorHandler(new FixedBackOff(1000L, 3))`. How many times does it run, and what then?",
              "a_bullets": [
                "4 runs: the first delivery plus 3 retries, 1 second apart.",
                "Then the record is logged and skipped. Add a `DeadLetterPublishingRecoverer` to send it to `orders.DLT`."
              ]
            }
          ]
        }
      ]
    }
