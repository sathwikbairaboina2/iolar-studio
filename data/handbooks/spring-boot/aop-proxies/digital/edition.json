    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "outer() has no annotation and calls this.inner(), which is @Transactional(REQUIRES_NEW). Is inner() in a new transaction?",
              "a_bullets": [
                "No. `this` is the target, not the proxy, so the advice is skipped.",
                "Fix: move inner() to another bean and inject it."
              ],
              "example_code": [
                "public void outer() { this.inner(); }"
              ]
            },
            {
              "type": "qa",
              "q": "An @Around advice ends with pjp.proceed(); on its own line. What does the caller get?",
              "a_bullets": [
                "The method runs, but the caller gets {red:null}: the result was never returned.",
                "Write `return pjp.proceed();`."
              ]
            },
            {
              "type": "qa",
              "q": "A @Transactional method saves a row, then throws IOException. Rolled back?",
              "a_bullets": [
                "No, it {red:commits}. Rollback happens only for RuntimeException and Error.",
                "Add `rollbackFor = IOException.class`."
              ]
            }
          ]
        }
      ]
    }
