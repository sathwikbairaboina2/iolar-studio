            },
            {
              "type": "heading",
              "text": "2. Proxy Choice",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "Interface present and not forced: ==JDK== proxy; else ==CGLIB==",
                "Boot defaults to ==CGLIB==",
                "CGLIB cannot proxy `final` classes or methods"
              ],
              "style": "dot"
            },
            {
              "type": "heading",
              "text": "3. Proxy Bypass Checklist",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "Self-invocation with `this.m()`",
                "`private` or `final` methods",
                "Objects made with `new`",
                "Beans not managed by Spring",
                "Annotation without its @Enable switch"
              ],
              "style": "cross",
              "ink": "red"
            },
            {
              "type": "sidebox",
              "title": "Enable switches",
              "items": [
                "Tx: `@EnableTransactionManagement`",
                "Cache: `@EnableCaching`",
                "Security: `@EnableMethodSecurity`",
                "Async: `@EnableAsync`",
                "Aspects: `@EnableAspectJAutoProxy`"
