    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "A singleton `OrderService` has a field `@Autowired Cart cart`, and `Cart` is a prototype bean. Do two requests get different carts?",
              "a_bullets": [
                "No: ==one Cart== is injected once, at singleton creation.",
                "Fix: inject `ObjectProvider<Cart>` and call `getObject()` per use."
              ]
            },
            {
              "type": "qa",
              "q": "Two `PaymentGateway` beans exist and `PayService(PaymentGateway g)` is the only constructor. What happens at startup?",
              "a_bullets": [
                "`NoUniqueBeanDefinitionException`: Spring cannot pick one.",
                "Fix: `@Primary` on the default bean, or `@Qualifier(\"name\")` on the parameter."
              ]
            },
            {
              "type": "qa",
              "q": "A `@Component` class has `@Bean DataSource ds()` and `@Bean Repo repo() { return new Repo(ds()); }`. Is the DataSource shared?",
              "a_bullets": [
                "No: lite mode has no proxy, so `ds()` makes a ==new instance==.",
                "Fix: use `@Configuration`, or take `DataSource` as a method parameter."
              ]
            }
          ]
        }
      ]
    }
