    {
      "title": "Stereotypes and Constructor Injection",
      "role": "outline",
      "outlineIndex": 1,
      "pages": [
        {
          "title": "Stereotypes and Constructor Injection",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Stereotype Annotations",
              "ink": "green"
            },
            {
              "type": "table",
              "headers": [
                "Annotation",
                "Layer",
                "Extra"
              ],
              "rows": [
                [
                  "`@Component`",
                  "generic",
                  "base stereotype"
                ],
                [
                  "`@Service`",
                  "business logic",
                  "same registration"
                ],
                [
                  "`@Repository`",
                  "persistence",
                  "==exception translation=="
                ],
                [
                  "`@Controller` / `@RestController`",
                  "web",
                  "serves requests"
                ]
              ],
              "frame": "dashed"
            },
            {
              "type": "bullets",
              "items": [
                "`@Service` and `@Repository` are ==specializations== of `@Component`",
                "`@Repository` turns `SQLException` into Spring's ==DataAccessException== hierarchy"
              ],
              "style": "dot"
            },
            {
              "type": "heading",
              "text": "2. Constructor Injection",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "Declare dependencies as ==final== constructor parameters",
                "One constructor: `@Autowired` is ==optional== (since Spring 4.3)"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "blue"
            },
            {
              "type": "code",
              "lang": "java",
              "lines": [
                "@Service",
                "public class OrderService {",
                "    private final OrderRepo repo;",
                "    public OrderService(OrderRepo repo) {",
                "        this.repo = repo;",
                "    }",
                "}"
              ]
            },
            {
              "type": "bullets",
              "items": [
                "{green:Constructor}: immutable, required, testable with plain `new`, never half-built",
                "{red:Field}: hides dependencies, needs reflection or a container to test"
              ],
              "style": "check"
            },
            {
              "type": "heading",
              "text": "3. Ambiguity and Cycles",
              "ink": "red"
            },
            {
              "type": "table",
              "headers": [
                "Problem",
                "Error",
                "Fix"
              ],
              "rows": [
                [
                  "Two beans of one type",
                  "`NoUniqueBeanDefinitionException`",
                  "`@Primary` on default, or `@Qualifier(\"name\")` at injection point"
                ],
                [
                  "A needs B, B needs A",
                  "`BeanCurrentlyInCreationException` at startup",
                  "Redesign the dependencies"
                ]
              ]
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Circular dependency",
              "text": "Fix it by ==redesigning==. Switching to field injection only hides the cycle."
            }
          ]
        }
      ]
    },
    {
      "title": "Bean Scopes and Lifecycle",
      "role": "outline",
      "outlineIndex": 2,
      "pages": [
        {
          "title": "Bean Scopes and Lifecycle",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Scopes",
              "ink": "green"
            },
            {
              "type": "table",
              "headers": [
                "Scope",
                "Instances",
                "Note"
              ],
              "rows": [
                [
                  "`singleton` (default)",
                  "one per container",
                  "stateless or thread-safe"
                ],
                [
                  "`prototype`",
                  "new per injection or lookup",
                  "{red:no destroy callbacks}"
                ],
                [
                  "`request` `session` `application`",
                  "per request, session, app",
                  "web-only"
                ]
              ]
            },
            {
              "type": "bullets",
              "items": [
                "Singleton is one per ==container==, not per JVM",
                "Shared by all threads, so keep it **stateless**"
              ],
              "style": "dot"
            },
            {
              "type": "heading",
              "text": "2. Prototype inside a singleton",
              "ink": "purple"
            },
            {
              "type": "bullets",
              "items": [
                "Injected once, so the prototype or request bean is ==frozen==",
                "Fix: `ObjectProvider<T>`, or `@Scope(proxyMode = TARGET_CLASS)`"
              ],
              "style": "cross",
              "ink": "red"
            },
            {
              "type": "code",
              "lang": "java",
              "lines": [
                "@Component",
                "class Report {",
                "  private final ObjectProvider<Job> jobs;",
                "  Report(ObjectProvider<Job> jobs) { this.jobs = jobs; }",
                "  void run() { jobs.getObject().go(); }",
                "}"
              ],
              "note": "getObject() returns a fresh prototype each call"
            },
            {
              "type": "heading",
              "text": "3. Lifecycle and laziness",
              "ink": "blue"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "Instantiate",
                    "ink": "blue"
                  },
                  {
                    "text": "Inject",
                    "ink": "blue"
                  },
                  {
                    "text": "@PostConstruct",
                    "ink": "green"
                  },
                  {
                    "text": "afterPropertiesSet",
                    "ink": "green"
                  },
                  {
                    "text": "Ready",
                    "ink": "orange"
                  },
                  {
                    "text": "@PreDestroy",
                    "ink": "red"
                  },
                  {
                    "text": "destroy",
                    "ink": "red"
                  }
                ]
              }
            },
            {
              "type": "bullets",
              "items": [
                "Init needing injected fields goes in ==@PostConstruct==, never the constructor",
                "`@Lazy` creates the bean on first use",
                "Wiring errors move from ==startup== to **runtime**"
              ],
              "style": "check"
            }
          ]
        }
      ]
    },
    {
      "title": "@Configuration and @Bean",
      "role": "outline",
      "outlineIndex": 3,
      "pages": [
        {
          "title": "@Configuration and @Bean",
          "blocks": [
            {
              "type": "heading",
              "text": "1. What it does",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "==@Configuration== marks a class holding `@Bean` methods",
                "Return value becomes a bean, named after the **method**",
                "Class is ==CGLIB-proxied==: repeated bean-method calls return the same singleton"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "table",
              "headers": [
                "",
                "@Bean",
                "Stereotype"
              ],
              "rows": [
                [
                  "Use for",
                  "third-party classes",
                  "your own classes"
                ],
                [
                  "Examples",
                  "ObjectMapper, RestTemplate, DataSource",
                  "@Service, @Repository"
                ]
              ]
            },
            {
              "type": "heading",
              "text": "2. Wiring and hooks",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "Dependencies are **method parameters**, injected automatically",
                "Do not call another bean method to wire",
                "`initMethod` / `destroyMethod` hook lifecycle of third-party objects",
                "Conditional with `@ConditionalOnMissingBean` or `@Profile`"
              ],
              "style": "check",
              "ink": "blue"
            },
            {
              "type": "code",
              "lang": "java",
              "lines": [
                "@Bean",
                "ObjectMapper mapper() { return new ObjectMapper(); }",
                "",
                "@Bean(initMethod = \"start\", destroyMethod = \"close\")",
                "Pool pool(DataSource ds) { return new Pool(ds); }",
                "",
                "@Bean @Profile(\"dev\")",
                "Mailer mailer() { return new FakeMailer(); }"
              ],
              "note": "pool gets its DataSource as an argument"
            },
            {
              "type": "heading",
              "text": "3. Full vs lite mode",
              "ink": "purple"
            },
            {
              "type": "table",
              "headers": [
                "",
                "@Configuration",
                "@Component + @Bean"
              ],
              "rows": [
                [
                  "Mode",
                  "full",
                  "lite"
                ],
                [
                  "Proxied",
                  "{green:yes}",
                  "{red:no}"
                ],
                [
                  "Inter-bean call",
                  "same singleton",
                  "{red:new instance}"
                ]
              ],
              "highlightRow": 2
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Beans calling each other",
              "text": "Use ==@Configuration==, not @Component, when beans call each other."
            }
          ]
        }
      ]
    },
