                  "`singleton`",
                  "One shared per container",
                  "**Default**"
                ],
                [
                  "`prototype`",
                  "New per request",
                  "No destroy call"
                ],
                [
                  "`request` `session` `application`",
                  "Per web unit",
                  "{orange:Web only}"
                ]
              ]
            },
