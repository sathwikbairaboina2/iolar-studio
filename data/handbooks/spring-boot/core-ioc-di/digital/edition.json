          "blocks": [
            {
              "type": "heading",
              "text": "1. Annotations and injection",
              "ink": "green"
            },
            {
              "type": "table",
              "headers": [
                "Annotation",
                "Use"
              ],
              "rows": [
                [
                  "`@Component` `@Service` `@Repository` `@Controller`",
                  "Register your own classes as beans"
                ],
                [
                  "`@Configuration` + `@Bean`",
                  "Third-party objects you cannot annotate"
                ],
                [
                  "`@Primary`",
                  "Default pick among candidates"
                ],
                [
                  "`@Qualifier(\"name\")`",
                  "Pick one at the injection point"
                ]
              ],
              "frame": "dashed"
            },
            {
              "type": "bullets",
              "items": [
                "==Constructor== injection for **required** dependencies",
                "Fields are `final`; one constructor needs no `@Autowired`",
                "==Setter== injection only for **optional** ones"
              ],
              "style": "check",
              "ink": "green"
            },
            {
              "type": "heading",
              "text": "2. Scopes and lifecycle",
