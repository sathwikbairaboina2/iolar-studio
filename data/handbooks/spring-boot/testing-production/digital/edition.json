    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "A `@WebMvcTest(UserController.class)` test fails at startup with NoSuchBeanDefinitionException for `UserService`. Why, and what fixes it?",
              "a_bullets": [
                "Slice tests load only the web layer, so ==services are not loaded==",
                "Add `@MockitoBean UserService` to the test"
              ]
            },
            {
              "type": "qa",
              "q": "`perform(post(\"/users\").content(json))` returns 415. What is the bug?",
              "a_bullets": [
                "No content type, so Spring can't pick a JSON converter",
                "Add `.contentType(MediaType.APPLICATION_JSON)`"
              ]
            },
            {
              "type": "qa",
              "q": "application.yml sets `server.port=8080`, env has `SERVER_PORT=9090`, and you run `java -jar app.jar --server.port=7070`. Which port wins?",
              "a_bullets": [
                "==7070==: command line beats env vars",
                "Env vars beat application.yml, so 9090 would win without the argument"
              ]
            }
          ]
        }
      ]
    }
  ]
