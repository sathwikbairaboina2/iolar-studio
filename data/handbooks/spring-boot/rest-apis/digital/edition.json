    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "`@GetMapping(\"/{id}\")` with `get(@PathVariable Long userId)`. What happens on GET /5?",
              "a_bullets": [
                "No URI variable named `userId`, so `MissingPathVariableException`",
                "It surfaces as a ==500==. Fix: `@PathVariable(\"id\")`."
              ]
            },
            {
              "type": "qa",
              "q": "`create(@RequestBody CreateUser req)` where `name` is `@NotBlank`. POST `{\"name\":\"\"}` gives?",
              "a_bullets": [
                "Constraints are ignored without `@Valid`, so the method ==runs normally==",
                "With `@Valid`: `MethodArgumentNotValidException`, a 400"
              ]
            },
            {
              "type": "qa",
              "q": "A `@Controller` method returns the String \"ok\". Why isn't the body ok?",
              "a_bullets": [
                "Without `@ResponseBody`, \"ok\" is a ==view name==",
                "`@RestController` writes it via an HttpMessageConverter"
              ]
            }
          ]
        }
      ]
    }
  ]
