              ],
              "style": "dot"
            },
            {
              "type": "heading",
              "text": "3. Pattern and Mistakes",
              "ink": "purple"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "Controller",
