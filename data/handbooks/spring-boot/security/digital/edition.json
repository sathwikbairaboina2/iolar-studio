            {
              "type": "callout",
              "style": "sticky",
              "title": "Thread-local gotcha",
              "text": "==SecurityContextHolder== is **thread-local**. Values do not reach new threads or async tasks unless a delegating strategy is configured."
            }
          ]
        }
