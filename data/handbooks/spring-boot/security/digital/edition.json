            {
              "type": "heading",
              "text": "2. Authentication vs Authorization",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "",
                "Authentication",
                "Authorization"
              ],
              "rows": [
                [
                  "Asks",
                  "**Who** are you?",
                  "**What** may you do?"
                ],
                [
                  "Failure",
                  "{red:401 Unauthorized}",
                  "{red:403 Forbidden}"
                ],
                [
                  "When",
                  "missing or invalid credentials",
                  "authenticated but denied"
                ]
              ],
              "highlightRow": 1
            },
            {
              "type": "heading",
              "text": "3. Authentication Flow",
              "ink": "purple"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "Filter",
                    "sub": "builds Authentication token",
                    "ink": "green"
                  },
                  {
                    "text": "ProviderManager",
                    "sub": "AuthenticationManager",
                    "ink": "blue"
                  },
                  {
                    "text": "AuthenticationProvider",
                    "sub": "UserDetailsService + PasswordEncoder",
                    "ink": "purple"
                  },
