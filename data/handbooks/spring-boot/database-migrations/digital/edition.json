    {
      "title": "Schema Migrations: The Mental Model",
      "role": "outline",
      "outlineIndex": 0,
      "pages": [
        {
          "title": "Schema Migrations: The Mental Model",
          "blocks": [
            {
              "type": "heading",
              "text": "1. What a Migration Is",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "==Migration== = versioned, ordered, scripted change to the schema",
                "Lives in ==source control== beside the application code",
                "The tool logs applied scripts in a ==history table==",
                "Dev, CI and prod all **converge** to the same schema state"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "heading",
              "text": "2. Core Workflow",
              "ink": "blue"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "Write script",
                    "sub": "new file",
                    "ink": "blue"
                  },
                  {
                    "text": "Commit",
                    "sub": "with the code",
                    "ink": "green"
                  },
                  {
                    "text": "Run tool",
                    "sub": "app startup or CI deploy",
                    "ink": "purple"
                  },
                  {
                    "text": "Apply pending",
                    "sub": "in order",
                    "ink": "orange"
                  }
                ]
              }
            },
            {
              "type": "table",
              "headers": [
                "Script",
                "In history table?",
                "Tool does"
              ],
              "rows": [
                [
                  "V1",
                  "{green:yes}",
                  "skip"
                ],
                [
                  "V2",
                  "{green:yes}",
                  "skip"
                ],
                [
                  "V3",
                  "{red:no}",
                  "**apply**, then record"
                ]
              ],
              "frame": "dashed"
            },
            {
              "type": "heading",
              "text": "3. Rules and Payoff",
              "ink": "red"
            },
            {
              "type": "sidebox",
              "title": "Forward-only and immutable",
              "items": [
                "Once applied, **never edit** the file",
                "Fix a mistake with a ==new migration==",
                "No manual SQL on a single environment"
              ],
              "ink": "red"
            },
            {
              "type": "table",
              "headers": [
                "",
                "Without migrations",
                "With migrations"
              ],
              "rows": [
                [
                  "Environments",
                  "{red:manual SQL drift}",
                  "{green:same state}"
                ],
                [
                  "History",
                  "{red:no audit trail}",
                  "{green:git + history table}"
                ],
                [
                  "Deploys",
                  "{red:unrepeatable}",
                  "{green:repeatable}"
                ]
              ],
              "highlightRow": 0
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Applied file = frozen",
              "text": "Wrong schema change already applied? Add the next migration. Never edit the old file."
            }
          ]
        }
      ]
    },
    {
      "title": "Flyway: Versioned and Repeatable Migrations",
      "role": "outline",
      "outlineIndex": 1,
      "pages": [
        {
          "title": "Flyway: Versioned and Repeatable Migrations",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Versioned vs repeatable",
              "ink": "green"
            },
            {
              "type": "table",
              "headers": [
                "",
                "Versioned",
                "Repeatable"
              ],
              "rows": [
                [
                  "File",
                  "`V2__add_orders_table.sql`",
                  "`R__order_views.sql`"
                ],
                [
                  "Runs",
                  "==once==, in version order",
                  "when ==checksum changes=="
                ],
                [
                  "Order",
                  "by version",
                  "after all V, by description"
                ],
                [
                  "Use for",
                  "tables, data changes",
                  "views, procedures, functions (`CREATE OR REPLACE`)"
                ]
              ],
              "highlightRow": 1
            },
            {
              "type": "heading",
              "text": "2. Naming and location",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "Pattern: ==V== or ==R==, version, ==two underscores==, description with `_` for spaces",
                "Default location: `classpath:db/migration`",
                "Spring Boot runs Flyway on startup when `flyway-core` is on the classpath"
              ],
              "style": "dot"
            },
            {
              "type": "code",
              "lang": "text",
              "lines": [
                "V2__add_orders_table.sql   matches",
                "V2_add_orders_table.sql    one _, no match",
                "R__order_views.sql         matches"
              ],
              "note": "two underscores after the version"
            },
            {
              "type": "heading",
              "text": "3. History and checksums",
              "ink": "purple"
            },
            {
              "type": "bullets",
              "items": [
                "`flyway_schema_history` stores version, description, checksum, success flag",
                "Edit an applied versioned file and its checksum changes, so ==validate fails=="
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "purple"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Never edit an applied V file",
              "text": "Add a new versioned migration instead."
            },
            {
              "type": "heading",
              "text": "4. Interview point",
              "ink": "orange"
            },
            {
              "type": "bullets",
              "items": [
                "**V or R?** V runs once; R re-runs when its checksum changes.",
                "**Why did validate fail?** An applied versioned file was edited."
              ],
              "style": "dot"
            }
          ]
        }
      ]
    },
    {
      "title": "Flyway Ordering, Commands and Pitfalls",
      "role": "outline",
      "outlineIndex": 2,
      "pages": [
        {
          "title": "Flyway Ordering, Commands and Pitfalls",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Version Ordering",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "Versions compare ==numerically== by segment: `V1.2` runs before `V1.10`",
                "No zero-padding needed; it is not a string sort",
                "A lower version added after a higher one was applied is ==rejected== by default",
                "`flyway.outOfOrder=true` allows it, but history may turn inconsistent"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "heading",
              "text": "2. Core Commands",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "Command",
                "Does"
              ],
              "rows": [
                [
                  "`migrate`",
                  "Apply pending migrations"
                ],
                [
                  "`info`",
                  "Show status of each migration"
                ],
                [
                  "`validate`",
                  "Check applied checksums"
                ],
                [
                  "`repair`",
                  "Fix the history table"
                ],
                [
                  "`baseline`",
                  "Mark an existing DB at a version"
                ],
                [
                  "`clean`",
                  "{red:Drops everything}"
                ]
              ]
            },
            {
              "type": "bullets",
              "items": [
                "Adopt Flyway on a non-empty DB with `baseline` or ==baselineOnMigrate==",
                "`clean-disabled=true` blocks `clean`; it is already the default, shown for clarity"
              ],
              "style": "check",
              "ink": "blue"
            },
            {
              "type": "code",
              "lang": "properties",
              "lines": [
                "spring.flyway.baseline-on-migrate=true",
                "spring.flyway.clean-disabled=true"
              ]
            },
            {
              "type": "heading",
              "text": "3. Mistakes",
              "ink": "red"
            },
            {
              "type": "table",
              "headers": [
                "Mistake",
                "Fix"
              ],
              "rows": [
                [
                  "Edited an applied file: checksum mismatch",
                  "Add a new versioned migration"
                ],
                [
                  "History needs a deliberate fix",
                  "Use `repair`, only then"
                ],
                [
                  "Same version on two branches",
                  "Agree a scheme, e.g. timestamps"
                ]
              ]
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Remember",
              "text": "Applied migrations are immutable: ==add a new one==, never edit."
            }
          ]
        }
      ]
    },
    {
      "title": "Liquibase Changelogs and Comparison with Flyway",
      "role": "outline",
      "outlineIndex": 3,
      "pages": [
        {
          "title": "Liquibase Changelogs and Comparison with Flyway",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Changelog and changeSet",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "==Changelog== = master file (YAML, XML, JSON or SQL) of ordered changeSets",
                "changeSet identity = ==id + author + file path==",
                "Each applied one is stored in `DATABASECHANGELOG` with an ==MD5 checksum=="
              ],
              "style": "dot",
              "ink": "green"
            },
            {
              "type": "code",
              "lang": "yaml",
              "lines": [
                "databaseChangeLog:",
                "  - changeSet:",
                "      id: 1",
                "      author: dev",
                "      changes:",
                "        - createTable:",
                "            tableName: users"
              ],
              "note": "one changeSet in a YAML changelog"
            },
            {
              "type": "bullets",
              "items": [
                "`createTable`, `addColumn`: {green:database-agnostic}, rollback is ==generated==",
                "Raw SQL changeSet: {red:you must write} an explicit `rollback`"
              ],
              "style": "check"
            },
            {
              "type": "heading",
              "text": "2. Attributes and the lock",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "`runOnChange`: re-run when the changeSet is edited",
                "`runAlways`: run on every update",
                "`preconditions`: check state before running",
                "`contexts` / `labels`: target environments",
                "`DATABASECHANGELOGLOCK` blocks ==concurrent runs=="
              ],
              "style": "dot",
              "ink": "blue"
            },
            {
              "type": "heading",
              "text": "3. Flyway vs Liquibase",
              "ink": "purple"
            },
            {
              "type": "table",
              "headers": [
                "",
                "Flyway",
                "Liquibase"
              ],
              "rows": [
                [
                  "Style",
                  "Plain SQL, simple",
                  "Abstracted, declarative"
                ],
                [
                  "Order",
                  "Versioned files",
                  "Ordered changeSets"
                ],
                [
                  "Rollback",
                  "None built in",
                  "Built in"
                ],
                [
                  "Targeting",
                  "Basic",
                  "Preconditions, contexts"
                ]
              ],
              "highlightRow": 0
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Crashed run",
              "text": "A crash can leave `DATABASECHANGELOGLOCK` ==locked==. Release it, or later runs wait forever."
            }
          ]
        }
      ]
    },
    {
      "title": "ddl-auto and Why Not in Production",
      "role": "outline",
      "outlineIndex": 4,
      "pages": [
        {
          "title": "ddl-auto and Why Not in Production",
          "blocks": [
            {
              "type": "heading",
              "text": "1. The five values",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "Value",
                "On startup",
                "Data"
              ],
              "rows": [
                [
                  "`none`",
                  "does nothing",
                  "untouched"
                ],
                [
                  "`validate`",
                  "checks entities vs schema",
                  "untouched"
                ],
                [
                  "`update`",
                  "adds missing tables, columns",
                  "kept"
                ],
                [
                  "`create`",
                  "drops, recreates schema",
                  "{red:destroyed}"
                ],
                [
                  "`create-drop`",
                  "as create, drops at shutdown",
                  "{red:destroyed}"
                ]
              ],
              "highlightRow": 1
            },
            {
              "type": "heading",
              "text": "2. Why not in production",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "`update` never drops or renames columns, can't migrate data",
                "No history, review or ==rollback== of the DDL",
                "DDL is **unpredictable** and unversioned",
                "Risk of ==data loss== or silently missing changes"
              ],
              "style": "cross"
            },
            {
              "type": "heading",
              "text": "3. Safe use",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "Prod: ==validate== fails startup if entities and schema differ, or `none`",
                "Flyway or Liquibase **owns** the schema",
                "Prototypes, tests: `create-drop` or `create` on in-memory DB"
              ],
              "style": "check"
            },
            {
              "type": "code",
              "lang": "properties",
              "lines": [
                "spring.jpa.hibernate.ddl-auto=validate"
              ],
              "note": "application.properties"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Remember",
              "text": "Never ship `create`, `create-drop` or `update` in a prod profile."
            },
            {
              "type": "sidebox",
              "title": "Interview Point",
              "items": [
                "**Why not `update` in prod?** Unreviewed, unversioned DDL, no rollback.",
                "**`validate` vs `none`?** validate fails startup on mismatch.",
                "**When is `create-drop` fine?** In-memory prototypes and tests."
              ],
              "ink": "orange"
            }
          ]
        }
      ]
    },
    {
      "title": "HikariCP Connection Pooling and Cheat Sheet",
      "role": "outline",
      "outlineIndex": 5,
      "pages": [
        {
          "title": "HikariCP Connection Pooling and Cheat Sheet",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Why Pool",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "Pooling ==reuses open connections==: opening one per request is slow",
                "==HikariCP== is the Spring Boot default pool"
              ],
              "style": "dot"
            },
            {
              "type": "table",
              "headers": [
                "Property",
                "Default",
                "Meaning"
              ],
              "rows": [
                [
                  "`maximumPoolSize`",
                  "10",
                  "max connections"
                ],
                [
                  "`minimumIdle`",
                  "= max size",
                  "fixed-size pool"
                ],
                [
                  "`connectionTimeout`",
                  "30s",
                  "wait for a connection"
                ],
                [
                  "`idleTimeout`",
                  "10min",
                  "retire idle extras"
                ],
                [
                  "`maxLifetime`",
                  "30min",
                  "retire old connections"
                ]
              ]
            },
            {
              "type": "heading",
              "text": "2. Sizing and Exhaustion",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "==Small pool is better==",
                "Start at `cores*2 + effective spindles`",
                "Sum over all app instances stays below DB `max_connections`",
                "Set `maxLifetime` below any DB or firewall timeout",
                "Error: `Connection is not available, request timed out after 30000ms`",
                "Cause: {red:leaked connections}",
                "Cause: {red:long transactions}",
                "Fix: release connections quickly",
                "Find leaks with `leakDetectionThreshold`"
              ],
              "style": "dot"
            },
            {
              "type": "code",
              "lang": "properties",
              "lines": [
                "spring.datasource.hikari.maximum-pool-size=10",
                "spring.datasource.hikari.connection-timeout=30000"
              ]
            },
            {
              "type": "heading",
              "text": "3. Cheat Sheet",
              "ink": "purple"
            },
            {
              "type": "table",
              "headers": [
                "Topic",
                "Remember"
              ],
              "rows": [
                [
                  "Flyway files",
                  "`V__` runs once; `R__` re-runs on checksum change"
                ],
                [
                  "Commands",
                  "migrate, info, validate, repair, baseline"
                ],
                [
                  "Production",
                  "`ddl-auto=validate`"
                ]
              ]
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Never edit an applied migration",
              "text": "The checksum mismatch fails validate. Add a new versioned migration instead."
            }
          ]
        }
      ]
    },
    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "`V2__add_orders.sql` already ran in prod. Someone adds a column to that file and redeploys. What happens?",
              "a_bullets": [
                "Startup fails: the **checksum** no longer matches `flyway_schema_history`.",
                "Fix: put the change in a new `V3__...` file and restore V2."
              ]
            },
            {
              "type": "qa",
              "q": "Files `V1.2__a.sql` and `V1.10__b.sql` are both pending. Which runs first?",
              "a_bullets": [
                "`V1.2` runs first.",
                "Versions compare numerically by segment (2 < 10), not as strings."
              ]
            },
            {
              "type": "qa",
              "q": "With `ddl-auto=update`, you rename an entity field `name` to `fullName`. What does prod end up with?",
              "a_bullets": [
                "A new empty `full_name` column is added.",
                "The old `name` column stays and its data is not copied.",
                "Use a reviewed migration instead."
              ]
            }
          ]
        }
      ]
    }
