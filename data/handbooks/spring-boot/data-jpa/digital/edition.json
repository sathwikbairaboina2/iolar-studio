        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "`order.getItems().add(item); orderRepo.save(order);` with cascade ALL, but `item.setOrder` never called. What is stored?",
              "a_bullets": [
                "The item row is inserted with ==order_id NULL==",
                "Only the owning @ManyToOne side writes the FK; use `order.addItem(item)`"
              ]
            },
            {
              "type": "qa",
              "q": "`run()` calls `this.saveAll()`, which is @Transactional. It throws a RuntimeException after 2 of 5 saves. What rolls back?",
              "a_bullets": [
                "Nothing: self-invocation bypasses the proxy, so no transaction starts",
                "The 2 saves already committed on their own"
              ]
            },
            {
              "type": "qa",
              "q": "100 orders are loaded with findAll(), then a loop calls `o.getItems().size()` on lazy items. How many queries?",
              "a_bullets": [
                "==101==: one for orders, then one per order",
                "Fix with `join fetch` or @EntityGraph, not EAGER"
              ]
            }
          ]
        }
      ]
    }
