            {
              "type": "heading",
              "text": "3. Defaults and Troubleshooting",
              "ink": "orange"
            },
            {
              "type": "table",
              "headers": [
                "State",
                "Cause"
              ],
              "rows": [
                [
                  "Pending",
                  "no node fits, or not scheduled yet"
                ],
                [
                  "ImagePullBackOff",
                  "wrong image or registry credentials"
                ],
                [
                  "CrashLoopBackOff",
                  "app crashes: `logs --previous`"
                ]
              ]
            },
            {
              "type": "bullets",
              "items": [
                "==maxSurge 25%==, ==maxUnavailable 25%==, ==revisionHistoryLimit 10==",
                "Add `-n <ns>` or `-A` to every query",
                "`kubectl explain <resource>.spec` shows field docs",
                "Deployment YAML needs `metadata.name`"
