    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "A Deployment has `selector.matchLabels: {app: web}` but its template labels are `{app: api}`. What happens on apply?",
              "a_bullets": [
                "The API rejects it.",
                "The selector must match the template labels, or the ReplicaSet could never own its Pods."
              ]
            },
            {
              "type": "qa",
              "q": "You run `kubectl scale deploy web --replicas=5`. Does `rollout history` gain a revision?",
              "a_bullets": [
                "No.",
                "Only a Pod template change triggers a rollout; the same ReplicaSet just scales to 5."
              ]
            },
            {
              "type": "qa",
              "q": "A Pod is in CrashLoopBackOff. Which command shows why the last run died?",
              "a_bullets": [
                "`kubectl logs <pod> --previous`",
                "Plain `logs` may show only the fresh restart; `describe pod` adds the Events."
              ]
            }
          ]
        }
      ]
    }
