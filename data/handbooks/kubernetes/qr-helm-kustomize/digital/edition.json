    {
      "title": "Helm Charts, Values and Templates",
      "role": "outline",
      "outlineIndex": 1,
      "pages": [
        {
          "title": "Helm Charts, Values and Templates",
          "blocks": [
            {
              "type": "heading",
              "text": "1. What a Chart Is",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "==Chart== = Kubernetes manifest templates + metadata",
                "`Chart.yaml`: name, `version`, `appVersion`",
                "`values.yaml`: defaults; `templates/`: manifests",
                "`charts/`: dependencies; `_helpers.tpl`: named partials",
                "`version` = chart package version, ==bump on any chart change==",
                "`appVersion` = the app's own version, informational only"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "heading",
              "text": "2. Values and Templates",
              "ink": "blue"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "values.yaml",
                    "sub": "defaults",
                    "ink": "green"
                  },
                  {
                    "text": "-f files",
                    "sub": "in order",
                    "ink": "blue"
                  },
                  {
                    "text": "--set",
                    "sub": "later wins",
                    "ink": "orange"
                  },
                  {
                    "text": "Render",
                    "sub": "Go templates",
                    "ink": "purple"
                  },
                  {
                    "text": "Cluster",
                    "sub": "YAML sent",
                    "ink": "red"
                  }
                ]
              }
            },
            {
              "type": "table",
              "headers": [
                "Syntax",
                "Gives"
              ],
              "rows": [
                [
                  "`{{ .Values.image.tag }}`",
                  "a value"
                ],
                [
                  "`{{ .Release.Name }}`",
                  "release name"
                ],
                [
                  "`{{ .Chart.Name }}`",
                  "chart name"
                ],
                [
                  "`{{ if .Values.ingress.enabled }}`",
                  "conditional"
                ],
                [
                  "`{{ range .Values.env }}`",
                  "loop"
                ]
              ],
              "frame": "dashed"
            },
            {
              "type": "bullets",
              "items": [
                "Pipeline: `{{ .Values.name | default \"app\" | quote }}`"
              ],
              "style": "dot"
            },
            {
              "type": "heading",
              "text": "3. Example and Mistakes",
              "ink": "purple"
            },
            {
              "type": "bullets",
              "items": [
                "`helm template` ==renders locally==, never touches the cluster"
              ],
              "style": "dot"
            },
            {
              "type": "code",
              "lang": "bash",
              "lines": [
                "helm create myapp",
                "helm template myapp ./myapp -f prod.yaml",
                "helm lint ./myapp"
              ],
              "note": "scaffold, render, check"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Common mistakes",
              "text": "Pasted YAML breaks indentation: use `{{ toYaml .Values.resources | nindent 12 }}`. Avoid `--set` on lists or nested keys: use a values file and ==quote== strings that look like numbers or booleans."
            }
          ]
        }
      ]
    },
    {
      "title": "Helm Install, Upgrade, Rollback and Releases",
      "role": "outline",
      "outlineIndex": 2,
      "pages": [
        {
          "title": "Helm Install, Upgrade, Rollback and Releases",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Releases and State",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "==Release== = one named install of a chart in a namespace",
                "Same chart, many releases under different names",
                "State = Secret `sh.helm.release.v1.<name>.v<rev>`",
                "No Tiller; each upgrade makes a new ==revision=="
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "heading",
              "text": "2. Lifecycle Commands",
              "ink": "blue"
            },
            {
              "type": "code",
              "lang": "bash",
              "lines": [
                "helm install web ./myapp -n prod --create-namespace -f prod.yaml",
                "helm upgrade --install web ./myapp -f prod.yaml",
                "helm upgrade web ./myapp --set image.tag=1.4",
                "helm history web",
                "helm rollback web 2"
              ]
            },
            {
              "type": "bullets",
              "items": [
                "`upgrade --install` is the ==idempotent== form",
                "`rollback web 2` = new revision with revision 2's config"
              ],
              "style": "dot"
            },
            {
              "type": "table",
              "headers": [
                "Command",
                "Shows"
              ],
              "rows": [
                [
                  "`helm list -A`",
                  "all releases"
                ],
                [
                  "`helm status web`",
                  "state"
                ],
                [
                  "`helm get values web`",
                  "overrides; `--all` adds defaults"
                ],
                [
                  "`helm get manifest web`",
                  "rendered YAML"
                ],
                [
                  "`helm uninstall web`",
                  "removes release"
                ]
              ]
            },
            {
              "type": "heading",
              "text": "3. Safe Deploys",
              "ink": "purple"
            },
            {
              "type": "bullets",
              "items": [
                "`--atomic`: auto rollback on failure, implies `--wait`",
                "`--wait`: block until resources are ready",
                "`--timeout`: sets the limit",
                "`helm diff upgrade` (plugin) previews changes"
              ],
              "style": "check"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Upgrade resets overrides",
              "text": "Without `--reuse-values` or the original `-f`, overrides revert to chart defaults. Pass the same values files every time."
            }
          ]
        }
      ]
    },
    {
      "title": "Kustomize Bases, Overlays and Patches",
      "role": "outline",
      "outlineIndex": 3,
      "pages": [
        {
          "title": "Kustomize Bases, Overlays and Patches",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Base and overlay",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "==Template-free== plain YAML, built into `kubectl`",
                "Directory with `kustomization.yaml` = one unit",
                "==Base== = common manifests",
                "==Overlay== lists base under `resources:`, adds env changes, base untouched"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "code",
              "lang": "text",
              "lines": [
                "base/",
                "  deployment.yaml",
                "  service.yaml",
                "  kustomization.yaml",
                "overlays/",
                "  dev/kustomization.yaml",
                "  prod/kustomization.yaml"
              ],
              "note": "layout"
            },
            {
              "type": "code",
              "lang": "yaml",
              "lines": [
                "resources:",
                "  - ../../base",
                "namePrefix: prod-",
                "namespace: prod",
                "replicas:",
                "  - name: web",
                "    count: 5"
              ],
              "note": "overlays/prod/kustomization.yaml"
            },
            {
              "type": "heading",
              "text": "2. Transformers and patches",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "Key",
                "Effect"
              ],
              "rows": [
                [
                  "`namePrefix`, `namePrefix`",
                  "rename resources"
                ],
                [
                  "`namespace`",
                  "set namespace"
                ],
                [
                  "`commonLabels`",
                  "add labels"
                ],
                [
                  "`images`",
                  "change name or tag"
                ],
                [
                  "`replicas`",
                  "set count"
                ],
                [
                  "`configMapGenerator`, `secretGenerator`",
                  "add hash suffix"
                ]
              ],
              "frame": "dashed"
            },
            {
              "type": "bullets",
              "items": [
                "==Hash==: new content, new name, references rewritten, pods roll",
                "`patches:` with `path` or inline `target`",
                "{blue:Strategic merge}: by structure, containers by `name`",
                "{purple:JSON 6902}: `op`/`path`/`value`"
              ],
              "style": "dot"
            },
            {
              "type": "heading",
              "text": "3. Commands and mistakes",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "Preview: `kubectl kustomize overlays/prod`",
                "Apply: `kubectl apply -k overlays/prod`",
                "Delete: `kubectl delete -k overlays/prod`"
              ],
              "style": "check"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Mistakes",
              "text": "A patch matching no name or kind ==fails the build==. `commonLabels` rewrites immutable selectors."
            }
          ]
        }
      ]
    },
    {
      "title": "Choosing Between Helm and Kustomize",
      "role": "outline",
      "outlineIndex": 4,
      "pages": [
        {
          "title": "Choosing Between Helm and Kustomize",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Two Tools, Two Jobs",
              "ink": "green"
            },
            {
              "type": "table",
              "headers": [
                "",
                "Helm",
                "Kustomize"
              ],
              "rows": [
                [
                  "Method",
                  "==Go templates== + values",
                  "==base + overlays + patches=="
                ],
                [
                  "Output",
                  "rendered from templates",
                  "always valid YAML"
                ],
                [
                  "State",
                  "release history in cluster",
                  "none stored in cluster"
                ],
                [
                  "Rollback",
                  "`helm rollback`, hooks",
                  "none built in"
                ],
                [
                  "Ecosystem",
                  "chart repositories",
                  "built into kubectl"
                ],
                [
                  "Best for",
                  "third-party, parameterized apps",
                  "your manifests, per-env differences"
                ]
              ],
              "highlightRow": 5
            },
            {
              "type": "heading",
              "text": "2. Typical Choice",
              "ink": "blue"
            },
            {
              "type": "diagram",
              "kind": "flowchart",
              "spec": {
                "rows": [
                  [
                    "q"
                  ],
                  [
                    "h",
                    "k"
                  ]
                ],
                "nodes": {
                  "q": {
                    "text": "Whose YAML?",
                    "shape": "diamond"
                  },
                  "h": {
                    "text": "Helm: ingress-nginx, cert-manager, Prometheus",
                    "shape": "box",
                    "ink": "blue"
                  },
                  "k": {
                    "text": "Kustomize: in-house service, overlay per env",
                    "shape": "box",
                    "ink": "green"
                  }
                },
                "edges": [
                  {
                    "from": "q",
                    "to": "h",
                    "label": "third-party"
                  },
                  {
                    "from": "q",
                    "to": "k",
                    "label": "yours"
                  }
                ]
              }
            },
            {
              "type": "heading",
              "text": "3. Combining Them",
              "ink": "purple"
            },
            {
              "type": "bullets",
              "items": [
                "Render with Helm, then patch the output with Kustomize",
                "`helmCharts:` in kustomization.yaml inflates a chart",
                "{green:Argo CD} and {green:Flux} support both"
              ],
              "style": "dot"
            },
            {
              "type": "code",
              "lang": "bash",
              "lines": [
                "helm template web ./myapp | kubectl apply -f -",
                "kustomize build --enable-helm overlays/prod"
              ],
              "note": "helmCharts needs --enable-helm"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "One owner per resource",
              "text": "`kubectl apply -k` on resources a Helm release owns causes ==drift== and conflicting field managers."
            }
          ]
        }
      ]
    },
    {
      "title": "Helm and Kustomize Cheat Sheet",
      "role": "outline",
      "outlineIndex": 5,
      "pages": [
        {
          "title": "Helm and Kustomize Cheat Sheet",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Helm Commands",
              "ink": "blue"
            },
            {
              "type": "code",
              "lang": "bash",
              "lines": [
                "helm create myapp; helm lint ./myapp",
                "helm template web ./myapp -f prod.yaml",
                "helm upgrade --install web ./myapp -n prod",
                "helm list -A; helm status web",
                "helm history web; helm rollback web 2",
                "helm uninstall web"
              ],
              "note": "upgrade --install is the idempotent deploy"
            },
            {
              "type": "heading",
              "text": "2. Values and Safety Flags",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "Precedence: chart ==values.yaml== < `-f` files (in order) < ==--set==",
                "`helm get values web` shows what is applied"
              ],
              "style": "dot"
            },
            {
              "type": "table",
              "headers": [
                "Flag",
                "Effect"
              ],
              "rows": [
                [
                  "`--atomic`",
                  "rolls back on failure, implies `--wait`"
                ],
                [
                  "`--wait` / `--timeout`",
                  "block until ready / set the limit"
                ],
                [
                  "`-n ns` / `--create-namespace`",
                  "target namespace / create it"
                ],
                [
                  "`--dry-run --debug`",
                  "render only, no install"
                ]
              ]
            },
            {
              "type": "heading",
              "text": "3. Kustomize",
              "ink": "purple"
            },
            {
              "type": "code",
              "lang": "yaml",
              "lines": [
                "resources: [../../base]",
                "namePrefix: prod-",
                "namespace: prod",
                "images: [{name: web, newTag: \"1.4\"}]",
                "replicas: [{name: web, count: 3}]",
                "configMapGenerator: [{name: cfg, literals: [A=1]}]",
                "patches: [{path: patch.yaml}]"
              ],
              "note": "kustomization.yaml in an overlay"
            },
            {
              "type": "table",
              "headers": [
                "Command",
                "Does"
              ],
              "rows": [
                [
                  "`kubectl kustomize <dir>`",
                  "preview output"
                ],
                [
                  "`kubectl apply -k <dir>`",
                  "apply"
                ],
                [
                  "`kubectl delete -k <dir>`",
                  "delete"
                ]
              ]
            },
            {
              "type": "heading",
              "text": "4. Which Tool",
              "ink": "orange"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Rule of thumb",
              "text": "==Helm== for packaged or third-party apps. ==Kustomize== for plain in-house YAML per environment."
            }
          ]
        }
      ]
    },
    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "You ran `helm install web ./myapp -f prod.yaml`. Later: `helm upgrade web ./myapp --set image.tag=1.4`. Which values apply?",
              "a_bullets": [
                "Chart defaults, with `image.tag=1.4` on top.",
                "The prod.yaml overrides are lost. Pass `-f prod.yaml` again, or use `--reuse-values`, which keeps the last release's values and merges the new `--set` over them."
              ]
            },
            {
              "type": "qa",
              "q": "The base Deployment is named `web`. An overlay patch targets `web-app`. What does `kubectl apply -k` do?",
              "a_bullets": [
                "The build fails: no matches for Id Deployment.v1.apps/web-app; failed to find unique target for patch.",
                "Fix: make `metadata.name` and `kind` match the base."
              ]
            },
            {
              "type": "qa",
              "q": "`helm history web` shows revisions 1 to 3. You run `helm rollback web 2`. What revision is current?",
              "a_bullets": [
                "Revision 4, carrying revision 2's config.",
                "Rollback adds a revision; it never deletes history."
              ]
            }
          ]
        }
      ]
    }
  ]
