          "ink": "blue"
        },
        {
          "type": "code",
          "lang": "yaml",
          "lines": [
            "spec:",
            "  resources:",
            "    requests: {storage: 50Gi}",
            "# confirm: status.capacity",
            "# shrink: never supported"
          ],
          "note": "class needs allowVolumeExpansion"
        },
        {
          "type": "bullets",
          "items": [
            "Edit `requests.storage` on the PVC",
            "Controller grows the backing disk (**ControllerExpand**)",
            "Kubelet grows the filesystem (**NodeExpand**)",
            "Done only when `status.capacity` shows the new size"
          ],
          "style": "number",
          "ink": "blue"
        },
        {
          "type": "code",
          "lang": "bash",
          "lines": [
            "kubectl edit pvc pgdata",
            "# storage: 20Gi -> 50Gi",
            "kubectl get pvc pgdata -w",
            "# CAPACITY flips 20Gi -> 50Gi"
          ],
          "note": "FileSystemResizePending = node step still pending"
        }
      ],
