            "#   PersistentVolumeClaim"
          ],
          "note": "new PVC >= snapshot size"
        },
        {
          "type": "bullets",
          "items": [
            "StatefulSet + `volumeClaimTemplates` = one disk per pod",
            "Pair with ==WaitForFirstConsumer== for per-zone volumes",
            "Set `persistentVolumeClaimRetentionPolicy` on purpose"
          ],
          "style": "checkbox",
