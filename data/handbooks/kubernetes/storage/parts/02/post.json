          "type": "code",
          "lang": "bash",
          "lines": [
            "kubectl get pvc,pv,sc",
            "kubectl describe pvc <name>",
            "kubectl get volumeattachment",
            "kubectl get csidrivers",
            "kubectl get volumesnapshot"
          ],
          "note": "describe pvc first, always"
        },
        {
          "type": "code",
          "lang": "yaml",
          "lines": [
            "kind: PersistentVolumeClaim",
            "spec:",
            "  dataSource:      # clone",
            "    kind: PersistentVolumeClaim",
            "    name: pgdata"
          ],
          "note": "same class and namespace only"
        },
        {
          "type": "callout",
          "style": "tip",
          "title": "Grow early",
          "text": "Expansion is ==online== on most CSI drivers, but shrinking never is. Start small, grow on alert — never over-provision \"just in case\"."
        }
      ],
