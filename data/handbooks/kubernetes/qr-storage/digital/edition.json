  "sections": [
    {
      "title": "Volumes, PersistentVolumes and Claims",
      "role": "outline",
      "outlineIndex": 1,
      "pages": [
        {
          "title": "Volumes, PersistentVolumes and Claims",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Volumes, PV and PVC",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "Volume outlives ==container restarts==, not the Pod",
                "`emptyDir`: dies with the Pod",
                "`hostPath`: node path; {red:avoid in production}",
                "**PV**: cluster-scoped storage",
                "**PVC**: namespaced request",
                "PVC binds ==1:1== to a PV matching size, `accessModes`, `storageClassName`"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "heading",
              "text": "2. Access Modes",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "Mode",
                "Mounts"
              ],
              "rows": [
                [
                  "`RWO` ReadWriteOnce",
                  "read-write, one node"
                ],
                [
                  "`ROX` ReadOnlyMany",
                  "read-only, many nodes"
                ],
                [
                  "`RWX` ReadWriteMany",
                  "read-write, many nodes"
                ],
                [
                  "`RWOP` ReadWriteOncePod",
                  "one Pod only"
                ]
              ],
              "frame": "dashed"
            },
            {
              "type": "heading",
              "text": "3. Example: 1Gi Claim",
              "ink": "purple"
            },
            {
              "type": "bullets",
              "items": [
                "Pod mounts the claim via `claimName` plus `volumeMounts`"
              ],
              "style": "dot"
            },
            {
              "type": "code",
              "lang": "yaml",
              "lines": [
                "kind: PersistentVolumeClaim",
                "metadata: {name: data}",
                "spec:",
                "  accessModes: [ReadWriteOnce]",
                "  resources:",
                "    requests: {storage: 1Gi}"
              ],
              "note": "the claim"
            },
            {
              "type": "code",
              "lang": "yaml",
              "lines": [
                "volumes:",
                "- name: d",
                "  persistentVolumeClaim:",
                "    claimName: data",
                "# in the container:",
                "volumeMounts: [{name: d, mountPath: /data}]"
              ],
              "note": "the Pod"
            },
            {
              "type": "heading",
              "text": "4. Gotchas",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "PVC `Pending`: no matching PV or StorageClass",
                "`Delete` reclaimPolicy wipes data with the PVC",
                "`Retain`: PV goes `Released`, no rebind until `claimRef` cleared"
              ],
              "style": "cross",
              "frame": "dashed",
              "ink": "red"
            }
          ]
        }
      ]
    },
    {
      "title": "StorageClasses and Dynamic Provisioning",
      "role": "outline",
      "outlineIndex": 2,
      "pages": [
        {
          "title": "StorageClasses and Dynamic Provisioning",
          "blocks": [
            {
              "type": "heading",
              "text": "1. What a StorageClass Holds",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "PVC with `storageClassName` ==creates its PV== automatically",
                "Default class: annotation `storageclass.kubernetes.io/is-default-class: \"true\"`",
                "`storageClassName: \"\"` turns dynamic provisioning ==off=="
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "blue"
            },
            {
              "type": "code",
              "lang": "yaml",
              "lines": [
                "kind: StorageClass",
                "metadata: {name: fast}",
                "provisioner: ebs.csi.aws.com",
                "parameters: {type: gp3}",
                "reclaimPolicy: Delete",
                "volumeBindingMode: WaitForFirstConsumer",
                "allowVolumeExpansion: true"
              ],
              "note": "names a provisioner, then holds its settings"
            },
            {
              "type": "heading",
              "text": "2. Binding and Provisioning",
              "ink": "purple"
            },
            {
              "type": "table",
              "headers": [
                "Mode",
                "Binds when",
                "Effect"
              ],
              "rows": [
                [
                  "`Immediate`",
                  "PVC created",
                  "zone mismatch risk"
                ],
                [
                  "`WaitForFirstConsumer`",
                  "Pod scheduled",
                  "PV matches Pod's zone"
                ]
              ],
              "highlightRow": 1
            },
            {
              "type": "table",
              "headers": [
                "",
                "Static",
                "Dynamic"
              ],
              "rows": [
                [
                  "PV made by",
                  "Admin, by hand",
                  "Class, on demand"
                ],
                [
                  "Needs class",
                  "No",
                  "Yes"
                ]
              ]
            },
            {
              "type": "bullets",
              "items": [
                "Expand: raise PVC `requests.storage`, ==never lower==",
                "Needs `allowVolumeExpansion: true`"
              ],
              "style": "check"
            },
            {
              "type": "heading",
              "text": "3. Gotchas",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "Dynamic PVs default to reclaimPolicy ==Delete==",
                "`storageClassName` cannot change on an existing PVC",
                "No default class and none named: PVC stays ==Pending=="
              ],
              "style": "cross",
              "frame": "dashed",
              "ink": "red"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Remember",
              "text": "Class name on the PVC means **dynamic**. Empty string means ==static only==."
            }
          ]
        }
      ]
    },
    {
      "title": "StatefulSets: Stable Identity and Storage",
      "role": "outline",
      "outlineIndex": 3,
      "pages": [
        {
          "title": "StatefulSets: Stable Identity and Storage",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Identity and Order",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "Pods named ==name-0== to ==name-N-1==",
                "DNS: `web-0.web.<ns>.svc.cluster.local`",
                "Needs a **headless Service** (`clusterIP: None`) set in `spec.serviceName`",
                "`podManagementPolicy: Parallel` drops the ordering"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "Create",
                    "sub": "0 to N-1",
                    "ink": "green"
                  },
                  {
                    "text": "Terminate",
                    "sub": "N-1 to 0",
                    "ink": "red"
                  }
                ]
              }
            },
            {
              "type": "heading",
              "text": "2. Storage per Pod",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "`volumeClaimTemplates` make ==one PVC per Pod==, e.g. `data-web-0`",
                "The PVC **reattaches** to the same-named Pod after a reschedule"
              ],
              "style": "dot"
            },
            {
              "type": "code",
              "lang": "yaml",
              "lines": [
                "serviceName: web",
                "volumeClaimTemplates:",
                "- metadata: {name: data}",
                "  spec:",
                "    accessModes: [ReadWriteOnce]",
                "    resources: {requests: {storage: 1Gi}}"
              ]
            },
            {
              "type": "table",
              "headers": [
                "",
                "Deployment",
                "StatefulSet"
              ],
              "rows": [
                [
                  "Pods",
                  "interchangeable",
                  "**unique**"
                ],
                [
                  "Volume",
                  "one shared claim",
                  "own PVC each"
                ],
                [
                  "Fits",
                  "stateless apps",
                  "databases, brokers"
                ]
              ],
              "highlightRow": 1
            },
            {
              "type": "heading",
              "text": "3. Gotchas",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "Scale-down or delete **keeps PVCs**: clean up by hand or set `persistentVolumeClaimRetentionPolicy`",
                "Rolling updates go from the ==highest ordinal== down"
              ],
              "style": "cross",
              "frame": "dashed",
              "ink": "red"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Canary",
              "text": "`updateStrategy.rollingUpdate.partition: 2` holds back ordinals below 2 on the old revision."
            }
          ]
        }
      ]
    },
    {
      "title": "DaemonSets, Jobs and CronJobs",
      "role": "outline",
      "outlineIndex": 4,
      "pages": [
        {
          "title": "DaemonSets, Jobs and CronJobs",
          "blocks": [
            {
              "type": "heading",
              "text": "1. DaemonSet",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "==One Pod per matching node==",
                "Use for log shippers, node monitors, CNI agents",
                "New node joins: Pod added automatically",
                "`nodeSelector` limits which nodes qualify"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "heading",
              "text": "2. Job and CronJob",
              "ink": "blue"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "CronJob",
                    "sub": "cron schedule",
                    "ink": "blue"
                  },
                  {
                    "text": "Job",
                    "sub": "runs to completion",
                    "ink": "green"
                  },
                  {
                    "text": "Pods",
                    "sub": "retried on failure",
                    "ink": "orange"
                  }
                ]
              }
            },
            {
              "type": "table",
              "headers": [
                "Field",
                "Sets"
              ],
              "rows": [
                [
                  "`completions`",
                  "successes needed"
                ],
                [
                  "`parallelism`",
                  "Pods running at once"
                ],
                [
                  "`backoffLimit`",
                  "retries, default ==6=="
                ],
                [
                  "`restartPolicy`",
                  "OnFailure or Never"
                ],
                [
                  "`concurrencyPolicy`",
                  "Allow, Forbid or Replace"
                ],
                [
                  "`startingDeadlineSeconds`",
                  "limit on late starts"
                ],
                [
                  "`timeZone`",
                  "zone for the schedule"
                ]
              ]
            },
            {
              "type": "heading",
              "text": "3. Which Controller?",
              "ink": "purple"
            },
            {
              "type": "table",
              "headers": [
                "Need",
                "Controller"
              ],
              "rows": [
                [
                  "Stateless replicas",
                  "Deployment"
                ],
                [
                  "Stable identity and storage",
                  "StatefulSet"
                ],
                [
                  "One Pod per node",
                  "DaemonSet"
                ],
                [
                  "Run-once work",
                  "Job"
                ],
                [
                  "Scheduled work",
                  "CronJob"
                ]
              ],
              "highlightRow": 2
            },
            {
              "type": "heading",
              "text": "4. Gotchas",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "Finished Jobs and Pods stay until `ttlSecondsAfterFinished` is set",
                "DaemonSet skips tainted nodes (control plane) without tolerations",
                "`restartPolicy: Always` is rejected for Jobs"
              ],
              "style": "cross",
              "frame": "dashed",
              "ink": "red"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Remember",
              "text": "Job Pods must end: `restartPolicy` is ==OnFailure== or ==Never==."
            }
          ]
        }
      ]
    },
    {
      "title": "Storage and Controllers Cheat Sheet",
      "role": "outline",
      "outlineIndex": 5,
      "pages": [
        {
          "title": "Storage and Controllers Cheat Sheet",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Inspect and retain",
              "ink": "blue"
            },
            {
              "type": "code",
              "lang": "bash",
              "lines": [
                "kubectl get pv,pvc,sc",
                "kubectl describe pvc <name>",
                "kubectl patch pv <name> -p '{\"spec\":{\"persistentVolumeReclaimPolicy\":\"Retain\"}}'"
              ],
              "note": "describe shows the Events behind a Pending claim; patch before deleting a claim you may need back"
            },
            {
              "type": "heading",
              "text": "2. StatefulSet ops and one-offs",
              "ink": "purple"
            },
            {
              "type": "code",
              "lang": "bash",
              "lines": [
                "kubectl get sts",
                "kubectl scale sts <name> --replicas=N",
                "kubectl rollout status sts/<name>",
                "kubectl delete pvc -l app=<label>",
                "kubectl create job <name> --image=<img> -- <cmd>",
                "kubectl create job <name> --from=cronjob/<cron>",
                "kubectl logs job/<name>"
              ],
              "note": "delete pvc removes leftover claims; --from=cronjob triggers a CronJob now"
            },
            {
              "type": "heading",
              "text": "3. Quick map",
              "ink": "green"
            },
            {
              "type": "table",
              "headers": [
                "Setting",
                "Values"
              ],
              "rows": [
                [
                  "Access modes",
                  "==RWO==, ==ROX==, ==RWX==, ==RWOP=="
                ],
                [
                  "Binding modes",
                  "`Immediate`, `WaitForFirstConsumer`"
                ],
                [
                  "Reclaim policies",
                  "`Delete`, `Retain`"
                ],
                [
                  "`kubectl get ds`",
                  "per-node DaemonSet coverage"
                ]
              ],
              "frame": "dashed"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Before deleting a claim",
              "text": "==Delete== wipes the data with the PVC. Patch the PV to ==Retain== first. Scaling a StatefulSet down keeps its PVCs."
            }
          ]
        }
      ]
    },
    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "A PVC sets `storageClassName: \"\"` and no PV matches its size. What status does it show, and why?",
              "a_bullets": [
                "{red:Pending}",
                "`\"\"` turns dynamic provisioning off, so only a hand-made matching PV can bind"
              ]
            },
            {
              "type": "qa",
              "q": "A 3-replica StatefulSet with a volumeClaimTemplate is scaled to 1, then back to 3. What happens to web-2's data?",
              "a_bullets": [
                "The PVCs survive the scale-down",
                "web-2 returns and reattaches `data-web-2`, so the data is {green:intact}"
              ]
            },
            {
              "type": "qa",
              "q": "A Job manifest sets `restartPolicy: Always`. What is the bug?",
              "a_bullets": [
                "The API server rejects it",
                "Jobs need `OnFailure` or `Never`; Always would restart finished Pods forever"
              ]
            }
          ]
        }
      ]
    }
  ]
}