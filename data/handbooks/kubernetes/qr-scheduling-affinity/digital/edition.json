  "sections": [
    {
      "title": "Scheduling Mental Model",
      "role": "outline",
      "outlineIndex": 0,
      "pages": [
        {
          "title": "Scheduling Mental Model",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Two Phases per Pod",
              "ink": "green"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "Filter",
                    "sub": "drop nodes that cannot fit",
                    "ink": "red"
                  },
                  {
                    "text": "Score",
                    "sub": "rank survivors",
                    "ink": "blue"
                  },
                  {
                    "text": "Bind",
                    "sub": "pod goes to top node",
                    "ink": "green"
                  }
                ]
              }
            },
            {
              "type": "bullets",
              "items": [
                "No node passes filtering → pod stays ==Pending==",
                "Reason shows as a `FailedScheduling` event"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "heading",
              "text": "2. Pull and Push",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "",
                "Tools",
                "Effect"
              ],
              "rows": [
                [
                  "{green:Attraction}",
                  "`nodeSelector`, node affinity, pod affinity",
                  "pull pods toward nodes"
                ],
                [
                  "{red:Repulsion}",
                  "taints, pod anti-affinity",
                  "push pods away"
                ]
              ]
            },
            {
              "type": "bullets",
              "items": [
                "Taints live on **nodes**; tolerations live on **pods**",
                "A toleration only ==permits== a node",
                "It never ==attracts== the pod to that node"
              ],
              "style": "dot"
            },
            {
              "type": "heading",
              "text": "3. Decided Once",
              "ink": "orange"
            },
            {
              "type": "bullets",
              "items": [
                "Placement happens ==once==, when the pod is scheduled",
                "`IgnoredDuringExecution`: later label changes do **not** evict running pods"
              ],
              "style": "check"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Toleration is not a magnet",
              "text": "A tolerating pod can still land on any untainted node. To steer it, add ==nodeSelector== or affinity."
            }
          ]
        }
      ]
    },
    {
      "title": "nodeSelector and Node Affinity",
      "role": "outline",
      "outlineIndex": 1,
      "pages": [
        {
          "title": "nodeSelector and Node Affinity",
          "blocks": [
            {
              "type": "heading",
              "text": "1. nodeSelector",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "Exact ==key=value== label match in the pod spec",
                "Several entries are {blue:ANDed}",
                "Simplest **hard** constraint"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "code",
              "lang": "yaml",
              "lines": [
                "# kubectl label node worker-1 disktype=ssd",
                "spec:",
                "  nodeSelector:",
                "    disktype: ssd"
              ],
              "note": "label the node first, then select it"
            },
            {
              "type": "heading",
              "text": "2. Required vs Preferred",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "",
                "Hard",
                "Soft"
              ],
              "rows": [
                [
                  "Field",
                  "`requiredDuringSchedulingIgnoredDuringExecution`",
                  "`preferredDuringSchedulingIgnoredDuringExecution`"
                ],
                [
                  "No match",
                  "{red:Pending}",
                  "{green:Still scheduled}"
                ],
                [
                  "Weight",
                  "none",
                  "==1-100==, added to node score"
                ]
              ],
              "frame": "dashed"
            },
            {
              "type": "heading",
              "text": "3. Operators and Combining",
              "ink": "purple"
            },
            {
              "type": "bullets",
              "items": [
                "Operators: `In`, `NotIn`, `Exists`, `DoesNotExist`, `Gt`, `Lt`",
                "==NotIn== and ==DoesNotExist== give node **anti-affinity**"
              ],
              "style": "dot"
            },
            {
              "type": "bullets",
              "items": [
                "Several `nodeSelectorTerms` are ==ORed==",
                "`matchExpressions` inside one term are ==ANDed==",
                "nodeSelector plus affinity: **both** must match"
              ],
              "style": "check",
              "ink": "purple"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "IgnoredDuringExecution",
              "text": "Rules apply only at placement. Later node label changes never evict running pods."
            }
          ]
        }
      ]
    },
    {
      "title": "Pod Affinity and Anti-Affinity",
      "role": "outline",
      "outlineIndex": 2,
      "pages": [
        {
          "title": "Pod Affinity and Anti-Affinity",
          "blocks": [
            {
              "type": "heading",
              "text": "1. What They Do",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "==Pod affinity==: land in the same domain as pods matching a `labelSelector`",
                "==Pod anti-affinity==: stay out of that domain",
                "`topologyKey` is **required**: it picks the domain"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "heading",
              "text": "2. topologyKey",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "topologyKey",
                "Domain"
              ],
              "rows": [
                [
                  "`kubernetes.io/hostname`",
                  "per **node**"
                ],
                [
                  "`topology.kubernetes.io/zone`",
                  "per **zone**"
                ]
              ]
            },
            {
              "type": "heading",
              "text": "3. Spreading Replicas",
              "ink": "purple"
            },
            {
              "type": "code",
              "lang": "yaml",
              "lines": [
                "podAntiAffinity:",
                "  requiredDuringSchedulingIgnoredDuringExecution:",
                "  - labelSelector:",
                "      matchLabels: {app: web}",
                "    topologyKey: kubernetes.io/hostname"
              ],
              "note": "one web replica per node"
            },
            {
              "type": "bullets",
              "items": [
                "{red:required} + hostname on 3 nodes: the ==4th replica stays Pending==",
                "{green:preferred} + `weight` (1-100): best-effort spread, scale-out never blocked"
              ],
              "style": "check"
            },
            {
              "type": "heading",
              "text": "4. Mistakes",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "Pod affinity is ==costly at scale== in large clusters",
                "`labelSelector` must match the **target** pods' labels, not the pod's own"
              ],
              "style": "cross",
              "frame": "dashed",
              "ink": "red"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Namespaces",
              "text": "The selector only matches pods in the pod's **own namespace** by default. Set ==namespaces== to widen it."
            }
          ]
        }
      ]
    },
    {
      "title": "Taints, Tolerations and Effects",
      "role": "outline",
      "outlineIndex": 3,
      "pages": [
        {
          "title": "Taints, Tolerations and Effects",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Taint and Toleration",
              "ink": "blue"
            },
            {
              "type": "code",
              "lang": "bash",
              "lines": [
                "kubectl taint nodes node1 key=value:NoSchedule",
                "kubectl taint nodes node1 key=value:NoSchedule-"
              ],
              "note": "trailing minus removes the taint"
            },
            {
              "type": "bullets",
              "items": [
                "Toleration fields: ==key==, ==operator== (Equal or Exists), ==value==, ==effect==",
                "Operator `Exists` with **no key** tolerates every taint"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "blue"
            },
            {
              "type": "heading",
              "text": "2. The Three Effects",
              "ink": "purple"
            },
            {
              "type": "table",
              "headers": [
                "Effect",
                "New pods",
                "Running pods"
              ],
              "rows": [
                [
                  "`NoSchedule`",
                  "blocked",
                  "{green:left alone}"
                ],
                [
                  "`PreferNoSchedule`",
                  "avoided if possible (soft)",
                  "left alone"
                ],
                [
                  "`NoExecute`",
                  "blocked",
                  "{red:evicted}"
                ]
              ],
              "highlightRow": 2
            },
            {
              "type": "bullets",
              "items": [
                "`tolerationSeconds` delays `NoExecute` eviction by that many seconds"
              ],
              "style": "check",
              "ink": "purple"
            },
            {
              "type": "heading",
              "text": "3. Built-in Taints",
              "ink": "orange"
            },
            {
              "type": "bullets",
              "items": [
                "Control plane: `node-role.kubernetes.io/control-plane:NoSchedule`",
                "Node controller adds `not-ready` and `unreachable` as ==NoExecute==",
                "Pods get a default ==300s== toleration injected for both"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "orange"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Remember",
              "text": "A toleration only **permits** a node. It never attracts the pod there."
            }
          ]
        }
      ]
    },
    {
      "title": "Topology Spread and Resource Requests",
      "role": "outline",
      "outlineIndex": 4,
      "pages": [
        {
          "title": "Topology Spread and Resource Requests",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Topology Spread",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "Fields: `maxSkew`, `topologyKey`, `whenUnsatisfiable`, `labelSelector`",
                "`DoNotSchedule` = hard, pod stays Pending; `ScheduleAnyway` = soft",
                "==maxSkew== = max gap in matching pods, fullest vs emptiest domain",
                "`maxSkew: 1` across zones = {green:even spread}"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "blue"
            },
            {
              "type": "code",
              "lang": "yaml",
              "lines": [
                "topologySpreadConstraints:",
                "- maxSkew: 1",
                "  topologyKey: topology.kubernetes.io/zone",
                "  whenUnsatisfiable: DoNotSchedule",
                "  labelSelector:",
                "    matchLabels: {app: web}"
              ],
              "note": "balance app=web pods across zones"
            },
            {
              "type": "table",
              "headers": [
                "",
                "Topology spread",
                "Anti-affinity"
              ],
              "rows": [
                [
                  "Result",
                  "**balanced** across domains",
                  "**max one** per domain"
                ],
                [
                  "HA across zones",
                  "{green:better}",
                  "blocks extra replicas"
                ]
              ]
            },
            {
              "type": "heading",
              "text": "2. Requests Drive Placement",
              "ink": "purple"
            },
            {
              "type": "bullets",
              "items": [
                "Scheduler sums pod ==requests==, not limits or live usage",
                "Compared against node **allocatable**",
                "Too high: {red:Pending}, `Insufficient cpu/memory`"
              ],
              "style": "dot"
            },
            {
              "type": "heading",
              "text": "3. QoS Class",
              "ink": "orange"
            },
            {
              "type": "table",
              "headers": [
                "Requests",
                "QoS class",
                "Eviction"
              ],
              "rows": [
                [
                  "equal limits",
                  "==Guaranteed==",
                  "last"
                ],
                [
                  "below limits",
                  "Burstable",
                  "middle"
                ],
                [
                  "none set",
                  "BestEffort",
                  "{red:first}"
                ]
              ]
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Requests, not usage",
              "text": "Placement and QoS both come from ==requests==. A node full of requests is full, even when it is idle."
            }
          ]
        }
      ]
    },
    {
      "title": "Scheduling Cheat Sheet",
      "role": "outline",
      "outlineIndex": 5,
      "pages": [
        {
          "title": "Scheduling Cheat Sheet",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Debug a Pending Pod",
              "ink": "red"
            },
            {
              "type": "code",
              "lang": "bash",
              "lines": [
                "kubectl describe pod <name>",
                "kubectl get nodes --show-labels",
                "kubectl describe node <n> | grep -i taint"
              ],
              "note": "Events show FailedScheduling reasons; then check labels and taints"
            },
            {
              "type": "bullets",
              "items": [
                "Read the ==Events== at the bottom for the **FailedScheduling** reason",
                "Compare node labels with your `nodeSelector` or affinity",
                "Compare node taints with your pod's tolerations"
              ],
              "style": "check"
            },
            {
              "type": "heading",
              "text": "2. Which Tool?",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "Goal",
                "Use"
              ],
              "rows": [
                [
                  "Pin to a node type",
                  "`nodeSelector` or node affinity"
                ],
                [
                  "Co-locate or separate pods",
                  "pod affinity or anti-affinity"
                ],
                [
                  "Reserve nodes",
                  "taint + toleration + `nodeSelector`"
                ]
              ],
              "highlightRow": 2
            },
            {
              "type": "heading",
              "text": "3. Dedicated Nodes",
              "ink": "purple"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "Taint node",
                    "sub": "keeps others out",
                    "ink": "red"
                  },
                  {
                    "text": "Toleration",
                    "sub": "permits your pods",
                    "ink": "orange"
                  },
                  {
                    "text": "nodeSelector / affinity",
                    "sub": "pulls your pods in",
                    "ink": "green"
                  }
                ]
              }
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Need BOTH",
              "text": "A taint alone only keeps others out. A toleration never attracts. Add ==nodeSelector or node affinity== to pull your pods in."
            },
            {
              "type": "heading",
              "text": "4. Taint Effects",
              "ink": "orange"
            },
            {
              "type": "table",
              "headers": [
                "Effect",
                "Behaviour"
              ],
              "rows": [
                [
                  "`NoSchedule`",
                  "block **new** pods only"
                ],
                [
                  "`PreferNoSchedule`",
                  "avoid if possible"
                ],
                [
                  "`NoExecute`",
                  "block new and **evict** existing"
                ]
              ]
            }
          ]
        }
      ]
    },
    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "A node has the taint `gpu=true:NoSchedule`. Your pod tolerates it and has no nodeSelector. Will it land on that node?",
              "a_bullets": [
                "Not necessarily: a toleration only **permits** the node.",
                "The pod can go to any node that passes filtering.",
                "Add a nodeSelector or node affinity to pull it in."
              ]
            },
            {
              "type": "qa",
              "q": "A Deployment has 4 replicas with required pod anti-affinity on `kubernetes.io/hostname`. The cluster has 3 nodes. What happens?",
              "a_bullets": [
                "3 pods run, one per node; the 4th stays Pending with FailedScheduling.",
                "Fix: use preferred anti-affinity or topology spread with `ScheduleAnyway`."
              ]
            },
            {
              "type": "qa",
              "q": "A node has 4 CPU allocatable. Two pods each request 3 CPU, limit 4, and use 0.1 CPU. Do both schedule there?",
              "a_bullets": [
                "No: the second is Pending with `Insufficient cpu`.",
                "The scheduler sums requests (3+3 > 4), not limits or live usage."
              ]
            }
          ]
        }
      ]
    }
  ]
}