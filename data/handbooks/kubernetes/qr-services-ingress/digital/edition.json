    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "A Service has selector `app: web, tier: be`. Pods are labeled `app=web, tier=fe`. What does `kubectl get endpoints web` show?",
              "a_bullets": [
                "No endpoints. Selector keys are ANDed, so `tier` must match too.",
                "Traffic gets refused or times out."
              ]
            },
            {
              "type": "qa",
              "q": "Service `port: 80, targetPort: 80`, but the container listens on 8080. Endpoints are listed. Do requests work?",
              "a_bullets": [
                "No. Traffic goes to Pod port 80 and is refused.",
                "Fix: set `targetPort: 8080`."
              ]
            },
            {
              "type": "qa",
              "q": "An Ingress with `ingressClassName: nginx` exists, but nothing answers. What is the likely cause?",
              "a_bullets": [
                "No ingress controller is installed, so the Ingress is silently ignored.",
                "Install a controller that matches the class."
              ]
            }
          ]
        }
      ]
