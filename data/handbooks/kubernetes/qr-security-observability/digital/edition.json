  "sections": [
    {
      "title": "securityContext: Hardening a Pod",
      "role": "outline",
      "outlineIndex": 1,
      "pages": [
        {
          "title": "securityContext: Hardening a Pod",
          "blocks": [
            {
              "type": "heading",
              "text": "1. What securityContext Is",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "==securityContext== sets privilege and access controls",
                "Pod-level `spec.securityContext` applies to **all containers**",
                "Container-level setting ==overrides== the pod-level one"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "heading",
              "text": "2. Users and Filesystem",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "Field",
                "Effect",
                "Level"
              ],
              "rows": [
                [
                  "`runAsNonRoot`",
                  "kubelet refuses a UID 0 image",
                  "either"
                ],
                [
                  "`runAsUser` / `runAsGroup`",
                  "set the UID / GID",
                  "either"
                ],
                [
                  "`fsGroup`",
                  "group owner of mounted volumes",
                  "{orange:pod only}"
                ],
                [
                  "`readOnlyRootFilesystem`",
                  "blocks writes to container FS",
                  "container"
                ]
              ]
            },
            {
              "type": "bullets",
              "items": [
                "`runAsNonRoot: true` only **checks**, it never changes the user",
                "Root image fails: `CreateContainerConfigError`",
                "To pass: set `runAsUser` to a ==non-zero UID== or use a non-root `USER` in the image",
                "Read-only root: mount an `emptyDir` at `/tmp` for write paths"
              ],
              "style": "check"
            },
            {
              "type": "heading",
              "text": "3. Lock Down the Container",
              "ink": "purple"
            },
            {
              "type": "code",
              "lang": "yaml",
              "lines": [
                "securityContext:",
                "  runAsNonRoot: true",
                "  runAsUser: 1000",
                "  readOnlyRootFilesystem: true",
                "  allowPrivilegeEscalation: false",
                "  capabilities:",
                "    drop: [\"ALL\"]",
                "    add: [\"NET_BIND_SERVICE\"]"
              ],
              "note": "drop ALL first, add back only what is needed"
            },
            {
              "type": "bullets",
              "items": [
                "`allowPrivilegeEscalation: false` blocks setuid gains",
                "{red:privileged: true} gives near-host access: avoid it"
              ],
              "style": "cross",
              "frame": "dashed",
              "ink": "red"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Hardening trio",
              "text": "==runAsNonRoot== + ==readOnlyRootFilesystem== + ==drop ALL=="
            }
          ]
        }
      ]
    },
    {
      "title": "Pod Security Standards and Admission",
      "role": "outline",
      "outlineIndex": 2,
      "pages": [
        {
          "title": "Pod Security Standards and Admission",
          "blocks": [
            {
              "type": "heading",
              "text": "1. The Three PSS Levels",
              "ink": "green"
            },
            {
              "type": "table",
              "headers": [
                "Level",
                "Meaning"
              ],
              "rows": [
                [
                  "`privileged`",
                  "{red:Unrestricted}"
                ],
                [
                  "`baseline`",
                  "Blocks known escalations: `hostNetwork`, `privileged`, `hostPath`"
                ],
                [
                  "`restricted`",
                  "{green:Hardened}: non-root, drop `ALL`, seccomp `RuntimeDefault`"
                ]
              ],
              "highlightRow": 2
            },
            {
              "type": "heading",
              "text": "2. Pod Security Admission",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "==PSA== is the built-in controller enforcing PSS per **namespace**",
                "Replaced the removed ==PodSecurityPolicy==",
                "Label: `pod-security.kubernetes.io/<mode>=<level>`"
              ],
              "style": "dot"
            },
            {
              "type": "table",
              "headers": [
                "Mode",
                "Effect"
              ],
              "rows": [
                [
                  "`enforce`",
                  "{red:Rejects} the Pod"
                ],
                [
                  "`audit`",
                  "Logs to the audit log"
                ],
                [
                  "`warn`",
                  "Shows the user a warning"
                ]
              ]
            },
            {
              "type": "heading",
              "text": "3. Rollout and Limits",
              "ink": "orange"
            },
            {
              "type": "diagram",
              "kind": "chain",
              "spec": {
                "steps": [
                  {
                    "text": "warn + audit",
                    "note": "set to restricted",
                    "ink": "blue"
                  },
                  {
                    "text": "Fix violations",
                    "ink": "orange"
                  },
                  {
                    "text": "enforce",
                    "note": "last",
                    "ink": "green"
                  }
                ]
              }
            },
            {
              "type": "code",
              "lang": "bash",
              "lines": [
                "kubectl label ns dev pod-security.kubernetes.io/enforce=restricted"
              ]
            },
            {
              "type": "bullets",
              "items": [
                "PSA checks ==Pods only==: a Deployment is created, its Pods are rejected",
                "Errors show in ==ReplicaSet events==",
                "Custom rules: use Kyverno or Gatekeeper"
              ],
              "style": "cross"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Safe order",
              "text": "Never start with `enforce`. Warn and audit first, then enforce."
            }
          ]
        }
      ]
    },
    {
      "title": "metrics-server and kubectl top",
      "role": "outline",
      "outlineIndex": 3,
      "pages": [
        {
          "title": "metrics-server and kubectl top",
          "blocks": [
            {
              "type": "heading",
              "text": "1. What metrics-server Is",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "Collects ==CPU and memory== from each **kubelet**",
                "Serves them via the `metrics.k8s.io` API",
                "{blue:In-memory only}: no history, nothing stored",
                "Powers `kubectl top` and the ==Horizontal Pod Autoscaler==",
                "**Not** a monitoring system"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "heading",
              "text": "2. Reading kubectl top",
              "ink": "blue"
            },
            {
              "type": "code",
              "lang": "bash",
              "lines": [
                "kubectl top nodes",
                "kubectl top pods -A",
                "kubectl top pod NAME --containers",
                "kubectl top pods -A --sort-by=cpu"
              ],
              "note": "--sort-by also takes memory"
            },
            {
              "type": "table",
              "headers": [
                "Value",
                "Unit",
                "Reads as"
              ],
              "rows": [
                [
                  "CPU",
                  "millicores",
                  "`250m` = 0.25 core"
                ],
                [
                  "Memory",
                  "`Mi`",
                  "mebibytes in use"
                ],
                [
                  "Both",
                  "recent average",
                  "brief ==spikes are missed=="
                ]
              ]
            },
            {
              "type": "heading",
              "text": "3. When It Fails",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "**Metrics API not available** = metrics-server missing or unhealthy",
                "Check its Deployment in the `kube-system` namespace",
                "Local clusters often need the ==--kubelet-insecure-tls== flag"
              ],
              "style": "cross",
              "frame": "dashed",
              "ink": "red"
            },
            {
              "type": "code",
              "lang": "bash",
              "lines": [
                "kubectl get deploy metrics-server -n kube-system"
              ]
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Remember",
              "text": "`kubectl top` shows ==now==, not history. For trends, use Prometheus."
            }
          ]
        }
      ]
    },
    {
      "title": "Logs and Events",
      "role": "outline",
      "outlineIndex": 4,
      "pages": [
        {
          "title": "Logs and Events",
          "blocks": [
            {
              "type": "heading",
              "text": "1. kubectl logs",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "`kubectl logs POD` reads container ==stdout/stderr== from the node",
                "`--previous` shows the last crashed container: ==first step== for {red:CrashLoopBackOff}"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "code",
              "lang": "bash",
              "lines": [
                "kubectl logs web-1 -c app -f",
                "kubectl logs web-1 --tail=100 --since=1h",
                "kubectl logs -l app=web",
                "kubectl logs web-1 --previous"
              ],
              "note": "-c container, -f follow, -l label selector"
            },
            {
              "type": "bullets",
              "items": [
                "Logs vanish when the pod is **deleted** or the node rotates them",
                "Production needs a ==log collector== (Fluent Bit, Loki) shipping to central storage"
              ],
              "style": "cross",
              "ink": "red"
            },
            {
              "type": "heading",
              "text": "2. Events",
              "ink": "blue"
            },
            {
              "type": "code",
              "lang": "bash",
              "lines": [
                "kubectl describe pod web-1",
                "kubectl get events --sort-by=.lastTimestamp -n NS"
              ],
              "note": "describe ends with the Events section"
            },
            {
              "type": "bullets",
              "items": [
                "Events show scheduling, image pull, probe failures, ==OOMKilled=="
              ],
              "style": "dot"
            },
            {
              "type": "table",
              "headers": [
                "",
                "Logs",
                "Events"
              ],
              "rows": [
                [
                  "Answer",
                  "What the **app** said",
                  "What **Kubernetes** did"
                ],
                [
                  "Command",
                  "`kubectl logs`",
                  "`describe` / `get events`"
                ]
              ],
              "frame": "dashed"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Check events early",
              "text": "Events expire after about ==1 hour==, so read them soon after a failure."
            }
          ]
        }
      ]
    },
    {
