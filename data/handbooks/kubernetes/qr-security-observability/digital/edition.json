    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "A pod sets `runAsNonRoot: true` but no `runAsUser`, and its image runs as UID 0. What happens?",
              "a_bullets": [
                "**Kubelet refuses to start the container**; the pod shows an error such as `CreateContainerConfigError`.",
                "Why: `runAsNonRoot` only checks the UID, it never switches the user. Add `runAsUser: 1000`."
              ]
            },
            {
              "type": "qa",
              "q": "A namespace has `enforce=restricted`. You apply a Deployment whose pods run as root. What do you see?",
              "a_bullets": [
                "**The Deployment is created, but no pods appear.**",
                "Why: admission checks Pods only, so the ReplicaSet's pod creations are rejected.",
                "Read the errors with `kubectl describe rs`."
              ]
            },
            {
              "type": "qa",
              "q": "`kubectl top pods` says 'Metrics API not available'. Where do you look?",
              "a_bullets": [
                "**metrics-server is missing or unhealthy.**",
                "Why: `kubectl top` reads `metrics.k8s.io`, served by metrics-server.",
                "Check its Deployment in `kube-system`."
              ]
            }
          ]
        }
      ]
    }
