    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "A handler runs `express.json()`, then computes the HMAC over `JSON.stringify(req.body)`. Valid webhooks sometimes fail verification. Why?",
              "a_bullets": [
                "Re-serializing can change whitespace and key order, so the bytes differ from what was signed.",
                "Verify against the ==raw body== bytes, before any parsing."
              ]
            },
            {
              "type": "qa",
              "q": "The handler does SELECT on `event_id`, and if no row exists it charges the customer and then INSERTs the ID. Two retries arrive together. What happens?",
              "a_bullets": [
                "Both SELECTs find nothing, so the customer is charged twice.",
                "Insert into a UNIQUE column in the same transaction as the charge. On a duplicate-key error, skip and return 200."
              ]
            },
            {
              "type": "qa",
              "q": "A dashboard labels request metrics by raw URL such as `/users/8431` and alerts on average latency. What two things are wrong?",
              "a_bullets": [
                "Raw URLs create endless time series. Label by route template `/users/:id`.",
                "The average hides slow tail requests. Alert on p95/p99 from a histogram."
              ]
            }
          ]
        }
      ]
