  "sections": [
    {
      "title": "The Request-Response Mental Model",
      "role": "outline",
      "outlineIndex": 0,
      "pages": [
        {
          "title": "The Request-Response Mental Model",
          "blocks": [
            {
              "type": "heading",
              "text": "1. The Exchange",
              "ink": "green"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "Request",
                    "sub": "method + URL + headers + body?",
                    "ink": "blue"
                  },
                  {
                    "text": "Response",
                    "sub": "status line + headers + body?",
                    "ink": "green"
                  }
                ]
              }
            },
            {
              "type": "table",
              "headers": [
                "Part",
                "Tells you"
              ],
              "rows": [
                [
                  "**Method**",
                  "what to do"
                ],
                [
                  "**URL**",
                  "to which resource"
                ],
                [
                  "**Status code**",
                  "how it went"
                ]
              ],
              "frame": "dashed"
            },
            {
              "type": "heading",
              "text": "2. Nouns in URLs, Verbs as Methods",
              "ink": "purple"
            },
            {
              "type": "bullets",
              "items": [
                "Resources are ==nouns==: `/users/42`",
                "Methods are the ==verbs==: GET, POST, PUT, PATCH, DELETE"
              ],
              "style": "dot"
            },
            {
              "type": "table",
              "headers": [
                "Avoid",
                "Use"
              ],
              "rows": [
                [
                  "`GET /getUser?id=42`",
                  "`GET /users/42`"
                ],
                [
                  "`POST /deleteUser`",
                  "`DELETE /users/42`"
                ]
              ]
            },
            {
              "type": "heading",
              "text": "3. Stateless and Self-Contained",
              "ink": "orange"
            },
            {
              "type": "bullets",
              "items": [
                "HTTP is ==stateless==: the server keeps no memory between requests",
                "Each request is {blue:self-contained}",
                "Auth and context travel in headers: `Authorization`, `Cookie`"
              ],
              "style": "dot"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Method semantics are a contract",
              "text": "Clients, caches and proxies rely on them for retrying and caching. Break them (a GET that deletes data) and you get ==real bugs==."
            }
          ]
        }
      ]
    },
    {
      "title": "GET, POST, PUT, PATCH and DELETE Semantics",
      "role": "outline",
      "outlineIndex": 1,
      "pages": [
        {
          "title": "GET, POST, PUT, PATCH and DELETE Semantics",
          "blocks": [
            {
              "type": "heading",
              "text": "1. The five verbs",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "Method",
                "URL",
                "Body",
                "Success"
              ],
              "rows": [
                [
                  "GET",
                  "`/users/42`",
                  "none",
                  "200"
                ],
                [
                  "POST",
                  "`/users`",
                  "new resource",
                  "201"
                ],
                [
                  "PUT",
                  "`/users/42`",
                  "full copy",
                  "200 or 204"
                ],
                [
                  "PATCH",
                  "`/users/42`",
                  "changed fields",
                  "200"
                ],
                [
                  "DELETE",
                  "`/users/42`",
                  "none",
                  "204 or 200"
                ]
              ]
            },
            {
              "type": "heading",
              "text": "2. Read, create, replace",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "GET has ==no body semantics==: parameters go in the **query string**",
                "POST to the collection: the ==server picks the ID==",
                "Reply `201 Created` with a `Location` header",
                "PUT sends the ==full body== to a known URL",
                "Omitted fields are {red:reset or removed}",
                "PUT {green:creates} the resource if missing"
              ],
              "style": "dot"
            },
            {
              "type": "code",
              "lang": "http",
              "lines": [
                "POST /users {\"name\":\"Asha\"}",
                "201 Created",
                "Location: /users/43"
              ]
            },
            {
              "type": "heading",
              "text": "3. Patch and delete",
              "ink": "purple"
            },
            {
              "type": "bullets",
              "items": [
                "PATCH changes ==only the sent fields==",
                "`PATCH /users/42 {\"email\":\"a@b.com\"}` keeps the name",
                "DELETE returns `204 No Content` (or `200` with a body)",
                "Deleting again ends in the {green:same state}"
              ],
              "style": "check"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "PUT vs PATCH",
              "text": "PUT ==replaces== the whole resource, so a missing field is lost. PATCH sends only the change."
            }
          ]
        }
      ]
    },
    {
      "title": "Safe and Idempotent Methods",
      "role": "outline",
      "outlineIndex": 2,
      "pages": [
        {
          "title": "Safe and Idempotent Methods",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Two Definitions",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "==Safe== = does not change server state",
                "GET, HEAD, OPTIONS: crawlers and prefetchers may call them freely",
                "==Idempotent== = N identical requests leave the same state as one"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "heading",
              "text": "2. Who Is What",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "Method",
                "Safe",
                "Idempotent"
              ],
              "rows": [
                [
                  "GET, HEAD, OPTIONS",
                  "{green:yes}",
                  "{green:yes}"
                ],
                [
                  "PUT",
                  "{red:no}",
                  "{green:yes}"
                ],
                [
                  "DELETE",
                  "{red:no}",
                  "{green:yes}"
                ],
                [
                  "POST",
                  "{red:no}",
                  "{red:no}"
                ],
                [
                  "PATCH",
                  "{red:no}",
                  "not guaranteed"
                ]
              ],
              "frame": "dashed"
            },
            {
              "type": "bullets",
              "items": [
                "==Safe ⊂ idempotent==: every safe method is idempotent",
                "PUT and DELETE: idempotent, **not** safe",
                "`DELETE /users/42` twice: same end state, user gone"
              ],
              "style": "dot"
            },
            {
              "type": "heading",
              "text": "3. Retrying After a Timeout",
              "ink": "orange"
            },
            {
              "type": "diagram",
              "kind": "flowchart",
              "spec": {
                "rows": [
                  [
                    "q"
                  ],
                  [
                    "a",
                    "b"
                  ]
                ],
                "nodes": {
                  "q": {
                    "text": "Timeout: retry?",
                    "shape": "diamond"
                  },
                  "a": {
                    "text": "Idempotent: retry freely",
                    "shape": "box",
                    "ink": "green"
                  },
                  "b": {
                    "text": "POST: needs key",
                    "shape": "box",
                    "ink": "orange"
                  }
                },
                "edges": [
                  {
                    "from": "q",
                    "to": "a",
                    "label": "GET, PUT, DELETE"
                  },
                  {
                    "from": "q",
                    "to": "b",
                    "label": "POST"
                  }
                ]
              }
            },
            {
              "type": "bullets",
              "items": [
                "Retrying a payment POST needs an ==Idempotency-Key== header"
              ],
              "style": "check",
              "ink": "orange"
            },
            {
              "type": "code",
              "lang": "bash",
              "lines": [
                "curl -X POST https://api.x.com/payments \\",
                "  -H 'Idempotency-Key: 7c1e-42' \\",
                "  -d '{\"amount\":500}'"
              ]
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Same key, one charge",
              "text": "A retry with the same key returns the first result, so no **duplicate** payment."
            }
          ]
        }
      ]
    },
    {
      "title": "Status Code Classes and the Common Codes",
      "role": "outline",
      "outlineIndex": 3,
      "pages": [
        {
          "title": "Status Code Classes and the Common Codes",
          "blocks": [
            {
              "type": "heading",
              "text": "1. The Five Classes",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "Class",
                "Meaning",
                "Next step"
              ],
              "rows": [
                [
                  "1xx",
                  "Informational",
                  "Interim reply"
                ],
                [
                  "2xx",
                  "{green:Success}",
                  "Done"
                ],
                [
                  "3xx",
                  "Redirection",
                  "Follow it or use cache"
                ],
                [
                  "4xx",
                  "{red:Client error}",
                  "Fix the request"
                ],
                [
                  "5xx",
                  "{orange:Server error}",
                  "Retry may work"
                ]
              ]
            },
            {
              "type": "heading",
              "text": "2. Success and Redirects",
              "ink": "green"
            },
            {
              "type": "table",
              "headers": [
                "Code",
                "Meaning"
              ],
              "rows": [
                [
                  "200",
                  "OK"
                ],
                [
                  "201",
                  "Created, with `Location`"
                ],
                [
                  "204",
                  "No Content, empty body"
                ],
                [
                  "301",
                  "Permanent redirect"
                ],
                [
                  "302 / 307",
                  "Temporary redirect; ==307 keeps the method=="
                ],
                [
                  "304",
                  "Not Modified, use the cache copy"
                ]
              ]
            },
            {
              "type": "heading",
              "text": "3. Client Errors (4xx)",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "==400== bad input",
                "==401== not authenticated",
                "==403== authenticated, but forbidden",
                "==404== not found",
                "==409== conflict",
                "==422== validation failed",
                "==429== rate limited"
              ],
              "style": "dot"
            },
            {
              "type": "heading",
              "text": "4. Server Errors (5xx)",
              "ink": "orange"
            },
            {
              "type": "bullets",
              "items": [
                "==500== unhandled server error",
                "==502== bad gateway: upstream sent a bad response",
                "==503== unavailable or overloaded; may send `Retry-After`",
                "==504== gateway timeout"
              ],
              "style": "dot",
              "ink": "orange"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "401 vs 403",
              "text": "**401** = who are you? **403** = I know you, still no."
            }
          ]
        }
      ]
    },
    {
      "title": "Headers That Matter and Common Mistakes",
      "role": "outline",
      "outlineIndex": 4,
      "pages": [
        {
          "title": "Headers That Matter and Common Mistakes",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Headers and Their Failures",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "Header",
                "Job",
                "Failure"
              ],
              "rows": [
                [
                  "`Content-Type`",
                  "body you send, e.g. `application/json`",
                  "{red:415}"
                ],
                [
                  "`Accept`",
                  "format you want back",
                  "{red:406}"
                ],
                [
                  "`Authorization: Bearer <token>`",
                  "credentials on every request",
                  "{red:401} + `WWW-Authenticate`"
                ],
                [
                  "`Location`",
                  "new or redirected resource",
                  "none"
                ],
                [
                  "`Retry-After`",
                  "how long to wait",
                  "after 429 / 503"
                ]
              ]
            },
            {
              "type": "heading",
              "text": "2. Caching and Locking",
              "ink": "purple"
            },
            {
              "type": "bullets",
              "items": [
                "`Cache-Control`: ==max-age== reuses, ==no-store== never caches",
                "`ETag` + `If-None-Match`: unchanged gives {green:304}",
                "`If-Match` on PUT = ==optimistic locking==; conflict gives {red:412}"
              ],
              "style": "dot"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "Server sends ETag",
                    "ink": "blue"
                  },
                  {
                    "text": "Client sends If-None-Match",
                    "ink": "purple"
                  },
                  {
                    "text": "304, no body",
                    "ink": "green"
                  }
                ]
              }
            },
            {
              "type": "code",
              "lang": "http",
              "lines": [
                "PUT /users/42",
                "If-Match: \"v7\""
              ],
              "note": "412 if the ETag has changed"
            },
            {
              "type": "heading",
              "text": "3. Common Mistakes",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "==200== with an error body",
                "==GET== that changes data",
                "==POST== for everything",
                "==500== for bad client input"
              ],
              "style": "cross",
              "ink": "red"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "401 vs 403",
              "text": "{red:401} = not authenticated. {orange:403} = authenticated but forbidden."
            }
          ]
        }
      ]
    },
    {
      "title": "HTTP Methods and Status Codes Cheat Sheet",
      "role": "outline",
      "outlineIndex": 5,
      "pages": [
        {
          "title": "HTTP Methods and Status Codes Cheat Sheet",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Methods",
              "ink": "green"
            },
            {
              "type": "table",
              "headers": [
                "Method",
                "Use",
                "Safe",
                "Idempotent",
                "OK code"
              ],
              "rows": [
                [
                  "`GET`",
                  "read",
                  "{green:yes}",
                  "{green:yes}",
                  "200"
                ],
                [
                  "`POST`",
                  "create / action",
                  "{red:no}",
                  "{red:no}",
                  "201"
                ],
                [
                  "`PUT`",
                  "replace",
                  "{red:no}",
                  "{green:yes}",
                  "200 / 204"
                ],
                [
                  "`PATCH`",
                  "partial update",
                  "{red:no}",
                  "not guaranteed",
                  "200"
                ],
                [
                  "`DELETE`",
                  "remove",
                  "{red:no}",
                  "{green:yes}",
                  "204"
                ]
              ],
              "frame": "dashed"
            },
            {
              "type": "heading",
              "text": "2. Codes and Headers",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "{red:4xx} client: ==400== bad request, ==401== who are you, ==403== not allowed, ==404== missing",
                "==409== conflict, ==422== invalid, ==429== slow down",
                "{orange:5xx} server: ==500== server bug, ==502/504== upstream, ==503== overloaded"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "`Content-Type` body sent, `Accept` format wanted, `Authorization` credentials",
                "`Cache-Control`, `ETag` / `If-None-Match` for 304 caching",
                "`Location` new resource, `Retry-After` wait after 429 / 503"
              ],
              "style": "check",
              "ink": "purple"
            },
            {
              "type": "heading",
              "text": "3. curl",
              "ink": "orange"
            },
            {
              "type": "code",
              "lang": "bash",
              "lines": [
                "curl -i https://api.x.com/users/42",
                "curl -X POST -H 'Content-Type: application/json' \\",
                "  -d '{\"name\":\"a\"}' https://api.x.com/users"
              ],
              "note": "GET, then POST"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "401 vs 403",
              "text": "{red:401} = not logged in. {red:403} = logged in, not allowed."
            }
          ]
        }
      ]
