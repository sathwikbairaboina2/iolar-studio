    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "A client times out on PUT /users/42 with a full body, then retries it. Can this create a bad state?",
              "a_bullets": [
                "No: PUT is ==idempotent==, so the second send leaves the same state.",
                "Same retry on POST /orders could create a duplicate."
              ]
            },
            {
              "type": "qa",
              "q": "POST /payments times out and the client auto-retries. What can go wrong, and what fixes it?",
              "a_bullets": [
                "POST is not idempotent, so the customer may be charged twice.",
                "Send an `Idempotency-Key` header so the server ignores the repeat."
              ]
            },
            {
              "type": "qa",
              "q": "A logged-in user without admin rights calls an admin endpoint and gets 401. What is the bug?",
              "a_bullets": [
                "401 means not authenticated; this user is known but not allowed.",
                "The correct code is ==403 Forbidden=="
              ]
            }
          ]
        }
      ]
    }
  ]
