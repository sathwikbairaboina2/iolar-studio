            {
              "type": "heading",
              "text": "2. Reject and retry",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "Server: ==429== + `Retry-After` (seconds or HTTP-date) + `RateLimit-*` headers",
                "Retry timeouts, 429, 502, 503, 504; never other 4xx, 500 or 501",
                "Honour `Retry-After`, else exponential backoff with cap and {orange:jitter}"
              ],
              "style": "check"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "Send",
