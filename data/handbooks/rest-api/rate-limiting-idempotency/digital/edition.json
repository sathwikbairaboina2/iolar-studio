          "title": "Webhooks Basics",
          "blocks": [
            {
              "type": "heading",
              "text": "1. What a Webhook Is",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "An ==HTTP POST== the provider sends to your registered URL",
                "Event happens → provider **pushes**; you stop polling",
                "Delivery is ==at-least-once== and **unordered**"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "heading",
              "text": "2. Handling an Event",
              "ink": "blue"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "Verify HMAC",
                    "sub": "raw body",
                    "ink": "red"
                  },
                  {
                    "text": "Return 2xx",
                    "sub": "fast",
                    "ink": "green"
                  },
                  {
                    "text": "Queue job",
                    "sub": "async work",
                    "ink": "blue"
                  },
                  {
                    "text": "Dedupe",
                    "sub": "event ID",
                    "ink": "purple"
                  }
                ]
              }
            },
            {
              "type": "bullets",
              "items": [
                "Provider signs the ==raw bytes== with a shared secret (HMAC-SHA256)",
                "Never verify re-serialised JSON",
                "Slow or failed response → provider **retries**",
                "Store the ==event ID==; skip seen ones to stay idempotent"
              ],
              "style": "check"
            },
            {
              "type": "code",
              "lang": "python",
              "lines": [
                "import hmac, hashlib",
                "mac = hmac.new(secret, raw_body,",
                "               hashlib.sha256).hexdigest()",
                "ok = hmac.compare_digest(mac, sig_header)"
              ],
              "note": "recompute, then compare in constant time"
            },
            {
              "type": "heading",
              "text": "3. Common Mistake",
              "ink": "red"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Trusting the payload",
              "text": "Skipping the ==signature== or **timestamp** check allows spoofed and replayed events."
            }
          ]
        }
      ]
