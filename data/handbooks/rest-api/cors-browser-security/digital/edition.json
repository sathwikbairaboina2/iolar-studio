  "sections": [
    {
      "title": "Same-Origin Policy and the CORS Mental Model",
      "role": "outline",
      "outlineIndex": 0,
      "pages": [
        {
          "title": "Same-Origin Policy and the CORS Mental Model",
          "blocks": [
            {
              "type": "heading",
              "text": "1. What an Origin Is",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "Origin = ==scheme + host + port==",
                "Any one part differs → **cross-origin**"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "table",
              "headers": [
                "vs `https://a.com`",
                "Same?",
                "Differs in"
              ],
              "rows": [
                [
                  "`http://a.com`",
                  "{red:No}",
                  "scheme"
                ],
                [
                  "`https://api.a.com`",
                  "{red:No}",
                  "host"
                ],
                [
                  "`https://a.com:4000`",
                  "{red:No}",
                  "port"
                ],
                [
                  "`https://a.com/x`",
                  "{green:Yes}",
                  "path is ignored"
                ]
              ],
              "frame": "dashed"
            },
            {
              "type": "heading",
              "text": "2. Who Enforces What",
              "ink": "blue"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "JS fetch",
                    "sub": "cross-origin",
                    "ink": "blue"
                  },
                  {
                    "text": "Server runs it",
                    "sub": "request still sent",
                    "ink": "orange"
                  },
                  {
                    "text": "Browser checks",
                    "sub": "Allow-Origin?",
                    "ink": "purple"
                  },
                  {
                    "text": "JS reads",
                    "sub": "or CORS error",
                    "ink": "green"
                  }
                ]
              }
            },
            {
              "type": "bullets",
              "items": [
                "Same-origin policy blocks JS ==reading== the response, not sending",
                "CORS is a browser-enforced ==opt-in==: the server names who may read",
                "curl, Postman and servers ignore CORS",
                "Browser adds `Origin`; no match → response hidden, CORS error logged"
              ],
              "style": "dot"
            },
            {
              "type": "code",
              "lang": "http",
              "lines": [
                "Origin: https://a.com",
                "Access-Control-Allow-Origin: https://a.com"
              ],
              "note": "request header, then the response header that allows it"
            },
            {
              "type": "heading",
              "text": "3. What CORS Is Not",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "Not auth or server security",
                "Attackers call your API directly, no browser involved",
                "It protects ==users' browsers== only"
              ],
              "style": "cross",
              "frame": "dashed",
              "ink": "red"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Blocked is not unsent",
              "text": "A CORS error hides the response, but the server may have **already run** the request."
            }
          ]
        }
      ]
    },
    {
      "title": "Simple vs Preflighted Requests",
      "role": "outline",
      "outlineIndex": 1,
      "pages": [
        {
          "title": "Simple vs Preflighted Requests",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Simple or Preflighted",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "==Simple==: sent directly, then the response is checked",
                "Anything else is ==preflighted== first"
              ],
              "style": "dot"
            },
            {
              "type": "table",
              "headers": [
                "",
                "Simple",
                "Preflighted"
              ],
              "rows": [
                [
                  "Method",
                  "GET, HEAD, POST",
                  "PUT, PATCH, DELETE"
                ],
                [
                  "Headers",
                  "no custom ones",
                  "`Authorization`, `X-Api-Key`"
                ],
                [
                  "Content-Type",
                  "`text/plain`, `multipart/form-data`, `application/x-www-form-urlencoded`",
                  "`application/json`"
                ]
              ],
              "frame": "dashed"
            },
            {
              "type": "heading",
              "text": "2. The Preflight",
              "ink": "blue"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "OPTIONS",
                    "sub": "automatic",
                    "ink": "blue"
                  },
                  {
                    "text": "2xx?",
                    "sub": "200 or 204",
                    "ink": "orange"
                  },
                  {
                    "text": "Real request",
                    "sub": "only if passed",
                    "ink": "green"
                  }
                ]
              }
            },
            {
              "type": "bullets",
              "items": [
                "Carries `Origin`, `Access-Control-Request-Method`, `Access-Control-Request-Headers`",
                "Needs ==2xx== plus matching Allow headers",
                "{red:No cookies} sent; answer it before your route auth"
              ],
              "style": "check"
            },
            {
              "type": "heading",
              "text": "3. Example",
              "ink": "purple"
            },
            {
              "type": "code",
              "lang": "javascript",
              "lines": [
                "fetch(url, {",
                "  method: 'POST',",
                "  headers: {'Content-Type': 'application/json'},",
                "  body",
                "})"
              ],
              "note": "OPTIONS first, then POST; with text/plain it would be simple"
            },
            {
              "type": "heading",
              "text": "4. Interview Point",
              "ink": "orange"
            },
            {
              "type": "bullets",
              "items": [
                "**Why does a JSON POST preflight?** `application/json` is not a safelisted Content-Type.",
                "**Does the preflight carry cookies?** No, so answer OPTIONS with 2xx before auth.",
                "**If the preflight fails?** The real request is never sent."
              ],
              "style": "dot"
            }
          ]
        }
      ]
    },
    {
      "title": "Access-Control-Allow-* Response Headers",
      "role": "outline",
      "outlineIndex": 2,
      "pages": [
        {
          "title": "Access-Control-Allow-* Response Headers",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Allow-Origin",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "`Access-Control-Allow-Origin`: ==one exact origin== or `*`",
                "Browser compares it to the request `Origin` header",
                "{red:Multiple comma-separated origins} are **invalid**"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "heading",
              "text": "2. Preflight and Exposed Headers",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "Header",
                "Job",
                "Example"
              ],
              "rows": [
                [
                  "`Allow-Methods`",
                  "Permitted methods (preflight response)",
                  "`GET, POST, PUT, DELETE`"
                ],
                [
                  "`Allow-Headers`",
                  "Must cover every name in `Access-Control-Request-Headers`",
                  "`Content-Type, Authorization`"
                ],
                [
                  "`Expose-Headers`",
                  "Extra response headers JS may read",
                  "`X-Total-Count`"
                ]
              ],
              "frame": "dashed"
            },
            {
              "type": "bullets",
              "items": [
                "JS reads only ==safelisted== response headers by default:",
                "`Cache-Control`, `Content-Language`, `Content-Length`, `Content-Type`, `Expires`, `Last-Modified`, `Pragma`",
                "Anything else (like `X-Total-Count`) must be listed in `Expose-Headers`"
              ],
              "style": "check"
            },
            {
              "type": "heading",
              "text": "3. Several Origins",
              "ink": "purple"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "Read Origin",
                    "sub": "request header",
                    "ink": "blue"
                  },
                  {
                    "text": "In allowlist?",
                    "sub": "exact match",
                    "ink": "purple"
                  },
                  {
                    "text": "Echo it",
                    "sub": "Allow-Origin",
                    "ink": "green"
                  },
                  {
                    "text": "Add Vary",
                    "sub": "Vary: Origin",
                    "ink": "orange"
                  }
                ]
              }
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Always add Vary: Origin",
              "text": "Without it, a cache may serve one origin's response to another origin."
            }
          ]
        }
      ]
    },
    {
      "title": "Credentials, Wildcards and Preflight Caching",
      "role": "outline",
      "outlineIndex": 3,
      "pages": [
        {
          "title": "Credentials, Wildcards and Preflight Caching",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Credentials and the wildcard rule",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "Cookies and HTTP auth cross-origin need ==both sides==",
                "Client: `credentials:'include'` (fetch) or `withCredentials=true` (XHR)",
                "Server: `Access-Control-Allow-Credentials: true`"
              ],
              "style": "check"
            },
            {
              "type": "code",
              "lang": "text",
              "lines": [
                "fetch(url, { credentials: 'include' })",
                "Access-Control-Allow-Origin: https://a.com",
                "Access-Control-Allow-Credentials: true"
              ],
              "note": "client call, then the matching response headers"
            },
            {
              "type": "sidebox",
              "title": "With credentials, no * anywhere",
              "items": [
                "Allow-Origin: the {red:exact origin}",
                "Allow-Methods, Allow-Headers, Expose-Headers: list names",
                "`*` is a ==literal== value here"
              ],
              "ink": "red"
            },
            {
              "type": "heading",
              "text": "2. Authorization header",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "Bearer tokens are {blue:not} credentials mode",
                "Authorization still ==forces a preflight==",
                "List it in Allow-Headers: `*` does not cover it"
              ],
              "style": "dot"
            },
            {
              "type": "heading",
              "text": "3. Preflight caching",
              "ink": "purple"
            },
            {
              "type": "table",
              "headers": [
                "Max-Age cap",
                "Seconds"
              ],
              "rows": [
                [
                  "Default",
                  "5"
                ],
                [
                  "Chrome",
                  "7200 (2h)"
                ],
                [
                  "Firefox",
                  "86400 (24h)"
                ]
              ]
            },
            {
              "type": "bullets",
              "items": [
                "`Access-Control-Max-Age: N` caches per origin + URL",
                "Cache hit skips the repeat OPTIONS: one round trip saved",
                "Permission removed on server: ==still works== until expiry",
                "Method or header missing from cache: fresh preflight"
              ],
              "style": "dot"
            }
          ]
        }
      ]
    },
    {
      "title": "Common CORS Mistakes and Debugging",
      "role": "outline",
      "outlineIndex": 4,
      "pages": [
        {
          "title": "Common CORS Mistakes and Debugging",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Missing Headers",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "CORS headers set only on success: ==401/404/500== lack `Access-Control-Allow-Origin`",
                "Browser shows a **fake CORS error** and hides the real status",
                "OPTIONS hits auth or routing: ==401/404/405== on the preflight"
              ],
              "style": "cross",
              "frame": "dashed",
              "ink": "red"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "OPTIONS",
                    "sub": "preflight",
                    "ink": "blue"
                  },
                  {
                    "text": "CORS layer",
                    "sub": "adds headers",
                    "ink": "purple"
                  },
                  {
                    "text": "Reply 2xx",
                    "sub": "200/204, before auth",
                    "ink": "green"
                  },
                  {
                    "text": "Auth + route",
                    "sub": "real request only",
                    "ink": "orange"
                  }
                ]
              }
            },
            {
              "type": "heading",
              "text": "2. Unsafe or Broken Setups",
              "ink": "orange"
            },
            {
              "type": "table",
              "headers": [
                "Mistake",
                "Result",
                "Fix"
              ],
              "rows": [
                [
                  "Reflect any Origin + `Allow-Credentials: true`",
                  "Any site reads authenticated responses",
                  "Validate against an ==allowlist=="
                ],
                [
                  "Proxy and app both add `Allow-Origin`",
                  "'multiple values' error",
                  "CORS in **exactly one** layer"
                ],
                [
                  "Redirect on preflight",
                  "Preflight fails",
                  "Preflight must not redirect"
                ],
                [
                  "`no-cors` mode",
                  "Opaque response, unreadable",
                  "Not a fix: set server headers"
                ]
              ],
              "frame": "dashed"
            },
            {
              "type": "heading",
              "text": "3. Debug in DevTools",
              "ink": "blue"
            },
            {
              "type": "diagram",
              "kind": "chain",
              "spec": {
                "steps": [
                  {
                    "text": "Network tab",
                    "note": "open failed call",
                    "ink": "blue"
                  },
                  {
                    "text": "OPTIONS request",
                    "note": "is it 2xx?",
                    "ink": "purple"
                  },
                  {
                    "text": "Response headers",
                    "note": "one Allow-Origin, matching",
                    "ink": "green"
                  },
                  {
                    "text": "Real request",
                    "note": "read its true status",
                    "ink": "orange"
                  }
                ]
              }
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Read the status first",
              "text": "A CORS error often masks a ==4xx/5xx== or an unhandled **OPTIONS**."
            }
          ]
        }
      ]
    },
    {
      "title": "CORS Cheat Sheet",
      "role": "outline",
      "outlineIndex": 5,
      "pages": [
        {
          "title": "CORS Cheat Sheet",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Origin and Enforcement",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "Differs in",
                "Other URL",
                "Result"
              ],
              "rows": [
                [
                  "Scheme",
                  "`http://a.com`",
                  "{red:cross-origin}"
                ],
                [
                  "Host",
                  "`api.a.com`",
                  "{red:cross-origin}"
                ],
                [
                  "Port",
                  "`https://a.com:4000`",
                  "{red:cross-origin}"
                ]
              ]
            },
            {
              "type": "bullets",
              "items": [
                "==Origin== = scheme + host + port",
                "The {blue:browser} enforces; the {green:server} opts in via headers",
                "curl, Postman and servers ignore CORS"
              ],
              "style": "dot"
            },
            {
              "type": "heading",
              "text": "2. Simple vs Preflight",
              "ink": "purple"
            },
            {
              "type": "table",
              "headers": [
                "",
                "Simple",
                "Preflighted"
              ],
              "rows": [
                [
                  "Method",
                  "GET, HEAD, POST",
                  "PUT, PATCH, DELETE"
                ],
                [
                  "Headers",
                  "safelisted only",
                  "`Authorization`, custom"
                ],
                [
                  "Content-Type",
                  "text/plain, form",
                  "`application/json`"
                ]
              ],
              "highlightRow": 2
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "OPTIONS",
                    "sub": "Origin, Request-Method, Request-Headers",
                    "ink": "purple"
                  },
                  {
                    "text": "2xx reply",
                    "sub": "Allow-Origin, Methods, Headers",
                    "ink": "green"
                  },
                  {
                    "text": "Real request",
                    "sub": "sent if it passes",
                    "ink": "blue"
                  }
                ]
              }
            },
            {
              "type": "heading",
              "text": "3. Credentials and Caching",
              "ink": "orange"
            },
            {
              "type": "bullets",
              "items": [
                "Client `credentials:'include'` + server `Allow-Credentials: true`",
                "==Exact== Allow-Origin, no `*` anywhere",
                "Echoing origins: add `Vary: Origin`"
              ],
              "style": "check"
            },
            {
              "type": "bullets",
              "items": [
                "`Max-Age` caches preflight: Chrome 2h cap, Firefox 24h",
                "A removed permission works until the cache expires",
                "`Expose-Headers` reveals custom response headers"
              ],
              "style": "dot"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Masked errors",
              "text": "A CORS error often hides a ==4xx/5xx== or an unhandled `OPTIONS`. Check DevTools Network."
            }
          ]
        }
      ]
    },
    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "A page on http://localhost:3000 sends POST with Content-Type: text/plain to http://localhost:4000/items. The response has no Allow-Origin. Is the server hit, and can JS read the reply?",
              "a_bullets": [
                "Simple request: no preflight, the POST is sent and the server runs it",
                "The browser hides the response from JS and logs a CORS error"
              ]
            },
            {
              "type": "qa",
              "q": "The API sends Allow-Origin: * and Allow-Credentials: true. The client uses credentials:'include'. What happens, and what is the fix?",
              "a_bullets": [
                "The browser blocks it: with credentials, * is not allowed",
                "Echo the exact origin from an allowlist and add Vary: Origin"
              ]
            },
            {
              "type": "qa",
              "q": "A fetch sends Authorization: Bearer abc. The preflight reply has Allow-Headers: *. Why does it still fail?",
              "a_bullets": [
                "* does not cover Authorization",
                "List Authorization explicitly in Allow-Headers"
              ]
            }
          ]
        }
      ]
    }
  ]
}
