    {
      "title": "OpenAPI Cheat Sheet",
      "role": "outline",
      "outlineIndex": 5,
      "pages": [
        {
          "title": "OpenAPI Cheat Sheet",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Skeleton and operations",
              "ink": "blue"
            },
            {
              "type": "code",
              "lang": "yaml",
              "lines": [
                "openapi: 3.1.0",
                "info: {title: Pets, version: 1.0.0}",
                "servers: [{url: https://api.example.com}]",
                "paths: {}",
                "components: {schemas: {}, parameters: {}, responses: {}, securitySchemes: {}}",
                "security: []",
                "webhooks: {}"
              ]
            },
            {
              "type": "table",
              "headers": [
                "Operation field",
                "Set"
              ],
              "rows": [
                [
                  "`operationId`",
                  "unique name"
                ],
                [
                  "`parameters`",
                  "`in` + `required`"
                ],
                [
                  "`requestBody`",
                  "`content` by media type"
                ],
                [
                  "`responses`",
                  "by status code"
                ],
                [
                  "`security`, `tags`",
                  "auth, grouping"
                ]
              ]
            },
            {
              "type": "heading",
              "text": "2. Schema keywords",
              "ink": "purple"
            },
            {
              "type": "bullets",
              "items": [
                "`type`, `properties`, `required`, `enum`, `items`, `format`",
                "`allOf` merges, `oneOf` one match, `anyOf` any; ==discriminator== picks subtype",
                "Reuse: `$ref: '#/components/schemas/User'`",
                "3.1 nullable: {green:`type: ['string','null']`}"
              ],
              "style": "dot"
            },
            {
              "type": "heading",
              "text": "3. Commands",
              "ink": "green"
            },
            {
              "type": "table",
              "headers": [
                "Stage",
                "Command"
              ],
              "rows": [
                [
                  "Lint",
                  "`spectral lint`, `redocly lint`"
                ],
                [
                  "Generate",
                  "`openapi-generator-cli generate -g <lang>`"
                ],
                [
                  "Test live API",
                  "`schemathesis run`"
                ],
                [
                  "Breaking diff",
                  "`oasdiff breaking`"
                ]
              ]
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Rule of thumb",
              "text": "Spec is the ==contract==. Generate code from it or it from code; lint and diff it every PR; test the running API against it."
            }
          ]
        }
      ]
    },
    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "A 3.1.0 document has a field with `type: string` and `nullable: true`. A client sends null. What happens?",
              "a_bullets": [
                "`nullable` is gone in 3.1, so null is not allowed",
                "Write `type: ['string','null']` instead"
              ]
            },
            {
              "type": "qa",
              "q": "`/users/{id}` has a parameter `in: path, name: id` with no `required`. What is wrong?",
              "a_bullets": [
                "Path parameters must set `required: true`",
                "The name must also match `{id}` in the URL"
              ]
            },
            {
              "type": "qa",
              "q": "A schema lists `id` and `email` under `properties` but has no `required` list. Is `{}` valid?",
              "a_bullets": [
                "Yes, properties are optional unless listed in `required`",
                "Undeclared required fields are a common mistake"
              ]
            }
          ]
        }
      ]
    }
