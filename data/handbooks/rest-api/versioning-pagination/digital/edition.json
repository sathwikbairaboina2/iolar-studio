  "sections": [
    {
      "title": "API Design Mental Model",
      "role": "outline",
      "outlineIndex": 0,
      "pages": [
        {
          "title": "API Design Mental Model",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Three Tools, One Goal",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "==Versioning==, ==pagination== and ==caching== all protect clients",
                "The ==contract stays stable== while data and servers change"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "table",
              "headers": [
                "Tool",
                "Idea"
              ],
              "rows": [
                [
                  "**Version**",
                  "A named contract; bump only for {red:breaking} changes, never {green:additive} ones"
                ],
                [
                  "**Pagination**",
                  "A bounded slice plus a way to ask for the next slice"
                ],
                [
                  "**Caching**",
                  "Reuse while {green:fresh}, revalidate cheaply when {orange:stale}"
                ]
              ],
              "frame": "dashed"
            },
            {
              "type": "heading",
              "text": "2. Core Request Flow",
              "ink": "blue"
            },
            {
              "type": "diagram",
              "kind": "chain",
              "spec": {
                "steps": [
                  {
                    "text": "Client sends",
                    "note": "version + page position + validators",
                    "ink": "blue"
                  },
                  {
                    "text": "Server returns",
                    "note": "data + next position + cache headers",
                    "ink": "green"
                  }
                ]
              }
            },
            {
              "type": "code",
              "lang": "http",
              "lines": [
                "GET /v1/users?limit=20&after=c9f2",
                "If-None-Match: \"abc123\""
              ],
              "note": "version, page position, validator"
            },
            {
              "type": "code",
              "lang": "http",
              "lines": [
                "200 OK",
                "ETag: \"abc124\"",
                "Cache-Control: max-age=60",
                "{\"data\":[...],\"next_cursor\":\"d41e\"}"
              ],
              "note": "data, next position, cache headers"
            },
            {
              "type": "heading",
              "text": "3. Remember",
              "ink": "purple"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Stable contract",
              "text": "Additive change keeps the version. Every page names its ==next position==. Every cached copy is either ==fresh== or ==revalidated==."
            }
          ]
        }
      ]
    },
    {
      "title": "URL vs Header Versioning",
      "role": "outline",
      "outlineIndex": 1,
      "pages": [
        {
          "title": "URL vs Header Versioning",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Two Schemes",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "URL: `/v1/users`, ==visible==, easy to route, curl and cache",
                "Catch: the URL (resource identity) changes per version",
                "Header: `Accept: application/vnd.example+json; version=2`",
                "Or `X-API-Version: 2`; URLs stay clean",
                "Catch: {red:hidden}, hard to test in a browser"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "code",
              "lang": "http",
              "lines": [
                "GET /users HTTP/1.1",
                "Accept: application/vnd.example+json; version=2",
                "",
                "HTTP/1.1 200 OK",
                "Vary: Accept"
              ],
              "note": "version in a header, URL unchanged"
            },
            {
              "type": "heading",
              "text": "2. Compare and Cache",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "Scheme",
                "Strength",
                "Catch"
              ],
              "rows": [
                [
                  "URL",
                  "simple, discoverable",
                  "URL changes per version"
                ],
                [
                  "Header",
                  "purist REST, long-lived APIs",
                  "hidden, needs Vary"
                ],
                [
                  "`?v=2`",
                  "easy",
                  "pollutes cache keys"
                ]
              ],
              "frame": "dashed"
            },
            {
              "type": "sidebox",
              "title": "Vary rule",
              "items": [
                "Header versions need `Vary: Accept`",
                "Or Vary on the version header",
                "Else shared caches serve the wrong version"
              ],
              "ink": "orange"
            },
            {
              "type": "heading",
              "text": "3. Mistakes",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "Versioning every endpoint separately",
                "Bumping the major version for small changes"
              ],
              "style": "cross",
              "ink": "red"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Pick one",
              "text": "Choose **one scheme** and version the ==whole API==."
            }
          ]
        }
      ]
    },
    {
      "title": "Backward Compatibility Rules",
      "role": "outline",
      "outlineIndex": 2,
      "pages": [
        {
          "title": "Backward Compatibility Rules",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Safe vs breaking",
              "ink": "green"
            },
            {
              "type": "table",
              "headers": [
                "{green:Safe}",
                "{red:Breaking}"
              ],
              "rows": [
                [
                  "Add optional field",
                  "Remove or rename a field"
                ],
                [
                  "Add new endpoint",
                  "Change a type"
                ],
                [
                  "Add optional query param",
                  "Make optional param required"
                ],
                [
                  "Add enum value (tolerant clients only)",
                  "Change status codes or error shapes"
                ],
                [
                  "",
                  "Change semantics"
                ]
              ]
            },
            {
              "type": "heading",
              "text": "2. Tolerant reader",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "==Clients== ignore unknown fields",
                "==Servers== accept unknown optional input",
                "Together they make **additive change safe**"
              ],
              "style": "check",
              "frame": "dashed",
              "ink": "blue"
            },
            {
              "type": "heading",
              "text": "3. Deprecation flow",
              "ink": "orange"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "Announce",
                    "ink": "blue"
                  },
                  {
                    "text": "Add headers",
                    "sub": "Deprecation + Sunset",
                    "ink": "orange"
                  },
                  {
                    "text": "Monitor",
                    "sub": "usage per version",
                    "ink": "purple"
                  },
                  {
                    "text": "Remove",
                    "sub": "after sunset date",
                    "ink": "red"
                  }
                ]
              }
            },
            {
              "type": "heading",
              "text": "4. Example: rename a field",
              "ink": "purple"
            },
            {
              "type": "code",
              "lang": "json",
              "lines": [
                "{",
                "  \"user_name\": \"ada\",",
                "  \"username\": \"ada\"",
                "}"
              ],
              "note": "transition period: return both fields"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Rename = add, then drop",
              "text": "Return **both** `user_name` and `username`, then drop the old one in the ==next version==."
            }
          ]
        }
      ]
    },
    {
      "title": "Offset vs Cursor Pagination",
      "role": "outline",
      "outlineIndex": 3,
      "pages": [
        {
          "title": "Offset vs Cursor Pagination",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Offset",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "`?limit=20&offset=40` maps to `LIMIT 20 OFFSET 40`",
                "Supports ==jump-to-page== and **totals**",
                "{red:Slow on deep pages}: the DB scans and discards skipped rows",
                "{red:Unstable}: inserts or deletes between requests cause duplicate or missing items"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "heading",
              "text": "2. Cursor (keyset)",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "`?limit=20&after=<opaque token>`",
                "Uses an ==index==, so it stays fast at any depth"
              ],
              "style": "dot"
            },
            {
              "type": "code",
              "lang": "sql",
              "lines": [
                "SELECT * FROM items",
                "WHERE (created_at, id) < (:c, :i)",
                "ORDER BY created_at DESC, id DESC",
                "LIMIT 20"
              ],
              "note": "the last row of a page gives :c and :i"
            },
            {
              "type": "bullets",
              "items": [
                "Needs a ==unique, stable sort key==; add `id` as tiebreaker",
                "Return an **opaque encoded** cursor plus `next_cursor`",
                "`next_cursor` is `null` at the end"
              ],
              "style": "check",
              "ink": "blue"
            },
            {
              "type": "heading",
              "text": "3. Which One",
              "ink": "purple"
            },
            {
              "type": "table",
              "headers": [
                "",
                "Offset",
                "Cursor"
              ],
              "rows": [
                [
                  "Speed",
                  "slow when deep",
                  "fast, indexed"
                ],
                [
                  "Changing data",
                  "unstable",
                  "consistent"
                ],
                [
                  "Access",
                  "random, jump-to-page",
                  "next/prev only"
                ],
                [
                  "Total page count",
                  "yes",
                  "no"
                ]
              ],
              "highlightRow": 1
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Rule of thumb",
              "text": "Use ==cursor== for feeds and large or fast-changing data. Offset is only simple, not safe."
            }
          ]
        }
      ]
    },
    {
      "title": "Caching with ETag and Cache-Control",
      "role": "outline",
      "outlineIndex": 4,
      "pages": [
        {
          "title": "Caching with ETag and Cache-Control",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Cache-Control",
              "ink": "green"
            },
            {
              "type": "table",
              "headers": [
                "Directive",
                "Meaning"
              ],
              "rows": [
                [
                  "`max-age=N`",
                  "fresh for **N seconds**"
                ],
                [
                  "`s-maxage`",
                  "==shared caches== only"
                ],
                [
                  "`no-cache`",
                  "stored, must ==revalidate=="
                ],
                [
                  "`no-store`",
                  "==never== stored"
                ],
                [
                  "`public`",
                  "any cache may store"
                ],
                [
                  "`private`",
                  "browser only, one user"
                ]
              ]
            },
            {
              "type": "heading",
              "text": "2. ETag and conditional requests",
              "ink": "blue"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "200 + ETag",
                    "sub": "ETag: \"abc123\"",
                    "ink": "green"
                  },
                  {
                    "text": "Client resends",
                    "sub": "If-None-Match: \"abc123\"",
                    "ink": "blue"
                  },
                  {
                    "text": "304",
                    "sub": "no body, unchanged",
                    "ink": "purple"
                  }
                ]
              }
            },
            {
              "type": "bullets",
              "items": [
                "==ETag== = validator, a fingerprint of one representation",
                "Unchanged → ==304 Not Modified==, saves bandwidth",
                "`If-Match: <etag>` on PUT/PATCH = ==optimistic concurrency==",
                "Mismatch → {red:412 Precondition Failed}"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "blue"
            },
            {
              "type": "code",
              "lang": "http",
              "lines": [
                "PUT /users/7",
                "If-Match: \"abc123\"",
                "-> 412 if the ETag changed"
              ],
              "note": "write only if nobody changed it first"
            },
            {
              "type": "heading",
              "text": "3. Common mistakes",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "`no-cache` is ==not== `no-store`: it still stores",
                "Personalised response cached as `public`",
                "Missing `Vary` on responses that differ",
                "ETag differs per server behind a load balancer",
                "`max-age` on data that changes"
              ],
              "style": "cross",
              "frame": "dashed",
              "ink": "red"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Remember",
              "text": "ETag out, `If-None-Match` in, 304 back. `If-Match` on writes, 412 on mismatch."
            }
          ]
        }
      ]
    },
    {
      "title": "Cheat Sheet",
      "role": "outline",
      "outlineIndex": 5,
      "pages": [
        {
          "title": "Cheat Sheet",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Versioning and Compatibility",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "==URL== `/v1/users`: simple, easy to route",
                "==Header== `Accept: application/vnd.example+json; version=2`: clean URLs, send `Vary: Accept`",
                "Bump the major version only for {red:breaking} changes",
                "{green:Safe}: add. {red:Breaking}: remove, rename, retype, make required",
                "Deprecate with `Deprecation` and `Sunset` headers"
              ],
              "style": "dot",
              "ink": "green"
            },
            {
              "type": "heading",
              "text": "2. Offset vs Cursor",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "",
                "Offset",
                "Cursor"
              ],
              "rows": [
                [
                  "SQL",
                  "`LIMIT/OFFSET`",
                  "keyset `WHERE`"
                ],
                [
                  "Jump to page",
                  "{green:yes}",
                  "{red:no}"
                ],
                [
                  "Deep pages",
                  "{red:slow}",
                  "{green:fast}"
                ],
                [
                  "Changing data",
                  "{red:unstable}",
                  "{green:stable}"
                ]
              ]
            },
            {
              "type": "bullets",
              "items": [
                "Cursor is an ==opaque token==; `next_cursor` is `null` at the end"
              ],
              "style": "check",
              "ink": "blue"
            },
            {
              "type": "heading",
              "text": "3. Caching",
              "ink": "purple"
            },
            {
              "type": "table",
              "headers": [
                "Directive",
                "Meaning"
              ],
              "rows": [
                [
                  "`max-age=N`",
                  "fresh for N seconds"
                ],
                [
                  "`s-maxage`",
                  "shared caches only"
                ],
                [
                  "`no-cache`",
                  "store, ==revalidate== first"
                ],
                [
                  "`no-store`",
                  "==never== store"
                ],
                [
                  "`public` / `private`",
                  "shared / one user only"
                ]
              ]
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "Server",
                    "sub": "ETag out",
                    "ink": "blue"
                  },
                  {
                    "text": "Client",
                    "sub": "If-None-Match in",
                    "ink": "purple"
                  },
                  {
                    "text": "Server",
                    "sub": "304 back",
                    "ink": "green"
                  }
                ]
              }
            },
            {
              "type": "bullets",
              "items": [
                "Add `Vary` when the response differs by header",
                "Writes: `If-Match` on PUT/PATCH, mismatch gives `412`"
              ],
              "style": "dot",
              "ink": "purple"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Mistake",
              "text": "`no-cache` is not `no-store`: it still stores, then revalidates."
            }
          ]
        }
      ]
    },
    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "You page with limit=20 and fetch offset=0. Then 3 new items are inserted at the top. What does offset=20 return?",
              "a_bullets": [
                "The last 3 items of page 1 again: duplicates",
                "A cursor avoids this: it anchors on the last row seen"
              ]
            },
            {
              "type": "qa",
              "q": "A response has ETag \"v7\" and Cache-Control: no-cache. The client resends If-None-Match: \"v7\" and the data is unchanged. What comes back?",
              "a_bullets": [
                "304 Not Modified, with no body",
                "`no-cache` means store but revalidate, not never store"
              ]
            },
            {
              "type": "qa",
              "q": "A cursor sorts by created_at only. 5 rows share one timestamp and a page ends in the middle of them. What breaks?",
              "a_bullets": [
                "Rows after the cut get skipped or repeated",
                "Fix: sort by (created_at, id), a unique key"
              ]
            }
          ]
        }
      ]
    }
  ]
}