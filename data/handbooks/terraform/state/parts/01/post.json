                "lines": [
                  "`-refresh-only` apply",
                  "state moves to world",
                  "infra untouched"
                ]
              },
              {
                "title": "reassert config",
                "lines": [
                  "normal apply",
                  "world moves to config",
                  "infra changes"
                ]
