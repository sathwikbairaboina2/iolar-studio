        {
          "type": "heading",
          "text": "Perpetual Diffs"
        },
        {
          "type": "bullets",
          "items": [
            "Same change every run, never converges",
            "Provider normalizing uppercase ARNs or JSON key order",
            "A mutating webhook rewriting the field back",
            "Or a genuine provider bug"
          ]
