              },
              "c0_0": {
                "text": "restore prior version"
              },
              "c1_0": {
                "text": "import every resource by ID"
              },
              "c2_0": {
                "text": "pull, restore, check serial"
              }
            },
            "edges": [
              {
                "from": "n0",
