    {
      "page_title": "ACID",
      "blocks": [
        {
          "type": "concept",
          "number": 2,
          "title": "ACID",
          "tagline": "four promises per COMMIT"
        },
        {
          "type": "labelrows",
          "rows": [
            {
              "icon": "shield-check",
              "label": "What it is:",
              "text": "Four guarantees a transactional database gives: ==A==, ==C==, ==I==, ==D=="
            },
            {
              "icon": "zap",
              "label": "Why it exists:",
              "text": "Without them, crashes and concurrency **silently** corrupt data, and every app rebuilds safety by hand"
            },
            {
              "icon": "database",
              "label": "Used for:",
              "text": "Picking {icon:postgresql} PostgreSQL or {icon:mysql} MySQL InnoDB over weaker NoSQL for payments, ledgers, bookings"
            }
          ]
        },
        {
          "type": "table",
          "headers": [
            "Letter",
            "Guarantee",
            "Mechanism"
          ],
          "rows": [
            [
              "**A**tomicity",
              "All or nothing",
              "Undo log"
            ],
            [
              "**C**onsistency",
              "Rules always hold",
              "Constraints"
            ],
            [
              "**I**solation",
              "No interference",
              "Locks / MVCC"
            ],
            [
              "**D**urability",
              "Survives power loss",
              "WAL + fsync at COMMIT"
            ]
          ],
          "frame": "solid"
        },
        {
          "type": "heading",
          "text": "1. Transfer 100 from 50",
          "ink": "green"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "BEGIN;",
            "UPDATE acct SET bal = bal - 100",
            "  WHERE id = 1; -- 50 - 100 < 0",
            "-- ERROR: CHECK (bal >= 0)",
            "ROLLBACK;"
          ],
          "note": "failed CHECK aborts the whole transaction",
          "result": {
            "headers": [
              "id",
              "before",
              "after"
            ],
            "rows": [
              [
                "1",
                "50",
                "50"
              ],
              [
                "2",
                "30",
                "30"
              ]
            ]
          }
        }
      ],
      "aside": "all four, always!",
      "subtitle": "Four safety guarantees"
    },
