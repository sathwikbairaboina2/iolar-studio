            [
              "Read Committed",
              "dirty read"
            ],
            [
              "Repeatable Read",
              "+ non-repeatable read"
            ],
            [
              "Serializable",
              "+ phantom, write skew"
            ]
          ],
          "highlightRow": 3
        }
