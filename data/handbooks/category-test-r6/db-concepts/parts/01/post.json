    {
      "page_title": "Partitioning",
      "blocks": [
        {
          "type": "concept",
          "number": 9,
          "title": "Partitioning",
          "tagline": "split the table, not the server"
        },
        {
          "type": "labelrows",
          "rows": [
            {
              "icon": "table",
              "label": "What it is:",
              "text": "One large table split into smaller ==partitions== inside a **single** database server."
            },
            {
              "icon": "zap",
              "label": "Why it exists:",
              "text": "Huge tables make scans, index maintenance, vacuuming and deletes slow."
            },
            {
              "icon": "database",
              "label": "Used for:",
              "text": "Time-series and log tables, archiving old data, queries that touch one slice."
            }
          ]
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "SELECT count(*) FROM orders",
            "WHERE created_at >= '2026-03-01'",
            "  AND created_at < '2026-04-01';",
            "-- scans only orders_2026_03"
          ],
          "note": "partition pruning skips the rest",
          "result": {
            "headers": [
              "Partition",
              "Read?"
            ],
            "rows": [
              [
                "orders_2026_02",
                "skipped"
              ],
              [
                "orders_2026_03",
                "scanned"
              ],
              [
                "orders_2026_04",
                "skipped"
              ]
            ]
          }
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "DROP TABLE orders_2026_01;",
            "-- not a DELETE of 50M rows"
          ],
          "note": "instant, no dead tuples left"
        },
        {
          "type": "heading",
          "text": "HOW IT WORKS",
          "style": "ribbon"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "CREATE TABLE orders (...)",
            "PARTITION BY RANGE (created_at);",
            "CREATE TABLE orders_2026_03",
            "  PARTITION OF orders",
            "  FOR VALUES FROM ('2026-03-01')",
            "  TO ('2026-04-01');"
          ],
          "note": "one partition per month"
        },
        {
          "type": "heading",
          "text": "1. Benefits",
          "ink": "green"
        },
        {
          "type": "bullets",
          "items": [
            "Faster queries: ==pruning== reads one slice",
            "Smaller **indexes** per partition",
            "Cheap bulk deletes: drop a partition",
            "Easier maintenance: vacuum one piece"
          ],
          "style": "checkbox",
          "frame": "solid",
          "ink": "green"
        },
        {
          "type": "heading",
          "text": "2. Partitioning vs Sharding",
          "ink": "blue"
        },
        {
          "type": "table",
          "headers": [
            "",
            "Partitioning",
            "Sharding"
          ],
          "rows": [
            [
              "Servers",
              "One node",
              "Many nodes"
            ],
            [
              "Adds capacity",
              "No",
              "Yes"
            ],
            [
              "Best key",
              "Range: time data",
              "Hash: even spread"
            ]
          ],
          "highlightRow": 0
        }
      ],
      "hero": "database",
      "aside": "one node only!",
      "subtitle": "Split one big table"
    },
    {
      "page_title": "Partitioning Pitfalls",
      "blocks": [
        {
          "type": "heading",
          "text": "1. Watch Out",
          "ink": "red"
        },
        {
          "type": "bullets",
          "items": [
            "Query **without** the partition key scans all partitions",
            "A bad key causes ==skew==: one hot partition",
            "Does not add servers: one machine's limits stay"
          ],
          "style": "cross",
          "frame": "solid",
          "ink": "red"
        },
        {
          "type": "callout",
          "style": "banner",
          "title": "INTERVIEW TAKEAWAY:",
          "text": "Partitioning is within one node, sharding spans many nodes. Pick range for time data and hash for even spread."
        }
      ],
      "hero": "database",
      "subtitle": "Split one big table"
    },
    {
      "page_title": "Sharding",
      "blocks": [
        {
          "type": "concept",
          "number": 10,
          "title": "Sharding",
          "tagline": "one key, many servers"
        },
        {
          "type": "labelrows",
          "rows": [
            {
              "icon": "database",
              "label": "What it is:",
              "text": "==Horizontally== splitting data across servers, each shard holding a subset of rows"
            },
            {
              "icon": "server",
              "label": "Why it exists:",
              "text": "One machine runs out of **write** throughput, storage or memory; vertical scaling hits a ceiling"
            },
            {
              "icon": "zap",
              "label": "Used for:",
              "text": "Huge, write-heavy datasets at scale: users, messages, orders"
            }
          ]
        },
        {
          "type": "heading",
          "text": "1. HOW IT WORKS",
          "style": "ribbon"
        },
        {
          "type": "code",
          "lang": "python",
          "lines": [
            "shard = hash(user_id) % 4",
            "# user 1042 -> shard 2",
            "db = shards[shard]",
            "db.query(sql, user_id)"
          ],
          "note": "app or router picks the shard",
          "result": {
            "headers": [
              "user_id",
              "shard"
            ],
            "rows": [
              [
                "1042",
                "2"
              ]
            ]
          }
        },
        {
          "type": "diagram",
          "kind": "flow",
          "spec": {
            "nodes": [
              {
                "text": "App",
                "sub": "user 1042",
                "ink": "blue"
              },
              {
                "text": "Router",
                "sub": "hash % 4 = 2",
                "ink": "orange"
              },
              {
                "text": "Shard 2",
                "sub": "owns 1042",
                "ink": "green"
              }
            ]
          }
        },
        {
          "type": "paragraph",
          "text": "Going from `% 4` to `% 5` remaps ~80% of keys. ==Consistent hashing== lets you add a shard and move only about **1/N** of them."
        },
        {
          "type": "heading",
          "text": "2. WINS VS CATCHES",
          "style": "ribbon"
        },
        {
          "type": "table",
          "headers": [
            "Benefit",
            "Catch"
          ],
          "rows": [
            [
              "Writes, storage scale ~linearly",
              "Resharding is painful"
            ],
            [
              "Failure hits one shard",
              "Cross-shard joins, transactions costly"
            ],
            [
              "Shards sit near users",
              "Hot key overloads a shard"
            ]
          ]
        },
        {
          "type": "heading",
          "text": "3. COMMON MISTAKES",
          "style": "ribbon"
        },
        {
          "type": "bullets",
          "items": [
            "Sharding before indexing, caching, replication",
