        {
          "type": "labelrows",
          "rows": [
            {
              "icon": "database",
              "label": "What it is:",
              "text": "reads and writes as ==one all-or-nothing unit=="
            },
            {
              "icon": "zap",
              "label": "Why it exists:",
              "text": "a crash midway leaves data **half-updated**"
            },
            {
              "icon": "table",
