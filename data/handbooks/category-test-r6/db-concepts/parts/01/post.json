            {
              "icon": "lock",
              "label": "Isolation:",
              "text": "four levels, weakest to strongest; each one blocks more anomalies"
            },
            {
              "icon": "lock",
              "label": "Locking:",
              "text": "`FOR UPDATE` for hot rows, ==version column== for rare conflicts; order locks"
            }
          ]
