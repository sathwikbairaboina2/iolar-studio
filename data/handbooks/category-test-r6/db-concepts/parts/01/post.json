    {
      "page_title": "Indexing",
      "blocks": [
        {
          "type": "concept",
          "number": 3,
          "title": "Indexing",
          "tagline": "sorted shortcut"
        },
        {
          "type": "labelrows",
          "rows": [
            {
              "icon": "database",
              "label": "What it is:",
              "text": "a ==sorted structure==, usually a B-tree, finds rows without a scan"
            },
            {
              "icon": "zap",
              "label": "Why:",
              "text": "10M-row scan is **O(n)**; B-tree is O(log n), 3-4 page reads"
            },
            {
              "icon": "table",
              "label": "Used for:",
              "text": "WHERE, JOIN keys, ORDER BY, ranges, UNIQUE"
            }
          ]
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "CREATE INDEX",
            "  idx_orders_user_created",
            "  ON orders(user_id, created_at);",
            "",
            "SELECT * FROM orders",
            "WHERE user_id = 42",
            "ORDER BY created_at DESC",
            "LIMIT 10;"
          ],
          "note": "two columns, in order; no sort step",
          "result": {
            "headers": [
              "user_id",
              "created_at"
            ],
            "rows": [
              [
                "42",
                "2026-03-09"
              ],
              [
                "42",
                "2026-03-07"
              ],
              [
                "42",
                "2026-03-02"
              ]
            ]
          }
        },
        {
          "type": "diagram",
          "kind": "flow",
          "spec": {
            "nodes": [
              {
                "text": "Walk the tree",
                "sub": "3-4 page reads",
                "ink": "blue"
              },
              {
                "text": "Land on user 42",
                "ink": "green"
              },
              {
                "text": "Read 10 newest",
                "sub": "already sorted",
                "ink": "orange"
              }
            ]
          }
        },
        {
          "type": "table",
          "headers": [
            "",
            "No index",
            "B-tree"
          ],
          "rows": [
            [
              "10M lookup",
              "full scan",
              "O(log n)"
            ],
            [
              "Latency",
              "seconds",
              "milliseconds"
            ],
            [
              "ORDER BY",
              "extra sort",
              "free"
            ],
            [
              "Covering index",
              "reads table",
              "index only"
            ]
          ],
          "highlightRow": 1
        },
        {
          "type": "sidebox",
          "title": "THINGS TO CONSIDER",
          "items": [
            "Every index slows **INSERT**/UPDATE, uses disk",
            "==Leftmost prefix==: (user_id, created_at) can't serve created_at alone",
            "Low-cardinality (boolean flag) gains little; `LOWER(email)` bypasses plain index"
          ],
          "ink": "red"
        }
      ],
      "hero": "database",
      "aside": "think B-tree!",
      "subtitle": "Find rows fast"
    },
    {
      "page_title": "Isolation Levels",
      "blocks": [
        {
          "type": "concept",
          "number": 4,
          "title": "Isolation Levels",
          "tagline": "how much can txns see?"
        },
        {
          "type": "labelrows",
          "rows": [
            {
              "icon": "eye",
              "label": "What:",
              "text": "A ==dial== for how much txns see of each other's changes."
            },
            {
              "icon": "zap",
              "label": "Why:",
              "text": "**Serializable** strongest but slow. Reports: weak levels; money: strong."
            }
          ]
        },
        {
          "type": "heading",
          "text": "1. Two doctors off call",
          "ink": "blue"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "SELECT count(*) FROM docs",
            "WHERE on_call;  -- both see 2",
            "UPDATE docs SET on_call = false",
            "WHERE name = 'me'; COMMIT;"
          ],
          "note": "each txn checks, then updates own row",
          "result": {
            "headers": [
              "Level",
              "Outcome"
            ],
            "rows": [
              [
                "Repeatable Read",
                "both commit, 0 on call"
              ],
              [
                "Serializable",
                "one **aborts**"
              ]
            ]
          }
        },
        {
          "type": "heading",
          "text": "2. What each level blocks",
          "ink": "green"
        },
        {
          "type": "table",
          "headers": [
            "Level",
            "Blocks",
            "Allows"
          ],
          "rows": [
            [
              "Read Uncommitted",
              "nothing",
              "dirty read"
            ],
            [
              "Read Committed",
              "dirty read",
              "non-repeatable"
            ],
            [
              "Repeatable Read",
              "+ non-repeatable",
              "phantom, write skew"
            ],
            [
              "Serializable",
              "all four",
              "none"
            ]
          ],
          "highlightRow": 3
        },
        {
          "type": "sidebox",
          "title": "3. MISTAKES",
          "items": [
            "Defaults differ: Postgres Read Committed, InnoDB Repeatable Read",
            "Serializable everywhere: aborts pile up",
            "No **retry** on serialization failure"
          ],
          "ink": "red"
        }
      ],
      "hero": "lock",
      "aside": "turn the dial!",
      "subtitle": "Speed vs correctness"
    },
    {
      "page_title": "Locking",
      "blocks": [
        {
          "type": "concept",
          "number": 5,
          "title": "Locking",
          "tagline": "one writer at a time"
        },
        {
          "type": "labelrows",
          "rows": [
            {
              "icon": "lock",
              "label": "What it is:",
              "text": "a transaction ==reserves a row or table== so others can't change it"
            },
            {
              "icon": "zap",
              "label": "Why:",
              "text": "two writers on one row cause **lost updates**"
            },
            {
              "icon": "database",
              "label": "Used for:",
              "text": "counters, stock, seat bookings, balances"
            }
          ]
        },
        {
          "type": "diagram",
          "kind": "flow",
          "spec": {
            "nodes": [
              {
                "text": "A reads stock",
                "sub": "sees 5",
                "ink": "blue"
              },
              {
                "text": "B reads stock",
                "sub": "sees 5",
                "ink": "blue"
              },
              {
                "text": "A writes 4",
                "sub": "commits",
                "ink": "green"
              },
              {
                "text": "B writes 4",
                "sub": "should be 3",
                "ink": "red"
              }
            ]
          }
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "BEGIN;",
            "SELECT stock FROM items",
            "  WHERE id = 7 FOR UPDATE;",
            "UPDATE items SET stock = 4",
            "  WHERE id = 7;",
            "COMMIT;"
          ],
          "note": "other writers block until COMMIT",
          "result": {
            "headers": [
              "stock"
            ],
            "rows": [
              [
                "5"
              ]
            ]
          }
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "UPDATE items",
            "  SET stock = stock - 1,",
            "      version = 4",
            "  WHERE id = 7",
            "    AND version = 3;"
          ],
          "note": "0 rows updated means retry",
          "result": {
            "headers": [
              "rows updated",
              "action"
            ],
            "rows": [
              [
                "1",
                "done"
              ],
              [
                "0",
                "retry"
              ]
            ]
          }
        },
        {
          "type": "table",
          "headers": [
            "1. Aspect",
            "Pessimistic",
            "Optimistic"
          ],
          "rows": [
            [
              "Mechanism",
              "`FOR UPDATE`",
              "version column"
            ],
            [
              "Locks held",
              "until COMMIT",
              "none"
            ],
            [
              "Lost updates",
              "prevented",
              "prevented"
            ],
            [
              "Strength",
              "simple, certain",
              "scales, no locks"
            ],
            [
              "Best when",
              "high contention",
              "rare conflicts"
            ]
          ],
          "highlightRow": 4
        },
        {
          "type": "sidebox",
          "title": "2. Mistakes and takeaway",
          "items": [
            "Random lock order: A waits on B, B on A (**deadlock**); lock by id",
            "Holding locks long: ==throughput== collapses",
            "Optimistic retries waste work when conflicts are common",
            "Takeaway: `FOR UPDATE` for hot rows; version column for rare conflicts; lock in order"
          ],
          "ink": "red"
        }
      ],
      "hero": "lock",
      "aside": "hot row? lock it!",
      "subtitle": "Pessimistic vs optimistic"
    },
    {
      "page_title": "MVCC",
      "blocks": [
        {
          "type": "concept",
          "number": 6,
          "title": "MVCC",
          "tagline": "snapshot reads"
        },
        {
          "type": "labelrows",
          "rows": [
            {
              "icon": "database",
              "label": "What:",
              "text": "==Multi-Version Concurrency Control==: many row versions, **consistent snapshot** reads."
            },
            {
              "icon": "lock",
              "label": "Why:",
              "text": "Plain locking makes readers wait for writers, hurting **read-heavy** throughput."
            },
            {
              "icon": "server",
              "label": "Used in:",
              "text": "PostgreSQL, MySQL InnoDB, Oracle: snapshot reads (Read Committed, Repeatable Read)."
            }
          ]
        },
        {
          "type": "heading",
          "text": "1. How it works",
          "style": "ribbon"
        },
        {
          "type": "table",
          "headers": [
            "Version",
            "Balance",
            "xmin (creator)",
            "xmax (deleter)"
          ],
          "rows": [
            [
              "v1",
              "500",
              "90",
              "101"
            ],
            [
              "v2",
              "400",
              "101",
              "—"
            ]
          ],
          "highlightRow": 0,
          "frame": "solid"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "-- txn 100 reads, snapshot taken",
            "SELECT bal FROM acct WHERE id=1;",
            "-- txn 101, meanwhile",
            "UPDATE acct SET bal=400 WHERE id=1;",
            "COMMIT; -- 100 still reads 500"
          ],
          "note": "txn 100 sees 500 until it ends",
          "result": {
            "headers": [
              "Txn",
              "Sees",
              "Waits?"
            ],
            "rows": [
              [
                "100",
                "500",
                "no"
              ],
              [
                "101",
                "400",
                "no"
              ]
            ]
          }
        },
        {
          "type": "heading",
          "text": "2. Locking vs MVCC",
          "ink": "blue"
        },
        {
          "type": "table",
          "headers": [
            "Case",
            "Plain locking",
            "MVCC"
          ],
          "rows": [
            [
              "Read vs write",
              "reader waits",
              "no blocking"
            ],
            [
              "Write vs read",
              "writer waits",
              "no blocking"
            ],
            [
              "Write vs write",
              "writer waits",
              "still conflicts"
            ],
            [
              "Read snapshot",
              "not kept",
              "consistent"
            ]
          ]
        },
        {
          "type": "sidebox",
          "title": "3. Watch out for",
          "items": [
            "Old versions pile up as **dead tuples**: needs ==VACUUM==",
            "Long transactions block cleanup, cause **bloat**",
            "Writers on the **same row** still conflict"
          ],
          "ink": "red"
        }
      ],
      "hero": "database",
      "aside": "readers never wait!",
      "subtitle": "Many row versions"
    },
    {
      "page_title": "Connection Pooling",
      "blocks": [
        {
          "type": "concept",
          "number": 7,
          "title": "Connection Pooling",
          "tagline": "open once, reuse thousands of times"
        },
        {
          "type": "labelrows",
          "rows": [
            {
              "icon": "database",
              "label": "What it is:",
              "text": "a cache of open connections that threads **borrow** and return"
            },
            {
              "icon": "zap",
              "label": "Why it exists:",
              "text": "each new connection costs a TCP handshake, TLS and auth: tens of ms"
            },
            {
              "icon": "server",
              "label": "Used for:",
              "text": "busy web backends, serverless functions and connection storms"
            }
          ]
        },
        {
          "type": "diagram",
          "kind": "flow",
          "spec": {
            "nodes": [
              {
                "text": "200 requests",
                "sub": "concurrent",
                "ink": "orange"
              },
              {
                "text": "Pool of 20",
                "sub": "180 wait in queue",
                "ink": "blue"
              },
              {
                "text": "PostgreSQL",
                "sub": "20 queries at once",
                "ink": "green"
              }
            ]
          }
        },
        {
          "type": "bullets",
          "items": [
            "Connections return to the pool after each query; sessions and prepared statements get reused",
            "A Postgres connection is a process using **several MB**",
            "==PgBouncer== (transaction mode): thousands of clients onto ~50 server connections",
            "No handshake means lower latency, plus a ==hard cap== on DB load"
          ],
          "style": "dot",
          "frame": "solid",
          "ink": "blue"
        },
        {
          "type": "table",
          "headers": [
            "Setup",
            "DB conns",
            "Effect"
          ],
          "rows": [
            [
              "No pool",
              "1 per request",
              "handshake each time"
            ],
            [
              "App pool of 20",
              "20 max",
              "180 queue, DB safe"
            ],
            [
              "PgBouncer",
              "~50 total",
              "thousands of clients"
            ]
          ],
          "highlightRow": 2
        },
        {
          "type": "code",
          "lang": "javascript",
          "lines": [
            "const pool = new Pool({ max: 20 });",
            "const c = await pool.connect();",
            "c.release(); // always return"
          ],
          "note": "release in a finally block"
        },
        {
          "type": "bullets",
          "items": [
            "Pool too big: the database **thrashes** on context switches",
            "Pool too small: requests sit in the queue",
            "Leaked connections (no release) drain the pool",
            "Transaction mode breaks `SET` and advisory locks"
          ],
          "style": "cross",
          "frame": "solid",
          "ink": "red"
        }
      ],
      "hero": "database",
      "aside": "size to the DB!",
      "subtitle": "Borrow, query, return"
    },
    {
      "page_title": "Replication",
      "blocks": [
        {
          "type": "concept",
          "number": 8,
          "title": "Replication",
          "tagline": "one primary, many followers"
        },
        {
          "type": "labelrows",
          "rows": [
            {
              "icon": "database",
              "label": "What it is:",
              "text": "==Copies== of the same data on many servers: one **primary** takes writes, replicas follow."
            },
            {
              "icon": "shield-check",
              "label": "Why it exists:",
              "text": "One server is a single point of failure and a **read** bottleneck."
            },
            {
              "icon": "server",
              "label": "Used for:",
              "text": "High availability, read scaling, nearby users, offline analytics, backups."
            }
          ]
        },
        {
          "type": "diagram",
          "kind": "flow",
          "spec": {
            "nodes": [
              {
                "text": "App write",
                "sub": "INSERT comment",
                "ink": "black"
              },
              {
                "text": "Primary",
                "sub": "writes the WAL",
                "ink": "red"
              },
              {
                "text": "Replica 1",
                "sub": "replays WAL",
                "ink": "green"
              },
              {
                "text": "Replica 2",
                "sub": "replays WAL",
                "ink": "green"
              }
            ]
          }
        },
        {
          "type": "table",
          "headers": [
            "Mode",
            "Commit returns when",
            "Cost"
          ],
          "rows": [
            [
              "{blue:Async}",
              "primary has the WAL",
              "may **lose** last writes"
            ],
            [
              "{green:Sync}",
              "≥1 replica has it",
              "slower writes"
            ],
            [
              "Multi-leader",
              "local leader has it",
              "needs conflict resolution"
            ]
          ],
          "highlightRow": 0
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "INSERT INTO comments (body)",
            "VALUES ('nice post');",
            "-- primary, t=0s",
            "SELECT body FROM comments;",
            "-- replica, t=0.1s: lag 2s"
          ],
          "note": "read your own writes from primary",
          "result": {
            "headers": [
              "Read from",
              "New comment?"
            ],
            "rows": [
              [
                "Replica",
                "missing"
              ],
              [
                "Primary",
                "visible"
              ]
            ]
          }
        },
        {
          "type": "sidebox",
          "title": "Benefits and cost",
          "items": [
            "==Failover== in seconds when a primary dies",
            "Read throughput scales by adding replicas",
            "Data survives disk or zone loss",
            "Cost: replica lag gives ==stale reads=="
          ],
          "ink": "green"
        }
      ],
      "hero": "database",
      "aside": "copies = safety",
      "subtitle": "Copies of your data"
