                "headers": [
                  "city",
                  "sales"
                ],
                "rows": [
                  [
                    "Delhi",
                    "300"
                  ],
                  [
                    "Pune",
                    "120"
                  ]
                ]
              }
            },
            {
              "type": "heading",
              "text": "3. Three Result Shapes",
              "ink": "purple"
            },
            {
              "type": "table",
              "headers": [
                "Apply type",
                "Returns"
              ],
              "rows": [
                [
                  "**aggregate**",
                  "One row per group"
                ],
                [
                  "**transform**",
                  "Same length as the input"
                ],
                [
                  "**filter**",
                  "Keeps or drops whole groups"
                ]
              ],
              "highlightRow": 0
            },
            {
              "type": "callout",
