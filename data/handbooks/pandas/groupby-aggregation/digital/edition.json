            {
              "type": "heading",
              "text": "2. Counting tools",
              "ink": "orange"
            },
            {
              "type": "table",
              "headers": [
                "Call",
                "Counts",
                "Options"
              ],
              "rows": [
                [
                  "`s.value_counts()`",
                  "unique values, sorted descending",
                  "`normalize=True` proportions; `dropna=False` keeps NaN"
                ],
                [
                  "`pd.crosstab(df['city'], df['plan'])`",
                  "combinations of two categoricals",
                  "`normalize='index'` row %"
                ]
              ]
            },
            {
              "type": "bullets",
              "items": [
                "**value_counts vs groupby?** Same as `s.groupby(s).size()`, sorted descending",
                "**pivot_table vs crosstab?** pivot_table aggregates a value column; crosstab counts category pairs",
                "**pivot vs pivot_table?** `pivot` only reshapes and fails on duplicates; pivot_table aggregates them"
              ],
              "style": "dot"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Remember",
              "text": "Need a ==value== summary: pivot_table. Need ==counts== of categories: crosstab or value_counts."
            }
          ]
        }
      ]
