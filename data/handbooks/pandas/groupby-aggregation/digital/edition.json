    {
      "title": "Common Mistakes",
      "role": "outline",
      "outlineIndex": 4,
      "pages": [
        {
          "title": "Common Mistakes",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Counts That Disagree",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "groupby drops ==NaN keys== by default; keep them with `dropna=False`",
                "`count()` skips NaN values; `size()` counts all rows"
              ],
              "style": "cross",
              "ink": "red"
            },
            {
              "type": "table",
              "headers": [
                "Call",
                "Counts",
                "NaN"
              ],
              "rows": [
                [
                  "`size()`",
                  "all rows",
                  "included"
                ],
                [
                  "`count()`",
                  "non-NaN values",
                  "skipped"
                ]
              ]
            },
            {
              "type": "heading",
              "text": "2. Wrong or Slow Aggregation",
              "ink": "orange"
            },
            {
              "type": "bullets",
              "items": [
                "`agg('sum')` hits ==every non-key column==: text raises or concatenates",
                "Select the value columns explicitly",
                "`apply` or a lambda is much slower than a built-in name on big data"
              ],
              "style": "cross",
              "ink": "orange"
            },
            {
              "type": "code",
              "lang": "python",
              "lines": [
                "df.groupby('k')['v'].agg('sum')  # fast, explicit",
                "df.groupby('k')['v'].agg(lambda s: s.sum())  # slow"
              ],
              "note": "same result, use the built-in name"
            },
            {
              "type": "heading",
              "text": "3. Fix Summary",
              "ink": "green"
            },
            {
              "type": "table",
              "headers": [
                "Symptom",
                "Fix"
              ],
              "rows": [
                [
                  "Group missing",
                  "`dropna=False`"
                ],
                [
                  "Counts differ",
                  "`size()` vs `count()`"
                ],
                [
                  "Slow groupby",
                  "built-in name"
                ],
                [
                  "Text column error",
                  "`['v']` first"
                ]
              ],
              "highlightRow": 0
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Remember",
              "text": "Select ==columns== first, use ==built-in== names, and set `dropna=False` when NaN keys matter."
            }
          ]
        }
      ]
    },
    {
      "title": "Cheat Sheet: Groupby and Summaries",
      "role": "outline",
      "outlineIndex": 5,
      "pages": [
        {
          "title": "Cheat Sheet: Groupby and Summaries",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Aggregate and Broadcast",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "==agg==: one row per group",
                "==transform==: same length as df, assign back as a column",
                "Named aggregation gives clean column names"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "blue"
            },
            {
              "type": "code",
              "lang": "python",
              "lines": [
                "df.groupby('k')['v'].agg(['sum','mean'])",
                "df.groupby('k').agg(total=('v','sum'))",
                "df['x'] = df.groupby('k')['v'].transform('mean')"
              ],
              "note": "agg reduces, transform keeps the index"
            },
            {
              "type": "heading",
              "text": "2. Grids and Counts",
              "ink": "purple"
            },
            {
              "type": "bullets",
              "items": [
                "`pivot_table`: value grid; `fill_value=0` fills NaN, `margins=True` adds All",
                "`value_counts`: one column's frequencies; `normalize=True` gives shares",
                "`crosstab`: category counts; `normalize='index'` gives row %"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "purple"
            },
            {
              "type": "code",
              "lang": "python",
              "lines": [
                "df.pivot_table(index='a', columns='b', values='v',",
                "    aggfunc='sum', fill_value=0, margins=True)",
                "s.value_counts(normalize=True)",
                "pd.crosstab(df.a, df.b, normalize='index')"
              ]
            },
            {
              "type": "heading",
              "text": "3. Interview Point: Pick the Tool",
              "ink": "green"
            },
            {
              "type": "table",
              "headers": [
                "Tool",
                "Returns"
              ],
              "rows": [
                [
                  "`agg`",
                  "One row per group"
                ],
                [
                  "`transform`",
                  "Same-length output"
                ],
                [
                  "`pivot_table`",
                  "A value grid"
                ],
                [
                  "`crosstab`",
                  "Category counts"
                ],
                [
                  "`value_counts`",
                  "One column's frequencies"
                ]
              ],
              "frame": "dashed"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Select the column",
              "text": "`groupby('k').agg('sum')` aggregates every other column. Write `groupby('k')['v'].agg('sum')`."
            }
          ]
        }
      ]
