      "pages": [
        {
          "title": "Category Dtype: The Mental Model",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Codes plus Categories",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "Stores a small array of ==unique values== (the **categories**)",
                "Each row holds only an ==integer code== pointing into that array",
                "`s.cat.categories` shows the array, `s.cat.codes` the per-row codes"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "code",
              "lang": "python",
              "lines": [
                "s = df['city'].astype('category')",
                "s.cat.categories  # unique values",
                "s.cat.codes       # one int per row",
                "c = pd.Categorical(vals,",
                "    categories=['low', 'mid', 'high'])"
              ],
              "note": "two ways to create one"
            },
            {
              "type": "heading",
              "text": "2. Memory Saving",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "",
                "object",
                "category"
              ],
              "rows": [
                [
                  "Per row",
                  "one {red:Python object}",
                  "{green:~1 to 2 bytes} (a code)"
                ],
                [
                  "Unique value",
                  "repeated every row",
                  "stored ==once=="
                ]
              ],
              "frame": "dashed"
            },
            {
              "type": "bullets",
              "items": [
                "Check with `df.memory_usage(deep=True)`",
                "Without `deep=True`, object columns are ==badly under-reported=="
              ],
              "style": "check"
            },
            {
              "type": "heading",
              "text": "3. When It Pays Off",
              "ink": "purple"
            },
            {
              "type": "bullets",
              "items": [
                "{green:Best}: few unique values, many rows (country, status)",
                "{red:Poor}: near-unique column such as an ID",
                "An ID gains nothing and can get ==larger=="
              ],
              "style": "dot"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Rule of thumb",
              "text": "Low cardinality shrinks a lot. Near-unique gains nothing. Always measure with `deep=True`."
            }
          ]
        }
      ]
    },
