            },
            {
              "type": "code",
              "lang": "python",
              "lines": [
                "out = (df.query('x > @v')",
                "  .assign(y=lambda d: d.a * 2)",
                "  .pipe(clean)",
                "  .sort_values('y'))"
              ],
              "note": "one step per line, no inplace"
