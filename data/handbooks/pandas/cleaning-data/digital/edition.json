                  },
                  {
                    "text": "Fix dtypes",
                    "ink": "green"
                  },
                  {
                    "text": "Handle missing",
                    "ink": "orange"
                  },
                  {
                    "text": "Clean text, names",
                    "ink": "purple"
                  },
                  {
                    "text": "Drop duplicates",
                    "ink": "red"
                  }
                ]
              }
            },
            {
              "type": "bullets",
              "items": [
                "`df.info()` shows dtype and non-null count per column",
                "A text dtype (`str` in pandas 3, `object` before) on a numeric-looking column = {red:dirty data}"
              ],
              "style": "dot"
            },
            {
              "type": "heading",
              "text": "3. Vectorized vs Row-by-Row",
              "ink": "purple"
            },
            {
              "type": "table",
              "headers": [
                "Style",
                "Runs in",
                "Speed"
