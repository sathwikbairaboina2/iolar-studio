          "title": "Shrinking Memory with Dtypes",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Smaller numbers",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "Call",
                "Result"
              ],
              "rows": [
                [
                  "`to_numeric(s, downcast='integer')`",
                  "smallest int that fits: int8, int16, int32"
                ],
                [
                  "`downcast='unsigned'`",
                  "uint, for non-negative data"
                ],
                [
                  "`downcast='float'`",
                  "float32"
                ],
                [
                  "`s.astype('int32')`",
                  "explicit; you pick the width"
                ]
              ]
            },
            {
              "type": "bullets",
              "items": [
                "==Check values fit== before `astype`",
                "NumPy casts {red:overflow wraps silently}, no error"
              ],
              "style": "cross",
              "ink": "red"
            },
            {
              "type": "heading",
              "text": "2. Categories and nullable types",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "`astype('category')` stores ==integer codes== plus one lookup of uniques",
                "Big saving when unique count is {green:far below} row count"
              ],
              "style": "dot"
            },
            {
              "type": "table",
              "headers": [
                "Nullable dtype",
                "Avoids"
              ],
              "rows": [
                [
                  "`Int64`, `Float64`",
                  "fallback to float64 for missing"
                ],
                [
                  "`'string'`, `'boolean'`",
                  "fallback to object"
                ],
                [
                  "`convert_dtypes()`",
                  "infers these for you"
                ]
              ]
            },
            {
              "type": "heading",
              "text": "3. Set dtypes at load",
              "ink": "orange"
            },
            {
              "type": "code",
              "lang": "python",
              "lines": [
                "df = pd.read_csv('f.csv',",
                "    dtype={'id': 'int32', 'tag': 'category'},",
                "    usecols=['id', 'tag'])",
