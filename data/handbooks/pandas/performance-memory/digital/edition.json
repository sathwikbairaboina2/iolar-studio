          "title": "Avoiding apply and iterrows",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Row loops are slow",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "`iterrows()` builds a ==Series per row==: slow",
                "Mixed dtypes get ==upcast== to one type, silently",
                "`itertuples()` is much faster if a loop is truly needed"
              ],
              "style": "dot"
            },
            {
              "type": "table",
              "headers": [
                "Tool",
                "Runs in",
                "Speed"
              ],
              "rows": [
                [
                  "`apply(f, axis=1)`",
                  "Python, f per row",
                  "slow"
                ],
                [
                  "`Series.apply(f)`",
                  "Python, f per element",
                  "slow"
                ],
                [
                  "Vectorised op",
                  "compiled, whole column",
                  "{green:10-100x faster}"
                ]
              ],
              "highlightRow": 2
            },
            {
              "type": "heading",
              "text": "2. Build once",
              "ink": "blue"
