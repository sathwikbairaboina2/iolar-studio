          "blocks": [
            {
              "type": "qa",
              "q": "An `object` column holds 1M strings drawn from 5 labels. Why does `df.memory_usage()` report only about 8 MB for it?",
              "a_bullets": [
                "The default is shallow: object columns count 8-byte pointers only.",
                "`deep=True` counts the real string bytes."
              ]
            },
            {
              "type": "qa",
              "q": "In pandas 3, what happens to `df` after this line, and what is the fix?",
              "a_bullets": [
                "`df` is unchanged: chained assignment sets a copy.",
                "Fix: `df.loc[df['a'] > 0, 'b'] = 1`."
              ],
              "example_code": [
                "df[df['a'] > 0]['b'] = 1"
              ]
            },
            {
              "type": "qa",
              "q": "What does this print, and why?",
              "a_bullets": [
                "`1.0` then `2.0`.",
                "`iterrows` builds one Series per row, upcasting int and float to float64."
              ],
              "example_code": [
                "df = pd.DataFrame({'id': [1, 2], 'price': [2.5, 3.5]})",
                "for _, r in df.iterrows():",
                "    print(r['id'])"
              ]
            }
