              ],
              "note": "full-width frame is never built"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Not for money",
              "text": "float32 keeps ==~7 digits== of precision. Avoid it for money."
            }
          ]
        }
      ]
