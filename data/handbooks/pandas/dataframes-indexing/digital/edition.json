            {
              "type": "heading",
              "text": "3. Filter and Index",
              "ink": "purple"
            },
            {
              "type": "code",
              "lang": "python",
              "lines": [
                "df[(df.age > 30) & (df.city == 'NYC')]",
                "df[df['city'].isin(['NYC', 'LA'])]",
                "df[~df['city'].isin(['LA'])]"
              ],
              "note": "parentheses around each condition; ~ means not"
            },
            {
              "type": "bullets",
              "items": [
                "`set_index('col')` and `reset_index(drop=True)` return a ==new DataFrame==",
                "Assign it: `df = df.set_index('id')`",
                "Reset after filtering to get 0..n-1 back"
              ],
              "style": "check"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Chained assignment",
              "text": "`df[mask]['b'] = 0` never changes df and warns (ChainedAssignmentError). Use `df.loc[mask, 'b'] = 0`."
