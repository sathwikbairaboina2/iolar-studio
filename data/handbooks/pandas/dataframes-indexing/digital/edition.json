    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "A DataFrame has index labels [10, 11, 12, 13]. How many rows do `df.loc[11:13]` and `df.iloc[1:3]` return?",
              "a_bullets": [
                "`loc` is end-inclusive: 3 rows (11, 12, 13)",
                "`iloc` is end-exclusive: 2 rows (labels 11 and 12)"
              ]
            },
            {
              "type": "qa",
              "q": "Why does `df[df.age > 30 & df.x == 1]` fail, and what is the fix?",
              "a_bullets": [
                "`&` binds tighter than `>` and `==`, so the parts are combined in the wrong order",
                "Wrap each condition: `df[(df.age > 30) & (df.x == 1)]`"
              ]
            },
            {
              "type": "qa",
              "q": "Ages are [20, 40, 50]. After `df2 = df[df.age > 30]`, what do `df2.iloc[0]` and `df2.loc[0]` do?",
              "a_bullets": [
                "`iloc[0]` returns the first remaining row, labelled 1",
                "`loc[0]` raises KeyError: label 0 was filtered out",
                "Use `reset_index(drop=True)` if you need positions as labels"
              ]
            }
          ]
        }
      ]
