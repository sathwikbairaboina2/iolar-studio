          "title": "Merge Mental Model and Join Types",
          "blocks": [
            {
              "type": "heading",
              "text": "1. What merge does",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "`pd.merge(left, right, on='key', how='inner')` works like a ==SQL JOIN==",
                "Matches rows by **key values**, not by position or index label"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "heading",
              "text": "2. Join types",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "how",
                "Keeps",
                "Other side"
              ],
              "rows": [
                [
                  "`inner`",
                  "keys in **both** frames",
                  "no NaN"
                ],
                [
                  "`left`",
                  "every left row",
                  "right columns {red:NaN}"
                ],
                [
                  "`right`",
                  "every right row (mirror of left)",
                  "left columns {red:NaN}"
                ],
                [
                  "`outer`",
                  "all keys from both",
                  "{red:NaN} on the missing side"
                ]
              ],
              "highlightRow": 1
            },
            {
              "type": "code",
              "lang": "python",
              "lines": [
                "orders.merge(customers, on='cust_id', how='left')"
              ],
              "note": "all orders kept, even when the customer is missing",
              "result": {
                "headers": [
                  "order_id",
                  "cust_id",
                  "name"
                ],
                "rows": [
                  [
                    "1",
                    "c1",
                    "Ana"
                  ],
                  [
                    "2",
                    "c2",
                    "Ben"
                  ],
                  [
                    "3",
                    "c9",
                    "NaN"
                  ]
                ]
              }
            },
            {
              "type": "heading",
              "text": "3. Duplicate keys multiply",
              "ink": "red"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "2 left rows",
                    "sub": "key A",
                    "ink": "blue"
                  },
                  {
                    "text": "3 right rows",
                    "sub": "key A",
                    "ink": "purple"
                  },
                  {
                    "text": "6 rows",
                    "sub": "2 x 3",
                    "ink": "red"
                  }
                ]
              }
            },
            {
              "type": "bullets",
              "items": [
                "Find unmatched rows: `how='left', indicator=True`, then `_merge == 'left_only'`"
              ],
              "style": "check"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Silent growth",
              "text": "Repeated keys on both sides ==multiply== rows. Compare the **row count** before and after every merge."
            }
          ]
        }
      ]
