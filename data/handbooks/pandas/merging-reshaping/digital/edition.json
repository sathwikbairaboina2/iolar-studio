            {
              "type": "heading",
              "text": "2. MultiIndex Basics",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "==MultiIndex== = index with several levels",
                "Build: `set_index(['a','b'])` or `groupby(['a','b'])`",
                "Read: `loc[('a1','b1')]` for one row, `xs('b1', level='b')` for one level"
