              "type": "heading",
              "text": "1. Join by key",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "`how=` {blue:inner} | {green:left} | {orange:right} | {purple:outer}",
                "`validate='1:1'` raises on bad keys; `indicator=True` adds `_merge`",
                "Key names differ: `left_on=` + `right_on=`; `df.join(o)` joins on the ==index=="
              ],
              "style": "dot",
              "ink": "blue"
            },
            {
              "type": "code",
              "lang": "python",
              "lines": [
                "r = a.merge(b, on='k', how='left',",
                "            suffixes=('_l','_r'),",
                "            validate='1:1', indicator=True)",
                "r[r['_merge'] == 'left_only']",
                "a.merge(b, left_on='a_id', right_on='b_id')"
              ],
              "note": "how='left' keeps unmatched rows so left_only can find them"
            },
            {
              "type": "heading",
              "text": "2. Combine and reshape",
              "ink": "purple"
            },
            {
              "type": "table",
              "headers": [
                "Job",
                "Call"
              ],
              "rows": [
                [
                  "Glue frames",
                  "`pd.concat([a,b], axis=0|1, ignore_index=True, join='outer')`"
                ],
                [
                  "Wide to long",
                  "`pd.melt(df, id_vars, value_vars, var_name, value_name)`"
                ],
                [
                  "Long to wide",
                  "`pivot` (unique pairs) or `pivot_table` (aggfunc, fill_value)"
                ],
                [
                  "Columns into index",
                  "`df.stack()`; back with `s.unstack(level)`"
                ],
                [
