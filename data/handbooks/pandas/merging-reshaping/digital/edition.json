    {
      "title": "Join Keys, Suffixes and Validation",
      "role": "outline",
      "outlineIndex": 1,
      "pages": [
        {
          "title": "Join Keys, Suffixes and Validation",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Keys and defaults",
              "ink": "green"
            },
            {
              "type": "table",
              "headers": [
                "Key columns",
                "Argument"
              ],
              "rows": [
                [
                  "Same name",
                  "`on='k'`"
                ],
                [
                  "Different names",
                  "`left_on='a_id', right_on='b_id'` (both columns stay)"
                ],
                [
                  "Index",
                  "`left_index=True, right_index=True`"
                ]
              ]
            },
            {
              "type": "bullets",
              "items": [
                "`df.join(other)`: joins on the ==index==, default {blue:left}",
                "`pd.merge`: joins on shared column names, default {green:inner}"
              ],
              "style": "dot"
            },
            {
              "type": "heading",
              "text": "2. Suffixes",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "Overlapping non-key columns get `_x`, `_y` by default",
                "Pass `suffixes=('_l','_r')` for ==readable== names"
              ],
              "style": "dot"
            },
            {
              "type": "heading",
              "text": "3. Validate and audit",
              "ink": "purple"
            },
            {
              "type": "bullets",
              "items": [
                "`validate='one_to_one'`, `'one_to_many'`, `'many_to_one'` ==raises MergeError== if uniqueness fails",
                "`indicator=True` adds `_merge`: `left_only`, `right_only`, `both`"
              ],
              "style": "dot"
            },
            {
              "type": "code",
              "lang": "python",
              "lines": [
                "a = pd.DataFrame({'a_id': [1, 2, 3]})",
                "b = pd.DataFrame({'b_id': [1, 2]})",
                "r = a.merge(b, left_on='a_id', right_on='b_id',",
                "            how='left', validate='one_to_one', indicator=True)",
                "print(r)"
              ],
              "note": "find unmatched rows: r[r['_merge'] == 'left_only']"
            },
            {
              "type": "code",
              "lang": "output",
              "lines": [
                "   a_id  b_id     _merge",
                "0     1   1.0       both",
                "1     2   2.0       both",
                "2     3   NaN  left_only"
              ]
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Audit needs how='left'",
              "text": "Default inner keeps only matches, so `left_only` never appears. Use `how='left'` or `'outer'`."
            }
          ]
        }
      ]
    },
