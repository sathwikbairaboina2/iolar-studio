            {
              "type": "code",
              "lang": "python",
              "lines": [
                "s = df.set_index(['a','b'])['v']",
                "s.unstack()",
                "s.unstack(fill_value=0)",
                "s.loc[('a1','b1')]",
                "s.xs('b1', level='b')"
              ],
              "note": "df has columns a, b, v",
              "result": {
                "headers": [
