      "pages": [
        {
          "title": "Plotting Mental Model",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Pandas Wraps Matplotlib",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "`df.plot()` and `s.plot()` are ==thin wrappers== over matplotlib",
                "They return an ==Axes== object",
                "The ==index== becomes the x-axis",
                "Each ==numeric column== becomes one series"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "heading",
              "text": "2. Figure and Axes",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "{blue:Figure} = the whole canvas",
                "{purple:Axes} = one plot area with its own x/y axis",
                "`fig, ax = plt.subplots()` is preferred over the implicit `plt` state machine"
              ],
              "style": "dot"
            },
            {
              "type": "table",
              "headers": [
                "",
                "Pyplot",
                "Object API"
              ],
              "rows": [
                [
                  "Call",
                  "`plt.plot`, `plt.title`",
                  "`ax.plot`, `ax.set_title`"
                ],
                [
                  "Acts on",
                  "the **current** axes, implicitly",
                  "an **explicit** axes"
                ],
                [
                  "Multiple plots",
                  "easy to hit the wrong one",
                  "==scales== well"
                ]
              ],
              "highlightRow": 2
            },
            {
              "type": "heading",
              "text": "3. Pandas vs Seaborn vs Matplotlib",
              "ink": "purple"
            },
            {
              "type": "table",
              "headers": [
                "Tool",
                "Best for",
                "Data"
              ],
              "rows": [
                [
                  "pandas",
                  "fastest **quick** plots",
                  "wide-form"
                ],
                [
                  "seaborn",
                  "**statistical** plots",
                  "long-form"
                ],
                [
                  "matplotlib",
                  "==full control==",
                  "any"
                ]
              ]
            },
            {
              "type": "heading",
              "text": "4. Gotchas",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "`plot()` ignores non-numeric columns ==silently==",
                "In scripts nothing shows until `plt.show()`"
              ],
              "style": "cross",
              "frame": "dashed",
              "ink": "red"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Remember",
              "text": "Notebooks render automatically; **scripts need** `plt.show()`."
            }
          ]
        }
      ]
    },
    {
      "title": "DataFrame.plot Chart Kinds",
      "role": "outline",
      "outlineIndex": 1,
      "pages": [
        {
          "title": "DataFrame.plot Chart Kinds",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Choosing the kind",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "`kind=` picks the chart; default is =='line'==",
                "`df.plot.bar()` is the same as `df.plot(kind='bar')`"
              ],
              "style": "dot",
              "ink": "green"
            },
            {
              "type": "table",
              "headers": [
                "kind",
                "Use for"
              ],
              "rows": [
                [
                  "`line`, `area`",
                  "ordered or time data"
                ],
                [
                  "`bar`, `barh`",
                  "categories"
                ],
                [
                  "`hist`, `box`",
                  "one variable's spread"
                ],
                [
                  "`scatter`, `pie`",
                  "two variables, shares"
                ]
              ]
            },
            {
              "type": "heading",
              "text": "2. Line and bar",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "Line: ==one line per column==, x from `x=` or the index",
                "Bar: `stacked=True` stacks columns",
                "`barh` flips horizontal for ==long labels=="
              ],
              "style": "dot",
              "ink": "blue"
            },
            {
              "type": "code",
              "lang": "python",
              "lines": [
                "df.plot(x='date', y='sales')",
                "df['city'].value_counts().plot.bar()",
                "df.plot.bar(x='city', y='sales', stacked=True)"
              ]
            },
            {
              "type": "heading",
              "text": "3. Hist and scatter",
              "ink": "purple"
            },
            {
              "type": "bullets",
              "items": [
                "Hist: ==bins== sets resolution; `alpha=0.5` to overlay columns",
                "Scatter: name both `x` and `y`; `c` colors, `s` sizes points"
              ],
              "style": "dot",
              "ink": "purple"
            },
            {
              "type": "code",
              "lang": "python",
              "lines": [
                "df['age'].plot.hist(bins=20, alpha=0.5)",
                "df.plot.scatter(x='height', y='weight', c='age', s=20)"
              ]
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Scatter",
              "text": "Unlike line, `scatter` ==fails without x and y==. `c` and `s` add a third variable."
            }
          ]
        }
      ]
    },
    {
      "title": "Figure and Axes Control",
      "role": "outline",
      "outlineIndex": 2,
      "pages": [
        {
          "title": "Figure and Axes Control",
          "blocks": [
            {
              "type": "heading",
              "text": "1. The subplots grid",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "`plt.subplots(2, 2, figsize=(10, 6))` returns `fig, axes`",
                "`axes` is a ==2D NumPy array==: use `axes[0, 1]`; `axes.ravel()` flattens",
                "`ax=axes[0, 1]` draws into that subplot",
                "Without `ax=`, pandas makes a ==new figure== or reuses the current axes"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "code",
              "lang": "python",
              "lines": [
                "fig, axes = plt.subplots(2, 2, figsize=(10, 6))",
                "df['a'].plot(ax=axes[0, 1])",
                "df['b'].plot.hist(ax=axes[1, 0])",
                "fig.tight_layout()"
              ],
              "note": "each call targets one chosen subplot"
            },
            {
              "type": "heading",
              "text": "2. One panel per column",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "df.plot option",
                "Effect"
              ],
              "rows": [
                [
                  "`subplots=True`",
                  "one subplot per column"
                ],
                [
                  "`sharex=True`, `sharey=True`",
                  "align the scales"
                ],
                [
                  "`layout=(2, 2)`",
                  "sets the grid"
                ]
              ],
              "frame": "dashed"
            },
            {
              "type": "heading",
              "text": "3. Two scales and polish",
              "ink": "purple"
            },
            {
              "type": "bullets",
              "items": [
                "Two scales: plot `b` with ==secondary_y=True== on the same `ax`",
                "Matplotlib way: `ax.twinx()` shares x, adds a second y-axis"
              ],
              "style": "dot"
            },
            {
              "type": "code",
              "lang": "python",
              "lines": [
                "ax = df['a'].plot()",
                "df['b'].plot(ax=ax, secondary_y=True)",
                "# matplotlib: ax2 = ax.twinx()"
              ]
            },
            {
              "type": "table",
              "headers": [
                "Call",
                "Adjusts"
              ],
              "rows": [
                [
                  "`fig.tight_layout()`",
                  "stops overlapping labels"
                ],
                [
                  "`ax.set_xlim` / `ax.set_ylim`",
                  "axis limits"
                ],
                [
                  "`ax.tick_params(axis='x', rotation=45)`",
                  "tick labels"
                ],
                [
                  "`ax.legend(loc='upper left')`",
                  "legend position"
                ]
              ]
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Remember",
              "text": "Pass ==ax=== to put a plot where you want it; otherwise pandas picks the axes for you."
            }
          ]
        }
      ]
    },
    {
      "title": "Plotting Grouped Data",
      "role": "outline",
      "outlineIndex": 3,
      "pages": [
        {
          "title": "Plotting Grouped Data",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Aggregate, then plot",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "Aggregate first: ==one bar per group==",
                "`groupby` keys become the index, so the ==x-axis==",
                "Several metrics give ==grouped== (side-by-side) bars by default",
                "`stacked=True` stacks them instead"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "code",
              "lang": "python",
              "lines": [
                "g = df.groupby('city')",
                "g['sales'].sum().plot.bar()  # one metric",
                "g[['sales','profit']].mean().plot.bar()  # grouped",
                "g[['sales','profit']].mean().plot.bar(stacked=True)  # stacked"
              ]
            },
            {
              "type": "heading",
              "text": "2. Two keys",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "`unstack()` pivots the inner key into columns: ==one series per city==",
                "`pivot_table` is the readable alternative to groupby + unstack"
              ],
              "style": "dot",
              "ink": "blue"
            },
            {
              "type": "code",
              "lang": "python",
              "lines": [
                "df.groupby(['year','city'])['sales'].sum().unstack().plot()",
                "df.pivot_table(index='month', columns='region',",
                "               values='sales', aggfunc='sum').plot()"
              ]
            },
            {
              "type": "heading",
              "text": "3. Overlay or subplots?",
              "ink": "purple"
            },
            {
              "type": "table",
              "headers": [
                "Call",
                "Result"
              ],
              "rows": [
                [
                  "`groupby('city')['sales'].plot(legend=True)`",
                  "{green:one line per group}, shared axes"
                ],
                [
                  "`df.plot.hist(by='city')`",
                  "{orange:one subplot per city}"
                ],
                [
                  "`df.boxplot(by='city')`",
                  "one subplot per numeric column, one box per city"
                ]
              ]
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Check the result",
              "text": "`by=` splits into ==subplots==; only the groupby-then-plot form overlays on one axes."
            }
          ]
        }
      ]
    },
    {
