                "Format follows the extension: `.png` `.svg` `.pdf`",
                "`transparent=True` for a see-through background",
                "`plt.close(fig)` in loops avoids memory leaks"
              ],
              "style": "check"
            },
            {
              "type": "heading",
              "text": "3. Cheat Sheet",
              "ink": "purple"
            },
            {
              "type": "table",
              "headers": [
                "Task",
                "Call"
              ],
              "rows": [
                [
                  "Plot",
                  "`df.plot(kind=, x=, y=, title=, figsize=, ax=, legend=, grid=, color=)`"
                ],
                [
                  "Grid",
                  "`plt.subplots(r, c)`"
                ],
                [
                  "Grouped",
                  "`groupby().agg().plot.bar()`"
                ],
                [
                  "Seaborn",
                  "`sns.<fn>(data=, x=, y=, hue=)`"
                ],
                [
                  "Save",
