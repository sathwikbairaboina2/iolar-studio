              "style": "dot"
            },
            {
              "type": "heading",
              "text": "2. Saving",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "`fig.savefig('out.png', dpi=300, bbox_inches='tight')`",
