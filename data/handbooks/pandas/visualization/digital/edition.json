            },
            {
              "type": "heading",
              "text": "3. Axes-level vs Figure-level",
              "ink": "purple"
            },
            {
              "type": "table",
              "headers": [
                "",
                "Axes-level",
                "Figure-level"
              ],
              "rows": [
                [
                  "Examples",
                  "`scatterplot`, `histplot`",
                  "`relplot`, `catplot`, `displot`, `pairplot`"
                ],
                [
                  "`ax=`",
                  "**takes** it",
                  "makes its own figure"
                ],
                [
                  "Returns",
