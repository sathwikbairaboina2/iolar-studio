              ],
              "rows": [
                [
                  "`histplot`",
                  "distribution; `kde=True` adds curve"
                ],
                [
                  "`boxplot`",
                  "median, quartiles, outliers"
                ],
                [
                  "`barplot`",
                  "==mean== with confidence interval"
                ],
                [
                  "`countplot`",
                  "row ==counts== per category"
                ],
                [
                  "`heatmap`",
                  "`df.corr()`, `annot=True`"
                ],
                [
                  "`pairplot`",
                  "all numeric pairs grid"
