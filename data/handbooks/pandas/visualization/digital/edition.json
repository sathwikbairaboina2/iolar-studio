              ]
            },
            {
              "type": "qa",
              "q": "How do `df.groupby('city')['sales'].plot()` and `df.plot.hist(by='city')` differ?",
              "a_bullets": [
                "The groupby form draws one line per city on one shared axes (overlay)",
                "`by='city'` splits into one subplot per city"
              ]
            },
            {
              "type": "qa",
              "q": "A 1000-row df has 3 cities. `df.plot.bar(x='city', y='sales')` shows what?",
              "a_bullets": [
                "1000 bars, one per row, not one per city",
                "Aggregate first: `df.groupby('city')['sales'].sum().plot.bar()`"
              ]
            }
          ]
        }
