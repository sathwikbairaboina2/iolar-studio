            {
              "type": "bullets",
              "items": [
                "{blue:hue} = color, {purple:style} = marker, {orange:size} = point size",
                "Replaces the manual ==groupby loop== for categorical splits"
              ],
              "style": "check"
            },
            {
              "type": "heading",
              "text": "2. Common Functions",
              "ink": "blue"
            },
            {
              "type": "table",
