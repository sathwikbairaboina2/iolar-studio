          "blocks": [
            {
              "type": "heading",
              "text": "1. Resample",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "`df.resample('ME').sum()` is ==groupby on time bins==",
                "Needs a **DatetimeIndex**, or `on='col'`",
                "Pick the aggregation: `sum`, `mean`, `last`, `ohlc`"
              ],
              "style": "dot",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "Direction",
                "Result",
                "Then"
              ],
              "rows": [
                [
                  "Down (daily to monthly)",
                  "Aggregates",
                  "Choose agg"
                ],
                [
                  "Up (daily to hourly)",
                  "{red:NaN} rows",
                  "`.ffill()` `.bfill()` `.interpolate()`"
                ]
              ]
            },
            {
              "type": "heading",
              "text": "2. Rolling windows",
              "ink": "green"
            },
            {
              "type": "table",
              "headers": [
                "Call",
                "Window"
              ],
              "rows": [
                [
                  "`rolling(7).mean()`",
                  "7 **rows**"
                ],
                [
                  "`rolling('7D')`",
                  "7 calendar days, needs DatetimeIndex"
                ],
                [
                  "`expanding().mean()`",
                  "grows from the start"
                ],
                [
                  "`ewm(span=7).mean()`",
                  "weights recent values more"
                ]
              ]
            },
            {
              "type": "bullets",
              "items": [
                "`min_periods=1`: first window-1 rows are not NaN"
              ],
              "style": "check",
              "ink": "green"
            },
            {
              "type": "heading",
              "text": "3. Lag, lead, change",
              "ink": "purple"
            },
            {
              "type": "code",
              "lang": "python",
              "lines": [
                "s.shift(1)  # lag: values down a row",
                "s.shift(-1)  # lead: next value up",
                "s.shift(freq='D')  # moves index labels",
                "s.pct_change(periods=7)  # vs 7 rows back",
                "s.diff()  # absolute change"
              ]
            },
            {
              "type": "bullets",
              "items": [
                "`s.pct_change()` == `s / s.shift(1) - 1`, first row {red:NaN}"
              ],
              "style": "dot",
              "ink": "purple"
            },
            {
              "type": "sidebox",
              "title": "Interview Point",
              "items": [
                "**Rolling 7 vs '7D'?** Rows vs calendar days.",
                "**shift(1) vs shift(freq='D')?** Values vs labels.",
                "**pct_change vs diff?** Ratio vs absolute change."
              ],
              "ink": "orange"
            }
          ]
        }
      ]
