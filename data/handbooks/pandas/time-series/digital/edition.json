              ],
              "rows": [
                [
                  "`D`",
                  "day"
                ],
                [
                  "`B`",
                  "business day"
                ],
                [
                  "`W`",
                  "week"
                ],
                [
                  "`ME`",
                  "month end"
                ],
                [
                  "`MS`",
                  "month start"
                ],
                [
