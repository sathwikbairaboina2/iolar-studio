    {
      "title": "Time Zones and Common Mistakes",
      "role": "outline",
      "outlineIndex": 4,
      "pages": [
        {
          "title": "Time Zones and Common Mistakes",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Localize vs Convert",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "Call",
                "On",
                "Effect"
              ],
              "rows": [
                [
                  "`tz_localize('Asia/Kolkata')`",
                  "naive",
                  "attaches zone, wall-clock same"
                ],
                [
                  "`tz_convert('UTC')`",
                  "aware",
                  "new zone, same instant"
                ],
                [
                  "`tz_localize(None)`",
                  "aware",
                  "strips the zone"
                ]
              ]
            },
            {
              "type": "bullets",
              "items": [
                "`tz_convert` on naive data raises {red:TypeError}",
                "`tz_localize` on aware data raises too"
              ],
              "style": "cross"
            },
            {
              "type": "code",
              "lang": "python",
              "lines": [
                "ts = pd.to_datetime(df['ts'])",
                "ts = ts.dt.tz_localize('Asia/Kolkata')",
                "ts = ts.dt.tz_convert('UTC')"
              ],
              "note": "localize first, convert after"
            },
            {
              "type": "heading",
              "text": "2. UTC and Daylight Saving",
              "ink": "orange"
            },
            {
              "type": "bullets",
              "items": [
                "==Store and compute in UTC==; local time only for display",
                "DST gap (missing hour): `tz_localize(..., nonexistent='shift_forward')`",
                "DST repeat (ambiguous hour): `tz_localize(..., ambiguous='infer')`"
              ],
              "style": "dot"
            },
            {
              "type": "heading",
              "text": "3. Silent Bugs",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "`shift` or `rolling(n)` on an unsorted index: wrong, silently",
                "`rolling('7D')` on an unsorted index raises; `sort_index()` first",
                "`shift(1)` across gaps moves rows, not days: `asfreq('D')` first",
                "Naive column vs aware Timestamp: `<` `>` raise, `==` gives False",
                "Dates left as `str` strings: parse with `to_datetime`"
              ],
              "style": "cross",
              "ink": "red"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Check first",
              "text": "Look at `df.dtypes` and `df.index.tz` before any time series work."
            }
          ]
        }
      ]
