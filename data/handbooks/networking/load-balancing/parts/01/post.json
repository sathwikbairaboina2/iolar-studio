              "L7 HTTP",
              "non-HTTP traffic"
            ],
            [
              "App cookie `JSESSIONID`",
              "L7 HTTP",
              "app renames cookie"
            ],
            [
              "Source-IP hash",
              "L4",
              "NAT, proxy, mobile"
            ],
            [
              "TLS session ID / SNI",
              "L4 TLS",
              "tickets, TLS 1.3"
            ]
          ],
          "frame": "solid"
        },
        {
          "type": "bullets",
          "items": [
            "LB-inserted: LB owns the cookie, **stateful** map cookie to backend",
            "App-controlled: LB parses app cookie, LB stays **stateless**",
            "Source-IP: carrier NAT puts 10k phones on {red:one backend}",
            "Mobile handoff wifi to LTE = new IP = new backend = lost session"
          ],
          "style": "dot"
