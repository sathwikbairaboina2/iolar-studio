          "ink": "blue"
        },
        {
          "type": "diagram",
          "kind": "chain",
          "spec": {
            "title": "Drain, in order",
            "steps": [
              {
                "text": "fail readiness",
                "note": "return 503 on /readyz",
                "ink": "orange"
              },
              {
                "text": "wait interval × unhealthy",
                "note": "~15s: LB stops sending",
                "ink": "blue"
              },
              {
                "text": "drain in-flight",
                "note": "finish open requests",
                "ink": "blue"
              },
              {
