      "page_title": "What a Load Balancer Actually Is",
      "blocks": [
        {
          "type": "heading",
          "text": "1. Definition",
          "ink": "green"
        },
        {
          "type": "paragraph",
          "text": "A load balancer is a __reverse proxy__ or __packet forwarder__ that spreads incoming work across a pool of backend servers. It presents ==one virtual IP (VIP)== to clients and hides every real server behind it.",
          "frame": "dashed",
          "ink": "green"
        },
        {
          "type": "table",
          "headers": [
            "Term",
            "Means"
          ],
          "rows": [
            [
              "==VIP==",
              "the one IP clients hit"
            ],
            [
              "backend / real server",
              "one server in the pool"
            ],
            [
              "pool",
              "a.k.a. target group, upstream"
            ],
            [
              "listener / frontend",
              "VIP + port + protocol"
            ],
            [
              "**connection** vs **request**",
              "1 conn carries many requests"
            ]
          ],
          "frame": "solid"
        },
        {
          "type": "heading",
          "text": "2. Goals, In Priority Order",
          "ink": "blue"
        },
        {
          "type": "table",
          "headers": [
            "#",
            "Goal",
            "What it buys"
          ],
          "rows": [
            [
              "1",
              "{red:availability}",
              "survive a backend dying"
            ],
            [
              "2",
              "{blue:scalability}",
              "add capacity horizontally"
            ],
            [
              "3",
              "{purple:performance}",
              "cut **tail** latency"
            ],
            [
              "4",
              "{orange:operability}",
              "drain a node, zero downtime"
            ]
          ],
          "frame": "solid"
        },
        {
          "type": "heading",
          "text": "3. Where It Sits, And Who Guards It",
          "ink": "blue"
        },
        {
          "type": "table",
          "headers": [
            "Tier",
            "Layer",
            "Job"
          ],
          "rows": [
            [
              "DNS-level",
              "geo",
              "pick a region"
            ],
            [
              "Edge / global",
              "anycast",
              "reach nearest POP"
            ],
            [
              "Regional",
              "L4",
              "fan out inside a region"
            ],
