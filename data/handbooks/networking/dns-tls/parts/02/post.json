        },
        {
          "type": "bullets",
          "items": [
            "'Propagation' usually means a stale negative cache",
            "Or a wrong record type, or a lame delegation at the parent",
            "ping resolves via the OS cache and proves nothing",
            "It hides which resolver and which authoritative answered",
            "Mixed content: one HTTP img tag breaks the lock on HTTPS"
          ]
        },
        {
          "type": "sidebox",
          "title": "Silent Killer",
          "items": [
            "0-RTT left on for non-idempotent endpoints",
            "Creates a replay vulnerability no test suite catches",
            "Gate early data to GET, or disable it entirely"
          ],
          "ink": "red"
