          "type": "code",
          "lang": "python",
          "lines": [
            "dest = 0x0A010207        # 10.1.2.7",
            "mask = 0xFFFFFF00        # /24",
            "print(hex(dest & mask))  # 0xa010200"
          ],
          "runnable": true
        },
        {
          "type": "heading",
          "text": "3. Longest Prefix Match",
          "ink": "green"
        },
        {
          "type": "bullets",
          "items": [
            "Among all matching entries, most network bits wins",
            "Specificity is decided BEFORE distance or metric",
            "A /32 from a lowly static beats a /24 from OSPF",
            "A /32 host route overrides everything for that address"
          ]
        }
