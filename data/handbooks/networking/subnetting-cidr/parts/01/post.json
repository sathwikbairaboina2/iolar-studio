            "Purpose"
          ],
          "rows": [
            [
              "198.18.0.0/15",
              "Benchmarking"
            ],
            [
              "192.0.0.0/24",
              "IETF protocol assignments"
            ],
            [
              "192.88.99.0/24",
              "6to4 relay anycast"
            ],
            [
              "224.0.0.0/4",
              "Multicast"
