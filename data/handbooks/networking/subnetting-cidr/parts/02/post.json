          "type": "bullets",
          "items": [
            "Destination 10.1.2.7, table has /0, /8, /16, /24",
            "All four entries match the destination",
            "The /24 wins — most network bits, nothing else consulted",
            "Test itself: destination AND entry_mask == entry_network"
          ]
        },
