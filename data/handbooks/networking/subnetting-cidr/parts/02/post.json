          "ink": "red"
        },
        {
          "type": "bullets",
          "items": [
            "Given 192.168.10.37/26, magic number is 64",
            "Network 192.168.10.0, broadcast 192.168.10.63",
            "Usable .1 to .62; next subnet starts at .64",
            "Same drill /20 on 172.16.135.9 -> 172.16.128.0, 4094 hosts"
          ]
        },
