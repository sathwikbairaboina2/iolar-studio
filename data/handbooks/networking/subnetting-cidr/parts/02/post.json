          "lines": [
            "import ipaddress as ip",
            "n = ip.ip_network('192.168.10.0/26')",
            "n.broadcast_address  # .63",
            "list(n.subnets(new_prefix=28))",
            "ip.ip_address('10.1.2.7') in n"
