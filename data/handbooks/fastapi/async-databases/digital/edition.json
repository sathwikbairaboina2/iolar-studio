    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "Two clients call this at once. How long until the second one gets a reply?",
              "a_bullets": [
                "About 2s, not 1s.",
                "`time.sleep` blocks the event loop, so every request waits.",
                "Fix: plain `def` (threadpool) or `await asyncio.sleep(1)`."
              ],
              "example_code": [
                "@app.get('/slow')",
                "async def slow():",
                "    time.sleep(1)",
                "    return 'ok'"
              ]
            },
            {
              "type": "qa",
              "q": "What goes wrong on the last line?",
              "a_bullets": [
                "After commit, loaded attributes are expired.",
                "Touching one on an AsyncSession triggers lazy IO and raises `MissingGreenlet`.",
                "Fix: `expire_on_commit=False` or `await session.refresh(user)`."
              ],
              "example_code": [
                "await session.commit()",
                "print(user.name)"
              ]
            },
            {
              "type": "qa",
              "q": "Why does the background task fail?",
              "a_bullets": [
                "The task runs after the response, when `get_db` has already closed `db`.",
                "Open a new session inside the task."
              ],
              "example_code": [
                "async def post(bg: BackgroundTasks, db: Annotated[AsyncSession, Depends(get_db)]):",
                "    bg.add_task(audit, db)"
              ]
            }
          ]
        }
      ]
    }
