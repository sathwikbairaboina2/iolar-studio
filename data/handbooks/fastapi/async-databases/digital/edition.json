        {
          "title": "FastAPI Async Cheat Sheet",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Blocking code",
              "ink": "red"
            },
            {
              "type": "table",
              "headers": [
                "",
                "async def",
                "def"
              ],
              "rows": [
                [
                  "Runs on",
                  "event loop",
                  "threadpool"
                ],
                [
                  "Blocking call",
                  "{red:stalls ALL requests}",
                  "{green:safe}"
                ]
              ],
              "frame": "dashed"
            },
            {
              "type": "bullets",
              "items": [
                "Blocking lib? Use ==def==",
                "Or `asyncio.to_thread` / `run_in_threadpool` inside `async def`"
              ],
              "style": "check",
              "ink": "red"
            },
            {
              "type": "heading",
              "text": "2. Engine and lifespan",
              "ink": "blue"
            },
            {
              "type": "code",
              "lang": "python",
              "lines": [
                "@asynccontextmanager",
                "async def lifespan(app):",
                "    engine = create_async_engine(URL)",
                "    app.state.SessionLocal = async_sessionmaker(",
                "        engine, expire_on_commit=False)",
                "    yield",
                "    await engine.dispose()"
              ],
              "note": "FastAPI(lifespan=lifespan)"
            },
            {
              "type": "bullets",
              "items": [
                "Engine ==once==, never per request",
                "`selectinload` avoids {red:MissingGreenlet}"
              ],
              "style": "dot",
              "ink": "blue"
            },
            {
              "type": "heading",
              "text": "3. Session and background",
              "ink": "green"
            },
            {
              "type": "code",
              "lang": "python",
              "lines": [
                "async def get_db():",
                "    async with SessionLocal() as s:",
                "        yield s",
                "Db = Annotated[AsyncSession, Depends(get_db)]"
              ]
            },
            {
              "type": "bullets",
              "items": [
                "`add_task(fn, args)`: open its ==own session==",
                "Heavy jobs: queue (Celery, ARQ)"
              ],
              "style": "dot",
              "ink": "green"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Never",
