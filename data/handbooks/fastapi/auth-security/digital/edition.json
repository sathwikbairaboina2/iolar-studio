  "sections": [
    {
      "title": "Security Mental Model",
      "role": "outline",
      "outlineIndex": 0,
      "pages": [
        {
          "title": "Security Mental Model",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Who You Are vs What You May Do",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "",
                "Asks",
                "Failure"
              ],
              "rows": [
                [
                  "Authentication",
                  "==who are you==?",
                  "{red:401} Unauthorized"
                ],
                [
                  "Authorization",
                  "==what may you do==?",
                  "{red:403} Forbidden"
                ]
              ]
            },
            {
              "type": "heading",
              "text": "2. OAuth2 Password Flow",
              "ink": "green"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "POST /token",
                    "sub": "username + password as form data",
                    "ink": "blue"
                  },
                  {
                    "text": "Access token",
                    "sub": "signed JWT returned",
                    "ink": "green"
                  },
                  {
                    "text": "Every request",
                    "sub": "Authorization: Bearer <token>",
                    "ink": "purple"
                  }
                ]
              }
            },
            {
              "type": "bullets",
              "items": [
                "Server stays ==stateless==: the signed JWT carries the identity",
                "{green:No session lookup} per request"
              ],
              "style": "check"
            },
            {
              "type": "heading",
              "text": "3. Security Classes in FastAPI",
              "ink": "purple"
            },
            {
              "type": "bullets",
              "items": [
                "`OAuth2PasswordBearer`, `APIKeyHeader` are declared as ==dependencies==",
                "They also add the {orange:Authorize} button to the `/docs` page"
              ],
              "style": "dot"
            },
            {
              "type": "code",
              "lang": "python",
              "lines": [
                "oauth2_scheme = OAuth2PasswordBearer(tokenUrl=\"token\")",
                "api_key = APIKeyHeader(name=\"X-API-Key\")",
                "",
                "@app.get(\"/me\")",
                "async def me(token: str = Depends(oauth2_scheme)): ..."
              ]
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Password flow = first-party only",
              "text": "Use it only for clients you fully trust. Third-party apps should use ==authorization code flow with PKCE==."
            }
          ]
        }
      ]
    },
    {
      "title": "Password Hashing",
      "role": "outline",
      "outlineIndex": 1,
      "pages": [
        {
          "title": "Password Hashing",
          "blocks": [
            {
              "type": "heading",
              "text": "1. What to Store",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "{red:Never} store ==plaintext== or fast hashes (MD5, SHA-256 alone)",
                "Use a ==slow, salted== algorithm: **bcrypt** or **argon2**",
                "Hashing is ==one-way==: you never decrypt",
                "Login: re-hash the attempt, **verify** against the stored hash",
                "==Salt== is random per password, embedded in the hash string",
                "Same password twice gives two **different** hashes"
              ],
              "style": "check",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "Login attempt",
                    "sub": "plain password",
                    "ink": "blue"
                  },
                  {
                    "text": "Re-hash",
                    "sub": "salt from stored hash",
                    "ink": "purple"
                  },
                  {
                    "text": "Verify",
                    "sub": "constant-time",
                    "ink": "orange"
                  },
                  {
                    "text": "Match?",
                    "sub": "yes: issue token",
                    "ink": "green"
                  }
                ]
              }
            },
            {
              "type": "heading",
              "text": "2. pwdlib Example",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "`PasswordHash.recommended()` gives an ==argon2== hasher",
                "`ph.hash(pw)` at signup; `ph.verify(pw, hash)` at login"
              ],
              "style": "dot"
            },
            {
              "type": "code",
              "lang": "python",
              "lines": [
                "from pwdlib import PasswordHash",
                "",
                "ph = PasswordHash.recommended()",
                "hash = ph.hash(pw)  # store this",
                "ok = ph.verify(pw, hash)  # True / False"
              ],
              "note": "salt and parameters live inside the hash string"
            },
            {
              "type": "heading",
              "text": "3. Mistakes",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "Comparing hashes with `==`: use the library `verify` (==constant-time==)",
                "Different errors for 'user not found' vs 'wrong password' leaks **user enumeration**",
                "Return one generic 401 for both cases"
              ],
              "style": "cross",
              "frame": "dashed",
              "ink": "red"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Remember",
              "text": "Slow + salted + one-way. Verify with the library, answer with one generic error."
            }
          ]
        }
      ]
    },
    {
      "title": "JWT Access Tokens and the Login Endpoint",
      "role": "outline",
      "outlineIndex": 2,
      "pages": [
        {
          "title": "JWT Access Tokens and the Login Endpoint",
          "blocks": [
            {
              "type": "heading",
              "text": "1. What a JWT is",
              "ink": "green"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "Header",
                    "sub": "base64url",
                    "ink": "blue"
                  },
                  {
                    "text": "Payload",
                    "sub": "base64url",
                    "ink": "green"
                  },
                  {
                    "text": "Signature",
                    "sub": "base64url",
                    "ink": "purple"
                  }
                ]
              }
            },
            {
              "type": "bullets",
              "items": [
                "Payload is ==readable by anyone==: signed, **not encrypted**",
                "{blue:sub} user id, {blue:exp} expiry (Unix time), {blue:iat} issued at",
                "Scopes go in a custom `scope` claim"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "heading",
              "text": "2. Create, decode, log in",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "`encode` signs; `decode` checks the signature and `exp`",
                "`/token` takes form data and returns a ==bearer== token"
              ],
              "style": "dot"
            },
            {
              "type": "code",
              "lang": "python",
              "lines": [
                "token = jwt.encode(",
                "    {\"sub\": user, \"exp\": now + timedelta(minutes=30)},",
                "    SECRET_KEY, algorithm=\"HS256\")",
                "data = jwt.decode(token, SECRET_KEY, algorithms=[\"HS256\"])"
              ]
            },
            {
              "type": "code",
              "lang": "python",
              "lines": [
                "@app.post(\"/token\")",
                "def login(form: OAuth2PasswordRequestForm = Depends()):",
                "    user = verify_user(form)",
                "    return {\"access_token\": make_jwt(user),",
                "            \"token_type\": \"bearer\"}"
              ]
            },
            {
              "type": "heading",
              "text": "3. Common mistakes",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "Hardcoded `SECRET_KEY`: use `openssl rand -hex 32`, load from env",
                "No `exp` claim",
                "No `algorithms=` on decode: allows algorithm confusion",
                "Long-lived token with no refresh strategy"
              ],
              "style": "cross",
              "frame": "dashed",
              "ink": "red"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Signed, not secret",
              "text": "Anyone can read the payload; only the ==signature== stops tampering."
            }
          ]
        }
      ]
    },
    {
      "title": "Security Dependencies and Scopes",
      "role": "outline",
      "outlineIndex": 3,
      "pages": [
        {
          "title": "Security Dependencies and Scopes",
          "blocks": [
            {
              "type": "heading",
              "text": "1. The Dependency Chain",
              "ink": "blue"
            },
            {
              "type": "diagram",
              "kind": "chain",
              "spec": {
                "steps": [
                  {
                    "text": "oauth2_scheme",
                    "note": "token or 401",
                    "ink": "blue"
                  },
                  {
                    "text": "get_current_user",
                    "note": "decode, load",
                    "ink": "purple"
                  },
                  {
                    "text": "get_current_active_user",
                    "note": "disabled: 400/403",
                    "ink": "orange"
                  },
                  {
                    "text": "Route",
                    "note": "Depends(...)",
                    "ink": "green"
                  }
                ]
              }
            },
            {
              "type": "bullets",
              "items": [
                "`OAuth2PasswordBearer` reads the ==bearer token== from `Authorization`; {red:401} if missing",
                "Bad token: raise `HTTPException(401)` with `WWW-Authenticate: Bearer`",
                "Routes only declare `Depends(get_current_active_user)`"
              ],
              "style": "dot"
            },
            {
              "type": "code",
              "lang": "python",
              "lines": [
                "oauth2_scheme = OAuth2PasswordBearer(tokenUrl=\"token\")",
                "async def get_current_user(token: str = Depends(oauth2_scheme)):",
                "    user = load_user(decode(token))",
                "    if not user:",
                "        raise HTTPException(401, headers={\"WWW-Authenticate\": \"Bearer\"})",
                "    return user"
              ]
            },
            {
              "type": "heading",
              "text": "2. Scopes",
              "ink": "purple"
            },
            {
              "type": "bullets",
              "items": [
                "Declare scopes on the scheme; guard routes with ==Security==",
                "`SecurityScopes.scopes` = what the route needs; compare to the token's `scope` claim"
              ],
              "style": "dot"
            },
            {
              "type": "code",
              "lang": "python",
              "lines": [
                "oauth2_scheme = OAuth2PasswordBearer(tokenUrl=\"token\", scopes={\"items:read\": \"Read items\"})",
                "async def get_current_user(sec: SecurityScopes, token: str = Depends(oauth2_scheme)):",
                "    granted = decode(token).get(\"scope\", \"\").split()",
                "    if any(s not in granted for s in sec.scopes):",
                "        raise HTTPException(403, \"Not enough permissions\")",
                "@app.get(\"/items\")",
                "async def items(u = Security(get_current_user, scopes=[\"items:read\"])): ..."
              ]
            },
            {
              "type": "heading",
              "text": "3. Mistakes",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "Trusting requested scopes: ==limit them to what the user is allowed==",
                "`Depends` on a scoped route: use `Security`, or `SecurityScopes` stays empty"
              ],
              "style": "cross"
            }
          ]
        }
      ]
    },
    {
      "title": "CORS Middleware and API Keys",
      "role": "outline",
      "outlineIndex": 4,
      "pages": [
        {
          "title": "CORS Middleware and API Keys",
          "blocks": [
            {
              "type": "heading",
              "text": "1. CORS and Setup",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "==CORS== is a **browser** rule: other-origin responses are unreadable unless the server allows it",
                "Origin = `scheme` + `host` + `port`",
                "{red:Not} protection against curl or other servers"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "blue"
            },
            {
              "type": "code",
              "lang": "python",
              "lines": [
                "app.add_middleware(",
                "    CORSMiddleware,",
                "    allow_origins=['https://app.example.com'],",
                "    allow_credentials=True,",
                "    allow_methods=['*'],",
                "    allow_headers=['*'])"
              ]
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "Preflight",
                    "sub": "OPTIONS + Access-Control-Request-*",
                    "ink": "orange"
                  },
                  {
                    "text": "Middleware",
                    "sub": "answers automatically",
                    "ink": "green"
                  },
                  {
                    "text": "Real request",
                    "sub": "JSON, PUT/DELETE, custom headers",
                    "ink": "blue"
                  }
                ]
              }
            },
            {
              "type": "heading",
              "text": "2. Wildcard Trap",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "`allow_origins=['*']` + `allow_credentials=True`: never combine",
                "Starlette ==mirrors== the caller's Origin on preflight and responses",
                "Any site can then make **credentialed** calls",
                "Fix: list explicit origins"
              ],
              "style": "cross",
              "ink": "red"
            },
            {
              "type": "heading",
              "text": "3. API Keys",
              "ink": "purple"
            },
            {
              "type": "bullets",
              "items": [
                "`APIKeyHeader` as a dependency; `auto_error=False` lets you return your own 401",
                "Compare with ==secrets.compare_digest==; store only **hashed** keys"
              ],
              "style": "check",
              "ink": "purple"
            },
            {
              "type": "code",
              "lang": "python",
              "lines": [
                "key_header = APIKeyHeader(name='X-API-Key', auto_error=False)",
                "async def check_key(key=Depends(key_header)):",
                "    h = sha256((key or '').encode()).hexdigest()",
                "    if not any(secrets.compare_digest(h, s) for s in HASHES):",
                "        raise HTTPException(401)"
              ]
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Which credential",
              "text": "==API keys== = server-to-server access. **JWT bearer** tokens = user sessions."
            }
          ]
        }
      ]
    },
    {
      "title": "Security Cheat Sheet",
      "role": "outline",
      "outlineIndex": 5,
      "pages": [
        {
          "title": "Security Cheat Sheet",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Login Flow and Status Codes",
              "ink": "blue"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "POST /token",
                    "sub": "form data",
                    "ink": "blue"
                  },
                  {
                    "text": "Verify hash",
                    "ink": "green"
                  },
                  {
                    "text": "Issue JWT",
                    "ink": "purple"
                  },
                  {
                    "text": "Bearer header",
                    "sub": "Authorization",
                    "ink": "orange"
                  },
                  {
                    "text": "Depends(oauth2_scheme)",
                    "sub": "decode → user",
                    "ink": "blue"
                  }
                ]
              }
            },
            {
              "type": "table",
              "headers": [
                "Code",
                "When",
                "Header"
              ],
              "rows": [
                [
                  "{red:401}",
                  "bad or missing credentials",
                  "`WWW-Authenticate: Bearer`"
                ],
                [
                  "{orange:403}",
                  "authenticated, missing scope",
                  "none"
                ]
              ]
            },
            {
              "type": "heading",
              "text": "2. Hash and JWT",
              "ink": "purple"
            },
            {
              "type": "bullets",
              "items": [
                "Hash with ==argon2== (pwdlib) or ==bcrypt==, never MD5 or SHA alone",
                "Set ==exp== on every token",
                "Pin `algorithms=[...]` on decode",
                "Keep ==SECRET_KEY== in env, not in code"
              ],
              "style": "check"
            },
            {
              "type": "code",
              "lang": "bash",
              "lines": [
                "openssl rand -hex 32"
              ],
              "note": "generate SECRET_KEY"
            },
            {
              "type": "heading",
              "text": "3. Dependencies and CORS",
              "ink": "orange"
            },
            {
              "type": "table",
              "headers": [
                "Need",
                "Use"
              ],
              "rows": [
                [
                  "Token",
                  "`Depends(oauth2_scheme)`"
                ],
                [
                  "Scoped route",
                  "`Security(dep, scopes=[...])`"
                ],
                [
                  "Service key",
                  "`APIKeyHeader`"
                ]
              ]
            },
            {
              "type": "bullets",
              "items": [
                "List ==explicit origins==",
                "No `'*'` with ==credentials==",
                "Add the middleware ==once=="
              ],
              "style": "check"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "CORS is not auth",
              "text": "It is a browser-only rule; curl and servers ignore it."
            }
          ]
        }
      ]
    },
    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "A teammate stores the user's password in the JWT payload because the token is signed. What is wrong?",
              "a_bullets": [
                "Signed is not encrypted: anyone can base64-decode the payload.",
                "Keep only `sub`, `exp` and scopes in it."
              ]
            },
            {
              "type": "qa",
              "q": "The app uses `allow_origins=['*']` with `allow_credentials=True`. What is the risk?",
              "a_bullets": [
                "Starlette mirrors any caller's Origin, so any site can make credentialed calls.",
                "List explicit origins instead."
              ]
            },
            {
              "type": "qa",
              "q": "A route uses `Depends(get_current_user)`, and that dependency checks `SecurityScopes`. A token without `items:read` gets 200. Why?",
              "a_bullets": [
                "`Depends` passes no scopes, so `SecurityScopes.scopes` is empty and the check always passes.",
                "Use `Security(get_current_user, scopes=['items:read'])`."
              ]
            }
          ]
        }
      ]
    }
  ]
}