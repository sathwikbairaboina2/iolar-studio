    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "An `async def` background task calls `time.sleep(5)`. What happens to other requests?",
              "a_bullets": [
                "The event loop is blocked, so ==every request stalls== for 5s.",
                "Fix: make it a plain `def` (threadpool) or `await asyncio.sleep`."
              ]
            },
            {
              "type": "qa",
              "q": "slowapi `5/minute` has no storage_uri and runs on 4 workers. How many requests per minute can one IP make?",
              "a_bullets": [
                "Up to ==20==: each process keeps its own in-memory count.",
                "Fix: point `storage_uri` at Redis to share counts."
              ]
            },
            {
              "type": "qa",
              "q": "A write handler runs `DEL key`, then commits the DB. Why can stale data still be cached?",
              "a_bullets": [
                "A reader can miss between the `DEL` and the commit, read the ==old row== and re-cache it.",
                "Delete the key ==after== the commit."
              ]
            }
          ]
        }
      ]
    }
