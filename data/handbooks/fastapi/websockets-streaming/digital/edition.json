    {
      "title": "WebSocket Endpoint Workflow",
      "role": "outline",
      "outlineIndex": 1,
      "pages": [
        {
          "title": "WebSocket Endpoint Workflow",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Handshake first",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "Declare with `@app.websocket('/ws')`",
                "==await websocket.accept()== before any send or receive",
                "Skipping it breaks the handshake"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "table",
              "headers": [
                "Call order",
                "Result"
              ],
              "rows": [
                [
                  "`accept()`, then send/receive",
                  "{green:OK}"
                ],
                [
                  "send/receive first",
                  "{red:RuntimeError}, Uvicorn answers **500**"
                ],
                [
                  "`close()` before `accept()`",
                  "Handshake rejected, **403**"
                ]
              ],
              "highlightRow": 0
            },
            {
              "type": "heading",
              "text": "2. Receive, send, close",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "Each `receive_*` ==awaits== the next message",
                "Echo loop: accept once, then receive and send forever"
              ],
              "style": "dot"
            },
            {
              "type": "table",
              "headers": [
                "",
                "Receive",
                "Send"
              ],
              "rows": [
                [
                  "Text",
                  "`receive_text()`",
                  "`send_text(s)`"
                ],
                [
                  "Bytes",
                  "`receive_bytes()`",
                  "`send_bytes(b)`"
                ],
                [
                  "JSON",
                  "`receive_json()`",
                  "`send_json(data)`"
                ]
              ]
            },
            {
              "type": "code",
              "lang": "python",
              "lines": [
                "async def echo(websocket):",
                "    await websocket.accept()",
                "    while True:",
                "        data = await websocket.receive_text()",
                "        await websocket.send_text(f\"You said: {data}\")"
              ],
              "note": "fragment: the handler body only"
            },
            {
              "type": "bullets",
              "items": [
                "Server closes with `await websocket.close(code=1000)`",
                "==1008== = policy violation, the usual code for failed auth"
              ],
              "style": "check"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Order",
              "text": "==accept()== first, always. Only then send, receive or close normally."
            }
          ]
        }
      ]
    },
    {
      "title": "Disconnects and Broadcasting",
      "role": "outline",
      "outlineIndex": 2,
      "pages": [
        {
          "title": "Disconnects and Broadcasting",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Disconnects",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "Client leaves: the next receive raises ==WebSocketDisconnect==",
                "Wrap the loop in `try/except WebSocketDisconnect`",
                "{red:Clean up} in `except` or `finally`, or dead sockets pile up and sends fail"
              ],
              "style": "check",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "heading",
              "text": "2. Connection Manager",
              "ink": "blue"
            },
            {
              "type": "code",
              "lang": "python",
              "lines": [
                "from fastapi import WebSocket",
                "class ConnectionManager:",
                "    active: list[WebSocket] = []; disconnect = lambda s, ws: ws in s.active and s.active.remove(ws)",
                "    async def connect(self, ws): await ws.accept(); self.active.append(ws)",
                "    async def broadcast(self, msg):",
                "        for ws in list(self.active):",
                "            try: await ws.send_text(msg)",
                "            except Exception: self.disconnect(ws)"
              ],
              "note": "connect = accept + append; disconnect = remove"
            },
            {
              "type": "code",
              "lang": "python",
              "lines": [
                "from fastapi import FastAPI, WebSocketDisconnect",
                "app, manager = FastAPI(), ConnectionManager()",
                "@app.websocket(\"/ws\")",
                "async def chat(websocket: WebSocket):",
                "    await manager.connect(websocket)",
                "    try:",
                "        while True: await manager.broadcast(await websocket.receive_text())",
                "    except WebSocketDisconnect: manager.disconnect(websocket)"
              ]
            },
            {
              "type": "heading",
              "text": "3. Safe Broadcast",
              "ink": "purple"
            },
            {
              "type": "bullets",
              "items": [
                "Iterate a ==copy==: `list(self.active)`",
                "Removing while iterating ==skips entries==",
                "Drop sockets whose send raises"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "purple"
            },
            {
              "type": "heading",
              "text": "4. Many Workers",
              "ink": "orange"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "One process only",
              "text": "`active` lives in a single process. Several workers or servers need ==Redis pub/sub== (or similar) to broadcast across them."
            }
          ]
        }
      ]
    },
