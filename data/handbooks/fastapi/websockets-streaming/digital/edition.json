              "text": "1. FileResponse",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "`FileResponse(path, filename='report.pdf')` ==streams== a file from disk",
                "Sets `Content-Length`, `Content-Type`, `Content-Disposition`",
                "Supports ==Range== requests",
                "{red:Threat}: `../../etc/passwd` leaks files",
                "{green:Fix}: `resolve()` the path, check it is inside base"
              ],
              "style": "dot",
              "ink": "green"
            },
            {
              "type": "code",
              "lang": "python",
              "lines": [
                "@app.get(\"/files/{name}\")",
                "async def get_file(name: str):",
                "    path = (BASE / name).resolve()",
                "    if not path.is_relative_to(BASE):",
                "        raise HTTPException(404)",
                "    return FileResponse(path, filename=\"report.pdf\")"
              ],
              "note": "BASE is your resolved base directory"
            },
            {
              "type": "heading",
              "text": "2. UploadFile",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
