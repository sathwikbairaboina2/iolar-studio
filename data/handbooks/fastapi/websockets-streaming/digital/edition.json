          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "The endpoint's first line is `data = await websocket.receive_text()`, with no accept. What happens?",
              "a_bullets": [
                "RuntimeError; Uvicorn answers the handshake with a 500.",
                "Fix: `await websocket.accept()` first. close() before accept would give a 403."
              ]
            },
            {
              "type": "qa",
              "q": "Broadcast loops `for ws in self.active:` and calls `self.active.remove(ws)` when a send fails. What is the bug?",
              "a_bullets": [
                "Removing while iterating skips the next socket.",
                "Iterate `list(self.active)` and prune the failures."
              ]
            },
            {
              "type": "qa",
              "q": "An async generator behind an SSE endpoint calls `time.sleep(1)` between events. What breaks?",
              "a_bullets": [
                "It blocks the event loop, so every request freezes.",
                "Use `await asyncio.sleep(1)`."
              ]
            }
          ]
        }
