  "sections": [
    {
      "title": "APIRouter Mental Model",
      "role": "outline",
      "outlineIndex": 0,
      "pages": [
        {
          "title": "APIRouter Mental Model",
          "blocks": [
            {
              "type": "heading",
              "text": "1. What a Router Is",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "==APIRouter== = a mini FastAPI app that holds path operations",
                "It uses `@router.get` / `@router.post` like the app does",
                "It ==cannot run alone==: attach it with `app.include_router(router)`",
                "{green:One router per resource} (users, items, orders), one module each",
                "`main.py` only ==wires== routers together"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "users.py",
                    "sub": "router",
                    "ink": "blue"
                  },
                  {
                    "text": "items.py",
                    "sub": "router",
                    "ink": "blue"
                  },
                  {
                    "text": "main.py",
                    "sub": "include_router",
                    "ink": "green"
                  },
                  {
                    "text": "FastAPI app",
                    "sub": "serves",
                    "ink": "purple"
                  }
                ]
              }
            },
            {
              "type": "heading",
              "text": "2. Constructor Options",
              "ink": "blue"
            },
            {
              "type": "code",
              "lang": "python",
              "lines": [
                "router = APIRouter(",
                "    prefix='/users', tags=['users'],",
                "    dependencies=[Depends(get_current_user)],",
                "    responses={404: {'description': 'Not found'}},",
                ")"
              ],
              "note": "all four options apply to every route in the router"
            },
            {
              "type": "heading",
              "text": "3. Prefix Rules",
              "ink": "purple"
            },
            {
              "type": "bullets",
              "items": [
                "Prefix ==starts with `/`==",
                "Prefix ==never ends with `/`==",
                "Route paths are ==relative to the prefix=="
              ],
              "style": "check",
              "ink": "purple"
            },
            {
              "type": "table",
              "headers": [
                "Prefix",
                "Route path",
                "Final URL"
              ],
              "rows": [
                [
                  "`/users`",
                  "`/{user_id}`",
                  "`/users/{user_id}`"
                ],
                [
                  "`/items`",
                  "`/`",
                  "`/items/`"
                ]
              ]
            },
            {
              "type": "code",
              "lang": "python",
              "lines": [
                "router = APIRouter(prefix='/items', tags=['items'])",
                "",
                "@router.get('/')",
                "async def list_items(): ..."
              ],
              "note": "minimal router"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Remember",
              "text": "A router does nothing until ==include_router== mounts it on the app."
            }
          ]
        }
      ]
    },
    {
      "title": "Prefix, Tags, Dependencies and include_router",
      "role": "outline",
      "outlineIndex": 1,
      "pages": [
        {
          "title": "Prefix, Tags, Dependencies and include_router",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Mounting a Router",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "`app.include_router(router)` registers ==all its routes==; call it **once per router**",
                "Call it in `main.py` or an `api/__init__` aggregator",
                "Extra `prefix`, `tags`, `dependencies`, `responses` are ==added on top== of the router's own",
                "So one router mounts under `/v1` and `/v2` without edits"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "code",
              "lang": "python",
              "lines": [
                "app.include_router(users.router, prefix=\"/v1\")",
                "app.include_router(users.router, prefix=\"/v2\", tags=[\"v2\"])"
              ],
              "note": "same router, two mounts"
            },
            {
              "type": "heading",
              "text": "2. What Stacks",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "Option",
                "Effect"
              ],
              "rows": [
                [
                  "`prefix`",
                  "Concatenated into the final path"
                ],
                [
                  "`tags`",
                  "{blue:Docs grouping only}; router + include + route tags combine"
                ],
                [
                  "`dependencies`",
                  "Run for every route, **before** the route's own"
                ],
                [
                  "`responses`",
                  "Merged into the OpenAPI responses"
                ]
              ]
            },
            {
              "type": "bullets",
              "items": [
                "Router-level `dependencies=[Depends(verify_token)]` return values are ==discarded==",
                "Use them for {green:auth checks} and side effects only"
              ],
              "style": "check"
            },
            {
              "type": "heading",
              "text": "3. Nesting",
              "ink": "purple"
            },
            {
              "type": "diagram",
              "kind": "chain",
              "spec": {
                "steps": [
                  {
                    "text": "child route",
                    "note": "/users",
                    "ink": "green"
                  },
                  {
                    "text": "parent.include_router(child, prefix='/admin')",
                    "note": "/admin/users",
                    "ink": "blue"
                  },
                  {
                    "text": "app.include_router(parent, prefix='/api/v1')",
                    "note": "/api/v1/admin/users",
                    "ink": "purple"
                  }
                ]
              }
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Define routes before including",
              "text": "`include_router` ==copies routes at call time==. Routes added to a router **after** it was included are missing."
            }
          ]
        }
      ]
    },
    {
      "title": "Organizing a Larger App",
      "role": "outline",
      "outlineIndex": 2,
      "pages": [
        {
          "title": "Organizing a Larger App",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Layout and layers",
              "ink": "green"
            },
            {
              "type": "code",
              "lang": "text",
              "lines": [
                "app/main.py",
                "app/api/routers/   users.py items.py",
                "app/schemas/       Pydantic",
                "app/models/        ORM",
                "app/services/      logic",
                "app/core/          config.py security.py",
                "app/db/            session.py base.py",
                "tests/"
              ],
              "note": "one folder per layer"
            },
            {
              "type": "table",
              "headers": [
                "Layer",
                "Does",
                "Never"
              ],
              "rows": [
                [
                  "Router",
                  "parse, `Depends`, call service",
                  "logic, raw SQL"
                ],
                [
                  "Service",
                  "session + schemas in, models out",
                  "HTTP objects"
                ]
              ]
            },
            {
              "type": "heading",
              "text": "2. Data flow",
              "ink": "blue"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "Body",
                    "sub": "UserCreate",
                    "ink": "blue"
                  },
                  {
                    "text": "Router",
                    "sub": "Depends",
                    "ink": "green"
                  },
                  {
                    "text": "Service",
                    "sub": "logic",
                    "ink": "purple"
                  },
                  {
                    "text": "Model",
                    "sub": "ORM to DB",
                    "ink": "orange"
                  },
                  {
                    "text": "UserRead",
                    "sub": "JSON",
                    "ink": "blue"
                  }
                ]
              }
            },
            {
              "type": "bullets",
              "items": [
                "==Schemas== = API contract; ==models== = DB tables",
                "Services are plain functions: testable without HTTP, reusable from CLI or jobs",
                "`from_attributes=True` lets `UserRead` read ORM objects"
              ],
              "style": "dot"
            },
            {
              "type": "code",
              "lang": "python",
              "lines": [
                "class UserRead(BaseModel):",
                "    model_config = ConfigDict(from_attributes=True)",
                "",
                "@router.post(\"/\", response_model=UserRead)",
                "def create(body: UserCreate, db=Depends(get_db)):",
                "    return user_service.create(db, body)"
              ],
              "note": "router stays thin"
            },
            {
              "type": "heading",
              "text": "3. Grouping",
              "ink": "purple"
            },
            {
              "type": "table",
              "headers": [
                "Group by",
                "Layout",
                "Use for"
              ],
              "rows": [
                [
                  "Layer",
                  "`schemas/users.py`",
                  "small apps"
                ],
                [
                  "Feature",
                  "`users/router.py`, `schemas.py`, `service.py`",
                  "large apps"
                ]
              ]
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Never",
              "text": "Return ORM objects without a ==response_model==, or expose **password hashes**."
            }
          ]
        }
      ]
    },
    {
      "title": "Settings Module with pydantic-settings",
      "role": "outline",
      "outlineIndex": 3,
      "pages": [
        {
          "title": "Settings Module with pydantic-settings",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Defining Settings",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "`pip install pydantic-settings`: a ==separate package== in Pydantic v2",
                "`class Settings(BaseSettings)` with **typed** fields",
                "Types are validated and coerced: `\"true\"` becomes `True`",
                "Env vars override `.env`, which overrides field defaults; names are {blue:case-insensitive}"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "code",
              "lang": "python",
              "lines": [
                "from pydantic import SecretStr",
                "from pydantic_settings import BaseSettings, SettingsConfigDict",
                "",
                "class Settings(BaseSettings):",
                "    model_config = SettingsConfigDict(env_file='.env')",
                "    database_url: str",
                "    debug: bool = False",
                "    secret_key: SecretStr"
              ],
              "note": "no default on required fields and secrets"
            },
            {
              "type": "heading",
              "text": "2. One Instance, Injected",
              "ink": "blue"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "Env vars",
                    "sub": "highest",
                    "ink": "red"
                  },
                  {
                    "text": ".env file",
                    "sub": "next",
                    "ink": "orange"
                  },
                  {
                    "text": "Defaults",
                    "sub": "lowest",
                    "ink": "green"
                  },
                  {
                    "text": "Settings()",
                    "sub": "validated",
                    "ink": "blue"
                  }
                ]
              }
            },
            {
              "type": "table",
              "headers": [
                "Style",
                "How",
                "Use when"
              ],
              "rows": [
                [
                  "Module global",
                  "`settings = Settings()` in `app/core/config.py`",
                  "import it everywhere"
                ],
                [
                  "Cached getter",
                  "`@lru_cache def get_settings()`",
                  "read `.env` once, inject it"
                ]
              ],
              "frame": "dashed"
            },
            {
              "type": "code",
              "lang": "python",
              "lines": [
                "@lru_cache",
                "def get_settings() -> Settings:",
                "    return Settings()",
                "",
                "app.dependency_overrides[get_settings] = (",
                "    lambda: Settings(database_url='sqlite://', secret_key='x'))"
              ],
              "note": "routes take Depends(get_settings); tests override it"
            },
            {
              "type": "heading",
              "text": "3. Fail Fast and Secrets",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "Missing required field raises ==ValidationError== at startup: the desired **fail-fast** behaviour",
                "`SecretStr` prints as `**********`; read it with `.get_secret_value()`"
              ],
              "style": "check",
              "ink": "green"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Secrets",
              "text": "Never commit `.env`. Give secrets ==no default==. Do not call `Settings()` in many places: use one instance or `get_settings()`."
            }
          ]
        }
      ]
    },
    {
      "title": "Avoiding Circular Imports and Common Mistakes",
      "role": "outline",
      "outlineIndex": 4,
      "pages": [
        {
          "title": "Avoiding Circular Imports and Common Mistakes",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Why cycles happen",
              "ink": "red"
            },
            {
              "type": "diagram",
              "kind": "flowchart",
              "spec": {
                "rows": [
                  [
                    "u",
                    "i"
                  ]
                ],
                "nodes": {
                  "u": {
                    "text": "users.py",
                    "shape": "box",
                    "ink": "red"
                  },
                  "i": {
                    "text": "items.py",
                    "shape": "box",
                    "ink": "red"
                  }
                },
                "edges": [
                  {
                    "from": "u",
                    "to": "i",
                    "label": "imports"
                  },
                  {
                    "from": "i",
                    "to": "u",
                    "label": "imports"
                  }
                ]
              }
            },
            {
              "type": "bullets",
              "items": [
                "One module sees a ==partially initialized== module",
                "Raises {red:ImportError} or {red:AttributeError}"
              ],
              "style": "dot"
            },
            {
              "type": "heading",
              "text": "2. One-way imports",
              "ink": "blue"
            },
            {
              "type": "diagram",
              "kind": "chain",
              "spec": {
                "title": "Imports flow down only",
                "steps": [
                  {
                    "text": "routers",
                    "ink": "blue"
                  },
                  {
                    "text": "services",
                    "ink": "green"
                  },
                  {
                    "text": "models / schemas",
                    "ink": "purple"
                  },
                  {
                    "text": "core / db",
                    "ink": "orange"
                  }
                ]
              }
            },
            {
              "type": "bullets",
              "items": [
                "Lower layers never import higher ones; ==routers never import each other==",
                "`get_db`, `get_current_user` live in ==app/api/deps.py==; `settings` in `app/core`"
              ],
              "style": "check"
            },
            {
              "type": "table",
              "headers": [
                "Unavoidable cycle",
                "Technique"
              ],
              "rows": [
                [
                  "Runtime use",
                  "Import inside the function"
                ],
                [
                  "Type hints only",
                  "`from __future__ import annotations` + `if TYPE_CHECKING:`"
                ],
                [
                  "ORM link",
                  "String ref: `relationship('Item')`"
                ]
              ]
            },
            {
              "type": "heading",
              "text": "3. Common mistakes",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "`from main import app` in shared modules: build the app only in ==main.py==",
                "Prefix without leading `/`: write `/users`",
                "Route `/` under a prefix: `/items` ==redirects== to `/items/`",
                "==Business logic in routers==: move it to services",
                "`Settings()` in many places: import one `settings`"
              ],
              "style": "cross",
              "ink": "red"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Remember",
              "text": "Fix the layering first; ==TYPE_CHECKING== is a last resort."
            }
          ]
        }
      ]
    },
    {
      "title": "Cheat Sheet: Structuring a FastAPI App",
      "role": "outline",
      "outlineIndex": 5,
      "pages": [
        {
          "title": "Cheat Sheet: Structuring a FastAPI App",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Router and Mount",
              "ink": "blue"
            },
            {
              "type": "code",
              "lang": "python",
              "lines": [
                "router = APIRouter(prefix='/users', tags=['users'],",
                "    dependencies=[Depends(auth)])",
                "app.include_router(users.router, prefix='/api/v1')"
              ],
              "note": "final path: /api/v1/users/..."
            },
            {
              "type": "bullets",
              "items": [
                "Extra ==prefix==, ==tags== and ==dependencies== in `include_router` **stack on top**",
                "Prefixes concatenate; tags combine; router dependencies run first"
              ],
              "style": "dot"
            },
            {
              "type": "heading",
              "text": "2. Layers and Imports",
              "ink": "green"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "Router",
                    "sub": "HTTP",
                    "ink": "blue"
                  },
                  {
                    "text": "Service",
                    "sub": "logic",
                    "ink": "green"
                  },
                  {
                    "text": "Model",
                    "sub": "DB",
                    "ink": "orange"
                  }
                ]
              }
            },
            {
              "type": "bullets",
              "items": [
                "{purple:Schema} = the contract at the boundaries",
                "Imports flow one way: ==routers → services → models → core==",
                "Shared deps live in `deps.py`",
                "`TYPE_CHECKING` imports break type-only cycles"
              ],
              "style": "check"
            },
            {
              "type": "heading",
              "text": "3. Settings",
              "ink": "purple"
            },
            {
              "type": "code",
              "lang": "python",
              "lines": [
                "class Settings(BaseSettings):",
                "    model_config = SettingsConfigDict(env_file='.env')",
                "settings = Settings()  # or @lru_cache get_settings"
              ]
            },
            {
              "type": "bullets",
              "items": [
                "Priority: ==env vars== > ==.env== > field defaults"
              ],
              "style": "dot"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Remember",
              "text": "Build **one** settings object and import it. Never import `app` from main."
            }
          ]
        }
      ]
    },
    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "`app.include_router(router)` runs first, then `@router.get('/ping')` is declared below it. What does `GET /ping` return?",
              "a_bullets": [
                "**404**: `include_router` copies routes at call time.",
                "Define every route before including."
              ]
            },
            {
              "type": "qa",
              "q": "`child = APIRouter(prefix='/items')` has `@child.get('/{id}')`. Then `parent.include_router(child, prefix='/admin')` and `app.include_router(parent, prefix='/api/v1')`. Final path?",
              "a_bullets": [
                "`/api/v1/admin/items/{id}`",
                "Prefixes concatenate, outermost first."
              ]
            },
            {
              "type": "qa",
              "q": "`.env` has `DEBUG=false`, the shell exports `DEBUG=true`, and the field is `debug: bool = False`. What is `settings.debug`?",
              "a_bullets": [
                "**True**: env vars beat `.env`, which beats defaults."
              ]
            }
          ]
        }
      ]
    }
  ]
}