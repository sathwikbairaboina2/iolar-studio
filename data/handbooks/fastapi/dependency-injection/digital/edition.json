      "role": "outline",
      "outlineIndex": 5,
      "pages": [
        {
          "title": "Dependency Cheat Sheet",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Declare and Class",
              "ink": "green"
            },
            {
              "type": "code",
              "lang": "python",
              "lines": [
                "def items(",
                "    db: Annotated[Session, Depends(get_db)],",
                "    p: Annotated[Pagination, Depends()],",
                "):",
                "    return db.query(Item).offset(p.skip)"
              ],
              "note": "function and class dependencies"
            },
            {
              "type": "bullets",
              "items": [
                "Pass ==fn uncalled==: `Depends(get_db)`",
                "`use_cache=False` disables per-request reuse",
                "Class dep: `Depends(Cls)` or bare `Depends()`; read `p.skip`"
              ],
              "style": "check",
              "ink": "green"
            },
            {
              "type": "heading",
              "text": "2. Yield Dependency",
