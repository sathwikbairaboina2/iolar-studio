    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "`get_db` is used by both `user` and `admin`, and the route declares only `admin`. How many times does `get_db` run per request?",
              "a_bullets": [
                "**Once**: the same callable in one tree is cached per request",
                "`use_cache=False` on a declaration forces a second call"
              ]
            },
            {
              "type": "qa",
              "q": "The route needs `b`, and `b` uses `Depends(a)`. Both `a` and `b` use `yield`. In what order do their setup, handler and teardown run?",
              "a_bullets": [
                "a up, b up, handler, b down, a down",
                "Teardown runs in reverse order of setup, after the response"
              ]
            },
            {
              "type": "qa",
              "q": "A test sets `app.dependency_overrides['get_db'] = fake`, yet the real database is still hit. Why?",
              "a_bullets": [
                "The key must be the function object `get_db`, not a string",
                "The string never matches, so the override is silently ignored"
              ]
            }
          ]
        }
