    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "You add a new model and run `alembic revision --autogenerate`. The script has an empty `upgrade()`. Name two causes.",
              "a_bullets": [
                "The model's module was never imported, so `Base.metadata` lacks the table.",
                "`target_metadata` points at the wrong or an empty `MetaData`."
              ]
            },
            {
              "type": "qa",
              "q": "You rename column `name` to `full_name` and autogenerate. What does the script do?",
              "a_bullets": [
                "It drops `name` and adds `full_name`, so the data is lost.",
                "Edit it to use `op.alter_column(..., new_column_name=...)`."
              ]
            },
            {
              "type": "qa",
              "q": "Four app replicas each run `alembic upgrade head` on startup. What is the bug?",
              "a_bullets": [
                "Replicas can run the same migration concurrently and race.",
                "Run it once as a release step before the new version starts."
              ]
            }
          ]
        }
      ]
    }
