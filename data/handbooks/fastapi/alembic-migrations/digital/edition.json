          "title": "env.py and target_metadata",
          "blocks": [
            {
              "type": "heading",
              "text": "1. What env.py Does",
              "ink": "green"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "alembic cmd",
                    "sub": "every command",
                    "ink": "green"
                  },
                  {
                    "text": "env.py",
                    "sub": "builds engine",
                    "ink": "blue"
                  },
                  {
                    "text": "configure()",
                    "sub": "context",
                    "ink": "purple"
                  },
                  {
                    "text": "run_migrations()",
                    "sub": "apply",
                    "ink": "orange"
                  }
                ]
              }
            },
            {
              "type": "heading",
              "text": "2. target_metadata",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "`target_metadata = Base.metadata` is what autogenerate diffs against the live DB",
                "{red:None}: autogenerate aborts with an error, no MetaData object",
                "==Import models== before reading `Base.metadata`, else tables are missing: empty migration"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "blue"
            },
            {
              "type": "code",
              "lang": "python",
              "lines": [
                "import myapp.models  # registers tables",
                "from myapp.db import Base",
                "target_metadata = Base.metadata"
              ],
              "note": "imports first, then read the metadata"
            },
            {
