                "alembic init -t async alembic",
                "alembic revision --autogenerate -m \"add user email\""
              ]
            },
            {
              "type": "bullets",
              "items": [
                "Set `sqlalchemy.url`, then ==target_metadata = Base.metadata==",
                "{red:None} metadata: autogenerate errors; missing model imports: empty migration",
                "==Review== the generated script before applying"
              ],
              "style": "check"
            },
            {
              "type": "heading",
              "text": "2. Apply and Inspect",
              "ink": "green"
            },
