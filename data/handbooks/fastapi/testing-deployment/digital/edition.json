    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "Your app fills `app.state.cache` in a startup lifespan. A test does `client = TestClient(app)` then `client.get('/items')` and fails with an AttributeError on the cache. Why?",
              "a_bullets": [
                "A bare `TestClient(app)` skips lifespan events, so startup never ran.",
                "Use `with TestClient(app) as client:`."
              ]
            },
            {
              "type": "qa",
              "q": "One test sets `app.dependency_overrides[get_db] = fake_get_db` and never clears it. What happens to later tests?",
              "a_bullets": [
                "The override lives on the shared `app`, so later tests still get the fake DB.",
                "Clear it in fixture teardown: `app.dependency_overrides.clear()`."
              ]
            },
            {
              "type": "qa",
              "q": "A container runs `CMD [\"uvicorn\",\"app.main:app\"]` and the logs look healthy, but the published port refuses connections. Why?",
              "a_bullets": [
                "Uvicorn binds `127.0.0.1` by default, which is unreachable from outside the container.",
                "Add `--host 0.0.0.0`."
              ]
            }
          ]
        }
      ]
    }
