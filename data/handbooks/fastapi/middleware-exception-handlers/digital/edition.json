    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "You call `add_middleware(A)` and then `add_middleware(B)`. Each prints its name before and after `call_next`. What prints for one request?",
              "a_bullets": [
                "`B in, A in, endpoint, A out, B out`",
                "The last one added is outermost, so it sees the request first."
              ]
            },
            {
              "type": "qa",
              "q": "A middleware does `raise HTTPException(401)` for a missing token. The client gets a 500. Why, and what is the fix?",
              "a_bullets": [
                "Exceptions raised in middleware bypass the exception handlers.",
                "Return `JSONResponse(status_code=401, ...)` directly."
              ]
            },
            {
              "type": "qa",
              "q": "With `allowed_hosts=['*.example.com']`, a request arrives with `Host: example.com`. What is the result?",
              "a_bullets": [
                "400 `Invalid host header`: the wildcard does not match the bare domain.",
                "List both `example.com` and `*.example.com`."
              ]
            }
          ]
