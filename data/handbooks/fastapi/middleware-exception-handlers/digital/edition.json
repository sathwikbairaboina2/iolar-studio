          "title": "Consistent Errors and Cheat Sheet",
          "blocks": [
            {
              "type": "heading",
              "text": "1. One Envelope, Three Handlers",
              "ink": "green"
            },
            {
              "type": "code",
              "lang": "python",
              "lines": [
                "def error(status, code, message, details=()):",
                "    body = {\"error\": {\"code\": code, \"message\": message,",
                "        \"details\": jsonable_encoder(details), \"request_id\": request_id.get()}}",
                "    return JSONResponse(body, status_code=status)"
              ],
              "note": "one helper, used by every handler"
            },
            {
              "type": "table",
              "headers": [
                "Handler",
                "Covers",
                "Returns"
              ],
              "rows": [
                [
                  "`StarletteHTTPException`",
                  "HTTP errors, unknown routes",
                  "`exc.status_code`"
                ],
                [
                  "`RequestValidationError`",
                  "bad body, query, path",
                  "422, `exc.errors()`"
                ],
                [
                  "`Exception`",
                  "everything else",
                  "500, generic"
                ]
              ]
            },
            {
              "type": "bullets",
              "items": [
                "Catch-all: ==log the traceback==, return a generic message",
                "{red:Never} leak internals to the client"
