    {
      "title": "Uvicorn Logging and Request IDs",
      "role": "outline",
      "outlineIndex": 1,
      "pages": [
        {
          "title": "Uvicorn Logging and Request IDs",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Loggers and Config",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "Logger",
                "Carries"
              ],
              "rows": [
                [
                  "`uvicorn`",
                  "the server"
                ],
                [
                  "`uvicorn.error`",
                  "==lifecycle and errors== (despite the name)"
                ],
                [
                  "`uvicorn.access`",
                  "one line per request"
                ]
              ]
            },
            {
              "type": "bullets",
              "items": [
                "`--log-config logging.yaml` or `dictConfig`",
                "`disable_existing_loggers: False`, or {red:app loggers go silent}",
                "`--log-level` debug | info | warning | error",
                "`--no-access-log` cuts noise; access log is ==on by default==",
                "Format as ==JSON== (`python-json-logger`, `structlog`) for aggregators"
              ],
              "style": "dot",
              "ink": "blue"
            },
            {
              "type": "heading",
              "text": "2. Request ID",
              "ink": "green"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "Header or uuid4",
                    "sub": "X-Request-ID",
                    "ink": "blue"
                  },
                  {
                    "text": "ContextVar",
                    "sub": "set per request",
                    "ink": "green"
                  },
                  {
                    "text": "Filter",
                    "sub": "adds request_id",
                    "ink": "purple"
                  },
                  {
                    "text": "Response header",
                    "sub": "echoed back",
                    "ink": "orange"
                  }
                ]
              }
            },
            {
              "type": "code",
              "lang": "python",
              "lines": [
                "import uuid, contextvars",
                "rid = contextvars.ContextVar(\"rid\", default=\"-\")",
                "@app.middleware(\"http\")",
                "async def add_id(request, call_next):",
                "    rid.set(request.headers.get(\"X-Request-ID\") or str(uuid.uuid4()))",
                "    response = await call_next(request)",
                "    response.headers[\"X-Request-ID\"] = rid.get()",
                "    return response"
              ]
            },
            {
              "type": "code",
              "lang": "python",
              "lines": [
                "import logging",
                "class RequestIdFilter(logging.Filter):",
                "    def filter(self, record):",
                "        record.request_id = rid.get()",
                "        return True"
              ],
              "note": "attach under filters: in logging.yaml"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "ContextVar, not a global",
              "text": "A plain global leaks IDs between ==concurrent requests==."
            }
          ]
        }
      ]
    },
