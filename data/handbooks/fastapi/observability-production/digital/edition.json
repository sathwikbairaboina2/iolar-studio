              }
            },
            {
              "type": "heading",
              "text": "3. Cardinality and Timeouts",
              "ink": "purple"
            },
            {
              "type": "table",
              "headers": [
                "Mistake",
                "Fix"
              ],
              "rows": [
                [
                  "Labels: user ID, raw URL",
                  "**Route template** only"
                ],
                [
                  "Unbounded span attributes",
                  "Bounded, short values"
                ],
                [
                  "No outbound timeout",
                  "`httpx.Timeout`, `asyncio.timeout()`"
