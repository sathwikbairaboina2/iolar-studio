    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "Your `/healthz` liveness probe runs `SELECT 1` on the DB. The DB goes down for 2 minutes. What happens to the pods?",
              "a_bullets": [
                "Probes fail on every pod, so Kubernetes restarts all of them.",
                "Restarts don't fix the DB. Use `/readyz` for dependency checks."
              ]
            },
            {
              "type": "qa",
              "q": "A middleware stores the request ID in a module-level variable. Requests A and B overlap. What can A's later log lines show?",
              "a_bullets": [
                "B's ID. B overwrote the shared global while A was awaiting.",
                "Fix: use a `ContextVar`, which is isolated per request."
              ]
            },
            {
              "type": "qa",
              "q": "A Prometheus counter is labeled with the raw path `/users/8841`. What goes wrong, and what is the fix?",
              "a_bullets": [
                "Each user ID creates a new time series, so memory and cost blow up.",
                "Label by the route template `/users/{id}`."
              ]
            }
          ]
        }
      ]
