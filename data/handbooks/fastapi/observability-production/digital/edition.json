          "title": "Production Observability Mental Model",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Three signals, one ID",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "Signal",
                "Answers",
                "Shape"
              ],
              "rows": [
                [
                  "{blue:Logs}",
                  "What happened?",
                  "discrete events"
                ],
                [
                  "{green:Metrics}",
                  "How much, how often?",
                  "aggregated numbers over time"
                ],
                [
                  "{purple:Traces}",
                  "Where did the time go?",
                  "one request across services"
                ]
              ]
            },
            {
              "type": "bullets",
              "items": [
                "==Request ID== is the glue",
                "One ID on every log line and span",
                "Follow one request across all signals"
              ],
              "style": "check"
            },
            {
              "type": "code",
              "lang": "python",
              "lines": [
                "import logging, uuid",
                "from fastapi import FastAPI",
                "app = FastAPI(); log = logging.getLogger(\"app\")",
                "@app.middleware(\"http\")",
                "async def stamp(request, call_next):",
                "    rid = request.headers.get(\"x-request-id\") or str(uuid.uuid4())",
                "    log.info(\"request_id=%s\", rid)",
                "    return await call_next(request)"
              ]
            },
            {
              "type": "heading",
              "text": "2. Probes and lifecycle",
              "ink": "green"
            },
