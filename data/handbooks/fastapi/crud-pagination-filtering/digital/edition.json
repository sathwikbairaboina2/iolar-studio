    {
      "title": "Pagination: Limit/Offset vs Cursor",
      "role": "outline",
      "outlineIndex": 3,
      "pages": [
        {
          "title": "Pagination: Limit/Offset vs Cursor",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Limit/Offset",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "`?limit=20&offset=40` maps to `LIMIT 20 OFFSET 40`",
                "==Simple==, and you can jump to any page"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "DB scans and discards skipped rows: {red:slow on deep pages}",
                "Inserts or deletes between requests: ==duplicate or missing rows=="
              ],
              "style": "cross"
            },
            {
              "type": "heading",
              "text": "2. Cursor (Keyset)",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "",
                "Offset",
                "Cursor"
              ],
              "rows": [
                [
                  "Param",
                  "`offset=40`",
                  "`cursor=<last_id>`"
                ],
                [
                  "SQL",
                  "`OFFSET 40`",
                  "`WHERE id > :cursor`"
                ],
                [
                  "Deep page",
                  "slow",
                  "{green:constant cost}"
                ],
                [
                  "Inserts",
                  "dupes or gaps",
                  "{green:stable}"
                ],
                [
                  "Jump to page",
                  "yes",
                  "no"
                ]
              ]
            },
            {
              "type": "code",
              "lang": "python",
              "lines": [
                "rows = db.scalars(select(Item)",
                "    .where(Item.id > cursor)",
                "    .order_by(Item.id)",
                "    .limit(limit + 1)).all()",
                "page = rows[:limit]",
                "nxt = page[-1].id if len(rows) > limit else None"
              ],
              "note": "fetch limit+1 to detect a next page"
            },
            {
              "type": "bullets",
              "items": [
                "Response: ==items== plus ==next_cursor==",
                "`next_cursor` is `null` on the last page"
              ],
              "style": "check"
            },
            {
              "type": "heading",
              "text": "3. Rules",
              "ink": "orange"
            },
            {
              "type": "sidebox",
              "title": "Every paginated route",
              "items": [
                "Cap size: `Query(20, ge=1, le=100)`",
                "Deterministic `ORDER BY`",
                "Unique tiebreaker such as `id`"
              ],
              "ink": "orange"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Which one?",
              "text": "**Offset** for small admin tables and page jumps. **Cursor** for feeds and large or changing data."
            }
          ]
        }
      ]
    },
    {
      "title": "Filtering, Sorting and 404 Handling",
      "role": "outline",
      "outlineIndex": 4,
      "pages": [
        {
          "title": "Filtering, Sorting and 404 Handling",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Filters and Sorting",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "Filter = ==optional query param==: `status: str | None = None`",
                "Add `.where(...)` only when the value is ==not None==",
                "`?sort=-created_at`: leading `-` means ==descending=="
              ],
              "style": "dot"
            },
            {
              "type": "code",
              "lang": "python",
              "lines": [
                "SORTS = {\"created_at\": Item.created_at}",
                "if status is not None:",
                "    q = q.where(Item.status == status)",
                "if sort.lstrip(\"-\") not in SORTS: raise HTTPException(422)",
                "col = SORTS[sort.lstrip(\"-\")]",
                "q = q.order_by(col.desc() if sort[0] == \"-\" else col)"
              ],
              "note": "dict whitelist maps input to a column"
            },
            {
              "type": "heading",
              "text": "2. Validate Values",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "==Whitelist== sort columns (dict or `Literal`)",
                "{red:Never} pass raw input into `order_by`",
                "`Literal` or `Enum` params: bad value gives ==422== automatically"
              ],
              "style": "check"
            },
            {
              "type": "heading",
              "text": "3. 404 Handling",
              "ink": "purple"
            },
            {
              "type": "code",
              "lang": "python",
              "lines": [
                "obj = db.get(Item, id)",
                "if obj is None:",
                "    raise HTTPException(status_code=404,",
                "        detail=\"Item not found\")"
              ],
              "note": "repeat in read, update and delete"
            },
            {
              "type": "table",
              "headers": [
                "Case",
                "Status"
              ],
              "rows": [
                [
                  "Resource not found",
                  "{red:404}"
                ],
                [
                  "Invalid input",
                  "{red:422}"
                ],
                [
                  "Filter matches nothing",
                  "{green:200} with `[]`"
                ]
              ]
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Empty is not missing",
              "text": "An empty filtered list is ==200 with []==, never 404."
            }
          ]
        }
      ]
    },
