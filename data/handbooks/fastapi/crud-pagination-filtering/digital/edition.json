    {
      "title": "Update: PUT vs PATCH and exclude_unset",
      "role": "outline",
      "outlineIndex": 2,
      "pages": [
        {
          "title": "Update: PUT vs PATCH and exclude_unset",
          "blocks": [
            {
              "type": "heading",
              "text": "1. PUT vs PATCH",
              "ink": "green"
            },
            {
              "type": "table",
              "headers": [
                "",
                "PUT",
                "PATCH"
              ],
              "rows": [
                [
                  "Replaces",
                  "**whole** resource",
                  "only fields **sent**"
                ],
                [
                  "Required fields",
                  "all of them",
                  "none"
                ],
                [
                  "Omitted field",
                  "validation error",
                  "left untouched"
                ]
              ],
              "highlightRow": 1
            },
            {
              "type": "heading",
              "text": "2. PATCH recipe",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "`ItemUpdate`: every field ==Optional== with default `None`",
                "`payload.model_dump(exclude_unset=True)` keeps only fields the client ==actually sent==",
                "Apply with `setattr` per key, then ==commit== and ==refresh=="
              ],
              "style": "check",
              "frame": "dashed",
              "ink": "blue"
            },
            {
              "type": "code",
              "lang": "python",
              "lines": [
                "class ItemUpdate(BaseModel):",
                "    name: str | None = None",
                "    price: float | None = None",
                "data = payload.model_dump(exclude_unset=True)",
                "for k, v in data.items():",
                "    setattr(obj, k, v)",
                "db.commit()",
                "db.refresh(obj)"
              ],
              "note": "ItemUpdate schema, then the body of the PATCH endpoint"
            },
            {
              "type": "heading",
              "text": "3. exclude_unset vs exclude_none",
              "ink": "purple"
            },
            {
              "type": "table",
              "headers": [
                "",
                "exclude_unset",
                "exclude_none"
              ],
              "rows": [
                [
                  "Keeps",
                  "only sent fields",
                  "only non-None fields"
                ],
                [
                  "Sent `null`",
                  "{green:kept}: clears the field",
                  "{red:dropped}: ignored"
                ],
                [
                  "Fits PATCH",
                  "{green:yes}",
                  "no: cannot clear a field"
                ]
              ]
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Plain model_dump() wipes data",
              "text": "On a PATCH body it writes `None` over every ==omitted== field. Always pass `exclude_unset=True`."
            }
          ]
        }
      ]
