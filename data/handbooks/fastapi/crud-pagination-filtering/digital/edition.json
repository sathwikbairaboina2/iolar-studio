    {
      "title": "Create, Read and Response Models",
      "role": "outline",
      "outlineIndex": 1,
      "pages": [
        {
          "title": "Create, Read and Response Models",
          "blocks": [
            {
              "type": "heading",
              "text": "1. POST and response_model",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "`@router.post('/items', response_model=ItemRead, status_code=201)`",
                "Returns the created object with its ==generated id==",
                "==response_model== filters the output",
                "Example: `password_hash` is never returned"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "code",
              "lang": "python",
              "lines": [
                "@router.post(\"/items\", response_model=ItemRead, status_code=201)",
                "def create_item(payload: ItemCreate, db: Session = Depends(get_db)):",
                "    obj = Item(**payload.model_dump())",
                "    db.add(obj)",
                "    db.commit()",
                "    db.refresh(obj)",
                "    return obj"
              ],
              "note": "refresh loads the generated id"
            },
            {
              "type": "heading",
              "text": "2. Schemas and ORM Objects",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "Type",
                "Role",
                "Holds"
              ],
              "rows": [
                [
                  "`ItemCreate`",
                  "input",
                  "client fields, no id"
                ],
                [
                  "`Item` (DB)",
                  "storage",
                  "all columns, `password_hash`"
                ],
                [
                  "`ItemRead`",
                  "output",
                  "id + server-set fields"
                ]
              ]
            },
            {
              "type": "bullets",
              "items": [
                "`ItemRead` sets `model_config = ConfigDict(from_attributes=True)` (Pydantic v2)",
                "Needed for `ItemRead.model_validate(orm_obj)` in services and tests",
                "A route with `response_model=ItemRead` serializes ORM objects anyway"
              ],
              "style": "check"
            },
            {
              "type": "heading",
              "text": "3. Reading",
              "ink": "purple"
            },
            {
              "type": "table",
              "headers": [
                "Route",
                "Returns"
              ],
              "rows": [
                [
                  "`GET /items/{id}`",
                  "fetch by id, return the object"
                ],
                [
                  "`GET /items`",
                  "`list[ItemRead]` with pagination params"
                ]
              ]
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Separate shapes",
              "text": "Input and output differ: ==ItemCreate== in, ==ItemRead== out. Never reuse the DB model or the create schema as the response."
            }
          ]
        }
      ]
