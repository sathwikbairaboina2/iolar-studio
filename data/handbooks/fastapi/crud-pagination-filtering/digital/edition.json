          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "PATCH /items/1 sends {\"price\": 5}. The handler runs `data = payload.model_dump()` and then `setattr` for each pair. What happens to `name`?",
              "a_bullets": [
                "`name` is overwritten with `None`, so the stored value is wiped.",
                "Plain `model_dump()` includes unset fields as `None`. Use `model_dump(exclude_unset=True)`."
              ]
            },
            {
              "type": "qa",
              "q": "A client loads `?limit=20&offset=0`. Another client inserts a row that sorts first. The first client then requests `offset=20`. What goes wrong?",
              "a_bullets": [
                "Every row shifts down one place, so the last row of page 1 appears again as a duplicate.",
                "Cursor paging with `WHERE id > last_id` is stable under inserts."
              ]
            },
            {
              "type": "qa",
              "q": "GET /items/99 matches nothing, and GET /items?status=archived matches no rows. Which status codes come back?",
              "a_bullets": [
                "/items/99 returns 404, raised as an HTTPException.",
                "The empty filter returns 200 with `[]`, because the collection exists."
              ]
            }
          ]
        }
