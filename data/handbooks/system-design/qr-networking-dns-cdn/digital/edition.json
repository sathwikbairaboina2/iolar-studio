    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "You change an A record with TTL 86400 and expect users to switch within a minute. What goes wrong?",
              "a_bullets": [
                "Caches may keep the old IP for up to 24 hours.",
                "Lower the TTL a full old-TTL ahead of the move, then change the record."
              ]
            },
            {
              "type": "qa",
              "q": "One packet is lost on a page loading 10 resources. Which stalls: HTTP/2 or HTTP/3?",
              "a_bullets": [
                "HTTP/2: all ten streams wait, because TCP holds every later byte.",
                "HTTP/3: only the stream that lost the packet waits."
              ]
            },
            {
              "type": "qa",
              "q": "You cache app.js and index.html for a year, then deploy. Users still see the old page. Fix?",
              "a_bullets": [
                "Purging is slow and costs money.",
                "Version filenames (app.3f9a.js) with a long TTL, and give index.html a short TTL."
              ]
            }
          ]
        }
      ]
    }
