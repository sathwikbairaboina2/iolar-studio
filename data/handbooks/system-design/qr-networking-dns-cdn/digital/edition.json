              ],
              "highlightRow": 1
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "Client",
                    "ink": "black"
                  },
                  {
                    "text": "Forward proxy",
                    "sub": "server sees its IP",
                    "ink": "blue"
                  },
                  {
                    "text": "Reverse proxy",
