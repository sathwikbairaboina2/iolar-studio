                    "ink": "green"
                  },
                  {
                    "text": "Servers",
                    "ink": "black"
                  }
                ]
              }
            },
            {
              "type": "heading",
              "text": "2. Minimal nginx",
              "ink": "green"
            },
            {
              "type": "code",
              "lang": "nginx",
              "lines": [
                "location /api/ {",
                "  proxy_pass http://backend;",
                "  proxy_set_header Host $host;",
                "  proxy_set_header X-Forwarded-For $remote_addr;",
                "}"
              ],
              "note": "Host and X-Forwarded-For are the two headers to set"
            },
            {
              "type": "bullets",
              "items": [
                "No `Host` set: upstream name goes out as Host → ==wrong vhost== or 404/400",
                "Upstream unreachable or failing → {red:502}",
                "Proxy timeout too short → {orange:504}"
              ],
              "style": "cross",
              "ink": "red"
            },
            {
              "type": "heading",
              "text": "3. Real Client IP",
              "ink": "purple"
            },
            {
              "type": "bullets",
              "items": [
                "Behind a reverse proxy the app sees the ==proxy's IP==",
                "Real client: `X-Forwarded-For`; scheme: `X-Forwarded-Proto`"
              ],
              "style": "dot"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Trust boundary",
              "text": "Anyone can forge `X-Forwarded-For`. Trust it ==only from your own proxy==."
            }
          ]
        }
      ]
