      "title": "Forward vs Reverse Proxies",
      "role": "outline",
      "outlineIndex": 3,
      "pages": [
        {
          "title": "Forward vs Reverse Proxies",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Which Side It Hides",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "",
                "Forward proxy",
                "Reverse proxy"
              ],
              "rows": [
                [
                  "Sits in front of",
                  "Clients",
                  "Servers"
                ],
                [
                  "Hides",
                  "{blue:The client} from the server",
                  "{green:The servers} from the client"
