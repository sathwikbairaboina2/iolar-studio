      "pages": [
        {
          "title": "Storage Types: Block, File, Object",
          "blocks": [
            {
              "type": "heading",
              "text": "1. The Three Types",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "",
                "Block (EBS)",
                "File (EFS)",
                "Object (S3)"
              ],
              "rows": [
                [
                  "Unit",
                  "raw ==fixed-size blocks==",
                  "==directories== + POSIX locking",
                  "==key== + blob + metadata"
                ],
                [
                  "Access",
                  "one server, as a disk",
                  "NFS / SMB, shared",
                  "HTTP, flat namespace"
                ],
                [
                  "Trait",
                  "**lowest latency**",
                  "shared tree",
                  "billions of objects, cheap, **high latency**"
                ],
                [
                  "Use",
                  "databases, boot volumes",
                  "home dirs, legacy apps",
                  "media, backups, logs"
                ]
              ],
              "highlightRow": 2
            },
            {
              "type": "heading",
              "text": "2. Objects Are Immutable",
              "ink": "orange"
            },
            {
              "type": "bullets",
              "items": [
                "Replaced ==whole==, never edited in place",
                "Change one byte = **re-upload** the object",
                "No append, no rename"
              ],
              "style": "cross",
              "ink": "orange"
            },
            {
              "type": "code",
              "lang": "bash",
              "lines": [
                "aws s3 cp s3://b/old s3://b/new",
                "aws s3 rm s3://b/old"
              ],
              "note": "rename = copy + delete"
            },
            {
              "type": "heading",
              "text": "3. Pick by Access Pattern",
              "ink": "green"
            },
            {
              "type": "diagram",
              "kind": "flowchart",
              "spec": {
                "rows": [
                  [
                    "q1"
                  ],
                  [
                    "a",
                    "q2"
                  ],
                  [
                    "b",
                    "c"
                  ]
                ],
                "nodes": {
                  "q1": {
                    "text": "Random small writes?",
                    "shape": "diamond"
                  },
                  "a": {
                    "text": "Block",
                    "shape": "box",
                    "ink": "blue"
                  },
                  "q2": {
                    "text": "Shared mutable files?",
                    "shape": "diamond"
                  },
                  "b": {
                    "text": "File",
                    "shape": "box",
                    "ink": "green"
                  },
                  "c": {
                    "text": "Object (write-once)",
                    "shape": "box",
                    "ink": "orange"
                  }
                },
                "edges": [
                  {
                    "from": "q1",
                    "to": "a",
                    "label": "yes"
                  },
                  {
                    "from": "q1",
                    "to": "q2",
                    "label": "no"
                  },
                  {
                    "from": "q2",
                    "to": "b",
                    "label": "yes"
                  },
                  {
                    "from": "q2",
                    "to": "c",
                    "label": "no"
                  }
                ]
              }
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Remember",
              "text": "Block = ==disk==, file = ==shared tree==, object = ==HTTP blobs==. Do not use S3 as a disk."
            }
          ]
        }
      ]
    },
    {
      "title": "S3 Core: Buckets, Keys, Consistency",
      "role": "outline",
      "outlineIndex": 1,
      "pages": [
        {
          "title": "S3 Core: Buckets, Keys, Consistency",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Buckets and Keys",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "Bucket names are ==globally unique==",
                "Object = **bucket + key**, such as `photos/2026/a.jpg`",
                "Folders are only a ==key-prefix== convention",
                "List with prefix + delimiter `/` to fake directories"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "heading",
              "text": "2. Limits and Consistency",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "Fact",
                "Value"
              ],
              "rows": [
                [
                  "Single object max",
                  "==50 TB== (5 TB before Dec 2025)"
                ],
                [
                  "One PUT max",
                  "==5 GB==, larger needs multipart"
                ],
                [
                  "PUT, overwrite, DELETE",
                  "{green:strong} read-after-write"
                ],
                [
                  "LIST after write",
                  "{green:strong} list-after-write"
                ]
              ],
              "frame": "dashed"
            },
            {
              "type": "heading",
              "text": "3. Everyday CLI",
              "ink": "purple"
            },
            {
              "type": "bullets",
              "items": [
                "`cp` one file, `sync` a directory, `ls` a prefix, `rm --recursive` a prefix"
              ],
              "style": "dot"
            },
            {
              "type": "code",
              "lang": "bash",
              "lines": [
                "aws s3 cp file s3://b/key",
                "aws s3 sync dir s3://b/prefix",
                "aws s3 ls s3://b/prefix/",
                "aws s3 rm s3://b/key --recursive"
              ]
            },
            {
              "type": "heading",
              "text": "4. Common Mistakes",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "Public bucket: keep ==Block Public Access== on",
                "Fearing sequential key names: each prefix scales to 3500 PUT / 5500 GET per second",
                "No versioning: overwrites are lost"
              ],
              "style": "cross",
              "frame": "dashed",
              "ink": "red"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Remember",
              "text": "Keys are flat strings. Prefixes only look like folders, and ==versioning== is your undo."
            }
          ]
        }
      ]
    },
    {
      "title": "Presigned URLs and Multipart Upload",
      "role": "outline",
      "outlineIndex": 2,
      "pages": [
        {
          "title": "Presigned URLs and Multipart Upload",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Presigned URL",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "==Presigned URL== = URL signed with your credentials",
                "Grants {blue:one operation} (GET or PUT) on {blue:one key} until it ==expires==",
                "Holder needs ==no AWS credentials==",
                "Browser-direct: file bytes **never pass through your server**"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "blue"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "Client asks",
                    "sub": "backend",
                    "ink": "blue"
                  },
                  {
                    "text": "Backend signs",
                    "sub": "PUT URL",
                    "ink": "purple"
                  },
                  {
                    "text": "Client PUTs",
                    "sub": "straight to S3",
                    "ink": "green"
                  }
                ]
              }
            },
            {
              "type": "code",
              "lang": "python",
              "lines": [
                "url = s3.generate_presigned_url(",
                "    'put_object',",
                "    Params={'Bucket': b, 'Key': k},",
                "    ExpiresIn=900)"
              ],
              "note": "valid for 900 s"
            },
            {
              "type": "sidebox",
              "title": "Why a URL dies or fails",
              "items": [
                "Temporary creds (IAM role): URL ends when the ==session token== expires, even before ExpiresIn",
                "The signer needs the ==permission itself==",
                "Signed Content-Type: the PUT must send the ==same one=="
              ],
              "ink": "orange"
            },
            {
              "type": "heading",
              "text": "2. Multipart Upload",
              "ink": "purple"
            },
            {
              "type": "diagram",
              "kind": "chain",
              "spec": {
                "steps": [
                  {
                    "text": "Initiate",
                    "note": "get upload id",
                    "ink": "blue"
                  },
                  {
                    "text": "Upload parts",
                    "note": "in parallel",
                    "ink": "purple"
                  },
                  {
                    "text": "Complete",
                    "note": "send ETag list",
                    "ink": "green"
                  }
                ]
              }
            },
            {
              "type": "table",
              "headers": [
                "Rule",
                "Value"
              ],
              "rows": [
                [
                  "Part size",
                  "5 MB to 5 GB"
                ],
                [
                  "Part count",
                  "up to 10,000"
                ],
                [
                  "Use it",
                  "above ~100 MB"
                ],
                [
                  "Required",
                  "above 5 GB"
                ],
                [
                  "Failed part",
                  "retry just that part"
                ]
              ]
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Hidden bill",
              "text": "==Abandoned== incomplete uploads keep billing for stored parts, invisibly. Add lifecycle rule `AbortIncompleteMultipartUpload` after **7 days**."
            }
          ]
        }
      ]
    },
    {
      "title": "Storage Tiers, Lifecycle, Lakes and Warehouses",
      "role": "outline",
      "outlineIndex": 3,
      "pages": [
        {
          "title": "Storage Tiers, Lifecycle, Lakes and Warehouses",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Tiers by Access",
              "ink": "green"
            },
            {
              "type": "table",
              "headers": [
                "Tier",
                "Use",
                "Note"
              ],
              "rows": [
                [
                  "Standard",
                  "hot",
                  "none"
                ],
                [
                  "Standard-IA / One Zone-IA",
                  "infrequent",
                  "==retrieval fee==, 30-day min, 128 KB min billed"
                ],
                [
                  "Glacier Instant",
                  "archive",
                  "instant restore"
                ],
                [
                  "Glacier Flexible",
                  "archive",
                  "restore ==minutes–hours=="
                ],
                [
                  "Deep Archive",
                  "coldest",
                  "restore ==12h+==, cheapest"
                ]
              ]
            },
            {
              "type": "bullets",
              "items": [
                "==Intelligent-Tiering== auto-moves objects by access pattern",
                "Small monitoring fee; best for **unpredictable** access"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "heading",
              "text": "2. Lifecycle Rule",
              "ink": "blue"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "Standard",
                    "sub": "logs/",
                    "ink": "green"
                  },
                  {
                    "text": "IA",
                    "sub": "day 30",
                    "ink": "blue"
                  },
                  {
                    "text": "Glacier",
                    "sub": "day 90",
                    "ink": "purple"
                  },
                  {
                    "text": "Expire",
                    "sub": "day 365",
                    "ink": "red"
                  }
                ]
              }
            },
            {
              "type": "bullets",
              "items": [
                "Rule also expires old ==noncurrent versions=="
              ],
              "style": "check"
            },
            {
              "type": "heading",
              "text": "3. Lake vs Warehouse",
              "ink": "purple"
            },
            {
              "type": "table",
              "headers": [
                "",
                "Lake",
                "Warehouse"
              ],
              "rows": [
                [
                  "Data",
                  "raw, any format",
                  "modeled tables"
                ],
                [
                  "Schema",
                  "{blue:on read}",
                  "{green:on write}"
                ],
                [
                  "Query",
                  "Athena, Spark",
                  "columnar SQL: Redshift, BigQuery, Snowflake"
                ],
                [
                  "Cost",
                  "cheap",
                  "costlier"
                ]
              ],
              "frame": "dashed"
            },
            {
              "type": "bullets",
              "items": [
                "No catalog → lake rots into a ==swamp==",
                "==Lakehouse== (Iceberg, Delta): table features on lake files"
              ],
              "style": "dot"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Remember",
              "text": "Tier by access, automate with lifecycle. Lake = raw, ==schema-on-read==; warehouse = modeled, ==schema-on-write==."
            }
          ]
        }
      ]
    },
    {
      "title": "Inverted Indexes and Elasticsearch Basics",
      "role": "outline",
      "outlineIndex": 4,
      "pages": [
        {
          "title": "Inverted Indexes and Elasticsearch Basics",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Inverted index and analysis",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "==Inverted index==: term → [doc ids], so search **looks up terms**, not every doc",
                "`LIKE '%word%'` cannot use a normal ==B-tree== index: full scan",
                "{red:Analyzer mismatch} at index vs query time → missing hits"
              ],
              "style": "dot"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "Char filters",
                    "sub": "strip HTML",
                    "ink": "blue"
                  },
                  {
                    "text": "Tokenizer",
                    "sub": "split words",
                    "ink": "green"
                  },
                  {
                    "text": "Token filters",
                    "sub": "lowercase, stopwords, 'running' → 'run'",
                    "ink": "purple"
                  }
                ]
              }
            },
            {
              "type": "heading",
              "text": "2. Shards and queries",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "JSON docs live in an ==index== of **primary shards**, each with replicas",
                "Primary shard count is ==fixed==: changing it means **reindexing**",
                "`match` = analyzed text; `term` = exact (keyword); `bool` = must / filter / should / must_not"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "code",
              "lang": "json",
              "lines": [
                "GET /products/_search",
                "{\"query\":{\"bool\":{",
                "  \"must\":[{\"match\":{\"title\":\"running shoes\"}}],",
                "  \"filter\":[{\"term\":{\"brand\":\"nike\"}},",
                "    {\"range\":{\"price\":{\"lte\":100}}}]}},",
                " \"sort\":[{\"price\":\"asc\"}],",
                " \"from\":0,\"size\":10}"
              ],
              "note": "sort, from and size sit beside query"
            },
            {
              "type": "heading",
              "text": "3. Mistakes",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "Dynamic mapping guesses types: set explicit mappings (`text` vs `keyword`)",
                "Deep `from`+`size` paging: use `search_after`",
                "Too many tiny shards",
                "Elasticsearch as the primary database"
              ],
              "style": "cross",
              "frame": "dashed",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "**Interview: why is LIKE '%x%' slow?** A B-tree needs a prefix, so it scans every row",
                "**Interview: add primary shards later?** No, reindex into a new index"
              ],
              "style": "star"
            }
          ]
        }
      ]
    },
    {
      "title": "Relevance, Search Sync and Cheat Sheet",
      "role": "outline",
      "outlineIndex": 5,
      "pages": [
        {
          "title": "Relevance, Search Sync and Cheat Sheet",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Relevance scoring",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "==BM25==: rare terms (IDF), more matches (TF, saturates), shorter fields",
                "Boost with `title^3`; `multi_match` combines fields",
                "`filter` clauses skip scoring and are ==cached=="
              ],
              "style": "dot"
            },
            {
              "type": "code",
              "lang": "json",
              "lines": [
                "{\"bool\": {",
                "\"must\": {\"multi_match\": {\"query\": \"redis\",",
                "\"fields\": [\"title^3\", \"body\"]}},",
                "\"filter\": {\"term\": {\"status\": \"live\"}}}}"
              ]
            },
            {
              "type": "heading",
              "text": "2. Syncing DB to index",
              "ink": "purple"
            },
            {
              "type": "table",
              "headers": [
                "Pattern",
                "Good",
                "Bad"
              ],
              "rows": [
                [
                  "Dual write",
                  "Simple",
                  "Crash between writes diverges; no ordering"
                ],
                [
                  "CDC / outbox",
                  "Reliable, ordered, replayable",
                  "Extra pipeline"
                ]
              ]
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "DB log",
                    "ink": "blue"
                  },
                  {
                    "text": "Debezium",
                    "ink": "purple"
                  },
                  {
                    "text": "Kafka",
                    "ink": "orange"
                  },
                  {
                    "text": "Indexer",
                    "ink": "green"
                  }
                ]
              }
            },
            {
              "type": "bullets",
              "items": [
                "Doc `_id` = DB primary key, so retries overwrite, not duplicate",
                "External versioning = row version; older events are rejected",
                "{orange:Near-real-time}: refresh ~1s, so a read right after a write may miss it"
              ],
              "style": "check"
            },
            {
              "type": "heading",
              "text": "3. Cheat sheet",
              "ink": "green"
            },
            {
              "type": "table",
              "headers": [
                "Topic",
                "Remember"
              ],
              "rows": [
                [
                  "Storage",
                  "block = disk, file = shared tree, object = HTTP blobs"
                ],
                [
                  "Upload",
                  "presign for direct; multipart >100 MB + abort lifecycle"
                ],
                [
                  "Cost",
                  "tier by access with lifecycle rules"
                ],
                [
                  "Analytics",
                  "lake = raw, schema-on-read; warehouse = modeled, schema-on-write"
                ],
                [
                  "Search",
                  "inverted index = term → docs; `text` search, `keyword` exact"
                ]
              ]
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Remember",
              "text": "==DB is truth==; the index is derived and rebuildable."
            }
          ]
        }
      ]
    },
    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "A text field uses the english analyzer. You index 'Running', then run a term query for 'running'. Zero hits. Why?",
              "a_bullets": [
                "The index stored the stemmed, lowercased token `run`.",
                "`term` skips analysis, so it looks for 'running'. Use `match` or term 'run'."
              ]
            },
            {
              "type": "qa",
              "q": "Your backend signs a 24-hour presigned PUT URL using an IAM role. Uploads fail after about an hour. Why?",
              "a_bullets": [
                "The role's temporary session token expires first, and the URL dies with it.",
                "Sign with longer-lived credentials, or issue shorter URLs."
              ]
            },
            {
              "type": "qa",
              "q": "The app commits a row to the DB, then crashes before indexing it in Elasticsearch. What does search show, and what fixes it?",
              "a_bullets": [
                "The row is missing from search: the dual write left the two stores diverged.",
                "Use CDC or an outbox so indexing is replayable. The DB stays the truth."
              ]
            }
          ]
        }
      ]
    }
  ]
}