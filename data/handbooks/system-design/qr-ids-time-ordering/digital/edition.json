          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "Two events have Lamport timestamps L(a)=3 and L(b)=5. Did a happen before b?",
              "a_bullets": [
                "Unknown: a → b implies L(a) < L(b), not the reverse",
                "They may be concurrent; only vector clocks can tell"
              ]
            },
            {
              "type": "qa",
              "q": "NTP steps a Snowflake worker's clock back 5 ms. What can go wrong?",
              "a_bullets": [
                "It reuses timestamps it already issued, with the sequence reset to 0: duplicate IDs",
                "Fix: keep `last_timestamp`; wait or refuse until time catches up"
              ]
            },
            {
              "type": "qa",
              "q": "Vector clocks are A=[2,1] and B=[1,2]. How are the two events related?",
              "a_bullets": [
                "Concurrent: neither vector dominates element-wise",
                "A conflict: keep both as siblings, then merge"
              ]
            }
          ]
        }
      ]
