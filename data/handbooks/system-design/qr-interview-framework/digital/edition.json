    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "50M DAU each post 2 times a day. What are the average and peak write QPS?",
              "a_bullets": [
                "50M × 2 = 10^8 ÷ 10^5 s ≈ **1,000** QPS average",
                "Peak is 2-3×, so ≈ 3,000. That is near one relational DB's limit, so plan for sharding or a queue."
              ]
            },
            {
              "type": "qa",
              "q": "Bug hunt: a candidate shards the tweets table by timestamp. What goes wrong?",
              "a_bullets": [
                "All new writes hit the newest shard, a **hot shard**",
                "Shard by a hashed ID instead, so the shard key matches the query pattern"
              ]
            },
            {
              "type": "qa",
              "q": "Bug hunt: \"1M posts/day × 1 KB × 365 × 5 yr ≈ 1.8 GB.\" What is wrong?",
              "a_bullets": [
                "1M × 1 KB = 1 GB per day, and 1 GB × ~1,800 days ≈ **1.8 TB**",
                "The unit is off by 1000×. Also multiply by 3 for replication."
              ]
            }
          ]
        }
      ]
    }
