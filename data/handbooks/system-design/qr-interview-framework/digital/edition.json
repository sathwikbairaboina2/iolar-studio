      "pages": [
        {
          "title": "Back-of-Envelope Estimation",
          "blocks": [
            {
              "type": "heading",
              "text": "1. The Three Formulas",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "Metric",
                "Formula",
                "Note"
              ],
              "rows": [
                [
                  "QPS",
                  "DAU × actions per user per day ÷ 86,400",
                  "≈10^5 s/day"
                ],
                [
                  "Storage",
                  "writes/day × item size × retention",
                  "×3 replication"
                ],
                [
                  "Bandwidth",
                  "QPS × payload size",
                  "drives CDN"
                ]
              ]
            },
            {
              "type": "bullets",
              "items": [
                "Peak QPS ≈ =={2-3×}== average",
                "Replicas multiply storage: add ==×3=="
              ],
              "style": "check"
            },
            {
              "type": "heading",
              "text": "2. Worked Example",
              "ink": "green"
            },
            {
              "type": "diagram",
              "kind": "chain",
              "spec": {
                "title": "Read QPS",
                "steps": [
                  {
                    "text": "100M DAU × 10 reads/day",
                    "note": "10^9 reads/day",
                    "ink": "blue"
                  },
                  {
                    "text": "÷ 10^5 s/day",
                    "note": "≈ 10,000 read QPS",
                    "ink": "green"
                  },
                  {
                    "text": "10:1 read/write",
                    "note": "≈ 1,000 write QPS",
                    "ink": "purple"
                  }
                ]
              }
            },
            {
              "type": "table",
              "headers": [
                "Estimate",
                "Arithmetic",
                "Result"
              ],
              "rows": [
                [
                  "Storage",
                  "1M posts/day × 1 KB × 365 × 5 yr",
                  "≈ 1.8 TB"
                ],
                [
                  "With replicas",
                  "1.8 TB × 3",
                  "≈ 5.4 TB"
                ],
                [
                  "Egress",
                  "10,000 QPS × 100 KB",
                  "1 GB/s → CDN"
                ]
              ],
              "highlightRow": 2
            },
            {
              "type": "heading",
              "text": "3. Rounding Rules",
              "ink": "orange"
            },
            {
              "type": "bullets",
              "items": [
                "Round to ==powers of 10==: 86,400 ≈ 10^5",
                "**Show the arithmetic** out loud, step by step",
                "Goal is ==order of magnitude==, not precision"
              ],
              "style": "dot"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Common mistake",
              "text": "Chasing exact digits wastes time. 1.8 TB vs 2 TB changes **no** design decision."
            }
          ]
        }
      ]
    },
