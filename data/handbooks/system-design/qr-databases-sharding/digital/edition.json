                  },
                  {
                    "from": "q",
                    "to": "c",
                    "label": "all three"
                  }
                ]
              }
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Ask first",
              "text": "Name the ==bottleneck== before naming a technique. Replicas never fix a write or size limit."
            }
          ]
        }
      ]
    },
    {
      "title": "Leader-Follower Replication",
      "role": "outline",
      "outlineIndex": 1,
      "pages": [
        {
          "title": "Leader-Follower Replication",
          "blocks": [
            {
              "type": "heading",
              "text": "1. How Writes Flow",
              "ink": "green"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "Client write",
                    "sub": "leader only",
                    "ink": "blue"
                  },
                  {
                    "text": "Leader",
                    "sub": "appends WAL / binlog",
                    "ink": "green"
                  },
                  {
                    "text": "Log shipped",
                    "sub": "to every follower",
                    "ink": "purple"
                  },
                  {
                    "text": "Followers",
                    "sub": "apply in order",
                    "ink": "orange"
                  }
                ]
              }
            },
            {
              "type": "bullets",
              "items": [
                "Followers ==apply the log in order==, so they match the leader"
              ],
              "style": "dot"
            },
            {
              "type": "heading",
              "text": "2. Sync, Async, Semi-sync",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "",
                "Ack when",
                "Win",
                "Risk"
              ],
              "rows": [
                [
                  "**Sync**",
                  "follower confirms",
                  "no data loss",
                  "one slow follower {red:blocks writes}"
                ],
                [
                  "**Async**",
                  "leader commits",
                  "fast",
                  "acked writes {red:lost} on leader crash"
                ],
                [
                  "**Semi-sync**",
                  "one sync follower, rest async",
                  "always one up-to-date copy",
                  "extra latency of one follower"
                ]
              ],
              "highlightRow": 2
            },
            {
              "type": "heading",
              "text": "3. Failover",
              "ink": "red"
            },
            {
              "type": "diagram",
              "kind": "chain",
              "spec": {
                "steps": [
                  {
                    "text": "Detect",
                    "note": "leader dead (timeout)",
                    "ink": "red"
                  },
                  {
                    "text": "Elect",
                    "note": "most up-to-date follower",
                    "ink": "blue"
                  },
                  {
                    "text": "Repoint",
                    "note": "clients to new leader",
                    "ink": "purple"
                  },
                  {
                    "text": "Rejoin",
                    "note": "old leader as follower",
                    "ink": "green"
                  }
                ]
              }
            },
            {
              "type": "bullets",
              "items": [
                "Lost async writes",
                "Split brain: two nodes think they are leader",
                "Timeout too low: needless failovers"
              ],
              "style": "cross",
              "ink": "red"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Pick the freshest",
              "text": "Promote the ==most up-to-date== follower to lose the fewest async writes."
            }
          ]
        }
      ]
    },
    {
      "title": "Read Replicas and Replication Lag",
      "role": "outline",
      "outlineIndex": 2,
      "pages": [
        {
          "title": "Read Replicas and Replication Lag",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Replicas and Lag",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "Replicas serve ==SELECT only==; writes go to the **leader**",
                "Split reads and writes in a {blue:proxy} or in app code",
                "==Replication lag== = delay from leader commit to follower visibility",
                "Async replicas give ==eventual consistency=="
              ],
              "style": "dot"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "App",
                    "ink": "black"
                  },
                  {
                    "text": "Proxy",
                    "sub": "read/write split",
                    "ink": "purple"
                  },
                  {
                    "text": "Leader",
                    "sub": "writes",
                    "ink": "red"
                  },
                  {
                    "text": "Replicas",
                    "sub": "SELECTs",
                    "ink": "green"
                  }
                ]
              }
            },
            {
              "type": "heading",
              "text": "2. Lag Anomalies",
              "ink": "orange"
            },
            {
              "type": "table",
              "headers": [
                "Anomaly",
                "Symptom",
                "Fix"
              ],
              "rows": [
                [
                  "==Read-your-writes==",
                  "Post, then read: nothing (lagging replica)",
                  "Read own recent writes from leader, or pin to a caught-up replica"
                ],
                [
                  "==Monotonic reads==",
                  "Reads hit different replicas: time goes backward",
                  "Pin user to one replica"
                ]
              ]
            },
            {
              "type": "heading",
              "text": "3. Monitor and Fall Back",
              "ink": "green"
            },
            {
              "type": "code",
              "lang": "sql",
              "lines": [
                "SELECT application_name, replay_lag",
                "FROM pg_stat_replication;  -- Postgres",
                "SHOW REPLICA STATUS;  -- MySQL: Seconds_Behind_Source"
              ],
              "note": "lag metrics to watch"
            },
            {
              "type": "bullets",
              "items": [
                "==Alert== when lag crosses a threshold",
                "Lag over threshold: ==fall back to the leader== for reads"
              ],
              "style": "check"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Remember",
              "text": "Replicas scale reads, not consistency. Async lag means **stale reads**, so pin users or read from the leader."
            }
          ]
        }
      ]
    },
    {
      "title": "Multi-Leader Replication",
      "role": "outline",
      "outlineIndex": 3,
      "pages": [
        {
          "title": "Multi-Leader Replication",
          "blocks": [
            {
              "type": "heading",
              "text": "1. What and Why",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "Many nodes ==accept writes== and replicate to each other",
                "Used for {blue:multi-datacenter}, offline-capable clients, collaborative editing",
                "{green:Benefit}: local-latency writes per region; survives a datacenter outage",
                "{red:Cost}: ==write conflicts=="
              ],
              "style": "check",
              "ink": "green"
            },
            {
              "type": "heading",
              "text": "2. Write Conflicts",
              "ink": "red"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "Leader A",
                    "sub": "sets x=1",
                    "ink": "blue"
                  },
                  {
                    "text": "Leader B",
                    "sub": "sets x=2",
                    "ink": "purple"
                  },
                  {
                    "text": "Replicate",
                    "sub": "each to the other",
                    "ink": "orange"
                  },
                  {
                    "text": "Conflict",
                    "sub": "same key, two values",
                    "ink": "red"
                  }
                ]
              }
            },
            {
              "type": "bullets",
              "items": [
                "Avoid: route all writes for a record to ==one leader==",
                "{blue:Last-write-wins}: simple, but ==silently drops data==",
                "{green:Merge values} or use ==CRDTs==",
                "{purple:Custom app logic} on read or write"
              ],
              "style": "dot"
            },
            {
              "type": "heading",
              "text": "3. Three Models Compared",
              "ink": "purple"
            },
            {
              "type": "table",
              "headers": [
                "",
                "Writes go to",
                "Trade-off"
              ],
              "rows": [
                [
                  "Single leader",
                  "one leader",
                  "no conflicts, one write bottleneck"
                ],
                [
                  "Multi-leader",
                  "a leader per region",
                  "regional writes, conflicts"
                ],
                [
                  "Leaderless (Dynamo)",
                  "any replica",
                  "quorum: ==W + R > N=="
                ]
              ],
              "highlightRow": 1
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "LWW loses writes",
              "text": "Last-write-wins raises no error: one of two concurrent writes just vanishes."
            }
          ]
        }
      ]
    },
    {
      "title": "Partitioning, Sharding and Consistent Hashing",
      "role": "outline",
      "outlineIndex": 4,
      "pages": [
        {
          "title": "Partitioning, Sharding and Consistent Hashing",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Range vs Hash",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "",
                "Range",
                "Hash mod N"
              ],
              "rows": [
                [
                  "Layout",
                  "Contiguous key ranges",
                  "`hash(key) mod N`"
                ],
                [
                  "Good",
                  "{green:Fast range scans}",
                  "{green:Even load}"
                ],
                [
                  "Bad",
                  "{red:Timestamps make a hot partition}",
                  "{red:No range queries; new N remaps almost every key}"
                ]
              ],
              "frame": "dashed"
            },
            {
              "type": "heading",
              "text": "2. Consistent Hashing",
              "ink": "green"
            },
            {
              "type": "diagram",
              "kind": "chain",
              "spec": {
                "steps": [
                  {
                    "text": "Ring",
                    "note": "nodes and keys hashed onto it",
                    "ink": "blue"
                  },
                  {
                    "text": "Key",
                    "note": "walks clockwise",
                    "ink": "purple"
                  },
                  {
                    "text": "Owner",
                    "note": "next node it meets",
                    "ink": "green"
                  }
                ]
              }
            },
            {
              "type": "bullets",
              "items": [
                "Add or remove a node: only about ==1/N== of keys move",
                "{green:Virtual nodes} smooth uneven distribution",
                "Use it instead of `hash mod N` when node count changes"
              ],
              "style": "check",
              "ink": "green"
            },
            {
              "type": "heading",
              "text": "3. Directory and Hot Keys",
              "ink": "orange"
            },
            {
              "type": "bullets",
              "items": [
                "==Directory sharding==: a mapping table sends keys to shards",
                "Flexible rebalancing, but the lookup service must stay ==available=="
              ],
              "style": "dot"
            },
            {
              "type": "sidebox",
              "title": "Hot key (celebrity, viral item)",
              "items": [
                "Hashing cannot split one key",
                "Salt it: `key#0`..`key#k`, fan-in on read",
                "Cache the hot value",
                "Give the key a dedicated shard"
              ],
              "ink": "orange"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Remember",
              "text": "`hash mod N` breaks when N changes. Use consistent hashing with virtual nodes."
            }
          ]
        }
      ]
    },
    {
      "title": "Replication and Sharding Cheat Sheet",
      "role": "outline",
      "outlineIndex": 5,
      "pages": [
        {
          "title": "Replication and Sharding Cheat Sheet",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Pick the Tool",
              "ink": "green"
            },
            {
              "type": "table",
              "headers": [
                "Bottleneck",
                "Pick"
              ],
              "rows": [
                [
                  "Reads",
                  "Add ==read replicas=="
                ],
                [
                  "Writes or data size",
                  "==Shard== (partition)"
                ],
                [
                  "Multi-region writes",
                  "==Multi-leader== or leaderless, with conflict handling"
                ]
              ],
              "frame": "dashed"
            },
            {
              "type": "heading",
              "text": "2. Sync Modes and Lag",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "Mode",
                "Acks after",
                "Trade-off"
              ],
              "rows": [
                [
                  "Sync",
                  "follower confirms",
                  "{green:durable}, {red:slow}"
                ],
                [
                  "Async",
                  "leader commits",
                  "{green:fast}, acked writes can be {red:lost}"
                ],
                [
                  "Semi-sync",
                  "one sync follower",
                  "compromise"
                ]
              ]
            },
            {
              "type": "bullets",
              "items": [
                "==Read-your-writes==: read own recent writes from the **leader**",
                "==Monotonic reads==: pin a user to **one replica**"
              ],
              "style": "check",
              "ink": "blue"
            },
            {
              "type": "heading",
              "text": "3. Shard Keys and Rings",
              "ink": "purple"
            },
            {
              "type": "bullets",
              "items": [
                "High ==cardinality==",
                "Even ==distribution==",
                "Matches the **main query pattern**"
              ],
              "style": "check",
              "ink": "purple"
            },
            {
              "type": "bullets",
              "items": [
                "Monotonic keys (timestamps) with range sharding: {red:hot partition}",
                "`hash mod N` when node count changes: remaps almost every key"
              ],
              "style": "cross"
            },
            {
              "type": "bullets",
              "items": [
                "Use ==consistent hashing== plus **virtual nodes**: adding a node moves ~1/N of keys",
                "Hot keys: ==salting== (`key#0..key#k`) or ==caching=="
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "purple"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Replicas do not scale writes",
              "text": "Replication fixes **reads** and failover only. If writes or data size outgrow one machine, ==shard==."
            }
          ]
        }
      ]
    },
    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "Async replication. The leader acks a write, then crashes before shipping it. A follower is promoted. Is the write there?",
              "a_bullets": [
                "No: the write is **lost**, though the client was told it succeeded",
                "Sync or semi-sync replication keeps one up-to-date copy"
              ]
            },
            {
              "type": "qa",
              "q": "A user posts a comment, reloads, and it is missing. Another reload shows it. Name the anomaly and the fix.",
              "a_bullets": [
                "**Read-your-writes** violation: the read hit a lagging replica",
                "Read a user's own recent writes from the leader"
              ]
            },
            {
              "type": "qa",
              "q": "Shards use `hash(key) mod 4`. You add a fifth node. Roughly what share of keys move?",
              "a_bullets": [
                "About **80%**: only keys with the same remainder mod 4 and mod 5 stay",
                "Consistent hashing moves only about 1/N"
              ]
            },
            {
              "type": "qa",
              "q": "One celebrity's key overloads its shard. Does adding shards help?",
              "a_bullets": [
                "No: hashing sends one key to one shard",
                "Salt the key (`key#0..k`) and merge on read, or cache it"
              ]
            }
          ]
        }
      ]
    }
  ]
}