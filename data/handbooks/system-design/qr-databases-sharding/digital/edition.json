      "pages": [
        {
          "title": "Replication and Partitioning Mental Model",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Two Different Tools",
              "ink": "green"
            },
            {
              "type": "table",
              "headers": [
                "",
                "Replication",
                "Partitioning"
              ],
              "rows": [
                [
                  "Data",
                  "{blue:Same} data copied on many nodes",
                  "{purple:Different} slice on each node"
                ],
                [
                  "Scales",
                  "Reads, availability",
                  "Writes, storage"
                ]
              ],
              "frame": "dashed"
            },
            {
              "type": "bullets",
              "items": [
                "Real systems ==combine both==: every partition is replicated",
                "So one node holds ==several partitions' replicas=="
              ],
              "style": "dot",
              "ink": "green"
            },
            {
              "type": "heading",
              "text": "2. What Each One Fixes",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "",
                "Fixes",
                "Does NOT fix"
              ],
              "rows": [
                [
                  "Replication",
                  "Read throughput, fault tolerance",
                  "{red:Data or write rate} beyond one machine"
                ],
                [
                  "Partitioning",
                  "Dataset size, write throughput",
                  "{red:Cross-partition joins, transactions, global secondary indexes}"
                ]
              ],
              "highlightRow": 1
            },
            {
              "type": "heading",
              "text": "3. Pick by Bottleneck",
              "ink": "purple"
            },
            {
              "type": "diagram",
              "kind": "flowchart",
              "spec": {
                "rows": [
                  [
                    "q"
                  ],
                  [
                    "a",
                    "b",
                    "c"
                  ]
                ],
                "nodes": {
                  "q": {
                    "text": "Bottleneck: reads, writes or data size?",
                    "shape": "diamond"
                  },
                  "a": {
                    "text": "Read replicas",
                    "shape": "box",
                    "ink": "blue"
                  },
                  "b": {
                    "text": "Partition / shard",
                    "shape": "box",
                    "ink": "purple"
                  },
                  "c": {
                    "text": "Both",
                    "shape": "box",
                    "ink": "green"
                  }
                },
                "edges": [
                  {
                    "from": "q",
                    "to": "a",
                    "label": "reads"
                  },
                  {
                    "from": "q",
