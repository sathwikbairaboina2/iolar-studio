    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "Service A calls B with a 2s timeout. B calls C with a 3s timeout. What goes wrong?",
              "a_bullets": [
                "A gives up at 2s, but B keeps waiting on C for up to 3s.",
                "That work is wasted, and A's retries pile more load onto B.",
                "Fix: the caller's timeout must be ==greater== than the callee's."
              ]
            },
            {
              "type": "qa",
              "q": "Three services are called in a sync chain, each 99% available. About how available is the chain?",
              "a_bullets": [
                "0.99 × 0.99 × 0.99 ≈ ==97%==.",
                "Sync calls multiply availability, so every extra hop lowers it."
              ]
            },
            {
              "type": "qa",
              "q": "The Orders service reads the Payments table directly for a report. What breaks?",
              "a_bullets": [
                "It is a hidden shared database: Payments can't change its schema or deploy alone.",
                "Use Payments' API, or events feeding a read model."
              ]
            }
          ]
        }
      ]
