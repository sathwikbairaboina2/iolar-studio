                    "ink": "green"
                  },
                  {
                    "text": "App B",
                    "sub": "no network code",
                    "ink": "blue"
                  }
                ]
              }
            },
            {
              "type": "heading",
              "text": "2. Data Plane vs Control Plane",
              "ink": "purple"
            },
            {
              "type": "table",
              "headers": [
                "Plane",
                "Role",
                "Examples"
              ],
              "rows": [
                [
                  "==Data plane==",
                  "Sidecar proxies carry the traffic",
                  "Envoy (Istio), linkerd2-proxy (Linkerd)"
                ],
                [
                  "==Control plane==",
                  "Pushes config, policy, certificates",
                  "Istio, Linkerd"
                ]
              ],
              "frame": "dashed"
            },
            {
              "type": "heading",
              "text": "3. Gains and Costs",
              "ink": "orange"
            },
            {
              "type": "bullets",
              "items": [
                "Uniform ==mTLS== between all services",
                "Traffic splitting for ==canary== releases",
                "Observability across languages, no code changes"
              ],
              "style": "check"
            },
            {
              "type": "bullets",
              "items": [
                "Extra ==latency hop== on every call",
                "CPU and memory **per pod**",
                "Operational complexity; skip it for a handful of services"
              ],
              "style": "cross",
              "ink": "red"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Too heavy?",
              "text": "Consider ==sidecarless (ambient)== mode: mesh features without a proxy in every pod."
            }
          ]
        }
      ]
