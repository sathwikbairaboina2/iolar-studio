            },
            {
              "type": "heading",
              "text": "3. Common Mistake",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "Scaling the app tier while a ==single database== stays the bottleneck"
              ],
              "style": "cross"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Scale the DB too",
              "text": "Add ==read replicas==, ==caching== or ==sharding==. More app instances just queue on the same database."
            }
          ]
        }
      ]
