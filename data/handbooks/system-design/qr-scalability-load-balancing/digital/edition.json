          "blocks": [
            {
              "type": "heading",
              "text": "1. Vertical vs Horizontal",
              "ink": "green"
            },
            {
              "type": "table",
              "headers": [
                "",
                "Vertical (scale up)",
                "Horizontal (scale out)"
              ],
              "rows": [
                [
                  "Change",
                  "Bigger machine: more CPU/RAM",
                  "More machines behind a LB"
                ],
                [
                  "Capacity",
                  "{red:Limited}, hard ceiling",
                  "{green:Elastic}, near-linear"
                ],
                [
                  "Upside",
                  "Simple, no code change",
                  "Resilient, fault tolerant"
                ],
                [
                  "Downside",
                  "{red:SPOF}, downtime on resize",
                  "Complex: needs stateless design, data consistency, networking"
                ]
              ],
              "highlightRow": 1
            },
            {
              "type": "heading",
              "text": "2. Example: 4-vCPU API at 90% CPU",
              "ink": "blue"
            },
            {
              "type": "diagram",
              "kind": "flowchart",
              "spec": {
                "rows": [
                  [
                    "q"
                  ],
                  [
                    "a",
