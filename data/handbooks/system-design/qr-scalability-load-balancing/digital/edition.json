    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "An API serves 200 RPS at 50 ms latency. You add instances and it now serves 400 RPS at the same latency. How many requests are in flight?",
              "a_bullets": [
                "400 × 0.05 = ==20== (concurrency = throughput × latency)",
                "Adding instances raised throughput, not per-request latency"
              ]
            },
            {
              "type": "qa",
              "q": "Behind a round-robin LB, users are logged out at random. Sessions sit in each instance's memory. Why, and what is the fix?",
              "a_bullets": [
                "The next request lands on an instance with no copy of the session",
                "Move sessions to a shared store like ==Redis==; sticky sessions only hide the bug"
              ]
            },
            {
              "type": "qa",
              "q": "Every /health check queries the database, and the database goes down. What does the LB do?",
              "a_bullets": [
                "Every instance fails its check and is removed, so ==no healthy backends== remain: full outage",
                "Keep the check shallow, and handle the DB failure separately"
              ]
            }
          ]
        }
      ]
