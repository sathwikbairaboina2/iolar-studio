    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "SLO is 99.9% over 30 days. Outages so far: 20 min and 30 min. What is the state?",
              "a_bullets": [
                "Budget is about 43 min; 50 min used, so it is overspent.",
                "Freeze feature releases and fix reliability."
              ]
            },
            {
              "type": "qa",
              "q": "A team adds `user_id` as a label on a request counter. What goes wrong?",
              "a_bullets": [
                "Each user makes a new time series, so cost and memory explode.",
                "Put user_id in logs and traces instead."
              ]
            },
            {
              "type": "qa",
              "q": "A canary looks healthy, but a migration dropped a column. Why does rollback fail?",
              "a_bullets": [
                "The old version still reads that column.",
                "Use expand then contract: add first, drop only after full rollout."
              ]
            }
          ]
        }
      ]
