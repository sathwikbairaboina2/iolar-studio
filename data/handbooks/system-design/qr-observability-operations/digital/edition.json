      "title": "Logs, Metrics and Traces",
      "role": "outline",
      "outlineIndex": 1,
      "pages": [
        {
          "title": "Logs, Metrics and Traces",
          "blocks": [
            {
              "type": "heading",
              "text": "1. The Three Signals",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "{blue:Logs}: timestamped ==discrete events==",
                "{green:Metrics}: numeric ==time series==, aggregated cheaply",
                "{purple:Traces}: one request across services, as ==spans=="
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "heading",
              "text": "2. How a Trace Is Built",
              "ink": "blue"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "Edge",
                    "sub": "makes trace ID",
                    "ink": "green"
                  },
                  {
                    "text": "Propagate",
                    "sub": "`traceparent` header (W3C)",
                    "ink": "blue"
                  },
                  {
                    "text": "Each span",
                    "sub": "parent ID, duration, status",
                    "ink": "purple"
                  }
                ]
              }
            },
            {
              "type": "heading",
              "text": "3. Compare and Combine",
              "ink": "purple"
            },
            {
              "type": "table",
              "headers": [
                "",
                "Metrics",
                "Traces",
                "Logs"
              ],
              "rows": [
                [
                  "Answer",
                  "Is something wrong?",
                  "Where?",
                  "Why?"
                ],
                [
                  "Detail",
                  "aggregated, cheap",
                  "per request",
                  "highest, costliest"
                ]
              ],
              "highlightRow": 0
            },
            {
              "type": "diagram",
              "kind": "chain",
              "spec": {
                "title": "One trace ID links all three",
                "steps": [
                  {
                    "text": "p99 spikes",
                    "note": "metric",
                    "ink": "green"
                  },
                  {
                    "text": "Payment span slow",
                    "note": "trace",
                    "ink": "purple"
                  },
                  {
                    "text": "DB lock timeout",
                    "note": "log line",
                    "ink": "blue"
                  }
                ]
              }
            },
            {
              "type": "heading",
              "text": "4. Mistakes",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "==High-cardinality== labels (`user_id`, `request_id`) explode series and cost",
                "Put those IDs in logs and traces instead",
                "Log **structured JSON**, not free text"
              ],
              "style": "cross",
              "frame": "dashed",
              "ink": "red"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Remember",
              "text": "Metrics say ==what==, traces say ==where==, logs say ==why==."
            }
          ]
        }
      ]
    },
    {
      "title": "SLIs, SLOs, SLAs and Error Budgets",
      "role": "outline",
      "outlineIndex": 2,
      "pages": [
        {
          "title": "SLIs, SLOs, SLAs and Error Budgets",
          "blocks": [
            {
              "type": "heading",
              "text": "1. SLI, SLO, SLA",
              "ink": "green"
            },
            {
              "type": "table",
              "headers": [
                "",
                "SLI",
                "SLO",
                "SLA"
              ],
              "rows": [
                [
                  "Is",
                  "Measured ratio",
                  "Internal target",
                  "Contract with penalties"
                ],
                [
                  "Answers",
                  "What you **measure**",
                  "What you **aim** for",
                  "What you **promise** and pay for"
                ],
                [
                  "Looks like",
                  "good / valid events",
                  "99.9% over 30 days",
                  "Looser than the SLO"
                ]
              ],
              "highlightRow": 1
            },
            {
              "type": "bullets",
              "items": [
                "SLI = ==good events / valid events==",
                "SLO is always ==stricter== than the SLA"
              ],
              "style": "dot"
            },
            {
              "type": "heading",
              "text": "2. Error Budget",
              "ink": "blue"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "SLO 99.9%",
                    "sub": "over 30 days",
                    "ink": "green"
                  },
                  {
                    "text": "Budget = 1 - SLO",
                    "sub": "0.1%",
                    "ink": "blue"
                  },
                  {
                    "text": "About 43 min",
                    "sub": "allowed downtime",
                    "ink": "orange"
                  }
                ]
              }
            },
            {
              "type": "bullets",
              "items": [
                "Example SLO: ==99.9%== of requests succeed in under `300 ms`",
                "Budget burning fast: {red:freeze feature releases}",
                "Spend that time on ==reliability==, not features"
              ],
              "style": "check"
            },
            {
              "type": "heading",
              "text": "3. Common Mistakes",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "Setting ==100%==: no budget left to ship",
                "Measuring server CPU, not **user-facing success**",
                "Using averages, not percentiles like ==p99=="
              ],
              "style": "cross",
              "frame": "dashed",
              "ink": "red"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Remember",
              "text": "SLI measures, SLO aims, SLA pays. The ==SLO is stricter== than the SLA, so you burn budget before you owe penalties."
            }
          ]
        }
      ]
    },
    {
      "title": "Alerting on Symptoms",
      "role": "outline",
      "outlineIndex": 3,
      "pages": [
        {
          "title": "Alerting on Symptoms",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Symptoms, Not Causes",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "{green:Page on symptoms}: ==error rate==, ==latency==, ==availability==",
                "{red:Not on causes}: CPU, memory, a single pod down",
                "Symptom = a **user** feels it; cause = maybe nobody does"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "heading",
              "text": "2. Burn Rate",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "==Burn rate== = current error-budget use ÷ allowed rate",
                "Burn rate **1** uses exactly the whole budget by window end",
                "Burn rate 14.4 over 1h eats about 2% of a 30-day budget",
                "==Multi-window==: a long and a short window must both exceed it"
              ],
              "style": "dot"
            },
            {
              "type": "table",
              "headers": [
                "",
                "Fast burn",
                "Slow burn"
              ],
              "rows": [
                [
                  "Example",
                  "14.4x over 1h",
                  "1x over 3 days"
                ],
                [
                  "Action",
                  "{red:Page} a human now",
                  "{blue:Ticket}, fix in hours"
                ]
              ],
              "frame": "dashed"
            },
            {
              "type": "heading",
              "text": "3. Example and Mistakes",
              "ink": "red"
            },
            {
              "type": "diagram",
              "kind": "flowchart",
              "spec": {
                "rows": [
                  [
                    "q"
                  ],
                  [
                    "a",
                    "b"
                  ]
                ],
                "nodes": {
                  "q": {
                    "text": "5xx ratio over 5m and 1h above threshold?",
                    "shape": "diamond"
                  },
                  "a": {
                    "text": "Page + runbook",
                    "shape": "box",
                    "ink": "red"
                  },
                  "b": {
                    "text": "Dashboard only (CPU 90%, latency healthy)",
                    "shape": "pill",
                    "ink": "green"
                  }
                },
                "edges": [
                  {
                    "from": "q",
                    "to": "a",
                    "label": "yes"
                  },
                  {
                    "from": "q",
                    "to": "b",
                    "label": "no"
                  }
                ]
              }
            },
            {
              "type": "bullets",
              "items": [
                "Paging on causes gives ==alert fatigue==",
                "Every page must be **actionable** and link a runbook",
                "Nothing should page for what **self-heals**"
              ],
              "style": "cross",
              "ink": "red"
            }
          ]
        }
      ]
    },
    {
      "title": "Safe Releases: Blue-Green, Canary and Feature Flags",
      "role": "outline",
      "outlineIndex": 4,
      "pages": [
        {
          "title": "Safe Releases: Blue-Green, Canary and Feature Flags",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Three Strategies",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "{blue:Blue-green}: ==two full environments==, traffic switches at once",
                "{orange:Canary}: a small slice goes to the new version first",
                "{purple:Feature flags}: ==deploy is not release==, code ships dark"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "1%",
                    "sub": "canary",
                    "ink": "green"
                  },
                  {
                    "text": "5%",
                    "sub": "compare SLIs",
                    "ink": "blue"
                  },
                  {
                    "text": "25%",
                    "sub": "compare SLIs",
                    "ink": "orange"
                  },
                  {
                    "text": "100%",
                    "sub": "full rollout",
                    "ink": "purple"
                  }
                ]
              }
            },
            {
              "type": "heading",
              "text": "2. Rollback and Trade-offs",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "",
                "Blue-green",
                "Canary",
                "Flags"
              ],
              "rows": [
                [
                  "Rollback",
                  "flip router to old env",
                  "auto, canary SLIs vs baseline",
                  "kill switch"
                ],
                [
                  "Strength",
                  "instant switch",
                  "limits blast radius",
                  "per-user, no redeploy"
                ],
                [
                  "Cost",
                  "**double** capacity",
                  "cheaper",
                  "cheap"
                ],
                [
                  "Catch",
                  "idle second env",
                  "slower, mixed versions",
                  "flag debt"
                ]
              ],
              "frame": "dashed"
            },
            {
              "type": "heading",
              "text": "3. Example and Mistakes",
              "ink": "red"
            },
            {
              "type": "code",
              "lang": "bash",
              "lines": [
                "kubectl rollout undo deployment/api"
              ],
              "note": "reverts a rolling update"
            },
            {
              "type": "bullets",
              "items": [
                "Flag `new_checkout` on for ==5% of users==; kill switch turns it off in seconds",
                "Incompatible DB schema breaks rollback: use ==expand then contract==",
                "Stale flags pile up as tech debt: remove after full rollout"
              ],
              "style": "cross",
              "frame": "dashed",
              "ink": "red"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Remember",
              "text": "Rollback only works if the **old version still runs on the new schema**."
            }
          ]
        }
      ]
    },
    {
      "title": "Autoscaling, Disaster Recovery and Multi-Region",
      "role": "outline",
      "outlineIndex": 5,
      "pages": [
        {
          "title": "Autoscaling, Disaster Recovery and Multi-Region",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Autoscaling",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "{green:Horizontal}: add instances on a metric target",
                "Targets: CPU ==60%==, requests per pod, ==queue depth==",
                "==Cooldown== or stabilization window stops flapping",
                "Set ==min== for HA, ==max== for cost control"
              ],
              "style": "check"
            },
            {
              "type": "code",
              "lang": "bash",
              "lines": [
                "kubectl autoscale deployment api --cpu-percent=60 --min=3 --max=20"
              ],
              "note": "Kubernetes HPA"
            },
            {
              "type": "heading",
              "text": "2. RPO, RTO and Regions",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "==RPO==: max tolerable data loss (time since last good copy)",
                "==RTO==: max tolerable time to restore service",
                "Payments DB with RPO 0 needs {blue:synchronous replication}"
              ],
              "style": "dot"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "Backups",
                    "sub": "cheapest",
                    "ink": "green"
                  },
                  {
                    "text": "Replication",
                    "sub": "costs more",
                    "ink": "orange"
                  },
                  {
                    "text": "Sync standby",
                    "sub": "lowest RPO",
                    "ink": "red"
                  }
                ]
              }
            },
            {
              "type": "table",
              "headers": [
                "",
                "Active-passive",
                "Active-active"
              ],
              "rows": [
                [
                  "Traffic",
                  "standby idle or warm",
                  "all regions serve"
                ],
                [
                  "Failover",
                  "DNS or load balancer",
                  "none needed"
                ],
                [
                  "RTO",
                  "minutes",
                  "near-zero"
                ],
                [
                  "Cost",
                  "simpler, cheaper",
                  "conflict resolution, consistency design"
                ]
              ],
              "highlightRow": 2
            },
            {
              "type": "heading",
              "text": "3. Mistakes",
              "ink": "red"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Untested DR fails",
              "text": "Run **failover drills**. Keep backups in a ==separate region and account==. Never scale on lagging metrics when queue depth is available."
            }
          ]
        }
      ]
    },
