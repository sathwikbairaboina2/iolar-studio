    {
      "title": "Class Members and Visibility Mental Model",
      "role": "outline",
      "outlineIndex": 0,
      "pages": [
        {
          "title": "Class Members and Visibility Mental Model",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Defaults and Erasure",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "Members with no modifier are ==public== by default",
                "`public`, `private`, `protected` are ==compile-time checks== only",
                "All three are **erased** in the emitted JS"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "heading",
              "text": "2. The Three Modifiers",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "Modifier",
                "Inside class",
                "Subclass",
                "Outside instance"
              ],
              "rows": [
                [
                  "`public`",
                  "{green:OK}",
                  "{green:OK}",
                  "{green:OK}"
                ],
                [
                  "`protected`",
                  "{green:OK}",
                  "{green:OK}",
                  "{red:error}"
                ],
                [
                  "`private`",
                  "{green:OK}",
                  "{red:error}",
                  "{red:error}"
                ]
              ],
              "frame": "dashed"
            },
            {
              "type": "heading",
              "text": "3. Example",
              "ink": "purple"
            },
            {
              "type": "code",
              "lang": "typescript",
              "lines": [
                "class A { private x = 1; protected y = 2; z = 3 }",
                "const a = new A();",
                "a.x; // error: private",
                "a.y; // error: protected",
                "a.z; // OK, public"
              ],
              "note": "only z is reachable from outside"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Remember",
              "text": "Modifiers are erased, so they give ==no runtime protection==. Plain JS can still read `a.x`."
            }
          ]
        }
      ]
    },
    {
      "title": "#private, readonly and Parameter Properties",
      "role": "outline",
      "outlineIndex": 1,
      "pages": [
        {
          "title": "#private, readonly and Parameter Properties",
          "blocks": [
            {
              "type": "heading",
              "text": "1. #private vs private",
              "ink": "purple"
            },
            {
              "type": "bullets",
              "items": [
                "`#name` is a ==runtime-private== field (ES2022)",
                "Blocked outside the class even in **plain JS**",
                "TS `private` is {red:erased}: checked only at compile time"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "purple"
            },
            {
              "type": "table",
              "headers": [
                "",
                "private x",
                "#x"
              ],
              "rows": [
                [
                  "Enforced",
                  "compile time",
                  "{green:runtime}"
                ],
                [
                  "`obj['x']`",
                  "{red:bypasses it}",
                  "not allowed"
                ],
                [
                  "Cast `as any`",
                  "{red:bypasses it}",
                  "not allowed"
                ],
                [
                  "In emitted JS",
                  "plain property",
                  "real private field"
                ]
              ],
              "highlightRow": 1
            },
            {
              "type": "heading",
              "text": "2. readonly",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "Assign only in the ==declaration== or the ==constructor==",
                "Later assignment is a compile **error**",
                "It is {orange:shallow}: contents of the value stay mutable"
              ],
              "style": "check",
              "ink": "blue"
            },
            {
              "type": "code",
              "lang": "typescript",
              "lines": [
                "class Box {",
                "  readonly tags: string[] = [];",
                "}",
                "const b = new Box();",
                "b.tags.push('a');  // OK",
                "b.tags = [];       // error"
              ],
              "note": "readonly freezes the binding, not the array"
            },
            {
              "type": "heading",
              "text": "3. Parameter Properties",
              "ink": "orange"
            },
            {
              "type": "bullets",
              "items": [
                "A modifier on a constructor parameter ==declares and assigns== the field",
                "Empty body is enough"
              ],
              "style": "dot"
            },
            {
              "type": "code",
              "lang": "typescript",
              "lines": [
                "class User {",
                "  constructor(",
                "    private readonly id: string,",
                "    public name = 'x'",
                "  ) {}",
                "}"
              ],
              "note": "two fields, no assignments written"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Gotcha",
              "text": "Only `public`, `private`, `protected`, `readonly` or `override` makes a parameter a property. A plain parameter stays a **local variable**."
            }
          ]
        }
      ]
    },
    {
      "title": "Abstract Classes and implements",
      "role": "outline",
      "outlineIndex": 2,
      "pages": [
        {
          "title": "Abstract Classes and implements",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Abstract classes",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "An ==abstract class== cannot be built with `new`",
                "It holds concrete members **and** abstract ones (no body)",
                "A concrete subclass must implement ==all== abstract members",
                "Otherwise it must be declared `abstract` too"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "code",
              "lang": "typescript",
              "lines": [
                "abstract class Shape {",
                "  abstract area(): number;",
                "  show() { return this.area(); }",
                "}",
                "class Sq extends Shape {",
                "  area() { return 4; }",
                "}"
              ],
              "note": "new Shape() is a compile error"
            },
            {
              "type": "heading",
              "text": "2. extends vs implements",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "`implements` = ==compile-time== shape check against an interface or type",
                "It inherits nothing and emits no JS"
              ],
              "style": "dot"
            },
            {
              "type": "table",
              "headers": [
                "",
                "extends",
                "implements"
              ],
              "rows": [
                [
                  "Gives you",
                  "implementation",
                  "nothing"
                ],
                [
                  "How many",
                  "{red:one} base",
                  "**many**"
                ],
                [
                  "In emitted JS",
                  "yes",
                  "none"
                ]
              ],
              "frame": "dashed"
            },
            {
              "type": "code",
              "lang": "typescript",
              "lines": [
                "interface A { run(n: number): void }",
                "interface B { id: string }",
                "class Base {}",
                "class C extends Base implements A, B {",
                "  id = \"c\";",
                "  run(n: number) {}",
                "}"
              ]
            },
            {
              "type": "heading",
              "text": "3. Gotchas",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "`implements` does not infer params: annotate `run(n: number)`",
                "Interfaces are erased: no `instanceof` on them"
              ],
              "style": "cross",
              "ink": "red"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Runtime",
              "text": "An abstract class ==exists at runtime==, so `instanceof` works. An interface does not."
            }
          ]
        }
      ]
    },
    {
      "title": "Static Members and Structural Typing of Classes",
      "role": "outline",
      "outlineIndex": 3,
      "pages": [
        {
          "title": "Static Members and Structural Typing of Classes",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Static Members",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "`static` lives on the ==class constructor==, not on instances",
                "Access with `Counter.count`, not `this.count`",
                "Can be `public`, `private`, `protected`, `readonly`",
                "==Inherited== by subclasses",
                "`static { ... }` block runs **once** at class load"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "code",
              "lang": "typescript",
              "lines": [
                "class Counter {",
                "  static count = 0;",
                "  static { Counter.count = 10; }",
                "  static inc() { return ++Counter.count; }",
                "}",
                "Counter.inc(); // 11"
              ],
              "note": "call via the class name"
            },
            {
              "type": "heading",
              "text": "2. Structural Typing",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "Same ==shape== means assignable",
                "`const p: Point = { x: 1, y: 2 }` works for a class `Point`",
                "{red:Exception}: a `private` or `protected` member makes it ==nominal-like==",
                "Only that class or its subclasses are assignable"
              ],
              "style": "dot"
            },
            {
              "type": "heading",
              "text": "3. Two Types per Class",
              "ink": "purple"
            },
            {
              "type": "table",
              "headers": [
                "Name",
                "Type of",
                "Contains"
              ],
              "rows": [
                [
                  "`Point`",
                  "instance type",
                  "instance members"
                ],
                [
                  "`typeof Point`",
                  "constructor type",
                  "`new` + static side"
                ]
              ]
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Remember",
              "text": "Matching public shape is interchangeable; a ==private== member breaks it."
            }
          ]
        }
      ]
    },
    {
      "title": "Common Mistakes with Classes",
      "role": "outline",
      "outlineIndex": 4,
      "pages": [
        {
          "title": "Common Mistakes with Classes",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Privacy and readonly",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "`private` is ==erased== in JS: `obj['x']` or a cast reads it",
                "Use `#x` for ==real== runtime privacy",
                "`readonly` is ==shallow==: `readonly tags: string[]` still allows `push`"
              ],
              "style": "cross",
              "ink": "red"
            },
            {
              "type": "code",
              "lang": "typescript",
              "lines": [
                "class A { private a = 1; #b = 2 }",
                "const o = new A()",
                "o['a']   // compiles, works at runtime",
                "// o.#b  // error: private field"
              ],
              "note": "brackets bypass private, never #"
            },
            {
              "type": "heading",
              "text": "2. Abstract, this, shape",
              "ink": "orange"
            },
            {
              "type": "table",
              "headers": [
                "Mistake",
                "Result",
                "Fix"
              ],
              "rows": [
                [
                  "`new` on abstract class",
                  "compile error",
                  "`new` a concrete subclass"
                ],
                [
                  "Abstract member not implemented",
                  "compile error",
                  "implement it, or mark subclass `abstract`"
                ],
                [
                  "`onClick={obj.method}`",
                  "`this` lost",
                  "arrow property or `.bind`"
                ],
                [
                  "Same shape, different classes",
                  "interchangeable",
                  "add a `private` member"
                ]
              ]
            },
            {
              "type": "bullets",
              "items": [
                "An ==arrow property== captures `this` per instance",
                "Or bind at the call site: `obj.method.bind(obj)`"
              ],
              "style": "dot"
            },
            {
              "type": "code",
              "lang": "typescript",
              "lines": [
                "class Btn {",
                "  n = 0",
                "  inc = () => { this.n++ }",
                "}"
              ],
              "note": "safe as onClick={btn.inc}"
            },
            {
              "type": "heading",
              "text": "3. Remember",
              "ink": "purple"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Compile time only",
              "text": "Only ==#x== is private at runtime. `readonly` is shallow. A `private` member makes a class **nominal-like**."
            }
          ]
        }
      ]
    },
    {
      "title": "Cheat Sheet: Class Modifiers",
      "role": "outline",
      "outlineIndex": 5,
      "pages": [
        {
          "title": "Cheat Sheet: Class Modifiers",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Visibility, readonly, parameter properties",
              "ink": "green"
            },
            {
              "type": "table",
              "headers": [
                "Modifier",
                "Access",
                "Runtime"
              ],
              "rows": [
                [
                  "`public`",
                  "anywhere",
                  "erased"
                ],
                [
                  "`protected`",
                  "class + subclasses",
                  "erased"
                ],
                [
                  "`private`",
                  "class only",
                  "erased"
                ],
                [
                  "`#x`",
                  "class only",
                  "{green:enforced}"
                ]
              ],
              "highlightRow": 3
            },
            {
              "type": "bullets",
              "items": [
                "==readonly==: set in declaration or constructor only",
                "It is **shallow**: `readonly a: string[]` still allows `push`",
                "A modifier on a constructor parameter makes it a ==field=="
              ],
              "style": "dot"
            },
            {
              "type": "code",
              "lang": "typescript",
              "lines": [
                "constructor(private readonly x: T) {}"
              ],
              "note": "declares and assigns the field; a plain param stays local"
            },
            {
              "type": "heading",
              "text": "2. abstract, implements, extends",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "`abstract class`: no `new`; abstract members need no body",
                "Concrete subclasses must implement them all"
              ],
              "style": "check"
            },
            {
              "type": "table",
              "headers": [
                "",
                "implements I, J",
                "extends B"
              ],
              "rows": [
                [
                  "Gives",
                  "shape check only",
                  "inherited code"
                ],
                [
                  "How many",
                  "many allowed",
                  "one only"
                ]
              ]
            },
            {
              "type": "heading",
              "text": "3. static and structural typing",
              "ink": "purple"
            },
            {
              "type": "bullets",
              "items": [
                "`static` lives on the class: `ClassName.member`, inherited by subclasses",
                "==Same shape== means assignable (structural typing)",
                "A `private` or `protected` member makes the type ==nominal-like=="
              ],
              "style": "dot"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "private is not secret",
              "text": "TS `private` is erased at runtime. Use ==#x== for real privacy."
            }
          ]
        }
      ]
    },
    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "What does this print, or does it fail to compile?",
              "a_bullets": [
                "Compiles and prints ==1==.",
                "Bracket access skips the `private` check, and `private` is erased in JS.",
                "Use `#n` for real privacy."
              ],
              "example_code": [
                "class Box { private n = 1 }",
                "console.log(new Box()['n'])"
              ]
            },
            {
              "type": "qa",
              "q": "Which of the two lines below errors?",
              "a_bullets": [
                "Only `c.items = []` errors, because it assigns to a `readonly` property.",
                "`push` is fine, because `readonly` is shallow."
              ],
              "example_code": [
                "class Cart { constructor(readonly items: string[]) {} }",
                "const c = new Cart([])",
                "c.items.push('a')",
                "c.items = []"
              ]
            },
            {
              "type": "qa",
              "q": "Why does the last line fail, when two plain classes with the same shape would be interchangeable?",
              "a_bullets": [
                "A `private` member makes the class nominal-like.",
                "`B` is not `A` or a subclass of it, so it is not assignable."
              ],
              "example_code": [
                "class A { private v = 1 }",
                "class B { private v = 1 }",
                "const a: A = new B()"
              ]
            }
          ]
        }
      ]
    }
