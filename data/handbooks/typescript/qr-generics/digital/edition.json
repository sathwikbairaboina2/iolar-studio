    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "`function len<T>(x: T) { return x.length }` fails to compile. Why, and what is the fix?",
              "a_bullets": [
                "A bare `T` could be anything, so the compiler knows no properties on it",
                "Constrain it: `<T extends { length: number }>`"
              ]
            },
            {
              "type": "qa",
              "q": "Given `get<T, K extends keyof T>(o: T, k: K): T[K]`, what is the type of `get({a: 1, b: 'x'}, 'b')`? What about `get({a: 1}, 'c')`?",
              "a_bullets": [
                "`string`, because `K` is inferred as `'b'` and `T['b']` is `string`",
                "The second call is a compile error: `'c'` is not in `keyof T`"
              ]
            },
            {
              "type": "qa",
              "q": "`function f<T extends string>(): T { return 'a' }` errors. Why?",
              "a_bullets": [
                "The caller may choose `T = 'b'`, and `'a'` is not assignable to `'b'`",
                "`T` is the caller's type, so you cannot return a concrete value for it"
              ]
            }
          ]
        }
      ]
    }
