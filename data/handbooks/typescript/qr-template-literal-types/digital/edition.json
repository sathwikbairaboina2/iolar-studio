    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "A mapped type over `keyof T` uses `Capitalize<K>` in its key template. Why does it error, and what is the fix?",
              "a_bullets": [
                "`Capitalize<K>` needs `K extends string`, but `keyof T` may be `string | number | symbol`.",
                "Fix: `Capitalize<K & string>`. Writing `${K}` directly fails too: `symbol` is not assignable there."
              ],
              "example_code": [
                "type Getters<T> = {",
                " [K in keyof T as `get${Capitalize<K>}`]: () => T[K]",
                "}"
              ]
            },
            {
              "type": "qa",
              "q": "Given `type A<T> = T extends any ? T[] : never`, what is `A<string | number>`?",
              "a_bullets": [
                "`string[] | number[]`",
                "T is naked, so the conditional distributes over each union member."
              ],
              "example_code": [
                "type R = A<string | number>"
              ]
            },
            {
              "type": "qa",
              "q": "Now `type B<T> = [T] extends [any] ? T[] : never`. What is `B<string | number>`?",
              "a_bullets": [
                "`(string | number)[]`",
                "Wrapping T in a tuple turns distribution off, so the union is checked as one type."
              ]
            }
          ]
        }
      ]
    }
  ]
