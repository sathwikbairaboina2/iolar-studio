  "sections": [
    {
      "title": "tsconfig Mental Model",
      "role": "outline",
      "outlineIndex": 0,
      "pages": [
        {
          "title": "tsconfig Mental Model",
          "blocks": [
            {
              "type": "heading",
              "text": "1. What it does",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "`tsconfig.json` says ==what== to compile (`include`, `exclude`, `files`) and ==how== (`compilerOptions`)",
                "Bare `tsc` finds it by walking ==up== from the current directory",
                "Checking and emitting are separate jobs",
                "`noEmit: true` = ==check only==; Vite, esbuild or SWC emit the JS"
              ],
              "style": "dot",
              "ink": "green"
            },
            {
              "type": "heading",
              "text": "2. Option groups and erasure",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "Group",
                "Options",
                "Decides"
              ],
              "rows": [
                [
                  "{red:Strictness}",
                  "`strict`",
                  "what errors"
                ],
                [
                  "{blue:Output}",
                  "`target`, `module`, `outDir`",
                  "emitted JS"
                ],
                [
                  "{green:Resolution}",
                  "`moduleResolution`, `paths`, `types`",
                  "how imports are found"
                ]
              ]
            },
            {
              "type": "bullets",
              "items": [
                "Types are ==erased== at compile time",
                "tsc only **checks and strips**: no runtime checks, no behaviour change"
              ],
              "style": "check"
            },
            {
              "type": "heading",
              "text": "3. extends",
              "ink": "purple"
            },
            {
              "type": "code",
              "lang": "json",
              "lines": [
                "{",
                "  \"extends\": \"@tsconfig/node20/tsconfig.json\",",
                "  \"compilerOptions\": { \"noEmit\": true },",
                "  \"include\": [\"src\"]",
                "}"
              ],
              "note": "inherit a base, then override"
            },
            {
              "type": "table",
              "headers": [
                "Part",
                "Child vs base"
              ],
              "rows": [
                [
                  "`compilerOptions`",
                  "child overrides per key"
                ],
                [
                  "`include`/`exclude`/`files`",
                  "==replaced==, not merged"
                ],
                [
                  "`paths`",
                  "relative to the config that defines them"
                ]
              ]
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Not merged",
              "text": "Setting `include` in the child silently drops the base's `include`."
            }
          ]
        }
      ]
    },
    {
      "title": "Strict Flags",
      "role": "outline",
      "outlineIndex": 1,
      "pages": [
        {
          "title": "Strict Flags",
          "blocks": [
            {
              "type": "heading",
              "text": "1. strict and the Core Flags",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "`strict: true` turns on the ==whole strict family==; set it on every new project",
                "Opt out of single flags only if needed",
                "`strictNullChecks`: `null`/`undefined` not assignable; narrow `string | undefined` first",
                "It catches the ==most bugs==",
                "`noImplicitAny`: no inferable type is an {red:error}, not silent `any`"
              ],
              "style": "check",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "heading",
              "text": "2. Rest of the Family",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "Flag",
                "Effect"
              ],
              "rows": [
                [
                  "`strictFunctionTypes`",
                  "params contravariant for function props; method syntax stays bivariant"
                ],
                [
                  "`strictBindCallApply`",
                  "`bind`/`call`/`apply` are type-checked"
                ],
                [
                  "`strictPropertyInitialization`",
                  "fields set in constructor or `!`; needs strictNullChecks"
                ],
                [
                  "`useUnknownInCatchVariables`",
                  "`catch (e)` is `unknown`"
                ],
                [
                  "`alwaysStrict`",
                  "emits `\"use strict\"`"
                ]
              ]
            },
            {
              "type": "bullets",
              "items": [
                "Narrow `e` with ==instanceof Error== before reading `e.message`"
              ],
              "style": "dot"
            },
            {
              "type": "code",
              "lang": "typescript",
              "lines": [
                "try { risky(); }",
                "catch (e) {",
                "  if (e instanceof Error) log(e.message);",
                "}"
              ]
            },
            {
              "type": "heading",
              "text": "3. NOT in strict",
              "ink": "red"
            },
            {
              "type": "table",
              "headers": [
                "Enable separately",
                "Effect"
              ],
              "rows": [
                [
                  "`noUncheckedIndexedAccess`",
                  "`arr[i]`, `record[key]` become `T | undefined`"
                ],
                [
                  "`exactOptionalPropertyTypes`",
                  "`x?: number` rejects explicit `undefined`"
                ],
                [
                  "`noImplicitOverride`",
                  "overrides need `override`"
                ],
                [
                  "`noImplicitReturns`",
                  "every path must return"
                ],
                [
                  "`noFallthroughCasesInSwitch`",
                  "no case fall-through"
                ]
              ],
              "highlightRow": 0
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Remember",
              "text": "`strict` does ==not== include `noUncheckedIndexedAccess`. Narrow instead of using `!`."
            }
          ]
        }
      ]
    },
    {
      "title": "target, module and moduleResolution",
      "role": "outline",
      "outlineIndex": 2,
      "pages": [
        {
          "title": "target, module and moduleResolution",
          "blocks": [
            {
              "type": "heading",
              "text": "1. target and lib",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "`target` = ==JS syntax level== of the output (ES2022, ESNext)",
                "Syntax the target supports is kept as-is; newer syntax is {orange:downleveled}",
                "No polyfills added; `lib` controls the typings",
                "`lib` = built-in typings, e.g. `[\"ES2023\", \"DOM\"]`",
                "`lib` defaults from `target`: `.at()` types missing → {red:property does not exist}"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "heading",
              "text": "2. module and moduleResolution",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "`module` = emitted format: ==CommonJS==, ==ESNext== or ==NodeNext==",
                "NodeNext decides **per file**: package.json `\"type\"`, `.mts` / `.cts`",
                "`moduleResolution` maps an import string to a file"
              ],
              "style": "dot"
            },
            {
              "type": "table",
              "headers": [
                "moduleResolution",
                "Relative imports",
                "package.json exports"
              ],
              "rows": [
                [
                  "`node10` (legacy)",
                  "extensionless",
                  "{red:ignored}"
                ],
                [
                  "`node16` / `nodenext`",
                  "need `.js` in ESM files",
                  "{green:honoured}"
                ],
                [
                  "`bundler` (Vite, webpack, esbuild)",
                  "extensionless OK",
                  "{green:honoured}"
                ]
              ],
              "frame": "dashed"
            },
            {
              "type": "heading",
              "text": "3. Pairing rules",
              "ink": "purple"
            },
            {
              "type": "table",
              "headers": [
                "Setup",
                "module",
                "moduleResolution"
              ],
              "rows": [
                [
                  "Node app or library",
                  "`NodeNext`",
                  "follows automatically"
                ],
                [
                  "Bundled app",
                  "`ESNext`",
                  "`bundler`"
                ]
              ]
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Never mix",
              "text": "Never use `bundler` when **tsc output runs directly in Node**."
            }
          ]
        }
      ]
    },
    {
      "title": "paths, baseUrl and Resolution Gotchas",
      "role": "outline",
      "outlineIndex": 3,
      "pages": [
        {
          "title": "paths, baseUrl and Resolution Gotchas",
          "blocks": [
            {
              "type": "heading",
              "text": "1. What paths Does",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "`paths` = a ==type-only alias map==",
                "Works without `baseUrl` since ==TS 4.1==",
                "Relative targets resolve from the **tsconfig file**"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "code",
              "lang": "json",
              "lines": [
                "{ \"compilerOptions\": {",
                "  \"paths\": { \"@/*\": [\"./src/*\"] }",
                "} }"
              ]
            },
            {
              "type": "heading",
              "text": "2. The Runtime Needs the Alias Too",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "`tsc` ==never rewrites== specifiers in emitted JS",
                "Bundler or runtime must know the same alias"
              ],
              "style": "dot"
            },
            {
              "type": "table",
              "headers": [
                "Where",
                "Fix"
              ],
              "rows": [
                [
                  "Vite",
                  "`resolve.alias` or `vite-tsconfig-paths`"
                ],
                [
                  "Node",
                  "subpath imports (`#src/*`)"
                ],
                [
                  "tsc output",
                  "`tsc-alias`"
                ]
              ]
            },
            {
              "type": "heading",
              "text": "3. Resolution Gotchas",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "Editor happy, build says {red:Cannot find module}: bundler alias never set",
                "node16/nodenext: `import './util.js'` finds `util.ts` (TS resolves the **output name**)",
                "ESM relative import without extension: ==TS2835=="
              ],
              "style": "cross",
              "frame": "dashed",
              "ink": "red"
            },
            {
              "type": "table",
              "headers": [
                "Option",
                "Effect"
              ],
              "rows": [
                [
                  "`types: [\"node\"]`",
                  "only these @types auto-included as globals"
                ],
                [
                  "`typeRoots`",
                  "where @types are searched"
                ],
                [
                  "`skipLibCheck: true`",
                  "skips checking .d.ts; hides dependency errors"
                ]
              ]
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "skipLibCheck",
              "text": "A normal setting, but ==not a fix== for your own types."
            }
          ]
        }
      ]
    },
    {
      "title": "Declaration Files, @types and declare module",
      "role": "outline",
      "outlineIndex": 4,
      "pages": [
        {
          "title": "Declaration Files, @types and declare module",
          "blocks": [
            {
              "type": "heading",
              "text": "1. .d.ts and @types",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "==.d.ts== holds only types, no runtime code",
                "It describes JS that exists elsewhere",
                "`declaration: true` makes tsc emit .d.ts beside the JS",
                "`package.json` ==\"types\"== (or exports `types`) points consumers to it",
                "`npm i -D @types/express` types a JS-only package",
                "Packages that ship their own types need no @types"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "heading",
              "text": "2. declare module",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "Goal",
                "Write in a .d.ts"
              ],
              "rows": [
                [
                  "Silence {red:TS7016}",
                  "`declare module 'untyped-lib';` (all `any`)"
                ],
                [
                  "Type it properly",
                  "`declare module 'untyped-lib' { export function foo(x: string): number; }`"
                ],
                [
                  "Non-code imports",
                  "`declare module '*.svg' { const src: string; export default src; }`"
                ]
              ]
            },
            {
              "type": "heading",
              "text": "3. Augmentation",
              "ink": "purple"
            },
            {
              "type": "code",
              "lang": "typescript",
              "lines": [
                "import type { User } from './user';",
                "declare module 'express-serve-static-core' {",
                "  interface Request { user?: User }",
                "}",
                "declare global {",
                "  var appName: string;",
                "}"
              ],
              "note": "top-level import makes this file a module, so it merges"
            },
            {
              "type": "bullets",
              "items": [
                "No top-level import/export: global ambient, ==replaces== not augments",
                "File must be inside `include` or tsc ignores it"
              ],
              "style": "cross"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "TS7016",
              "text": "Add `@types/x`, or write ==declare module==."
            }
          ]
        }
      ]
    },
    {
      "title": "isolatedModules, verbatimModuleSyntax and Cheat Sheet",
      "role": "outline",
      "outlineIndex": 5,
      "pages": [
        {
          "title": "isolatedModules, verbatimModuleSyntax and Cheat Sheet",
          "blocks": [
            {
              "type": "heading",
              "text": "1. verbatimModuleSyntax",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "`type` modifier = ==erased==; no modifier = ==kept==",
                "`import { User }` of a type is an {red:error}",
                "Implies isolatedModules safety",
                "Replaces `importsNotUsedAsValues`, `preserveValueImports`"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "blue"
            },
            {
              "type": "code",
              "lang": "ts",
              "lines": [
                "import type { User } from './user' // erased",
                "import { type User } from './user' // emitted as import {} from './user'",
                "import { User } from './user' // error if User is a type"
              ]
            },
            {
              "type": "bullets",
              "items": [
                "ESM syntax with `module: CommonJS` is an error",
                "Fix: `module: NodeNext` plus `\"type\": \"module\"` in package.json",
                "Or write `import x = require('x')`"
              ],
              "style": "cross",
              "ink": "red"
            },
            {
              "type": "heading",
              "text": "2. isolatedModules",
              "ink": "purple"
            },
            {
              "type": "bullets",
              "items": [
                "Errors on code a single-file transpiler (esbuild, SWC, Babel) can't compile",
                "Re-export a type with `export type { T }`",
                "`const enum` use is restricted"
              ],
              "style": "dot",
              "ink": "purple"
            },
            {
              "type": "heading",
              "text": "3. Baseline and Error Map",
              "ink": "green"
            },
            {
              "type": "table",
              "headers": [
                "Option",
                "Bundled app",
                "Node package"
              ],
              "rows": [
                [
                  "strict, noUncheckedIndexedAccess",
                  "true",
                  "true"
                ],
                [
                  "target",
                  "ES2022",
                  "ES2022"
                ],
                [
                  "module",
                  "ESNext",
                  "NodeNext"
                ],
                [
                  "moduleResolution",
                  "bundler",
                  "NodeNext"
                ],
                [
                  "verbatimModuleSyntax, skipLibCheck",
                  "true",
                  "true"
                ],
                [
                  "noEmit",
                  "true",
                  "false"
                ]
              ]
            },
            {
              "type": "table",
              "headers": [
                "Error",
                "Fix"
              ],
              "rows": [
                [
                  "TS7016",
                  "add `@types/x` or `declare module`"
                ],
                [
                  "Cannot find module",
                  "check moduleResolution, bundler alias for `paths`"
                ],
                [
                  "TS2835",
                  "add `.js` to relative import"
                ],
                [
                  "possibly undefined",
                  "narrow; don't use `!`"
                ]
              ]
            }
          ]
        }
      ]
    },
    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "Under verbatimModuleSyntax, what does the emitted JS keep for `import { type User } from './user'` versus `import type { User } from './user'`?",
              "a_bullets": [
                "`import { type User }` is emitted as the side-effect import `import {} from './user'`.",
                "`import type` is removed entirely.",
                "Use `import type` when the whole import should vanish."
              ]
            },
            {
              "type": "qa",
              "q": "The editor resolves `@/util` through paths, but the build fails with Cannot find module. Why?",
              "a_bullets": [
                "paths only affects type-checking; tsc does not rewrite specifiers.",
                "Add the same alias to the bundler or runtime, e.g. Vite resolve.alias."
              ]
            },
            {
              "type": "qa",
              "q": "With strict on, does `const s: string = names[0]` error when names is a string[]?",
              "a_bullets": [
                "No: strict does not include noUncheckedIndexedAccess.",
                "Enable it and names[0] becomes string | undefined, so it errors until narrowed."
              ]
            }
          ]
        }
      ]
    }
