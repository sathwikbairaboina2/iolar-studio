    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "`const u = {} as User;` then `console.log(u.name.length)`. What happens at compile time and at runtime?",
              "a_bullets": [
                "It compiles: the assertion silences the missing-property error.",
                "Runtime: `TypeError`, because `u.name` is `undefined`. Assertions check nothing."
              ]
            },
            {
              "type": "qa",
              "q": "Why does `request(cfg.method)` fail, and what is the fix?",
              "a_bullets": [
                "`cfg.method` is widened to `string`, which is not assignable to `'GET' | 'POST'`.",
                "Fix: add `as const` to the object. Asserting `as 'GET'` would work too, but it overrides the checker instead of keeping the literal type."
              ],
              "example_code": [
                "const cfg = { method: 'GET' };",
                "request(cfg.method);"
              ]
            },
            {
              "type": "qa",
              "q": "With `type Colors = Record<string, string | number[]>`, which compiles: `a.red.map(f)` or `b.red.map(f)`?",
              "a_bullets": [
                "Only `b.red.map(f)` compiles.",
                "`a` is annotated, so `a.red` widens to `string | number[]`.",
                "`b` uses `satisfies`, so `b.red` stays `number[]`."
              ],
              "example_code": [
                "const a: Colors = { red: [1, 2, 3] };",
                "const b = { red: [1, 2, 3] } satisfies Colors;"
              ]
            }
          ]
        }
      ]
