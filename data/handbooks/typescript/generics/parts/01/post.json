              "2",
              "return types"
            ],
            [
              "3",
              "contextual signatures"
            ]
          ]
        },
        {
          "type": "bullets",
          "items": [
            "Lower tiers lose whenever candidates conflict.",
            "Order matters: the array is read before the callback.",
            "That is why callback params need no annotation."
          ]
