          "type": "heading",
          "text": "1. Blocking Inference",
          "ink": "blue"
        },
        {
          "type": "code",
          "lang": "ts",
          "lines": [
            "declare function pick<T>(",
            "  items: T[], def: NoInfer<T>): T",
            "pick([1, 2], 'x')  // Error, not widened",
            "// NoInfer, TS 5.4"
          ],
          "runnable": false
        },
