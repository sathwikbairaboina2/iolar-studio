  "sections": [
    {
      "title": "Narrowing Mental Model",
      "role": "outline",
      "outlineIndex": 0,
      "pages": [
        {
          "title": "Narrowing Mental Model",
          "blocks": [
            {
              "type": "heading",
              "text": "1. What narrowing is",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "==Narrowing== refines a union inside a branch, using control-flow analysis of runtime checks",
                "`typeof x === 'string'` narrows primitives",
                "`typeof` gives: 'string' 'number' 'bigint' 'boolean' 'symbol' 'undefined' 'object' 'function'"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "heading",
              "text": "2. Null and falsy traps",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "`typeof null` is 'object', so `typeof x === 'object'` keeps {red:null} until `x !== null`",
                "`if (x)` also drops valid `0`, `''` and `NaN`"
              ],
              "style": "cross",
              "ink": "red"
            },
            {
              "type": "table",
              "headers": [
                "Check",
                "Removes"
              ],
              "rows": [
                [
                  "`if (x)`",
                  "null, undefined, 0, '', NaN"
                ],
                [
                  "`x != null`",
                  "null, undefined only"
                ],
                [
                  "`x !== undefined`",
                  "undefined only"
                ]
              ],
              "highlightRow": 1
            },
            {
              "type": "heading",
              "text": "3. Reassignment and closures",
              "ink": "purple"
            },
            {
              "type": "bullets",
              "items": [
                "A closure made ==before the last assignment== loses narrowing",
                "Assignment narrows to the assigned type: `let x: string | number = 'a'` is a string",
                "Since ==TS 5.4==, closures created after the last assignment keep it"
              ],
              "style": "dot"
            },
            {
              "type": "code",
              "lang": "typescript",
              "lines": [
                "let id: string | undefined = load();",
                "if (id) {",
                "  setTimeout(() => id.length, 0); // error",
                "}",
                "id = undefined;"
              ],
              "note": "id is possibly undefined inside the callback"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Fix",
              "text": "Copy to a `const` before the callback: `const s = id;`"
            }
          ]
        }
      ]
    },
    {
      "title": "Built-in Narrowing Operators",
      "role": "outline",
      "outlineIndex": 1,
      "pages": [
        {
          "title": "Built-in Narrowing Operators",
          "blocks": [
            {
              "type": "heading",
              "text": "1. instanceof",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "==instanceof== checks the **prototype chain**, narrows to the class type",
                "`if (e instanceof Error) { e.message }`"
              ],
              "style": "dot",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "Interfaces and type aliases are erased, so no `instanceof`",
                "Fails across realms (iframes): each has its own `Error`"
              ],
              "style": "cross",
              "ink": "red"
            },
            {
              "type": "heading",
              "text": "2. in and equality",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "`'swim' in pet` keeps union members that have (or may have) `swim`",
                "`if ('swim' in pet) pet.swim()`"
              ],
              "style": "dot",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "Check",
                "Narrows to"
              ],
              "rows": [
                [
                  "`a === b`, `a !== b`",
                  "the type both share"
                ],
                [
                  "`x == null`",
                  "drops {green:null} and {green:undefined} together"
                ],
                [
                  "`'key' in obj`",
                  "members with the property"
                ]
              ]
            },
            {
              "type": "heading",
              "text": "3. Array.isArray",
              "ink": "purple"
            },
            {
              "type": "table",
              "headers": [
                "Input type",
                "True branch"
              ],
              "rows": [
                [
                  "`string | string[]`",
                  "`string[]`"
                ],
                [
                  "`unknown`",
                  "`any[]`"
                ],
                [
                  "`T | T[]`",
                  "`T[]`"
                ]
              ]
            },
            {
              "type": "code",
              "lang": "typescript",
              "lines": [
                "const list = Array.isArray(x) ? x : [x];"
              ],
              "note": "standard way to split T | T[]"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Remember",
              "text": "`instanceof` needs a **runtime class**. For interfaces, use `in` or a tag field."
            }
          ]
        }
      ]
    },
    {
      "title": "Discriminated Unions",
      "role": "outline",
      "outlineIndex": 2,
      "pages": [
        {
          "title": "Discriminated Unions",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Shape of a Union",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "Members share one ==tag== field with a **literal** type",
                "Each member has its own tag value"
              ],
              "style": "dot",
              "ink": "green"
            },
            {
              "type": "code",
              "lang": "ts",
              "lines": [
                "type Shape =",
                "  | { kind: 'circle'; r: number }",
                "  | { kind: 'square'; side: number };",
                "if (s.kind === 'circle') s.r;",
                "else s.side;"
              ],
              "note": "s: Shape; each branch sees one member"
            },
            {
              "type": "heading",
              "text": "2. Narrowing and the Literal Rule",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "`switch (s.kind)` or `if` narrows to ==exactly one member==",
                "Tag can be a string, number, boolean, null or undefined literal",
                "Plain `string` tag: {red:narrowing fails}"
              ],
              "style": "check",
              "ink": "blue"
            },
            {
              "type": "heading",
              "text": "3. Tagged vs Optional Fields",
              "ink": "purple"
            },
            {
              "type": "table",
              "headers": [
                "",
                "Optional fields",
                "Tagged union"
              ],
              "rows": [
                [
                  "Type",
                  "`{ ok?; data?; error? }`",
                  "one member per state"
                ],
                [
                  "Illegal state",
                  "ok with error, or neither",
                  "{green:unrepresentable}"
                ]
              ],
              "highlightRow": 1
            },
            {
              "type": "heading",
              "text": "4. Result Pattern",
              "ink": "orange"
            },
            {
              "type": "code",
              "lang": "ts",
              "lines": [
                "type Result<T> =",
                "  | { ok: true; value: T }",
                "  | { ok: false; error: Error };",
                "if (r.ok) r.value; else r.error;"
              ],
              "note": "if (r.ok) narrows r"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Remember",
              "text": "Tag must be a ==literal==, else no narrowing."
            }
          ]
        }
      ]
    },
    {
      "title": "Exhaustiveness with never",
      "role": "outline",
      "outlineIndex": 3,
      "pages": [
        {
          "title": "Exhaustiveness with never",
          "blocks": [
            {
              "type": "heading",
              "text": "1. The never leftover",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "Each `case` removes one member from the union",
                "When all are handled, `default` sees ==never==",
                "Nothing can reach it, so `s` has no valid value"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "heading",
              "text": "2. Enforcing it",
              "ink": "blue"
            },
            {
              "type": "code",
              "lang": "typescript",
              "lines": [
                "function assertNever(x: never): never {",
                "  throw new Error('Unexpected: ' + x)",
                "}",
                "switch (s.kind) {",
                "  case 'circle': return 'c'",
                "  case 'square': return 'q'",
                "  default: return assertNever(s)",
                "}"
              ],
              "note": "default passes the leftover to a never parameter"
            },
            {
              "type": "diagram",
              "kind": "chain",
              "spec": {
                "title": "Add a triangle member",
                "steps": [
                  {
                    "text": "Union grows",
                    "note": "new kind",
                    "ink": "blue"
                  },
                  {
                    "text": "Leftover",
                    "note": "s is Triangle, not never",
                    "ink": "orange"
                  },
                  {
                    "text": "Compile error",
                    "note": "every unhandled switch",
                    "ink": "red"
                  }
                ]
              }
            },
            {
              "type": "table",
              "headers": [
                "",
                "assertNever",
                "Inline check"
              ],
              "rows": [
                [
                  "Default",
                  "`return assertNever(s)`",
                  "`const _exhaustive: never = s;`"
                ],
                [
                  "Runtime",
                  "throws",
                  "nothing"
                ]
              ],
              "frame": "dashed"
            },
            {
              "type": "heading",
              "text": "3. Gotcha",
              "ink": "red"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Compile time only",
              "text": "JSON or API data can carry an unknown `kind` and reach `default`. ==Validate== untrusted input first."
            }
          ]
        }
      ]
    },
    {
      "title": "Custom Guards and Assertion Functions",
      "role": "outline",
      "outlineIndex": 4,
      "pages": [
        {
          "title": "Custom Guards and Assertion Functions",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Type Guards",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "`p is Fish` is a ==type predicate==",
                "True branch narrows to Fish; false branch {green:excludes} Fish",
                "Return type `boolean` alone {red:does not narrow}"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "code",
              "lang": "typescript",
              "lines": [
                "function isFish(p: Fish | Bird): p is Fish {",
                "  return 'swim' in p",
                "}",
                "if (isFish(p)) p.swim()  // Fish",
                "else p.fly()  // Bird"
              ],
              "note": "predicate is the contract"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Body is unchecked",
              "text": "TypeScript trusts the predicate. A guard that returns `true` for everything silently gives ==unsound types==."
            },
            {
              "type": "heading",
              "text": "2. Assertion Functions",
              "ink": "blue"
            },
            {
              "type": "code",
              "lang": "typescript",
              "lines": [
                "function assertIsString(v: unknown): asserts v is string {",
                "  if (typeof v !== 'string') throw new Error()",
                "}",
                "assertIsString(x)",
                "x.toUpperCase()  // x: string"
              ]
            },
            {
              "type": "bullets",
              "items": [
                "`asserts cond` has no type: narrows by condition, e.g. `asserts x != null`"
              ],
              "style": "dot"
            },
            {
              "type": "table",
              "headers": [
                "",
                "Guard",
                "Assertion"
              ],
              "rows": [
                [
                  "Signature",
                  "`p is T`",
                  "`asserts v is T`"
                ],
                [
                  "Failure",
                  "returns false",
                  "**throws**"
                ],
                [
                  "Narrows",
                  "both branches",
                  "rest of scope"
                ]
              ],
              "frame": "dashed"
            },
            {
              "type": "sidebox",
              "title": "Assertion rules",
              "items": [
                "Must {red:throw} on failure",
                "Call via an ==explicitly typed== reference"
              ],
              "ink": "orange"
            }
          ]
        }
      ]
    },
    {
      "title": "Narrowing Cheat Sheet",
      "role": "outline",
      "outlineIndex": 5,
      "pages": [
        {
          "title": "Narrowing Cheat Sheet",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Checks and when to pick them",
              "ink": "green"
            },
            {
              "type": "table",
              "headers": [
                "Check",
                "Narrows",
                "Pick for"
              ],
              "rows": [
                [
                  "`typeof`",
                  "primitives, `function`",
                  "unknown input"
                ],
                [
                  "`instanceof`",
                  "class instances",
                  "class hierarchies"
                ],
                [
                  "`in`",
                  "property presence",
                  "object unions"
                ],
                [
                  "`===` / `== null`",
                  "literals, null",
                  "tags, null checks"
                ]
              ]
            },
            {
              "type": "heading",
              "text": "2. Tag + exhaustiveness",
              "ink": "blue"
            },
            {
              "type": "code",
              "lang": "typescript",
              "lines": [
                "switch (s.kind) {",
                "  case 'circle': return s.r",
                "  case 'square': return s.side",
                "  default: return assertNever(s)",
                "}"
              ],
              "note": "literal tag + switch"
            },
            {
              "type": "bullets",
              "items": [
                "New member: `default` is no longer {red:never}, so the compile fails"
              ],
              "style": "check"
            },
            {
              "type": "heading",
              "text": "3. Guard vs assertion",
              "ink": "purple"
            },
            {
              "type": "table",
              "headers": [
                "Form",
                "Does",
                "Narrows"
              ],
              "rows": [
                [
                  "`x is T`",
                  "returns boolean",
                  "both branches"
                ],
                [
                  "`asserts x is T`",
                  "throws on failure",
                  "rest of scope"
                ]
              ]
            },
            {
              "type": "heading",
              "text": "4. Pitfalls",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "`typeof null` is `'object'`",
                "Truthiness drops `0` and `''`",
                "Interfaces cannot use `instanceof`",
                "Guard bodies are ==unchecked=="
              ],
              "style": "cross"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Compile time only",
              "text": "`assertNever` cannot stop bad JSON at runtime. ==Validate== untrusted data."
            }
          ]
        }
      ]
    },
    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "`x` is `string[] | null`. Why does `if (typeof x === 'object') { x.length }` fail to compile?",
              "a_bullets": [
                "`typeof null` is `'object'`, so `null` stays in the type",
                "Check `x !== null` instead"
              ]
            },
            {
              "type": "qa",
              "q": "`function f(n: number | undefined) { if (n) return n; return 'none' }`. What does `f(0)` return?",
              "a_bullets": [
                "`'none'`: truthiness drops `0`, `''` and `NaN` too",
                "Use `n !== undefined` when falsy values are valid"
              ]
            },
            {
              "type": "qa",
              "q": "`function isFish(p: Fish | Bird): boolean { return 'swim' in p }`. Why does `if (isFish(p)) p.swim()` fail?",
              "a_bullets": [
                "A `boolean` return type does not narrow",
                "Declare the return type as `p is Fish`"
              ],
              "example_code": [
                "function isFish(p: Fish | Bird): p is Fish {",
                "  return 'swim' in p",
                "}"
              ]
            }
          ]
        }
      ]
    }
  ]
}