  "sections": [
    {
      "title": "Typing Parameters and Returns",
      "role": "outline",
      "outlineIndex": 0,
      "pages": [
        {
          "title": "Typing Parameters and Returns",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Annotating parameters",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "Unannotated parameter is implicitly ==any==; under `noImplicitAny` (part of `strict`) that is an {red:error}",
                "Annotate the same way in function, arrow and destructured forms",
                "Destructured parameters: annotate the ==whole object==, not each name"
              ],
              "style": "dot"
            },
            {
              "type": "code",
              "lang": "ts",
              "lines": [
                "function add(a: number, b: number): number { return a + b }",
                "const f = (x: string): number => x.length",
                "function g({ id, name }: { id: number; name: string }) {}"
              ],
              "note": "function, arrow, destructured"
            },
            {
              "type": "heading",
              "text": "2. Return types",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "Return type is ==inferred== from the body",
                "Annotate it on **exported or public** functions",
                "It locks the contract and catches accidental changes"
              ],
              "style": "check"
            },
            {
              "type": "heading",
              "text": "3. never",
              "ink": "purple"
            },
            {
              "type": "bullets",
              "items": [
                "A function that throws or loops forever never returns normally",
                "Its return type is ==never==, not `void`"
              ],
              "style": "dot"
            },
            {
              "type": "code",
              "lang": "ts",
              "lines": [
                "function fail(msg: string): never {",
                "  throw new Error(msg)",
                "}"
              ]
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Rename trap",
              "text": "`{ id: number }` does not type `id`. It renames `id` to a variable called `number`. Write `{ id }: { id: number }`."
            }
          ]
        }
      ]
    },
    {
      "title": "Optional, Default and Rest Parameters",
      "role": "outline",
      "outlineIndex": 1,
      "pages": [
        {
          "title": "Optional, Default and Rest Parameters",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Optional and default",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "`name?: T` makes the type ==T | undefined==",
                "Optional parameters go **after** the required ones",
                "`f(x = 10)` infers `x: number` and is optional for callers",
                "The default applies **only** when the argument is ==undefined=="
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "table",
              "headers": [
                "Argument",
                "Default used?"
              ],
              "rows": [
                [
                  "`undefined` (or omitted)",
                  "{green:yes}"
                ],
                [
                  "`null`",
                  "{red:no}, stays null"
                ],
                [
                  "`0`",
                  "{red:no}, stays 0"
                ],
                [
                  "`\"\"` (empty string)",
                  "{red:no}, stays empty"
                ]
              ],
              "highlightRow": 0
            },
            {
              "type": "heading",
              "text": "2. Rest and tuples",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "`...nums: number[]` collects the extra arguments",
                "Rest must be ==last== and an **array or tuple** type",
                "Type the rest as a ==tuple== to fix the call shape"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "blue"
            },
            {
              "type": "code",
              "lang": "typescript",
              "lines": [
                "function sum(...nums: number[]) {}",
                "function f(...args: [string, number]) {}",
                "f(\"a\", 1); // ok",
                "f(\"a\");     // error: expected 2 arguments"
              ]
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Order",
              "text": "{green:required} first, then {orange:optional or default}, then {blue:rest} last. A required parameter after an optional one is an **error**."
            }
          ]
        }
      ]
    },
    {
      "title": "Function Types and Call Signatures",
      "role": "outline",
      "outlineIndex": 2,
      "pages": [
        {
          "title": "Function Types and Call Signatures",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Describing Callables",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "`type Fn = (a: number, b: number) => number`",
                "Parameter ==names are documentation== only; they need not match",
                "{green:Call signature} adds properties: `{ description: string; (x: number): string }`",
                "{purple:Construct signature}: `type Ctor = new (x: string) => Foo`, used with `new`"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "blue"
            },
            {
              "type": "heading",
              "text": "2. Assignability",
              "ink": "purple"
            },
            {
              "type": "bullets",
              "items": [
                "`strictFunctionTypes` ==on==: parameters are checked **contravariantly**",
                "Off: parameters are bivariant, which is unsound",
                "A `Dog` handler is not assignable to an `Animal` handler",
                "{green:Fewer parameters} is assignable to a type with more"
              ],
              "style": "check",
              "ink": "purple"
            },
            {
              "type": "code",
              "lang": "typescript",
              "lines": [
                "type Cb = (x: number, i: number) => void;",
                "const ok: Cb = x => {};",
                "const bad: Cb = (x, i, z) => {}; // error"
              ],
              "note": "callbacks may ignore extra arguments"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Remember",
              "text": "A callback may use ==fewer== arguments than it receives, never more."
            }
          ]
        }
      ]
    },
    {
      "title": "Overloads and this Parameters",
      "role": "outline",
      "outlineIndex": 3,
      "pages": [
        {
          "title": "Overloads and this Parameters",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Overload Signatures",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "Write several ==signatures with no body==, then **one implementation**",
                "The implementation signature is {red:hidden from callers}",
                "Only the overload signatures are callable"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "code",
              "lang": "typescript",
              "lines": [
                "function f(x: string): string;",
                "function f(x: number): number;",
                "function f(x: any) { return x }",
                "f('a'); // string",
                "f(true); // error: no overload matches"
              ],
              "note": "any in the implementation does not leak out"
            },
            {
              "type": "heading",
              "text": "2. Order and When to Skip",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "{green:Most specific first}: the ==first matching== signature wins",
                "A broad `any` placed first swallows every call",
                "Same return type for every argument type? Use a ==union== or a **generic** instead"
              ],
              "style": "check",
              "ink": "blue"
            },
            {
              "type": "code",
              "lang": "typescript",
              "lines": [
                "function g(x: any): any;",
                "function g(x: string): string; // unreachable",
                "function g(x: any) { return x }",
                "g('a'); // any, never string"
              ],
              "note": "bad order: the any overload always matches"
            },
            {
              "type": "heading",
              "text": "3. this Parameter",
              "ink": "purple"
            },
            {
              "type": "bullets",
              "items": [
                "A ==fake first parameter== named `this`, erased at compile time",
                "`function f(this: HTMLElement, e: Event)`",
                "Not counted as an argument",
                "Calling it with the wrong `this` is a {red:compile error}"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "purple"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Remember",
              "text": "Callers see only the overloads. Put ==specific== signatures first and `any` last."
            }
          ]
        }
      ]
    },
    {
      "title": "void vs undefined",
      "role": "outline",
      "outlineIndex": 4,
      "pages": [
        {
          "title": "void vs undefined",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Meaning",
              "ink": "green"
            },
            {
              "type": "table",
              "headers": [
                "",
                "void",
                "undefined"
              ],
              "rows": [
                [
                  "Means",
                  "result ==ignored==",
                  "really returns `undefined`"
                ],
                [
                  "As `() => X`",
                  "accepts ==any== function",
                  "may omit `return` since TS 5.1 (needed `return undefined` before)"
                ]
              ]
            },
            {
              "type": "heading",
              "text": "2. The callback escape",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "`() => void` type: a returned value is ==discarded==",
                "`: void` on a declaration: **cannot** return a value",
                "Escape applies only to function type assignment"
              ],
              "style": "dot"
            },
            {
              "type": "code",
              "lang": "typescript",
              "lines": [
                "const f: () => void = () => 42; // ok",
                "function g(): void { return 42; } // error",
                "const h: () => undefined = () => undefined;"
              ]
            },
            {
              "type": "heading",
              "text": "3. Mistakes",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "`string | void` in a union: use `string | undefined`"
              ],
              "style": "cross"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Callbacks use void",
              "text": "`forEach` takes a `void` callback, so `x => arr.push(x)` (returns a number) still type checks."
            },
            {
              "type": "sidebox",
              "title": "Interview Point",
              "items": [
                "**void vs undefined?** Ignored result vs a real `undefined`.",
                "**Is `() => 42` a `() => void`?** Yes, the result is discarded.",
                "**Why not `string | void`?** Use `string | undefined`."
              ],
              "ink": "orange"
            }
          ]
        }
      ]
    },
    {
      "title": "TypeScript Functions Cheat Sheet",
      "role": "outline",
      "outlineIndex": 5,
      "pages": [
        {
          "title": "TypeScript Functions Cheat Sheet",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Parameters and Overloads",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "Order: ==required== first, then `x?: T` or `x = v`, then `...xs: T[]` last",
                "Default `x = v` fires only on {green:undefined}, not null",
                "Overloads: signatures with ==no body==, then one implementation",
                "Callers cannot see the implementation signature",
                "List the ==most specific== overload first"
              ],
              "style": "dot",
              "ink": "green"
            },
            {
              "type": "heading",
              "text": "2. Callable Types",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "Form",
                "Type"
              ],
              "rows": [
                [
                  "Plain function",
                  "`(a: A) => R`"
                ],
                [
                  "Callable with props",
                  "`{ (a: A): R; prop: P }`"
                ],
                [
                  "Constructor",
                  "`new (a: A) => R`"
                ]
              ]
            },
            {
              "type": "heading",
              "text": "3. this, void, never",
              "ink": "purple"
            },
            {
              "type": "bullets",
              "items": [
                "`function f(this: T, ...)`: ==compile time only==, not an argument"
              ],
              "style": "dot"
            },
            {
              "type": "table",
              "headers": [
                "Type",
                "Use for"
              ],
              "rows": [
                [
                  "`void`",
                  "result is ignored"
                ],
                [
                  "`undefined`",
                  "a real undefined value"
                ],
                [
                  "`never`",
                  "function never returns"
                ]
              ]
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Common mistakes",
              "text": "Implicit **any** params; **null** expecting a default; wrong overload order; **void** in a union; required param after optional."
            }
          ]
        }
      ]
    },
    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "What does this log?",
              "a_bullets": [
                "`guest`, then an empty line",
                "Only ==undefined== triggers a default; `\"\"` does not"
              ],
              "example_code": [
                "function greet(name = \"guest\") { return name }",
                "console.log(greet(undefined))",
                "console.log(greet(\"\"))"
              ]
            },
            {
              "type": "qa",
              "q": "What is the type of f(\"hi\"), and what is the bug?",
              "a_bullets": [
                "`string`: `f(x: unknown)` is listed first, so it matches first",
                "Wrong order: put `f(x: string)` first to get `number`"
              ],
              "example_code": [
                "function f(x: unknown): string;",
                "function f(x: string): number;",
                "function f(x: any) { return x }"
              ]
            },
            {
              "type": "qa",
              "q": "Which line is a compile error?",
              "a_bullets": [
                "Line b: `function b(): void { return 42 }` errors",
                "a is fine: assigning to a `() => void` type discards the result"
              ],
              "example_code": [
                "const a: () => void = () => 42",
                "function b(): void { return 42 }"
              ]
            }
          ]
        }
      ]
    }
