    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "A button inside a boundary-wrapped component has onClick={() => { throw new Error('x') }}. Does the fallback show?",
              "a_bullets": [
                "No. Boundaries miss event handler errors.",
                "Use try/catch, or call showBoundary(err) from useErrorBoundary()."
              ]
            },
            {
              "type": "qa",
              "q": "A component fetches in useEffect inside <Suspense fallback={<Spinner />}>. Does the spinner show while loading?",
              "a_bullets": [
                "No. useEffect fetching never suspends.",
                "The component renders immediately with empty state. Use use(promise) or a Suspense-enabled data source."
              ]
            },
            {
              "type": "qa",
              "q": "A lazy() chunk fails to load because the user is offline. Which wrapper handles it, and which goes outside?",
              "a_bullets": [
                "The error boundary, since the import rejects. Suspense only covers pending.",
                "ErrorBoundary outside, Suspense inside, with a Retry that reloads the page."
              ]
            }
          ]
        }
