                "Skeleton"
              ],
              "rows": [
                [
                  "Layout shift",
                  "**more**",
                  "**less**, matches final layout"
                ],
                [
                  "Fast loads",
                  "delay ==~200ms== to avoid flicker",
                  "preferred default"
                ]
              ]
            },
            {
              "type": "heading",
              "text": "4. Mistakes",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "One global boundary only: a widget error blanks the whole page",
                "Suspense fallback bigger or different from the content"
              ],
              "style": "cross"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Isolate and recover",
