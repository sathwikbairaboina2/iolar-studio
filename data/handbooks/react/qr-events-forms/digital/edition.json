    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "A component renders `<form action={save}>` and calls `useFormStatus()` itself to disable its button. Why is `pending` always false?",
              "a_bullets": [
                "`useFormStatus` reads the status of an {blue:ancestor} form.",
                "The component that renders the form has no ancestor form, so it always sees `pending` as false.",
                "Fix: put the button in a child component rendered inside the form."
              ]
            },
            {
              "type": "qa",
              "q": "You render `<input value={name} />` with no `onChange`. What happens when you type?",
              "a_bullets": [
                "Nothing changes: the field is read-only and React warns.",
                "Fix: add `onChange` that calls `setName`, or use `defaultValue`."
              ]
            },
            {
              "type": "qa",
              "q": "A Cancel `<button>` with no `type` sits inside a form that has `onSubmit`. What does clicking it do?",
              "a_bullets": [
                "It submits the form, because buttons default to `type=\"submit\"`.",
                "Fix: write `type=\"button\"`."
              ]
            }
          ]
        }
      ]
    }
