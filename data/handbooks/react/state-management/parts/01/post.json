          "type": "callout",
          "style": "sticky",
          "title": "Same primitive",
          "text": "`useState` is internally a `useReducer` with `basicStateReducer(s, a) => typeof a === 'function' ? a(s) : a`. No new machinery — only a different __author__ of the transition."
        },
        {
          "type": "heading",
          "text": "2. Example: form with validation",
          "ink": "blue"
        },
        {
          "type": "code",
          "lang": "jsx",
          "lines": [
            "const [email, setEmail] = useState('')",
            "const [pw, setPw] = useState('')",
            "const [errors, setErrors] = useState({})",
            "const [sending, setSending] = useState(0)",
            "const [done, setDone] = useState(false)"
          ],
          "note": "submit handler calls four setters"
        },
        {
          "type": "code",
          "lang": "jsx",
          "lines": [
            "function reducer(s, a) {",
            "  switch (a.type) {",
            "   case 'field_changed': return {",
            "     ...s, [a.name]: a.value,",
            "     errors: validate(s, a) }",
            "   case 'submitted': return {",
            "     ...s, sending: true }",
            "   default: throw Error(a.type) }}"
          ],
          "note": "one place owns every transition"
        },
        {
          "type": "heading",
          "text": "3. Migration path",
          "ink": "orange"
        },
        {
          "type": "diagram",
