          "title": "URL Params and Search Params",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Path Params",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "Route path `'/users/:id'`",
                "`useParams()` returns `{ id }`",
                "Always a ==string==, so use `Number(id)` before comparing"
              ],
              "style": "dot"
            },
            {
              "type": "code",
              "lang": "javascript",
              "lines": [
                "const { id } = useParams(); // \"42\"",
                "const userId = Number(id);",
                "const user = users.find(u => u.id === userId);"
              ]
            },
            {
              "type": "heading",
              "text": "2. Search Params",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "`const [sp, setSp] = useSearchParams()`",
                "`sp.get('q')` returns ==string or null==",
                "`setSp({ q: 'abc' })` updates the URL",
                "They live in the URL: {green:survive refresh} and are shareable"
              ],
              "style": "dot"
            },
            {
              "type": "table",
              "headers": [
                "",
                "Path param",
                "Search param"
              ],
              "rows": [
                [
                  "Use for",
                  "Identify a resource",
                  "Optional state: filter, sort, page"
                ],
                [
                  "Example",
                  "`/users/42`",
                  "`?sort=name&page=2`"
                ]
              ],
              "highlightRow": 0
            },
            {
              "type": "heading",
              "text": "3. Rules and Traps",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "Optional segment: trailing `?`, as in `/:lang?/about`",
                "Parent route params are ==merged== into `useParams` in children"
              ],
              "style": "check"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Replacing drops keys",
              "text": "`setSp({ page: '2' })` replaces the whole object, so `q` and `sort` are lost. Spread `Object.fromEntries(sp)` first."
            }
          ]
        }
      ]
