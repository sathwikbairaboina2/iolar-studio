              "rows": [
                [
                  "`getBy`",
                  "{red:throws}",
                  "sync"
                ],
                [
                  "`queryBy`",
                  "returns ==null==",
                  "sync, use for absence"
                ],
                [
                  "`findBy`",
                  "rejects",
