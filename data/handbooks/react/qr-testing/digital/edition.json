    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "This test fails on the last line even though the app works. What is the bug?",
              "a_bullets": [
                "`user.click(btn)` is async and was not awaited.",
                "The assertion runs before React updates.",
                "Fix: `await user.click(btn)`, then `await screen.findByText('Saved')` if the text appears after async work."
              ],
              "example_code": [
                "const user = userEvent.setup()",
                "render(<Form />)",
                "user.click(screen.getByRole('button', { name: /save/i }))",
                "expect(screen.getByText('Saved')).toBeInTheDocument()"
              ]
            },
            {
              "type": "qa",
              "q": "The spinner correctly disappears, but this assertion throws. Why?",
              "a_bullets": [
                "`getBy` throws when nothing matches, so it never reaches `not`.",
                "Use `queryBy`, which returns null: `expect(screen.queryByText('Loading')).not.toBeInTheDocument()`."
              ],
              "example_code": [
                "expect(screen.getByText('Loading')).not.toBeInTheDocument()"
              ]
            },
            {
              "type": "qa",
              "q": "One test calls `server.use(...)` to return a 500. Later tests also get 500s. What is missing?",
              "a_bullets": [
                "`afterEach(() => server.resetHandlers())`.",
                "Without it the override stays active and leaks into later tests."
              ]
            }
          ]
        }
      ]
    }
