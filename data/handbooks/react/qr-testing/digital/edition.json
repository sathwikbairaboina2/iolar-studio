            },
            {
              "type": "heading",
              "text": "3. Hooks",
              "ink": "purple"
            },
            {
              "type": "code",
              "lang": "javascript",
              "lines": [
                "const { result } = renderHook(",
                "  () => useAuth(), { wrapper: AuthProvider })",
                "act(() => { result.current.login() })"
              ],
              "note": "wrapper supplies providers"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Remember",
              "text": "Wrap state changes in ==act==, then read `result.current`. Never put clicks inside `waitFor`."
            }
          ]
        }
      ]
