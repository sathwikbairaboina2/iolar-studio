      "pages": [
        {
          "title": "Cheat Sheet: Testing Library Essentials",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Setup and Queries",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "`environment: 'jsdom'` and `globals: true` in `test`",
                "`setupFiles` → `'@testing-library/jest-dom/vitest'`"
              ],
              "style": "check"
            },
            {
              "type": "table",
              "headers": [
                "Need",
                "Query"
              ],
              "rows": [
                [
                  "Element is present",
                  "`getBy`"
                ],
                [
                  "Element is absent",
                  "`queryBy` + `expect(...).not.toBeInTheDocument()`"
                ],
                [
                  "Appears after async work",
                  "`findBy` (await it)"
                ]
              ],
              "highlightRow": 1
            },
            {
              "type": "heading",
              "text": "2. Interaction and MSW",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "`const user = userEvent.setup()` before render",
                "`await user.click(btn)`, `await user.type(input, 'hi')`",
                "`server.use` overrides one test; ==resetHandlers== restores defaults"
              ],
              "style": "dot"
            },
            {
              "type": "code",
              "lang": "javascript",
              "lines": [
                "const server = setupServer(...handlers)",
                "beforeAll(() => server.listen())",
                "afterEach(() => server.resetHandlers())",
                "afterAll(() => server.close())"
              ],
