        {
          "type": "code",
          "lang": "jsx",
          "lines": [
            "function useFetch(url){",
            "  const [s,setS] = useState({})",
            "  useEffect(() => load(url, setS),",
            "    [url])  // load returns abort",
            "  return s  // {data,loading,error}",
            "}"
          ]
        },
