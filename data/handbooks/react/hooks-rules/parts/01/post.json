          "type": "heading",
          "text": "7. AbortController, Preferred"
        },
        {
          "type": "code",
          "lang": "jsx",
          "lines": [
            "useEffect(() => {",
            "  const c = new AbortController()",
            "  fetch(url, { signal: c.signal })",
            "   .then(r=>r.json()).then(setD)",
            "  return () => c.abort()",
            "}, [url])"
          ],
          "note": "abort rejects with AbortError — catch it"
        },
