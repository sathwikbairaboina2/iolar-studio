    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "`count` is 0. What does `{count && <Badge />}` put on the page?",
              "a_bullets": [
                "It renders the number ==0==",
                "`&&` returns the falsy left side, and React prints numbers",
                "Fix: `count > 0 && <Badge />`"
              ]
            },
            {
              "type": "qa",
              "q": "Bug hunt: `items.map(i => <li><Row key={i.id} /></li>)` warns about keys. Why?",
              "a_bullets": [
                "The key is on the inner `Row`, not on the `li` that map returns",
                "Move it: `<li key={i.id}>`"
              ]
            },
            {
              "type": "qa",
              "q": "Rows use `key={index}` and each holds a text input. You delete the first row, A. Whose typed text does the first row now show?",
              "a_bullets": [
                "A's text, now beside B's label: key 0 survives and keeps its state",
                "Use `key={item.id}` so A's state leaves with A"
              ]
            }
          ]
        }
      ]
    }
