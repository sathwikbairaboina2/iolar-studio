    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "You write `const [tags, setTags] = useState([]);` then call `setTags(['a'])`. Does it compile?",
              "a_bullets": [
                "No: the state type is inferred as `never[]`, so `'a'` is rejected.",
                "Fix: `useState<string[]>([])`."
              ]
            },
            {
              "type": "qa",
              "q": "Why does `const Pick = <T>(p: { items: T[] }) => null` fail in a .tsx file?",
              "a_bullets": [
                "The parser reads `<T>` as a JSX tag.",
                "Write `<T,>`, or use a function declaration."
              ]
            },
            {
              "type": "qa",
              "q": "A component has a type error, yet `npm run dev` shows no error. Is the code fine?",
              "a_bullets": [
                "No: Vite only strips types in dev and never checks them.",
                "`npm run build` runs tsc and fails; `tsc -b --noEmit` catches it earlier."
              ]
            }
          ]
        }
      ]
