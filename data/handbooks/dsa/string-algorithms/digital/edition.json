        {
          "title": "KMP and the Prefix Function",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Why KMP",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "==KMP== finds P in T in **O(n+m)**",
                "Text index `i` never moves back",
                "Naive matching: O(n*m) worst case"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "heading",
              "text": "2. Prefix function (LPS)",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "`lps[i]`: longest ==proper== prefix of P[0..i] that is also its suffix",
                "Build in O(m): on mismatch `k=lps[k-1]`, on match `k++`"
              ],
              "style": "dot"
            },
            {
              "type": "table",
              "headers": [
                "P",
                "a",
                "b",
                "a",
                "b",
                "a",
                "c",
                "a"
              ],
              "rows": [
                [
                  "lps",
                  "0",
                  "0",
                  "1",
                  "2",
                  "3",
                  "0",
                  "1"
                ]
              ]
            },
            {
              "type": "code",
              "lang": "python",
              "lines": [
                "def lps_of(p):",
                "    lps = [0] * len(p); k = 0",
                "    for i in range(1, len(p)):",
                "        while k and p[i] != p[k]: k = lps[k-1]",
                "        if p[i] == p[k]: k += 1",
                "        lps[i] = k",
                "    return lps"
              ],
              "note": "store lps[i]=k after each step"
            },
            {
              "type": "heading",
              "text": "3. Search and mistakes",
              "ink": "purple"
            },
            {
              "type": "diagram",
