            {
              "type": "heading",
              "text": "1. Overlap, Merge, Insert",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "Overlap: ==a.start <= b.end and b.start <= a.end==",
                "Use `<` when touching endpoints are allowed",
                "Merge: sort by start; if `cur.start <= last.end` then `last.end = max(last.end, cur.end)`",
                "Insert: three phases on sorted input, O(n)"
              ],
              "style": "dot",
              "ink": "blue"
