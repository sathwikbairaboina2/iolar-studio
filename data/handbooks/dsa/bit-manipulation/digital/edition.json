      "pages": [
        {
          "title": "Operators: AND, OR, XOR, NOT and Shifts",
          "blocks": [
            {
              "type": "heading",
              "text": "1. The Bitwise Operators",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "Op",
                "Bit is 1 when",
                "Use",
                "Identities"
              ],
              "rows": [
                [
                  "`&`",
                  "both are 1",
                  "mask, test bits",
                  "x & 0 = 0, x & x = x"
                ],
                [
                  "`|`",
                  "either is 1",
                  "set bits",
                  "x | 0 = x"
                ],
                [
                  "`^`",
                  "bits differ",
                  "toggle, cancel",
                  "x ^ x = 0, x ^ 0 = x"
                ]
              ],
              "highlightRow": 2
            },
            {
              "type": "bullets",
              "items": [
                "==XOR== is commutative and associative: order never matters",
                "`3 ^ 5` = `011 ^ 101` = `110` = 6"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "blue"
            },
            {
              "type": "heading",
              "text": "2. NOT",
              "ink": "purple"
            },
            {
              "type": "bullets",
              "items": [
                "`~` flips every bit, so ==~x = -x - 1==",
                "Python ints are unbounded: `~` gives negatives",
                "Mask with `& 0xFF` to keep 8 bits"
              ],
              "style": "dot"
            },
            {
              "type": "code",
              "lang": "python",
              "lines": [
                "print(~5, ~5 & 0xFF)"
              ],
              "note": "~5 = -6; the mask keeps the low 8 bits"
            },
            {
              "type": "code",
              "lang": "output",
              "lines": [
                "-6 250"
              ]
            },
            {
              "type": "heading",
              "text": "3. Shifts",
