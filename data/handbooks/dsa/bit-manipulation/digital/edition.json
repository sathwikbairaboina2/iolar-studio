              "type": "table",
              "headers": [
                "Shift",
                "Effect",
                "Fill"
              ],
              "rows": [
                [
                  "`x << k`",
                  "x times 2^k",
                  "zeros on the right"
                ],
                [
                  "`x >> k`",
                  "floor of x / 2^k",
                  "keeps the sign bit"
                ],
                [
                  "`x >>> k` (Java, JS)",
                  "unsigned shift",
                  "fills zeros"
                ]
              ]
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Right shift floors",
              "text": "`-7 >> 1` is ==-4==, not -3: it rounds toward negative infinity."
            }
