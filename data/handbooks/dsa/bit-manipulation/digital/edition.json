      "title": "Bit Manipulation Cheat Sheet",
      "role": "outline",
      "outlineIndex": 5,
      "pages": [
        {
          "title": "Bit Manipulation Cheat Sheet",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Operators and bit i",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "Op",
                "Use"
              ],
              "rows": [
                [
                  "`&`",
                  "==mask== / test"
                ],
                [
                  "`|`",
                  "==set=="
                ],
                [
                  "`^`",
                  "==toggle== / cancel"
                ],
                [
                  "`~`",
                  "flip every bit"
                ],
                [
                  "`<<`",
                  "multiply by 2^k"
                ],
                [
                  "`>>`",
                  "divide by 2^k (floor)"
                ]
              ]
            },
            {
              "type": "table",
              "headers": [
                "Bit i",
                "Expression"
              ],
              "rows": [
                [
                  "Check",
                  "`(x>>i)&1`"
                ],
                [
                  "Set",
                  "`x|(1<<i)`"
                ],
                [
                  "Clear",
                  "`x&~(1<<i)`"
                ],
                [
                  "Toggle",
                  "`x^(1<<i)`"
                ]
              ],
              "highlightRow": 1
            },
            {
              "type": "heading",
              "text": "2. Tricks and XOR",
              "ink": "purple"
            },
            {
              "type": "bullets",
              "items": [
                "`x&(x-1)` ==clears== the lowest set bit",
                "`x&-x` ==isolates== the lowest set bit",
                "`-x = ~x+1` (two's complement)",
                "Power of two: `x>0 && !(x&(x-1))`",
                "`x^x=0`, `x^0=x`: ==fold XOR== over all items for the single number"
              ],
              "style": "check",
              "ink": "purple"
            },
            {
              "type": "code",
              "lang": "python",
              "lines": [
                "def count_bits(x):",
                "    n = 0",
                "    while x:",
                "        x &= x - 1",
                "        n += 1",
                "    return n"
              ],
              "note": "Kernighan: one loop per set bit, O(set bits)"
            },
            {
              "type": "heading",
              "text": "3. Subsets and traps",
              "ink": "orange"
            },
            {
              "type": "bullets",
              "items": [
                "`mask` runs 0 to 2^n - 1",
                "Item i is in the subset if `mask&(1<<i)`"
              ],
              "style": "dot",
              "ink": "orange"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Traps",
              "text": "Write `(x&1)==0`: == binds tighter than &. Use `1L<<i` for 64-bit. In Python, mask negatives: `x & 0xFFFFFFFF`."
            }
          ]
        }
      ]
