          "blocks": [
            {
              "type": "heading",
              "text": "1. Recurrence Shape",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "`T(n) = aT(n/b) + f(n)`",
                "==a== subproblems, each of size ==n/b==",
                "==f(n)== = work to **split and combine**"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "heading",
              "text": "2. Recursion Tree Method",
              "ink": "blue"
            },
            {
              "type": "diagram",
              "kind": "chain",
              "spec": {
                "steps": [
                  {
                    "text": "Draw the tree",
                    "note": "a children per node",
                    "ink": "blue"
                  },
                  {
                    "text": "Work per level",
                    "note": "sum the f(n) costs",
                    "ink": "green"
                  },
                  {
                    "text": "Count levels",
                    "note": "log_b n if balanced",
                    "ink": "purple"
                  },
                  {
                    "text": "Multiply",
                    "note": "work per level × levels",
                    "ink": "orange"
                  }
                ]
              }
            },
            {
              "type": "table",
              "headers": [
                "Recurrence",
                "Work per level",
                "Result"
              ],
              "rows": [
                [
                  "`T(n)=2T(n/2)+n` (merge sort)",
                  "n on each of log n levels",
                  "{green:Theta(n log n)}"
                ],
                [
                  "`T(n)=T(n-1)+1`",
                  "1 per level, n levels",
                  "{green:O(n)}"
                ],
                [
                  "`T(n)=T(n-1)+n`",
                  "n, n-1, ... 1",
                  "{orange:O(n²)}"
                ],
                [
                  "`T(n)=T(n-1)+T(n-2)+1`",
                  "subproblems repeat",
                  "{red:about O(2ⁿ)}"
                ]
              ],
              "highlightRow": 0
            },
            {
              "type": "heading",
              "text": "3. Naive Fibonacci",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "Naive Fibonacci is ==exponential==, about O(2ⁿ)",
                "Same subproblems are **recomputed** many times",
                "==Memoisation== caches each result: O(n)"
              ],
              "style": "cross",
              "frame": "dashed",
              "ink": "red"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Remember",
