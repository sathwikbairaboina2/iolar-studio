          "blocks": [
            {
              "type": "heading",
              "text": "1. Tail Calls and TCO",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "==Tail call==: the recursive call is the **last action**",
                "Nothing left to do after it returns, e.g. `fact(n-1, acc*n)`",
                "==TCO== reuses the frame: O(1) stack space"
              ],
              "style": "dot"
            },
            {
              "type": "table",
              "headers": [
                "Language",
                "TCO?"
              ],
              "rows": [
                [
                  "Scheme",
                  "{green:guaranteed}"
                ],
                [
                  "Some C compilers",
                  "{blue:sometimes}"
                ],
                [
                  "Python, Java",
                  "{red:never}"
                ]
              ]
            },
            {
              "type": "heading",
              "text": "2. Stack Overflow",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "Cause: ==unbounded== or very deep recursion",
                "Fix: add a base case, use a loop, or an explicit stack",
                "Tail recursion to loop: parameters become ==variables==",
                "Avoid deep recursion on a 10⁵ long list"
              ],
              "style": "check"
            },
            {
              "type": "code",
              "lang": "python",
              "lines": [
                "acc = 1",
                "while n > 0:",
                "    acc *= n",
                "    n -= 1"
              ],
              "note": "loop form of fact(n, acc)"
            },
            {
              "type": "heading",
              "text": "3. Cheat Sheet",
              "ink": "purple"
            },
            {
              "type": "table",
              "headers": [
