                  },
                  {
                    "text": "Compute",
                    "sub": "n^(log_b a)",
                    "ink": "blue"
                  },
                  {
                    "text": "Compare",
                    "sub": "with f(n)",
                    "ink": "purple"
                  },
                  {
                    "text": "Pick case",
                    "sub": "1, 2 or 3",
                    "ink": "orange"
                  }
