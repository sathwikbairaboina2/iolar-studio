      "pages": [
        {
          "title": "Master Theorem",
          "blocks": [
            {
              "type": "heading",
              "text": "1. The Setup",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "Solves ==T(n) = aT(n/b) + f(n)== with **a ≥ 1**, **b > 1**",
                "Compare ==f(n)== against the leaf work `n^(log_b a)`"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "Read a, b",
                    "sub": "from the recurrence",
