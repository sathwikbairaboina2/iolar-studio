          "blocks": [
            {
              "type": "heading",
              "text": "1. Knapsack: 0/1 vs Unbounded",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "`dp[i][w] = max(dp[i-1][w], val[i] + dp[i-1][w-wt[i]])`",
                "==O(nW)== time",
                "1D version: loop ==w downward==, so an item is not reused"
              ],
              "style": "dot",
              "ink": "green"
            },
            {
              "type": "table",
              "headers": [
                "Variant",
                "Items",
                "Loop over w"
              ],
              "rows": [
                [
                  "0/1 knapsack",
                  "once",
                  "{red:downward}"
                ],
                [
                  "Unbounded, coin change",
                  "may repeat",
                  "{green:upward}"
                ]
              ]
            },
            {
              "type": "heading",
              "text": "2. Coin Change",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "Min coins: `dp[a] = min(dp[a-c] + 1)`, `dp[0]=0`, rest start at ==infinity==",
                "Unreachable stays infinity, so return ==-1==",
                "Count ways: ==coins outer==, amounts inner gives combinations; swap the loops for permutations"
              ],
              "style": "check",
              "ink": "blue"
            },
            {
              "type": "code",
              "lang": "python",
              "lines": [
                "def fewest(coins, amount):",
                "    dp = [0] + [float('inf')] * amount",
                "    for a in range(1, amount + 1):",
                "        for c in coins:",
                "            if c <= a: dp[a] = min(dp[a], dp[a-c] + 1)",
                "    return -1 if dp[amount] == float('inf') else dp[amount]",
                "print(fewest([1, 3, 4], 6), fewest([5], 3))"
              ],
              "note": "coins {1,3,4}, amount 6 is 3+3"
            },
            {
              "type": "code",
              "lang": "output",
              "lines": [
                "2 -1"
              ]
            },
            {
              "type": "heading",
              "text": "3. Grid Paths",
              "ink": "purple"
            },
            {
              "type": "bullets",
              "items": [
                "`dp[r][c] = dp[r-1][c] + dp[r][c-1]`",
                "First row and column: 1 up to the first obstacle, 0 from it onward",
                "Obstacle cells = 0",
                "==O(mn)== time, one row of space"
              ],
              "style": "dot",
              "ink": "purple"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Direction",
              "text": "An upward loop in 0/1 knapsack reuses an item."
            }
          ]
        }
      ]
