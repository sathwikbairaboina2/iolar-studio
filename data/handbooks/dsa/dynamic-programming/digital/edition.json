                "    res.append(path[:])  # copy",
                "    for i in range(start, len(a)):",
                "        if i > start and a[i] == a[i-1]: continue",
                "        path.append(a[i])  # choose",
                "        go(i + 1)  # recurse",
                "        path.pop()  # un-choose"
              ],
