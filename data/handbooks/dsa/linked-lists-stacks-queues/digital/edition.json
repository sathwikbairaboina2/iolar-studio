            {
              "type": "heading",
              "text": "1. The Idea",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "Stack kept in ==sorted order==, increasing or decreasing",
                "Per element: ==pop while the top violates the order==, then push",
                "Decreasing stack of indices gives the **next greater element**"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "heading",
              "text": "2. Next Greater Element",
              "ink": "blue"
            },
            {
              "type": "code",
              "lang": "python",
              "lines": [
                "a = [2, 1, 5, 3]",
                "ans, st = [-1] * len(a), []",
                "for i, x in enumerate(a):",
                "    while st and x > a[st[-1]]:",
                "        ans[st.pop()] = x",
                "    st.append(i)",
                "print(ans)"
              ],
              "note": "a[i] > a[top]: pop, answer[top] = a[i]"
            },
            {
              "type": "code",
              "lang": "output",
              "lines": [
                "[5, 5, -1, -1]"
              ]
            },
