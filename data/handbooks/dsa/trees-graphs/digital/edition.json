                  "Min peek",
                  "O(1)",
                  "O(h)",
                  "n/a"
                ],
                [
                  "Search",
                  "O(n)",
                  "O(h); O(log n) if balanced",
                  "O(L)"
                ],
                [
                  "Sorted?",
                  "no",
