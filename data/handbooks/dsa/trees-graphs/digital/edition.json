          "title": "Binary Trees, BSTs and Traversals",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Definition",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "Binary tree: ==at most 2 children== per node",
                "Height h = longest root-to-leaf path",
                "==BST==: left subtree < node < right subtree, for **every** node"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "heading",
              "text": "2. Mechanism",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "Search, insert, delete walk ==one path== = O(h)",
                "{green:Balanced}: O(log n). {red:Skewed}: O(n)",
                "Delete with 2 children: use the ==inorder successor=="
              ],
              "style": "dot",
              "ink": "blue"
            },
            {
              "type": "heading",
              "text": "3. Traversals",
              "ink": "purple"
            },
            {
              "type": "table",
              "headers": [
                "Order",
                "Visit",
                "Use"
              ],
              "rows": [
                [
                  "Preorder",
                  "node, left, right",
                  "copy a tree"
                ],
                [
                  "Inorder",
                  "left, node, right",
                  "==sorted== BST"
                ],
                [
                  "Postorder",
                  "left, right, node",
                  "delete, heights"
                ],
                [
                  "Level-order",
                  "`queue`",
                  "by depth"
                ]
              ],
              "frame": "dashed"
            },
            {
              "type": "code",
              "lang": "python",
              "lines": [
                "def inorder(n):",
                "    if n:",
                "        inorder(n[1])",
                "        print(n[0])",
                "        inorder(n[2])",
                "inorder((2,(1,None,None),(3,None,None)))"
              ],
              "note": "root 2, children 1 and 3"
            },
            {
              "type": "code",
              "lang": "output",
              "lines": [
                "1",
                "2",
                "3"
              ]
            },
            {
              "type": "heading",
              "text": "4. Mistakes",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "Checking a node against children only: pass ==min/max bounds== down",
                "Inserting sorted data: the BST becomes a ==linked list==",
                "Skewed trees hit the recursion limit"
              ],
              "style": "cross",
              "frame": "dashed",
              "ink": "red"
            }
          ]
