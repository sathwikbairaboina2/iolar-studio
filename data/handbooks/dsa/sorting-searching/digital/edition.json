    {
      "title": "Binary Search and Its Variants",
      "role": "outline",
      "outlineIndex": 4,
      "pages": [
        {
          "title": "Binary Search and Its Variants",
          "blocks": [
            {
              "type": "heading",
              "text": "1. The Template",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "Needs a ==sorted== array; each step **halves** the range",
                "Time {green:O(log n)}, space `O(1)` when iterative",
                "Mid is `lo+(hi-lo)/2`, not `(lo+hi)/2`: the sum overflows fixed-width ints"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "code",
              "lang": "python",
              "lines": [
                "def binary_search(a, t):",
                "    lo, hi = 0, len(a) - 1",
                "    while lo <= hi:",
                "        mid = lo + (hi - lo) // 2",
                "        if a[mid] == t: return mid",
                "        if a[mid] < t: lo = mid + 1",
                "        else: hi = mid - 1",
                "    return -1"
              ],
              "note": "returns -1 if not found"
            },
            {
              "type": "heading",
              "text": "2. Variants",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "Variant",
                "On match",
                "Result"
              ],
              "rows": [
                [
                  "First occurrence",
                  "record `mid`, then `hi = mid-1`",
                  "leftmost index"
                ],
                [
                  "Last occurrence",
                  "record `mid`, then `lo = mid+1`",
                  "rightmost index"
                ]
              ],
              "frame": "dashed"
            },
            {
              "type": "bullets",
              "items": [
                "**Search on answer**: binary search any ==monotonic predicate== (min capacity, square root)",
                "**Rotated array**: one half is always ==sorted==; check if the target lies in it, else go to the other half"
              ],
              "style": "dot"
            },
            {
              "type": "heading",
              "text": "3. Off-by-one Traps",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "`lo<=hi` with `hi=mid`: {red:infinite loop}",
                "`lo<hi` with `hi=mid-1`: {red:skips the answer}"
              ],
              "style": "cross",
              "frame": "dashed",
              "ink": "red"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "One template",
              "text": "Pick **one** template and stay consistent: `lo<=hi` with `mid+1` and `mid-1`."
            }
          ]
        }
      ]
