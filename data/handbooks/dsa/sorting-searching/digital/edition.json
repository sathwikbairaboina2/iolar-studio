            {
              "type": "heading",
              "text": "1. Bubble Sort",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "Swap adjacent ==out-of-order== pairs",
                "After pass k, the **k largest** are fixed at the end",
                "No swap in a full pass → stop: ==O(n)== on sorted input"
              ],
              "style": "dot"
            },
            {
              "type": "heading",
              "text": "2. Insertion Sort",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "A ==sorted prefix== grows by one each step",
                "Larger elements shift right; **no swaps**"
              ],
              "style": "dot"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "Take key",
                    "ink": "blue"
                  },
                  {
                    "text": "Shift larger right",
                    "ink": "orange"
                  },
                  {
                    "text": "Drop in gap",
                    "ink": "green"
                  }
                ]
              }
            },
            {
              "type": "code",
              "lang": "python",
              "lines": [
                "for i in range(1, len(a)):",
                "    key, j = a[i], i - 1",
                "    while j >= 0 and a[j] > key:",
                "        a[j + 1] = a[j]",
                "        j -= 1",
                "    a[j + 1] = key"
              ]
            },
            {
              "type": "heading",
              "text": "3. Which One",
              "ink": "green"
