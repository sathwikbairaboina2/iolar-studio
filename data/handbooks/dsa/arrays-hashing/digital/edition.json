          "blocks": [
            {
              "type": "heading",
              "text": "1. Counting in One Pass",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "==One pass== over the input: O(n) time, O(k) space for k distinct keys",
                "Use `Counter(s)` or the manual `counts.get(c, 0) + 1`"
              ],
              "style": "dot"
            },
            {
              "type": "code",
              "lang": "python",
              "lines": [
                "from collections import Counter",
                "s = 'aab'",
                "c = Counter(s)  # Counter form",
                "counts = {}  # manual form",
                "for ch in s:",
                "    counts[ch] = counts.get(ch, 0) + 1"
              ]
            },
            {
              "type": "heading",
              "text": "2. Seen-Set Lookups",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "{green:Two Sum}: check `target - x` in `seen` ==before== inserting x",
                "`seen[value] = index`: O(n) instead of O(n^2)",
                "{blue:Duplicates}: if x is already in the set return true, else `add(x)`"
              ],
              "style": "dot"
            },
            {
              "type": "code",
              "lang": "python",
              "lines": [
                "def two_sum(nums, target):",
                "    seen = {}",
                "    for i, x in enumerate(nums):",
                "        if target - x in seen:",
                "            return seen[target - x], i",
                "        seen[x] = i"
              ]
            },
