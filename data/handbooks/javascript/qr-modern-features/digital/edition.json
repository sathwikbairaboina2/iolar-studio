              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "heading",
              "text": "2. Loading Rules",
              "ink": "blue"
            },
            {
              "type": "code",
              "lang": "javascript",
              "lines": [
                "const { f, default: g } = await import('./m.js');"
              ],
              "note": "import() returns a promise; await gives the module namespace object"
            },
            {
              "type": "bullets",
              "items": [
                "Static `import` only at the ==top level==",
                "Node: `.mjs` file or `\"type\": \"module\"`",
                "Include the ==file extension==: `'./m.js'`"
              ],
              "style": "check"
