    {
      "title": "Modern JS Cheat Sheet",
      "role": "outline",
      "outlineIndex": 5,
      "pages": [
        {
          "title": "Modern JS Cheat Sheet",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Unpack and Combine",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "==Rest== goes last; defaults apply only to `undefined`",
                "==Spread== is a shallow copy; later keys win"
              ],
              "style": "check"
            },
            {
              "type": "code",
              "lang": "javascript",
              "lines": [
                "const { a, b = 1, ...rest } = obj",
                "const [x, , z] = arr",
                "const m = { ...a, ...b }",
                "const all = [...a, ...b]",
                "fn(...args)"
              ]
            },
            {
              "type": "heading",
              "text": "2. Safe Access and Pipeline",
              "ink": "green"
            },
            {
              "type": "code",
              "lang": "javascript",
              "lines": [
                "user?.address?.city ?? 'N/A'",
                "arr.filter(f).map(m).reduce(r, init)"
              ]
            },
            {
              "type": "bullets",
              "items": [
                "`??` replaces only null/undefined; `||` any falsy",
                "==reduce==: pass init, return acc"
              ],
              "style": "check"
            },
            {
              "type": "heading",
              "text": "3. Modules and Collections",
              "ink": "purple"
            },
            {
              "type": "table",
              "headers": [
                "",
                "Export",
                "Import"
              ],
              "rows": [
                [
                  "Default",
                  "`export default x`",
                  "`import x from './m.js'`"
                ],
                [
                  "Named",
                  "`export { y }`",
                  "`import { y } from './m.js'`"
                ],
                [
                  "Both",
                  "",
                  "`import x, { y } from './m.js'`"
                ]
              ]
            },
            {
              "type": "table",
              "headers": [
                "",
                "Map",
                "Set"
              ],
              "rows": [
                [
                  "Create",
                  "`new Map([[k, v]])`",
                  "`new Set(arr)`"
                ],
                [
                  "Use",
                  "`map.get(k)`",
                  "`set.has(v)`"
                ],
                [
                  "To array",
                  "`[...map]`",
                  "`[...set]`"
                ]
              ]
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Remember",
              "text": "Named imports need exact names; ==default== takes any. Object integer keys sort first; Map keeps pure insertion order."
            }
          ]
        }
      ]
