          "text": "Retry & Timeout",
          "ink": "green"
        },
        {
          "type": "code",
          "lang": "javascript",
          "lines": [
            "for (let i = 0; ; i++) try {",
            "  return await send();",
            "} catch (e) {",
            "  if (e.status < 500) throw e; // 4xx: no",
            "  await sleep(2 ** i * 100 + jitter());"
          ],
          "runnable": false
        },
        {
          "type": "bullets",
          "items": [
            "only retry transient errors — network/5xx",
            "never retry 4xx",
            "race alone ignores the loser — abort too",
            "promises have no built-in cancel",
            "thread an `AbortSignal`, check `signal.aborted`"
          ]
        },
