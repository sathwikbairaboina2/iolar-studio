    {
      "title": "ESM and CJS Cheat Sheet",
      "role": "outline",
      "outlineIndex": 5,
      "pages": [
        {
          "title": "ESM and CJS Cheat Sheet",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Syntax side by side",
              "ink": "green"
            },
            {
              "type": "table",
              "headers": [
                "",
                "CJS",
                "ESM"
              ],
              "rows": [
                [
                  "Import",
                  "`const x = require('x')`",
                  "`import x from 'x'`"
                ],
                [
                  "Named",
                  "`const { a } = require('x')`",
                  "`import { a } from 'x'`"
                ],
                [
                  "Export value",
                  "`module.exports = v`",
                  "`export default v`"
                ],
                [
                  "Export many",
                  "`module.exports = { a, b }`",
                  "`export { a, b }`"
                ],
                [
                  "Export one",
                  "`exports.a = 1`",
                  "`export const a = 1`"
                ]
              ]
            },
            {
              "type": "heading",
              "text": "2. Files and lazy loading",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                ".mjs = ==ESM==, .cjs = ==CJS==",
                "`.js` follows the `type` field in package.json",
                "`import()` returns a Promise of the namespace; default is `m.default`",
                "Top-level await is ==ESM only=="
              ],
              "style": "dot"
            },
            {
              "type": "code",
              "lang": "javascript",
              "lines": [
                "const m = await import('./x.js');",
                "m.default; m.a;"
              ]
            },
            {
              "type": "heading",
              "text": "3. npm scripts and tree shaking",
              "ink": "purple"
            },
            {
              "type": "table",
              "headers": [
                "Command",
                "Does"
              ],
              "rows": [
                [
                  "`npm run <script>`",
                  "runs a `scripts` entry"
                ],
                [
                  "`npm start` / `npm test`",
                  "no `run` needed"
                ],
                [
                  "`npm run x -- --flag`",
                  "passes the flag to the script"
                ],
                [
                  "`prebuild` / `postbuild`",
                  "run automatically around build"
                ]
              ]
            },
            {
              "type": "bullets",
              "items": [
                "Tree shaking needs ==ESM== plus `\"sideEffects\": false`"
              ],
              "style": "check"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Interview point",
              "text": "New library: ==ESM==, the standard and tree-shakable. Ship both with `exports` using `import` and `require` conditions."
            }
          ]
        }
      ]
