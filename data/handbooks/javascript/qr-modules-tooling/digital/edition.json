    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "`m.js` has `export let count = 0; export function inc(){ count++ }`. After `import { count, inc } from './m.js'; inc();` what does `console.log(count)` print? And with `const { count } = require('./m')` in CJS?",
              "a_bullets": [
                "ESM prints `1`: the import is a live, read-only view of the exporter's variable.",
                "CJS prints `0`: destructuring copied the value at require time."
              ],
              "example_code": [
                "import { count, inc } from './m.js';",
                "inc();",
                "console.log(count);"
              ]
            },
            {
              "type": "qa",
              "q": "`package.json` has `\"type\": \"module\"`. `app.js` runs `const fs = require('fs')` and crashes. Why, and what are two fixes?",
              "a_bullets": [
                "`.js` is now ESM, where `require` is not defined.",
                "Use `import fs from 'fs'`, or rename the file to `app.cjs`."
              ]
            },
            {
              "type": "qa",
              "q": "A bundle still contains a whole utility library although you call one function from it via `require`. Why?",
              "a_bullets": [
                "`require` is a runtime call, so the bundler cannot statically tell which exports are used.",
                "Use named ESM imports and set `\"sideEffects\": false`."
              ]
            }
          ]
        }
      ]
    }
