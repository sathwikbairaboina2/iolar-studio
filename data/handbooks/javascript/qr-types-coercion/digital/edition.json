            },
            {
              "type": "code",
              "lang": "javascript",
              "lines": [
                "Number.isNaN('abc')  // false",
                "isNaN('abc')         // true (coerces)",
                "Object.is(0, -0)     // false",
                "0 || 5               // 5",
                "0 ?? 5               // 0"
              ],
              "note": "NaN and -0 checks; defaults"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "NaN",
              "text": "`NaN === NaN` is false. Use `Number.isNaN` or `Object.is`; `??` keeps 0 and ''."
            }
