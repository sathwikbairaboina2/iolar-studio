              ],
              "highlightRow": 0
            },
            {
              "type": "heading",
              "text": "2. Truthiness and coercion",
              "ink": "purple"
            },
            {
              "type": "bullets",
              "items": [
                "==Falsy== (exactly 8): `false 0 -0 0n '' null undefined NaN`",
                "Everything else is truthy, including `'0'`, `[]` and `{}`"
              ],
              "style": "check",
              "ink": "purple"
            },
            {
              "type": "bullets",
              "items": [
                "`+` with any string ==concatenates==: `1+'2'` is '12'",
                "`- * / %` convert to ==number==: `'6'-'2'` is 4",
                "`==` only for `x == null` (null and undefined); else `===`"
              ],
