    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "With `o = {a:{b:1}}` and `const c = {...o}`, you run `c.a.b = 2`. What is `o.a.b`?",
              "a_bullets": [
                "**2**: spread is shallow",
                "`c.a` and `o.a` are the same object",
                "`structuredClone(o)` gives a deep copy"
              ]
            },
            {
              "type": "qa",
              "q": "Why is `[] == ![]` true?",
              "a_bullets": [
                "`![]` is `false`, because arrays are truthy",
                "`[] == false`: false becomes 0, `[]` becomes `''` then 0",
                "`0 == 0` is true"
              ]
            },
            {
              "type": "qa",
              "q": "What do `0 || 5` and `0 ?? 5` give?",
              "a_bullets": [
                "`5` and `0`",
                "`||` skips any falsy value",
                "`??` skips only null and undefined"
              ]
            }
          ]
        }
      ]
