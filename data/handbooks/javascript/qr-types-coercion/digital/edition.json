          "title": "null, undefined and NaN",
          "blocks": [
            {
              "type": "heading",
              "text": "1. undefined vs null",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "{blue:undefined} = ==no value assigned==: uninitialised variable, missing property or argument, no `return`",
                "{green:null} = ==intentional empty== value, set by the programmer"
              ],
              "style": "dot"
            },
            {
              "type": "table",
              "headers": [
                "",
                "undefined",
                "null"
              ],
              "rows": [
                [
                  "`typeof`",
                  "'undefined'",
                  "'object'"
                ],
                [
                  "`Number(x)`",
                  "NaN",
                  "0"
                ],
                [
                  "`JSON.stringify`",
                  "property dropped",
                  "kept"
                ],
                [
                  "`x + 1`",
                  "NaN",
                  "1"
                ]
              ],
              "highlightRow": 1
            },
            {
              "type": "heading",
              "text": "2. NaN",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "Type ==number==, made by failed maths",
                "`0/0`, `Number('abc')`, `parseInt('x')`, `Math.sqrt(-1)`",
                "Only value not equal to itself: `NaN === NaN` is {red:false}",
                "`Number.isNaN(x)` is strict; global `isNaN` coerces first"
              ],
              "style": "dot"
            },
            {
              "type": "code",
              "lang": "javascript",
              "lines": [
                "Number.isNaN('abc')  // false",
                "isNaN('abc')         // true",
                "[NaN].includes(NaN)  // true",
                "[NaN].indexOf(NaN)   // -1"
              ]
            },
            {
              "type": "heading",
              "text": "3. Mistake: NaN spreads",
              "ink": "red"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "One NaN poisons the maths",
              "text": "Any arithmetic with NaN or undefined gives NaN. Guard with `?.` and `??`: `user?.age ?? 0`"
            }
          ]
        }
      ]
    },
    {
      "title": "Types and Coercion Cheat Sheet",
      "role": "outline",
