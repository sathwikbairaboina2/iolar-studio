            {
              "type": "heading",
              "text": "2. Web storage API",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "==Synchronous==, ~5MB per origin, values are ==strings only==",
                "`setItem(k,v)`, `getItem(k)`, `removeItem(k)`, `clear()`",
                "`getItem` returns ==null== if the key is missing",
                "A bare object is saved as ==\"[object Object]\"==, so use JSON"
              ],
              "style": "dot"
            },
            {
              "type": "code",
              "lang": "javascript",
              "lines": [
                "localStorage.setItem('u', {a: 1}) // \"[object Object]\"",
                "localStorage.setItem('u', JSON.stringify({a: 1}))",
                "const u = JSON.parse(localStorage.getItem('u'))",
                "localStorage.getItem('nope') // null"
              ]
            },
            {
              "type": "heading",
              "text": "3. Cookies and secrets",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "Options: `Expires`/`Max-Age`, `Path`, `Secure`, `SameSite`, `HttpOnly`",
                "{green:HttpOnly} cookie is unreadable by JS, so keep auth tokens there"
              ],
              "style": "check"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "No secrets in web storage",
              "text": "Any ==XSS== script can read localStorage and sessionStorage. Tokens go in an **HttpOnly** cookie."
            }
          ]
        }
      ]
