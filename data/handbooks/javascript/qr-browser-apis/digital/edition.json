                "  body: JSON.stringify(data)",
                "})"
              ],
              "note": "stringify the object yourself"
            },
            {
              "type": "bullets",
              "items": [
                "Body must be a ==string==, `FormData`, `Blob` or `URLSearchParams`",
                "A raw object becomes {red:\"[object Object]\"}"
