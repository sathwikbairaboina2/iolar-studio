          "blocks": [
            {
              "type": "heading",
              "text": "1. What fetch returns",
              "ink": "green"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "fetch(url, options)",
                    "sub": "call",
                    "ink": "blue"
                  },
                  {
                    "text": "Promise<Response>",
                    "sub": "resolves on headers",
                    "ink": "green"
                  },
                  {
                    "text": "Body stream",
                    "sub": "read later",
                    "ink": "purple"
                  }
                ]
              }
            },
            {
              "type": "bullets",
              "items": [
                "Promise resolves once ==headers arrive==",
                "The body is a **separate stream** read later",
                "Options: `method` (default GET), `headers`, `body`, `credentials`, `mode`, `cache`, `signal`"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
