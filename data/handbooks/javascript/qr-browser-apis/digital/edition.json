          "title": "URL, URLSearchParams and Cheat Sheet",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Parse a URL",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "`new URL(path, base)` resolves a relative path against ==base==",
                "Properties: `origin`, `pathname`, `search`, `hash`, `searchParams`",
                "An invalid URL throws {red:TypeError}",
                "`searchParams.set` encodes the value for you"
              ],
              "style": "dot",
              "ink": "blue"
            },
            {
              "type": "code",
              "lang": "javascript",
              "lines": [
                "const url = new URL('/api?q=a', 'https://x.com');",
                "url.searchParams.set('q', 'a b&c');",
                "console.log(url.origin, url.pathname, url.search);"
              ]
            },
            {
              "type": "code",
              "lang": "output",
              "lines": [
                "https://x.com /api ?q=a+b%26c"
              ]
            },
            {
              "type": "heading",
              "text": "2. URLSearchParams",
              "ink": "purple"
            },
            {
              "type": "table",
              "headers": [
                "Method",
                "Effect"
              ],
              "rows": [
                [
                  "`get(k)`",
                  "first value, `null` if missing"
                ],
                [
                  "`getAll(k)`",
                  "array of every value"
                ],
                [
                  "`has(k)`",
                  "boolean"
                ],
                [
                  "`set(k,v)`",
                  "==replaces== existing values"
                ],
                [
                  "`append(k,v)`",
                  "adds a duplicate"
                ],
                [
                  "`delete(k)`",
                  "removes the key"
                ],
                [
                  "`toString()`",
                  "encoded query, no `?`"
                ]
              ]
            },
            {
              "type": "bullets",
              "items": [
                "Iterates as ==[key, value]== pairs",
                "{red:Never} concatenate query strings by hand",
                "Space becomes `+` here, but `%20` in encodeURIComponent",
                "`fetch(url)` takes a URL object; URLSearchParams works as `body`"
              ],
              "style": "cross",
