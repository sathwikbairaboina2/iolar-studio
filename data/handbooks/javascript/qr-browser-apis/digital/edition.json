              "type": "heading",
              "text": "1. Workflow",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "==Async==, transactional **key-value object store**",
                "Holds objects, Blobs, files: {green:hundreds of MB+}"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "blue"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "open",
                    "sub": "name, version",
                    "ink": "blue"
                  },
                  {
                    "text": "onupgradeneeded",
                    "sub": "schema here",
                    "ink": "purple"
                  },
                  {
                    "text": "transaction",
                    "sub": "readwrite",
                    "ink": "orange"
                  },
                  {
                    "text": "put / get",
                    "sub": "objectStore",
                    "ink": "green"
                  }
                ]
              }
            },
            {
              "type": "code",
              "lang": "javascript",
              "lines": [
                "const req = indexedDB.open('app', 2);",
                "req.onupgradeneeded = () => {",
                "  req.result.createObjectStore('users', { keyPath: 'id' })",
                "    .createIndex('byName', 'name');",
                "};",
                "req.onsuccess = () => req.result",
                "  .transaction('users', 'readwrite')",
                "  .objectStore('users').put({ id: 1, name: 'Ana' });"
              ],
              "note": "schema in upgrade, data in a transaction"
            },
            {
              "type": "bullets",
              "items": [
                "Schema changes only in ==onupgradeneeded==",
                "It runs only after a **bumped version**",
                "Also `add`, `get`, `delete`, `getAll`"
              ],
              "style": "check"
            },
