    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "The server returns 404. Does `const res = await fetch('/missing')` throw?",
              "a_bullets": [
                "No. `fetch` rejects only on network failure or abort.",
                "The Promise resolves with `res.ok === false`, so check `res.ok` before `res.json()`."
              ]
            },
            {
              "type": "qa",
              "q": "What happens with `await res.json(); await res.text();` on the same response?",
              "a_bullets": [
                "The second call rejects with a TypeError, because the body stream is already used (`bodyUsed` is true).",
                "Call `res.clone()` before the first read."
              ]
            },
            {
              "type": "qa",
              "q": "After `localStorage.setItem('user', {name:'Ann'})`, what does `JSON.parse(localStorage.getItem('user'))` do?",
              "a_bullets": [
                "It throws. The stored value is the string \"[object Object]\", which is not valid JSON.",
                "Store `JSON.stringify(obj)` instead."
              ]
            }
          ]
        }
      ]
    }
