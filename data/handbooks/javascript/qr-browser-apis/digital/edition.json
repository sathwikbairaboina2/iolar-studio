          "blocks": [
            {
              "type": "heading",
              "text": "1. Lifetime and scope",
              "ink": "green"
            },
            {
              "type": "table",
              "headers": [
                "",
                "localStorage",
                "sessionStorage",
                "Cookies"
              ],
              "rows": [
                [
                  "Lifetime",
                  "==Until cleared==",
                  "==One tab==, gone on close",
                  "Expires / Max-Age"
