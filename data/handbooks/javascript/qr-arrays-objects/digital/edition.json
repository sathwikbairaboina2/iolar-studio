          "title": "Spread and Destructuring",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Spread and Rest",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "Array spread copies or merges: `[...a, ...b]`",
                "Object spread merges, ==later keys win==",
                "Rest collects the remainder: `[head, ...tail]`, `{ id, ...others }`",
                "Rest must come {red:last}"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "code",
              "lang": "javascript",
              "lines": [
                "const all = [...a, ...b];",
                "const cfg = { ...defaults, ...overrides };",
                "// overrides.size replaces defaults.size"
              ],
              "note": "order decides the winner"
            },
            {
              "type": "heading",
              "text": "2. Destructuring",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "",
                "Array",
                "Object"
              ],
              "rows": [
                [
                  "Matches by",
                  "**position**",
                  "**key**"
                ],
                [
                  "Skip",
                  "`[a, , c]`",
                  "omit the key"
                ],
                [
                  "Rename",
                  "n/a",
                  "`{ name: n }`"
                ],
                [
                  "Default",
                  "`[a = 1]`",
                  "`{ age = 18 }`"
                ]
              ],
              "frame": "dashed"
            },
            {
              "type": "code",
              "lang": "javascript",
              "lines": [
                "const [first, , third] = arr;",
                "const { name: n, age = 18 } = user;",
                "const [head, ...tail] = arr;",
                "const { id, ...others } = obj;"
              ]
            },
            {
              "type": "heading",
              "text": "3. Defaults and Mistakes",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "Default applies only to ==undefined==",
                "`const { x = 5 } = { x: null }` gives x = `null`, not 5",
                "`[...rest, last]` is a SyntaxError"
              ],
              "style": "cross",
              "frame": "dashed",
              "ink": "red"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "null is a value",
              "text": "Only ==undefined== (missing) triggers a default. Handle `null` yourself with `??`."
            }
          ]
        }
      ]
