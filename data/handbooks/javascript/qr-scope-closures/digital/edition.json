          "blocks": [
            {
              "type": "qa",
              "q": "What does this print?",
              "a_bullets": [
                "**3 3 3**",
                "One function-scoped `i` is shared and is 3 when the callbacks run",
                "With `let i`, each iteration gets its own binding: 0 1 2"
              ],
              "example_code": [
                "for (var i = 0; i < 3; i++)",
                "  setTimeout(() => console.log(i))"
              ]
            },
            {
              "type": "qa",
              "q": "Why does this throw?",
              "a_bullets": [
                "ReferenceError",
                "`y` is in the temporal dead zone until its declaration line",
                "`typeof` is only safe on names never declared"
              ],
              "example_code": [
                "console.log(typeof y)",
                "let y = 1"
              ]
            },
            {
              "type": "qa",
              "q": "Which line throws, and what error?",
              "a_bullets": [
                "Only the last line: TypeError",
                "`push` mutates the value, and the binding stays the same",
                "`a = []` reassigns the binding, which `const` forbids"
              ],
              "example_code": [
                "const a = []",
                "a.push(1)",
                "a = []"
              ]
            },
            {
              "type": "qa",
              "q": "What does this print?",
              "a_bullets": [
                "**2**",
                "A closure captures the variable by reference, not its value at creation"
              ],
              "example_code": [
                "let n = 1",
                "const f = () => n",
                "n = 2",
                "console.log(f())"
              ]
            }
          ]
