    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "What does this print?",
              "a_bullets": [
                "A **TypeError**.",
                "`g()` is a plain call, so default binding applies.",
                "Class bodies are strict, so `this` is `undefined`."
              ],
              "example_code": [
                "class C { n = 1; get() { return this.n; } }",
                "const g = new C().get;",
                "console.log(g());"
              ]
            },
            {
              "type": "qa",
              "q": "What does this print?",
              "a_bullets": [
                "`1 3`",
                "`bind` fixes `this` permanently; the second `bind` is ignored.",
                "`call` on the original `f` is unaffected."
              ],
              "example_code": [
                "function f() { return this.x; }",
                "const b = f.bind({ x: 1 }).bind({ x: 2 });",
                "console.log(b(), f.call({ x: 3 }));"
              ]
            },
            {
              "type": "qa",
              "q": "Why does `hi()` not return `'x'`, and what is the fix?",
              "a_bullets": [
                "An arrow function has no own `this`; it takes the outer scope's.",
                "Use method shorthand: `hi() { return this.name; }`."
              ],
              "example_code": [
                "const o = { name: 'x', hi: () => this.name };"
              ]
            },
            {
              "type": "qa",
              "q": "What does this print?",
              "a_bullets": [
                "`1 false`",
                "`a.list.push` only reads `list`, found on the prototype.",
                "The shared array is mutated, so `b` sees it."
              ],
              "example_code": [
                "function A() {}",
                "A.prototype.list = [];",
                "const a = new A(), b = new A();",
                "a.list.push(1);",
                "console.log(b.list.length, a.hasOwnProperty('list'));"
              ]
            }
          ]
        }
      ]
