          "title": "Errors and Debugging Mental Model",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Error objects and types",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "An `Error` carries ==name==, ==message== and ==stack==",
                "Any value can be thrown, but throw `Error` objects to get a stack trace"
              ],
              "style": "dot"
            },
            {
              "type": "table",
              "headers": [
                "Type",
                "Cause",
                "Example"
              ],
              "rows": [
                [
                  "`SyntaxError`",
                  "Parse time, nothing runs",
                  "`let = ;`"
                ],
                [
                  "`ReferenceError`",
                  "Undeclared variable",
                  "`foo`"
                ],
                [
                  "`TypeError`",
                  "Wrong type, calling undefined",
                  "`undefined.x`"
                ],
                [
                  "`RangeError`",
                  "Value out of range",
                  "`new Array(-1)`, infinite recursion"
                ],
                [
                  "`URIError`",
                  "Bad URI function input",
                  "`decodeURI('%')`"
                ]
              ]
            },
            {
              "type": "heading",
              "text": "2. Where errors go",
              "ink": "blue"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "throw",
                    "sub": "runtime error",
                    "ink": "red"
                  },
                  {
                    "text": "Call stack",
                    "sub": "bubbles up",
                    "ink": "blue"
                  },
                  {
                    "text": "catch",
                    "sub": "handled",
                    "ink": "green"
                  },
                  {
                    "text": "No catch",
                    "sub": "script or task dies, console",
                    "ink": "orange"
                  }
                ]
              }
            },
            {
              "type": "bullets",
              "items": [
                "try/catch sees only ==synchronous== throws and awaited rejections",
                "A throw in `setTimeout` or an un-awaited promise skips it"
              ],
              "style": "cross"
            },
            {
              "type": "code",
              "lang": "javascript",
              "lines": [
                "try {",
                "  setTimeout(() => { throw new Error('late'); }, 0);",
                "} catch (e) {",
                "  // never runs: the callback fires after try exits",
                "}"
              ],
              "note": "the error escapes to the console"
            },
            {
              "type": "heading",
              "text": "3. Debugging loop",
              "ink": "green"
            },
            {
              "type": "diagram",
