                    "ink": "purple"
                  },
                  {
                    "text": "Isolate",
                    "note": "breakpoint or log",
                    "ink": "orange"
                  },
                  {
                    "text": "Fix",
                    "ink": "green"
                  },
                  {
                    "text": "Re-test",
                    "ink": "green"
                  }
                ]
              }
            }
          ]
        }
      ]
