    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "What does this print, and in what order?",
              "example_code": [
                "function f() {",
                "  try { return 'try'; }",
                "  finally { console.log('cleanup'); }",
                "}",
                "console.log(f());"
              ],
              "a_bullets": [
                "`cleanup`, then `try`",
                "finally runs before the function actually returns"
              ]
            },
            {
              "type": "qa",
              "q": "Why is 'caught' never printed?",
              "example_code": [
                "try {",
                "  setTimeout(() => { throw new Error('boom'); }, 0);",
                "} catch (e) { console.log('caught'); }"
              ],
              "a_bullets": [
                "The callback runs after the try block has already exited",
                "Put the try/catch inside the callback"
              ]
            },
            {
              "type": "qa",
              "q": "What goes wrong here?",
              "example_code": [
                "async function load() { throw new Error('x'); }",
                "try { load(); } catch (e) { console.log('caught'); }"
              ],
              "a_bullets": [
                "load() returns a rejected promise, so nothing throws synchronously",
                "Result: unhandled rejection. Fix: `await load()` inside try"
              ]
            }
          ]
        }
      ]
