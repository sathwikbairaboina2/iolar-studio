        {
          "type": "code",
          "lang": "go",
          "lines": [
            "var counter int",
            "for i := 0; i < 1000; i++ {",
            "    go func() { counter++ }()",
            "}",
            "// final < 1000, varies per run"
          ],
          "runnable": false
        },
        {
          "type": "bullets",
          "items": [
            "Race = same address, concurrent",
            "At least one access is a write",
            "No synchronization orders them",
            "Result: undefined behavior"
          ]
        },
