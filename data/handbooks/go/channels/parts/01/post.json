            ]
          ]
        },
        {
          "type": "sidebox",
          "title": "Cheap To Pass",
          "items": [
            "A channel value points at one `hchan`",
            "Copying it shares the same channel",
            "Handing it to goroutines costs nothing",
            "Safe for N goroutines, no mutex needed"
          ],
          "ink": "green"
        },
        {
          "type": "callout",
          "style": "takeaway",
          "title": "Ops Order Memory",
          "text": "Every channel operation is a synchronization point: it establishes happens-before between the two goroutines involved."
        },
        {
          "type": "code",
          "lang": "go",
          "lines": [
            "go func(c <-chan T) { // pass c: pre-1.22",
            "\tdefer wg.Done()",
            "\tfor v := range c { out <- v }",
            "}(c) // spawned once per input channel"
          ]
        },
        {
          "type": "code",
          "lang": "go",
          "lines": [
            "go func() {",
            "\twg.Wait()  // last producer finished",
            "\tclose(out) // nobody else knows when",
            "}()"
          ]
        },
        {
          "type": "diagram",
          "kind": "flow",
          "spec": {
            "nodes": [
              "sender parks",
              "`sendq`",
              "receiver arrives",
              "direct copy",
