              "`chan T`",
              "both",
              "the owner"
            ],
            [
              "`chan<- T`",
              "send only",
              "producer arg"
            ],
            [
              "`<-chan T`",
              "receive only",
              "consumer arg"
            ]
          ]
        },
        {
          "type": "code",
          "lang": "go",
          "lines": [
            "func worker(in <-chan Job, o chan<- R) {",
            "\t<-o // compile error: send-only",
            "}"
          ]
        },
        {
          "type": "bullets",
          "items": [
            "`chan T` converts to either directed form",
            "The conversion never goes back the other way",
            "Signature states intent, compiler enforces it"
          ]
        },
        {
          "type": "heading",
          "text": "len, cap, Identity",
