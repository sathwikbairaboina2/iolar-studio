      "page_title": "Worker Signatures & Non-Blocking Ops",
      "blocks": [
        {
          "type": "code",
          "lang": "go",
          "lines": [
            "func worker(jobs <-chan J, o chan<- R) {",
            "\tfor j := range jobs { o <- process(j) }",
            "}"
