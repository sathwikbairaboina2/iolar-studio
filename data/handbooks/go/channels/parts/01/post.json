        },
        {
          "type": "code",
          "lang": "go",
          "lines": [
            "ch := make(chan int)  // only ints pass",
            "buf := make(chan int, 4) // cap 4",
            "var nilCh chan int    // zero value: nil"
          ]
        },
        {
          "type": "bullets",
          "items": [
            "CSP: share memory by communicating",
            "Not: communicate by sharing memory",
            "`make(chan T)` is unbuffered, capacity 0",
            "`var ch chan int` gives nil, not usable"
          ]
        },
        {
          "type": "heading",
          "text": "Reading The Arrow",
          "ink": "black"
        },
        {
          "type": "code",
          "lang": "go",
          "lines": [
            "ch <- v   // send v into ch",
            "v := <-ch // receive into v",
            "<-ch      // receive and discard"
          ]
        },
        {
          "type": "paragraph",
          "text": "The arrow always points the way data flows. That single mnemonic reads every channel expression you will ever meet."
        },
        {
          "type": "heading",
          "text": "Directional Types",
          "ink": "red"
        },
        {
          "type": "table",
