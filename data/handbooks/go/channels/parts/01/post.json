              "blocks forever"
            ]
          ]
        },
        {
          "type": "callout",
          "style": "tip",
          "title": "Drop On Full",
          "text": "A drop-on-full send fits metrics and logs, where a stale item is worthless. Never drop a work item: that is silent data loss."
        }
      ]
