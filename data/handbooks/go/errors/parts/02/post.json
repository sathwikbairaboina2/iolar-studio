              "context",
              "`fmt.Errorf`"
            ],
            [
              "caller reads fields",
              "struct type"
            ]
          ]
        },
        {
          "type": "code",
          "lang": "go",
          "lines": [
            "var ErrNotFound =",
            "  errors.New(\"not found\") // once",
            "",
            "return fmt.Errorf(",
            "  \"load %q: %w\", path, err)"
          ],
          "note": "one wrap per layer crossed"
        },
        {
          "type": "bullets",
          "items": [
            "Wrap with `%w` when the cause is part of your contract",
            "Use `%v` to deliberately keep it private",
            "`errors.Is` for a known value, `errors.As` for a known type",
            "`errors.As` into an interface for behaviour"
          ]
        },
        {
          "type": "heading",
          "text": "Inspect by Question",
          "ink": "purple"
        },
        {
          "type": "table",
