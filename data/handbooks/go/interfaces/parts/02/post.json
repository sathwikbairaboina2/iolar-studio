          "rows": [
            [
              "sentinel",
              "`errors.Is`",
              "walks the chain"
            ],
            [
              "concrete type",
              "`errors.As`",
              "fills a pointer"
            ],
            [
              "exact dynamic",
              "`err.(*T)`",
              "no unwrapping"
            ]
          ]
        },
        {
          "type": "code",
          "lang": "go",
          "lines": [
            "if s, ok := i.(string); ok {",
            "\tuse(s)       // never panics",
            "}",
            "var _ error = (*MyErr)(nil)"
