              },
              {
                "from": "b1",
                "to": "c1_0"
              },
              {
                "from": "b2",
                "to": "c2_0"
              }
            ]
          }
        },
        {
          "type": "callout",
          "style": "takeaway",
          "title": "The Core Promise",
          "text": "Same `go.mod` + `go.sum` + Go version = the same bits, on any machine, forever."
        }
      ]
    },
    {
      "page_title": "Anatomy of go.mod",
      "blocks": [
        {
          "type": "code",
          "lang": "gomod",
          "lines": [
            "module example.com/m",
            "go 1.22",
            "toolchain go1.22.3",
            "require example.com/dep v1.4.2",
            "require example.com/log v0.9.0 // indirect"
          ],
          "runnable": false
        },
        {
          "type": "heading",
          "text": "The Header Lines",
          "ink": "accent"
        },
        {
          "type": "bullets",
          "items": [
            "`module` declares the path every consumer imports",
            "`go 1.22` gates language features and toolchain behaviour",
            "It is NOT a minimum runtime version",
            "`toolchain` names the version go switches to (1.21+)"
          ]
        },
        {
          "type": "callout",
          "style": "tip",
          "title": "Hard Since 1.21",
          "text": "A newer `go` line makes an older toolchain refuse to build rather than try and fail."
        },
        {
          "type": "heading",
          "text": "Requirements"
        },
        {
          "type": "bullets",
          "items": [
            "`require` names a module at a MINIMUM version",
            "Never a pin, never a maximum — MVS may pick higher",
            "`// indirect` = not imported by your own packages"
          ]
        },
        {
          "type": "sidebox",
          "title": "Why `// indirect` Appears",
          "items": [
            "The dependency ships no `go.mod` of its own",
            "MVS bumped it above what its parent asked for",
            "Graph pruning records many more of them"
          ]
        },
        {
          "type": "heading",
          "text": "Other Directives"
        },
        {
          "type": "table",
          "headers": [
            "Directive",
            "Effect"
          ],
          "rows": [
            [
              "`exclude dep v1.4.1`",
              "pretend that version does not exist"
            ],
            [
              "`replace old => new`",
              "swap source or version"
            ],
            [
              "`retract v1.2.0`",
              "author withdraws a release"
            ],
            [
              "`require ( ... )`",
              "block form, one module per line"
            ]
          ]
        },
        {
          "type": "heading",
          "text": "Machine-Edited"
        },
        {
          "type": "code",
          "lang": "bash",
          "lines": [
            "go mod edit -require=example.com/d@v1.5.0",
            "go mod edit -droprequire=example.com/old",
            "go mod edit -replace=a.com/x=../x",
            "go mod edit -go=1.22"
          ],
          "runnable": false
        },
        {
          "type": "bullets",
          "items": [
            "File is line-oriented so diffs stay readable",
            "Comments after directives survive `go mod tidy`",
            "Your ordering does not — tidy sorts and regroups"
          ]
        },
        {
          "type": "callout",
          "style": "takeaway",
          "title": "Commit It",
          "text": "`go.mod` is the source of truth the build reads before it touches the network."
        },
        {
          "type": "heading",
          "text": "SemVer, Go Flavour",
          "ink": "accent"
        },
        {
          "type": "bullets",
          "items": [
            "`vMAJOR.MINOR.PATCH`, always with the leading `v`",
            "MAJOR = breaking, MINOR = feature, PATCH = fix",
            "MINOR and PATCH stay backwards compatible",
            "`v0.x.y` promises nothing — every v0 minor may break"
          ]
        }
      ]
    },
    {
      "page_title": "Versions and Pseudo-Versions",
      "blocks": [
        {
          "type": "table",
          "headers": [
            "String",
            "Meaning"
          ],
          "rows": [
            [
              "`v1.2.0-beta.1`",
              "prerelease, sorts BEFORE `v1.2.0`"
            ],
            [
              "`v2.0.0+incompatible`",
              "v2 tag from a repo with no `go.mod`"
            ],
            [
              "`v1.4.2`",
              "plain release tag"
            ]
          ]
        },
        {
          "type": "bullets",
          "items": [
            "Prereleases are never chosen by `@latest`",
            "Fields compare numerically: `v1.10.0` > `v1.9.0`"
          ]
        },
        {
          "type": "heading",
          "text": "Pseudo-Versions"
        },
        {
          "type": "code",
          "lang": "text",
          "lines": [
            "v0.0.0-20230518120500-abcdef123456",
            "# base | UTC yyyymmddhhmmss | 12-char hash",
            "# synthetic version for an untagged commit"
          ],
          "runnable": false
        },
        {
          "type": "table",
          "headers": [
            "Prior tag",
            "Shape"
          ],
          "rows": [
            [
              "none",
              "`v0.0.0-<ts>-<hash>`"
            ],
            [
              "a prerelease",
              "`v1.2.3-0.<ts>-<hash>`"
            ],
            [
              "a release",
              "`v1.2.4-0.<ts>-<hash>`"
            ]
          ]
        },
        {
          "type": "bullets",
          "items": [
            "Pseudo-versions sort below the next real tag",
            "So a real release always beats a commit-of-the-day"
          ]
        },
        {
          "type": "heading",
          "text": "Query Forms"
        },
        {
          "type": "table",
          "headers": [
            "Query",
            "Resolves to"
          ],
          "rows": [
            [
              "`@latest`",
              "highest release tag, no prereleases"
            ],
            [
              "`@upgrade` / `@patch`",
              "latest / latest patch only"
            ],
            [
              "`@v1.4.2` / `@master`",
              "exact tag / branch tip"
            ],
            [
              "`@none`",
              "removes the requirement"
            ]
          ]
        },
        {
          "type": "code",
          "lang": "bash",
          "lines": [
            "go get example.com/dep@none    # drop it",
            "go get example.com/dep@abc123f # a commit"
          ],
          "runnable": false
        },
        {
          "type": "callout",
          "style": "tip",
          "title": "Retracted Skipped",
          "text": "`@latest` also ignores any version the author has retracted."
        },
        {
          "type": "sidebox",
          "title": "Tag Gotcha",
          "items": [
            "A tag only exists once it is pushed",
            "Local tags are invisible to the proxy and `go get`",
            "`git push --tags` or the release is not real"
          ],
          "ink": "red"
        },
        {
          "type": "callout",
          "style": "takeaway",
          "title": "Read It Field By Field",
          "text": "Version strings compare numerically per field, not lexically — never string-sort them."
        },
        {
          "type": "heading",
          "text": "The Rule",
          "ink": "accent"
        },
        {
          "type": "bullets",
          "items": [
            "Major 2 and above must appear in the module path",
            "`example.com/m/v2`, then `/v3`, and so on",
            "v0 and v1 share the bare path — no `/v1` suffix exists"
          ]
        },
        {
          "type": "paragraph",
          "text": "Two incompatible majors are simply two different modules. That is the whole trick: both can sit in one build."
        },
        {
          "type": "callout",
          "style": "takeaway",
          "title": "Import Compatibility Rule",
          "text": "If an import path is unchanged, the package it names must stay backwards compatible."
        },
        {
          "type": "heading",
          "text": "Cutting v2"
        },
        {
          "type": "code",
          "lang": "gomod",
          "lines": [
            "module example.com/m/v2  # bump the path",
            "// rewrite every self-import to /v2",
            "// then: git tag v2.0.0 && git push --tags"
          ],
          "runnable": false
        }
      ]
    },
    {
      "page_title": "Semantic Import Versioning",
      "blocks": [
        {
          "type": "diagram",
          "kind": "cards",
          "spec": {
            "cards": [
              {
                "title": "Branch layout",
                "lines": [
                  "tag `v2.0.0` on a branch",
                  "history stays linear",
                  "one major per branch"
                ]
              },
              {
                "title": "Subdirectory",
                "lines": [
                  "`/v2/go.mod` in the tree",
                  "tag `v2/v2.0.0`",
                  "one commit, many majors"
                ]
              }
            ]
          }
        },
        {
          "type": "heading",
          "text": "Coexistence"
        },
        {
          "type": "code",
          "lang": "go",
          "lines": [
            "import (",
            "  v1 \"example.com/m\"     // v1.5.0",
            "  v2 \"example.com/m/v2\"  // v2.1.0",
            ")"
          ],
          "runnable": false
        },
        {
          "type": "bullets",
          "items": [
            "Separate packages, separate types, separate state",
            "A v1 `Client` is NOT assignable to a v2 `Client`",
            "Conversion code between them is on you",
            "Diamond deps across majors are legal and common"
          ]
        },
        {
          "type": "heading",
          "text": "`+incompatible`"
        },
        {
          "type": "bullets",
          "items": [
            "A v2+ tag with no `go.mod` becomes `v2.0.0+incompatible`",
            "Treated as pre-modules code, path stays bare",
            "Adding `go.mod` at v2 supersedes the incompatible path",
            "One version cannot carry both semantics"
          ]
        },
        {
          "type": "sidebox",
          "title": "Errors To Memorise",
          "items": [
            "\"module declares its path as X but was required as Y\"",
            "\"go.mod has post-v1 module path\" — you forgot `/v2`",
            "Cause: tagged v2.0.0 without changing the module line"
          ],
          "ink": "red"
        },
        {
          "type": "callout",
          "style": "tip",
          "title": "Migrate Gradually",
          "text": "Keep v1 alive with fixes, ship v2 as a new module, then mark v1 `// Deprecated:` and `retract` it."
        },
        {
          "type": "heading",
          "text": "Highest Of The Minimums",
          "ink": "accent"
        },
        {
          "type": "bullets",
          "items": [
            "Build uses the MINIMUM version satisfying all requires",
            "Walk the requirement graph from the main module",
            "Collect every required version of each module",
            "Keep the highest of those, not the highest published"
          ]
        },
        {
          "type": "diagram",
          "kind": "flow",
          "spec": {
            "nodes": [
              "main go.mod",
              "walk graph",
              "collect requires",
              "max per module",
              "build list"
            ]
          }
        },
        {
          "type": "code",
          "lang": "text",
          "lines": [
            "main -> A v1.2.0, B v1.0.0",
            "B    -> A v1.5.0",
            "selected: A v1.5.0  # max of minimums"
          ],
          "runnable": false
        }
      ]
    },
    {
      "page_title": "MVS: How Versions Get Picked",
      "blocks": [
        {
          "type": "heading",
          "text": "Why No Solver"
        },
        {
          "type": "bullets",
          "items": [
            "Deterministic: no SAT search, no backtracking",
            "No lockfile — `go.mod` already holds the answer",
            "npm and Cargo pick highest allowed; Go picks lowest",
            "A new upstream release cannot change your build"
          ]
        },
        {
          "type": "callout",
          "style": "takeaway",
          "title": "Nothing Moves On Its Own",
          "text": "Adding a dependency never silently upgrades unrelated modules. Versions move only when you move them."
        },
        {
          "type": "heading",
          "text": "The Bill"
        },
        {
          "type": "bullets",
          "items": [
            "You can sit on an old version for years, missing fixes",
            "Upgrading is an explicit chore, never automatic",
            "No ranges, no `<2.0` caps, no constraint expressions",
            "Conflicts resolve by upgrading, never by downgrading"
          ]
        },
        {
          "type": "heading",
          "text": "Graph Pruning"
        },
        {
          "type": "bullets",
          "items": [
            "Go 1.17+: deps saying `go 1.17` load only direct deps",
            "Small graph, fast load, far fewer files fetched",
            "Price: more `// indirect` lines recorded in `go.mod`"
          ]
        },
        {
          "type": "heading",
          "text": "Debug Trio"
        },
        {
          "type": "table",
          "headers": [
            "Command",
            "Answers"
          ],
          "rows": [
            [
              "`go list -m all`",
              "what got selected"
            ],
            [
              "`go mod why -m dep`",
              "shortest path keeping it in"
            ],
            [
              "`go mod graph`",
              "every `from@v to@v` edge"
            ]
          ]
        },
        {
          "type": "code",
          "lang": "bash",
          "lines": [
            "go get -u ./...        # minor + patch",
            "go get -u=patch ./...  # patch only",
            "go get dep@latest      # one module",
            "go get dep@v1.2.0      # may downgrade others"
          ],
          "runnable": false
        },
        {
          "type": "callout",
          "style": "tip",
          "title": "Downgrades Cascade",
          "text": "Pinning a module lower forces down anything that required a higher version of it."
        },
        {
          "type": "heading",
          "text": "What go.sum Is",
          "ink": "accent"
        },
        {
          "type": "bullets",
          "items": [
            "Hashes for every module version in the graph",
            "NOT a lockfile — it selects nothing, it only verifies",
            "Two lines per module: the zip, and its `go.mod`"
          ]
        },
        {
          "type": "code",
          "lang": "text",
          "lines": [
            "example.com/dep v1.4.2 h1:AbC...",
            "example.com/dep v1.4.2/go.mod h1:XyZ...",
            "# h1 = base64 SHA-256 of sorted file hashes"
          ],
          "runnable": false
        },
        {
          "type": "sidebox",
          "title": "Mismatch Means Stop",
          "items": [
            "Any hash difference aborts the build: SECURITY ERROR",
            "\"checksum mismatch\" = content changed for a fixed version",
            "Investigate. Do not blindly delete `go.sum`"
          ],
          "ink": "red"
        },
        {
          "type": "heading",
          "text": "Proxy Path"
        },
        {
          "type": "diagram",
          "kind": "flow",
          "spec": {
            "nodes": [
              "go build",
              "proxy.golang.org",
              "direct VCS",
              "module cache",
              "compile"
            ]
          }
        }
      ]
    },
    {
      "page_title": "go.sum, Proxy, Checksum DB",
      "blocks": [
        {
          "type": "bullets",
          "items": [
            "`GOPROXY` defaults to `https://proxy.golang.org,direct`",
            "The proxy is an immutable cache of fetched versions",
            "Deleted upstream tags still resolve from it"
          ]
        },
        {
          "type": "heading",
          "text": "Env Knobs"
        },
        {
          "type": "table",
          "headers": [
            "Var",
            "Does"
          ],
          "rows": [
            [
              "`GOPRIVATE`",
              "sets no-proxy and no-sumdb at once"
            ],
            [
              "`GONOPROXY`",
              "skip the proxy for path globs"
            ],
            [
              "`GONOSUMDB`",
              "skip the checksum DB for globs"
            ],
            [
              "`GOMODCACHE`",
              "relocate the cache directory"
            ]
          ]
        },
        {
          "type": "bullets",
          "items": [
            "Globs are comma-separated prefixes: `github.com/org/*`",
            "`GONOSUMCHECK` and kin are obsolete names — ignore them",
            "`GOSUMDB` is `sum.golang.org`, a transparency log",
            "`-mod=mod` does not disable it; `GOPRIVATE` does",
            "Read every one of them back with `go env`"
          ]
        },
        {
          "type": "heading",
          "text": "Cache Commands"
        },
        {
          "type": "code",
          "lang": "bash",
          "lines": [
            "go mod download     # CI warm-up, fills cache",
            "go mod verify       # re-hash cache vs go.sum",
            "go clean -modcache  # wipe $GOPATH/pkg/mod"
          ],
          "runnable": false
        },
        {
          "type": "bullets",
          "items": [
            "Cache lives at `$GOPATH/pkg/mod`, read-only on disk",
            "`-mod=readonly` has been the default since 1.16",
            "Build fails instead of editing `go.mod` behind your back"
          ]
        },
        {
          "type": "callout",
          "style": "takeaway",
          "title": "Always Commit go.sum",
          "text": "Deleting and regenerating it trusts whatever the network serves today. That is the whole attack."
        },
        {
          "type": "heading",
          "text": "`replace` Forms",
          "ink": "accent"
        },
        {
          "type": "code",
          "lang": "gomod",
          "lines": [
            "replace a.com/dep => ../local/dep",
            "replace a.com/dep => a.com/fork v1.4.2",
            "replace a.com/dep v1.4.1 => a.com/dep v1.4.2"
          ],
          "runnable": false
        },
        {
          "type": "bullets",
          "items": [
            "Local path: live-edit a dependency without publishing",
            "Fork: swap by module path and version",
            "Third form replaces one specific version only",
            "Imports in your source are unchanged — original path"
          ]
        },
        {
          "type": "sidebox",
          "title": "Replace Rules",
          "items": [
            "Only the MAIN module's replaces apply",
            "Replaces inside a library are ignored downstream",
            "A filesystem target needs its own `go.mod`",
            "That target's requirements still feed MVS"
          ]
        },
        {
          "type": "callout",
          "style": "tip",
          "title": "Strip Before Tagging",
          "text": "Publishing a library that carries a local-path `replace` breaks every consumer of it."
        }
      ]
    },
    {
      "page_title": "replace, exclude, retract, Workspaces",
      "blocks": [
        {
          "type": "heading",
          "text": "`exclude`"
        },
        {
          "type": "bullets",
          "items": [
            "`exclude a.com/dep v1.4.1` skips a known-bad version",
            "MVS then picks the next higher one",
            "Main-module-only, exactly like `replace`",
            "Rarely right — bumping the `require` line is clearer"
          ]
        },
        {
          "type": "heading",
          "text": "`retract`"
        },
        {
          "type": "code",
          "lang": "gomod",
          "lines": [
            "retract v1.3.0 // accidental API break",
            "retract [v1.0.0, v1.2.0] // bad build"
          ],
          "runnable": false
        },
        {
          "type": "bullets",
          "items": [
            "The AUTHOR withdraws versions; add a `// reason`",
            "They vanish from `@latest` and `go list -m -versions`",
            "Still fetchable if a consumer pins them explicitly",
            "Published in a NEW higher version — retract = release again"
          ]
        },
        {
          "type": "heading",
          "text": "Workspaces"
        },
