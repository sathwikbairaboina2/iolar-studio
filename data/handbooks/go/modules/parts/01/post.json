              },
              "c0_1": {
                "text": "pkg/b"
              },
              "c1_0": {
                "text": "nested module"
              },
              "c2_0": {
                "text": "innermost wins"
              }
            },
            "edges": [
              {
                "from": "n0",
                "to": "b0"
              },
              {
                "from": "n0",
                "to": "b1"
              },
              {
                "from": "n0",
                "to": "b2"
              },
              {
                "from": "b0",
