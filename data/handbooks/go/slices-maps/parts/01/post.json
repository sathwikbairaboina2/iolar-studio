      "blocks": [
        {
          "type": "heading",
          "text": "What Slicing Computes",
          "ink": "blue"
        },
        {
          "type": "table",
          "headers": [
            "expr",
            "len",
            "cap"
          ],
          "rows": [
            [
              "`s[low:high]`",
              "high-low",
              "cap(s)-low"
            ],
            [
              "`s[:3]`",
              "3",
              "cap(s)"
            ],
            [
              "`s[2:]`",
              "len-2",
              "cap-2"
            ],
