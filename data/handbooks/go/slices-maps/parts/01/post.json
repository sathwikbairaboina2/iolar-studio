        },
        {
          "type": "heading",
          "text": "copy And Delete Idioms"
        },
        {
          "type": "bullets",
          "items": [
            "`copy(dst,src)` moves `min(len(dst),len(src))` and returns that count",
            "`copy` never grows `dst` — presize it yourself",
            "Overlap is memmove-safe: `copy(s[1:], s[:len(s)-1])` shifts right"
          ]
        }
      ]
    },
