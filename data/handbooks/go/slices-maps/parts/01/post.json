          "type": "heading",
          "text": "Reaching Past len",
          "ink": "red"
        },
        {
          "type": "bullets",
          "items": [
            "You may slice up to `cap`, not just `len`: `s[:cap(s)]`",
            "That resurrects stale data you thought was dropped",
            "Old elements stay readable until overwritten"
          ]
        },
        {
          "type": "diagram",
          "kind": "memory-cells",
          "spec": {
