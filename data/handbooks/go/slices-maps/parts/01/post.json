              "`s[:]`",
              "len(s)",
              "cap(s)"
            ]
          ]
        },
        {
          "type": "bullets",
          "items": [
            "Every sub-slice shares the SAME backing array",
            "Slicing never copies element data — only a new 3-word header",
            "Slicing an array takes its address, so writes flow back"
          ]
        },
        {
          "type": "code",
          "lang": "go",
          "lines": [
            "a := [5]int{1, 2, 3, 4, 5}",
