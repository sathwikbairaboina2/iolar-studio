          "title": "Git Basics Cheat Sheet",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Start, Save, History",
              "ink": "blue"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "Working tree",
                    "sub": "edit files",
                    "ink": "blue"
                  },
                  {
                    "text": "Staging",
                    "sub": "git add",
                    "ink": "orange"
                  },
                  {
                    "text": "Repository",
