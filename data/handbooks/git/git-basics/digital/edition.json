            },
            {
              "type": "heading",
              "text": "2. Branches and Remotes",
              "ink": "green"
            },
            {
              "type": "table",
              "headers": [
                "Goal",
                "Command"
              ],
              "rows": [
                [
                  "New branch",
                  "`git switch -c <name>`"
                ],
                [
                  "Merge in",
                  "`git merge <name>`"
                ],
                [
                  "Delete merged",
                  "`git branch -d <name>`"
                ],
                [
                  "List remotes",
                  "`git remote -v`"
                ],
                [
                  "Download only",
                  "`git fetch`"
                ],
                [
                  "Fetch + merge",
                  "`git pull`"
                ],
                [
                  "Publish",
                  "`git push -u origin <branch>`"
                ]
              ]
            },
            {
              "type": "heading",
              "text": "3. Top Mistakes",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "Committing ==secrets==: once pushed, kept in history",
                "`git add .` picking up ==junk==: use `.gitignore`",
                "==Force-pushing== shared branches",
                "Committing on the ==wrong branch==",
                "Forgetting `git status` before committing"
              ],
              "style": "cross",
              "ink": "red"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Before every commit",
