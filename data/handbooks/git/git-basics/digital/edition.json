    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "You run `git add app.py`, edit app.py again, then `git commit -m \"x\"`. What does `git status` show for app.py?",
              "a_bullets": [
                "The commit recorded the ==staged== version, which is the first edit",
                "The second edit was never staged, so app.py shows as ==modified==",
                "Nothing is staged any more"
              ]
            },
            {
              "type": "qa",
              "q": "You add `.env` to .gitignore, but `git status` still reports .env as modified. Why?",
              "a_bullets": [
                "`.gitignore` only skips ==untracked== files; .env is already tracked",
                "Run `git rm --cached .env`, then commit",
                "Old commits still hold the secret"
              ]
            },
            {
              "type": "qa",
              "q": "`git push` is rejected. What happened and what do you do?",
              "a_bullets": [
                "The remote has commits you lack",
                "`git pull`, resolve any conflicts, then push again",
                "Avoid `--force` on shared branches: it overwrites others' work"
              ]
            }
          ]
        }
      ]
    }
