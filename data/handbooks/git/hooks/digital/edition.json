  "sections": [
    {
      "title": "What Git Hooks Are",
      "role": "outline",
      "outlineIndex": 0,
      "pages": [
        {
          "title": "What Git Hooks Are",
          "blocks": [
            {
              "type": "heading",
              "text": "1. What a hook is",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "==Executable script== Git runs at a fixed event: commit, push, receive",
                "Plain file, **any language**, starts with a ==shebang==",
                "Lives in `.git/hooks/`, filename = hook name, no extension"
              ],
              "style": "dot",
              "ink": "green"
            },
            {
              "type": "heading",
              "text": "2. What Git runs",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "File in .git/hooks",
                "Git does"
              ],
              "rows": [
                [
                  "`pre-commit.sample`",
                  "{red:ignored}, has an extension"
                ],
                [
                  "`pre-commit`, no `chmod +x`",
                  "{red:ignored}, silently"
                ],
                [
                  "`pre-commit`, executable",
                  "{green:runs}"
                ]
              ],
              "highlightRow": 2
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "Event",
                    "sub": "commit",
                    "ink": "blue"
                  },
                  {
                    "text": "Hook runs",
                    "sub": "exit code",
                    "ink": "purple"
                  },
                  {
                    "text": "Exit 0",
                    "sub": "continues",
                    "ink": "green"
                  },
                  {
                    "text": "Non-zero",
                    "sub": "aborts",
                    "ink": "red"
                  }
                ]
              }
            },
            {
              "type": "heading",
              "text": "3. Example",
              "ink": "purple"
            },
            {
              "type": "code",
              "lang": "bash",
              "lines": [
                "#!/bin/sh",
                "npm test || exit 1",
                "# chmod +x .git/hooks/pre-commit"
              ],
              "note": ".git/hooks/pre-commit blocks the commit if tests fail"
            },
            {
              "type": "heading",
              "text": "4. Mistakes",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "Hooks are ==local==: `.git/hooks` is never cloned or pushed",
                "Teammates **do not get** your hooks"
              ],
              "style": "cross",
              "ink": "red"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Remember",
              "text": "Any client hook that runs ==before== the action and exits non-zero aborts it: pre-commit, prepare-commit-msg, commit-msg, pre-push. `post-*` hooks cannot abort."
            }
          ]
        }
      ]
    },
    {
      "title": "Client-Side Hooks",
      "role": "outline",
      "outlineIndex": 1,
      "pages": [
        {
          "title": "Client-Side Hooks",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Hooks that run before",
              "ink": "blue"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "pre-commit",
                    "sub": "lint staged",
                    "ink": "blue"
                  },
                  {
                    "text": "prepare-commit-msg",
                    "sub": "pre-fill",
                    "ink": "purple"
                  },
                  {
                    "text": "commit-msg",
                    "sub": "validate",
                    "ink": "orange"
                  },
                  {
                    "text": "post-commit",
                    "sub": "notify",
                    "ink": "green"
                  }
                ]
              }
            },
            {
              "type": "table",
              "headers": [
                "Hook",
                "Gets",
                "Use"
              ],
              "rows": [
                [
                  "`pre-commit`",
                  "nothing",
                  "lint, format, fast tests"
                ],
                [
                  "`prepare-commit-msg`",
                  "message file",
                  "pre-fill the editor text"
                ],
                [
                  "`commit-msg`",
                  "`$1` = message file",
                  "validate the message"
                ],
                [
                  "`pre-push`",
                  "remote name + URL; refs on stdin",
                  "full test suite"
                ]
              ]
            },
            {
              "type": "heading",
              "text": "2. Validate the message",
              "ink": "purple"
            },
            {
              "type": "bullets",
              "items": [
                "`commit-msg` reads the file at ==$1==, exits non-zero to reject",
                "Regex enforces **Conventional Commits**"
              ],
              "style": "dot"
            },
            {
              "type": "code",
              "lang": "bash",
              "lines": [
                "#!/bin/sh",
                "grep -qE '^(feat|fix|chore|docs)(\\(.+\\))?: .+' \"$1\" || { echo 'Bad message'; exit 1; }"
              ],
              "note": ".git/hooks/commit-msg"
            },
            {
              "type": "heading",
              "text": "3. Hooks that run after",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "`post-commit`, `post-merge`, `post-checkout` run ==after== the action",
                "Use: notifications, reinstalling dependencies",
                "Any hook that runs before and exits non-zero {red:aborts}; post-* hooks {green:cannot}"
              ],
              "style": "check"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Remember",
              "text": "Before-hooks (pre-commit, prepare-commit-msg, commit-msg, pre-push) can abort. post-* hooks never can."
            }
          ]
        }
      ]
    },
    {
      "title": "Server-Side Hooks",
      "role": "outline",
      "outlineIndex": 2,
      "pages": [
        {
          "title": "Server-Side Hooks",
          "blocks": [
            {
              "type": "heading",
              "text": "1. The Three Hooks",
              "ink": "green"
            },
            {
              "type": "table",
              "headers": [
                "Hook",
                "Runs",
                "Can reject?"
              ],
              "rows": [
                [
                  "`pre-receive`",
                  "once per push",
                  "{red:whole push}"
                ],
                [
                  "`update`",
                  "once per ref",
                  "{orange:that ref only}"
                ],
                [
                  "`post-receive`",
                  "after accept",
                  "{green:never}"
                ]
              ]
            },
            {
              "type": "heading",
              "text": "2. Inputs and Use",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "They run on the ==remote repository==, not the client",
                "`pre-receive` stdin: lines of `old-sha new-sha refname`; ==non-zero== rejects all",
                "`update` args: `refname old-sha new-sha`",
                "`post-receive`: CI triggers, deploys, notifications"
              ],
              "style": "dot"
            },
            {
              "type": "code",
              "lang": "bash",
              "lines": [
                "while read old new ref; do",
                "  if [ \"$ref\" = refs/heads/main ]; then",
                "    echo \"main is locked\"; exit 1",
                "  fi",
                "done"
              ],
              "note": "pre-receive: reject any push touching main"
            },
            {
              "type": "heading",
              "text": "3. Hosted Platforms",
              "ink": "purple"
            },
            {
              "type": "bullets",
              "items": [
                "GitHub and GitLab ==usually do not expose== these hooks",
                "Use {green:protected branches}, {green:required checks} or {green:webhooks}"
              ],
              "style": "check"
            },
            {
              "type": "heading",
              "text": "4. Interview Point",
              "ink": "orange"
            },
            {
              "type": "bullets",
              "items": [
                "**Reject one branch, accept the rest?** Use `update`; it runs per ref",
                "**Why can post-receive not reject?** The push is already accepted",
                "**Server hooks on GitHub?** Not exposed; use protected branches or webhooks"
              ],
              "style": "dot"
            }
          ]
        }
      ]
    },
    {
      "title": "Sharing Hooks with core.hooksPath",
      "role": "outline",
      "outlineIndex": 3,
      "pages": [
        {
          "title": "Sharing Hooks with core.hooksPath",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Tracked Hooks Folder",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "`git config core.hooksPath .githooks` ==points Git at a tracked folder==",
                "Used instead of `.git/hooks`, so hooks are ==versioned== with the repo",
                "It is **local config**: each clone must run it ==once==",
                "Put it in a setup script or a `make` target"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "heading",
              "text": "2. Local vs Global",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "Scope",
                "Command",
                "Effect"
              ],
              "rows": [
                [
                  "Repo",
                  "`git config core.hooksPath .githooks`",
                  "This repo only"
                ],
                [
                  "All repos",
                  "`git config --global core.hooksPath <dir>`",
                  "One path for every repo"
                ]
              ],
              "highlightRow": 1
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Global replaces .git/hooks",
              "text": "With --global, a repo's own ==local hooks stop running==. Git reads only the hooksPath folder."
            },
            {
              "type": "heading",
              "text": "3. Executable Bit and Check",
              "ink": "purple"
            },
            {
              "type": "bullets",
              "items": [
                "Tracked hook files still need the ==executable bit==",
                "`git update-index --chmod=+x` records it in Git",
                "`git config core.hooksPath` shows the active path",
                "{red:Empty value} = default `.git/hooks`"
              ],
              "style": "check"
            },
            {
              "type": "code",
              "lang": "bash",
              "lines": [
                "git update-index --chmod=+x .githooks/pre-commit",
                "git config core.hooksPath"
              ],
              "note": "the second command prints the active path"
            },
            {
              "type": "code",
              "lang": "output",
              "lines": [
                ".githooks"
              ]
            }
          ]
        }
      ]
    },
    {
      "title": "Tools: pre-commit and husky",
      "role": "outline",
      "outlineIndex": 4,
      "pages": [
        {
          "title": "Tools: pre-commit and husky",
          "blocks": [
            {
              "type": "heading",
              "text": "1. pre-commit (Python framework)",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "Config file: ==.pre-commit-config.yaml== listing `repo`, `rev` and hook `id`s",
                "Run `pre-commit install` ==once== to put the Git hook in place",
                "Hooks run on ==staged files only== by default"
              ],
              "style": "dot"
            },
            {
              "type": "code",
              "lang": "yaml",
              "lines": [
                "repos:",
                "  - repo: https://github.com/pre-commit/pre-commit-hooks",
                "    rev: v4.6.0",
                "    hooks:",
                "      - id: end-of-file-fixer"
              ],
              "note": "repo + pinned rev + hook ids"
            },
            {
              "type": "table",
              "headers": [
                "Command",
                "Effect"
              ],
              "rows": [
                [
                  "`pre-commit install`",
                  "Enable the Git hook"
                ],
                [
                  "`pre-commit run --all-files`",
                  "Run on the {green:whole repo}"
                ],
                [
                  "`pre-commit autoupdate`",
                  "Bump pinned `rev`s"
                ]
              ]
            },
            {
              "type": "heading",
              "text": "2. husky + lint-staged (Node)",
              "ink": "green"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "npx husky init",
                    "sub": "creates .husky/",
                    "ink": "blue"
                  },
                  {
                    "text": "prepare script",
                    "sub": "runs on install",
                    "ink": "green"
                  },
                  {
                    "text": "core.hooksPath",
                    "sub": ".husky/_",
                    "ink": "purple"
                  },
                  {
                    "text": ".husky/pre-commit",
                    "sub": "npx lint-staged",
                    "ink": "orange"
                  }
                ]
              }
            },
            {
              "type": "code",
              "lang": "json",
              "lines": [
                "{",
                "  \"scripts\": { \"prepare\": \"husky\" },",
                "  \"lint-staged\": { \"*.js\": \"eslint --fix\" }",
                "}"
              ],
              "note": "package.json"
            },
            {
              "type": "bullets",
              "items": [
                "lint-staged lints ==staged files only==",
                "Auto-fixed files are ==re-staged== by default"
              ],
              "style": "check"
            },
            {
              "type": "heading",
              "text": "3. Which one?",
              "ink": "orange"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Pick by repo",
              "text": "==pre-commit== for polyglot or Python repos. ==husky + lint-staged== for Node projects."
            }
          ]
        }
      ]
    },
    {
      "title": "Skipping Hooks, Mistakes and Cheat Sheet",
      "role": "outline",
      "outlineIndex": 5,
      "pages": [
        {
          "title": "Skipping Hooks, Mistakes and Cheat Sheet",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Skipping Hooks",
              "ink": "orange"
            },
            {
              "type": "table",
              "headers": [
                "Command",
                "Skips",
                "Never skips"
              ],
              "rows": [
                [
                  "`git commit --no-verify` (`-n`)",
                  "pre-commit, commit-msg",
                  "server-side hooks"
                ],
                [
                  "`git push --no-verify`",
                  "pre-push",
                  "server-side hooks"
                ]
              ],
              "frame": "dashed"
            },
            {
              "type": "bullets",
              "items": [
                "`HUSKY=0` ==disables husky== for that command",
                "`SKIP=hook-id` skips named pre-commit hooks, keeps the rest"
              ],
              "style": "dot"
            },
            {
              "type": "code",
              "lang": "bash",
              "lines": [
                "HUSKY=0 git commit -m \"wip\"",
                "SKIP=flake8 git commit -m \"wip\""
              ]
            },
            {
              "type": "heading",
              "text": "2. Common Mistakes",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "Slow pre-commit (full test suite) pushes people to ==--no-verify==",
                "Keep pre-commit fast; move heavy checks to ==pre-push== and CI",
                "Client hooks are skippable: never rely on them for enforcement",
                "Repeat critical checks in ==CI== or server-side"
              ],
              "style": "cross",
              "frame": "dashed",
              "ink": "red"
            },
            {
              "type": "heading",
              "text": "3. Cheat Sheet",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "Hook / setting",
                "Job"
              ],
              "rows": [
                [
                  "`pre-commit`",
                  "lint staged files"
                ],
                [
                  "`commit-msg`",
                  "validate message"
                ],
                [
                  "`pre-push`",
                  "run tests"
                ],
                [
                  "`pre-receive`",
                  "reject push"
                ],
                [
                  "`core.hooksPath`",
                  "share hooks"
                ],
                [
                  "`--no-verify`",
                  "bypass client hooks"
                ]
              ]
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Remember",
              "text": "Any client hook that runs ==before the action== (pre-commit, prepare-commit-msg, commit-msg, pre-push) aborts on non-zero exit. `post-*` hooks cannot abort."
            }
          ]
        }
      ]
    },
    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "A `.git/hooks/pre-commit` script ends with `exit 1`, yet commits still succeed. Likely cause?",
              "a_bullets": [
                "The file is not ==executable==, so Git silently ignores it",
                "Fix: `chmod +x .git/hooks/pre-commit`"
              ]
            },
            {
              "type": "qa",
              "q": "A `post-receive` hook exits 1 after a push. Is the push rejected?",
              "a_bullets": [
                "No: the push was already accepted before the hook ran",
                "Only `pre-receive` and `update` can reject"
              ]
            },
            {
              "type": "qa",
              "q": "After `git config core.hooksPath .githooks`, what happens to `.git/hooks/pre-commit`?",
              "a_bullets": [
                "Git reads hooks from `.githooks` instead, so it stops running",
                "The setting is local, so each clone must run it once"
              ]
            },
            {
              "type": "qa",
              "q": "`git commit --no-verify` is used with a bad message. What is skipped, and what can still catch it?",
              "a_bullets": [
                "It skips `pre-commit` and `commit-msg`",
                "Server-side hooks and CI still run, so repeat critical checks there"
              ]
            }
          ]
        }
      ]
    }
  ]
}