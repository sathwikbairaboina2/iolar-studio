              "--git-common-dir"
            ]
          ]
        },
        {
          "type": "code",
          "lang": "bash",
          "lines": [
            "HOOKS=$(git rev-parse --git-common-dir)/hooks",
            "# correct in main and linked worktrees"
          ]
        },
        {
          "type": "heading",
          "text": "pop Is Not Atomic",
          "ink": "red"
        },
        {
          "type": "code",
          "lang": "bash",
          "lines": [
            "git stash pop || echo \"conflict!\"",
            "git stash list    # verify it is gone"
          ]
        },
        {
          "type": "bullets",
          "items": [
            "Never assume a scripted pop succeeded",
            "Check the exit code, then inspect the list"
          ]
        },
        {
          "type": "bullets",
          "items": [
            "Deleting a branch a linked worktree holds is blocked",
            "==`git branch -D` is blocked too== — no `--force` escape",
            "The `builtin/branch.c` check is not gated on force",
            "Errors: branch 'x' **used by worktree at** '<path>'",
            "Fix: `git worktree remove <path>` first, then delete",
            "Or switch that worktree to another branch"
          ]
        },
        {
          "type": "heading",
          "text": "Decision Table",
          "ink": "blue"
        },
        {
          "type": "table",
          "headers": [
            "Situation",
            "Pick"
          ],
          "rows": [
            [
              "<10 min, small diff",
              "stash"
            ],
            [
              "Parallel or hot build",
              "worktree"
            ],
            [
              "Side-by-side compare",
              "worktree"
            ],
            [
              "Own config or hooks",
              "clone"
            ],
            [
              "Clean tree, just moving",
              "git switch"
            ]
          ]
        },
        {
          "type": "heading",
          "text": "The Two Shapes"
        },
        {
          "type": "bullets",
          "items": [
            "Stash = hidden 2-or-3-parent commits",
            "Stacked on `refs/stash`, indexed by reflog",
            "Worktree = extra dir, own HEAD and index",
            "Listed in `.git/worktrees/`, shared objects"
          ]
        },
        {
          "type": "heading",
          "text": "Habits That Save You"
        },
        {
          "type": "bullets",
          "items": [
            "Label every stash with `-m`",
            "Include untracked with `-u`",
            "`apply` → verify → `drop`, never a blind pop",
            "Promote keepers with `git stash branch`",
            "Remove worktrees, then `prune`"
          ],
          "style": "checkbox"
        },
        {
          "type": "callout",
          "style": "takeaway",
          "title": "One-line recall",
          "text": "Stash ==time-multiplexes== one working tree; worktrees ==space-multiplex== many trees over one history."
        },
        {
          "type": "heading",
          "text": "Cheat Sheet"
        },
        {
          "type": "code",
          "lang": "bash",
          "lines": [
            "git stash push -u -m \"msg\"",
            "git stash apply && git stash drop",
            "git worktree add -b br ../dir",
            "git worktree remove ../dir"
          ]
        }
      ]
    }
