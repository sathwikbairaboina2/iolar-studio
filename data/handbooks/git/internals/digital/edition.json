    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "History is A←B←C. You amend B. What happens to C?",
              "a_bullets": [
                "A new commit B' replaces B; C still points to the old B and keeps its hash",
                "The branch tip now reaches B', so C is orphaned",
                "C gets a new hash only if replayed, e.g. rebased onto B'"
              ]
            },
            {
              "type": "qa",
              "q": "After `git branch -D feat`, are its commits gone?",
              "a_bullets": [
                "Usually not gone: reflog entries still reference them, so gc skips them",
                "Lost only after the reflog entries expire and gc prunes, or if objects are deleted by hand"
              ]
            },
            {
              "type": "qa",
              "q": "Two repos each run `echo hi | git hash-object --stdin`. Same hash?",
              "a_bullets": [
                "Yes: the hash depends only on the header `blob size` plus the content",
                "Without `-w`, nothing is written to .git/objects"
              ]
            },
            {
              "type": "qa",
              "q": "In detached HEAD you commit, then run `git switch main`. Where is that commit?",
              "a_bullets": [
                "Still in the object store, but only the reflog reaches it",
                "Recover it: find the hash in `git reflog`, then `git branch rescue <sha>`"
              ]
            }
          ]
        }
      ]
    }
  ]
