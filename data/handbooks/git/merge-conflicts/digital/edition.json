  "inputsHash": "d19ee377b0ccdd744e48bdf31e992a4a80b5a3f1083e2812271f9fc7d8a39116",
  "generatedAt": "2026-10-16T06:46:42.207Z",
  "sections": [
    {
      "title": "Why Conflicts Happen",
      "role": "outline",
      "outlineIndex": 0,
      "pages": [
        {
          "title": "Why Conflicts Happen",
          "blocks": [
            {
              "type": "heading",
              "text": "1. What a conflict is",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "==Conflict== = Git refuses to guess",
                "Two commits changed the **same lines** since their merge base",
                "Or one edited a file the other **deleted**",
                "**Merge base** = last shared commit; ours = your branch; theirs = incoming"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "table",
              "headers": [
                "Case",
                "Base",
                "Ours",
                "Theirs",
                "Result"
              ],
              "rows": [
                [
                  "Only theirs changed",
                  "A",
                  "A",
                  "B",
                  "B (auto)"
                ],
                [
                  "Only ours changed",
                  "A",
                  "B",
                  "A",
                  "B (auto)"
                ],
                [
                  "Both, differently",
                  "A",
                  "B",
                  "C",
                  "{red:CONFLICT}"
                ]
              ],
              "highlightRow": 2
            },
            {
              "type": "heading",
              "text": "2. Common triggers",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "==Same-line== edits",
                "==Edit vs delete==",
                "{red:rename/rename} (named differently) or rename/delete",
                "{red:add/add}: same path, ==different content==",
                "Rename on one side + edit on the other merges ==cleanly=="
              ],
              "style": "cross",
              "ink": "red"
            },
            {
              "type": "heading",
              "text": "3. Where it shows up",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "Can conflict: `merge`, `rebase`, `cherry-pick`, `stash pop`, `revert`"
              ],
              "style": "dot"
            },
            {
              "type": "bullets",
              "items": [
                "`git status` lists ==Unmerged paths==, **both modified**",
                "`MERGE_HEAD` or a `rebase-merge` dir exists until you finish"
              ],
              "style": "check"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Paused, not failed",
              "text": "The operation stays open until every path is resolved."
            }
          ]
        }
      ]
    },
    {
      "title": "Reading Conflict Markers",
      "role": "outline",
      "outlineIndex": 1,
      "pages": [
        {
          "title": "Reading Conflict Markers",
          "blocks": [
            {
              "type": "heading",
              "text": "1. The three markers",
              "ink": "blue"
            },
            {
              "type": "code",
              "lang": "text",
              "lines": [
                "<<<<<<< HEAD",
                "timeout = 30",
                "=======",
                "timeout = 60",
                ">>>>>>> feature"
              ],
              "note": "Markers start at column 0"
            },
            {
              "type": "bullets",
              "items": [
                "{blue:`<<<<<<< HEAD` to `=======`}: ==your current side==",
                "{green:`=======` to `>>>>>>> feature`}: the ==incoming side==",
                "In a **rebase** the HEAD side is the upstream branch; the flip is covered in the ours/theirs section"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "blue"
            },
            {
              "type": "heading",
              "text": "2. Show the base",
              "ink": "purple"
            },
            {
              "type": "bullets",
              "items": [
                "`diff3` or `zdiff3` adds a `|||||||` section with the ==original text==",
                "Seeing the base makes each side's intent easy to judge",
                "Make the base section the default:"
              ],
              "style": "dot",
              "ink": "purple"
            },
            {
              "type": "code",
              "lang": "bash",
              "lines": [
                "git config --global merge.conflictStyle zdiff3"
              ]
            },
            {
              "type": "heading",
              "text": "3. Resolve and check",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "Pick ==ours==, ==theirs==, or a **hand-written mix**",
                "Edit to the final text; delete all three marker lines",
                "Result must also {green:compile} and {green:pass tests}"
              ],
              "style": "check",
              "ink": "green"
            },
            {
              "type": "table",
              "headers": [
                "Find leftovers before `git add`",
                "Command"
              ],
              "rows": [
                [
                  "Whitespace and marker check",
                  "`git diff --check`"
                ],
                [
                  "Search the tree",
                  "`grep -rn '<<<<<<<' .`"
                ]
              ]
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Classic mistake",
              "text": "Staging a file that still has ==marker lines==. Run the check first."
            }
          ]
        }
      ]
    },
    {
      "title": "Resolve and Continue a Merge or Rebase",
      "role": "outline",
      "outlineIndex": 2,
      "pages": [
        {
          "title": "Resolve and Continue a Merge or Rebase",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Merge Workflow",
              "ink": "green"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "git merge feature",
                    "sub": "stops on conflict",
                    "ink": "red"
                  },
                  {
                    "text": "git status",
                    "sub": "find both modified",
                    "ink": "blue"
                  },
                  {
                    "text": "Edit files",
                    "sub": "remove markers",
                    "ink": "orange"
                  },
                  {
                    "text": "git add <file>",
                    "sub": "marks resolved",
                    "ink": "green"
                  },
                  {
                    "text": "git commit",
                    "sub": "message pre-filled",
                    "ink": "purple"
                  }
                ]
              }
            },
            {
              "type": "heading",
              "text": "2. Rebase Workflow",
              "ink": "blue"
            },
            {
              "type": "diagram",
              "kind": "chain",
              "spec": {
                "steps": [
                  {
                    "text": "git rebase main",
                    "note": "stops at 1st bad commit",
                    "ink": "red"
                  },
                  {
                    "text": "Fix files, git add <file>",
                    "ink": "green"
                  },
                  {
                    "text": "git rebase --continue",
                    "note": "repeat per conflicting commit",
                    "ink": "blue"
                  }
                ]
              }
            },
            {
              "type": "bullets",
              "items": [
                "`git add` alone marks a file ==resolved==",
                "Rebase needs ==no commit== in between, only `--continue`",
                "`git rebase --skip` ==drops== the current commit"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "blue"
            },
            {
              "type": "heading",
              "text": "3. Track and Reuse",
              "ink": "purple"
            },
            {
              "type": "bullets",
              "items": [
                "Still conflicting: `git diff --name-only --diff-filter=U`",
                "==rerere== records your resolution and replays it on a repeat conflict"
              ],
              "style": "check"
            },
            {
              "type": "code",
              "lang": "bash",
              "lines": [
                "git config rerere.enabled true"
              ],
              "note": "enable once, then repeated conflicts resolve themselves"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Finish step differs",
              "text": "Merge ends with ==git commit==. Rebase ends with ==git rebase --continue==. Never commit mid-rebase."
            }
          ]
        }
      ]
    },
    {
      "title": "Ours, Theirs and Mergetool",
      "role": "outline",
      "outlineIndex": 3,
      "pages": [
        {
          "title": "Ours, Theirs and Mergetool",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Ours vs theirs",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "",
                "ours",
                "theirs"
              ],
              "rows": [
                [
                  "merge",
                  "branch you are on",
                  "branch merged in"
                ],
                [
                  "rebase",
                  "upstream you rebase onto",
                  "your commit replayed"
                ]
              ],
              "highlightRow": 1
            },
            {
              "type": "heading",
              "text": "2. Picking a side",
              "ink": "green"
            },
            {
              "type": "code",
              "lang": "bash",
              "lines": [
                "git checkout --ours app.py",
                "git checkout --theirs app.py",
                "git add app.py"
              ],
              "note": "whole file one way, then stage"
            },
            {
              "type": "table",
              "headers": [
                "Option",
                "Effect"
              ],
              "rows": [
                [
                  "`-X ours` / `-X theirs`",
                  "decides {red:conflicting hunks} only; rest still merges"
                ],
                [
                  "`-s ours`",
                  "==discards== the other branch's changes entirely"
                ]
              ]
            },
            {
              "type": "heading",
              "text": "3. Mergetool",
              "ink": "purple"
            },
            {
              "type": "bullets",
              "items": [
                "`git mergetool` opens a 3-way view: ==LOCAL==, ==BASE==, ==REMOTE==, ==MERGED==",
                "Edit **MERGED**, save, quit",
                "Choose the tool: `git config merge.tool <name>`",
                "No stray `.orig` files: `git config mergetool.keepBackup false`"
              ],
              "style": "dot"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Rebase flip",
              "text": "In a rebase, ==ours== is the upstream and ==theirs== is your own commit."
            },
            {
              "type": "sidebox",
              "title": "Interview Point",
              "items": [
                "**Ours in a rebase?** The upstream branch; theirs is your replayed commit.",
                "**`-X ours` vs `-s ours`?** Hunks only vs the whole other branch dropped.",
                "**Leftover `.orig`?** Set `mergetool.keepBackup` to false."
              ],
              "ink": "orange"
            }
          ]
        }
      ]
    },
    {
      "title": "Aborting and Avoiding Conflicts",
      "role": "outline",
      "outlineIndex": 4,
      "pages": [
        {
          "title": "Aborting and Avoiding Conflicts",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Bail Out Cleanly",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "==Abort== restores the state from before the operation",
                "Use the command that matches what you started"
              ],
              "style": "dot"
            },
            {
              "type": "code",
              "lang": "bash",
              "lines": [
                "git merge --abort",
                "git rebase --abort",
                "git cherry-pick --abort"
              ],
              "note": "each one resets branch, index and files"
            },
            {
              "type": "heading",
              "text": "2. Bad Resolutions",
              "ink": "orange"
            },
            {
              "type": "bullets",
              "items": [
                "Committing a file that still has ==markers== is the classic mistake",
                "Run `git diff --check` before every commit"
              ],
              "style": "cross",
              "ink": "red"
            },
            {
              "type": "table",
              "headers": [
                "Already committed",
                "Undo with"
              ],
              "rows": [
                [
                  "A bad merge",
                  "`git reset --hard ORIG_HEAD`"
                ],
                [
                  "Anything else",
                  "`git reflog`, then reset to the earlier entry"
                ]
              ]
            },
            {
              "type": "heading",
              "text": "3. Avoid Conflicts",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "==Pull or rebase often==",
                "Keep branches **short-lived**",
                "Make small, focused commits",
                "Never reformat whole files"
              ],
              "style": "check",
              "ink": "green"
            },
            {
              "type": "sidebox",
              "title": "Hot and generated files",
              "items": [
                "Agree on ==ownership== of hot files",
                "Regenerate lockfiles (`npm install`), never hand-merge",
                "Let a formatter rewrite formatting"
              ],
              "ink": "blue"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Remember",
              "text": "Stuck mid-merge? `--abort` is free. After committing, `ORIG_HEAD` is your way back."
            }
          ]
        }
      ]
    },
    {
      "title": "Merge Conflict Cheat Sheet",
      "role": "outline",
      "outlineIndex": 5,
      "pages": [
        {
          "title": "Merge Conflict Cheat Sheet",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Inspect",
              "ink": "blue"
            },
            {
              "type": "code",
              "lang": "bash",
              "lines": [
                "git status",
                "git diff",
                "git diff --name-only --diff-filter=U",
                "git log --merge"
              ],
              "note": "U = still unmerged"
            },
            {
              "type": "heading",
              "text": "2. Resolve and pick a side",
              "ink": "green"
            },
            {
              "type": "table",
              "headers": [
                "",
                "Merge",
                "Rebase"
              ],
              "rows": [
                [
                  "Finish",
                  "`git commit`",
                  "`git rebase --continue`"
                ],
                [
                  "`--ours`",
                  "your branch",
                  "{red:upstream}"
                ],
                [
                  "`--theirs`",
                  "merged-in branch",
                  "{red:your commit}"
                ]
              ],
              "highlightRow": 1
            },
            {
              "type": "code",
              "lang": "bash",
              "lines": [
                "git checkout --theirs <file>",
                "git add <file>"
              ],
              "note": "edit, then git add marks it resolved"
            },
            {
              "type": "heading",
              "text": "3. Escape and setup",
              "ink": "purple"
            },
            {
              "type": "table",
              "headers": [
                "Escape",
                "Command"
              ],
              "rows": [
                [
                  "Merge",
                  "`git merge --abort`"
                ],
                [
                  "Rebase",
                  "`git rebase --abort`"
                ],
                [
                  "Bad merge done",
                  "`git reset --hard ORIG_HEAD`"
                ]
              ]
            },
            {
              "type": "bullets",
              "items": [
                "`merge.conflictStyle zdiff3`",
                "`rerere.enabled true`",
                "`merge.tool <name>`",
                "`mergetool.keepBackup false`"
              ],
              "style": "check",
              "frame": "dashed"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Rebase flip",
              "text": "In a rebase ==ours== is the branch you rebase onto, ==theirs== is your own commit."
            }
          ]
        }
      ]
    },
    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "During `git rebase main` you want your own commit's version of app.py. Which flag?",
              "a_bullets": [
                "`git checkout --theirs app.py`",
                "Rebase flips sides: theirs is your replayed commit",
                "Then `git add`, `git rebase --continue`"
              ]
            },
            {
              "type": "qa",
              "q": "After the merge commit, tests fail with a syntax error at a ======= line. What went wrong?",
              "a_bullets": [
                "Conflict markers were committed unresolved",
                "`git add` marks a file resolved without checking its content",
                "Run `git diff --check` before staging"
              ]
            },
            {
              "type": "qa",
              "q": "Mid-rebase you fixed a file and ran `git add`. What next?",
              "a_bullets": [
                "`git rebase --continue`",
                "No `git commit` needed here",
                "Repeat for each conflicting commit"
              ]
            },
            {
              "type": "qa",
              "q": "`git merge -X theirs feature` vs `git merge -s ours feature`: what differs?",
              "a_bullets": [
                "`-X theirs`: conflicting hunks take feature, the rest still merges",
                "`-s ours`: records the merge but keeps your tree unchanged"
              ]
            }
          ]
        }
      ]
    }
  ]
}