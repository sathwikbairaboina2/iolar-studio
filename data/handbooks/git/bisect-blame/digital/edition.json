  "sections": [
    {
      "title": "History Archaeology Mental Model",
      "role": "outline",
      "outlineIndex": 0,
      "pages": [
        {
          "title": "History Archaeology Mental Model",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Question to tool",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "Question",
                "Tool"
              ],
              "rows": [
                [
                  "Which commits touched X?",
                  "`log` filters"
                ],
                [
                  "String appeared or vanished?",
                  "`log -S` / `-G`"
                ],
                [
                  "Who last changed this line?",
                  "`blame`"
                ],
                [
                  "What did that commit do?",
                  "`show`"
                ],
                [
                  "Which commit broke it?",
                  "`bisect`"
                ]
              ]
            },
            {
              "type": "heading",
              "text": "2. The history model",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "History = ==DAG== of immutable snapshots",
                "`log`, `blame`, `show` only **read**: always safe",
                "`git log` walks from ==HEAD== back through parents",
                "`A..B` = commits in B not in A; bounds the search"
              ],
              "style": "dot"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "Narrow",
                    "sub": "path, author, date, message",
                    "ink": "blue"
                  },
                  {
                    "text": "Pick sha",
                    "sub": "log --oneline",
                    "ink": "green"
                  },
                  {
                    "text": "Inspect",
                    "sub": "show sha",
                    "ink": "purple"
                  }
                ]
              }
            },
            {
              "type": "heading",
              "text": "3. Blame goes one layer",
              "ink": "orange"
            },
            {
              "type": "bullets",
              "items": [
                "Blame shows the ==last commit== to touch a line",
                "Not the commit that introduced the idea",
                "Go deeper: `-L` range or `blame <sha>^`"
              ],
              "style": "dot"
            },
            {
              "type": "code",
              "lang": "bash",
              "lines": [
                "git blame -L 40,60 app.py",
                "git blame a1b2c3d^ -- app.py"
              ]
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Reformat trap",
              "text": "The last toucher may be a whitespace commit. Dig past it."
            },
            {
              "type": "bullets",
              "items": [
                "**Is blame safe to run?** Yes, read-only.",
                "**Commits in B but not A?** `git log A..B`"
              ],
              "style": "check"
            }
          ]
        }
      ]
    },
    {
      "title": "Filtering git log",
      "role": "outline",
      "outlineIndex": 1,
      "pages": [
        {
          "title": "Filtering git log",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Filter by metadata",
              "ink": "green"
            },
            {
              "type": "table",
              "headers": [
                "Flag",
                "Keeps commits..."
              ],
              "rows": [
                [
                  "`--author=\"name\"`",
                  "by that author"
                ],
                [
                  "`--since=\"2 weeks ago\"`",
                  "after a date"
                ],
                [
                  "`--until=2026-01-01`",
                  "before a date"
                ],
                [
                  "`--grep=\"fix\"`",
                  "message matches regex; `-i` ignores case"
                ],
                [
                  "`-- path/file`",
                  "that touched the path"
                ],
                [
                  "`--follow`",
                  "one file, across ==renames=="
                ]
              ]
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Double dash",
              "text": "Put `--` ==before the path==, or Git may read it as a branch name. `--follow` works on a single file only."
            },
            {
              "type": "heading",
              "text": "2. Shape and detail",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "Flag",
                "Effect"
              ],
              "rows": [
                [
                  "`-p`",
                  "adds the patch"
                ],
                [
                  "`--stat`",
                  "files changed"
                ],
                [
                  "`--name-status`",
                  "A/M/D/R per file"
                ],
                [
                  "`--no-merges` / `--merges`",
                  "hide merges / only merges"
                ],
                [
                  "`-n 5`",
                  "limit the count"
                ],
                [
                  "`--first-parent`",
                  "mainline only"
                ]
              ],
              "frame": "dashed"
            },
            {
              "type": "heading",
              "text": "3. Views",
              "ink": "purple"
            },
            {
              "type": "bullets",
              "items": [
                "`--oneline --graph --decorate --all`: ==compact topology== of every branch",
                "`--pretty=format:` with `--date=short` sets your own columns",
                "`%h` hash, `%an` author, `%ad` date, `%s` subject"
              ],
              "style": "dot"
            },
            {
              "type": "code",
              "lang": "bash",
              "lines": [
                "git log --pretty=format:\"%h %an %ad %s\" --date=short"
              ]
            },
            {
              "type": "code",
              "lang": "output",
              "lines": [
                "a1b2c3d Ana 2026-01-05 fix retry loop",
                "9f8e7d6 Raj 2026-01-03 add config"
              ]
            }
          ]
        }
      ]
    },
    {
      "title": "Pickaxe Search: log -S, -G and -L",
      "role": "outline",
      "outlineIndex": 2,
      "pages": [
        {
          "title": "Pickaxe Search: log -S, -G and -L",
          "blocks": [
            {
              "type": "heading",
              "text": "1. -S and -G",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "`git log -S\"foo\"`: commits where the ==count of foo changed==",
                "Finds when a symbol **appeared or vanished**",
                "`git log -G\"regex\"`: a added or removed line matches, even if the count is same",
                "`--pickaxe-regex` lets -S take a regex"
              ],
              "style": "dot",
              "ink": "green"
            },
            {
              "type": "table",
              "headers": [
                "",
                "-S",
                "-G"
              ],
              "rows": [
                [
                  "Tests",
                  "count change",
                  "any changed line"
                ],
                [
                  "Pattern",
                  "fixed string",
                  "regex"
                ],
                [
                  "Noise",
                  "low",
                  "{red:higher}"
                ],
                [
                  "Catches",
                  "add / remove",
                  "moved or edited lines"
                ]
              ],
              "frame": "dashed"
            },
            {
              "type": "heading",
              "text": "2. Narrow the hunt",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "`-p` shows the ==matching hunk==",
                "Path after `--` narrows and speeds the search",
                "`--all` searches every branch; default is only **HEAD** history"
              ],
              "style": "check",
              "ink": "blue"
            },
            {
              "type": "code",
              "lang": "bash",
              "lines": [
                "git log -S\"MAX_RETRIES\" -p --all -- src/"
              ],
              "note": "-S, patch, all branches, path"
            },
            {
              "type": "heading",
              "text": "3. -L: line history",
              "ink": "purple"
            },
            {
              "type": "bullets",
              "items": [
                "`-L` shows full history of a ==range or function== with diffs",
                "Follows **renames and moves**"
              ],
              "style": "dot",
              "ink": "purple"
            },
            {
              "type": "code",
              "lang": "bash",
              "lines": [
                "git log -L 10,20:file.c",
                "git log -L :funcName:file.c"
              ]
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Remember",
              "text": "-S misses edits where the count is **unchanged**; use -G. No `--all` means other branches are {red:skipped}."
            }
          ]
        }
      ]
    },
    {
      "title": "git blame and git show",
      "role": "outline",
      "outlineIndex": 3,
      "pages": [
        {
          "title": "git blame and git show",
          "blocks": [
            {
              "type": "heading",
              "text": "1. git blame",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "`git blame file`: ==last commit==, author, date per line",
                "`-L 40,60` or `-L :funcName` limits the range",
                "`-w` skips whitespace, `-M` moved lines, `-C` lines copied from other files"
              ],
              "style": "dot"
            },
            {
              "type": "heading",
              "text": "2. Skip noise, go back",
              "ink": "purple"
            },
            {
              "type": "bullets",
              "items": [
                "`--ignore-rev <sha>` skips one bulk-format commit",
                "Set `blame.ignoreRevsFile` to apply the list automatically",
                "`blame <sha>^ -- file`: file just before that commit, finds the previous author"
              ],
              "style": "dot"
            },
            {
              "type": "code",
              "lang": "bash",
              "lines": [
                "git blame --ignore-revs-file .git-blame-ignore-revs f",
                "git config blame.ignoreRevsFile .git-blame-ignore-revs",
                "git blame abc123^ -- f"
              ]
            },
            {
              "type": "heading",
              "text": "3. git show and the why",
              "ink": "green"
            },
            {
              "type": "table",
              "headers": [
                "Command",
                "Prints"
              ],
              "rows": [
                [
                  "`git show <sha>`",
                  "message + diff"
                ],
                [
                  "`git show <sha>:path`",
                  "file as in that commit"
                ],
                [
                  "`git show --stat <sha>`",
                  "summary only"
                ]
              ]
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "blame",
                    "sub": "line",
                    "ink": "blue"
                  },
                  {
                    "text": "sha",
                    "ink": "purple"
                  },
                  {
                    "text": "show",
                    "sub": "read message",
                    "ink": "green"
                  },
                  {
                    "text": "PR / issue",
                    "sub": "the why",
                    "ink": "orange"
                  }
                ]
              }
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Reformat steals blame",
              "text": "Check `-w -M -C` and ignore-revs before blaming the author."
            },
            {
              "type": "sidebox",
              "title": "Interview Point",
              "items": [
                "**What does blame show?** Last commit to touch the line, not its origin.",
                "**Skip a reformat commit?** `--ignore-rev <sha>` or an ignore-revs file."
              ],
              "ink": "orange"
            }
          ]
        }
      ]
    },
    {
      "title": "git bisect: Binary Search for a Bad Commit",
      "role": "outline",
      "outlineIndex": 4,
      "pages": [
        {
          "title": "git bisect: Binary Search for a Bad Commit",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Workflow",
              "ink": "green"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "bisect start",
                    "ink": "blue"
                  },
                  {
                    "text": "bisect bad",
                    "sub": "current is broken",
                    "ink": "red"
                  },
                  {
                    "text": "bisect good <sha-or-tag>",
                    "sub": "known working",
                    "ink": "green"
                  },
                  {
                    "text": "Test midpoint",
                    "sub": "mark good or bad",
                    "ink": "purple"
                  },
                  {
                    "text": "first bad commit",
                    "sub": "then bisect reset",
                    "ink": "orange"
                  }
                ]
              }
            },
            {
              "type": "bullets",
              "items": [
                "Shortcut: `git bisect start <bad> <good>`",
                "Commit can't be tested: `git bisect skip`",
                "About ==log2(N)== steps: 1000 commits ≈ **10 steps**",
                "`git bisect reset` returns to your original branch"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "heading",
              "text": "2. Automate with run",
              "ink": "purple"
            },
            {
              "type": "table",
              "headers": [
                "Exit code",
                "Meaning"
              ],
              "rows": [
                [
                  "`0`",
                  "{green:good}"
                ],
                [
                  "`1-127` except 125",
                  "{red:bad}"
                ],
                [
                  "`125`",
                  "skip"
                ],
                [
                  "`128+`",
                  "abort"
                ]
              ]
            },
            {
              "type": "code",
              "lang": "bash",
              "lines": [
                "git bisect run npm test",
                "git bisect run ./check.sh"
              ]
            },
            {
              "type": "heading",
              "text": "3. Sessions and custom terms",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "`git bisect log` shows the marks so far",
                "`git bisect replay <file>` reruns a saved log",
                "`git bisect start --term-old=fast --term-new=slow` for non-bug hunts like performance"
              ],
              "style": "dot"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Mistakes",
              "text": "Always ==git bisect reset== when done. A script with the wrong exit code makes bisect point at the wrong commit."
            }
          ]
        }
      ]
    },
    {
      "title": "Archaeology Cheat Sheet",
      "role": "outline",
      "outlineIndex": 5,
      "pages": [
        {
          "title": "Archaeology Cheat Sheet",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Dig Through History",
              "ink": "green"
            },
            {
              "type": "table",
              "headers": [
                "Question",
                "Command"
              ],
              "rows": [
                [
                  "Commits touching a file",
                  "`git log --follow -p -- path`"
                ],
                [
                  "Who last changed a line",
                  "`git blame -w -M -L 40,60 file`"
                ],
                [
                  "String added or removed",
                  "`git log -S\"str\" -p --all`"
                ],
                [
                  "Changed line matches regex",
                  "`git log -G\"regex\"`"
                ],
                [
                  "History of a function",
                  "`git log -L :funcName:file`"
                ]
              ]
            },
            {
              "type": "bullets",
              "items": [
                "==-S== fires when the string's **count** changes",
                "==-G== fires when a changed line **matches** the regex"
              ],
              "style": "dot"
            },
            {
              "type": "heading",
              "text": "2. Find the Breaking Commit",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "Exit {green:0} = good, {red:1-127} = bad",
                "{orange:125} = skip, {purple:128+} = abort",
                "About log2(N) steps: 1000 commits ≈ 10"
              ],
              "style": "check"
            },
            {
              "type": "code",
              "lang": "bash",
              "lines": [
                "git bisect start",
                "git bisect bad",
                "git bisect good <sha>",
                "git bisect run ./test.sh",
                "git bisect reset"
              ],
              "note": "reset returns you to your branch"
            },
            {
              "type": "heading",
              "text": "3. Common Mistakes",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "Forgot `git bisect reset`: stuck on a detached HEAD",
                "Test script returns the wrong exit code",
                "Bisecting with a dirty working tree",
                "Trusting blame: a reformat commit steals the line"
              ],
              "style": "cross",
              "ink": "red"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Path guard",
              "text": "Put `--` before a path: `git log -- path`."
            }
          ]
        }
      ]
    },
    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "A commit changes `timeout=30` to `timeout=60`. Which lists it: `git log -S\"timeout\"` or `git log -G\"timeout\"`?",
              "a_bullets": [
                "{red:-S} misses it: the count of `timeout` is unchanged",
                "{green:-G} finds it: a changed line matches the regex",
                "`-S\"timeout=30\"` would find it, since that count drops"
              ]
            },
            {
              "type": "qa",
              "q": "Your `git bisect run` script exits 2 when the build breaks. What happens?",
              "a_bullets": [
                "Exit 2 counts as ==bad==, since 1-127 except 125 means bad",
                "An unbuildable commit gets blamed wrongly",
                "Exit `125` to skip untestable commits"
              ]
            },
            {
              "type": "qa",
              "q": "Blame points at a 'reformat code' commit. How do you reach the real author?",
              "a_bullets": [
                "Add `-w`, or `--ignore-rev <sha>`",
                "Or re-blame with `git blame <sha>^ -- file`"
              ]
            },
            {
              "type": "qa",
              "q": "Bisect printed 'first bad commit', yet `git status` says detached HEAD. Why?",
              "a_bullets": [
                "Bisect leaves you on a tested commit",
                "Run `git bisect reset` to return to your branch"
              ]
            }
          ]
        }
      ]
    }
  ]
