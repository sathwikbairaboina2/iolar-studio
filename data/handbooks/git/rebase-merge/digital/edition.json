              ]
            },
            {
              "type": "heading",
              "text": "2. Squash Merge",
              "ink": "purple"
            },
            {
              "type": "bullets",
              "items": [
                "==Squash merge== collapses a whole PR into **one commit** on main",
                "{green:Pro}: clean main history",
                "{red:Con}: individual commit detail is lost"
              ],
              "style": "dot"
            },
            {
              "type": "heading",
              "text": "3. Command Cheat Sheet",
              "ink": "orange"
            },
            {
              "type": "table",
              "headers": [
                "Command",
                "Does"
              ],
              "rows": [
                [
                  "`git rebase main`",
                  "replay branch on main's tip"
                ],
                [
                  "`git rebase -i HEAD~N`",
                  "squash, reword, drop last N"
                ],
                [
                  "`git rebase --continue/--abort/--skip`",
                  "next commit / undo / drop commit"
                ],
                [
                  "`git merge --no-ff`",
                  "force a merge commit"
                ],
                [
                  "`git merge --ff-only`",
                  "fail unless fast-forward"
                ],
                [
                  "`git push --force-with-lease`",
                  "push a rebased branch safely"
                ],
                [
                  "`git pull --rebase`",
                  "fetch + replay local on origin"
                ]
              ]
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Decision rule",
              "text": "{blue:Private and unpushed} means ==rebase==. {green:Public and shared} means ==merge==."
            }
          ]
        }
