    {
      "title": "Cheat Sheet: Secure and Observable LLM Apps",
      "role": "outline",
      "outlineIndex": 5,
      "pages": [
        {
          "title": "Cheat Sheet: Secure and Observable LLM Apps",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Threats and defence stack",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "All retrieved or tool text is ==untrusted data==",
                "==Indirect injection== is the main risk",
                "Break one leg of the **lethal trifecta**: private data, untrusted input, exfiltration channel"
              ],
              "style": "dot"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "Input guard",
                    "sub": "limits, PII, injection classifier",
                    "ink": "blue"
                  },
                  {
                    "text": "Least-privilege tools",
                    "sub": "code-level authorization",
                    "ink": "purple"
                  },
                  {
                    "text": "Output guard",
                    "sub": "schema, secrets, URL allowlist",
                    "ink": "orange"
                  },
                  {
                    "text": "Fail closed",
                    "sub": "safe fallback",
                    "ink": "red"
                  }
                ]
              }
            },
            {
              "type": "heading",
              "text": "2. Permissions checklist",
              "ink": "purple"
            },
            {
              "type": "bullets",
              "items": [
                "Tool ==allowlist==, read-only by default",
                "Per-user short-lived tokens, schema-validated arguments",
                "Human approval: write, send, spend, delete",
                "Fetch and browse leak data: ==outbound domain allowlist==",
                "Sandbox for code; rate and spend caps"
              ],
              "style": "check"
            },
            {
              "type": "heading",
              "text": "3. Measure and trace",
              "ink": "green"
            },
            {
              "type": "table",
              "headers": [
                "Metric",
                "Judges"
              ],
              "rows": [
                [
                  "Context precision",
                  "retrieved chunks relevant, ranked well"
                ],
                [
                  "Context recall",
                  "everything needed was retrieved"
                ],
                [
                  "Faithfulness",
                  "answer supported by context"
                ],
                [
                  "Answer relevance",
                  "answer addresses the question"
                ]
              ]
            },
            {
              "type": "bullets",
              "items": [
                "Gate every change on a ==golden set==",
                "Trace: prompt version, model, tokens, latency, tool args, guardrail verdicts, session ID"
              ],
              "style": "dot"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Interview Point",
              "text": "**Prevent**: least privilege, allowlists, approval, fail closed. **Detect**: faithfulness and recall drops on the golden set. **Debug**: trace fields."
            }
          ]
        }
      ]
