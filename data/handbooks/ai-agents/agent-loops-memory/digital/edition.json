          "title": "Stopping Conditions, Cost and Latency",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Stop Signals and Loop Failure",
              "ink": "green"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "Final answer",
                    "sub": "no tool call",
                    "ink": "green"
                  },
                  {
                    "text": "Step cap",
                    "sub": "max iterations",
                    "ink": "blue"
                  },
                  {
                    "text": "Budget",
                    "sub": "tokens or time",
                    "ink": "orange"
                  },
                  {
                    "text": "Interrupt",
                    "sub": "human or guardrail",
                    "ink": "red"
                  }
                ]
              }
            },
            {
              "type": "bullets",
              "items": [
                "{red:Same tool + same args} repeated = ==never converges==",
                "Detect the repeat, then **break out** or ==force a different strategy=="
              ],
              "style": "cross"
            },
            {
              "type": "code",
              "lang": "python",
              "lines": [
                "key = (call.name, json.dumps(call.args, sort_keys=True))",
                "if key in seen:",
                "    raise LoopDetected(key)  # or re-plan",
                "seen.add(key)"
              ],
              "note": "key = tool name + sorted args"
            },
            {
              "type": "heading",
              "text": "2. Cost",
              "ink": "orange"
            },
            {
              "type": "table",
              "headers": [
                "Mitigation",
                "Effect"
              ],
              "rows": [
                [
                  "==Prompt caching==",
                  "re-sent prefix costs less"
                ],
                [
                  "Smaller model",
                  "handles easy steps"
                ],
                [
                  "Trimmed tool outputs",
                  "fewer tokens per step"
                ],
                [
                  "==Hard step cap==",
                  "bounds total spend"
                ]
              ]
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Why cost snowballs",
              "text": "Every step re-sends the **whole context**, so step n pays for all earlier steps. Total cost grows ==faster than linearly==."
            },
            {
              "type": "heading",
              "text": "3. Latency",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "Lever",
                "How"
              ],
              "rows": [
                [
                  "==Parallel calls==",
                  "run independent tools together"
                ],
                [
                  "Streaming",
                  "show tokens as they arrive"
                ],
                [
                  "Fewer steps",
                  "cut needless loop iterations"
                ],
                [
                  "Fast model",
                  "route simple requests to it"
                ]
              ]
            }
          ]
        }
      ]
