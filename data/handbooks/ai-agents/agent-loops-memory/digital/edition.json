    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "An agent calls `search('Paris weather')` with the same arguments five times in a row. What is wrong, and what do you do?",
              "a_bullets": [
                "It is stuck: the same call and arguments give the same observation, so it never converges.",
                "Detect repeats, then break out or force a different strategy. A step cap guarantees it stops."
              ]
            },
            {
              "type": "qa",
              "q": "Each step of a 10-step loop adds 1k tokens to the context. Is the total input about 10k tokens?",
              "a_bullets": [
                "No. Every step re-sends the whole context: 1k + 2k + ... + 10k = ==55k==.",
                "Cost grows faster than linearly. Prompt caching and trimmed tool outputs reduce it."
              ]
            },
            {
              "type": "qa",
              "q": "A plan-and-execute agent finds no flights in step 2, yet runs step 3, \"book a hotel for those flights\". What is the bug?",
              "a_bullets": [
                "The plan is static and never checked against the observation.",
                "Re-plan after a surprise or failure: revise the remaining steps."
              ]
            }
          ]
        }
      ]
    }
