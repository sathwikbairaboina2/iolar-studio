              "type": "heading",
              "text": "1. Dataset and Retrieval",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "Record: ==input== + reference + ==gold doc IDs== + tags",
                "Mine ==production logs==; add ==unanswerable== cases",
                "Keep a ==held-out split==",
                "MRR example: ranks 3 and 1 give (1/3 + 1)/2 ≈ 0.67"
              ],
              "style": "check"
            },
            {
              "type": "table",
              "headers": [
                "Metric",
                "Asks",
                "Score"
              ],
              "rows": [
                [
                  "`recall@k`",
                  "found?",
                  "relevant in top k / total relevant"
                ],
                [
                  "`precision@k`",
                  "noise?",
                  "relevant in top k / k"
                ],
                [
                  "MRR",
                  "first hit",
                  "mean(1/rank of first hit)"
                ],
                [
                  "nDCG",
                  "graded relevance",
                  "good docs ranked high"
                ]
              ],
              "frame": "dashed"
            },
            {
              "type": "heading",
              "text": "2. Generation and Judge",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "==Faithfulness== = supported claims / total claims",
                "==Answer relevance==: addresses the question",
                "==Context relevance==: how much context was useful",
                "Judge: ==one criterion== per call, anchored rubric",
                "==Reasoning first==, temp 0, swap order",
                "Calibrate against ==human labels=="
              ],
              "style": "dot"
            },
            {
              "type": "heading",
              "text": "3. Biases, Agents, CI",
              "ink": "purple"
            },
            {
              "type": "bullets",
              "items": [
                "Judge biases: ==position==, ==verbosity==, ==self-preference==",
                "Agents: score ==tool choice==, arguments, efficiency, ==outcome=="
              ],
              "style": "cross"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "PR",
                    "sub": "fast subset",
                    "ink": "green"
                  },
                  {
                    "text": "Nightly",
                    "sub": "full run",
                    "ink": "blue"
                  },
                  {
                    "text": "Gate",
                    "sub": "threshold per metric",
                    "ink": "red"
                  }
                ]
              }
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Remember",
              "text": "Score each stage ==separately==: an overall score alone cannot show whether retrieval or generation failed."
            }
