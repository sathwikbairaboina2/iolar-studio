  "sections": [
    {
      "title": "Evaluation Mental Model and Dataset Building",
      "role": "outline",
      "outlineIndex": 0,
      "pages": [
        {
          "title": "Evaluation Mental Model and Dataset Building",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Evals as Unit Tests",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "==Evals== = unit tests for **non-deterministic** systems",
                "Fixed inputs, scored outputs, {blue:tracked over time}",
                "Changes are ==measured==, not guessed",
                "An overall score alone cannot locate the failing stage"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "Retriever",
                    "ink": "blue"
                  },
                  {
                    "text": "Generator",
                    "ink": "purple"
                  },
                  {
                    "text": "Agent steps",
                    "ink": "orange"
                  },
                  {
                    "text": "End to end",
                    "ink": "green"
                  }
                ]
              }
            },
            {
              "type": "heading",
              "text": "2. Golden Record",
              "ink": "blue"
            },
            {
              "type": "code",
              "lang": "json",
              "lines": [
                "{\"input\": \"How do I reset SSO?\",",
                "\"reference\": \"Admin console > SSO > Reset\",",
                "\"gold_doc_ids\": [\"kb-112\"],",
                "\"tags\": {\"category\": \"auth\",",
                "         \"difficulty\": \"hard\"}}"
              ],
              "note": "input + reference or expected facts + gold doc IDs + tags"
            },
            {
              "type": "heading",
              "text": "3. Sources and Coverage",
              "ink": "purple"
            },
            {
              "type": "table",
              "headers": [
                "Source",
                "Trust"
              ],
              "rows": [
                [
                  "Real production logs",
                  "{green:best}"
                ],
                [
                  "Expert-written cases",
                  "good"
                ],
                [
                  "Synthetic LLM cases",
                  "{red:always human-spot-check}"
                ]
              ]
            },
            {
              "type": "bullets",
              "items": [
                "Edge cases on purpose: ==unanswerable==, ambiguous, adversarial, rare categories",
                "==50-200== curated cases beat thousands of noisy ones",
                "Keep a ==held-out split== of cases"
              ],
              "style": "check"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Overfitting",
              "text": "Tuning prompts against the same cases every time fits the set, not the task. Keep the held-out split unseen."
            }
          ]
        }
      ]
    },
    {
      "title": "Retrieval Metrics: Recall@k, MRR and Friends",
      "role": "outline",
      "outlineIndex": 1,
      "pages": [
        {
          "title": "Retrieval Metrics: Recall@k, MRR and Friends",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Recall and Precision",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "==Recall@k== = relevant docs in top k / **total relevant docs**",
                "Tells you if the answer evidence {green:reached the generator}",
                "==Precision@k== = relevant docs in top k / **k**",
                "Low precision = {red:noisy context} that distracts the model"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "blue"
            },
            {
              "type": "heading",
              "text": "2. MRR and nDCG",
              "ink": "purple"
            },
            {
              "type": "bullets",
              "items": [
                "==MRR== = mean over queries of **1/rank** of the first relevant hit",
                "Only the first hit counts; later hits are ignored",
                "==nDCG== handles graded relevance and rewards several good docs ranked high"
              ],
              "style": "dot"
            },
            {
              "type": "table",
              "headers": [
                "First hit at",
                "1/rank"
              ],
              "rows": [
                [
                  "Rank 1",
                  "1.0"
                ],
                [
                  "Rank 3",
                  "0.33"
                ],
                [
                  "Rank 4",
                  "0.25"
                ],
                [
                  "Miss",
                  "0"
                ]
              ]
            },
            {
              "type": "heading",
              "text": "3. Worked Example",
              "ink": "green"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "Query A",
                    "sub": "gold at rank 3 → 1/3",
                    "ink": "orange"
                  },
                  {
                    "text": "Query B",
                    "sub": "gold at rank 1 → 1",
                    "ink": "blue"
                  },
                  {
                    "text": "MRR",
                    "sub": "(1/3 + 1) / 2 ≈ 0.67",
                    "ink": "green"
                  }
                ]
              }
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Picking k",
              "text": "Recall@k ==rises with k==. Pick k to match the context you **actually pass in**."
            }
          ]
        }
      ]
    },
    {
      "title": "Answer Faithfulness and Relevance",
      "role": "outline",
      "outlineIndex": 2,
      "pages": [
        {
          "title": "Answer Faithfulness and Relevance",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Faithfulness",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "==Faithfulness== (groundedness): every claim is supported by the **retrieved context**",
                "Low faithfulness = ==hallucination==",
                "Example: 4 of 5 claims supported gives score ==0.8=="
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "Answer",
                    "sub": "full text",
                    "ink": "blue"
                  },
                  {
                    "text": "Atomic claims",
                    "sub": "split",
                    "ink": "purple"
                  },
                  {
                    "text": "Check each",
                    "sub": "vs context",
                    "ink": "orange"
                  },
                  {
                    "text": "Score",
                    "sub": "supported / total",
                    "ink": "green"
                  }
                ]
              }
            },
            {
              "type": "heading",
              "text": "2. Three Relevance Checks",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "Metric",
                "Asks",
                "Tells you"
              ],
              "rows": [
                [
                  "Faithfulness",
                  "Is it in the context?",
                  "Hallucination"
                ],
                [
                  "Answer relevance",
                  "Does it address the question?",
                  "On topic, true or not"
                ],
                [
                  "Context relevance",
                  "How much context was useful?",
                  "Retrieval vs generation failure"
                ]
              ],
              "frame": "dashed"
            },
            {
              "type": "bullets",
              "items": [
                "Faithful but irrelevant: true to the context, ignores the question",
                "Relevant but unfaithful: answers the question with invented facts"
              ],
              "style": "cross"
            },
            {
              "type": "heading",
              "text": "3. Where to Fix",
              "ink": "purple"
            },
            {
              "type": "diagram",
              "kind": "flowchart",
              "spec": {
                "rows": [
                  [
                    "q1"
                  ],
                  [
                    "q2"
                  ],
                  [
                    "a",
                    "b"
                  ]
                ],
                "nodes": {
                  "q1": {
                    "text": "Faithfulness low?",
                    "shape": "diamond"
                  },
                  "q2": {
                    "text": "Recall low?",
                    "shape": "diamond"
                  },
                  "a": {
                    "text": "Fix retrieval first",
                    "shape": "box",
                    "ink": "red"
                  },
                  "b": {
                    "text": "Fix prompt or model",
                    "shape": "box",
                    "ink": "blue"
                  }
                },
                "edges": [
                  {
                    "from": "q1",
                    "to": "q2",
                    "label": "yes"
                  },
                  {
                    "from": "q2",
                    "to": "a",
                    "label": "yes"
                  },
                  {
                    "from": "q2",
                    "to": "b",
                    "label": "no"
                  }
                ]
              }
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Score all three",
              "text": "One metric alone misleads. ==Faithful + relevant + useful context== is the only passing profile."
            }
          ]
        }
      ]
    },
    {
      "title": "LLM-as-Judge: Rubrics and Biases",
      "role": "outline",
      "outlineIndex": 3,
      "pages": [
        {
          "title": "LLM-as-Judge: Rubrics and Biases",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Rubric Design",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "Open-ended output, exact match fails: use a ==judge model==",
                "The judge prompt is a **spec**: test it like code",
                "==One criterion== per judge call",
                "Anchors: what a ==1, 3 and 5== look like",
                "Reasoning first, then score; `temperature=0`"
              ],
              "style": "check",
              "ink": "green"
            },
            {
              "type": "code",
              "lang": "json",
              "lines": [
                "{\"criterion\": \"faithfulness\",",
                "\"reasoning\": \"2 of 3 claims cited\",",
                "\"score\": 3}"
              ],
              "note": "structured JSON, reasoning before score"
            },
            {
              "type": "heading",
              "text": "2. Pairwise and Biases",
              "ink": "purple"
            },
            {
              "type": "bullets",
              "items": [
                "==Pairwise== is more reliable than absolute scores",
                "Run **both orders**; a disagreement counts as a ==tie=="
              ],
              "style": "dot"
            },
            {
              "type": "table",
              "headers": [
                "Bias",
                "Judge tends to"
              ],
              "rows": [
                [
                  "Position",
                  "prefer the **first** answer"
                ],
                [
                  "Verbosity",
                  "prefer the **longer** answer"
                ],
                [
                  "Self-preference",
                  "favor its **own model family**"
                ],
                [
                  "Hard math or facts",
                  "be {red:weak}: verify separately"
                ]
              ],
              "frame": "dashed"
            },
            {
              "type": "heading",
              "text": "3. Calibrate",
              "ink": "orange"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "Human labels",
                    "sub": "30-100 cases",
                    "ink": "blue"
                  },
                  {
                    "text": "Judge scores",
                    "sub": "same cases",
                    "ink": "purple"
                  },
                  {
                    "text": "Compare",
                    "sub": "agreement or Cohen's kappa",
                    "ink": "green"
                  },
                  {
                    "text": "Fix prompt",
                    "sub": "then repeat",
                    "ink": "orange"
                  }
                ]
              }
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Keep the judge honest",
              "text": "Use a ==different or stronger== model than the one judged. ==Re-calibrate== whenever the judge prompt or model changes."
            }
          ]
        }
      ]
    },
    {
      "title": "Agent Trajectory Evaluation and CI Regression Suites",
      "role": "outline",
      "outlineIndex": 4,
      "pages": [
        {
          "title": "Agent Trajectory Evaluation and CI Regression Suites",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Trajectory and Metrics",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "==Trajectory== = ordered steps: thoughts, tool calls, arguments, observations",
                "Score the **path**, not just the final answer",
                "Metrics: {blue:tool selection}, {blue:argument validity}, {blue:step efficiency} (steps vs optimal)",
                "Also: {red:loops or redundant calls}, and ==task success rate=="
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "heading",
              "text": "2. Matching a Reference",
              "ink": "purple"
            },
            {
              "type": "table",
              "headers": [
                "Mode",
                "Passes when"
              ],
              "rows": [
                [
                  "Exact",
                  "same steps, same order"
                ],
                [
                  "In-order",
                  "reference steps appear in order, extras allowed"
                ],
                [
                  "Any-order",
                  "all reference steps present, any order"
                ]
              ]
            },
            {
              "type": "bullets",
              "items": [
                "Prefer ==outcome checks==: final state, e.g. the DB row created",
                "Many valid routes exist, so exact paths fail good runs"
              ],
              "style": "check"
            },
            {
              "type": "heading",
              "text": "3. Regression Suite in CI",
              "ink": "blue"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "Every PR",
                    "sub": "small fast subset",
                    "ink": "green"
                  },
                  {
                    "text": "Nightly",
                    "sub": "full set",
                    "ink": "blue"
                  },
                  {
                    "text": "Gate",
                    "sub": "threshold per metric",
                    "ink": "red"
                  }
                ]
              }
            },
            {
              "type": "sidebox",
              "title": "Gate rules",
              "items": [
                "Cache or mock tools, fix the seed: less flakiness and cost",
                "Block merge if recall@5 drops more than ==2 points== vs main",
                "Promote every production failure into a new test case",
                "Pin the judge model and version"
              ],
              "ink": "blue"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Remember",
              "text": "Gate on ==outcome== plus per-metric thresholds, not one overall score."
            }
          ]
        }
      ]
    },
    {
      "title": "Evals Cheat Sheet",
      "role": "outline",
      "outlineIndex": 5,
      "pages": [
