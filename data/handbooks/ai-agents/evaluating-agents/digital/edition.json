    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "A judge picks the answer shown first in 80% of pairwise runs, whatever the answer is. What is this, and what is the fix?",
              "a_bullets": [
                "{red:Position bias}.",
                "Run both orders and count a disagreement as a tie."
              ]
            },
            {
              "type": "qa",
              "q": "The gold doc ranks 2nd for query A, 4th for query B, and is not retrieved for query C. What is MRR?",
              "a_bullets": [
                "(0.5 + 0.25 + 0) / 3 = ==0.25==",
                "The miss counts as 0. It is not skipped."
              ]
            },
            {
              "type": "qa",
              "q": "Recall@5 is 0.95 but faithfulness is 0.60. Fix retrieval or generation?",
              "a_bullets": [
                "{green:Generation}. Recall of 0.95 means the gold docs reached the generator.",
                "Tune the prompt or model."
              ]
            }
          ]
        }
      ]
    }
  ]
