              "text": "1. Retrieve or Skip",
              "ink": "green"
            },
            {
              "type": "table",
              "headers": [
                "",
                "Skip",
                "Retrieve"
              ],
              "rows": [
                [
                  "Facts",
                  "chit-chat, math, general knowledge",
                  "private, recent or specific facts"
                ],
                [
                  "Context",
                  "answer already in context",
                  "fact not in context"
                ]
              ]
            },
            {
              "type": "bullets",
              "items": [
                "Routing comes from the ==tool description== plus a system rule",
                "Rule: 'search before answering any question about company docs'"
              ],
              "style": "dot",
              "ink": "green"
            },
            {
              "type": "heading",
              "text": "2. Grade, Retry, Stop",
              "ink": "blue"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "Search",
                    "ink": "blue"
                  },
                  {
                    "text": "Grade",
                    "sub": "relevant / partial / irrelevant",
                    "ink": "purple"
                  },
                  {
                    "text": "Retry",
                    "sub": "weak grade",
                    "ink": "orange"
                  },
                  {
                    "text": "Answer",
                    "sub": "or 'not found'",
                    "ink": "green"
                  }
                ]
              }
            },
            {
              "type": "bullets",
              "items": [
                "Weak grade: ==rewrite the query==, broaden or narrow the filter, or switch source",
                "Stop after **N retries** and say 'not found'"
              ],
              "style": "number"
            },
            {
              "type": "heading",
              "text": "3. Groundedness Check",
              "ink": "purple"
            },
            {
              "type": "bullets",
              "items": [
                "Each claim must be supported by a ==retrieved passage==",
                "Unsupported claim: **drop** it or flag it"
              ],
              "style": "check"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Remember",
              "text": "Grade before answering, cap the retries, check claims last."
            },
            {
              "type": "sidebox",
              "title": "Interview Point",
              "items": [
                "**No retrieval?** Chit-chat, math, general knowledge, in-context answer",
                "**Re-retrieve?** Weak grade triggers it; the N-retry cap stops it",
                "**Grounded?** Every claim maps to a retrieved passage"
              ],
              "ink": "orange"
            }
          ]
        }
      ]
