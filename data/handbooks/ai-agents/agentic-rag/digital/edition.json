    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "Fixed RAG gets 'Who is the CEO of the company that acquired Orbit?' and returns the wrong answer. Why?",
              "a_bullets": [
                "The bridge entity (the acquirer) is not in the question, so one top-k search never finds it.",
                "Agentic RAG runs hop 1 (find the acquirer), then hop 2 (find its CEO)."
              ]
            },
            {
              "type": "qa",
              "q": "An agent calls search('refund policy') six times with the same results, hits max_steps and answers nothing. What fixes it?",
              "a_bullets": [
                "Dedupe repeated queries, and force a rewritten query on each retry.",
                "Stop after N retries and answer 'not found'.",
                "max_steps only stopped the endless loop. It did not fix the cause."
              ]
            },
            {
              "type": "qa",
              "q": "The answer cites [doc9#p1], but this run's tool results held only doc3#p2 and doc4#p1. What should happen?",
              "a_bullets": [
                "Reject the answer and regenerate it.",
                "Every cited id must exist in this run's tool results, or the citation is fabricated."
              ]
            }
          ]
        }
      ]
