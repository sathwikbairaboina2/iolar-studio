    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "The window is 8,000 tokens. Your prompt is 7,500 tokens and you set max_tokens=1000. What happens?",
              "a_bullets": [
                "Input plus output must fit, and 7,500 + 1,000 is over 8,000",
                "The call errors or the output is cut short",
                "Shrink the prompt or set max_tokens to 500 or less"
              ]
            },
            {
              "type": "qa",
              "q": "The schema's enum is pos, neg or neu. JSON mode returned {\"sentiment\":\"positive\"}. Why was that allowed?",
              "a_bullets": [
                "JSON mode only guarantees valid JSON, not your shape",
                "Use schema-constrained output, then validate and retry"
              ]
            },
            {
              "type": "qa",
              "q": "A RAG bot gets chunks that do not contain the answer, yet it answers confidently. What is missing?",
              "a_bullets": [
                "A refusal rule: answer only from the context, otherwise say you don't know",
                "Also require citations like [doc2] so answers can be checked"
              ]
            }
          ]
        }
      ]
    }
