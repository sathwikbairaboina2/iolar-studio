          "blocks": [
            {
              "type": "heading",
              "text": "1. Prompt Layout",
              "ink": "blue"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "System rules",
                    "sub": "answer from context only",
