            {
              "type": "heading",
              "text": "2. Defaults and Debug",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "==Chunk== 200-500 tokens, 10-20% overlap",
                "Retrieve ==top 20-50==, rerank to ==5==",
                "Same embedding model for index and query; ==cosine== similarity",
                "==HNSW== index for scale"
              ],
              "style": "dot"
            },
            {
              "type": "diagram",
