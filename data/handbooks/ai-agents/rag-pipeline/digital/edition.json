          "blocks": [
            {
              "type": "heading",
              "text": "1. Ingestion",
              "ink": "green"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "Load",
                    "sub": "PDF, HTML, DB rows",
                    "ink": "green"
                  },
                  {
                    "text": "Parse",
                    "sub": "clean text",
                    "ink": "blue"
                  },
                  {
                    "text": "Strip",
                    "sub": "headers, footers, nav",
                    "ink": "orange"
                  },
                  {
                    "text": "Tag",
                    "sub": "metadata",
                    "ink": "purple"
                  }
                ]
              }
            },
            {
              "type": "bullets",
              "items": [
                "Metadata on every document: ==source, title, page, date, ACL=="
              ],
              "style": "check"
            },
            {
              "type": "heading",
              "text": "2. Chunking",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "Too big: {red:diluted embedding}",
                "Too small: {red:lost context}",
                "Start at ==200-500 tokens== with ==10-20% overlap=="
              ],
              "style": "dot"
            },
            {
              "type": "table",
              "headers": [
                "Strategy",
                "Strength",
                "Catch"
              ],
              "rows": [
                [
                  "Fixed-size",
                  "fast",
                  "cuts mid-sentence"
                ],
                [
                  "Recursive",
                  "==good default==",
                  "paragraph, then sentence"
                ],
                [
                  "Structure-aware",
                  "best for docs",
                  "needs headings or code blocks"
                ],
                [
                  "Semantic",
                  "follows meaning",
                  "costly"
                ]
              ]
            },
            {
              "type": "heading",
              "text": "3. Split on Headings",
              "ink": "purple"
            },
            {
              "type": "bullets",
              "items": [
                "Prepend the ==section title== so an orphan paragraph keeps context"
              ],
              "style": "dot"
            },
            {
              "type": "code",
              "lang": "python",
              "lines": [
                "for sec in split_on_headings(doc):",
                "    for part in cap_tokens(sec.text, 400):",
                "        chunks.append({",
                "            \"text\": sec.title + \"\\n\" + part,",
                "            **sec.meta})"
              ],
              "note": "pseudocode: 400-token cap per chunk"
            },
            {
              "type": "sidebox",
              "title": "Interview Point",
              "items": [
                "**Size and overlap?** Start 200-500 tokens, 10-20% overlap, then test on real queries",
                "**Metadata per chunk?** Citations, filters, ACL",
                "**Fixed splitter on tables or code?** Cuts rows and functions apart"
              ],
              "ink": "orange"
            }
          ]
        }
      ]
    },
