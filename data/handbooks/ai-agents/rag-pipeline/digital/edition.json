    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "You switch to a new embedding model and re-embed only the new chunks. Queries use the new model too. Old documents stop appearing. Why?",
              "a_bullets": [
                "Old vectors live in a different vector space, so distances to new query vectors mean nothing.",
                "Re-embed the whole corpus whenever the model changes."
              ]
            },
            {
              "type": "qa",
              "q": "RRF with 60: doc A is rank 1 dense and rank 3 BM25. Doc B is rank 2 in both. Which ranks higher?",
              "a_bullets": [
                "A: 1/61 + 1/63 ≈ 0.03227. B: 2/62 ≈ 0.03226.",
                "A wins, barely."
              ]
            },
            {
              "type": "qa",
              "q": "The answer cites [4], but only 3 chunks were retrieved. What is wrong, and what is the fix?",
              "a_bullets": [
                "The citation is invented, so the answer is unverified.",
                "Check that every cited ID is in the retrieved set. Treat a miss as a failure."
              ]
            }
          ]
        }
      ]
