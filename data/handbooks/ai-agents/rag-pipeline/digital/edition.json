                    "ink": "blue"
                  },
                  {
                    "text": "Cite inline",
                    "note": "model writes IDs",
                    "ink": "purple"
                  },
                  {
                    "text": "Check IDs",
                    "note": "must exist in retrieved set",
                    "ink": "green"
                  },
                  {
                    "text": "Map to links",
