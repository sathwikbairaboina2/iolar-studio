              "type": "table",
              "headers": [
                "",
                "Flat (exact)",
                "HNSW (ANN)",
                "IVF (ANN)"
              ],
              "rows": [
                [
                  "Method",
                  "Compare all",
                  "Graph hops",
                  "Nearest clusters"
                ],
                [
                  "Recall",
                  "Perfect",
                  "Slightly lower",
                  "Slightly lower"
                ],
                [
                  "Speed",
                  "O(N)",
