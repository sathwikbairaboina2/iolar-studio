            {
              "type": "bullets",
              "items": [
                "Rule: ==answer only from the context==",
                "Answer missing → say =={red:\"I don't know\"}==",
                "Top-k must fit the window, ==room left== for the answer",
                "Dedupe near-identical chunks; order by relevance",
                "Best chunks ==first and last==; middle recalled worst"
              ],
              "style": "check",
              "frame": "dashed",
              "ink": "blue"
            },
            {
              "type": "heading",
              "text": "2. Citations",
              "ink": "purple"
