    {
      "title": "Retrieval Tuning Cheat Sheet",
      "role": "outline",
      "outlineIndex": 5,
      "pages": [
        {
          "title": "Retrieval Tuning Cheat Sheet",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Chunk and Filter",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "==256-512 tokens==, {blue:10-20%} overlap",
                "Split on **structure** first, then token windows",
                "Pick the size by ==recall@k==, not habit",
                "Pre-filter on metadata, **always** `tenant_id`"
              ],
              "style": "check"
            },
            {
              "type": "heading",
              "text": "2. Hybrid, Re-rank, Rewrite",
              "ink": "purple"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "BM25 + dense",
                    "sub": "merge with RRF",
                    "ink": "blue"
                  },
                  {
                    "text": "Top ~50",
                    "sub": "bi-encoder",
                    "ink": "green"
                  },
                  {
                    "text": "Re-score",
                    "sub": "cross-encoder",
                    "ink": "purple"
                  },
                  {
                    "text": "Keep 3-5",
                    "ink": "orange"
                  }
                ]
              }
            },
            {
              "type": "code",
              "lang": "python",
              "lines": [
                "score = sum(1 / (60 + rank) for rank in ranks)"
              ],
              "note": "RRF: ranks of one chunk across lists"
            },
            {
              "type": "bullets",
              "items": [
                "Re-ranker cannot recover a chunk that was never retrieved",
                "Rewrites: standalone follow-up, expansion, ==HyDE==, multi-query",
                "Keep a rewrite only if the metrics improve"
              ],
              "style": "cross"
            },
            {
              "type": "heading",
              "text": "3. Measure",
              "ink": "orange"
            },
            {
              "type": "table",
              "headers": [
                "Metric",
                "Formula",
                "Tunes"
              ],
              "rows": [
                [
                  "recall@k",
                  "relevant in top k / all relevant, mean over queries",
                  "chunking, hybrid, filters"
                ],
                [
                  "MRR",
                  "mean of 1/rank of first relevant",
                  "re-ranker"
                ]
              ]
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Debug order",
