          "blocks": [
            {
              "type": "heading",
              "text": "1. What retrieval is",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "==Retrieval== picks the top-k chunks from an index for the prompt",
                "Right chunk missing → answer {red:cannot be grounded}, even with a great LLM"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "heading",
              "text": "2. Pipeline and two stages",
              "ink": "blue"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "Rewrite",
                    "sub": "query",
                    "ink": "blue"
                  },
                  {
                    "text": "Filter",
                    "sub": "metadata",
                    "ink": "purple"
                  },
                  {
                    "text": "Retrieve",
                    "sub": "dense + keyword",
                    "ink": "green"
                  },
                  {
                    "text": "Re-rank",
                    "sub": "candidates",
                    "ink": "orange"
                  },
                  {
                    "text": "Top few",
                    "sub": "chunks",
                    "ink": "pink"
                  },
                  {
                    "text": "Generate",
                    "sub": "answer",
                    "ink": "black"
                  }
                ]
              }
            },
            {
              "type": "table",
              "headers": [
                "",
                "Stage 1",
                "Stage 2"
              ],
              "rows": [
                [
                  "Job",
                  "Retrieve",
                  "Re-rank"
                ],
                [
                  "Cost",
                  "cheap, wide",
                  "slow, precise"
                ],
                [
                  "Keeps",
                  "top 50-100",
                  "top 3-5"
                ],
                [
                  "Goal",
                  "==high recall==",
                  "==precision=="
                ]
              ],
              "frame": "dashed"
            },
            {
              "type": "heading",
              "text": "3. Dense vs keyword",
              "ink": "purple"
            },
            {
              "type": "table",
              "headers": [
                "",
                "Dense vectors",
                "BM25"
              ],
              "rows": [
                [
                  "Matches",
                  "**meaning**",
                  "**exact tokens**"
                ],
                [
                  "Misses",
                  "IDs, error codes, names",
                  "paraphrases"
                ]
              ],
              "highlightRow": 1
            },
            {
              "type": "sidebox",
              "title": "Interview Point",
              "items": [
                "**Hallucinate with a strong LLM?** Wrong or missing chunks; the model fills the gap.",
