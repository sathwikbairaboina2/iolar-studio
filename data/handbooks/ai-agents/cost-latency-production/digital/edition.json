              "type": "code",
              "lang": "python",
              "lines": [
                "with tracer.start_as_current_span(\"llm_call\") as span:",
                "    span.set_attribute(\"user_id\", uid)",
                "    span.set_attribute(\"prompt_version\", \"v7\")",
                "    span.set_attribute(\"cache_hit\", False)"
