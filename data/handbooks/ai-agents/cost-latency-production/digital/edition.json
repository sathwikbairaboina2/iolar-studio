    {
      "title": "Parallel Tools, Retrieval Caching, Timeouts and Fallbacks",
      "role": "outline",
      "outlineIndex": 3,
      "pages": [
        {
          "title": "Parallel Tools, Retrieval Caching, Timeouts and Fallbacks",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Parallel Tools",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "Independent `tool_use` blocks in one turn run together",
                "Use `asyncio.gather`; return all results in ==one message==",
                "Latency = ==slowest call==, not the sum",
                "{red:Never} parallelize dependent or write-then-read calls",
                "Cap concurrency to avoid rate limits"
              ],
              "style": "dot",
              "ink": "green"
            },
            {
              "type": "code",
              "lang": "python",
              "lines": [
                "async def run_all(calls, sem):",
                "    async def one(c):",
                "        async with sem:",
                "            return await tool(c)",
                "    return await asyncio.gather(*map(one, calls))"
              ],
              "note": "semaphore = concurrency cap"
            },
            {
              "type": "heading",
              "text": "2. Retrieval Cache",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "",
                "Exact-match",
                "Semantic"
              ],
              "rows": [
                [
                  "Hit rate",
                  "low",
                  "high"
                ],
                [
                  "Risk",
                  "none",
                  "similar but wrong result"
                ]
              ]
            },
            {
              "type": "bullets",
              "items": [
                "Key = ==normalized query + filters + index version==",
                "Invalidate on index or document update; set a ==TTL==",
                "{red:Never} cache user-private results under a shared key"
              ],
              "style": "check",
              "ink": "blue"
            },
            {
              "type": "heading",
              "text": "3. Timeouts and Fallbacks",
              "ink": "purple"
            },
            {
              "type": "bullets",
              "items": [
                "Timeouts: per-tool, per-model-call, ==whole-run deadline==",
                "Retry only ==idempotent== calls",
                "Exponential backoff + ==jitter==, max attempts cap"
              ],
              "style": "dot",
              "ink": "purple"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "Retry",
                    "ink": "blue"
                  },
                  {
                    "text": "Alt model",
                    "sub": "or provider",
                    "ink": "purple"
                  },
                  {
                    "text": "Cached",
                    "sub": "or degraded",
                    "ink": "orange"
                  },
                  {
                    "text": "Clear error",
                    "ink": "red"
                  }
                ]
              }
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Circuit breaker",
              "text": "Stops calling a dependency that keeps failing, so the chain skips to the next step."
            }
          ]
        }
      ]
