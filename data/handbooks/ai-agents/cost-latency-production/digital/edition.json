      "pages": [
        {
          "title": "Cost and Latency Mental Model",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Cost Formula",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "Cost = ==input tokens × input price== + ==output tokens × output price==",
                "Output tokens cost ==3-5×== input tokens, so cut output length first",
                "Example at 4×: 500 output tokens cost as much as 2,000 input tokens"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "heading",
              "text": "2. Agent Loops Grow Quadratically",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "Each turn resends the ==whole history==",
                "Assume history starts at 0: step n sends n × 1k tokens",
                "Total sent = n(n+1)/2 × 1k, so input grows ==quadratically=="
              ],
              "style": "dot"
            },
            {
              "type": "table",
              "headers": [
                "Steps (n)",
                "Input tokens sent in total"
              ],
              "rows": [
                [
                  "1",
                  "1k"
                ],
                [
                  "2",
                  "3k"
                ],
                [
                  "10",
                  "55k"
                ],
                [
                  "20",
                  "210k"
                ]
              ],
              "frame": "dashed"
            },
            {
              "type": "heading",
              "text": "3. Latency",
              "ink": "purple"
            },
            {
              "type": "bullets",
              "items": [
                "**TTFT** = time to first token: the wait before the first output token appears",
                "Latency = TTFT + output tokens × per-token decode time",
                "TTFT is driven by ==input size=="
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "purple"
            },
            {
              "type": "heading",
              "text": "4. Four Levers",
              "ink": "orange"
            },
            {
              "type": "table",
              "headers": [
                "Lever",
                "Technique"
              ],
              "rows": [
                [
                  "Send fewer tokens",
                  "trim history"
                ],
                [
                  "Reuse tokens",
                  "prompt caching"
                ],
                [
                  "Cheaper model",
                  "routing"
                ],
                [
                  "Do work concurrently",
                  "streaming, parallel calls"
                ]
              ]
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Interview trap",
              "text": "Measure cost per ==successful task==, not per request: retries and failed runs hide in the total."
            }
          ]
        }
      ]
    },
    {
      "title": "Token Accounting and Prompt Caching",
      "role": "outline",
      "outlineIndex": 1,
      "pages": [
        {
          "title": "Token Accounting and Prompt Caching",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Count Every Token",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "Log ==usage== from **every** response, never estimate",
                "Tag each record with `run_id`, `step` and `model`"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "code",
              "lang": "python",
              "lines": [
                "log.info(run_id=run_id, step=step, model=r.model,",
                "  input_tokens=u.input_tokens,",
                "  output_tokens=u.output_tokens,",
                "  cache_read_tokens=u.cache_read_tokens,",
                "  cache_write_tokens=u.cache_write_tokens)"
              ],
              "note": "one record per response"
            },
            {
              "type": "heading",
              "text": "2. Prompt Caching",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "Input",
                "Price vs base",
                "When"
              ],
              "rows": [
                [
                  "Normal",
                  "1×",
                  "no cache"
                ],
                [
                  "Cache write",
                  "{red:≈ 1.25×}",
                  "first request"
                ],
                [
                  "Cache read",
                  "{green:≈ 0.1×}",
                  "later hits"
                ]
              ],
              "frame": "dashed"
            },
            {
              "type": "bullets",
              "items": [
                "Reuses a ==prefix== of the prompt; pays off from the **second hit**",
                "TTL is about ==5 min== by default; each hit refreshes it",
                "Low-traffic prompts expire between calls and never get hits"
              ],
              "style": "dot"
            },
            {
              "type": "heading",
              "text": "3. Prefix Order and Breakers",
              "ink": "red"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "Tools",
                    "ink": "blue"
                  },
                  {
                    "text": "System",
                    "ink": "green"
                  },
                  {
                    "text": "Stable docs",
                    "ink": "purple"
                  },
                  {
                    "text": "Conversation",
                    "ink": "orange"
                  },
                  {
                    "text": "New user turn",
                    "ink": "red"
                  }
                ]
              }
            },
            {
              "type": "bullets",
              "items": [
                "Timestamp or request ID in the system prompt",
                "Reordered tools",
                "Edited earlier messages"
              ],
              "style": "cross",
              "frame": "dashed",
              "ink": "red"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Confirm hits",
              "text": "Exact prefix match only. Check ==cache_read_tokens > 0==; zero means the cache is broken."
            }
          ]
        }
      ]
