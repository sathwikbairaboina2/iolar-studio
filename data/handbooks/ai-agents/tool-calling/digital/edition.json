    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "A loop appends only the tool result, not the assistant message that made the call. What happens?",
              "a_bullets": [
                "The API rejects it: the result has no matching call id.",
                "Keep the assistant tool-call message first, then the results by id."
              ]
            },
            {
              "type": "qa",
              "q": "A send_email tool times out, so the loop retries it three times. What is the bug?",
              "a_bullets": [
                "Sending is non-idempotent, so the user may get duplicates.",
                "Use an idempotency key or ask for confirmation; auto-retry only safe tools."
              ]
            },
            {
              "type": "qa",
              "q": "A stdio MCP server runs print('ready') for debugging. Why does the client break?",
              "a_bullets": [
                "Stdout carries the JSON-RPC messages, so stray text corrupts them.",
                "Log to stderr instead."
              ]
            }
          ]
        }
      ]
    }
