            {
              "type": "heading",
              "text": "3. Compare and Avoid",
              "ink": "red"
            },
            {
              "type": "table",
              "headers": [
                "",
                "MCP",
                "Function calling"
              ],
              "rows": [
                [
                  "Discovery",
                  "Standard `tools/list`",
                  "Hand-written"
                ],
                [
                  "Reuse",
                  "One server, many apps",
                  "Custom glue per app"
