          "blocks": [
            {
              "type": "heading",
              "text": "1. The Loop",
              "ink": "green"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "Model call",
                    "sub": "messages + tools",
                    "ink": "blue"
                  },
                  {
                    "text": "Tool call?",
                    "sub": "name, id, args",
                    "ink": "purple"
