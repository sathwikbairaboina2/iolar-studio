            {
              "type": "heading",
              "text": "2. Tool Definition",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "Part",
                "Rule"
              ],
              "rows": [
                [
                  "Name",
                  "specific, not `do_action`"
                ],
                [
                  "Description",
                  "what, when, when not"
                ],
                [
                  "Schema",
                  "types, `enum`, `required`, `additionalProperties: false`"
                ],
                [
                  "Server",
                  "==validate== args anyway"
                ]
              ]
            },
            {
              "type": "heading",
              "text": "3. Structured Output and Errors",
