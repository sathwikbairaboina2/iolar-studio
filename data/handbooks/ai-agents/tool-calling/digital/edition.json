            {
              "type": "heading",
              "text": "2. Primitives and Transports",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "{blue:Tools}: model-invoked actions",
                "{green:Resources}: readable data",
                "{purple:Prompts}: reusable templates",
                "`tools/list` discovers tools",
                "`tools/call` invokes one"
              ],
              "style": "dot"
            },
            {
              "type": "table",
              "headers": [
