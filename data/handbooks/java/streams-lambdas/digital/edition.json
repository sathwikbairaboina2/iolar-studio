                "Stream.of(\"apple\", \"avocado\")",
                "  .collect(Collectors.toMap(s -> s.charAt(0), s -> s));"
              ],
              "a_bullets": [
                "IllegalStateException: Duplicate key a (attempted merging values apple and avocado).",
                "Fix: pass a merge function, `(x, y) -> x`."
              ]
            },
            {
              "type": "qa",
              "q": "Which call fails, and why?",
              "example_code": [
                "var s = Stream.of(1, 2).filter(n -> n > 0);",
                "s.count();",
                "s.forEach(System.out::println);"
              ],
              "a_bullets": [
                "The forEach: IllegalStateException, stream already operated upon or closed.",
