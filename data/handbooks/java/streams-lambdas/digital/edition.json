              "type": "heading",
              "text": "1. Stream and Pipeline",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "A ==stream== is a one-shot **view** of a source",
                "Stores no data, never modifies the source"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "Source",
                    "sub": "collection, array",
                    "ink": "green"
                  },
                  {
                    "text": "Intermediate",
                    "sub": "0 or more, lazy",
                    "ink": "blue"
                  },
                  {
                    "text": "Terminal",
                    "sub": "exactly one",
                    "ink": "red"
                  }
                ]
              }
            },
            {
              "type": "heading",
              "text": "2. Sources and Operations",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "Source",
                "Note"
              ],
              "rows": [
                [
                  "`list.stream()`",
                  "collection"
                ],
                [
                  "`Arrays.stream(arr)`",
                  "array"
                ],
                [
                  "`Stream.of(a, b)`",
                  "fixed values"
                ],
                [
                  "`Stream.iterate` / `generate`",
                  "{red:infinite}, needs `limit`"
