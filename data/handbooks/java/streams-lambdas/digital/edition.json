                  "`Function<T,R>`",
                  "`apply`",
                  "T→R"
                ],
                [
                  "`Predicate<T>`",
                  "`test`",
                  "T→boolean"
                ],
                [
                  "`Consumer<T>`",
                  "`accept`",
                  "T→void"
                ],
                [
                  "`Supplier<T>`",
                  "`get`",
                  "()→T"
                ],
                [
                  "`UnaryOperator<T>`",
                  "`apply`",
                  "T→T"
                ],
                [
                  "`BinaryOperator<T>`",
                  "`apply`",
                  "(T,T)→T"
                ]
              ]
            },
            {
              "type": "heading",
              "text": "2. Lambda syntax",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "Target type comes from context: `x -> x + 1` fits either type below",
                "Captures ==effectively final== locals only"
              ],
              "style": "dot"
            },
            {
              "type": "code",
              "lang": "java",
              "lines": [
                "UnaryOperator<Integer> a = x -> x + 1;",
                "Function<Integer,Integer> b = x -> x + 1;",
                "BinaryOperator<Integer> c = (p, q) -> { return p + q; };",
                "int base = 1; // base++ breaks capture"
              ]
            },
            {
              "type": "heading",
              "text": "3. Method references",
              "ink": "purple"
            },
            {
              "type": "table",
              "headers": [
                "Kind",
                "Example",
                "Receiver"
              ],
              "rows": [
                [
                  "Static",
                  "`Integer::parseInt`",
                  "none"
