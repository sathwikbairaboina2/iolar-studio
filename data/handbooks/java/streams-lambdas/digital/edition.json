            {
              "type": "heading",
              "text": "1. Functional interfaces",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "==One abstract method== only; default, static, Object methods don't count",
                "`@FunctionalInterface`: compiler enforces it; `IntFunction`, `ToIntFunction` avoid boxing"
              ],
              "style": "dot"
            },
            {
              "type": "table",
              "headers": [
                "Type",
                "Method",
                "Shape"
