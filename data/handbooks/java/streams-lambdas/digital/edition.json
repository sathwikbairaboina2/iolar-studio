              "rows": [
                [
                  "{blue:Intermediate}, returns Stream",
                  "`filter` `map` `flatMap` `limit` `skip` `peek`"
                ],
                [
                  "{orange:Stateful} intermediate",
                  "`sorted` `distinct`: see **all** data"
                ],
                [
                  "{red:Terminal}",
                  "`collect` `forEach` `count` `reduce` `findFirst` `anyMatch` `allMatch` `noneMatch` `toList()`"
                ]
              ],
              "highlightRow": 2
            },
            {
              "type": "heading",
              "text": "3. Example and Interview Point",
              "ink": "purple"
            },
            {
              "type": "code",
              "lang": "java",
              "lines": [
                "names.stream()",
                "  .filter(n -> n.length() > 3)",
                "  .map(String::toUpperCase)",
                "  .sorted()",
                "  .toList();"
              ],
              "note": "toList(): Java 16+, unmodifiable",
              "result": {
                "headers": [
                  "names",
                  "result"
                ],
                "rows": [
                  [
                    "Al, Alice, Bob, Carol",
                    "[ALICE, CAROL]"
                  ]
                ]
              }
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Reuse fails",
              "text": "A used stream throws `IllegalStateException`. Create a new stream per use."
            },
            {
              "type": "bullets",
              "items": [
                "**Intermediate vs terminal?** Intermediate returns a Stream; terminal returns a result or void",
                "**Stateless vs stateful?** `filter`/`map` see one element; `sorted`/`distinct` buffer all"
              ],
              "style": "check",
              "ink": "purple"
            }
          ]
        }
