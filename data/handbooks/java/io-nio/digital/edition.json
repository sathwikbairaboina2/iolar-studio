    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "`try (var a = new Res(\"A\"); var b = new Res(\"B\")) { throw new IllegalStateException(); }`. Both close() methods throw IOException. What reaches the caller, and which closes first?",
              "a_bullets": [
                "`IllegalStateException` arrives, the body's exception stays primary",
                "The two IOExceptions are attached, read with `getSuppressed()`",
                "B closes first, then A (reverse order)"
              ]
            },
            {
              "type": "qa",
              "q": "`p` does not exist yet. What does `Files.writeString(p, \"hi\", StandardOpenOption.APPEND)` do?",
              "a_bullets": [
                "Throws `NoSuchFileException`",
                "Passing any option replaces the defaults, so CREATE is gone",
                "Fix: pass `CREATE, APPEND`"
              ]
            },
            {
              "type": "qa",
              "q": "A file holds \"café\" saved as ISO-8859-1. What do `Files.readString(p)` and an `InputStreamReader` with UTF_8 return?",
              "a_bullets": [
                "`Files.readString` throws `MalformedInputException`",
                "The reader silently returns \"caf\\uFFFD\", so the data is corrupted",
                "Read it with the right charset: `ISO_8859_1`"
              ]
            }
          ]
        }
      ]
    }
