                ]
              ]
            },
            {
              "type": "bullets",
              "items": [
                "`Files.lines` is ==lazy==, so ==close== the stream"
              ],
              "style": "check"
            },
            {
              "type": "code",
              "lang": "java",
              "lines": [
                "try (Stream<String> s = Files.lines(p)) {",
                "    s.filter(l -> l.startsWith(\"ERR\")).forEach(System.out::println);",
                "}"
              ]
            },
            {
              "type": "heading",
              "text": "2. Writing, Appending, Streaming",
              "ink": "green"
            },
            {
              "type": "table",
              "headers": [
                "Call / option",
                "Effect"
              ],
              "rows": [
                [
                  "`writeString(p, text)`, `write(p, lines)`",
                  "==truncates==, creates file"
                ],
                [
                  "`APPEND` + `CREATE`",
                  "adds to end, creates if missing"
                ],
                [
                  "`CREATE_NEW`",
                  "{red:fails} if file exists"
                ]
              ]
            },
            {
              "type": "bullets",
              "items": [
                "`newBufferedReader(p, UTF_8)` and `newBufferedWriter(p, UTF_8, options)` choose the ==charset==",
                "Wrap both in ==try-with-resources=="
              ],
              "style": "check"
            },
            {
              "type": "code",
              "lang": "java",
              "lines": [
                "try (var r = Files.newBufferedReader(p, UTF_8);",
                "     var w = Files.newBufferedWriter(q, UTF_8, CREATE, APPEND)) {",
                "    String l; while ((l = r.readLine()) != null) { w.write(l); w.newLine(); }",
                "}"
              ]
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Default write",
              "text": "Plain `write` ==truncates==. Forgetting `APPEND` wipes the file."
            },
            {
              "type": "sidebox",
              "title": "Interview Point",
              "items": [
                "**Large file?** `Files.lines` in try-with-resources, lazy",
                "**Append?** `APPEND` with `CREATE`",
                "**Fail if exists?** `CREATE_NEW`"
              ],
              "ink": "orange"
            }
          ]
        }
      ]
