            },
            {
              "type": "heading",
              "text": "2. Read and Write",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "Small file: `Files.readString`, `Files.readAllLines`",
                "Large file: ==lazy== `Files.lines` or `newBufferedReader`, closed"
              ],
              "style": "dot"
            },
            {
              "type": "code",
              "lang": "java",
              "lines": [
                "try (Stream<String> s = Files.lines(p, UTF_8)) {",
                "    long n = s.count();",
                "}"
              ],
              "note": "the stream holds a file handle"
            },
