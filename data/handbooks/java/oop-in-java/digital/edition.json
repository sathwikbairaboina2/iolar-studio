    {
      "title": "Overloading vs Overriding and equals/hashCode",
      "role": "outline",
      "outlineIndex": 4,
      "pages": [
        {
          "title": "Overloading vs Overriding and equals/hashCode",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Overloading vs Overriding",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "",
                "Overloading",
                "Overriding"
              ],
              "rows": [
                [
                  "Signature",
                  "same name, **different params**",
                  "**same** signature, subclass"
                ],
                [
                  "Resolved",
                  "{blue:compile time}, declared types",
                  "{green:runtime}, actual object (dynamic dispatch)"
                ],
                [
                  "Return type",
                  "alone is not enough",
                  "may be covariant"
                ]
              ]
            },
            {
              "type": "bullets",
              "items": [
                "Always add `@Override`",
                "Access cannot be narrowed",
                "No broader checked exceptions"
              ],
              "style": "check"
            },
            {
              "type": "heading",
              "text": "2. equals and hashCode",
              "ink": "green"
            },
            {
              "type": "code",
              "lang": "java",
              "lines": [
                "@Override public boolean equals(Object o) {",
                "  if (this == o) return true;",
                "  if (o == null || getClass() != o.getClass()) return false;",
                "  P p = (P) o;",
                "  return id == p.id && Objects.equals(name, p.name); }",
                "@Override public int hashCode() {",
                "  return Objects.hash(id, name); }"
              ],
              "note": "same fields in both"
            },
            {
              "type": "bullets",
              "items": [
                "Default `equals` is reference equality (`==`)",
                "Equal objects → ==same hashCode==",
                "Same hashCode does not mean equal",
                "hashCode is stable across calls"
              ],
              "style": "dot"
            },
            {
              "type": "heading",
              "text": "3. Mistakes and Interview Point",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "`equals` without `hashCode`: key lands in another bucket, `HashMap` misses it",
                "Mutable fields in a key's hash",
                "`equals(Point p)` only overloads, never overrides"
              ],
              "style": "cross"
            },
            {
              "type": "bullets",
              "items": [
                "**Compile-time?** Overloading",
                "**Contract?** equal → same hashCode",
                "**Only equals?** HashMap/HashSet lookups fail",
                "**Wrong param type?** It overloads; `@Override` catches it"
              ],
              "style": "dot"
            }
          ]
        }
      ]
