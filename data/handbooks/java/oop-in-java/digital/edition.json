              "type": "qa",
              "q": "Overloads f(Object) and f(String) exist. Which one does this call?",
              "example_code": [
                "Object x = \"hi\";",
                "f(x);"
              ],
              "a_bullets": [
                "`f(Object)`",
                "Overloads are chosen at compile time by the declared type, not the actual object"
              ]
            },
            {
              "type": "qa",
              "q": "What does `new B()` print?",
              "example_code": [
                "class A { A() { show(); } void show() {} }",
                "class B extends A {",
                "  int n = 5;",
                "  void show() { System.out.println(n); }",
                "}"
              ],
              "a_bullets": [
                "`0`",
                "A's constructor runs before B's fields are set, but the override still runs"
              ]
            },
            {
              "type": "qa",
              "q": "A class overrides `equals` on `id` but not `hashCode`. Does a `HashSet` find an equal copy of an added object?",
              "a_bullets": [
                "Usually no: `contains` returns false",
                "Different hash codes usually land in different buckets, so `equals` never runs"
              ]
            }
