              ]
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "On a List<Integer>",
              "text": "`remove(1)` removes the ==index==. Use `remove(Integer.valueOf(1))` to remove the ==value==."
            }
          ]
        }
      ]
