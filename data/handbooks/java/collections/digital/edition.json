          "blocks": [
            {
              "type": "heading",
              "text": "1. Comparable vs Comparator",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "",
                "Comparable",
                "Comparator"
              ],
              "rows": [
                [
                  "Method",
                  "`compareTo(T o)`",
                  "`compare(a, b)`"
                ],
                [
                  "Defined",
                  "**inside** the class",
                  "==external==, separate object"
                ],
                [
                  "Orders",
                  "{blue:one} natural order",
                  "{green:many}, class unchanged"
                ]
              ],
              "frame": "dashed"
            },
            {
              "type": "bullets",
              "items": [
                "Chain keys with `comparing`, `thenComparing`; flip with ==reversed()=="
              ],
              "style": "dot"
            },
            {
              "type": "code",
              "lang": "java",
              "lines": [
                "Comparator<Person> c = Comparator",
                "    .comparing(Person::getAge)",
                "    .thenComparing(Person::getName)",
                "    .reversed();"
              ],
              "note": "age, then name, whole order reversed"
            },
            {
              "type": "heading",
              "text": "2. Safe Iteration",
              "ink": "orange"
            },
            {
              "type": "bullets",
              "items": [
                "`list.remove(x)` inside for-each throws {red:ConcurrentModificationException}",
                "Fix: call ==Iterator.remove()== while iterating",
                "Or one line: `list.removeIf(x -> x < 0)`"
              ],
              "style": "check",
              "frame": "dashed",
              "ink": "orange"
            },
            {
              "type": "heading",
              "text": "3. Common Mistake",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "Comparing with `a - b` can **overflow** and flip the sign",
                "Use `Integer.compare(a, b)` instead"
              ],
              "style": "cross",
              "ink": "red"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Remember",
              "text": "Comparable = the class's ==single default== order. Comparator = any extra order, no class change."
            }
          ]
        }
      ]
