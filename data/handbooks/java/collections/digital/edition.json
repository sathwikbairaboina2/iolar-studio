              "a_bullets": [
                "`[10, 30, 1]`",
                "`remove(1)` picks `remove(int index)`, not the value",
                "To remove the value: `l.remove(Integer.valueOf(1))`"
              ],
              "example_code": [
                "List<Integer> l = new ArrayList<>(List.of(10, 20, 30, 1));",
                "l.remove(1);",
                "System.out.println(l);"
              ]
            },
            {
              "type": "qa",
              "q": "Why can this loop throw, and what is the fix?",
              "a_bullets": [
                "Usually `ConcurrentModificationException`: the list changed behind the iterator",
                "Fix: `names.removeIf(s -> s.startsWith(\"A\"))`"
              ],
              "example_code": [
                "for (String s : names)",
                "    if (s.startsWith(\"A\")) names.remove(s);"
              ]
            },
            {
              "type": "qa",
              "q": "What does the map hold after both puts?",
              "a_bullets": [
                "`{a=2}`",
                "TreeMap decides key equality by `compare`, not `equals`",
                "The old key stays, the value is replaced"
              ],
              "example_code": [
                "Map<String, Integer> m = new TreeMap<>(String.CASE_INSENSITIVE_ORDER);",
                "m.put(\"a\", 1);",
                "m.put(\"A\", 2);",
                "System.out.println(m);"
              ]
            }
          ]
        }
      ]
