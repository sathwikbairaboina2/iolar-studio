                    "text": "Integer",
                    "sub": "extends Number",
                    "ink": "green"
                  },
                  {
                    "text": "List<Integer>",
                    "sub": "NOT a List<Number>",
                    "ink": "red"
                  },
                  {
                    "text": "List<? extends Number>",
                    "sub": "accepts both",
