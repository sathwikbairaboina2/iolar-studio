            {
              "type": "heading",
              "text": "2. Generic arrays",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "Arrays check type at runtime, erasure can't"
              ],
              "style": "dot"
            },
            {
              "type": "table",
              "headers": [
                "Need",
                "Illegal or risky",
                "Use"
