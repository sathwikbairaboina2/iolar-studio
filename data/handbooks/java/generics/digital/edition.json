              "rows": [
                [
                  "`T`",
                  "type"
                ],
                [
                  "`E`",
                  "element"
                ],
                [
                  "`K` / `V`",
                  "key / value"
                ],
                [
                  "`N`",
                  "number"
                ]
              ],
              "frame": "dashed"
            },
            {
              "type": "bullets",
              "items": [
                "Generic class: parameter after the name",
                "Generic method: ==own parameter before the return type==",
                "`T` is usually **inferred** from the arguments"
              ],
              "style": "dot"
            },
            {
              "type": "code",
              "lang": "java",
              "lines": [
                "class Box<T> { T val; }",
                "static <T> T first(List<T> l) {",
                "    return l.get(0);",
                "}"
              ],
              "note": "first(names) infers T = String"
            },
            {
              "type": "heading",
              "text": "3. Invariance",
