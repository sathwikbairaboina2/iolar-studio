    {
      "title": "Generics Cheat Sheet",
      "role": "outline",
      "outlineIndex": 5,
      "pages": [
        {
          "title": "Generics Cheat Sheet",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Declare",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "Class: `class Box<T>`; method: `<T>` goes ==before the return type==",
                "Bound: `<T extends A & B>`, **class first**, then interfaces after `&`",
                "{red:No primitives}: `List<int>` is illegal, use the wrapper `List<Integer>`"
              ],
              "style": "dot"
            },
            {
              "type": "code",
              "lang": "java",
              "lines": [
                "class Box<T extends Number & Comparable<T>> { T val; }",
                "static <T> T first(List<T> l) { return l.get(0); }"
              ],
              "note": "class bound and generic method"
            },
            {
              "type": "heading",
              "text": "2. Wildcards and PECS",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "Form",
                "Read",
                "Write",
                "Role"
              ],
              "rows": [
                [
                  "`?`",
                  "Object",
                  "null only",
                  "unknown"
                ],
                [
                  "`? extends T`",
                  "T",
                  "null only",
                  "{green:producer}"
                ],
                [
                  "`? super T`",
                  "Object",
                  "T",
                  "{orange:consumer}"
                ]
              ],
              "highlightRow": 1
            },
            {
              "type": "bullets",
              "items": [
                "==PECS==: Producer Extends, Consumer Super",
                "**Invariant**: `List<Integer>` is not a `List<Number>`",
                "Accept both with `List<? extends Number>`"
              ],
              "style": "check"
            },
            {
              "type": "heading",
              "text": "3. Erasure Bans and Fixes",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "`new T()`, `new T[n]`, `T.class`, static `T` field",
                "`instanceof List<String>`; use `List<?>` instead",
                "Overloads differing only by type argument clash"
              ],
              "style": "cross",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "Pass a ==Class<T> token== for runtime type",
                "Use `List<T>` instead of `T[]`",
                "`@SafeVarargs` only if the array is never written or exposed"
              ],
              "style": "check",
              "ink": "green"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Raw types",
              "text": "Avoid **raw** `List`: `add(42)` compiles, fails later as ==ClassCastException==. Suppress unchecked only when proven safe."
            }
          ]
        }
      ]
