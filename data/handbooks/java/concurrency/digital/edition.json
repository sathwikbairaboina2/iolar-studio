    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "Two threads each run `count++` 1000 times on a `volatile int count`. Is the final value always 2000?",
              "a_bullets": [
                "No, it is often less than 2000.",
                "`volatile` gives visibility, not atomicity: `count++` is read, add, write.",
                "Fix: `AtomicInteger.incrementAndGet()`."
              ]
            },
            {
              "type": "qa",
              "q": "A pool has core=2, max=4 and an ArrayBlockingQueue of 10. You submit 5 tasks at once. How many threads run?",
              "a_bullets": [
                "Two. Tasks 3 to 5 wait in the queue.",
                "A third thread appears only once the queue is full."
              ]
            },
            {
              "type": "qa",
              "q": "On a ConcurrentHashMap: `if (!map.containsKey(k)) map.put(k, 1);` What is wrong?",
              "a_bullets": [
                "Each call is atomic, but the pair is not: two threads can both see k absent.",
                "Fix: `map.merge(k, 1, Integer::sum)` or `putIfAbsent`."
              ]
            }
          ]
        }
      ]
