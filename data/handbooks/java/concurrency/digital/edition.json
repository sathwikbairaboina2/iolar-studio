                "Map",
                "Lock",
                "Iterator"
              ],
              "rows": [
                [
                  "ConcurrentHashMap",
                  "per bin",
                  "weakly consistent, no CME"
                ],
                [
                  "synchronizedMap",
                  "one lock, every call",
                  "fail-fast"
                ],
                [
                  "Hashtable",
                  "one lock, every call",
