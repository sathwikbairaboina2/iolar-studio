              "type": "heading",
              "text": "1. Syntax and Indentation",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "==Text block== = multi-line literal in `\"\"\"` (Java 15+)",
                "Content starts on the ==line after== the opening `\"\"\"`",
                "Common leading whitespace is stripped",
                "==Closing `\"\"\"` position== counts; move it left to keep indent"
              ],
              "style": "dot",
              "ink": "blue"
            },
            {
              "type": "code",
              "lang": "java",
              "lines": [
                "String json = \"\"\"",
                "    {\"id\": 1}",
                "    \"\"\";"
              ],
              "note": "quotes need no escaping: good for JSON, SQL, HTML"
            },
            {
              "type": "heading",
              "text": "2. Newlines and Escapes",
              "ink": "purple"
            },
            {
              "type": "table",
              "headers": [
                "Item",
                "Effect"
              ],
              "rows": [
                [
                  "Line break",
                  "kept as `\\n`"
                ],
                [
                  "`\\` at line end",
                  "{green:suppresses} the line break"
                ],
                [
                  "`\\s`",
                  "keeps a trailing space"
                ],
                [
                  "Trailing spaces",
                  "{red:stripped} otherwise"
                ]
              ],
              "frame": "dashed"
            },
            {
              "type": "heading",
              "text": "3. Still a String",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "Ordinary `String`, ==interned== like any literal",
                "{red:No interpolation}: use `formatted(args)` or `String.format`"
              ],
              "style": "dot",
              "ink": "green"
            },
            {
              "type": "code",
              "lang": "java",
              "lines": [
                "String msg = \"\"\"",
                "    Hi %s",
                "    \"\"\".formatted(\"Ann\");"
              ]
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Closing delimiter",
              "text": "`\"\"\"` on its own line adds a final `\\n`. Put it right after the last text to ==drop it==."
            }
          ]
        }
      ]
