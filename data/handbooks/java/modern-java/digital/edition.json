          "title": "Switch Expressions and Pattern Matching",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Switch Expressions",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "Switch ==expression== returns a value, uses `->` labels",
                "No fall-through, no `break`",
                "`yield` returns a value from a block",
                "Must be ==exhaustive==: all cases or `default`"
              ],
              "style": "check",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "code",
              "lang": "java",
              "lines": [
                "int n = switch (day) {",
                "  case MON, TUE -> 1;",
                "  case WED -> { yield 2; }",
                "  default -> 0;",
                "};"
              ]
            },
            {
              "type": "heading",
              "text": "2. Pattern Matching",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "`o instanceof String s && s.length() > 3` binds `s`, no cast",
                "Binding in scope only where the match is ==definitely true=="
              ],
              "style": "dot"
            },
            {
              "type": "table",
              "headers": [
                "Form",
                "Syntax"
              ],
              "rows": [
                [
                  "Type",
                  "`case Circle c ->`"
                ],
                [
                  "Null",
                  "`case null ->` (else {red:NPE})"
                ],
                [
                  "Guard",
                  "`case Circle c when c.r() > 10 ->`"
                ],
                [
                  "Record",
                  "`case Point(int x, int y) -> x + y`"
                ]
              ],
              "frame": "dashed"
            },
            {
              "type": "heading",
              "text": "3. Exhaustive and Ordered",
              "ink": "purple"
            },
            {
              "type": "bullets",
              "items": [
                "Sealed hierarchy, no `default`: compiler checks ==exhaustiveness==",
                "A dominated pattern is a ==compile error=="
              ],
              "style": "dot"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Order cases",
              "text": "Put specific before general: `case Shape s` above `case Circle c` will not compile."
            }
          ]
        }
      ]
