    {
      "title": "Stack vs Heap Memory",
      "role": "outline",
      "outlineIndex": 2,
      "pages": [
        {
          "title": "Stack vs Heap Memory",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Stack and Heap",
              "ink": "green"
            },
            {
              "type": "table",
              "headers": [
                "",
                "Stack",
                "Heap"
              ],
              "rows": [
                [
                  "Scope",
                  "one **per thread**",
                  "**shared** by all threads"
                ],
                [
                  "Holds",
                  "frames",
                  "objects and arrays"
                ],
                [
                  "Speed",
                  "fast, LIFO",
                  "slower"
                ],
                [
                  "Freed",
                  "auto on return",
                  "only by ==GC=="
                ]
              ],
              "frame": "dashed"
            },
            {
              "type": "bullets",
              "items": [
                "Frame = ==locals + operand stack + return address==",
                "Method call **pushes** a frame; return **pops** it"
              ],
              "style": "dot"
            },
            {
              "type": "heading",
              "text": "2. What Lives Where",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "Primitive local: the value sits in the {blue:stack frame}",
                "Object local: ==reference on the stack==, object on the {orange:heap}",
                "Java is ==always pass-by-value==: the reference is copied"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "blue"
            },
            {
              "type": "code",
              "lang": "java",
              "lines": [
                "int n = 5;  // value on stack",
                "Point p = new Point();  // p on stack, object on heap",
                "void move(Point q) { q.x = 9; q = null; }"
              ],
              "note": "caller's p still points to the object, with x changed"
            },
            {
              "type": "heading",
              "text": "3. Errors and Tuning",
              "ink": "red"
            },
            {
              "type": "table",
              "headers": [
                "Error",
                "Cause",
                "Tune"
              ],
              "rows": [
                [
                  "`StackOverflowError`",
                  "too-deep or infinite recursion",
                  "`-Xss`"
                ],
                [
                  "`OutOfMemoryError: Java heap space`",
                  "heap exhausted",
                  "`-Xms` / `-Xmx`"
                ]
              ]
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Not on the stack, not all in the heap",
              "text": "Class metadata lives in ==Metaspace== (native memory, Java 8+). **Static fields** live on the heap, held by the `Class` object."
            }
          ]
        }
      ]
