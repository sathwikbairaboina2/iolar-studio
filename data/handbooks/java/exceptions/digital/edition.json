              "type": "heading",
              "text": "1. throw vs throws",
              "ink": "green"
            },
            {
              "type": "table",
              "headers": [
                "",
                "throw",
                "throws"
              ],
              "rows": [
                [
                  "Is a",
                  "==statement==",
                  "signature clause"
                ],
                [
                  "Takes",
                  "one exception object",
                  "exception types (required for checked)"
                ],
                [
                  "Where",
                  "method body",
                  "after the parameter list"
                ],
                [
                  "Example",
                  "`throw new IllegalStateException(\"msg\")`",
                  "`void read() throws IOException`"
                ]
              ],
              "highlightRow": 0
            },
            {
              "type": "heading",
              "text": "2. Custom Exceptions",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "Checked: `class AppException extends Exception`",
                "Unchecked: `extends RuntimeException`",
                "Provide ==(message)== and ==(message, cause)== constructors",
                "Wrap lower-level errors, keep the **cause**"
              ],
              "style": "dot"
            },
            {
              "type": "code",
              "lang": "java",
              "lines": [
                "class AppException extends Exception {",
                "  AppException(String m, Throwable c) { super(m, c); }",
                "}",
                "try { load(); }",
                "catch (IOException e) {",
                "  throw new AppException(\"load failed\", e);",
                "}"
              ],
              "note": "wrap and rethrow"
            },
            {
              "type": "heading",
              "text": "3. Overriding Rules",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "Override ==cannot== throw a broader checked exception than the parent",
                "It may throw {green:fewer}, narrower, or any **unchecked** exception",
                "Parent `throws IOException`, child `throws Exception` → {red:compile error}"
              ],
              "style": "check"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Keep the cause",
              "text": "Always pass `e` when wrapping, or the original stack trace is lost."
            }
          ]
        }
      ]
