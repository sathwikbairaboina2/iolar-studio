                [
                  "`ClassCastException`",
                  "invalid downcast",
                  "`instanceof` before cast"
                ],
                [
                  "`NumberFormatException` (is an `IllegalArgumentException`)",
                  "`Integer.parseInt(\"abc\")`",
                  "validate input"
                ],
                [
                  "`ArithmeticException`",
                  "int divide by zero",
                  "check divisor"
                ],
                [
                  "`ConcurrentModificationException`",
                  "remove inside for-each",
                  "`Iterator.remove()`, `removeIf`"
                ]
              ]
            },
            {
              "type": "heading",
              "text": "2. Safe Removal",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
