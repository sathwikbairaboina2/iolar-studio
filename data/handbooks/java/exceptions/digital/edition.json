    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "What does this print?",
              "example_code": [
                "static int f() {",
                "  try { return 1; }",
                "  finally { System.out.println(\"F\"); }",
                "}",
                "System.out.println(f());"
              ],
              "a_bullets": [
                "`F`, then `1`",
                "`finally` runs before the method returns, so `F` prints first"
              ]
            },
            {
              "type": "qa",
              "q": "Why does this not compile?",
              "example_code": [
                "try { read(); }",
                "catch (Exception e) { }",
                "catch (IOException e) { }"
              ],
              "a_bullets": [
                "`Exception` already catches `IOException`, so the second catch is unreachable",
                "Put the subclass first"
              ]
            },
            {
              "type": "qa",
              "q": "In try-with-resources, the body throws A and `close()` throws B. Which does the caller see?",
              "a_bullets": [
                "A, with B attached through `getSuppressed()`",
                "A manual `finally { close() }` would throw B and lose A"
              ]
            }
          ]
        }
      ]
