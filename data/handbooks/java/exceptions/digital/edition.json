              "rows": [
                [
                  "`NullPointerException`",
                  "method or field on `null`",
                  "null check, `Objects.requireNonNull`, `Optional`"
                ],
                [
                  "`ArrayIndexOutOfBoundsException` (is an `IndexOutOfBoundsException`)",
                  "index < 0 or >= length",
                  "valid range ==0 to length-1=="
