          "blocks": [
            {
              "type": "heading",
              "text": "1. Races and Deadlocks",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "==Data race==: same memory, no synchronization, at least one write",
                "It is {red:undefined behaviour}, not just a wrong value",
                "==Deadlock== needs **circular wait** on two or more locks"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "red"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "A holds m1",
                    "ink": "blue"
                  },
                  {
                    "text": "A wants m2",
                    "sub": "held by B",
                    "ink": "red"
                  },
                  {
                    "text": "B holds m2",
                    "ink": "blue"
                  },
                  {
                    "text": "B wants m1",
                    "sub": "held by A",
                    "ink": "red"
                  }
                ]
              }
            },
            {
              "type": "code",
              "lang": "cpp",
              "lines": [
                "std::scoped_lock lk(m1, m2);"
              ],
              "note": "fix: lock both at once, or use one fixed global lock order"
            },
            {
              "type": "heading",
              "text": "2. Lock Discipline and Detection",
              "ink": "blue"
            },
            {
              "type": "sidebox",
              "title": "While holding a lock",
              "items": [
                "Never call unknown code or callbacks",
                "Keep critical sections short",
                "Never block on I/O"
              ],
              "ink": "orange"
            },
            {
              "type": "code",
              "lang": "bash",
              "lines": [
                "g++ -std=c++20 -fsanitize=thread -pthread a.cpp"
              ],
              "note": "ThreadSanitizer; -pthread works on GCC and Clang"
            },
            {
              "type": "heading",
              "text": "3. Cheat Sheet",
              "ink": "green"
            },
            {
              "type": "table",
              "headers": [
                "Need",
