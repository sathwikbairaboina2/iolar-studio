    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "What does this print, and why?",
              "example_code": [
                "auto a = std::make_unique<int>(5);",
                "auto b = std::move(a);",
                "std::cout << (a ? \"full\" : \"null\");"
              ],
              "a_bullets": [
                "`null`",
                "`std::move` only casts; the move constructor of `b` steals the pointer and nulls `a`."
              ]
            },
            {
              "type": "qa",
              "q": "What is the bug here?",
              "example_code": [
                "int* p = new int(1);",
                "std::shared_ptr<int> a(p);",
                "std::shared_ptr<int> b(p);"
              ],
              "a_bullets": [
                "Two control blocks own one object, so it is deleted twice (UB).",
                "Copy instead: `b = a;`, or use `make_shared`."
              ]
            },
            {
              "type": "qa",
              "q": "Why is `return std::move(w);` worse than `return w;` for a local `w`?",
              "a_bullets": [
                "It blocks copy elision (RVO), so a move is forced.",
                "`return w;` lets the compiler elide the object or move it."
              ]
            }
          ]
        }
      ]
