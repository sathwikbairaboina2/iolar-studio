      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "With `std::map<string,int> m`, does `for (auto [k, v] : m) v++;` change the map?",
              "a_bullets": [
                "No: plain `auto` copies each pair, so `v` is a copy.",
                "Use `auto& [k, v]` to modify the map."
              ]
            },
            {
              "type": "qa",
              "q": "What is wrong with `decltype(auto) f() { int x = 1; return (x); }`?",
              "a_bullets": [
                "`(x)` in parentheses makes decltype give `int&`.",
                "It returns a reference to a local, which dangles."
              ]
            },
            {
              "type": "qa",
              "q": "Why does `max(1, 2.5)` fail for `template<typename T> T max(T a, T b)`?",
              "a_bullets": [
                "T deduces as `int` from one argument and `double` from the other, so deduction conflicts.",
                "Write `max<double>(1, 2.5)`."
              ]
            }
          ]
        }
      ]
