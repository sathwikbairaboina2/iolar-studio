      "pages": [
        {
          "title": "Function and Class Templates",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Blueprint and Deduction",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "==Template== = compile-time blueprint",
                "Instantiated per distinct `T`: each type gets its **own generated code**",
                "`max(1, 2)` deduces `T` = {green:int}",
                "`max(1, 2.5)` {red:fails}: `T` conflicts, so give `T` explicitly"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "code",
              "lang": "cpp",
              "lines": [
                "template<typename T>",
                "T max(T a, T b) { return a > b ? a : b; }",
                "",
                "max(1, 2);            // T = int",
                "max<double>(1, 2.5);  // explicit T"
              ]
            },
            {
              "type": "heading",
              "text": "2. Class Templates and Specialization",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "",
                "Before C++17",
                "C++17"
              ],
              "rows": [
                [
                  "Class args",
                  "explicit: `std::vector<int>`",
                  "==CTAD== deduces: `std::pair p{1, 'a'}`"
                ]
              ]
            },
            {
              "type": "bullets",
              "items": [
                "Full specialization `template<> struct S<int>{}` replaces **one type**",
                "Function templates: {red:no} partial specialization",
                "Use ==overloads== or `if constexpr` instead"
              ],
              "style": "dot",
              "ink": "blue"
            },
            {
              "type": "heading",
              "text": "3. Common Mistakes",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "Definitions not in the header: linker reports {red:undefined reference}",
                "Dependent name without `typename`: write `typename T::value_type`"
              ],
              "style": "cross",
              "frame": "dashed",
              "ink": "red"
            }
          ]
        }
      ]
    },
    {
      "title": "auto, decltype and Range-for",
      "role": "outline",
      "outlineIndex": 2,
      "pages": [
        {
          "title": "auto, decltype and Range-for",
          "blocks": [
            {
              "type": "heading",
              "text": "1. auto deduction",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "`auto x = expr` deduces from the initializer",
                "Drops ==top-level const== and ==references==: `const int& r` gives `int`"
              ],
              "style": "dot"
            },
            {
              "type": "table",
              "headers": [
                "Form",
                "Result",
                "Use"
              ],
              "rows": [
                [
                  "`auto&`",
                  "keeps ref and const",
                  "modify in place"
                ],
                [
                  "`const auto&`",
                  "binds to anything",
                  "no copy"
                ],
                [
                  "`auto&&`",
                  "{purple:forwarding reference}",
                  "lvalue or rvalue"
                ]
              ]
            },
            {
              "type": "heading",
              "text": "2. decltype and decltype(auto)",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "`decltype(expr)` gives the ==exact declared type==, const and refs kept",
                "`decltype((x))` with double parentheses gives `T&`",
                "`decltype(auto)` (C++14) returns with decltype rules"
              ],
              "style": "dot"
            },
            {
              "type": "code",
              "lang": "cpp",
              "lines": [
                "int x = 0;",
                "decltype(x) a = x;    // int",
                "decltype((x)) b = x;  // int&",
                "decltype(auto) f() {",
                "    int y = 1;",
                "    return (y);       // int&, dangling",
                "}"
              ]
            },
            {
              "type": "heading",
              "text": "3. Range-for",
              "ink": "purple"
            },
            {
              "type": "table",
              "headers": [
                "Loop",
                "Effect"
              ],
              "rows": [
                [
                  "`for (const auto& e : v)`",
                  "{green:no copies}, read only"
                ],
                [
                  "`for (auto e : v)`",
                  "{red:copies each element}"
                ],
                [
                  "`for (auto& e : v)`",
                  "edits the source"
                ]
              ]
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "vector<bool>",
              "text": "`auto&` fails on `vector<bool>`: its proxy is a ==temporary==. Use `auto&&` or `const auto&`."
            }
          ]
        }
      ]
    },
    {
      "title": "Structured Bindings and constexpr",
      "role": "outline",
      "outlineIndex": 3,
      "pages": [
        {
          "title": "Structured Bindings and constexpr",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Structured Bindings (C++17)",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "==Unpack== pairs, tuples, arrays, aggregates",
                "`auto [a, b]` makes a **copy** of the object",
                "`auto& [k, v]` binds by ==reference==, so it edits the source"
              ],
              "style": "dot"
            },
            {
              "type": "code",
              "lang": "cpp",
              "lines": [
                "auto [it, ok] = m.insert({k, v});",
                "for (auto& [key, val] : m) val++;"
              ]
            },
            {
              "type": "heading",
              "text": "2. constexpr Family",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "`constexpr` variable = compile-time constant",
                "Usable as array size or template argument: `constexpr int N = 4; int a[N];`"
              ],
              "style": "dot"
            },
            {
              "type": "table",
              "headers": [
                "Keyword",
                "Guarantee"
              ],
              "rows": [
                [
                  "`constexpr` function",
                  "compile time **or** run time"
                ],
                [
                  "`consteval` (C++20)",
                  "{green:compile time only}"
                ],
                [
                  "`constinit` (C++20)",
                  "static initialization, still mutable"
                ]
              ]
            },
            {
              "type": "heading",
              "text": "3. Mistakes",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "Lambdas cannot capture binding names before ==C++20==",
                "`constexpr` is not `const`: const may be initialized at **run time**"
              ],
              "style": "cross",
              "ink": "red"
            },
            {
              "type": "heading",
              "text": "4. Interview Point",
              "ink": "purple"
            },
            {
              "type": "bullets",
              "items": [
                "**Copy or modify?** `auto [a, b]` copies; `auto&` modifies the source",
                "**constexpr vs consteval?** consteval forces compile time",
                "**constexpr vs const?** const can be set at run time"
              ],
              "style": "dot"
            }
          ]
        }
      ]
    },
    {
      "title": "optional and variant",
      "role": "outline",
      "outlineIndex": 4,
      "pages": [
        {
          "title": "optional and variant",
          "blocks": [
            {
              "type": "heading",
              "text": "1. optional: a T or nothing",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "`optional<T>` (C++17): ==T or nothing==",
                "`if (o) use(*o);` and `o.value_or(0)` for a default",
                "`o.value()` throws `bad_optional_access` if empty",
                "`*o` on empty: {red:undefined behaviour}"
              ],
              "style": "dot",
              "ink": "green"
            },
            {
              "type": "heading",
              "text": "2. variant: exactly one alternative",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "`get<int>(v)` throws `bad_variant_access` on wrong type",
                "`get_if<int>(&v)` returns {green:nullptr} instead",
                "`visit` must cover ==every alternative==, else compile error"
              ],
              "style": "dot",
              "ink": "blue"
            },
            {
              "type": "code",
              "lang": "cpp",
              "lines": [
                "variant<int, string> v = 3;",
                "if (auto* p = get_if<int>(&v)) use(*p);",
                "visit(overloaded{",
                "  [](int i) { /* ... */ },",
                "  [](string s) { /* ... */ }",
                "}, v);"
              ],
              "note": "visit dispatches on the active type"
            },
            {
              "type": "heading",
              "text": "3. Which one to use",
              "ink": "purple"
            },
            {
              "type": "table",
              "headers": [
                "Situation",
                "Use"
              ],
              "rows": [
                [
                  "Value may be absent",
                  "`optional<T>`"
                ],
                [
                  "Closed set of types",
                  "`variant<...>`"
                ],
                [
                  "Neither",
                  "sentinel or pointer"
                ]
              ]
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Default variant",
              "text": "It holds its ==first type==. If that is not default-constructible, put `std::monostate` first."
            }
          ]
        }
      ]
    },
