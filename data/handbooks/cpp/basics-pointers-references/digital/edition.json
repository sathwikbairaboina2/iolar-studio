            {
              "type": "bullets",
              "items": [
                "Required, never null: ==reference==",
                "Optional or must be reseated: ==pointer==",
                "`sizeof(p)` is 8 bytes on 64-bit; a reference has no address of its own"
              ],
              "style": "check"
            },
            {
              "type": "heading",
              "text": "2. Parameter Passing",
              "ink": "green"
            },
            {
              "type": "table",
              "headers": [
                "Form",
                "Copy?",
                "Caller changed?",
                "Use for"
