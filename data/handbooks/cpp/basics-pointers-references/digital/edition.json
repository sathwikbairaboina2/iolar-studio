                  "Storage",
                  "stack",
                  "stack",
                  "heap"
                ],
                [
                  "`.size()`",
                  "no",
                  "yes",
                  "yes"
                ],
                [
                  "Decays",
                  "{red:yes}",
                  "{green:no}",
                  "{green:no}"
                ]
              ],
              "highlightRow": 1
