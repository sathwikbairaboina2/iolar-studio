                [
                  "Initialized",
                  "{green:must be}",
                  "optional"
                ],
                [
                  "Null",
                  "{red:never}",
                  "`nullptr` ok"
                ],
                [
                  "Reseat",
                  "{red:never}",
                  "{green:yes}"
