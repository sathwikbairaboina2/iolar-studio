            {
              "type": "heading",
              "text": "3. Mistakes",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "Returning a reference or pointer to a local is {red:dangling} (UB)",
                "Non-const `T&` cannot bind a temporary; `const T&` can"
              ],
              "style": "cross"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Remember",
              "text": "Small types by **value**, large read-only by ==const T&==, modify with `T&`, optional with `T*`."
            }
          ]
