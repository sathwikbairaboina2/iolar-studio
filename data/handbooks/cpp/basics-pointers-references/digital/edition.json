            {
              "type": "heading",
              "text": "3. Mistakes",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "`sizeof(arr)/sizeof(arr[0])` fails after decay",
                "`[]` never checks bounds; `.at()` does",
