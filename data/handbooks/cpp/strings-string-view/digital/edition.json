      "pages": [
        {
          "title": "C Strings vs std::string",
          "blocks": [
            {
              "type": "heading",
              "text": "1. C String Basics",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "C string = `char` array ending in =='\\0'==",
                "`strlen` is {red:O(n)}: it scans for the terminator",
                "`std::string::size()` is {green:O(1)}: length is stored"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "`const char*` `==` compares ==addresses==, not contents",
                "Content: `strcmp(a, b) == 0`, or `std::string` / `string_view` `==`"
              ],
              "style": "cross"
            },
            {
              "type": "heading",
              "text": "2. Crossing the Boundary",
              "ink": "blue"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "const char*",
                    "sub": "C string",
                    "ink": "orange"
                  },
                  {
                    "text": "std::string",
                    "sub": "implicit, scans for '\\0'",
                    "ink": "green"
                  },
                  {
                    "text": "c_str() / data()",
                    "sub": "explicit only",
                    "ink": "blue"
                  }
                ]
              }
            },
            {
              "type": "code",
              "lang": "cpp",
              "lines": [
                "std::string s(\"a\\0b\", 3);  // length given",
                "auto t = \"a\\0b\"s;          // also size 3",
                "s.size();                  // 3",
                "std::strlen(s.c_str());    // 1"
              ],
              "note": "embedded '\\0' is kept; C APIs stop at the first one"
            },
            {
              "type": "heading",
              "text": "3. Comparison",
              "ink": "purple"
            },
            {
              "type": "table",
              "headers": [
                "",
                "C string",
                "std::string"
              ],
              "rows": [
                [
                  "Memory",
                  "manual buffer sizing",
                  "{green:manages itself}, grows safely"
                ],
                [
                  "Copy / join",
                  "`strcpy`/`strcat` {red:overflow risk}",
                  "`=` and `+` are safe"
                ],
                [
                  "Ownership",
                  "none",
                  "owns its buffer"
                ],
                [
                  "Operators",
                  "none on content",
                  "`==`, `<`, `+`, range-for"
                ]
              ],
              "highlightRow": 1
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Remember",
              "text": "Built with a length, a std::string can hold ==embedded '\\0'==; a C API only sees the text before the first one."
            }
          ]
        }
      ]
