    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "What does b hold after `P p;`?",
              "a_bullets": [
                "Cause: declaration order is b, a, not list order",
                "Result: b reads uninitialised a, which is undefined behavior",
                "`-Wreorder` flags this"
              ],
              "example_code": [
                "struct P { int b, a;",
                "  P(): a(1), b(a + 1) {} };"
              ]
            },
            {
              "type": "qa",
              "q": "`Base` has a virtual function but a non-virtual destructor. What goes wrong here?",
              "a_bullets": [
                "Deleting through `Base*` is undefined behavior; `~Derived` is skipped",
                "Fix: `virtual ~Base()`"
              ],
              "example_code": [
                "Base* p = new Derived;",
                "delete p;"
              ]
            },
            {
              "type": "qa",
              "q": "What does `D d;` print?",
              "a_bullets": [
                "It prints {red:B}",
                "Inside `B()` the object is still a `B`, so the call binds to `B::f`"
              ],
              "example_code": [
                "struct B { B() { f(); }",
                "  virtual void f() { std::cout << \"B\"; } };",
                "struct D : B {",
                "  void f() override { std::cout << \"D\"; } };"
              ]
            }
          ]
        }
      ]
