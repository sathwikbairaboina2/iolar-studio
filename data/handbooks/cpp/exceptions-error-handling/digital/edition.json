            {
              "type": "qa",
              "q": "What does this print?",
              "example_code": [
                "struct B { ~B() { std::cout << \"~B \"; } };",
                "void f() { B b; throw std::runtime_error(\"x\"); }",
                "try { f(); } catch (const std::exception& e) { std::cout << e.what(); }"
              ],
              "a_bullets": [
                "`~B x`",
                "Unwinding destroys `b` before the handler runs"
              ]
            },
            {
              "type": "qa",
              "q": "Spot the bug: `catch (const std::exception& e) { log(); throw e; }`",
              "a_bullets": [
                "`throw e;` copies and slices to plain `std::exception`",
                "Use a bare `throw;` to keep the original object"
              ]
            },
            {
              "type": "qa",
              "q": "Does this leak? `S() : p(new int[4]) { throw 1; }` with `delete[] p` in `~S`",
              "a_bullets": [
                "Yes: the constructor never finished, so `~S` never runs",
                "Make `p` a `std::unique_ptr<int[]>`: members are destroyed"
              ]
            }
          ]
        }
