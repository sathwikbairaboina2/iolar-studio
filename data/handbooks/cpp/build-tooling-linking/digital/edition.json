              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "CMake ==generates== Make or Ninja files",
                "It does **not** compile anything itself"
              ],
              "style": "dot"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "CMakeLists.txt",
                    "ink": "blue"
                  },
                  {
                    "text": "`cmake -S . -B build`",
                    "sub": "configure",
                    "ink": "purple"
                  },
                  {
                    "text": "Makefile / Ninja",
                    "ink": "orange"
                  },
                  {
                    "text": "`cmake --build build`",
                    "sub": "compile + link",
                    "ink": "green"
                  }
                ]
              }
            },
            {
              "type": "heading",
              "text": "2. Targets",
              "ink": "purple"
            },
            {
              "type": "bullets",
              "items": [
                "Targets carry ==properties==: sources, include dirs, links",
                "`-DCMAKE_BUILD_TYPE=Release` picks Debug or Release"
              ],
              "style": "dot"
            },
            {
              "type": "code",
              "lang": "cmake",
              "lines": [
                "cmake_minimum_required(VERSION 3.20)",
                "project(app CXX)",
                "set(CMAKE_CXX_STANDARD 20)",
                "add_executable(app main.cpp util.cpp)",
                "add_library(foo STATIC foo.cpp)",
                "target_include_directories(foo PUBLIC include)",
                "target_link_libraries(app PRIVATE foo)"
              ]
            },
            {
              "type": "table",
              "headers": [
                "Keyword",
                "foo itself",
                "Consumers of foo"
              ],
              "rows": [
                [
                  "`PUBLIC`",
                  "{green:yes}",
                  "{green:yes}"
                ],
                [
                  "`PRIVATE`",
                  "{green:yes}",
                  "{red:no}"
                ],
                [
                  "`INTERFACE`",
                  "{red:no}",
                  "{green:yes}"
                ]
              ]
            },
            {
              "type": "heading",
              "text": "3. Compiler Flags",
              "ink": "orange"
            },
            {
              "type": "table",
              "headers": [
                "Flag",
