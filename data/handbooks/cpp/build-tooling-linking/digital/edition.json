      "pages": [
        {
          "title": "Build Pipeline Mental Model",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Four Stages",
              "ink": "blue"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "Preprocess",
                    "sub": ".cpp → TU",
                    "ink": "blue"
                  },
                  {
                    "text": "Compile",
                    "sub": "→ .o object",
                    "ink": "green"
                  },
                  {
                    "text": "Assemble",
                    "sub": "asm → machine code",
                    "ink": "orange"
                  },
                  {
                    "text": "Link",
                    "sub": "objects + libs → exe",
                    "ink": "purple"
                  }
                ]
              }
            },
            {
              "type": "bullets",
              "items": [
                "Each `.cpp` is compiled ==independently== into its own **translation unit (TU)**",
                "Only the ==linker== sees across TUs"
              ],
              "style": "dot"
            },
            {
              "type": "heading",
              "text": "2. Inspect Each Stage",
              "ink": "green"
            },
            {
              "type": "table",
              "headers": [
                "Command",
                "Stops after",
                "You get"
              ],
              "rows": [
                [
                  "`g++ -E main.cpp`",
                  "preprocess",
                  "expanded source (TU)"
                ],
                [
                  "`g++ -S main.cpp`",
                  "compile",
                  "assembly `main.s`"
                ],
                [
                  "`g++ -c main.cpp`",
                  "assemble",
                  "object `main.o`"
                ],
                [
                  "`g++ main.cpp`",
                  "link",
                  "full executable"
                ]
              ]
            },
            {
              "type": "heading",
              "text": "3. Declaration vs Definition",
              "ink": "purple"
            },
            {
              "type": "table",
              "headers": [
                "",
                "Says",
                "Needed by"
              ],
              "rows": [
                [
                  "Declaration",
                  "a name exists: `int f(int);`",
                  "{blue:compile}"
                ],
                [
                  "Definition",
                  "body or storage: `int f(int a){...}`",
                  "{purple:link}"
                ]
              ]
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Which error is which",
              "text": "{blue:Compile error} = syntax or type problem in ==one TU==. {purple:Linker error} = ==missing or duplicate symbol== across TUs."
            }
          ]
        }
      ]
    },
    {
      "title": "Preprocessor and Header Guards",
      "role": "outline",
      "outlineIndex": 1,
      "pages": [
        {
          "title": "Preprocessor and Header Guards",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Pure Text Substitution",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "Runs ==before compilation==; it only edits text",
                "`#include` **pastes** the file's contents",
                "`#define` **replaces** tokens",
                "`#if` / `#ifdef` **selects** which code is kept"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "heading",
              "text": "2. Header Guards",
              "ink": "blue"
            },
            {
              "type": "code",
              "lang": "cpp",
              "lines": [
                "#ifndef FOO_H",
                "#define FOO_H",
                "int add(int a, int b);",
                "#endif"
              ],
              "note": "stops the same header being pasted twice into one TU"
            },
            {
              "type": "table",
              "headers": [
                "",
                "#ifndef guard",
                "#pragma once"
              ],
              "rows": [
                [
                  "Standard",
                  "{green:yes}",
                  "{red:no}, but universal"
                ],
                [
                  "Copied or symlinked file",
                  "{green:safe}",
                  "{red:can fail}"
                ],
                [
                  "Length",
                  "4 lines",
                  "**1 line**"
                ]
              ],
              "frame": "dashed"
            },
            {
              "type": "heading",
              "text": "3. Macro Traps and Paths",
              "ink": "red"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Macros do not evaluate",
              "text": "`#define SQ(x) x*x` makes `SQ(1+2)` expand to `1+2*1+2` = ==5==. Write `((x)*(x))`, or better use `constexpr` / `inline`."
            },
            {
              "type": "table",
              "headers": [
                "Syntax",
                "Meaning"
              ],
              "rows": [
                [
                  "`#include <x>`",
                  "system and library paths"
                ],
                [
                  "`#include \"x\"`",
                  "project files"
                ],
                [
                  "`-I dir`",
                  "adds a search directory"
                ],
                [
                  "`-D NAME=1`",
                  "defines a macro from the command line"
                ]
              ]
            }
          ]
        }
      ]
    },
    {
      "title": "ODR, inline and static",
      "role": "outline",
      "outlineIndex": 2,
      "pages": [
        {
          "title": "ODR, inline and static",
          "blocks": [
            {
              "type": "heading",
              "text": "1. The One Definition Rule",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "A non-inline function or variable is ==defined once== in the whole program",
                "Break it: {red:multiple definition} error, or silent **UB**",
                "Never define a normal function or global in a header",
                "Each including TU gets its own copy, so the linker finds duplicates"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "blue"
            },
            {
              "type": "heading",
              "text": "2. Ways to Stay Safe",
              "ink": "green"
            },
            {
              "type": "table",
              "headers": [
                "Tool",
                "Effect",
                "Copies"
              ],
              "rows": [
                [
                  "`inline`",
                  "identical definitions allowed",
                  "linker keeps **one**"
                ],
                [
                  "`static` / anonymous namespace",
                  "internal linkage, hidden from linker",
                  "one **per TU**"
                ],
                [
                  "`extern int x;`",
                  "declaration only",
                  "defined in one `.cpp`"
                ]
              ],
              "frame": "dashed"
            },
            {
              "type": "bullets",
              "items": [
                "`inline` is about ==linkage==, not a speed hint",
                "C++17 allows `inline` variables too",
                "Classes, templates, `constexpr` functions are ODR-safe in headers"
              ],
              "style": "check"
            },
            {
              "type": "heading",
              "text": "3. In Practice",
              "ink": "purple"
            },
            {
              "type": "code",
              "lang": "cpp",
              "lines": [
                "// config.h",
                "inline int limit = 10;   // shared",
                "extern int count;        // declares",
                "static int hits = 0;     // per TU",
                "// config.cpp",
                "int count = 0;           // the one definition"
              ],
              "note": "exactly one definition of count"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Header rule",
              "text": "Headers hold ==declarations==, `inline`, templates and classes. Plain definitions go in one `.cpp`."
            }
          ]
        }
      ]
    },
    {
      "title": "Linker Errors and Libraries",
      "role": "outline",
      "outlineIndex": 3,
      "pages": [
        {
          "title": "Linker Errors and Libraries",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Two Linker Errors",
              "ink": "red"
            },
            {
              "type": "table",
              "headers": [
                "Error",
                "Cause",
                "Check"
              ],
              "rows": [
                [
                  "`undefined reference to foo()`",
                  "Declared, never defined; or .o/lib not passed",
                  "Signature and namespace match exactly"
                ],
                [
                  "`multiple definition of foo`",
                  "Header definition without `inline`; or .cpp linked twice",
                  "Add `inline`, or define once in a .cpp"
                ]
              ]
            },
            {
              "type": "heading",
              "text": "2. Link Order and Flags",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "==Libraries go after== the objects that need them",
                "`-L` adds a library dir",
                "`-lfoo` finds `libfoo.a` or `libfoo.so`"
              ],
              "style": "dot"
            },
            {
              "type": "code",
              "lang": "bash",
              "lines": [
                "g++ main.o -L. -lfoo"
              ],
              "note": "-lfoo comes after main.o"
            },
            {
              "type": "heading",
              "text": "3. Static vs Shared",
              "ink": "purple"
            },
            {
              "type": "table",
              "headers": [
                "",
                "Static .a",
                "Shared .so/.dll"
              ],
              "rows": [
                [
                  "Linked",
                  "Copied into the exe",
                  "Loaded at {blue:run time}"
                ],
                [
                  "Size",
                  "Larger",
                  "Smaller"
                ],
                [
                  "Update",
                  "Needs {red:relink}",
                  "Swap the library"
                ],
                [
                  "Build",
                  "`ar rcs`",
                  "needs `-fPIC`"
                ]
              ],
              "highlightRow": 0
            },
            {
              "type": "code",
              "lang": "bash",
              "lines": [
                "ar rcs libfoo.a foo.o",
                "g++ -shared -fPIC foo.cpp -o libfoo.so"
              ]
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "cannot open shared object file",
              "text": "The .so is missing at run time. Set ==LD_LIBRARY_PATH== or link with ==rpath==."
            },
            {
              "type": "sidebox",
              "title": "Interview Point",
              "items": [
                "**Undefined vs multiple?** Missing symbol vs duplicate symbol.",
                "**Why link order?** Libraries resolve what earlier objects need.",
                "**Why -fPIC?** Shared code loads at any address."
              ],
              "ink": "orange"
            }
          ]
        }
      ]
    },
