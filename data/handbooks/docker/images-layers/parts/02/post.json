        },
        {
          "type": "bullets",
          "items": [
            "Base pinned by digest, never `latest`",
            "`.dockerignore` has `.git`, `.env*`, `node_modules`",
            "Manifests copied before application source",
            "Final stage sets `USER` and an exec-form CMD",
            "`docker history` shows no secrets in any ARG"
          ]
        },
