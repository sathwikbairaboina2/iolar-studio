        },
        {
          "type": "qa",
          "q": "Why did the image not shrink after I added `rm -rf /var/cache`?",
          "a_bullets": [
            "The rm ran in a separate, later RUN",
            "The earlier layer still holds every byte",
            "All you added on top was a whiteout marker"
          ],
          "example_code": [
            "RUN apt-get install -y x && rm -rf /var/cache"
          ]
        },
        {
          "type": "heading",
          "text": "3. Quick Q"
        },
        {
          "type": "qa",
          "q": "Same Dockerfile, but CI rebuilds everything every run. Why?",
          "a_bullets": [
            "CI starts with an empty local build cache",
            "Point `--cache-from` at a registry cache image",
            "`.git` inside the context also busts COPY each commit"
          ]
        },
