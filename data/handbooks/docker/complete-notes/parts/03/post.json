        },
        {
          "type": "code",
          "lang": "dockerfile",
          "lines": [
            "FROM base        # first line",
            "ARG V=1  ENV K=v  LABEL a=b",
            "WORKDIR /app  COPY . .  ADD t.gz /",
            "RUN cmd  EXPOSE 80  VOLUME /data",
            "USER app  HEALTHCHECK CMD curl -f",
            "ENTRYPOINT [\"exec\"]  CMD [\"args\"]"
          ],
          "note": "exec form = JSON array, app is PID 1"
        }
      ],
      "hero": "docker",
      "subtitle": "(production habits and the traps that bite later)"
    },
    {
      "page_title": "Layer Transfer on Pull and Push",
      "blocks": [
        {
          "type": "heading",
          "text": "4. Volumes & Networks",
          "ink": "orange"
        },
        {
          "type": "sidebox",
          "title": "Volumes",
          "items": [
            "`docker volume create v` | `ls` | `inspect` | `rm` | `prune`",
            "Named: `-v v:/data`; bind: `-v $(pwd):/app`",
            "tmpfs: `--tmpfs /run` (memory only)",
            "Append `:ro` for ==read-only== mounts"
          ],
          "ink": "orange"
        },
        {
          "type": "callout",
          "style": "sticky",
          "title": "Signals",
          "text": "`docker stop` = ==SIGTERM==, then SIGKILL after 10s. Use exec-form CMD/ENTRYPOINT so PID 1 is **your app**; add `--init` for zombie reaping."
        },
        {
          "type": "heading",
          "text": "5. Compose & Registry",
