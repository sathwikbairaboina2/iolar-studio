          "ink": "red"
        },
        {
          "type": "bullets",
          "items": [
            "`USER` non-root; ==pin== base image tags",
            "No secrets in `ENV` or `ARG` (they stay in layers)",
            "`--cap-drop ALL`; **never** mount `docker.sock`",
            "Scan images in CI before push"
          ],
          "style": "checkbox",
          "frame": "dashed",
          "ink": "red"
