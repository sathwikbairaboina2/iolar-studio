            "docker compose up -d | down -v",
            "docker compose ps | logs -f svc",
            "docker compose exec svc sh",
            "docker compose build | pull | config",
            "docker compose up --scale svc=3",
            "docker compose -f a.yml -f b.yml up"
          ],
          "note": "override.yml auto-merged; .env fills ${VAR}"
        },
        {
          "type": "heading",
          "text": "6. Cleanup & Exit Codes",
          "ink": "red"
        },
        {
          "type": "code",
          "lang": "bash",
          "lines": [
            "docker system df        # disk usage",
            "docker system prune -a --volumes",
            "docker container prune",
            "docker builder prune    # build cache"
          ],
          "note": "-a also drops unused images"
        },
