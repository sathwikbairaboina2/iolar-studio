          "runnable": false
        },
        {
          "type": "bullets",
          "items": [
            "Multi-stage: toolchain ≠ runtime",
            "No shells, pkg managers in runtime",
            "Fewer tools = fewer post-exploit moves"
          ]
        },
        {
          "type": "heading",
          "text": "Pin & Ignore",
          "ink": "red"
        },
        {
          "type": "code",
          "lang": "dockerfile",
          "lines": [
            "FROM node:20@sha256:abc123...",
            "# digest = reproducible build",
            "COPY --chown=node:node . .",
            "USER node"
          ],
          "runnable": false
        },
        {
          "type": "bullets",
          "items": [
            "`.dockerignore`: `.env`, `.git`, keys",
            "`COPY .` leaks secrets into layers",
            "`COPY --chown` beats post-hoc `chown` layers"
          ]
        },
        {
          "type": "diagram",
          "kind": "cards",
          "spec": {
            "cards": [
              {
                "title": "fat image",
                "lines": [
