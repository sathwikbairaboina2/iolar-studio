  "slides": [
    {
      "page_title": "Threat Model",
      "blocks": [
        {
          "type": "heading",
          "text": "Containers ≠ VMs",
          "ink": "blue"
        },
        {
          "type": "bullets",
          "items": [
            "Namespaces (`pid`,`net`,`mnt`,`user`) + `cgroups`",
            "All containers share the host kernel",
            "Breakout = kernel vuln or privileged syscall"
          ]
        },
        {
          "type": "paragraph",
          "text": "Root in a container ≈ root on host at kernel level. Docker is isolation by default, not a boundary."
        },
        {
          "type": "heading",
          "text": "Attack Surfaces",
          "ink": "red"
        },
        {
          "type": "table",
          "headers": [
            "surface",
            "example"
          ],
          "rows": [
            [
              "engine",
              "`dockerd` compromise"
            ],
            [
              "host kernel",
              "kernel exploit"
            ],
            [
              "mounts",
              "`/` bind mount"
            ],
            [
              "network",
              "flat bridge"
            ],
            [
              "image",
              "malware layers"
            ]
          ]
        },
        {
          "type": "bullets",
          "items": [
            "Threat actors: supply chain, runtime escape, leaked secrets",
            "`--privileged` removes nearly all isolation",
            "Red flag in any Dockerfile or run cmd"
          ]
        },
        {
          "type": "diagram",
          "kind": "flow",
          "spec": {
            "nodes": [
              "non-root",
              "drop caps",
              "seccomp",
              "read-only FS",
              "scan",
              "secrets"
            ]
          }
        },
        {
          "type": "callout",
          "style": "takeaway",
          "title": "Rule of thumb",
          "text": "Each layer shrinks blast radius. No single control stops every escape vector."
        },
        {
          "type": "qa",
          "q": "Is a container a security boundary?",
          "a_bullets": [
            "No, by default",
            "Add user namespaces + layers",
            "Defense in depth, always"
          ]
        },
        {
          "type": "heading",
          "text": "Why Drop UID 0",
          "ink": "blue"
        },
        {
          "type": "bullets",
          "items": [
            "UID 0 inherits kernel-level power",
            "Historic escapes needed root",
            "Create user after `apt install`"
          ]
        },
        {
          "type": "code",
          "lang": "dockerfile",
          "lines": [
            "FROM debian:12",
            "RUN adduser --system \\",
            "  --no-create-home appuser",
            "COPY --chown=appuser app /app",
            "USER appuser"
          ],
          "runnable": false
        },
        {
          "type": "bullets",
          "items": [
            "Runtime override: `docker run --user 1000:1000`",
            "Works even on root-default images",
            "K8s: `runAsNonRoot: true` in securityContext"
          ]
        },
        {
          "type": "heading",
          "text": "Gotchas",
          "ink": "red"
        },
        {
          "type": "bullets",
          "items": [
            "Files made before `USER` stay root-owned",
            "`chown` first or bind mounts fail to write",
            "Ports <1024 privileged → use 8080"
          ]
        },
        {
          "type": "code",
          "lang": "bash",
          "lines": [
            "sysctl net.ipv4.\\",
            "  ip_unprivileged_port_start=0",
            "# or: --cap-add NET_BIND_SERVICE"
          ],
          "runnable": false
        },
        {
          "type": "bullets",
          "items": [
            "`userns-remap` maps root → host UID range",
            "Breaks shared volumes + some images",
            "Set `ENV HOME=/home/appuser`"
          ]
        },
        {
          "type": "sidebox",
          "title": "Verify",
          "items": [
            "`docker exec c id` → uid=1000",
            "`docker inspect` → `.Config.User`"
          ],
          "ink": "green"
        }
      ]
    },
    {
      "page_title": "Running as Non-Root",
      "blocks": [
        {
          "type": "qa",
          "q": "App still crashes as non-root?",
          "a_bullets": [
            "Check root-owned file perms",
            "Check `$HOME` env",
            "Check privileged port"
          ]
        },
        {
          "type": "heading",
          "text": "Root, Split Up",
          "ink": "blue"
        },
        {
          "type": "bullets",
          "items": [
            "~40 caps: `CAP_SYS_ADMIN`, `CAP_NET_ADMIN`...",
            "Docker grants a default subset",
            "Default drop list removes the worst"
          ]
        },
        {
          "type": "table",
          "headers": [
            "cap",
            "power"
          ],
          "rows": [
            [
              "`CAP_SYS_ADMIN`",
              "mount, ns — 'new root'"
            ],
            [
              "`CAP_NET_ADMIN`",
              "firewall, routing"
            ],
            [
              "`CAP_DAC_OVERRIDE`",
              "ignore perms"
            ],
            [
              "`CAP_SYS_PTRACE`",
              "inspect procs"
            ]
          ]
        },
        {
          "type": "code",
          "lang": "bash",
          "lines": [
            "docker run --cap-drop=ALL \\",
            "  --cap-add=NET_BIND_SERVICE \\",
            "  myapp:1.0   # whitelist only"
          ],
          "runnable": false
        },
        {
          "type": "heading",
          "text": "Auditing Caps",
          "ink": "green"
        },
        {
          "type": "code",
          "lang": "bash",
          "lines": [
            "docker exec c sh -c \\",
            "  'grep Cap /proc/1/status'",
            "capsh --decode 0x00000000a80425fb",
            "capsh --print  # bounding set"
          ],
          "runnable": false
        },
        {
          "type": "bullets",
          "items": [
            "`setcap cap_net_bind_service+ep nginx`",
            "Per-binary cap, no container-wide root",
            "Avoid `CAP_SYS_ADMIN` unless legit"
          ]
        },
        {
          "type": "callout",
          "style": "tip",
          "title": "Bounding set",
          "text": "`--cap-add` can't restore caps dropped from the bounding set — restart with the right flags."
        },
        {
          "type": "diagram",
          "kind": "cards",
          "spec": {
            "cards": [
              {
                "title": "`--privileged`",
                "lines": [
                  "all caps",
                  "+ devices",
                  "cgroup write"
                ]
              },
              {
                "title": "whitelist",
                "lines": [
                  "drop ALL",
                  "add 1-2 caps",
                  "prod-safe"
                ]
              }
            ]
          }
        },
        {
          "type": "heading",
          "text": "Syscall Firewall",
          "ink": "blue"
        },
        {
          "type": "bullets",
          "items": [
            "BPF filter attached at process start",
            "Default profile blocks ~44 risky syscalls",
            "`kexec_load`, `keyctl`, `open_by_handle_at`"
          ]
        },
        {
          "type": "diagram",
          "kind": "flow",
          "spec": {
            "nodes": [
              "process",
              "syscall",
              "BPF filter",
              "allow / EPERM"
            ]
          }
        },
        {
          "type": "code",
          "lang": "json",
          "lines": [
            "{\"defaultAction\":",
            " \"SCMP_ACT_ERRNO\",",
            " \"syscalls\": [{\"names\":",
            "  [\"read\",\"write\"],",
            "  \"action\":\"SCMP_ACT_ALLOW\"}]}"
          ],
          "runnable": false
        },
        {
          "type": "heading",
          "text": "Usage",
          "ink": "green"
        },
        {
          "type": "bullets",
          "items": [
            "`--security-opt seccomp=profile.json`",
            "`seccomp=unconfined` disables — never in prod",
            "`notify` action → proxy to supervisor (gVisor)"
          ]
        },
        {
          "type": "table",
          "headers": [
            "control",
            "gates"
          ],
          "rows": [
            [
              "capabilities",
              "resources touched"
            ],
            [
              "seccomp",
              "kernel entry points"
            ]
          ]
        }
      ]
    },
    {
      "page_title": "Seccomp",
      "blocks": [
        {
          "type": "callout",
          "style": "tip",
          "title": "Debugging",
          "text": "Random `EPERM`? Often seccomp. Run `strace -c` outside the filter to derive the allowlist."
        },
        {
          "type": "sidebox",
          "title": "Gotchas",
          "items": [
            "Not namespaced — per container",
            "Set at run time, not in image",
            "Keep profiles minimal allowlists"
          ],
          "ink": "red"
        },
        {
          "type": "heading",
          "text": "Read-Only Root",
          "ink": "blue"
        },
        {
          "type": "code",
          "lang": "bash",
          "lines": [
            "docker run --read-only \\",
            "  --tmpfs /tmp:rw,noexec,\\",
            "  nosuid,size=64m myapp"
          ],
          "runnable": false
        },
        {
          "type": "bullets",
          "items": [
            "Tamper-proof + ransomware-resistant",
            "Volumes stay writable under `--read-only`",
            "Grant only the paths the app needs"
          ]
        },
        {
          "type": "heading",
          "text": "Why `tmpfs` Flags",
          "ink": "red"
        },
        {
          "type": "table",
          "headers": [
            "flag",
            "blocks"
          ],
          "rows": [
            [
              "`noexec`",
              "running payloads"
            ],
            [
              "`nosuid`",
              "setuid escalation"
            ],
            [
              "`size=64m`",
              "disk-fill abuse"
            ]
          ]
        },
        {
          "type": "bullets",
          "items": [
            "PID files, caches break → fix via env config",
            "Pair with `--cap-drop=ALL`",
            "No writable code path + no root powers"
          ]
        },
        {
          "type": "heading",
          "text": "cgroup Limits",
          "ink": "green"
        },
        {
          "type": "code",
          "lang": "bash",
          "lines": [
            "--memory=512m",
            "--pids-limit=100  # fork bombs",
            "--cpus=1.5"
          ],
          "runnable": false
        },
        {
          "type": "diagram",
          "kind": "cards",
          "spec": {
            "cards": [
              {
                "title": "no limits",
                "lines": [
                  "fork bomb eats host",
                  "noisy neighbors"
