              {
                "title": "limited",
                "lines": [
                  "escape hits wall",
                  "OOM-contained"
                ]
              }
            ]
          }
        },
        {
          "type": "callout",
          "style": "takeaway",
          "title": "Gotcha",
          "text": "`apk`/`apt` need writable `/var` — do installs at build time, never runtime."
        },
        {
          "type": "heading",
          "text": "Minimal Bases",
          "ink": "blue"
