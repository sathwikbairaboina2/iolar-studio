                "sub": "its real state"
              }
            ]
          }
        },
        {
          "type": "heading",
          "text": "5. Production Checklist",
          "ink": "red"
        },
        {
          "type": "bullets",
          "items": [
            "Pin image digests — never `latest`",
            "Resource limits set; logs capped with `max-size` / `max-file`",
            "A healthcheck on every service that others gate on",
            "No source bind mounts; secrets as files",
            "Back up named volumes yourself — nothing else will"
          ],
          "style": "checkbox"
        }
      ]
