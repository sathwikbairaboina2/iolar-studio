    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "A plan shows a Nested Loop with `rows=10`, but `actual rows=1000000`. What went wrong, and what is the right fix?",
              "a_bullets": [
                "The estimate was 10x or more off, so the planner picked a join suited to a small outer side",
                "Fix the estimate: ==ANALYZE== or extended stats, not a join hint"
              ]
            },
            {
              "type": "qa",
              "q": "An index exists on `status`, and `WHERE status='active'` matches 60% of the rows. EXPLAIN shows a Seq Scan. Is that a bug?",
              "a_bullets": [
                "No, the planner is right",
                "An index scan makes random heap fetches for most of the table, which costs more than one sequential pass"
              ]
            },
            {
              "type": "qa",
              "q": "On 1M rows, `city='Paris'` has selectivity 0.01 and `zip='75001'` has 0.01. What rows does the planner estimate for both together, and why can that be wrong?",
              "a_bullets": [
                "1M × 0.01 × 0.01 = ==100 rows==",
                "City and zip are correlated, so the real count may be thousands: a big underestimate"
              ]
            }
          ]
        }
      ]
    }
