            },
            {
              "type": "table",
              "headers": [
                "Situation",
                "Pick"
              ],
              "rows": [
                [
                  "Few rows (high selectivity)",
                  "**Index scan**"
                ],
                [
                  "Medium selectivity",
                  "**Bitmap scan**"
                ],
                [
                  "Most of the table",
                  "**Seq scan**"
                ],
                [
                  "Covering index + vacuumed table",
                  "**Index-only scan**"
                ],
                [
                  "Small outer + indexed inner",
                  "**Nested loop**"
                ],
