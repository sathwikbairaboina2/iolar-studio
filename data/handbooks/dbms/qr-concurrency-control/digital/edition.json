  "sections": [
    {
      "title": "Serializability Mental Model",
      "role": "outline",
      "outlineIndex": 0,
      "pages": [
        {
          "title": "Serializability Mental Model",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Serializable and Conflicts",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "==Serializable== schedule: interleaved run whose result equals some serial (one-at-a-time) order",
                "Conflict needs {green:same item}",
                "Conflict needs {blue:different transactions}",
                "Conflict needs {red:at least one write}"
              ],
              "style": "check",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "table",
              "headers": [
                "Pair",
                "Conflict?"
              ],
              "rows": [
                [
                  "R-R",
                  "{green:never}"
                ],
                [
                  "R-W",
                  "{red:yes}"
                ],
                [
                  "W-R",
                  "{red:yes}"
                ],
                [
                  "W-W",
                  "{red:yes}"
                ]
              ]
            },
            {
              "type": "heading",
              "text": "2. Precedence Graph Test",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "==Conflict serializable==: swap adjacent non-conflicting ops until the schedule is serial",
                "==Acyclic== graph ⇒ conflict serializable; a **cycle** ⇒ not"
              ],
              "style": "dot",
              "ink": "blue"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "Node per transaction",
                    "ink": "blue"
                  },
                  {
                    "text": "Edge Ti→Tj",
                    "sub": "Ti op conflicts with and precedes Tj op",
                    "ink": "purple"
                  },
                  {
                    "text": "Look for cycle",
                    "ink": "red"
                  },
                  {
                    "text": "Topological sort",
                    "sub": "equivalent serial order",
                    "ink": "green"
                  }
                ]
              }
            },
            {
              "type": "heading",
              "text": "3. How Far It Goes",
              "ink": "purple"
            },
            {
              "type": "bullets",
              "items": [
                "Conflict serializable ⊂ serializable",
                "View serializable also admits ==blind writes==",
                "Engines enforce only the **conflict** form: cheap to test"
              ],
              "style": "dot",
              "ink": "purple"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Remember",
              "text": "R-R never conflicts. One cycle in the precedence graph means no equivalent serial order."
            }
          ]
        }
      ]
    },
    {
      "title": "Shared and Exclusive Locks",
      "role": "outline",
      "outlineIndex": 1,
      "pages": [
        {
          "title": "Shared and Exclusive Locks",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Lock Modes and Compatibility",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "{green:S lock} = **read**; many holders at once",
                "{red:X lock} = **write**; one holder, blocks every S and X request",
                "Blocked requester ==waits== in the queue"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "table",
              "headers": [
                "Held \\ Request",
                "S",
                "X"
              ],
              "rows": [
                [
                  "S",
                  "{green:allowed}",
                  "{red:wait}"
                ],
                [
                  "X",
                  "{red:wait}",
                  "{red:wait}"
                ]
              ],
              "frame": "dashed"
            },
            {
              "type": "heading",
              "text": "2. Upgrade S→X",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "Upgrade succeeds only if ==no other== transaction holds S",
                "Two transactions upgrading the same item ==deadlock=="
              ],
              "style": "dot"
            },
            {
              "type": "diagram",
              "kind": "chain",
              "spec": {
                "steps": [
                  {
                    "text": "T1, T2 hold S(A)",
                    "ink": "green"
                  },
                  {
                    "text": "T1 asks X(A)",
                    "note": "waits for T2",
                    "ink": "blue"
                  },
                  {
                    "text": "T2 asks X(A)",
                    "note": "waits for T1",
                    "ink": "orange"
                  },
                  {
                    "text": "Deadlock",
                    "ink": "red"
                  }
                ]
              }
            },
            {
              "type": "heading",
              "text": "3. Locks Alone Are Not Enough",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "Unlocking right after each operation allows non-serializable runs",
                "{red:Lost update}: both read, both write, one write vanishes",
                "{red:Unrepeatable read}: a re-read sees another commit"
              ],
              "style": "cross",
              "frame": "dashed",
              "ink": "red"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Remember",
              "text": "Serializability depends on **when** locks are released, not just on S and X modes."
            },
            {
              "type": "sidebox",
              "title": "Interview Point",
              "items": [
                "**Can two readers share an item?** Yes, S+S is allowed.",
                "**Why can upgrades deadlock?** Each holds S and waits for the other.",
                "**Do locks alone ensure serializability?** No, release timing matters."
              ],
              "ink": "purple"
            }
          ]
        }
      ]
    },
    {
      "title": "Two-Phase Locking and Deadlocks",
      "role": "outline",
      "outlineIndex": 2,
      "pages": [
        {
          "title": "Two-Phase Locking and Deadlocks",
          "blocks": [
            {
              "type": "heading",
              "text": "1. The 2PL Rule",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "{green:Growing}: only ==acquire== locks",
                "{red:Shrinking}: only ==release==; after the first unlock, **never lock again**",
                "Guarantees ==conflict serializability==",
                "Serial order = order of the **lock points**"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "Growing",
                    "sub": "acquire only",
                    "ink": "green"
                  },
                  {
                    "text": "Lock point",
                    "sub": "last lock taken",
                    "ink": "blue"
                  },
                  {
                    "text": "Shrinking",
                    "sub": "release only",
                    "ink": "red"
                  }
                ]
              }
            },
            {
              "type": "heading",
              "text": "2. Strict 2PL",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "",
                "Holds until commit/abort",
                "Prevents"
              ],
              "rows": [
                [
                  "Strict 2PL",
                  "all **X** locks",
                  "dirty reads, cascading aborts"
                ],
                [
                  "Rigorous (strong strict)",
                  "**X** and **S** locks",
                  "same, plus commit order = serial order"
                ]
              ],
              "highlightRow": 0
            },
            {
              "type": "paragraph",
              "text": "Real engines use ==strict== or ==rigorous== 2PL, not the basic form.",
              "ink": "blue"
            },
            {
              "type": "heading",
              "text": "3. Deadlocks",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "2PL ==does not prevent== deadlock: T1 holds A, wants B; T2 holds B, wants A",
                "Detect: ==wait-for graph==; on a cycle, abort a victim (cheapest or youngest)",
                "Crude alternative: ==lock timeout==",
                "Prevent: one ==global lock order==, so no cycle can form"
              ],
              "style": "cross",
              "ink": "red"
            },
            {
              "type": "table",
              "headers": [
                "Timestamp scheme",
                "Older wants younger's lock",
                "Younger wants older's lock"
              ],
              "rows": [
                [
                  "wait-die",
                  "Older **waits**",
                  "Younger **dies**"
                ],
                [
                  "wound-wait",
                  "Older **wounds** younger",
                  "Younger **waits**"
                ]
              ]
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "After a deadlock abort",
              "text": "The victim is rolled back. The ==application must retry== the transaction."
            }
          ]
        }
      ]
    },
    {
      "title": "MVCC Snapshots",
      "role": "outline",
      "outlineIndex": 3,
      "pages": [
        {
          "title": "MVCC Snapshots",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Versions, Not Overwrites",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "Every write makes a ==new row version== stamped with its **txn ID**",
                "Old versions are kept: {blue:heap} (PostgreSQL) or {purple:undo log} (InnoDB, Oracle)",
                "InnoDB, Oracle: update in place; undo rebuilds old rows"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "table",
              "headers": [
                "Engine",
                "New version",
                "Old version"
              ],
              "rows": [
                [
                  "PostgreSQL",
                  "new tuple",
                  "heap"
                ],
                [
                  "InnoDB",
                  "in-place update",
                  "undo log"
                ],
                [
                  "Oracle",
                  "in-place update",
                  "undo log"
                ]
              ]
            },
            {
              "type": "heading",
              "text": "2. Snapshots and Write Skew",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "Reader sees a ==snapshot== from txn (or statement) start",
                "No read locks: readers never block writers, nor writers readers",
                "Same-row writes ==serialize== on a row lock; second waits or fails",
                "==Write skew== under snapshot isolation (PostgreSQL REPEATABLE READ, Oracle)"
              ],
              "style": "dot"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "T1, T2 read",
                    "sub": "2 doctors on call",
                    "ink": "blue"
                  },
                  {
                    "text": "T1 updates Alice",
                    "sub": "off call",
                    "ink": "orange"
                  },
                  {
                    "text": "T2 updates Bob",
                    "sub": "off call",
                    "ink": "orange"
                  },
                  {
                    "text": "Invariant broken",
                    "sub": "0 on call",
                    "ink": "red"
                  }
                ]
              }
            },
            {
              "type": "heading",
              "text": "3. Cleanup and Fixes",
              "ink": "purple"
            },
            {
              "type": "bullets",
              "items": [
                "Old versions pile up: {blue:VACUUM} (PostgreSQL), {purple:purge} (InnoDB)",
                "A long-running txn pins old versions and ==bloats== storage"
              ],
              "style": "cross",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "True `SERIALIZABLE`: PostgreSQL SSI aborts one txn",
                "`SELECT ... FOR UPDATE` on the rows read",
                "A constraint that encodes the invariant"
              ],
              "style": "check",
              "ink": "green"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Retry",
              "text": "SSI aborts one txn: ==retry it==."
            }
          ]
        }
      ]
    },
    {
      "title": "Optimistic Concurrency Control",
      "role": "outline",
      "outlineIndex": 4,
      "pages": [
        {
          "title": "Optimistic Concurrency Control",
          "blocks": [
            {
              "type": "heading",
              "text": "1. What OCC Is",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "==No locks== while the transaction runs",
                "Read, then compute on **private copies**",
                "{red:Validate at commit}: abort on conflict"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "heading",
              "text": "2. Three Phases",
              "ink": "blue"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "Read",
                    "sub": "work on local copy",
                    "ink": "green"
                  },
                  {
                    "text": "Validate",
                    "sub": "did anyone change what I read or wrote?",
                    "ink": "orange"
                  },
                  {
                    "text": "Write",
                    "sub": "apply changes",
                    "ink": "blue"
                  }
                ]
              }
            },
            {
              "type": "heading",
              "text": "3. Version Column Pattern",
              "ink": "purple"
            },
            {
              "type": "bullets",
              "items": [
                "Add a ==version== column; bump it on every update",
                "`WHERE version=?` is the validate step",
                "{red:0 rows affected} = conflict: re-read, retry"
              ],
              "style": "dot"
            },
            {
              "type": "code",
              "lang": "sql",
              "lines": [
                "UPDATE items",
                "SET qty = qty - 1, version = version + 1",
                "WHERE id = 7 AND version = 3;"
              ],
              "note": "0 rows means someone else bumped the version"
            },
            {
              "type": "heading",
              "text": "4. Pessimistic vs OCC",
              "ink": "orange"
            },
            {
              "type": "table",
              "headers": [
                "",
                "Pessimistic (2PL, `FOR UPDATE`)",
                "OCC"
              ],
              "rows": [
                [
                  "Wins when",
                  "{red:high contention}",
                  "{green:low contention}, long think-time (web forms)"
                ],
                [
                  "On conflict",
                  "waits for lock",
                  "aborts and retries"
                ],
                [
                  "Cost",
                  "blocked waiters",
                  "wasted aborted work"
                ]
              ],
              "highlightRow": 0
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Check the count",
              "text": "Always check ==rows affected==; ignoring it **silently loses updates**. Bound retries and use backoff."
            }
          ]
        }
      ]
    },
    {
      "title": "Concurrency Control Cheat Sheet",
      "role": "outline",
      "outlineIndex": 5,
      "pages": [
        {
          "title": "Concurrency Control Cheat Sheet",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Conflicts and Locks",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "==Conflict== = same item + different transactions + at least one write",
                "Precedence graph ==acyclic== ⇒ conflict serializable",
                "Upgrade S→X on one item by two transactions ⇒ {red:deadlock}"
              ],
              "style": "dot"
            },
            {
              "type": "table",
              "headers": [
                "Held / Asked",
                "S",
                "X"
              ],
              "rows": [
                [
                  "S",
                  "{green:ok}",
                  "{red:wait}"
                ],
                [
                  "X",
                  "{red:wait}",
                  "{red:wait}"
                ]
              ]
            },
            {
              "type": "heading",
              "text": "2. 2PL and Deadlocks",
              "ink": "blue"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "Grow",
                    "sub": "acquire only",
                    "ink": "green"
                  },
                  {
                    "text": "Lock point",
                    "sub": "last lock",
                    "ink": "blue"
                  },
                  {
                    "text": "Shrink",
                    "sub": "release only",
                    "ink": "orange"
                  },
                  {
                    "text": "Commit",
                    "sub": "Strict: X held till here",
                    "ink": "purple"
                  }
                ]
              }
            },
            {
              "type": "bullets",
              "items": [
                "Deadlock fix: ==global lock order==",
                "Or ==wait-for graph== cycle ⇒ abort a victim",
                "Always ==retry== the aborted transaction"
              ],
              "style": "check"
            },
            {
              "type": "heading",
              "text": "3. MVCC and OCC",
              "ink": "purple"
            },
            {
              "type": "bullets",
              "items": [
                "MVCC: ==readers never block writers==; old versions live in the heap (PostgreSQL) or undo (InnoDB, Oracle)",
                "Snapshot isolation still allows ==write skew==",
                "Fix: `SERIALIZABLE` or `SELECT ... FOR UPDATE`"
              ],
              "style": "dot"
            },
            {
              "type": "table",
              "headers": [
                "",
                "Pessimistic locks",
                "OCC + version column"
              ],
              "rows": [
                [
                  "Best for",
                  "hot rows",
                  "rare conflicts"
                ],
                [
                  "Cost",
                  "waiting",
                  "wasted work"
                ]
              ]
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Check the count",
              "text": "`UPDATE ... WHERE version=?` hitting 0 rows = conflict. Re-read, retry with backoff."
            }
          ]
        }
      ]
    },
    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "T1 and T2 each run R(A) then W(A), interleaved as R1, R2, W1, W2. Is this conflict serializable?",
              "a_bullets": [
                "No: R1 before W2 gives T1→T2, and R2 before W1 gives T2→T1.",
                "The precedence graph has a cycle, so no serial order matches (a lost update)."
              ]
            },
            {
              "type": "qa",
              "q": "Two transactions both hold an S lock on row X, then each requests an X lock. What happens?",
              "a_bullets": [
                "Each waits for the other's S lock to go: a deadlock.",
                "The engine aborts a victim, and the application must retry it."
              ]
            },
            {
              "type": "qa",
              "q": "Under snapshot isolation, the rule is one doctor on call. Both see 2 on call and each sets their own row off. Result?",
              "a_bullets": [
                "Both commit and nobody is on call: write skew.",
                "They wrote different rows, so no write conflict. Fix: SERIALIZABLE or `FOR UPDATE`."
              ]
            }
          ]
        }
      ]
    }
  ]
