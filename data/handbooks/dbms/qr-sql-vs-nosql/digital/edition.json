          "title": "Database Families and Mental Model",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Five families",
              "ink": "green"
            },
            {
              "type": "table",
              "headers": [
                "Family",
                "Data shape",
                "Strength",
                "Examples"
              ],
              "rows": [
                [
                  "Relational",
                  "Tables, fixed schema",
                  "SQL joins, strong transactions",
                  "PostgreSQL, MySQL"
                ],
                [
                  "Document",
                  "JSON-like, flexible schema",
                  "Nested data in one fetch",
                  "MongoDB"
                ],
                [
                  "Key-value",
                  "Key to value",
                  "get/put by key, fastest, simplest",
                  "Redis, DynamoDB"
                ],
                [
                  "Wide-column",
                  "Partition key, sparse column families",
                  "Huge write volume",
                  "Cassandra, HBase"
                ],
                [
                  "Graph",
                  "Nodes and edges",
                  "Fast multi-hop traversals",
                  "Neo4j"
                ]
              ],
              "frame": "dashed"
            },
            {
              "type": "heading",
              "text": "2. Mental model: the query shape",
              "ink": "blue"
            },
