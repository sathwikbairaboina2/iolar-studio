    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "N=3, W=2, R=1. Can a read return stale data?",
              "a_bullets": [
                "Yes: R + W = 3, not above N=3.",
                "The read may hit the one replica missing the write.",
                "Use R=2 so read and write sets overlap."
              ]
            },
            {
              "type": "qa",
              "q": "A CP store splits; a client reaches the minority side and writes. What happens?",
              "a_bullets": [
                "The write is refused or errors.",
                "Consistency is kept, availability is lost.",
                "Only the majority side keeps serving."
              ]
            },
            {
              "type": "qa",
              "q": "Orders are range-sharded by auto-increment id. Which shard is overloaded?",
              "a_bullets": [
                "The last one: every new id lands there.",
                "Hash the key to spread writes.",
                "Cost: range scans now hit every shard."
              ]
            },
            {
              "type": "qa",
              "q": "A 5k-user app picks Cassandra for scale, then needs joins and transactions. Mistake?",
              "a_bullets": [
                "It chose for scale it did not have.",
                "Start from access patterns; default to PostgreSQL."
              ]
            }
          ]
        }
      ]
