                ],
                [
                  "Differential",
                  "changes since last **full**",
                  "full + latest differential"
                ],
                [
                  "Incremental",
                  "changes since last backup of **any** type",
                  "full + all incrementals in order"
                ]
              ]
            },
            {
              "type": "heading",
              "text": "2. WAL, PITR and ARIES",
              "ink": "blue"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "Base backup",
                    "sub": "restore first",
                    "ink": "green"
                  },
                  {
                    "text": "Replay WAL",
                    "sub": "archived logs",
                    "ink": "blue"
                  },
