                "Sync",
                "Async"
              ],
              "rows": [
                [
                  "Data loss",
                  "none",
                  "lag can lose commits"
                ],
                [
                  "Commit speed",
                  "slower",
                  "fast"
                ]
              ]
            },
            {
              "type": "heading",
              "text": "4. Access Control",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "`GRANT` / `REVOKE` privileges to **roles**; assign users to roles",
                "Apply ==least privilege==: one role per app",
                "RLS: `USING` filters reads, `WITH CHECK` controls writes",
                "==Restore-test== regularly"
              ],
              "style": "check"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Remember",
              "text": "Replication is **not** a backup: a bad `DROP TABLE` replicates instantly."
            }
          ]
        }
      ]
