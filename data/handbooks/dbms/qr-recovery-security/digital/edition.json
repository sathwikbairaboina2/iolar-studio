    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "Full backup Sunday, incremental Mon to Wed. The disk dies Thursday morning. What do you restore, and what changes if the daily backups were differential?",
              "a_bullets": [
                "Incremental: Sunday full, then Mon, Tue, Wed in order.",
                "Differential: Sunday full plus only Wednesday's, since it holds everything since the full."
              ]
            },
            {
              "type": "qa",
              "q": "A DROP TABLE ran at 14:05:10. The team has a synchronous replica and plans to fail over to it. Why does that not get the table back?",
              "a_bullets": [
                "The DROP replicated to the replica immediately.",
                "Use PITR instead: restore the base backup, replay archived WAL to a time just before 14:05:10.",
                "This only works if WAL archiving was on before the incident."
              ]
            },
            {
              "type": "qa",
              "q": "Crash: T1 committed but its pages never reached disk. T2 never committed but one of its dirty pages did. What does ARIES do?",
              "a_bullets": [
                "Analysis finds the dirty pages and active transactions.",
                "Redo repeats all history, including T1 (no-force) and T2.",
                "Undo then rolls back T2 (steal), writing CLRs."
              ]
            }
          ]
        }
      ]
    }
