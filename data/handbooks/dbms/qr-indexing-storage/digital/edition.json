    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "An index on (a, b, c) exists. Does `WHERE b = 5 AND c = 2` use it for a seek?",
              "a_bullets": [
                "No: the leftmost-prefix rule needs `a` first.",
                "Without `a`, the sorted order doesn't help.",
                "Expect a scan."
              ]
            },
            {
              "type": "qa",
              "q": "InnoDB, secondary index on `email`. How many tree traversals does `SELECT * WHERE email = 'x'` take?",
              "a_bullets": [
                "Two.",
                "Secondary index gives the primary key.",
                "Clustered index then gives the row."
              ]
            },
            {
              "type": "qa",
              "q": "Inserts slow down after switching the clustered key from an auto-increment id to UUIDv4. Why?",
              "a_bullets": [
                "Random keys land in random pages.",
                "Full pages split, causing fragmentation.",
                "Sequential keys just append to the last page."
              ]
            },
            {
              "type": "qa",
              "q": "A hash index exists on `id`. Is `WHERE id BETWEEN 5 AND 9` fast?",
              "a_bullets": [
                "No: hashing destroys key order.",
                "Hash serves only `=`.",
                "Use a B+ tree and walk the linked leaves."
              ]
            }
          ]
        }
      ]
    }
