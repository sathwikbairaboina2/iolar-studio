                    "ink": "blue"
                  },
                  {
                    "text": "Candidate key",
                    "sub": "minimal",
                    "ink": "purple"
                  },
                  {
                    "text": "Primary key",
                    "sub": "chosen, no NULL",
                    "ink": "green"
                  },
                  {
                    "text": "Foreign key",
                    "sub": "points to a key",
