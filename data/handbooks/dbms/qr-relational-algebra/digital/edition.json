      "pages": [
        {
          "title": "Relational Model and Keys",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Relation and Domain",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "==Relation== = set of tuples (rows) over a schema of attributes (columns)",
                "It is a set: ==no duplicate tuples==, ==row order irrelevant==",
                "==Domain== = allowed atomic values, e.g. age: integers 0-150",
                "==Degree== = number of attributes; ==cardinality== = number of tuples"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "blue"
            },
            {
              "type": "heading",
              "text": "2. Kinds of Keys",
              "ink": "purple"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "Super key",
                    "sub": "uniquely identifies",
                    "ink": "blue"
                  },
                  {
                    "text": "Candidate key",
                    "sub": "minimal super key",
                    "ink": "purple"
                  },
                  {
                    "text": "Primary key",
                    "sub": "chosen, no NULLs",
                    "ink": "green"
                  }
                ]
              }
            },
            {
              "type": "table",
              "headers": [
                "Key",
                "Meaning",
                "Student(id, email, name)"
              ],
              "rows": [
                [
                  "Super key",
                  "any unique attribute set",
                  "`{id, name}`"
                ],
                [
                  "Candidate key",
                  "drop any attribute, uniqueness lost",
                  "`id`, `email`"
                ],
                [
                  "Primary key",
                  "one chosen candidate",
                  "`id`"
                ],
                [
                  "Alternate key",
                  "remaining candidates",
                  "`email`"
                ]
              ],
              "frame": "dashed"
            },
            {
              "type": "heading",
              "text": "3. Foreign Key",
              "ink": "orange"
            },
            {
              "type": "bullets",
              "items": [
                "==Foreign key== references a candidate/primary key, in another or the same relation",
                "Value must match an existing key or be ==NULL== (referential integrity)"
              ],
              "style": "check"
            },
            {
              "type": "code",
              "lang": "sql",
              "lines": [
                "CREATE TABLE Employee (",
                "  id INT PRIMARY KEY,",
                "  email TEXT UNIQUE,",
                "  boss_id INT REFERENCES Employee(id)",
                ");"
              ],
              "note": "boss_id points back into the same relation"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Remember",
              "text": "super key ⊇ candidate key ⊇ primary key. A foreign key points to a key, never to an arbitrary column."
            }
          ]
        }
      ]
    },
    {
      "title": "Selection, Projection and Renaming",
      "role": "outline",
      "outlineIndex": 1,
      "pages": [
        {
          "title": "Selection, Projection and Renaming",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Selection and Projection",
              "ink": "green"
            },
            {
              "type": "table",
              "headers": [
                "",
                "σ_cond(R)",
                "π_A,B(R)"
              ],
              "rows": [
                [
                  "Keeps",
                  "rows matching the predicate",
                  "only listed columns"
                ],
                [
                  "Schema",
                  "{green:same as R}",
                  "only A, B"
                ],
                [
                  "Size",
                  "never larger than R",
                  "==duplicates removed==, may shrink"
                ]
              ],
              "frame": "dashed"
            },
            {
              "type": "bullets",
              "items": [
                "Relations are sets, so π always ==dedupes== rows"
              ],
              "style": "dot"
            },
            {
              "type": "heading",
              "text": "2. Composition Order",
              "ink": "blue"
            },
            {
              "type": "diagram",
              "kind": "chain",
              "spec": {
                "steps": [
                  {
                    "text": "R",
                    "note": "name, age",
                    "ink": "black"
                  },
                  {
                    "text": "σ age>20",
                    "note": "schema kept",
                    "ink": "green"
                  },
                  {
                    "text": "π name",
                    "note": "result",
                    "ink": "blue"
                  }
                ]
              }
            },
            {
              "type": "bullets",
              "items": [
                "`π_name(σ_age>20(R))` {green:works}",
                "`σ_age>20(π_name(R))` {red:fails}: age was projected away",
                "Selections ==commute==: `σ_c1(σ_c2(R)) = σ_c2(σ_c1(R)) = σ_c1∧c2(R)`"
              ],
              "style": "dot"
            },
            {
              "type": "heading",
              "text": "3. Rename ρ",
              "ink": "purple"
            },
            {
              "type": "bullets",
              "items": [
                "`ρ_S(A→B)(R)` renames the relation to S and attribute A to B",
                "Required in ==self-joins==",
                "Required when a product has ==clashing attribute names=="
              ],
              "style": "check"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Order",
              "text": "Select first, project last: π must keep every column a later σ reads."
            }
          ]
        }
      ]
    },
    {
      "title": "Set Operations and Cartesian Product",
      "role": "outline",
      "outlineIndex": 2,
      "pages": [
        {
          "title": "Set Operations and Cartesian Product",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Set Operations",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "`R ∪ S`, `R ∩ S`, `R − S` need ==union-compatible== relations",
                "Same {blue:degree} and matching {blue:domains} per column",
                "Result takes **attribute names from R**",
                "`R − S ≠ S − R`: difference is ==not commutative==",
                "`R ∩ S = R − (R − S)`: intersection is derived"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "heading",
              "text": "2. Cartesian Product",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "`R × S`",
                "Value"
              ],
              "rows": [
                [
                  "Pairs",
                  "every tuple of R with every tuple of S"
                ],
                [
                  "Degree",
                  "deg(R) + deg(S)"
                ],
                [
                  "Cardinality",
                  "==|R| · |S|=="
                ]
              ],
              "frame": "dashed"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "R × S",
                    "sub": "all pairs",
                    "ink": "blue"
                  },
                  {
                    "text": "σ keys match",
                    "sub": "drop junk pairs",
                    "ink": "orange"
                  },
                  {
                    "text": "Join",
                    "sub": "meaningful",
                    "ink": "green"
                  }
                ]
              }
            },
            {
              "type": "bullets",
              "items": [
                "Product alone gives ==meaningless pairs==; follow it with a selection"
              ],
              "style": "cross"
            },
            {
              "type": "heading",
              "text": "3. 'Not In' Queries",
              "ink": "purple"
            },
            {
              "type": "code",
              "lang": "text",
              "lines": [
                "π_id(Customer) − π_cust_id(Order)"
              ],
              "note": "customers who never ordered"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Remember",
              "text": "'Never / not in' means ==difference==; order of operands matters."
            }
          ]
        }
      ]
    },
    {
      "title": "Joins and Division",
      "role": "outline",
      "outlineIndex": 3,
      "pages": [
        {
          "title": "Joins and Division",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Theta, Equi, Natural",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "==Theta join== R ⋈_θ S = σ_θ(R × S)",
                "==Equi-join==: theta join with only `=` conditions",
                "==Natural join== ⋈: equates same-named attributes, keeps one copy each"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "heading",
              "text": "2. Inner vs Outer",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "Join",
                "Symbol",
                "Keeps"
              ],
              "rows": [
                [
                  "Inner",
                  "⋈",
                  "matches only"
                ],
                [
                  "Left",
                  "⟕",
                  "all of R, NULL-padded"
                ],
                [
                  "Right",
                  "⟖",
                  "all of S, NULL-padded"
                ],
                [
                  "Full",
                  "⟗",
                  "all of both, NULL-padded"
                ]
              ],
              "frame": "dashed"
            },
            {
              "type": "bullets",
              "items": [
                "No common attributes: natural join becomes a ==Cartesian product==",
                "Accidentally shared column names: silently joins on the wrong columns"
              ],
              "style": "cross",
              "ink": "red"
            },
            {
              "type": "heading",
              "text": "3. Division",
              "ink": "purple"
            },
            {
              "type": "bullets",
              "items": [
                "R ÷ S: values of attrs(R) − attrs(S) paired with ==every== tuple of S",
                "The 'for all' query: students who took all required courses"
              ],
              "style": "dot"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "π_A(R) × S",
                    "sub": "all wanted pairs",
                    "ink": "blue"
                  },
                  {
                    "text": "− R",
                    "sub": "missing pairs",
                    "ink": "red"
                  },
                  {
                    "text": "π_A(...)",
                    "sub": "students lacking one",
                    "ink": "orange"
                  },
                  {
                    "text": "π_A(R) − that",
                    "sub": "answer",
                    "ink": "green"
                  }
                ]
              }
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Division formula",
              "text": "R ÷ S = π_A(R) − π_A((π_A(R) × S) − R); schema = attrs(R) − attrs(S)"
            }
          ]
        }
      ]
    },
    {
      "title": "How SQL Maps to Algebra",
      "role": "outline",
      "outlineIndex": 4,
      "pages": [
        {
          "title": "How SQL Maps to Algebra",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Clause to Operator",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "SQL",
                "Algebra"
              ],
              "rows": [
                [
                  "`SELECT` list",
                  "projection ==π=="
                ],
                [
                  "`WHERE`",
                  "selection ==σ=="
                ],
                [
                  "`FROM R, S`",
                  "product ==×=="
                ],
                [
                  "`JOIN ... ON`",
                  "theta join ==⋈_θ=="
                ],
                [
                  "`UNION` / `INTERSECT` / `EXCEPT`",
                  "∪ / ∩ / −"
                ]
              ],
              "frame": "dashed"
            },
            {
              "type": "heading",
              "text": "2. Order and Bags",
              "ink": "purple"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "FROM",
                    "sub": "R × S",
                    "ink": "blue"
                  },
                  {
                    "text": "WHERE",
                    "sub": "σ",
                    "ink": "green"
                  },
                  {
                    "text": "SELECT",
                    "sub": "π",
                    "ink": "purple"
                  }
                ]
              }
            },
            {
              "type": "bullets",
              "items": [
                "Algebra mirrors it: ==π(σ(R × S))==",
                "SQL tables are {blue:bags}; algebra relations are {green:sets}",
                "`SELECT` keeps duplicates; add `DISTINCT` to match π",
                "`UNION`, `INTERSECT`, `EXCEPT` drop duplicates; `ALL` keeps them"
              ],
              "style": "dot",
              "ink": "purple"
            },
            {
              "type": "heading",
              "text": "3. Division in SQL",
              "ink": "orange"
            },
            {
              "type": "bullets",
              "items": [
                "No division operator in SQL",
                "Option 1: `NOT EXISTS` twice (no student lacks a required course)",
                "Option 2: count matches with `HAVING`"
              ],
              "style": "number",
              "ink": "orange"
            },
            {
              "type": "code",
              "lang": "sql",
              "lines": [
                "SELECT student FROM Takes",
                "WHERE course IN (SELECT course FROM Required)",
                "GROUP BY student",
                "HAVING COUNT(DISTINCT course) =",
                "  (SELECT COUNT(*) FROM Required);"
              ],
              "note": "Takes ÷ Required"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Remember",
              "text": "Plain `SELECT` is ==not== π: it keeps duplicates unless `DISTINCT`."
            }
          ]
        }
      ]
    },
