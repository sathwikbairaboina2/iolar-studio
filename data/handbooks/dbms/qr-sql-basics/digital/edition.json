                  },
                  {
                    "text": "GROUP BY",
                    "ink": "purple"
                  },
                  {
                    "text": "HAVING",
                    "ink": "pink"
                  },
                  {
                    "text": "ORDER BY",
                    "ink": "red"
                  },
                  {
                    "text": "LIMIT",
                    "ink": "black"
                  }
                ]
              }
            },
            {
              "type": "heading",
              "text": "3. Joins",
              "ink": "purple"
            },
            {
              "type": "table",
              "headers": [
                "Join",
                "Returns"
              ],
              "rows": [
                [
                  "`INNER`",
                  "matches only"
                ],
                [
                  "`LEFT`",
                  "all left + NULLs"
                ],
                [
                  "`FULL`",
                  "all both sides"
                ],
                [
                  "Anti-join",
                  "`LEFT JOIN` + `WHERE r.id IS NULL`"
                ]
              ],
              "frame": "dashed"
            },
            {
              "type": "heading",
              "text": "4. NULL rules",
              "ink": "orange"
            },
            {
              "type": "bullets",
              "items": [
                "`IS NULL`, never `= NULL`",
                "`COUNT(*)` counts rows; `COUNT(col)` skips NULLs",
                "`COALESCE(x, 0)` gives a default"
              ],
              "style": "check"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Always WHERE",
              "text": "`UPDATE` or `DELETE` without ==WHERE== hits **every row**."
            }
