    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "Asha has 2 orders and Bo has none. What does this return?",
              "a_bullets": [
                "Asha 2, Bo 0",
                "`COUNT(o.id)` skips the NULL row; `COUNT(*)` would give Bo 1"
              ],
              "example_code": [
                "SELECT c.name, COUNT(o.id)",
                "FROM customers c",
                "LEFT JOIN orders o ON o.customer_id = c.id",
                "GROUP BY c.name"
              ]
            },
            {
              "type": "qa",
              "q": "We want every customer with their shipped-order count, but Bo vanishes. Fix?",
              "a_bullets": [
                "`WHERE o.status = 'shipped'` rejects Bo's NULL row, so the join acts inner",
                "Use `ON o.customer_id = c.id AND o.status = 'shipped'` and no WHERE on `o.status`"
              ],
              "example_code": [
                "... LEFT JOIN orders o ON o.customer_id = c.id",
                "WHERE o.status = 'shipped'"
              ]
            },
            {
              "type": "qa",
              "q": "Why does this return no rows, though Bo has no orders and one `customer_id` is NULL?",
              "a_bullets": [
                "`NOT IN` expands to `id <> 1 AND id <> 2 AND id <> NULL`",
                "`id <> NULL` is unknown, so the AND is never true",
                "Use `NOT EXISTS` or filter NULLs out"
              ],
              "example_code": [
                "SELECT name FROM customers",
                "WHERE id NOT IN (SELECT customer_id FROM orders)"
              ]
            }
          ]
        }
      ]
    }
  ]
