      "pages": [
        {
          "title": "SQL Mental Model and Tables",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Model and Statement Families",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "A ==table== = rows (records) by **typed columns**",
                "SQL is ==declarative==: you state the result, the engine picks the plan"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "table",
              "headers": [
                "Family",
                "Job",
                "Statements"
              ],
              "rows": [
                [
                  "{blue:DDL}",
                  "defines structure",
                  "CREATE, ALTER, DROP"
                ],
                [
                  "{orange:DML}",
                  "changes and reads data",
                  "INSERT, UPDATE, DELETE, SELECT"
                ]
              ]
            },
            {
              "type": "heading",
              "text": "2. CREATE TABLE and Types",
              "ink": "blue"
            },
            {
              "type": "code",
              "lang": "sql",
              "lines": [
                "CREATE TABLE users (",
                "  id INT PRIMARY KEY,",
                "  email VARCHAR(100) NOT NULL UNIQUE,",
                "  created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP",
                ");"
              ]
            },
            {
              "type": "table",
              "headers": [
                "Need",
                "Type"
              ],
              "rows": [
                [
                  "Whole numbers",
                  "`INT` / `BIGINT`"
                ],
                [
                  "Exact money",
                  "`DECIMAL(p,s)`"
                ],
                [
                  "Approximate",
                  "`FLOAT`"
                ],
                [
                  "Text",
                  "`VARCHAR(n)` / `TEXT`"
                ],
                [
                  "Flag",
                  "`BOOLEAN`"
                ],
                [
                  "Date, date + time",
                  "`DATE` / `TIMESTAMP`"
                ]
              ],
              "highlightRow": 1
            },
            {
              "type": "heading",
              "text": "3. Constraints",
              "ink": "purple"
            },
            {
              "type": "bullets",
              "items": [
                "`NOT NULL`: value required",
                "`UNIQUE`: no duplicate values",
                "`DEFAULT`: value used when none given",
                "`CHECK (price > 0)`: row must pass the test",
                "`PRIMARY KEY`: row identifier",
                "`FOREIGN KEY`: must match a key in another table"
              ],
              "style": "check",
              "frame": "dashed",
              "ink": "purple"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Money",
              "text": "Store money in ==DECIMAL(p,s)==, never **FLOAT**: float is approximate."
            }
          ]
        }
      ]
    },
    {
      "title": "Primary and Foreign Keys",
      "role": "outline",
      "outlineIndex": 1,
      "pages": [
        {
          "title": "Primary and Foreign Keys",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Keys and the FK link",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "==Primary key== = unique + NOT NULL row identifier",
                "Only **one** PK per table",
                "May be ==composite==: `PRIMARY KEY (order_id, product_id)`",
                "==Foreign key== values must exist in the referenced table's key"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "code",
              "lang": "sql",
              "lines": [
                "CREATE TABLE orders (",
                "  id INT PRIMARY KEY,",
                "  customer_id INT REFERENCES customers(id)",
                "    ON DELETE CASCADE",
                ");"
              ],
              "note": "orders is the child, customers the parent"
            },
            {
              "type": "heading",
              "text": "2. Referential actions on delete",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "Action",
                "Effect on child rows"
              ],
              "rows": [
                [
                  "`CASCADE`",
                  "{red:Deletes} the child rows too"
                ],
                [
                  "`SET NULL`",
                  "Clears the reference to NULL"
                ],
                [
                  "`RESTRICT` / `NO ACTION`",
                  "{green:Blocks} the parent delete"
                ]
              ],
              "frame": "dashed"
            },
            {
              "type": "heading",
              "text": "3. Surrogate vs natural key",
              "ink": "purple"
            },
            {
              "type": "bullets",
              "items": [
                "{blue:Surrogate}: auto-increment `id`, no business meaning",
                "{orange:Natural}: real data like email or ISBN",
                "Natural keys ==change==, so every FK pointing at them breaks",
                "Prefer a surrogate PK plus a `UNIQUE` constraint on the natural key"
              ],
              "style": "check"
            },
            {
              "type": "heading",
              "text": "4. Order and indexing",
              "ink": "red"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "Insert",
                    "sub": "parent first",
                    "ink": "green"
                  },
                  {
                    "text": "Child rows",
                    "sub": "reference parent",
                    "ink": "blue"
                  },
                  {
                    "text": "Delete",
                    "sub": "children first",
                    "ink": "red"
                  },
                  {
                    "text": "Parent row",
                    "sub": "delete last",
                    "ink": "orange"
                  }
                ]
              }
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Wrong order = rejected",
              "text": "The FK rejects the statement. Also, FK columns are ==not auto-indexed== in most engines: index them yourself."
            }
          ]
        }
      ]
    },
    {
      "title": "INSERT, UPDATE, DELETE and SELECT",
      "role": "outline",
      "outlineIndex": 2,
      "pages": [
        {
          "title": "INSERT, UPDATE, DELETE and SELECT",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Changing rows",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "`INSERT` takes many rows; ==list the columns== so schema changes don't break it",
                "{red:No WHERE} on `UPDATE` or `DELETE` = ==every row== changes"
              ],
              "style": "dot"
            },
            {
              "type": "code",
              "lang": "sql",
              "lines": [
                "INSERT INTO users (email, name)",
                "VALUES ('a@x.com','Asha'), ('b@x.com','Bo');",
                "UPDATE orders SET status = 'shipped' WHERE id = 7;",
                "DELETE FROM orders WHERE id = 7;"
              ]
            },
            {
              "type": "heading",
              "text": "2. SELECT and run order",
              "ink": "purple"
            },
            {
              "type": "bullets",
              "items": [
                "`SELECT col1, col2 FROM t WHERE cond ORDER BY col DESC LIMIT 10`",
                "Avoid `SELECT *` in production code",
                "A SELECT alias works in ==ORDER BY==, **not** in WHERE"
              ],
              "style": "dot"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "FROM",
                    "ink": "blue"
                  },
                  {
                    "text": "WHERE",
                    "ink": "blue"
                  },
                  {
                    "text": "GROUP BY",
                    "ink": "green"
                  },
                  {
                    "text": "HAVING",
                    "ink": "green"
                  },
                  {
                    "text": "SELECT",
                    "ink": "purple"
                  },
                  {
                    "text": "ORDER BY",
                    "ink": "orange"
                  },
                  {
                    "text": "LIMIT",
                    "ink": "orange"
                  }
                ]
              }
            },
            {
              "type": "heading",
              "text": "3. WHERE operators",
              "ink": "orange"
            },
            {
              "type": "table",
              "headers": [
                "Operator",
                "Meaning"
              ],
              "rows": [
                [
                  "`= <> < >`",
                  "compare"
                ],
                [
                  "`AND` `OR` `NOT`",
                  "combine conditions"
                ],
                [
                  "`IN (1,2)`",
                  "any listed value"
                ],
                [
                  "`BETWEEN a AND b`",
                  "==inclusive== range"
                ],
                [
                  "`LIKE 'A%'`",
                  "`%` any run, `_` one char"
                ]
              ]
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "AND binds tighter than OR",
              "text": "`a OR b AND c` means `a OR (b AND c)`. Use ==parentheses==."
            }
          ]
        }
      ]
    },
    {
      "title": "Joins",
      "role": "outline",
      "outlineIndex": 3,
      "pages": [
        {
          "title": "Joins",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Join Types",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "Join",
                "Unmatched rows"
              ],
              "rows": [
                [
                  "`INNER`",
                  "dropped"
                ],
                [
                  "`LEFT`",
                  "left kept, right cols = NULL"
                ],
                [
                  "`RIGHT`",
                  "mirror: right kept, left cols = NULL"
                ],
                [
                  "`FULL OUTER`",
                  "both sides kept"
                ]
              ]
            },
            {
              "type": "bullets",
              "items": [
                "{blue:INNER JOIN} keeps only rows with a ==match on both sides==",
                "`FROM orders o JOIN customers c ON c.id = o.customer_id`"
              ],
              "style": "dot"
            },
            {
              "type": "heading",
              "text": "2. Anti-Join",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "==LEFT JOIN + IS NULL== on the right key",
                "Finds left rows with **no match**"
              ],
              "style": "dot"
            },
            {
              "type": "code",
              "lang": "sql",
              "lines": [
                "SELECT c.id FROM customers c",
                "LEFT JOIN orders o ON o.customer_id = c.id",
                "WHERE o.id IS NULL;"
              ],
              "note": "customers with no orders"
            },
            {
              "type": "heading",
              "text": "3. ON vs WHERE",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "Right-table filter in `WHERE` turns a LEFT JOIN into an ==inner join==",
                "Put it in `ON`: it limits which orders count as a match",
                "Then `WHERE o.id IS NULL` finds customers with no **shipped** order"
              ],
              "style": "cross",
              "ink": "red"
            },
            {
              "type": "code",
              "lang": "sql",
              "lines": [
                "LEFT JOIN orders o ON o.customer_id = c.id",
                "  AND o.status = 'shipped'",
                "WHERE o.id IS NULL;"
              ],
              "note": "status test in WHERE would return nothing"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Row blow-up",
              "text": "Missing or wrong `ON` gives a CROSS JOIN: ==m x n== rows. One-to-many repeats the parent **once per child**."
            }
          ]
        }
      ]
    },
    {
      "title": "GROUP BY, HAVING and NULL Semantics",
      "role": "outline",
      "outlineIndex": 4,
      "pages": [
        {
          "title": "GROUP BY, HAVING and NULL Semantics",
          "blocks": [
            {
              "type": "heading",
              "text": "1. GROUP BY and aggregates",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "==GROUP BY== collapses rows into one row per group",
                "`COUNT`, `SUM`, `AVG`, `MIN`, `MAX` run **per group**",
                "Every non-aggregated SELECT column must be in GROUP BY",
                "Otherwise {red:error}, or an arbitrary value in lax MySQL modes"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "code",
              "lang": "sql",
              "lines": [
                "SELECT dept, COUNT(*), AVG(salary)",
                "FROM emp",
                "GROUP BY dept;"
              ],
              "note": "one output row per dept"
            },
            {
              "type": "heading",
              "text": "2. WHERE vs HAVING",
              "ink": "blue"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "FROM",
                    "ink": "black"
                  },
                  {
                    "text": "WHERE",
                    "sub": "filters rows",
                    "ink": "green"
                  },
                  {
                    "text": "GROUP BY",
                    "sub": "makes groups",
                    "ink": "blue"
                  },
                  {
                    "text": "HAVING",
                    "sub": "filters groups",
                    "ink": "purple"
                  },
                  {
                    "text": "SELECT",
                    "ink": "orange"
                  }
                ]
              }
            },
            {
              "type": "bullets",
              "items": [
                "WHERE runs before grouping, so it ==cannot use aggregates==",
                "HAVING runs after grouping: `HAVING COUNT(*) > 5`"
              ],
              "style": "check",
              "ink": "blue"
            },
            {
              "type": "heading",
              "text": "3. NULL semantics",
              "ink": "red"
            },
            {
              "type": "table",
              "headers": [
                "Expression",
                "Result"
              ],
              "rows": [
                [
                  "`NULL = NULL`",
                  "{red:not true}, use `IS NULL` / `IS NOT NULL`"
                ],
                [
                  "`5 + NULL`, `x > NULL`",
                  "NULL"
                ],
                [
                  "`COUNT(*)`",
                  "counts **all** rows"
                ],
                [
                  "`COUNT(col)`",
                  "skips NULLs"
                ],
                [
                  "`SUM` / `AVG`",
                  "ignore NULLs"
                ],
                [
                  "`COALESCE(x, 0)`",
                  "substitutes a default"
                ]
              ],
              "highlightRow": 2
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "NOT IN trap",
              "text": "`NOT IN (subquery)` returns ==no rows== if the subquery contains a NULL. NULL means unknown."
            }
          ]
        }
      ]
    },
    {
      "title": "SQL Cheat Sheet",
      "role": "outline",
