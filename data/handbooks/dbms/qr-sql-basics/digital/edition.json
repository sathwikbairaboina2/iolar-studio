      "pages": [
        {
          "title": "SQL Cheat Sheet",
          "blocks": [
            {
              "type": "heading",
              "text": "1. DDL and DML",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "==DDL== defines structure; ==DML== changes rows",
                "`ON DELETE CASCADE` removes child rows with the parent"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "code",
              "lang": "sql",
              "lines": [
                "CREATE TABLE t (id INT PRIMARY KEY, fk INT REFERENCES p(id) ON DELETE CASCADE);",
                "ALTER TABLE t ADD COLUMN c TEXT;",
                "DROP TABLE t;",
                "INSERT INTO t (a,b) VALUES (1,2);",
                "UPDATE t SET a=1 WHERE id=3;",
                "DELETE FROM t WHERE id=3;"
              ]
            },
            {
              "type": "heading",
              "text": "2. Query skeleton",
              "ink": "blue"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "SELECT",
