              "type": "heading",
              "text": "1. Cardinality Ratios",
              "ink": "green"
            },
            {
              "type": "table",
              "headers": [
                "Ratio",
                "Maps to",
                "Example"
              ],
              "rows": [
                [
                  "1:N",
                  "FK on the **N** side",
                  "`Order.customer_id`"
                ],
                [
                  "M:N",
                  "==Junction table==",
                  "PK `(student_id, course_id)`"
                ],
                [
                  "1:1",
                  "FK + `UNIQUE`",
                  "either side"
                ]
              ],
              "frame": "dashed"
