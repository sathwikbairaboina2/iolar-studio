          "blocks": [
            {
              "type": "heading",
              "text": "1. The key ladder",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "==Super key==: any set that uniquely identifies a row",
                "Supersets of a key also qualify: {id}, {id, name}",
                "==Candidate key==: minimal super key; a table may have several",
                "==Prime attribute==: part of some candidate key"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "Super keys",
                    "sub": "all unique sets",
                    "ink": "green"
                  },
                  {
                    "text": "Candidate keys",
                    "sub": "minimal",
                    "ink": "blue"
                  },
                  {
                    "text": "Primary key",
                    "sub": "one chosen",
                    "ink": "purple"
                  }
                ]
              }
            },
            {
              "type": "heading",
              "text": "2. Primary, alternate, foreign",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "",
                "Primary",
                "Alternate",
                "Foreign"
              ],
              "rows": [
                [
                  "Is",
                  "chosen candidate",
                  "other candidates",
                  "refers to another table's key"
                ],
                [
                  "Unique",
                  "yes",
                  "yes, UNIQUE",
                  "no, duplicates OK"
                ],
                [
                  "NULL",
                  "never",
                  "per column",
                  "allowed"
                ],
                [
                  "Per table",
                  "at most 1",
                  "many",
                  "many"
                ]
              ],
              "frame": "dashed"
            },
            {
              "type": "bullets",
              "items": [
                "ON DELETE ==CASCADE==: child rows deleted too",
                "==SET NULL==: child FK becomes NULL",
                "==RESTRICT==: parent delete is blocked"
              ],
              "style": "check"
            },
            {
              "type": "heading",
              "text": "3. Composite and surrogate",
              "ink": "purple"
            },
            {
              "type": "bullets",
              "items": [
                "==Composite key==: 2+ attributes, e.g. `(student_id, course_id)`",
                "==Surrogate key==: generated id, no business meaning"
              ],
              "style": "dot"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Remember",
              "text": "Every primary key is a candidate key, but not every super key is one."
            }
          ]
        }
