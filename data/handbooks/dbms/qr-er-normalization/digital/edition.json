    {
      "title": "Functional Dependencies and Closure",
      "role": "outline",
      "outlineIndex": 3,
      "pages": [
        {
          "title": "Functional Dependencies and Closure",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Meaning of an FD",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "==X → Y==: equal X ⇒ equal Y in any two rows",
                "A rule about the **schema**, not the current data"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "heading",
              "text": "2. Armstrong's axioms and derived rules",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "Rule",
                "Statement"
              ],
              "rows": [
                [
                  "Reflexivity",
                  "Y ⊆ X ⇒ X → Y"
                ],
                [
                  "Augmentation",
                  "X → Y ⇒ XZ → YZ"
                ],
                [
                  "Transitivity",
                  "X → Y, Y → Z ⇒ X → Z"
                ],
                [
                  "Union",
                  "X→Y, X→Z ⇒ X→YZ"
                ],
                [
                  "Decomposition",
                  "X→YZ ⇒ X→Y, X→Z"
                ]
              ]
            },
            {
              "type": "heading",
              "text": "3. Closure and keys",
              "ink": "purple"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "Start",
                    "sub": "X⁺ = X",
                    "ink": "blue"
                  },
                  {
                    "text": "Grow",
                    "sub": "add RHS of FDs whose LHS ⊆ set",
                    "ink": "purple"
                  },
                  {
                    "text": "Repeat",
                    "sub": "until nothing changes",
                    "ink": "orange"
                  },
                  {
                    "text": "Super key",
                    "sub": "X⁺ = all attributes",
                    "ink": "green"
                  }
                ]
              }
            },
            {
              "type": "bullets",
              "items": [
                "Attributes never on any RHS are in ==every key==",
                "Test them by closure, then add attributes only as needed"
              ],
              "style": "check"
            },
            {
              "type": "heading",
              "text": "4. Partial vs transitive",
              "ink": "red"
            },
            {
              "type": "table",
              "headers": [
                "Kind",
                "Shape"
              ],
              "rows": [
                [
                  "Partial",
                  "non-prime depends on part of a composite key"
                ],
                [
                  "Transitive",
                  "non-prime → non-prime via X → Y → Z"
                ]
              ]
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Remember",
              "text": "FDs come from the **meaning** of the schema, not from sample rows."
            }
          ]
        }
      ]
    },
