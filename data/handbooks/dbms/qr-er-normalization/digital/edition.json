              "style": "cross",
              "frame": "dashed",
              "ink": "red"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Remember",
              "text": "The FK goes on the ==many== side; many-to-many always gets its own table."
            }
          ]
        }
      ]
