            {
              "type": "code",
              "lang": "sql",
              "lines": [
                "CREATE TABLE enrolls (",
                "  student_id INT REFERENCES student,",
                "  course_id INT REFERENCES course,",
                "  PRIMARY KEY (student_id, course_id)",
                ");"
              ]
            },
            {
              "type": "heading",
              "text": "2. Participation",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "{green:Total} (double line): every instance takes part, FK ==NOT NULL==",
                "{blue:Partial}: taking part is optional, FK ==nullable==",
                "In 1:1, put the FK on the side with ==total participation=="
              ],
              "style": "check",
              "frame": "dashed",
              "ink": "blue"
            },
            {
              "type": "heading",
              "text": "3. Common Mistakes",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "M:N stored as a ==comma-separated list== column",
                "FK placed on the **1** side of a 1:N"
