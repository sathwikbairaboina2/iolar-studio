    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "R(A,B,C) has A→B and B→C. Find A⁺. Is R in 3NF?",
              "a_bullets": [
                "A⁺ = {A,B,C}, so A is the key",
                "B→C: B is not a super key and C is non-prime",
                "Transitive dependency, so not 3NF"
              ]
            },
            {
              "type": "qa",
              "q": "Enroll(student_id, course_id, course_name) has key (student_id, course_id) and course_id→course_name. Highest normal form?",
              "a_bullets": [
                "1NF only",
                "course_name depends on part of the key (partial dependency)",
                "Fix: move (course_id, course_name) to a Course table"
              ]
            },
            {
              "type": "qa",
              "q": "R(A,B,C) has AB→C and C→B. In 3NF? In BCNF?",
              "a_bullets": [
                "Keys are AB and AC, so A, B, C are all prime",
                "3NF: yes, B in C→B is prime",
                "BCNF: no, C is not a super key"
              ]
            },
            {
              "type": "qa",
              "q": "Student–Course is M:N. Why is a course_id column in Student wrong?",
              "a_bullets": [
                "A student row can hold only one course",
                "Use a junction table with PK (student_id, course_id)"
              ]
            }
          ]
        }
      ]
