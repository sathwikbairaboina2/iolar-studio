          "title": "Normalization Cheat Sheet",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Keys and Cardinality",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "==Super key== ⊇ ==candidate key== ⊇ ==primary key==",
                "**FK** points at a key; may be ==NULL== and duplicated"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "Cardinality",
                "Tables"
              ],
              "rows": [
                [
                  "1:N",
                  "FK on the **N side**"
                ],
                [
                  "M:N",
                  "==Junction table==, PK (fk1, fk2)"
                ],
                [
                  "1:1",
                  "FK plus ==UNIQUE=="
                ]
              ]
            },
            {
              "type": "bullets",
              "items": [
                "M:N stored as a comma-separated list column",
                "FK placed on the 1 side of a 1:N"
              ],
              "style": "cross",
              "ink": "red"
            },
            {
              "type": "heading",
              "text": "2. Closure and Normal Form Tests",
              "ink": "purple"
            },
            {
              "type": "bullets",
              "items": [
                "X is a ==super key== iff X⁺ contains **every** attribute",
                "X⁺: add the RHS of any FD whose LHS is inside the set"
              ],
              "style": "dot",
              "ink": "purple"
            },
            {
              "type": "table",
              "headers": [
                "Form",
                "Test"
              ],
              "rows": [
                [
                  "1NF",
                  "Values are ==atomic=="
                ],
                [
                  "2NF",
                  "No ==partial== dependency"
                ],
                [
                  "3NF",
                  "No ==transitive== dependency"
                ],
                [
                  "BCNF",
                  "Every determinant is a ==super key=="
                ]
              ],
              "highlightRow": 3
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Memory line",
              "text": "Every non-key attribute depends on ==the key== (1NF), ==the whole key== (2NF), and ==nothing but the key== (3NF/BCNF)."
