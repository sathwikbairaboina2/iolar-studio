          "type": "heading",
          "text": "6. Blind Detection"
        },
        {
          "type": "bullets",
          "items": [
            "No output echoed? Use time or out-of-band",
            "`; sleep 5` delaying the response proves it",
            "nslookup to your own domain confirms execution"
          ]
        }
      ],
      "cont": true
