        {
          "type": "heading",
          "text": "3. CSP Is The Real Control"
        },
        {
          "type": "code",
          "lang": "http",
          "lines": [
            "Content-Security-Policy:",
            "  default-src 'self';",
            "  script-src 'self' 'nonce-r4Nd0m';",
            "  object-src 'none'; base-uri 'none'"
          ]
        },
        {
          "type": "table",
          "headers": [
            "Directive",
            "Stops"
          ],
          "rows": [
            [
              "`default-src 'self'`",
              "foreign loads"
            ],
            [
              "`script-src` nonce",
              "injected ==inline JS=="
            ],
            [
              "`object-src 'none'`",
              "plugin payloads"
            ],
            [
              "`base-uri 'none'`",
              "<base> hijack"
            ]
          ]
        },
        {
          "type": "sidebox",
          "title": "Recommended SPA + API Layout",
          "items": [
            "Refresh token in a __Host-, HttpOnly, SameSite=Lax cookie",
            "Access token in memory only",
            "Silent refresh call on boot"
          ]
        },
        {
          "type": "heading",
          "text": "4. Silent Refresh On Boot",
          "ink": "green"
        },
        {
          "type": "diagram",
          "kind": "flow",
          "spec": {
            "nodes": [
              "page load, no token",
              "POST /refresh + cookie",
              "new access JWT",
              "held in a JS variable"
            ]
          }
        },
        {
          "type": "code",
          "lang": "js",
          "lines": [
            "let token = null  // memory only",
            "async function boot() {",
            "  const r = await fetch('/refresh',",
            "    { method: 'POST',",
            "      credentials: 'include' })",
            "  token = (await r.json()).access }"
          ],
          "note": "nonce changes every response"
        },
        {
          "type": "bullets",
          "items": [
            "Refresh cookie is ==SameSite=Lax==: no cross-site mint",
            "API returns 401: refresh **once**, then retry",
            "Refresh fails: send the user to login",
            "Nonce must be fresh per page render"
          ],
          "style": "number"
        },
        {
          "type": "heading",
          "text": "5. What Leaks Tokens",
          "ink": "red"
        },
        {
          "type": "bullets",
          "items": [
            "Third-party <script src> with full page access",
            "Unpinned npm deps shipped in the bundle",
            "Access token in localStorage 'for convenience'",
            "Long-lived access token with no refresh step"
          ],
          "style": "cross"
        },
        {
          "type": "callout",
          "style": "takeaway",
          "title": "Shrink The Blast Radius",
          "text": "CSP stops the script, HttpOnly stops the theft, a short-lived access token caps the damage window."
        }
      ]
    },
    {
      "page_title": "CSRF: Exploit And Defenses (cont.)",
      "blocks": [
