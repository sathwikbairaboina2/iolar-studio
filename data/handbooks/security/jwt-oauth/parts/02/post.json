        {
          "type": "heading",
          "text": "7. OAuth 2.1 in One Box",
          "ink": "blue"
        },
        {
          "type": "bullets",
          "items": [
            "==PKCE required== on every authorization code flow",
            "Implicit and ROPC __removed__ from the spec",
            "Redirect URIs matched __exactly__ — no wildcards",
            "Refresh tokens sender-constrained or rotated"
          ],
          "style": "checkbox",
          "ink": "green"
        },
        {
          "type": "callout",
          "style": "cloud",
          "title": "The key idea",
          "text": "Grants differ only in __how the client proves who is asking__. No user means client credentials; no keyboard means device code; a password in your app means you built the thing OAuth was invented to delete."
        }
      ],
      "hero": "key",
