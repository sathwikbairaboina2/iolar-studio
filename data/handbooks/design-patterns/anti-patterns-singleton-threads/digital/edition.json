    {
      "title": "Thread-Safe Singleton Implementations",
      "role": "outline",
      "outlineIndex": 3,
      "pages": [
        {
          "title": "Thread-Safe Singleton Implementations",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Simple Variants",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "==Eager==: `private static final Foo INSTANCE = new Foo();`",
                "Class-loading safe; built even if unused; no lazy exceptions",
                "==Synchronized== `getInstance()`: lazy, but every call takes the lock"
              ],
              "style": "dot"
            },
            {
              "type": "heading",
              "text": "2. Double-Checked Locking",
              "ink": "blue"
            },
            {
              "type": "code",
              "lang": "java",
              "lines": [
                "private static volatile Foo instance;",
                "if (instance == null) {",
                "  synchronized (Foo.class) {",
                "    if (instance == null) instance = new Foo();",
                "  }",
                "}"
              ]
            },
            {
              "type": "bullets",
              "items": [
                "Field **must** be `volatile`: reordering can publish a partly built object",
                "Needs the Java 5+ memory model"
              ],
              "style": "cross"
            },
            {
              "type": "heading",
              "text": "3. Holder and Enum",
              "ink": "purple"
            },
            {
              "type": "code",
              "lang": "java",
              "lines": [
                "private static class Holder { static final Foo INSTANCE = new Foo(); }",
                "static Foo getInstance() { return Holder.INSTANCE; }",
                "enum Foo { INSTANCE; }"
              ]
            },
            {
              "type": "bullets",
              "items": [
                "==Holder==: lazy, lock-free; JVM class initialization is thread-safe",
                "==Enum==: most robust (Effective Java); safe against reflection and serialization",
                "Cannot extend a class; constant created when enum class first initialized"
              ],
              "style": "dot"
            },
            {
              "type": "table",
              "headers": [
                "Variant",
                "Lazy",
                "Lock"
              ],
              "rows": [
                [
                  "Eager",
                  "no",
                  "none"
                ],
                [
                  "Synchronized",
                  "yes",
                  "every call"
                ],
                [
                  "DCL + volatile",
                  "yes",
                  "only while null; then one volatile read"
                ],
                [
                  "Holder",
                  "first call",
                  "none"
                ],
                [
                  "Enum",
                  "on class use",
                  "none"
                ]
              ],
              "highlightRow": 3
            }
          ]
        }
      ]
