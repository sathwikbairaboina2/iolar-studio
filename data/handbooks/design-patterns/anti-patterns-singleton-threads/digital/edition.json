    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "Double-checked locking uses `private static Foo instance;` with no volatile. What can go wrong?",
              "a_bullets": [
                "Another thread can see a non-null `instance` that is only partly constructed, because of reordering.",
                "Fix: declare it `private static volatile Foo instance;`."
              ]
            },
            {
              "type": "qa",
              "q": "Test B expects Config's default path but fails only when it runs after test A, which changed the path. Why, and what is the fix?",
              "a_bullets": [
                "The singleton keeps its state for the whole JVM, so A's change leaks into B.",
                "Inject a Config interface through the constructor and pass a fresh fake in each test."
              ]
            },
            {
              "type": "qa",
              "q": "Eager, synchronized getInstance(), holder: which one is both lazy and lock-free?",
              "a_bullets": [
                "The holder idiom. The Holder class loads on the first getInstance() call, and JVM class initialization is thread-safe.",
                "Eager is not lazy, and synchronized takes the lock on every call."
              ]
            }
          ]
        }
      ]
