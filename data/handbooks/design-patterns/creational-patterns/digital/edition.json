          "title": "Prototype and Choosing Between Patterns",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Prototype",
              "ink": "orange"
            },
            {
              "type": "bullets",
              "items": [
                "==Prototype==: new object by `clone()` of an existing instance",
                "Skips costly init: DB loads, heavy config",
                "{red:Shallow copy} shares nested refs; mutating the clone hits the original",
                "Deep-copy mutable fields; beware circular refs"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "orange"
            },
            {
              "type": "code",
              "lang": "python",
              "lines": [
                "import copy",
                "a = {\"t\": [1]}",
                "s, d = a.copy(), copy.deepcopy(a)",
                "a[\"t\"].append(2)",
                "print(s[\"t\"], d[\"t\"])"
              ],
              "note": "shallow copy s sees the change, deep copy d does not"
            },
            {
              "type": "code",
              "lang": "output",
              "lines": [
                "[1, 2] [1]"
              ]
            },
            {
              "type": "heading",
              "text": "2. Telling Them Apart",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "",
                "Factory Method",
                "Abstract Factory"
              ],
              "rows": [
                [
                  "Makes",
                  "one product",
                  "a family"
                ],
                [
                  "Via",
                  "inheritance",
                  "composition (factory object)"
                ]
              ]
            },
            {
              "type": "bullets",
              "items": [
                "{blue:Factory}: finished object in one call",
                "{green:Builder}: assembled in steps, parts vary",
                "Abstract Factory can use ==Builders== or ==Prototypes== inside"
              ],
              "style": "dot"
            },
            {
              "type": "heading",
              "text": "3. Pick Quickly",
              "ink": "green"
            },
            {
              "type": "table",
              "headers": [
                "Need",
                "Pattern"
              ],
              "rows": [
                [
                  "Exactly one",
                  "Singleton"
                ],
                [
                  "Many optional params",
                  "Builder"
                ],
                [
                  "Class unknown until runtime",
                  "Factory Method"
                ],
                [
                  "Matched families",
                  "Abstract Factory"
                ],
                [
                  "Costly to create, cheap to copy",
