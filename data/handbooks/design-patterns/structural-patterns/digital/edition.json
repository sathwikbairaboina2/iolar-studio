        {
          "title": "Structural Patterns Mental Model",
          "blocks": [
            {
              "type": "heading",
              "text": "1. One Skeleton",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "Compose classes and objects into bigger structures; ==behaviour contracts stay unchanged==",
                "Favour ==composition== over inheritance",
                "Wrapper holds a reference to the wrapped object and **forwards calls**",
                "Patterns differ in ==intent==, not in shape"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "blue"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "Client",
                    "ink": "black"
                  },
                  {
                    "text": "Wrapper",
                    "sub": "holds a reference",
                    "ink": "blue"
                  },
                  {
                    "text": "Wrapped",
                    "sub": "does the work",
                    "ink": "green"
                  }
                ]
              }
            },
            {
              "type": "heading",
              "text": "2. Interface Decides the Pattern",
              "ink": "purple"
            },
            {
              "type": "table",
              "headers": [
                "Wrapper's interface",
                "Patterns"
              ],
              "rows": [
                [
                  "{red:Changes}",
                  "Adapter, Facade"
                ],
                [
                  "{green:Identical}",
                  "Decorator, Proxy, Composite"
                ],
                [
                  "{purple:Split} abstraction from implementation",
                  "Bridge"
                ]
              ]
            },
            {
              "type": "heading",
              "text": "3. One-Line Intents",
              "ink": "orange"
            },
            {
              "type": "table",
              "headers": [
                "Pattern",
                "Intent"
              ],
              "rows": [
                [
                  "Adapter",
                  "==converts== one interface to another"
                ],
                [
                  "Decorator",
                  "==adds== behaviour"
                ],
                [
                  "Facade",
                  "==simplifies== a subsystem"
                ],
                [
                  "Proxy",
                  "==controls access=="
                ],
                [
                  "Composite",
                  "treats tree and leaf **alike**"
                ],
                [
                  "Bridge",
                  "==decouples== abstraction from implementation"
                ]
              ],
              "frame": "dashed"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Quick test for look-alikes",
              "text": "Ask what the wrapper is for: ==convert, add, simplify, guard, aggregate==. Not how it is built."
            }
          ]
        }
