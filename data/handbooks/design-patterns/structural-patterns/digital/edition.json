    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "You call `Gzip(Encrypt(FileStream())).write(data)`. In what order is the data transformed?",
              "a_bullets": [
                "**Compressed first, then encrypted**: the outer decorator runs first, then delegates inward.",
                "Swapping the order would compress ciphertext, which barely shrinks."
              ]
            },
            {
              "type": "qa",
              "q": "`ReportProxy` implements `Report` and wraps `RealReport`. Its `load()` catches every exception and returns an empty report. What is wrong?",
              "a_bullets": [
                "It swallows errors, so callers can no longer tell failure from an empty result.",
                "A proxy must keep the real object's contract, not hide its failures."
              ]
            },
            {
              "type": "qa",
              "q": "3 shapes (Circle, Square, Triangle) and 3 renderers (Vector, Raster, Svg). How many concrete classes with Bridge, and with plain subclassing?",
              "a_bullets": [
                "Bridge: 3 + 3 = **6** concrete classes.",
                "Subclassing: 3 × 3 = **9**, and every new shape adds a whole row."
              ]
            }
          ]
        }
      ]
