          "blocks": [
            {
              "type": "heading",
              "text": "1. What They Are",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "Govern how objects ==communicate== and share responsibility",
                "Move ==variation== (algorithm, reaction, request) out of the caller, behind an interface"
              ],
              "style": "dot"
            },
            {
              "type": "table",
              "headers": [
                "Pattern",
                "Intent"
              ],
              "rows": [
                [
                  "Strategy",
                  "Swap an algorithm"
                ],
                [
                  "Observer",
                  "Notify dependents of a change"
                ],
                [
                  "Command",
                  "Turn a request into an object"
                ],
                [
                  "Iterator",
                  "Traverse without exposing structure"
                ],
                [
                  "State",
                  "Behavior changes with internal state"
                ],
                [
                  "Template Method",
                  "Fixed skeleton, subclass fills steps"
                ],
                [
                  "Chain of Responsibility",
                  "Pass request along handlers until one handles it"
                ]
              ]
            },
            {
              "type": "heading",
              "text": "2. Inheritance or Composition",
