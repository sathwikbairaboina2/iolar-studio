          "blocks": [
            {
              "type": "heading",
              "text": "1. The Seven at a Glance",
              "ink": "green"
            },
            {
              "type": "table",
              "headers": [
                "Pattern",
                "Core idea",
                "Example"
              ],
              "rows": [
                [
                  "**Strategy**",
                  "swap algorithm at runtime; client-chosen; composition",
                  "sort comparator"
                ],
                [
                  "**State**",
                  "behavior follows internal state; objects drive transitions",
                  "order lifecycle"
                ],
                [
                  "**Template Method**",
                  "base-class skeleton; subclasses fill steps; inheritance",
                  "framework lifecycle hooks"
                ],
                [
                  "**Observer**",
                  "one-to-many notify",
                  "event listeners"
                ],
                [
                  "**Command**",
                  "request as object; `execute`/`undo`; queue, replay",
                  "editor undo stack"
                ],
                [
                  "**Iterator**",
                  "traverse without exposing structure; one cursor per traversal",
                  "for-each loop"
                ],
                [
                  "**Chain**",
                  "handlers pass along until one handles",
                  "middleware"
                ]
              ]
            },
            {
              "type": "heading",
              "text": "2. Telling Look-alikes Apart",
