            },
            {
              "type": "table",
              "headers": [
                "Pair",
                "Difference"
              ],
              "rows": [
                [
                  "Strategy / State",
                  "client switches vs state switches itself"
                ],
                [
                  "Strategy / Template",
                  "composition vs inheritance"
                ],
                [
                  "Command / Strategy",
                  "Command has a receiver and undo"
                ],
                [
                  "Observer / Chain",
                  "all notified vs first handler wins"
                ]
              ]
