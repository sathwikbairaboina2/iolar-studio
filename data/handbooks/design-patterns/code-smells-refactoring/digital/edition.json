              "style": "check"
            },
            {
              "type": "heading",
              "text": "3. Switch Order and Mistakes",
              "ink": "purple"
            },
            {
              "type": "diagram",
              "kind": "chain",
              "spec": {
                "title": "One branch at a time",
                "steps": [
                  {
                    "text": "Extract Method",
                    "note": "per branch",
                    "ink": "blue"
                  },
                  {
                    "text": "Move Method",
                    "note": "into a class",
                    "ink": "purple"
                  },
                  {
                    "text": "Interface",
                    "note": "introduce it",
                    "ink": "green"
                  },
                  {
                    "text": "Repeat",
                    "note": "old switch and new classes coexist",
                    "ink": "orange"
                  }
                ]
              }
            },
            {
              "type": "bullets",
              "items": [
                "Big-bang rewrite",
                "Changing behavior and structure together",
                "Skipping tests",
                "Abstracting after one case: wait for the 2nd or 3rd duplicate (==Rule of Three==)",
                "A Factory with the switch still in many places"
              ],
              "style": "cross",
              "ink": "red"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Branch by Abstraction",
              "text": "Old switch and new classes ==coexist== until the last branch moves. Then delete the switch."
            }
