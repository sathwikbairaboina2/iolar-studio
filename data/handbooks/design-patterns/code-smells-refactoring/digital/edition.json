    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "One commit turns a status switch into State classes and also adds a new Refunded status. A test fails. What went wrong?",
              "a_bullets": [
                "Refactor and feature are mixed, so the failure has two possible causes.",
                "Split them: refactor on green, commit, then add the feature."
              ]
            },
            {
              "type": "qa",
              "q": "The same shipping-type switch sits in 4 classes. You add Overnight. How many edits, and what removes the problem?",
              "a_bullets": [
                "4 edits, one per copy: a Switch Statements smell.",
                "Replace Conditional with Polymorphism: one new Strategy class, plus one Factory switch."
              ]
            },
            {
              "type": "qa",
              "q": "An Order moves Pending, Paid, Shipped as methods are called on it. Strategy or State?",
              "a_bullets": [
                "State: the object switches itself and each state knows its successor.",
                "Strategy is picked by the client and its algorithms do not know each other."
              ]
            }
          ]
        }
      ]
