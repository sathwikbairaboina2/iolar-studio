          "blocks": [
            {
              "type": "heading",
              "text": "1. Smell vs Bug",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "A ==smell== is a surface symptom of a deeper design problem",
                "The code works, but it is ==costly to change==",
                "A smell is a **prompt to investigate**, not a bug"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "table",
              "headers": [
                "",
                "Bug",
                "Smell"
              ],
              "rows": [
                [
                  "Behavior now",
                  "{red:Broken}",
                  "{green:Works}"
                ],
                [
                  "Cost",
                  "Wrong result",
                  "Next change **risky, slow, expensive**"
                ]
              ]
            },
            {
              "type": "heading",
              "text": "2. Smell Families",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "Family",
                "Smells",
                "Cost"
              ],
              "rows": [
                [
                  "**Bloaters**",
                  "Long Method, Large Class, Switch Statements, Primitive Obsession",
                  "Code grows too big"
                ],
                [
                  "**Change preventers**",
                  "Shotgun Surgery, Divergent Change",
                  "One change, many edits"
                ],
                [
                  "**Couplers**",
                  "Feature Envy",
                  "Classes lean on each other"
                ]
              ]
            },
            {
              "type": "heading",
              "text": "3. Refactoring Safely",
              "ink": "purple"
            },
            {
              "type": "bullets",
              "items": [
                "==Refactoring== = change internal structure, **same observable behavior**",
                "Passing tests are the safety net"
              ],
              "style": "check"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "Tests green",
                    "ink": "green"
                  },
                  {
                    "text": "One small change",
                    "ink": "blue"
                  },
                  {
                    "text": "Tests green",
                    "ink": "green"
                  },
                  {
                    "text": "Commit",
                    "ink": "purple"
                  }
                ]
              }
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Never mix",
              "text": "Refactor and add a feature in ==separate commits==. Mixed, a failing test has two possible causes."
            }
          ]
        }
      ]
