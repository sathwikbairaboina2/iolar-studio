    {
      "title": "Bloaters and Couplers: Spotting the Six Smells",
      "role": "outline",
      "outlineIndex": 1,
      "pages": [
        {
          "title": "Bloaters and Couplers: Spotting the Six Smells",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Smells and Fixes",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "Smell",
                "Sign",
                "Fix"
              ],
              "rows": [
                [
                  "Long Method",
                  "comments mark sections, 20+ lines",
                  "==Extract Method=="
                ],
                [
                  "Large Class",
                  "too many fields, breaks SRP",
                  "==Extract Class=="
                ],
                [
                  "Switch Statements",
                  "same type switch repeated, breaks Open/Closed",
                  "Polymorphism"
                ],
                [
                  "Shotgun Surgery",
                  "one change, many classes",
                  "Move Method / Inline Class"
                ],
                [
                  "Divergent Change",
                  "one class, many reasons",
                  "Extract Class"
                ],
                [
                  "Feature Envy",
                  "uses another object's data",
                  "==Move Method=="
                ]
              ]
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Opposites",
              "text": "Shotgun Surgery is the opposite of Divergent Change, which usually comes from a Large Class."
            },
            {
              "type": "heading",
              "text": "2. Feature Envy in Code",
              "ink": "orange"
            },
            {
              "type": "bullets",
              "items": [
                "Many getters of another object: the method belongs with that data"
              ],
              "style": "dot"
            },
            {
              "type": "code",
              "lang": "java",
              "lines": [
                "double total() { // Order",
                "  return base * (1 - customer.getTier().getDiscount());",
                "}",
                "// after Move Method, in Tier",
                "double apply(double base) {",
                "  return base * (1 - discount);",
                "}"
              ]
            },
            {
              "type": "heading",
              "text": "3. Quick Checks",
              "ink": "purple"
            },
            {
              "type": "bullets",
              "items": [
                "==Long Method==: a comment marks each section",
                "==Switch==: new type means editing every copy",
                "==Large Class==: changes for unrelated reasons"
              ],
              "style": "check"
            }
          ]
        }
      ]
