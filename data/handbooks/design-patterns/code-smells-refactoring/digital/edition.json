            {
              "type": "heading",
              "text": "1. Factory",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "==Replace Constructor with Factory Method==",
                "Holds the **single remaining switch**: type code → Strategy or State",
                "Callers never use `new` on concrete classes"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "code",
              "lang": "python",
              "lines": [
                "def make_shipping(code):",
                "    match code:",
                "        case 'standard': return Standard()",
                "        case 'express': return Express()",
                "        case _: raise ValueError(code)"
              ],
              "note": "the only switch left"
            },
            {
              "type": "heading",
              "text": "2. Safe Step Loop and Tests",
              "ink": "blue"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "Tests green",
                    "ink": "green"
                  },
                  {
                    "text": "ONE small change",
                    "sub": "mechanical",
