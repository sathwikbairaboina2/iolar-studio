                    "sub": "*",
                    "ink": "green"
                  }
                ]
              }
            },
            {
              "type": "heading",
              "text": "3. Many-to-many",
              "ink": "purple"
            },
            {
              "type": "bullets",
              "items": [
                "`*` to `*` is resolved with an ==association class== or **join class**",
                "Result: two ==one-to-many== links"
              ],
              "style": "dot"
            },
            {
              "type": "diagram",
              "kind": "chain",
              "spec": {
                "steps": [
                  {
                    "text": "Student",
                    "note": "1",
                    "ink": "blue"
                  },
                  {
                    "text": "Enrollment",
                    "note": "0..* each side",
                    "ink": "orange"
