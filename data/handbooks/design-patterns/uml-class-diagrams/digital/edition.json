          "title": "Multiplicity and Reading Relationships",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Multiplicity values",
              "ink": "green"
            },
            {
              "type": "table",
              "headers": [
                "Mark",
                "Meaning"
              ],
              "rows": [
                [
                  "`1`",
                  "exactly one"
                ],
                [
                  "`0..1`",
                  "optional"
                ],
                [
                  "`*` or `0..*`",
                  "zero or more"
                ],
                [
                  "`1..*`",
                  "at least one"
                ],
                [
                  "`n..m`",
                  "a range, e.g. `2..5`"
                ]
              ],
              "frame": "dashed"
            },
            {
              "type": "bullets",
              "items": [
                "Written at ==each end== of the line",
                "Read an end as: how many of ==that end's class== per ==one instance== of the other",
                "`Customer 1 --- 0..* Order` = one customer has many orders"
              ],
              "style": "dot"
            },
            {
              "type": "heading",
              "text": "2. Roles and association classes",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "{blue:Role names} sit on the line: `+owner`, `+orders`",
                "The attribute implementing a role is shown ==on the line==, not inside the box",
                "An ==association class== hangs off the line by a **dashed connector**",
                "It holds attributes of the link itself"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "blue"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "Student",
                    "sub": "*",
                    "ink": "blue"
