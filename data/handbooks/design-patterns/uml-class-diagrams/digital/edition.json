    {
      "title": "Reading Pattern Diagrams and Common Mistakes",
      "role": "outline",
      "outlineIndex": 4,
      "pages": [
        {
          "title": "Reading Pattern Diagrams and Common Mistakes",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Reading Routine",
              "ink": "green"
            },
            {
              "type": "diagram",
              "kind": "chain",
              "spec": {
                "steps": [
                  {
                    "text": "Interface first",
                    "note": "<<interface>> or abstract class",
                    "ink": "green"
                  },
                  {
                    "text": "Follow triangles",
                    "note": "down to concrete classes",
                    "ink": "blue"
                  },
                  {
                    "text": "Trace diamonds, arrows",
                    "note": "who holds what",
                    "ink": "purple"
                  }
                ]
              }
            },
            {
              "type": "heading",
              "text": "2. Three Patterns",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "Pattern",
                "Interface",
                "Line to it"
              ],
              "rows": [
                [
                  "Strategy",
                  "Strategy",
                  "Context association"
                ],
                [
                  "Observer",
                  "Observer",
                  "Subject hollow diamond, 0..*"
                ],
                [
                  "Factory",
                  "Product",
                  "Factory dependency on Products"
                ]
              ],
              "frame": "dashed"
            },
            {
              "type": "bullets",
              "items": [
                "**Strategy**: Context holds one reference, so it is ==swappable at runtime==",
                "**Observer**: observers live on their own, so ==aggregation==; Subject calls `update()` on each",
                "**Factory**: returns the ==Product interface==, dashed arrow to concrete Products"
              ],
              "style": "dot"
            },
            {
              "type": "diagram",
              "kind": "chain",
              "spec": {
                "title": "Reading Strategy",
                "steps": [
                  {
                    "text": "Strategy",
                    "note": "<<interface>>",
                    "ink": "green"
                  },
                  {
                    "text": "ConcreteStrategies",
                    "note": "dashed + hollow triangle",
                    "ink": "blue"
                  },
                  {
                    "text": "Context",
                    "note": "association to Strategy",
                    "ink": "purple"
                  }
                ]
              }
            },
            {
              "type": "heading",
              "text": "3. Common Mistakes",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "Diamond on the part end: it belongs on the ==whole==",
                "Solid line with a hollow triangle for realization: the line must be ==dashed==",
                "Inheritance for has-a: use a diamond or association",
                "Drawing every dependency: it clutters, keep the key ones",
                "Omitting multiplicity: mark `1`, `0..*` at each end"
              ],
              "style": "cross",
              "ink": "red"
            }
          ]
        }
      ]
    },
