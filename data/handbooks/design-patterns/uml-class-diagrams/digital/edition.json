    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "A dashed line with a hollow triangle points from ArrayList to List. What does it mean?",
              "a_bullets": [
                "Realization: ArrayList implements the List interface.",
                "A solid line with a hollow triangle would mean inheritance (a plain solid line is just an association). A dashed line with an open arrow would mean dependency."
              ]
            },
            {
              "type": "qa",
              "q": "A diagram puts a filled diamond on the Room end of a House–Room line. What is wrong?",
              "a_bullets": [
                "The diamond belongs on the whole, so it should be on House.",
                "Filled diamond on House means composition: delete the House and its Rooms go too."
              ]
            },
            {
              "type": "qa",
              "q": "Customer 1 --- 0..* Order. Can an Order exist with no Customer? Can a Customer have no Orders?",
              "a_bullets": [
                "No: each Order relates to exactly one Customer.",
                "Yes: 0..* means a Customer can have zero or more Orders."
              ]
            }
          ]
        }
      ]
