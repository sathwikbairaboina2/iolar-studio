        {
          "type": "heading",
          "text": "2. Classic Binary Search Template"
        },
        {
          "type": "code",
          "lang": "java",
          "lines": [
            "int low = 0, high = n - 1;",
            "while (low <= high) {",
            "  int mid = low + (high-low)/2;",
            "  if (arr[mid] == target)",
            "    return mid;",
            "  else if (arr[mid] < target)",
            "    low = mid + 1;",
            "  else high = mid - 1;",
            "}",
            "return -1; // not found"
          ],
          "note": "works only on SORTED arrays / lists"
        },
        {
          "type": "paragraph",
          "text": "Search Target: the goal is the ==index== of the target element. Return the index if found, otherwise return **-1**."
        },
        {
          "type": "sidebox",
          "title": "Example",
          "items": [
            "arr = [2,5,8,12,16,23,38,56,72]",
            "target = 23",
            "answer: index = __5__"
          ],
          "ink": "green"
        },
        {
          "type": "table",
          "headers": [
            "Condition",
            "Where is target",
            "Action"
          ],
          "rows": [
            [
              "arr[mid] == target",
              "at mid",
              "return mid"
            ],
