    {
      "page_title": "Rotated Arrays with Duplicates & Peak Search",
      "blocks": [
        {
          "type": "bullets",
          "items": [
            "arr[low] == arr[mid] == arr[high] -> can't tell which half is sorted",
            "Shrink: `low++`, `high--`, continue the loop",
            "Otherwise apply the normal sorted-half check"
          ],
          "frame": "dashed",
          "ink": "red"
        },
        {
          "type": "callout",
          "style": "sticky-pink",
          "title": "Note",
