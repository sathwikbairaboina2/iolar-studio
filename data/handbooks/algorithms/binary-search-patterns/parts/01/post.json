              "**RIGHT** half",
              "low = mid + 1"
            ],
            [
              "arr[mid] > target",
              "**LEFT** half",
              "high = mid - 1"
            ]
          ]
        },
        {
          "type": "code",
          "lang": "java",
          "lines": [
            "// lastOccurrence: same loop",
            "if (arr[mid] == target) {",
            "  ans = mid;     // potential",
            "  low = mid + 1; // right half",
            "}",
            "return ans;"
          ],
          "note": "Move RIGHT when target is found"
        },
        {
          "type": "code",
