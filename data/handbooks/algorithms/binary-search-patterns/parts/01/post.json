        {
          "type": "heading",
          "text": "3. First & Last Occurrence + Bounds"
        },
        {
          "type": "sidebox",
          "title": "1. First Occurrence (Lower Bound)",
          "items": [
            "Goal: ==first index== of target, else -1",
            "On a match do NOT return yet",
            "Move **LEFT**: high = mid - 1"
          ],
          "ink": "green"
        },
        {
          "type": "code",
          "lang": "java",
          "lines": [
            "int ans = -1;",
            "while (low <= high) {",
            "  mid = low + (high - low) / 2;",
            "  if (arr[mid] == target) {",
            "    ans = mid;     // potential",
            "    high = mid - 1; // left half",
            "  } else if (arr[mid] < target)",
            "    low = mid + 1;",
            "  else high = mid - 1;",
            "}",
            "return ans;"
          ],
          "note": "Move LEFT when target is found"
        },
        {
          "type": "sidebox",
          "title": "2. Last Occurrence (Upper Bound - 1)",
          "items": [
            "Goal: ==last index== of target, else -1",
            "On a match do NOT return yet",
            "Move **RIGHT**: low = mid + 1"
          ],
          "ink": "green"
        },
        {
          "type": "sidebox",
          "title": "3. Count Frequency of target",
          "items": [
            "frequency = lastOccurrence - firstOccurrence + 1",
            "arr = [2,4,4,4,4,5,6,7,9], target = 4",
            "firstOccurrence = 1, lastOccurrence = 4",
            "frequency = 4 - 1 + 1 = __4__"
          ],
