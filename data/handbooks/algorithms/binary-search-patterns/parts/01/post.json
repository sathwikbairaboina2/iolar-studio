            "      target < arr[mid])",
            "    high = mid - 1;",
            "  else low = mid + 1;",
            "} else { // right half sorted",
            "  if (arr[mid] <= target &&",
            "      target <= arr[high])",
            "    low = mid + 1;",
            "  else high = mid - 1;",
            "}"
          ],
