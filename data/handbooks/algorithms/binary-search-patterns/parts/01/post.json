          "lines": [
            "int low = 0, high = n - 1;",
            "while (low < high) {",
            "  mid = low + (high - low) / 2;",
            "  if (arr[mid] < arr[mid + 1])",
            "    low = mid + 1; // go right",
            "  else high = mid; // go left",
            "}",
            "return low; // index of peak"
