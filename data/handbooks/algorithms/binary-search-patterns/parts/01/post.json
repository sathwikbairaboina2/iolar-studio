    {
      "page_title": "Lower Bound, Upper Bound & Search on Answer",
      "blocks": [
        {
          "type": "callout",
          "style": "tip",
          "title": "Tip",
          "text": "Use both first & last occurrence to count frequency in ==O(log n)== time, no linear scan."
        },
        {
          "type": "sidebox",
          "title": "4. Lower Bound",
          "items": [
            "Goal: first index where `arr[i] >= target`",
            "If all elements < target, return **n**"
          ],
          "ink": "green"
        },
        {
          "type": "code",
          "lang": "java",
          "lines": [
            "int low = 0, high = n; // not n-1",
            "while (low < high) {",
            "  mid = low + (high - low) / 2;",
            "  if (arr[mid] >= target)",
            "    high = mid;",
            "  else low = mid + 1;",
            "}",
            "return low; // first arr[i] >= t"
          ],
          "note": "returns n when all elements < target"
        },
        {
          "type": "sidebox",
          "title": "5. Upper Bound",
          "items": [
            "Goal: first index where `arr[i] > target`",
            "If all elements <= target, return **n**"
          ],
          "ink": "green"
        },
        {
          "type": "code",
          "lang": "java",
          "lines": [
            "int low = 0, high = n; // not n-1",
            "while (low < high) {",
            "  mid = low + (high - low) / 2;",
            "  if (arr[mid] > target)",
            "    high = mid;",
            "  else low = mid + 1;",
            "}",
            "return low; // first arr[i] > t"
          ],
          "note": "high = n (one past last index)"
        },
        {
          "type": "table",
          "headers": [
            "Pattern",
            "Goal / Return",
            "When target found",
            "Example use"
          ],
          "rows": [
            [
              "First Occurrence",
              "first index, or -1",
              "move **LEFT**, high = mid - 1",
              "count frequency, lower bound"
            ],
            [
              "Last Occurrence",
              "last index, or -1",
              "move **RIGHT**, low = mid + 1",
              "count frequency, upper bound - 1"
