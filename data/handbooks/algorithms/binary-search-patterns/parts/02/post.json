          "lines": [
            "while (lo <= hi) {",
            "  int mid = lo + (hi - lo) / 2;",
            "  if (a[mid] == t) return mid;",
            "  if (a[mid] < t) lo = mid + 1;",
            "  else hi = mid - 1;",
            "}  return -1;  // not found"
          ],
          "note": "overflow-safe mid, sorted input only"
