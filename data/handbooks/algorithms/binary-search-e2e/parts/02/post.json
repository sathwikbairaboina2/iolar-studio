        {
          "type": "code",
          "lang": "java",
          "lines": [
            "boolean search(int[][] m, int t){",
            "  int R=m.length, n=m[0].length;",
            "  int low=0, high=R*n-1;",
            "  while (low <= high) {",
            "    int mid = low+(high-low)/2;",
            "    int r = mid / n, c = mid % n;",
            "    if (m[r][c]==t) return true;",
            "    if (m[r][c]<t) low = mid+1;",
            "    else high = mid - 1;",
            "  }",
            "  return false;",
            "}"
          ],
          "note": "never build the flat array"
        },
