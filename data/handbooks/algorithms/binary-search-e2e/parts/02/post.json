        },
        {
          "type": "code",
          "lang": "java",
          "lines": [
            "int bs(int[] a, int lo, int hi,",
            "       int t, boolean asc) {",
            "  while (lo <= hi) {",
            "    int m = lo+(hi-lo)/2;",
            "    if (a[m] == t) return m;",
            "    boolean go = asc ? a[m] < t",
            "                     : a[m] > t;",
            "    if (go) lo = m + 1;",
            "    else hi = m - 1;",
            "  }",
            "  return -1;",
            "}"
          ],
          "note": "asc false: flip the comparison"
        },
        {
