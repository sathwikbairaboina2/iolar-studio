    {
      "page_title": "Finding & Preventing Duplicates (Q53-54)",
      "blocks": [
        {
          "type": "heading",
          "text": "Q53. Rows beyond the first, ROW_NUMBER()",
          "ink": "purple"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "SELECT id, email FROM (",
            " SELECT *, ROW_NUMBER() OVER (",
            " PARTITION BY email ORDER BY id",
            ") rn FROM users) t",
            "WHERE rn > 1;  -- ids 3, 4"
          ],
          "note": "ORDER BY id decides which row stays"
        },
        {
          "type": "heading",
          "text": "Q54. Employees sharing a salary",
          "ink": "blue"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "SELECT name, salary",
            "FROM employees e",
            "WHERE EXISTS (SELECT 1",
            " FROM employees x",
            " WHERE x.salary = e.salary",
            " AND x.id <> e.id);  -- Ben, Chen"
          ],
          "note": "x.id <> e.id excludes the row itself"
        },
        {
          "type": "heading",
          "text": "Duplicates: three tools",
          "ink": "red"
        },
        {
          "type": "table",
          "headers": [
            "Goal",
            "Pick"
          ],
          "rows": [
            [
              "Count each duplicate",
              "GROUP BY + HAVING"
            ],
            [
              "List the extra rows",
              "ROW_NUMBER() > 1"
            ],
            [
              "Remove the extras",
              "DELETE ... USING"
            ]
          ]
        },
        {
          "type": "heading",
          "text": "Extra. Nth highest with OFFSET",
          "ink": "blue"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "SELECT DISTINCT salary",
            "FROM employees",
            "ORDER BY salary DESC",
            "LIMIT 1 OFFSET 2;  -- 70000"
          ],
          "note": "OFFSET n-1 gives the nth highest"
        },
        {
          "type": "heading",
          "text": "Extra. Count the extra copies",
          "ink": "red"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "SELECT COUNT(*)",
            "  - COUNT(DISTINCT email) AS extra",
            "FROM users;  -- 2"
          ],
          "note": "total rows minus distinct emails"
        },
        {
          "type": "table",
          "headers": [
            "Measure",
            "Result"
          ],
          "rows": [
            [
              "Total rows",
              "4"
            ],
            [
              "Distinct emails",
              "2"
            ],
            [
              "Extra copies",
              "2"
            ]
          ]
        },
        {
          "type": "bullets",
          "items": [
            "`WHERE COUNT(*) > 1` is an error: use ==HAVING==",
            "`ROW_NUMBER()` without a tiebreaker is **unstable**",
            "Forgetting `DISTINCT` returns the **same** salary twice"
          ],
          "style": "cross",
          "frame": "dashed",
          "ink": "red"
        },
        {
          "type": "heading",
          "text": "Extra. Prevent duplicates: UNIQUE",
          "ink": "purple"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "ALTER TABLE users",
            "  ADD CONSTRAINT uq_email",
            "  UNIQUE (email);"
          ],
          "note": "fails until duplicates are removed"
        },
        {
          "type": "callout",
          "style": "tip",
          "title": "Tip",
          "text": "For the nth highest, use DENSE_RANK so tied salaries count as one rank."
        },
        {
          "type": "callout",
          "style": "sticky",
          "title": "Remember",
          "text": "Add a tiebreaker such as id to ORDER BY so ROW_NUMBER() results are repeatable."
        }
      ],
      "hero": "postgresql",
      "subtitle": "Interview scenarios I"
    },
    {
      "page_title": "Running Totals & Trends (Q55-58)",
      "blocks": [
        {
          "type": "paragraph",
          "text": "Sample `orders`: ids 1-4 are Jan 1-4 2024 (100, 200, 300, 400) from customers 1, 2, 3, 3. Id 6 is Feb 10, customer 1, 1200. Id 10 is Mar 5, customer 1, 900.",
          "frame": "dashed",
          "ink": "green"
        },
        {
          "type": "heading",
          "text": "Q55. Running total of amount by date",
          "ink": "blue"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "SELECT order_date, amount,",
            "  SUM(amount) OVER (",
            "    ORDER BY order_date) AS running",
            "FROM orders",
            "WHERE order_date < '2024-02-01';",
            "-- running: 100, 300, 600, 1000"
          ],
          "note": "default frame: same-date ties share a total"
        },
        {
          "type": "heading",
          "text": "Q56. 3-row moving average of daily sales",
          "ink": "blue"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "SELECT order_date,",
            "  ROUND(AVG(amount) OVER (",
            "    ORDER BY order_date ROWS",
            "    BETWEEN 2 PRECEDING AND",
            "    CURRENT ROW), 2) AS ma3",
            "FROM orders",
            "WHERE order_date < '2024-02-01';",
            "-- ma3: 100.00, 150.00, 200.00, 300.00"
          ],
          "note": "first rows average fewer than 3"
        },
        {
          "type": "heading",
          "text": "Q57. Month-over-month growth with LAG()",
          "ink": "blue"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "WITH m AS (SELECT",
            "  to_char(order_date,'YYYY-MM') mon,",
            "  SUM(amount) s",
            "  FROM orders GROUP BY 1)",
            "SELECT mon, s, ROUND(100.0*",
            "  (s-LAG(s) OVER w)/LAG(s) OVER w,1) pct",
            "FROM m WINDOW w AS (ORDER BY mon);"
          ],
          "note": "first month has no previous: NULL"
        },
        {
          "type": "table",
          "headers": [
            "mon",
            "s",
            "pct"
          ],
          "rows": [
            [
              "2024-01",
              "1000",
              "NULL"
            ],
            [
              "2024-02",
              "1200",
              "20.0"
            ],
            [
              "2024-03",
              "900",
              "-25.0"
            ]
          ]
        },
        {
          "type": "heading",
          "text": "Q58. Top 3 customers by spend each month",
          "ink": "blue"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "WITH s AS (SELECT",
            "  to_char(order_date,'YYYY-MM') mon,",
            "  customer_id, SUM(amount) spend",
            "  FROM orders GROUP BY 1, 2)",
            "SELECT * FROM (SELECT *, ROW_NUMBER()",
            "  OVER (PARTITION BY mon",
            "  ORDER BY spend DESC) rn FROM s) t",
            "WHERE rn <= 3 ORDER BY mon, rn;"
          ],
          "note": "PARTITION BY mon resets rank each month"
        },
        {
          "type": "table",
          "headers": [
            "mon",
            "customer_id",
            "spend",
            "rn"
          ],
          "rows": [
            [
              "2024-01",
              "3",
              "700",
              "1"
            ],
            [
              "2024-01",
              "2",
              "200",
              "2"
            ],
            [
              "2024-01",
              "1",
              "100",
              "3"
            ],
            [
              "2024-02",
              "1",
              "1200",
              "1"
            ],
            [
              "2024-03",
              "1",
              "900",
              "1"
            ]
          ]
        },
        {
          "type": "callout",
          "style": "takeaway",
          "title": "Key Takeaways",
          "text": "ORDER BY alone gives a running total; a ROWS frame gives a moving window. LAG/LEAD compare neighbouring rows: growth, months in a row, id gaps. ROW_NUMBER with PARTITION BY gives top N per group."
        }
      ],
      "hero": "postgresql",
      "subtitle": "Running totals, trends"
    },
    {
      "page_title": "Streaks & Sequence Gaps (Q59-60)",
      "blocks": [
        {
          "type": "heading",
          "text": "Q59. Customers ordering 3 months in a row",
          "ink": "blue"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "WITH m AS (SELECT DISTINCT customer_id,",
            "  date_trunc('month', order_date)::date mon",
            "  FROM orders)",
            "SELECT DISTINCT customer_id FROM (",
            "  SELECT *, LAG(mon, 2) OVER (",
            "    PARTITION BY customer_id",
            "    ORDER BY mon) p FROM m) t",
            "WHERE mon = p + INTERVAL '2 months';",
            "-- customer_id: 1"
          ],
          "note": "dedupe to one row per month first"
        },
        {
          "type": "heading",
          "text": "Q60. Gaps in a sequence of order ids",
          "ink": "blue"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "SELECT order_id + 1 AS gap_start,",
            "  next_id - 1 AS gap_end",
            "FROM (SELECT order_id,",
            "  LEAD(order_id) OVER (",
            "    ORDER BY order_id) next_id",
            "  FROM orders) t",
            "WHERE next_id - order_id > 1;",
            "-- gap_start, gap_end: (5, 5), (7, 9)"
          ],
          "note": "LEAD reads the next id"
        }
      ],
      "hero": "postgresql",
      "subtitle": "Running totals, trends"
    },
    {
      "page_title": "Query Patterns Cheatsheet (Q61-66)",
      "blocks": [
        {
          "type": "heading",
          "text": "Q61. Highest-paid employee",
          "ink": "green"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "-- A: all ties kept",
            "SELECT * FROM employees",
            "WHERE salary = (SELECT MAX(salary)",
            "  FROM employees);",
            "-- B: ORDER BY salary DESC LIMIT 1"
          ],
          "note": "MAX() alone returns a value, not the row"
        },
        {
          "type": "bullets",
          "items": [
            "`MAX()` gives the **value**, not the row",
            "`LIMIT 1` gives one row, ties dropped",
            "`RANK() OVER (...)` = 1 keeps every tie"
          ],
          "style": "check",
          "frame": "dashed",
          "ink": "green"
        },
        {
          "type": "heading",
          "text": "Q62. Rows with no match",
          "ink": "red"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "SELECT d.* FROM departments d",
            "WHERE NOT EXISTS (SELECT 1",
            "  FROM employees e",
            "  WHERE e.dept_id = d.id);"
          ],
          "note": "NOT IN returns nothing if a NULL appears"
        },
        {
          "type": "bullets",
          "items": [
            "`NOT IN` + one NULL in the list = **zero rows**",
            "`NOT EXISTS` is NULL-safe: the default pick",
            "`LEFT JOIN ... WHERE e.id IS NULL` is also safe"
          ],
          "style": "cross",
          "frame": "dashed",
          "ink": "red"
        },
        {
          "type": "heading",
          "text": "Q63. Top N per group",
          "ink": "purple"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "WITH r AS (",
            "  SELECT *, ROW_NUMBER() OVER (",
            "    PARTITION BY dept_id",
            "    ORDER BY salary DESC) AS rn",
            "  FROM employees)",
            "SELECT * FROM r WHERE rn <= 3;"
          ],
          "note": "Swap in RANK() to keep ties"
        },
        {
          "type": "heading",
          "text": "Q64. Conditional count, one pass",
          "ink": "blue"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "SELECT",
            "  COUNT(*) AS total,",
            "  COUNT(*) FILTER",
            "    (WHERE status = 'shipped')",
            "    AS shipped",
            "FROM orders;"
          ],
          "note": "FILTER is PostgreSQL 9.4+"
        },
        {
          "type": "heading",
          "text": "Q65. One row per group",
          "ink": "purple"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "SELECT DISTINCT ON (dept_id)",
            "  dept_id, name, salary",
            "FROM employees",
            "ORDER BY dept_id, salary DESC;"
          ],
          "note": "ORDER BY must lead with DISTINCT ON key"
        },
        {
          "type": "heading",
          "text": "Q66. Pivot status counts",
          "ink": "blue"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "SELECT customer_id,",
            "  SUM(CASE WHEN status='paid'",
            "    THEN 1 ELSE 0 END) AS paid_n,",
            "  SUM(CASE WHEN status='open'",
            "    THEN 1 ELSE 0 END) AS open_n",
            "FROM orders GROUP BY customer_id;"
          ],
          "note": "One CASE per output column"
        },
        {
          "type": "callout",
          "style": "takeaway",
          "title": "Key Takeaways",
          "text": "Prefer NOT EXISTS over NOT IN. Use ROW_NUMBER() in a CTE for top N, DISTINCT ON for top 1, FILTER or CASE to count by condition."
