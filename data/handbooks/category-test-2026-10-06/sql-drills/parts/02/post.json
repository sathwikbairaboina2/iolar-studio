          }
        },
        {
          "type": "heading",
          "text": "Q49. 2nd highest salary, LIMIT/OFFSET",
          "ink": "blue"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "SELECT DISTINCT salary",
            "FROM employees",
            "ORDER BY salary DESC",
            "LIMIT 1 OFFSET 1;  -- 80000"
          ],
          "note": "DISTINCT skips tied top salaries"
        },
        {
          "type": "heading",
          "text": "Q50. 3rd highest salary, DENSE_RANK()",
          "ink": "purple"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "SELECT DISTINCT salary FROM (",
            " SELECT salary, DENSE_RANK()",
            "  OVER (ORDER BY salary DESC) r",
            " FROM employees) t",
            "WHERE r = 3;  -- 70000"
          ],
          "note": "RANK() would skip ranks after ties"
        },
        {
          "type": "heading",
          "text": "Q51. 2nd highest per department",
          "ink": "green"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "SELECT dept_id, name, salary",
            "FROM (SELECT *, DENSE_RANK()",
            " OVER (PARTITION BY dept_id",
            " ORDER BY salary DESC) r",
            " FROM employees) t",
            "WHERE r = 2;  -- 10 Ben, 20 Dia"
          ],
          "note": "PARTITION BY restarts rank per dept"
        },
        {
          "type": "heading",
          "text": "Q52. Duplicate emails, HAVING",
          "ink": "red"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "SELECT email, COUNT(*) AS n",
            "FROM users",
            "GROUP BY email",
            "HAVING COUNT(*) > 1;",
            "-- a@x.com | 3"
          ],
          "note": "HAVING filters groups, WHERE rows"
        },
        {
          "type": "callout",
          "style": "takeaway",
          "title": "Key Takeaways",
          "text": "Nth highest: use DENSE_RANK, so ties count once. Duplicates: GROUP BY + HAVING counts them, ROW_NUMBER() isolates the extras. Add PARTITION BY for per-group answers."
        },
        {
          "type": "heading",
          "text": "Ties: RANK vs DENSE_RANK vs ROW_NUMBER",
          "ink": "green"
        },
        {
          "type": "table",
          "headers": [
            "Function",
            "Salaries 90, 80, 80, 70"
          ],
          "rows": [
            [
              "ROW_NUMBER()",
              "1, 2, 3, 4"
            ],
            [
              "RANK()",
              "1, 2, 2, 4"
            ],
            [
              "DENSE_RANK()",
              "1, 2, 2, 3"
            ]
          ]
        },
        {
          "type": "bullets",
          "items": [
            "`ROW_NUMBER()` never ties: it breaks ties arbitrarily",
            "`RANK()` ==skips== numbers after a tie",
            "`DENSE_RANK()` leaves **no gaps** in the ranks"
          ],
          "style": "check",
          "frame": "dashed",
          "ink": "green"
        }
      ],
