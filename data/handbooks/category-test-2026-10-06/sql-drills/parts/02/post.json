  "slides": [
    {
      "page_title": "CTEs: Chaining & Recursion (Q43-Q47)",
      "blocks": [
        {
          "type": "heading",
          "text": "Q44. Chain two CTEs: above-average depts",
          "ink": "purple"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "WITH t AS (SELECT dept_id,",
            "  SUM(salary) s FROM employees",
            "  GROUP BY dept_id),",
            "a AS (SELECT AVG(s) av FROM t)",
            "SELECT t.* FROM t, a",
            "WHERE t.s > a.av;"
          ],
          "note": "later CTE can read an earlier one"
        },
        {
          "type": "heading",
          "text": "Q45. Top earner per department",
          "ink": "green"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "WITH r AS (SELECT *, ROW_NUMBER()",
            "  OVER (PARTITION BY dept_id",
            "  ORDER BY salary DESC) rn",
            "  FROM employees)",
            "SELECT * FROM r WHERE rn = 1;"
          ],
          "note": "RANK() would keep tied top earners"
        },
        {
          "type": "heading",
          "text": "Q46. Management chain, WITH RECURSIVE",
          "ink": "orange"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "WITH RECURSIVE c AS (",
            "  SELECT * FROM employees",
            "  WHERE id = 5",
            "  UNION ALL",
            "  SELECT e.* FROM employees e",
            "  JOIN c ON e.id = c.manager_id)",
            "SELECT name FROM c;"
          ],
          "note": "stops when manager_id is NULL"
        },
        {
          "type": "bullets",
          "items": [
            "Anchor row is the **employee** you start from",
            "Each step joins to the ==manager== row above",
            "The top boss has no manager, so recursion ends"
          ],
          "style": "number",
          "frame": "dashed",
          "ink": "orange"
        },
        {
          "type": "heading",
          "text": "Q47. Numbers 1 to 10, recursive CTE",
          "ink": "blue"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "WITH RECURSIVE n(i) AS (",
            "  SELECT 1",
            "  UNION ALL",
            "  SELECT i + 1 FROM n",
            "  WHERE i < 10)",
            "SELECT i FROM n;  -- 1 ... 10"
          ],
          "note": "WHERE i < 10 stops the recursion"
        },
        {
          "type": "bullets",
          "items": [
            "`SELECT 1` is the **anchor**: it runs once",
            "The part after `UNION ALL` re-reads the previous row",
            "Recursion ends when a step returns ==no rows=="
          ],
          "style": "check",
          "frame": "dashed",
          "ink": "blue"
        },
        {
          "type": "callout",
          "style": "tip",
          "title": "Tip",
          "text": "A recursive CTE without a stop condition loops forever. Always bound it with WHERE, or test with LIMIT first."
        },
        {
          "type": "heading",
          "text": "Q43. Subquery rewritten as a CTE",
          "ink": "green"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "WITH avg_pay AS (",
            "  SELECT AVG(salary) AS a",
            "  FROM employees)",
            "SELECT name, salary",
            "FROM employees, avg_pay",
            "WHERE salary > avg_pay.a;"
          ],
          "note": "name it once, reuse it below"
        },
        {
          "type": "bullets",
          "items": [
            "A CTE is a **named** temporary result",
            "It lives only for ==one statement==",
            "Easier to read than a nested subquery"
          ],
          "style": "check",
          "frame": "dashed",
          "ink": "green"
        },
        {
          "type": "callout",
          "style": "sticky",
          "title": "Remember",
          "text": "A CTE is not stored. It is re-run by every statement that uses WITH."
        }
      ],
      "hero": "postgresql",
      "subtitle": "Query & code drills"
    },
    {
      "page_title": "CTE vs Subquery & Deleting Rows (Q48)",
      "blocks": [
        {
          "type": "heading",
          "text": "CTE vs subquery",
          "ink": "purple"
        },
        {
          "type": "table",
          "headers": [
            "Need",
            "Pick"
          ],
          "rows": [
            [
              "Reuse a result twice",
              "CTE"
            ],
            [
              "Walk a hierarchy",
              "WITH RECURSIVE"
            ],
            [
              "One-off filter",
              "Subquery"
            ],
            [
              "Step-by-step logic",
              "Chained CTEs"
            ]
          ]
        },
        {
          "type": "heading",
          "text": "Q48. Delete duplicate rows, RETURNING them",
          "ink": "red"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "WITH d AS (",
            "  SELECT id, ROW_NUMBER() OVER (",
            "    PARTITION BY email",
            "    ORDER BY id) rn",
            "  FROM employees)",
            "DELETE FROM employees e USING d",
            "WHERE e.id = d.id AND d.rn > 1",
            "RETURNING e.id, e.email;"
          ],
          "note": "RETURNING lists exactly the deleted rows"
        },
        {
          "type": "bullets",
          "items": [
            "`ROW_NUMBER()` numbers each email group by id",
            "Rows with ==rn > 1== are the extra copies",
            "`USING d` joins the CTE to the **DELETE**",
            "`RETURNING` shows what was removed"
          ],
          "style": "number",
          "frame": "dashed",
          "ink": "red"
        },
        {
          "type": "callout",
          "style": "tip",
          "title": "Tip",
          "text": "Run the SELECT inside the CTE first. Wrap the DELETE in BEGIN ... ROLLBACK to preview it safely."
        },
        {
          "type": "heading",
          "text": "Extra. MATERIALIZED hint",
          "ink": "green"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "WITH x AS MATERIALIZED (",
            "  SELECT * FROM employees)",
            "SELECT * FROM x WHERE id = 1;",
            "-- or: AS NOT MATERIALIZED"
          ],
          "note": "PostgreSQL 12+ controls inlining"
        },
        {
          "type": "bullets",
          "items": [
            "Since PG 12, a CTE used once is ==inlined==",
            "`MATERIALIZED` forces a **one-time** run",
            "`NOT MATERIALIZED` forces inlining"
          ],
          "style": "check",
          "frame": "dashed",
          "ink": "green"
        },
        {
          "type": "heading",
          "text": "Extra. CTE keyword recap",
          "ink": "blue"
        },
        {
          "type": "table",
          "headers": [
            "Keyword",
            "Job"
          ],
          "rows": [
            [
              "WITH",
              "Names a result"
            ],
            [
              "RECURSIVE",
              "Self-reference"
            ],
            [
              "UNION ALL",
              "Joins anchor and step"
            ],
            [
              "RETURNING",
              "Shows changed rows"
            ]
          ]
        },
        {
          "type": "callout",
          "style": "sticky",
          "title": "Remember",
          "text": "Data-changing CTEs (DELETE, UPDATE, INSERT with RETURNING) run exactly once, even if unused."
        }
      ],
      "hero": "postgresql",
      "subtitle": "Query & code drills"
    },
