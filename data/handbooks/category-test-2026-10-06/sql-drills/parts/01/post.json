        },
        {
          "type": "callout",
          "style": "takeaway",
          "title": "Key Takeaways",
          "text": "Scalar subquery = one value (Q31). IN takes a list (Q33). EXISTS tests for any match, NOT EXISTS for none (Q34-35). Correlated subqueries use the outer alias (Q36)."
        }
