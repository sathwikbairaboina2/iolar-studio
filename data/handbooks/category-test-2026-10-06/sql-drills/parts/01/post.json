    {
      "page_title": "Filtering with WHERE (Q7-Q14)",
      "blocks": [
        {
          "type": "heading",
          "text": "Q7. Employees in department 10",
          "ink": "blue"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "SELECT name, dept_id",
            "FROM employees",
            "WHERE dept_id = 10;"
          ],
          "note": "single = compares, never =="
        },
        {
          "type": "heading",
          "text": "Q8. Salary between 50000 and 80000",
          "ink": "blue"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "SELECT name, salary",
            "FROM employees",
            "WHERE salary BETWEEN 50000",
            "  AND 80000;"
          ],
          "note": "BETWEEN includes both ends"
        },
        {
          "type": "heading",
          "text": "Q9. Departments 10, 20 or 30",
          "ink": "blue"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "SELECT name, dept_id",
            "FROM employees",
            "WHERE dept_id IN (10, 20, 30);"
          ],
          "note": "IN replaces a chain of ORs"
        },
        {
          "type": "heading",
          "text": "Q10. Names starting with 'A'",
          "ink": "blue"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "SELECT name",
            "FROM employees",
            "WHERE name LIKE 'A%';"
          ],
          "note": "LIKE is case-sensitive; ILIKE is not"
        },
        {
          "type": "heading",
          "text": "Q11. Employees with no manager",
          "ink": "blue"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "SELECT name",
            "FROM employees",
            "WHERE manager_id IS NULL;"
          ],
          "note": "= NULL never matches any row"
        },
        {
          "type": "heading",
          "text": "Q12. 2024 orders, not cancelled",
          "ink": "blue"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "SELECT order_id, status",
            "FROM orders",
            "WHERE order_date >= '2024-01-01'",
            "  AND order_date < '2025-01-01'",
            "  AND (NOT status = 'cancelled'",
            "       OR status IS NULL);"
          ],
          "note": "parenthesise every OR inside AND"
        },
        {
          "type": "heading",
          "text": "Q13. Distinct job titles",
          "ink": "blue"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "SELECT DISTINCT job_title",
            "FROM employees;"
          ],
          "note": "one row per unique value"
        },
        {
          "type": "heading",
          "text": "Q14. Skip the first 10 rows",
          "ink": "blue"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "SELECT employee_id, name",
            "FROM employees",
            "ORDER BY employee_id",
            "LIMIT 10 OFFSET 10;"
          ],
          "note": "always pair OFFSET with ORDER BY"
        },
        {
          "type": "callout",
          "style": "takeaway",
          "title": "Key Takeaways",
          "text": "Use ==BETWEEN== for inclusive ranges and ==IN== for lists. Test missing values with **IS NULL**, never `= NULL`. Wrap each OR in __parentheses__ when mixing it with AND."
        }
      ],
      "hero": "postgresql",
      "subtitle": "Eight filter drills"
    },
    {
      "page_title": "Aggregates and GROUP BY (Q15-20)",
      "blocks": [
        {
          "type": "heading",
          "text": "Q15. Count the total number of employees",
          "ink": "green"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "SELECT COUNT(*) AS total",
            "FROM employees;",
            "-- one row: total = row count"
          ],
          "note": "COUNT(*) counts rows, NULLs included"
        },
        {
          "type": "heading",
          "text": "Q16. Average salary across the company",
          "ink": "green"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "SELECT AVG(salary) AS avg_salary",
            "FROM employees;",
            "-- one numeric value, many decimals"
          ],
          "note": "AVG skips NULL salaries"
        },
        {
          "type": "heading",
          "text": "Q17. Highest and lowest salary together",
          "ink": "green"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "SELECT MAX(salary) AS top_pay,",
            "       MIN(salary) AS low_pay",
            "FROM employees;",
            "-- one row, two columns"
          ],
          "note": "Several aggregates, one scan"
        },
        {
          "type": "heading",
          "text": "Q18. Count employees per department",
          "ink": "blue"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "SELECT dept_id, COUNT(*) AS n",
            "FROM employees",
            "GROUP BY dept_id",
            "ORDER BY dept_id;",
            "-- one row per dept_id"
          ],
          "note": "Every plain column must be grouped"
        },
        {
          "type": "heading",
          "text": "Q19. Total order amount per customer",
          "ink": "blue"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "SELECT customer_id,",
            "       SUM(amount) AS total",
            "FROM orders",
            "GROUP BY customer_id",
            "ORDER BY total DESC;"
          ],
          "note": "SUM per group, biggest spender first"
        },
        {
          "type": "heading",
          "text": "Q20. Departments with more than 5 staff",
          "ink": "purple"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "SELECT dept_id, COUNT(*) AS n",
            "FROM employees",
            "GROUP BY dept_id",
            "HAVING COUNT(*) > 5;",
            "-- only groups with n >= 6"
          ],
          "note": "HAVING filters groups, WHERE filters rows"
        },
        {
          "type": "callout",
          "style": "takeaway",
          "title": "Key Takeaways",
          "text": "WHERE filters rows before grouping; HAVING filters groups after. Aggregates skip NULLs, except COUNT(*). Every non-aggregated SELECT column goes in GROUP BY."
        },
        {
          "type": "table",
          "headers": [
            "all_rows",
            "has_mgr",
            "no_mgr"
          ],
          "rows": [
            [
              "6",
              "5",
              "1"
            ]
          ],
          "highlightRow": 0
        }
      ],
      "hero": "postgresql",
      "subtitle": "Count, sum, group, filter"
    },
    {
      "page_title": "ROUND, COUNT Variants & HAVING (Q21-22)",
      "blocks": [
        {
          "type": "heading",
          "text": "Q21. Average salary per job title, 2 dp",
          "ink": "blue"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "SELECT job_title,",
            "  ROUND(AVG(salary), 2) AS avg_pay",
            "FROM employees",
            "GROUP BY job_title",
            "ORDER BY avg_pay DESC;"
          ],
          "note": "ROUND(numeric, 2) works on AVG output"
        },
        {
          "type": "heading",
          "text": "Q22. NULL managers: COUNT(*) vs COUNT(col)",
          "ink": "red"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "SELECT COUNT(*) AS all_rows,",
            "  COUNT(manager_id) AS has_mgr,",
            "  COUNT(*) - COUNT(manager_id)",
            "    AS no_mgr",
            "FROM employees;"
          ],
          "note": "COUNT(col) ignores NULLs; COUNT(*) never"
        },
        {
          "type": "heading",
          "text": "Three ways to COUNT",
          "ink": "green"
        },
        {
          "type": "table",
          "headers": [
            "Form",
            "Counts",
            "NULLs"
          ],
          "rows": [
            [
              "COUNT(*)",
              "every row",
              "kept"
            ],
            [
              "COUNT(col)",
              "non-NULL values",
              "skipped"
            ],
            [
              "COUNT(DISTINCT col)",
              "unique values",
              "skipped"
            ]
          ],
          "frame": "dashed"
        },
        {
          "type": "heading",
          "text": "Extra: Count unique job titles",
          "ink": "blue"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "SELECT COUNT(DISTINCT job_title)",
            "  AS titles",
            "FROM employees;",
            "-- one row, one number"
          ],
          "note": "duplicates count once"
        },
        {
          "type": "heading",
          "text": "Extra: Group by two columns",
          "ink": "blue"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "SELECT dept_id, job_title,",
            "  COUNT(*) AS n",
            "FROM employees",
            "GROUP BY dept_id, job_title",
            "ORDER BY dept_id;"
          ],
          "note": "one row per unique pair"
        },
        {
          "type": "heading",
          "text": "Extra: HAVING on an average",
          "ink": "purple"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "SELECT dept_id,",
            "  AVG(salary) AS avg_pay",
            "FROM employees",
            "GROUP BY dept_id",
            "HAVING AVG(salary) > 60000;"
          ],
          "note": "aggregates are illegal in WHERE"
        },
        {
          "type": "bullets",
          "items": [
            "Putting an aggregate in ==WHERE== raises an error",
            "Selecting a column missing from **GROUP BY**",
            "Using `COUNT(col)` when you meant `COUNT(*)`",
            "Forgetting AVG on integers can look truncated"
          ],
          "style": "cross",
          "frame": "dashed",
          "ink": "red"
        },
        {
          "type": "callout",
          "style": "tip",
          "title": "Tip: verify with a spot check",
          "text": "Add `ORDER BY` plus a small `LIMIT` to a GROUP BY query first. Read a few groups by hand before trusting the totals."
        }
      ],
      "hero": "postgresql",
      "subtitle": "Count, sum, group, filter"
    },
    {
      "page_title": "INNER, LEFT & Self Joins (Q23-Q28)",
      "blocks": [
        {
          "type": "paragraph",
          "text": "Tables: `employees(id, name, salary, dept_id, manager_id)`, `departments(id, name)`, `customers(id, name)`, `orders(id, customer_id, emp_id, amount)`, `project_roles(role)`.",
          "frame": "dashed",
          "ink": "green"
        },
        {
          "type": "heading",
          "text": "Q23. Employee with department name (INNER JOIN)"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "SELECT e.name, d.name AS dept",
            "FROM employees e",
            "JOIN departments d",
            "  ON d.id = e.dept_id;"
          ],
          "note": "drops employees with NULL dept_id"
        },
        {
          "type": "heading",
          "text": "Q24. All departments, even empty (LEFT JOIN)"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "SELECT d.name, e.name AS emp",
            "FROM departments d",
            "LEFT JOIN employees e",
            "  ON e.dept_id = d.id;"
          ],
          "note": "empty departments show NULL emp"
        },
        {
          "type": "heading",
          "text": "Q25. Departments with no employees"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "SELECT d.name",
            "FROM departments d",
            "LEFT JOIN employees e",
            "  ON e.dept_id = d.id",
            "WHERE e.id IS NULL;"
          ],
          "note": "test the right table's key, not a nullable column"
        },
        {
          "type": "heading",
          "text": "Q26. Earns more than manager (self join)"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "SELECT e.name",
            "FROM employees e",
            "JOIN employees m",
            "  ON m.id = e.manager_id",
            "WHERE e.salary > m.salary;"
          ],
          "note": "same table twice needs two aliases"
        },
        {
          "type": "heading",
          "text": "Q27. Employee next to manager's name"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "SELECT e.name, m.name AS manager",
            "FROM employees e",
            "LEFT JOIN employees m",
            "  ON m.id = e.manager_id;"
          ],
          "note": "LEFT keeps the boss with no manager"
        },
        {
          "type": "heading",
          "text": "Q28. Customers who never ordered (anti-join)"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "SELECT c.name",
            "FROM customers c",
            "LEFT JOIN orders o",
            "  ON o.customer_id = c.id",
            "WHERE o.id IS NULL;"
          ],
          "note": "keep unmatched rows, filter on NULL"
        },
        {
          "type": "callout",
          "style": "takeaway",
          "title": "Key Takeaways",
          "text": "INNER keeps matches only; LEFT keeps every left row. Anti-join = LEFT JOIN + IS NULL. Self joins need aliases. CROSS JOIN multiplies row counts."
        }
      ],
      "hero": "postgresql",
      "subtitle": "PostgreSQL drills"
    },
    {
      "page_title": "Multi-Table & CROSS Joins (Q29-Q30)",
      "blocks": [
        {
          "type": "heading",
          "text": "Q29. Order total per department (3 tables)"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "SELECT d.name, SUM(o.amount) AS total",
            "FROM orders o",
            "JOIN employees e",
            "  ON e.id = o.emp_id",
            "JOIN departments d",
            "  ON d.id = e.dept_id",
            "GROUP BY d.name;"
          ],
          "note": "chain joins: orders, employees, departments"
        },
        {
          "type": "heading",
          "text": "Q30. Every employee-role pairing (CROSS JOIN)"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "SELECT e.name, r.role",
            "FROM employees e",
            "CROSS JOIN project_roles r;",
            "-- rows = employees x roles"
          ],
          "note": "no ON clause: full Cartesian product"
        },
        {
          "type": "heading",
          "text": "Join types at a glance",
          "ink": "green"
        },
        {
          "type": "table",
          "headers": [
            "Join",
            "Keeps",
            "Unmatched"
          ],
          "rows": [
            [
              "INNER",
              "matches only",
              "dropped"
            ],
            [
              "LEFT",
              "all left rows",
              "NULL right"
            ],
            [
              "CROSS",
              "every pairing",
              "n/a"
            ],
            [
              "Self join",
              "one table twice",
              "per aliases"
            ]
          ],
          "frame": "dashed"
        },
        {
          "type": "heading",
          "text": "Extra: Orders per customer, zeros kept",
          "ink": "blue"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "SELECT c.name, COUNT(o.id) AS n",
            "FROM customers c",
            "LEFT JOIN orders o",
            "  ON o.customer_id = c.id",
            "GROUP BY c.name;"
          ],
          "note": "COUNT(*) would show 1 for zero"
        },
        {
          "type": "heading",
          "text": "Extra: Filter inside ON",
          "ink": "purple"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "SELECT d.name, e.name AS emp",
            "FROM departments d",
            "LEFT JOIN employees e",
            "  ON e.dept_id = d.id",
            "  AND e.salary > 60000;"
          ],
          "note": "ON filter keeps empty departments"
        },
        {
          "type": "heading",
          "text": "Common join mistakes",
          "ink": "red"
        },
        {
          "type": "bullets",
          "items": [
            "Filtering the right table in ==WHERE== turns LEFT into INNER",
            "Joining without **ON** gives a Cartesian product",
            "Joining on a `NULL` key never matches",
            "Selecting `name` from two tables is ambiguous"
          ],
          "style": "cross",
          "frame": "dashed",
          "ink": "red"
        },
        {
          "type": "callout",
          "style": "tip",
          "title": "Tip: check row counts",
          "text": "Run `COUNT(*)` before and after each join. A jump means duplicate matches; a drop means lost rows."
        }
      ],
      "hero": "postgresql",
      "subtitle": "PostgreSQL drills"
    },
    {
      "page_title": "Subqueries (Q31-36)",
      "blocks": [
        {
          "type": "heading",
          "text": "Q31. Earn more than company average",
          "ink": "blue"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "SELECT name, salary",
            "FROM employees",
            "WHERE salary > (",
            "  SELECT AVG(salary) FROM employees",
            "); -- scalar: one value"
          ],
          "note": "scalar subquery must return one value"
        },
        {
          "type": "heading",
          "text": "Q32. Department with top headcount",
          "ink": "blue"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "SELECT name, dept_id",
            "FROM employees",
            "WHERE dept_id = (SELECT dept_id",
            "  FROM employees GROUP BY dept_id",
            "  ORDER BY COUNT(*) DESC LIMIT 1);"
          ],
          "note": "LIMIT 1 hides tied departments"
        },
        {
          "type": "heading",
          "text": "Q33. Departments located in Mumbai",
          "ink": "blue"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "SELECT name",
            "FROM employees",
            "WHERE dept_id IN (",
            "  SELECT dept_id FROM departments",
            "  WHERE location = 'Mumbai');"
          ],
          "note": "IN subquery returns one column"
        },
        {
          "type": "heading",
          "text": "Q34. Customers with an order",
          "ink": "green"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "SELECT c.name",
            "FROM customers c",
            "WHERE EXISTS (",
            "  SELECT 1 FROM orders o",
            "  WHERE o.customer_id = c.customer_id);"
          ],
          "note": "EXISTS stops at the first match"
        },
        {
          "type": "heading",
          "text": "Q35. Customers who never ordered",
          "ink": "green"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "SELECT c.name",
            "FROM customers c",
            "WHERE NOT EXISTS (",
            "  SELECT 1 FROM orders o",
            "  WHERE o.customer_id = c.customer_id);"
          ],
          "note": "NOT EXISTS is NULL-safe, NOT IN is not"
        },
        {
          "type": "heading",
          "text": "Q36. Above own department average",
          "ink": "purple"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "SELECT e.name, e.salary",
            "FROM employees e",
            "WHERE e.salary > (",
            "  SELECT AVG(salary) FROM employees",
            "  WHERE dept_id = e.dept_id);"
          ],
          "note": "re-runs once per outer row"
        },
