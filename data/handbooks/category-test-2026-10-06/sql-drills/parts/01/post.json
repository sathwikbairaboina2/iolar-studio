          "type": "heading",
          "text": "Q1. List all columns",
          "ink": "blue"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "SELECT *",
            "FROM employees;",
            "-- 6 rows, all 4 columns"
          ],
          "note": "avoid * in production queries"
        },
        {
          "type": "heading",
          "text": "Q2. Pick name and salary",
          "ink": "blue"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "SELECT name, salary",
            "FROM employees;",
            "-- 6 rows, 2 columns"
          ],
          "note": "column order follows your SELECT"
        },
        {
          "type": "heading",
          "text": "Q3. Alias salary as monthly_pay",
          "ink": "blue"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "SELECT name,",
            "       salary AS monthly_pay",
            "FROM employees;",
            "-- header now says monthly_pay"
          ],
          "note": "alias is unusable in WHERE"
        },
        {
          "type": "heading",
          "text": "Q4. Compute annual salary",
          "ink": "blue"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "SELECT name,",
            "       salary * 12 AS annual_pay",
            "FROM employees;",
            "-- Asha -> 864000, Zoya -> 1080000"
          ],
          "note": "name the computed column"
        },
        {
          "type": "heading",
          "text": "Q5. Sort high to low",
          "ink": "blue"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "SELECT name, salary",
            "FROM employees",
            "ORDER BY salary DESC;",
            "-- Zoya 90000 first, Kiran last"
          ],
          "note": "DESC puts NULLs first"
        },
        {
          "type": "heading",
          "text": "Q6. Top 5 earners",
          "ink": "blue"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "SELECT name, salary",
            "FROM employees",
            "ORDER BY salary DESC",
            "LIMIT 5;"
          ],
          "note": "sort first, then LIMIT cuts"
