        {
          "type": "heading",
          "text": "Q46. Management chain with WITH RECURSIVE",
          "ink": "red"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "WITH RECURSIVE c AS (",
            "  SELECT * FROM employees",
            "  WHERE id = 7",
            "  UNION ALL",
            "  SELECT e.* FROM employees e",
            "  JOIN c ON e.id = c.manager_id)",
            "SELECT id, name FROM c;"
          ],
          "note": "stops when manager_id is NULL"
        },
