          "type": "code",
          "lang": "sql",
          "lines": [
            "WITH r AS (",
            "  SELECT *, ROW_NUMBER() OVER (",
            "    PARTITION BY dept_id",
            "    ORDER BY salary DESC) AS rn",
            "  FROM employees)",
            "SELECT * FROM r WHERE rn = 1;"
          ],
          "note": "ties: add a tiebreaker to ORDER BY"
