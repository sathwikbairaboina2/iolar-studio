          "type": "heading",
          "text": "Q47. Numbers 1 to 10 recursively",
          "ink": "green"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "WITH RECURSIVE n(x) AS (",
            "  SELECT 1",
            "  UNION ALL",
            "  SELECT x + 1 FROM n WHERE x < 10)",
            "SELECT x FROM n; -- 1,2,...,10"
          ],
          "note": "no WHERE x < 10 means endless loop"
        },
