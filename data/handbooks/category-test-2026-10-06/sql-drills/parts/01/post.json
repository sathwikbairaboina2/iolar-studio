      "page_title": "CTEs: WITH Queries (Q43-Q48)",
      "blocks": [
        {
          "type": "heading",
          "text": "Q43. Average-salary subquery as a WITH clause",
          "ink": "green"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "WITH avg_sal AS (",
            "  SELECT AVG(salary) AS a",
            "  FROM employees)",
            "SELECT e.name, e.salary",
            "FROM employees e, avg_sal",
            "WHERE e.salary > avg_sal.a;"
          ],
          "note": "the CTE runs once, reads like a name"
        },
        {
          "type": "heading",
          "text": "Q44. Chain two CTEs: totals, then above average",
          "ink": "blue"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "WITH dept(d, t) AS (",
            "  SELECT dept_id, SUM(salary)",
            "  FROM employees GROUP BY 1),",
            "big AS (SELECT AVG(t) a FROM dept)",
            "SELECT d, t FROM dept, big",
            "WHERE t > a;"
          ],
          "note": "later CTEs can read earlier ones"
        },
        {
          "type": "table",
          "headers": [
            "d",
            "t"
