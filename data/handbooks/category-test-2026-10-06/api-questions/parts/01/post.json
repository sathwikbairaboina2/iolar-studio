    {
      "page_title": "Pagination, Filtering, Rate Limits",
      "blocks": [
        {
          "type": "heading",
          "text": "☆ Q21. Offset vs cursor pagination?",
          "ink": "blue"
        },
        {
          "type": "paragraph",
          "text": "==Offset== jumps by position (`page=3`); ==cursor== resumes after the last item seen (`after=abc`).",
          "frame": "dashed",
          "ink": "green"
        },
        {
          "type": "table",
          "headers": [
            "",
            "Offset",
            "Cursor"
          ],
          "rows": [
            [
              "Jump to page N",
              "yes",
              "no"
            ],
            [
              "Deep pages",
              "slow",
              "fast"
            ],
            [
              "Live inserts",
              "skips/dupes",
              "stable"
            ],
            [
              "Total count",
              "easy",
              "costly"
            ]
          ],
          "frame": "dashed"
        },
        {
          "type": "heading",
          "text": "☆ Q22. Why is offset slow and inconsistent?",
          "ink": "red"
        },
        {
          "type": "bullets",
          "items": [
            "DB must **scan and discard** all skipped rows",
            "`OFFSET 1000000` reads a million rows first",
            "Insert on page 1 shifts rows: duplicates",
            "Delete on page 1 shifts rows: skipped items"
          ],
          "style": "cross",
          "frame": "dashed",
          "ink": "red"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "-- offset: O(offset + limit)",
            "SELECT * FROM posts",
            "ORDER BY id LIMIT 20 OFFSET 1000000;",
            "-- keyset: uses the index",
            "WHERE id > 8421 ORDER BY id LIMIT 20;"
          ],
          "note": "cursor = indexed WHERE, no skipping"
        },
        {
          "type": "heading",
          "text": "☆ Q23. Filtering, sorting, fields?",
          "ink": "purple"
        },
        {
          "type": "code",
          "lang": "http",
          "lines": [
            "GET /orders?status=paid",
            "  &created_gte=2026-01-01",
            "  &sort=-created_at,total",
            "  &fields=id,total,status",
            "  &limit=20&after=eyJpZCI6OH0"
          ],
          "note": "whitelist fields; index sort columns"
        },
        {
          "type": "bullets",
          "items": [
            "Filter by **query params**, one per field",
            "`sort=-field` means descending order",
            "`fields=` trims payload size",
            "Whitelist columns: block injection and slow scans"
          ],
          "style": "dot",
          "frame": "dashed",
          "ink": "purple"
        },
        {
          "type": "heading",
          "text": "☆ Q24. Token bucket vs sliding window?",
          "ink": "blue"
        },
        {
          "type": "diagram",
          "kind": "flow",
          "spec": {
            "nodes": [
              {
                "text": "Refill",
                "sub": "r tokens/sec",
                "ink": "green"
              },
              {
                "text": "Bucket",
                "sub": "cap = burst",
                "ink": "blue"
              },
              {
                "text": "Request",
                "sub": "takes 1 token",
                "ink": "orange"
              },
              {
                "text": "Empty?",
                "sub": "reject 429",
                "ink": "red"
              }
            ]
          }
        }
      ],
      "hero": "apigateway",
      "subtitle": "Interview Q21-Q25"
