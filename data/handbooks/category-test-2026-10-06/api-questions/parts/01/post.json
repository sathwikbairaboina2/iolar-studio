            "  \"data\": [ ... ],",
            "  \"next_cursor\": \"eyJpZCI6ODQyMX0\",",
            "  \"has_more\": true",
            "}"
          ],
          "note": "cursor is opaque, never parsed"
        },
        {
          "type": "heading",
          "text": "What to rate limit by",
          "ink": "blue"
        },
        {
          "type": "table",
          "headers": [
            "Key",
            "Fits",
            "Catch"
          ],
          "rows": [
            [
              "IP address",
              "public endpoints",
              "NAT shares one IP"
            ],
            [
              "API key",
              "paid tiers",
              "key can leak"
            ],
            [
              "User ID",
              "logged-in apps",
              "needs auth first"
            ],
            [
              "Endpoint",
              "costly routes",
              "tune per route"
            ]
          ],
          "highlightRow": 1,
          "frame": "dashed"
        },
        {
          "type": "heading",
          "text": "Client backoff with jitter",
          "ink": "green"
        },
        {
          "type": "bullets",
          "items": [
            "Wait `Retry-After` when the header is sent",
            "Else double the delay each try: 1s, 2s, 4s",
            "Add random **jitter** so clients desync",
            "Cap retries, then surface the error"
          ],
          "style": "number",
          "frame": "dashed",
          "ink": "green"
        },
        {
          "type": "heading",
          "text": "Pagination mistakes",
          "ink": "red"
