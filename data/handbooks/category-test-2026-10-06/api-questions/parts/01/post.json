    {
      "page_title": "Rate Limit Algorithms and Client Backoff",
      "blocks": [
        {
          "type": "table",
          "headers": [
            "Algorithm",
            "Behaviour",
            "Cost"
          ],
          "rows": [
            [
              "Token bucket",
              "allows bursts, steady avg",
              "2 values"
            ],
            [
              "Sliding log",
              "exact, last N secs",
              "O(requests)"
            ],
            [
              "Sliding counter",
              "weighted 2 windows",
              "O(1)"
            ],
            [
              "Fixed window",
              "edge burst 2x",
              "O(1)"
            ]
          ],
          "highlightRow": 0,
          "frame": "dashed"
        },
        {
          "type": "callout",
          "style": "sticky",
          "title": "Say it in the interview",
          "text": "Cursor for feeds, offset for admin. Send 429 plus Retry-After; clients back off with jitter."
        },
        {
          "type": "heading",
          "text": "☆ Q25. Telling clients they're limited",
          "ink": "green"
        },
        {
          "type": "code",
          "lang": "http",
          "lines": [
            "HTTP/1.1 429 Too Many Requests",
            "Retry-After: 30",
            "RateLimit-Limit: 100",
            "RateLimit-Remaining: 0",
            "RateLimit-Reset: 30"
          ],
          "note": "Retry-After in seconds or date"
        },
        {
          "type": "heading",
          "text": "Cursor response shape",
          "ink": "purple"
        },
        {
          "type": "code",
          "lang": "json",
          "lines": [
