          ],
          "rows": [
            [
              "500",
              "unhandled bug",
              "maybe"
            ],
            [
              "502",
              "bad upstream reply",
              "yes"
            ],
            [
              "503",
              "overloaded or down",
              "after wait"
            ],
            [
              "504",
