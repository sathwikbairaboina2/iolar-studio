              "Hash",
              "even spread",
              "bad range scans"
            ],
            [
              "Range",
              "easy ranges",
              "hot shard risk"
            ],
            [
              "Directory lookup",
              "flexible",
              "extra hop"
            ],
            [
              "Consistent hashing",
              "new node moves ~1/N keys",
              "more moving parts"
            ]
          ],
          "frame": "dashed"
        },
        {
          "type": "heading",
          "text": "Benefits",
          "ink": "green"
        },
        {
          "type": "bullets",
          "items": [
            "Writes and storage scale ==roughly linearly== by adding shards",
            "A failure or load spike stays contained to one shard"
          ],
          "style": "check",
          "ink": "green"
        },
        {
          "type": "heading",
          "text": "Things to consider",
          "ink": "red"
        },
        {
          "type": "bullets",
          "items": [
