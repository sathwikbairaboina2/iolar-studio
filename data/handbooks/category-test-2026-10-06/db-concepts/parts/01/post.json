                "shape": "icon",
                "icon": "postgresql"
              }
            },
            "edges": [
              {
                "from": "app",
                "to": "primary",
                "label": "writes"
              },
              {
                "from": "primary",
                "to": "r1",
                "label": "WAL"
              },
              {
                "from": "primary",
                "to": "r2",
                "label": "WAL"
              }
            ]
          }
        },
        {
          "type": "bullets",
          "items": [
            "App ==writes== go to the primary only",
            "Primary ships WAL records to the 2 replicas",
            "Reads are load-balanced across the replicas",
            "Primary dies: a replica is **promoted**"
          ],
          "style": "number"
        },
        {
          "type": "table",
          "headers": [
            "Mode",
            "Commit waits for",
            "Data loss",
            "Latency"
          ],
          "rows": [
            [
              "==Sync==",
              "replica ack",
              "none",
              "higher"
            ],
            [
              "==Async==",
              "nothing",
              "last few txns",
              "low"
            ]
          ],
          "frame": "dashed"
        },
        {
          "type": "table",
          "headers": [
            "Topology",
            "Writes go to",
            "Catch"
          ],
          "rows": [
            [
              "Single-leader",
              "one primary",
              "most common"
            ],
            [
              "Multi-leader",
              "one per region",
              "conflict resolution"
            ],
            [
              "Leaderless (Dynamo)",
              "any node",
              "quorum R+W>N"
            ]
          ],
          "highlightRow": 0
        },
        {
          "type": "sidebox",
          "title": "Benefits",
          "items": [
            "✓ **High availability**: failover in seconds to minutes",
            "✓ **Read throughput** scales by adding replicas"
          ],
          "ink": "green"
        },
        {
          "type": "sidebox",
          "title": "Things to consider",
          "items": [
            "⚠ **Lag**: user writes, reads a stale replica, misses it",
            "⚠ Fix: ==read-your-writes==, route that user to primary briefly",
            "⚠ Replicas scale reads only: writes and data size stay bounded by one primary"
          ],
          "ink": "red"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "SELECT pg_is_in_recovery();",
            "-- true: this node is a replica",
            "SELECT now() -",
            "  pg_last_xact_replay_timestamp();",
            "-- replica lag, e.g. 00:00:02"
          ],
          "note": "Run on the replica, not primary"
        },
        {
          "type": "callout",
          "style": "tip",
          "title": "Tip",
          "text": "Alert on replica lag: a stale replica is worse than a slower read from the primary."
        },
        {
          "type": "callout",
          "style": "takeaway",
          "title": "INTERVIEW TAKEAWAY",
          "text": "Replication gives availability and read scale, but trades consistency for lag. It does not fix write scaling: that is what sharding is for."
        }
      ],
      "hero": "postgresql",
      "subtitle": "Copies for scale"
