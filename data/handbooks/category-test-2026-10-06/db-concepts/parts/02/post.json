          "type": "heading",
          "text": "RESHARDING",
          "ink": "orange"
        },
        {
          "type": "bullets",
          "items": [
            "Naive `hash % N` remaps **most** keys when N changes",
            "Consistent hashing moves only ~1/N of the keys",
            "Copy data to the new shard in the background",
            "Flip the router last, then delete the old copy"
          ],
          "style": "number",
          "frame": "dashed",
          "ink": "orange"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "-- user_id in every query: 1 shard",
            "SELECT * FROM orders",
            "WHERE user_id = 1001;",
            "-- no user_id: scatter to all 4",
            "SELECT * FROM orders WHERE total > 99;"
          ],
          "note": "No shard key means fan-out"
        },
        {
          "type": "callout",
          "style": "tip",
          "title": "Exhaust first",
          "text": "Try indexes, caching, replicas and partitioning before you shard."
