              "Setup",
              "Built into Docker",
              "Separate install"
            ],
            [
              "Unit",
              "Service",
              "Pod, Deployment"
            ],
            [
              "Scaling",
              "Replicas",
              "Autoscaling"
            ],
            [
              "Ecosystem",
              "Small",
              "Far larger"
            ]
          ],
          "frame": "dashed"
        },
        {
          "type": "heading",
          "text": "4. Healthcheck in Compose",
          "ink": "purple"
        },
        {
          "type": "code",
          "lang": "yaml",
          "lines": [
            "services:",
            "  db:",
            "    healthcheck:",
            "      test: [\"CMD\",\"pg_isready\"]",
            "      interval: 10s",
            "      retries: 5",
            "    stop_grace_period: 30s"
          ],
          "note": "start_period covers slow boots"
        },
        {
          "type": "heading",
          "text": "5. Limits Keep Hosts Alive",
          "ink": "green"
        },
        {
          "type": "bullets",
          "items": [
            "`--memory` caps RAM; going over means an ==OOM kill==, exit 137",
            "`--cpus` caps CPU time; the process slows, never dies",
            "Reservations guarantee a minimum share per container",
            "Set both so one noisy container cannot starve the rest"
          ],
          "style": "check",
          "frame": "dashed",
          "ink": "green"
        },
        {
          "type": "heading",
          "text": "6. Host-Wide Log Rotation",
          "ink": "blue"
        },
        {
          "type": "code",
          "lang": "json",
          "lines": [
            "{\"log-driver\": \"json-file\",",
            "  \"log-opts\": {",
            "    \"max-size\": \"10m\",",
            "    \"max-file\": \"3\"}}"
          ],
          "note": "daemon.json sets the default for all"
        },
        {
          "type": "bullets",
          "items": [
            "Edit `/etc/docker/daemon.json`, then restart the daemon",
            "Applies only to ==newly created== containers, not old ones",
            "Per-container `--log-opt` flags override the host default"
          ],
          "style": "dot",
          "frame": "dashed",
          "ink": "blue"
        },
        {
          "type": "callout",
          "style": "tip",
          "title": "Pick the Lightest Tool",
          "text": "Start with Compose on one host; move to an orchestrator only when one host stops being enough."
