          "title": "Fargate vs EC2 and IAM Roles",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Fargate or EC2",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "{blue:Fargate} is serverless: pay per ==vCPU and GB per second==",
                "No instances to patch",
                "{orange:EC2 launch type}: you manage the container instance fleet",
                "Capacity comes from your ==ASG capacity provider=="
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "",
                "Fargate",
                "EC2"
              ],
              "rows": [
                [
                  "Best for",
                  "Most web services, batch work",
                  "GPUs, daemon tasks"
                ],
                [
                  "Scale",
                  "Any size, no hosts",
                  "Very large steady workloads"
                ],
                [
                  "Cost",
                  "Per second",
                  "Cheaper Spot or Reserved"
                ]
              ],
              "highlightRow": 0
            },
            {
              "type": "heading",
              "text": "2. Execution role vs task role",
              "ink": "green"
            },
            {
              "type": "table",
              "headers": [
                "",
                "Execution role",
                "Task role"
              ],
              "rows": [
                [
                  "Used by",
                  "ECS itself",
                  "Your app code"
                ],
                [
                  "Does",
                  "Pulls ECR image, fetches secrets, writes CloudWatch logs",
                  "Calls S3, DynamoDB, other AWS APIs"
                ],
                [
                  "Field",
                  "`executionRoleArn`",
                  "`taskRoleArn`"
                ]
              ]
            },
            {
              "type": "bullets",
              "items": [
                "Execution role trust principal: `ecs-tasks.amazonaws.com`",
                "App assumes the task role via the ==credentials endpoint==",
                "Grant ==least privilege== on the task role"
              ],
              "style": "check",
              "ink": "green"
            },
            {
              "type": "heading",
              "text": "3. Common mistakes",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "S3 permissions on the execution role: app gets {red:AccessDenied}",
                "ECR pull permission on the task role: task {red:fails to start}"
              ],
              "style": "cross",
              "frame": "dashed",
              "ink": "red"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Remember",
              "text": "==Execution role== = ECS's job before the app starts. **Task role** = the app's job once it runs."
            }
          ]
        }
      ]
