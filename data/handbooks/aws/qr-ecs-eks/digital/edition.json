    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "Every revision uses `:latest`. A bad image is pushed, you roll back to the previous revision, and it is still broken. Why?",
              "a_bullets": [
                "Answer: `:latest` now points to the broken image, so the old revision pulls it too.",
                "Fix: tag by git SHA, so each revision points to a distinct image."
              ]
            },
            {
              "type": "qa",
              "q": "A Fargate task never starts. What do you check?",
              "a_bullets": [
                "Answer: network path to ECR (private subnet needs NAT or VPC endpoints).",
                "Execution role needs ECR pull permission.",
                "The `awslogs-group` log group must exist."
              ]
            },
            {
              "type": "qa",
              "q": "The app gets S3 AccessDenied, though the execution role allows S3. What is the bug?",
              "a_bullets": [
                "Answer: app code uses the task role, not the execution role.",
                "Grant S3 on the task role, least privilege."
              ]
            }
          ]
        }
      ]
    }
  ]
