          "title": "ECR and ECS Mental Model",
          "blocks": [
            {
              "type": "heading",
              "text": "1. ECR Registry",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "==ECR== is a **private** registry, one per ==region==",
                "URI: `<account>.dkr.ecr.<region>.amazonaws.com/<repo>:<tag>`"
              ],
              "style": "dot"
            },
            {
              "type": "code",
              "lang": "text",
              "lines": [
                "123456789012.dkr.ecr.us-east-1.amazonaws.com/web:3f9c2ab"
              ]
            },
            {
              "type": "heading",
              "text": "2. ECS Hierarchy",
              "ink": "green"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "Cluster",
                    "sub": "holds services",
                    "ink": "blue"
                  },
                  {
                    "text": "Service",
                    "sub": "keeps N tasks",
                    "ink": "green"
                  },
                  {
                    "type": "x",
                    "text": "Task",
                    "sub": "running instance",
                    "ink": "purple"
                  },
                  {
                    "text": "Task definition",
                    "sub": "the blueprint",
                    "ink": "orange"
                  }
                ]
              }
            },
            {
              "type": "bullets",
              "items": [
                "Task definition: versioned, ==immutable== JSON, named `family:revision`",
                "Any change creates a ==new revision==",
                "Containers in a task share one **network namespace** and lifecycle"
              ],
              "style": "dot",
              "ink": "green"
            },
            {
              "type": "table",
              "headers": [
                "Choice",
                "When"
              ],
              "rows": [
                [
                  "One task",
                  "Tightly coupled containers"
                ],
                [
                  "Separate tasks",
                  "Everything else"
                ]
              ]
            },
            {
              "type": "heading",
              "text": "3. Mistake: :latest",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "Revision stores only the tag",
                "`:latest` moves to the new image",
                "ECS resolves the tag at task start",
                "Old revision pulls the new broken image: no rollback"
              ],
              "style": "cross",
              "ink": "red"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Fix",
              "text": "Tag by ==git SHA== and enable ==tag immutability==."
            }
          ]
        }
      ]
    },
    {
      "title": "Task Definitions and Services",
      "role": "outline",
      "outlineIndex": 2,
      "pages": [
        {
          "title": "Task Definitions and Services",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Task Definition",
              "ink": "green"
            },
            {
              "type": "table",
              "headers": [
                "Field",
                "Holds"
              ],
              "rows": [
                [
                  "`family`",
                  "name; each change is a new revision"
                ],
                [
                  "`cpu`, `memory`",
                  "set at task level"
                ],
                [
                  "`networkMode`",
                  "`awsvpc` for Fargate"
                ],
                [
                  "`containerDefinitions`",
                  "the containers"
                ],
                [
                  "`taskRoleArn`",
                  "app's AWS API calls"
                ],
                [
                  "`executionRoleArn`",
                  "pull image, secrets, logs"
                ]
              ]
            },
            {
              "type": "bullets",
              "items": [
                "`image`, `portMappings`, `environment`",
                "`secrets` come from SSM or Secrets Manager",
                "`logConfiguration` sends logs to CloudWatch",
                "==essential== container exits: the whole task stops"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "heading",
              "text": "2. Service and Scaling",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "`desiredCount` = tasks the service keeps running",
                "Rolling update: `minimumHealthyPercent` and `maxPercent`",
                "==Circuit breaker== stops a failing deploy and rolls back",
                "`--task-definition fam:rev` points the service at a revision",
                "`--force-new-deployment` alone only restarts the current one"
              ],
              "style": "dot",
              "ink": "blue"
            },
            {
              "type": "code",
              "lang": "bash",
              "lines": [
                "aws ecs update-service --cluster app \\",
                "  --service web --task-definition web:7"
              ],
              "note": "roll out a new revision"
            },
            {
              "type": "bullets",
              "items": [
                "Application Auto Scaling, ==target tracking== on:",
                "{blue:CPU}, {green:memory} or ALB `RequestCountPerTarget`"
              ],
              "style": "check"
            },
            {
              "type": "heading",
              "text": "3. Mistake",
              "ink": "red"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "CannotPullContainerError",
              "text": "Task stuck in PROVISIONING or STOPPED: no route to ECR (private subnet without ==NAT or VPC endpoints==) or the execution role lacks permission."
            }
          ]
        }
      ]
    },
    {
      "title": "Fargate vs EC2 and IAM Roles",
      "role": "outline",
