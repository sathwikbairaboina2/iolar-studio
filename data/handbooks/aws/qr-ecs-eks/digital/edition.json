          "blocks": [
            {
              "type": "heading",
              "text": "1. Deploy Flow",
              "ink": "green"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "Build image",
                    "ink": "blue"
                  },
                  {
                    "text": "Push to ECR",
                    "ink": "blue"
                  },
                  {
                    "text": "New revision",
                    "sub": "register",
                    "ink": "purple"
                  },
                  {
                    "text": "Update service",
