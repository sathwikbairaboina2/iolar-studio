    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "An RDS Multi-AZ instance has slow reports. You expect the standby in the other AZ to share the read load. Will it?",
              "a_bullets": [
                "No: the {blue:standby} serves ==no reads==; it only waits for failover.",
                "Add a ==read replica== for reads (async, so results may lag)."
              ]
            },
            {
              "type": "qa",
              "q": "A bad DELETE ran 10 minutes ago. Automated backups are on. What do you do, and what happens to the endpoint?",
              "a_bullets": [
                "Run a ==point-in-time restore== to just before the DELETE.",
                "It creates a ==new instance== with a new endpoint, so repoint the app. The old one is untouched."
              ]
            },
            {
              "type": "qa",
              "q": "How many RCUs for 100 strongly consistent reads per second of 8 KB items?",
              "a_bullets": [
                "8 KB is ==2 units== of 4 KB, so 100 × 2 = ==200 RCU==.",
                "Eventually consistent would need only 100."
              ]
            }
          ]
        }
      ]
