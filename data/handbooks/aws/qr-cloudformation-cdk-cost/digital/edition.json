    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "The first create of a stack failed, leaving it in ROLLBACK_COMPLETE. You fix the template and run an update. What happens?",
              "a_bullets": [
                "The update is rejected: this state allows delete only.",
                "Delete the stack, then create it again."
              ]
            },
            {
              "type": "qa",
              "q": "You rename a Bucket construct ID in CDK and deploy. What happens to the bucket?",
              "a_bullets": [
                "The new ID gives a new logical ID, so CDK creates a new bucket.",
                "The old bucket is deleted only if its removal policy is DESTROY. The L2 default is RETAIN, so it stays behind as an orphan.",
                "Run `cdk diff` first to see the change."
              ]
            },
            {
              "type": "qa",
              "q": "Private-subnet jobs read terabytes from S3 through a NAT Gateway, and the bill is high. What is the fix?",
              "a_bullets": [
                "NAT charges hourly plus per GB processed.",
                "Add a free S3 gateway endpoint so that traffic skips the NAT."
              ]
            }
          ]
        }
      ]
