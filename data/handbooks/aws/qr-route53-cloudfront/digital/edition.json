                "  --distribution-id E123 \\",
                "  --paths \"/index.html\" \"/img/*\""
              ],
              "note": "invalidate only when the URL cannot change"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "OAC bucket policy",
