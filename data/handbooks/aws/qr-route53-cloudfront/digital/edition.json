    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "A teammate creates `example.com` as a CNAME to `d111abcdef8.cloudfront.net`. What goes wrong, and what is the fix?",
              "a_bullets": [
                "A CNAME is not allowed at the ==zone apex==.",
                "Use an ==A alias== record to the distribution. It is free and works at the apex."
              ]
            },
            {
              "type": "qa",
              "q": "Weighted records: A=200, B=50, C=0. What share of answers does each get?",
              "a_bullets": [
                "A 80%, B 20%, C 0%, because share is weight / sum (250).",
                "Weight ==0== stops traffic to that record."
              ]
            },
            {
              "type": "qa",
              "q": "A private bucket uses OAC, but the origin is the S3 website endpoint. What happens?",
              "a_bullets": [
                "Requests fail with 403, because the website endpoint does not support OAC.",
                "Use the ==REST endpoint== origin, with a bucket policy on `AWS:SourceArn`."
              ]
            }
          ]
        }
      ]
