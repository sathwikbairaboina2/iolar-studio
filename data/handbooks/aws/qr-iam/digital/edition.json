          "blocks": [
            {
              "type": "heading",
              "text": "1. What IAM Is",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "==IAM== is global: decides **who** (authN) can do **what** on which resource (authZ)",
                "Principals: {blue:users}, {green:roles}, {red:root}",
                "A ==group== only holds users: attach policies to it",
                "A group cannot nest groups or be a principal"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "heading",
              "text": "2. User vs Role",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "",
                "User",
                "Role"
              ],
              "rows": [
                [
                  "Credentials",
                  "permanent password / keys",
                  "**none** of its own"
                ],
                [
                  "Gets access",
                  "signs in",
                  "assumed via ==STS=="
                ],
                [
                  "Lifetime",
                  "long-lived",
                  "1 h default, 12 h max"
                ]
              ],
              "frame": "dashed"
            },
            {
              "type": "heading",
              "text": "3. EC2 Instance Profile",
              "ink": "purple"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "App on EC2",
                    "ink": "blue"
                  },
                  {
                    "text": "Instance profile",
                    "sub": "wraps role",
                    "ink": "purple"
                  },
                  {
                    "text": "STS",
                    "ink": "orange"
                  },
                  {
                    "text": "Temp keys",
                    "sub": "rotate",
                    "ink": "green"
                  }
                ]
              }
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Instance profile",
              "text": "Wraps a role: rotating credentials, ==no keys on disk=="
            },
            {
              "type": "heading",
              "text": "4. Interview Point",
              "ink": "orange"
            },
            {
              "type": "bullets",
              "items": [
                "**Group as principal?** No, it only carries policies for its users",
                "**User vs role?** User has permanent credentials; role has none",
                "**Role credentials?** Assumed via STS: temporary, 1 h default, 12 h max",
                "**Who can assume a role?** Principals named in its trust policy"
              ],
              "style": "dot"
            }
          ]
        }
      ]
    },
    {
      "title": "Policies, Least Privilege and Evaluation Logic",
      "role": "outline",
      "outlineIndex": 2,
      "pages": [
        {
          "title": "Policies, Least Privilege and Evaluation Logic",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Policies and evaluation",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "==Policy== = JSON of statements: `Effect`, `Action`, `Resource`, optional `Condition`",
                "==Least privilege== = only the actions and resources a task needs"
              ],
              "style": "dot",
              "ink": "green"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "Implicit deny",
                    "sub": "the default",
                    "ink": "black"
                  },
                  {
                    "text": "Explicit Deny?",
                    "sub": "wins, stop",
                    "ink": "red"
                  },
                  {
                    "text": "Allow?",
                    "sub": "needed to pass",
                    "ink": "green"
                  }
                ]
              }
            },
            {
              "type": "heading",
              "text": "2. Policy types",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "Type",
                "Attached to",
                "Grants?"
              ],
              "rows": [
                [
                  "Identity-based",
                  "user, group, role",
                  "{green:yes}"
                ],
                [
                  "Resource-based",
                  "bucket, role trust policy; names a `Principal`",
                  "{green:yes}"
                ],
                [
                  "Permission boundary",
                  "user or role",
                  "{red:no}, max only"
                ],
                [
                  "SCP",
                  "account or OU",
                  "{red:no}, max only"
                ]
              ]
            },
            {
              "type": "heading",
              "text": "3. Deny beats Allow",
              "ink": "red"
            },
            {
              "type": "code",
              "lang": "json",
              "lines": [
                "{\"Effect\": \"Allow\", \"Action\": \"s3:GetObject\",",
                "  \"Resource\": \"arn:aws:s3:::bucket/*\"}",
                "{\"Effect\": \"Deny\", \"Action\": \"s3:*\",",
                "  \"Resource\": \"arn:aws:s3:::bucket/*\",",
                "  \"Condition\": {\"BoolIfExists\": {",
                "    \"aws:MultiFactorAuthPresent\": \"false\"}}}"
              ],
              "note": "Deny wins even though the Allow matches"
            },
            {
              "type": "bullets",
              "items": [
                "Deny on `aws:SourceIp` or MFA false blocks access even if another policy allows it"
              ],
              "style": "check"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Remember",
              "text": "Default is ==implicit deny==. An Allow never overrides an **explicit Deny**."
            },
            {
              "type": "bullets",
              "items": [
                "**No matching policy?** Implicit deny",
                "**Allow over explicit Deny?** Never",
                "**SCP or boundary vs identity policy?** Limit only, never grant",
                "**Real permissions used?** Access Analyzer, last accessed data"
              ],
              "style": "dot",
              "frame": "dashed"
            }
          ]
        }
      ]
    },
    {
      "title": "MFA, Root Account and Access Keys vs Roles",
      "role": "outline",
      "outlineIndex": 3,
      "pages": [
        {
          "title": "MFA, Root Account and Access Keys vs Roles",
          "blocks": [
            {
              "type": "heading",
              "text": "1. What They Are",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "==MFA== = second factor on top of the password",
                "Types: virtual TOTP app, FIDO2 key, hardware token",
                "==Root== = all-powerful email identity made with the account"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "blue"
            },
            {
              "type": "heading",
              "text": "2. Locking Down Root",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "Root gets ==MFA==",
                "Root gets {red:no access keys}",
                "Root-only: change root email or password, close account, restore locked-out IAM admin",
                "Daily work: IAM user or ==IAM Identity Center=="
              ],
              "style": "check",
              "ink": "red"
            },
            {
              "type": "heading",
              "text": "3. Keys vs Roles",
              "ink": "purple"
            },
            {
              "type": "table",
              "headers": [
                "",
                "Access key",
                "Role"
              ],
              "rows": [
                [
                  "Prefix",
                  "`AKIA...`",
                  "`ASIA...` + session token"
                ],
                [
                  "Lifetime",
                  "{red:long-lived}",
                  "{green:temporary}, auto-expires"
                ],
                [
                  "Leaks via",
                  "code, git",
                  "little to leak"
                ],
                [
                  "Use for",
                  "local CLI only",
                  "EC2, Lambda, CI"
                ]
              ],
              "highlightRow": 3
            },
            {
              "type": "heading",
              "text": "4. Example: Enforce MFA",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "==Deny== all but MFA setup when `aws:MultiFactorAuthPresent` is false",
                "`DeactivateMFADevice` stays denied"
              ],
              "style": "dot"
            },
            {
              "type": "code",
              "lang": "json",
              "lines": [
                "\"Effect\": \"Deny\",",
                "\"NotAction\": [\"iam:CreateVirtualMFADevice\",",
                "  \"iam:EnableMFADevice\", \"iam:ListMFADevices\",",
                "  \"iam:ListVirtualMFADevices\", \"iam:ResyncMFADevice\",",
                "  \"iam:GetUser\", \"sts:GetSessionToken\"],",
                "\"Condition\": {\"BoolIfExists\":",
                "  {\"aws:MultiFactorAuthPresent\": \"false\"}}"
              ]
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Keys hygiene",
              "text": "Rotate or ==delete== any access key unused for **90 days**."
            }
          ]
        }
      ]
