          "title": "AWS IAM Cheat Sheet",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Evaluation Order",
              "ink": "red"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "Implicit deny",
                    "sub": "the default",
                    "ink": "black"
                  },
                  {
                    "text": "Explicit Deny",
                    "sub": "wins, stop",
                    "ink": "red"
                  },
                  {
                    "text": "Allow",
                    "sub": "needed to pass",
                    "ink": "green"
                  }
                ]
              }
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Remember",
              "text": "==Deny always beats Allow==, in every policy."
            },
            {
              "type": "heading",
              "text": "2. Identities and Root",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "",
                "Holds",
                "Credentials"
              ],
              "rows": [
                [
                  "Group",
                  "**users only**; policies attach here",
                  "none"
                ],
                [
                  "User",
                  "one person or app",
                  "long-lived"
                ],
                [
                  "Role",
                  "assumed by others",
                  "{green:temporary}"
                ]
              ]
            },
            {
              "type": "bullets",
              "items": [
                "Root: enable ==MFA== and delete its keys",
                "Root only for root-only tasks: change email, close account, unlock admin",
