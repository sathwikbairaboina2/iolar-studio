    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "A group policy allows `s3:*` on everything. Another policy on the same user denies `s3:DeleteObject`. Can the user delete an object?",
              "a_bullets": [
                "No. An explicit Deny beats every Allow.",
                "Evaluation: implicit deny, then explicit Deny wins, else Allow."
              ]
            },
            {
              "type": "qa",
              "q": "A role has a policy allowing S3 read, yet EC2 gets AccessDenied on `sts:AssumeRole`. What is missing?",
              "a_bullets": [
                "The trust policy must name `ec2.amazonaws.com` as Principal.",
                "Permissions policy = what the role can do. Trust policy = who can assume it."
              ]
            },
            {
              "type": "qa",
              "q": "You attached admin rights to user dev, but the CLI still says AccessDenied. First command to run?",
              "a_bullets": [
                "`aws sts get-caller-identity`",
                "The CLI may be using a different principal, such as old keys or an assumed role."
              ]
            }
          ]
        }
      ]
    }
