    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "The subnet route table has `0.0.0.0/0 -> igw-xxx` and the SG allows 443, yet the instance cannot reach the internet. Why?",
              "a_bullets": [
                "It has no public or Elastic IP; an IGW route alone is not enough.",
                "Attach an {green:Elastic IP}."
              ]
            },
            {
              "type": "qa",
              "q": "A custom NACL allows inbound 443 and outbound 443 only. The SG is open. Why do clients time out?",
              "a_bullets": [
                "NACLs are {red:stateless}: replies leave on the client's ephemeral port.",
                "Allow outbound ==1024-65535==."
              ]
            },
            {
              "type": "qa",
              "q": "A private instance routes `0.0.0.0/0` to a zonal NAT gateway, but the NAT gateway sits in a private subnet. What happens?",
              "a_bullets": [
                "Still no internet: the NAT gateway has no IGW route.",
                "Place it in a {blue:public subnet} with an Elastic IP."
              ]
            }
          ]
        }
