    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "You create a metric filter for ERROR today, but yesterday's 40 ERROR lines never show in the metric. Why, and what now?",
              "a_bullets": [
                "Answer: a metric filter only counts events ingested after it was created.",
                "Fix: run Logs Insights over yesterday: `filter @message like /ERROR/ | stats count() by bin(5m)`."
              ]
            },
            {
              "type": "qa",
              "q": "An alarm needs 3 of 5 datapoints breaching. The last 5 are: breach, OK, breach, OK, breach. State?",
              "a_bullets": [
                "Answer: ALARM, 3 of the last 5 breach.",
                "The breaches need not be consecutive; any M of the last N count."
              ]
            },
            {
              "type": "qa",
              "q": "Someone deleted an S3 object. lookup-events for DeleteObject returns nothing. Why?",
              "a_bullets": [
                "Answer: object operations are data events, which are off by default.",
                "Fix: enable data events on a trail for that bucket; past deletes are not recoverable from history."
              ]
            }
          ]
        }
      ]
    }
