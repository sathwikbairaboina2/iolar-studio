    {
      "title": "CloudWatch Metrics, Alarms and Dashboards",
      "role": "outline",
      "outlineIndex": 1,
      "pages": [
        {
          "title": "CloudWatch Metrics, Alarms and Dashboards",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Metrics",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "==Metric== = data points by namespace + name + dimensions",
                "Each unique dimension combo is a ==separate metric==",
                "EC2 basic = ==5 min==; detailed = ==1 min== (paid)",
                "EC2 does {red:not} report memory or disk-used",
                "Install the ==CloudWatch agent== to collect them"
              ],
              "style": "dot",
              "ink": "green"
            },
            {
              "type": "heading",
              "text": "2. Alarms",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "Setting",
                "Meaning"
              ],
              "rows": [
                [
                  "Statistic",
                  "Average, Sum, Max"
                ],
                [
                  "Period",
                  "seconds per window"
                ],
                [
                  "Threshold",
                  "value that counts as breach"
                ],
                [
                  "Evaluation periods (N)",
                  "latest windows checked"
                ],
                [
                  "Datapoints to alarm (M)",
                  "breaches needed, e.g. 3 of 5"
                ]
              ]
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "OK",
                    "ink": "green"
                  },
                  {
                    "text": "ALARM",
                    "sub": "M of N breach",
                    "ink": "red"
                  },
                  {
                    "text": "INSUFFICIENT_DATA",
                    "sub": "too few points",
                    "ink": "orange"
                  }
                ]
              }
            },
            {
              "type": "table",
              "headers": [
                "Missing data",
                "Effect"
              ],
              "rows": [
                [
                  "`missing` (default)",
                  "uses existing points; sparse metric sticks in INSUFFICIENT_DATA"
                ],
                [
                  "`notBreaching`",
                  "gaps count as OK"
                ],
                [
                  "`breaching`",
                  "gaps breach: stopped instance falsely fires"
                ],
                [
                  "`ignore`",
                  "keeps current state"
                ]
              ]
            },
            {
              "type": "bullets",
              "items": [
                "Actions: ==SNS==, EC2 stop/terminate/reboot/recover, Auto Scaling",
                "Test: `aws cloudwatch set-alarm-state --alarm-name X --state-value ALARM --state-reason test`"
              ],
              "style": "check",
              "ink": "blue"
            },
            {
              "type": "heading",
              "text": "3. Dashboards",
              "ink": "purple"
            },
            {
              "type": "bullets",
              "items": [
                "Mix metrics from multiple ==regions==",
                "Mix metrics from multiple ==accounts==",
                "Metric math: `errors / requests * 100` = ==error rate %=="
              ],
              "style": "dot",
              "ink": "purple"
            }
          ]
        }
      ]
    },
    {
      "title": "CloudWatch Logs, Logs Insights and Custom Metrics",
      "role": "outline",
      "outlineIndex": 2,
      "pages": [
        {
          "title": "CloudWatch Logs, Logs Insights and Custom Metrics",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Hierarchy and ingest",
              "ink": "green"
            },
            {
              "type": "table",
              "headers": [
                "Level",
                "Holds",
                "Example"
              ],
              "rows": [
                [
                  "Log group",
                  "retention, permissions",
                  "`/aws/lambda/orders`"
                ],
                [
                  "Log stream",
                  "one instance or container",
                  "`i-0abc`"
                ],
                [
                  "Log event",
                  "timestamped line",
                  "one log line"
                ]
              ]
            },
            {
              "type": "bullets",
              "items": [
                "Retention defaults to ==Never expire==",
                "==Set retention== to control cost",
                "Ingest: CloudWatch agent, awslogs driver, SDK",
                "Role needs `logs:CreateLogStream`, `logs:PutLogEvents`"
              ],
              "style": "dot"
            },
            {
              "type": "heading",
              "text": "2. Insights and metric filters",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "Insights queries logs with a ==command pipeline==",
                "Metric filter turns a log pattern into a metric",
                "An alarm can watch that metric",
                "Counts only events ingested ==after== creation"
              ],
              "style": "dot"
            },
            {
              "type": "code",
              "lang": "text",
              "lines": [
                "fields @timestamp, @message",
                "| filter @message like /ERROR/",
                "| stats count() as errors by bin(5m) as t",
                "| sort t desc",
                "| limit 20"
              ]
            },
            {
              "type": "heading",
              "text": "3. Custom metrics and cost",
              "ink": "purple"
            },
            {
              "type": "bullets",
              "items": [
                "Standard resolution ==1 min==; high ==1 sec== (`StorageResolution=1`)",
                "==EMF== emits metrics from structured log lines",
                "Publish a custom metric from the CLI"
              ],
              "style": "dot"
            },
            {
              "type": "code",
              "lang": "bash",
              "lines": [
                "aws cloudwatch put-metric-data --namespace MyApp --metric-name Orders --value 1 --unit Count"
              ]
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Insights cost",
              "text": "Billed per ==GB scanned==: narrow time range and log groups. Export to S3 for archive."
            }
          ]
        }
      ]
    },
    {
      "title": "CloudTrail: Management vs Data Events and Trails to S3",
      "role": "outline",
      "outlineIndex": 3,
      "pages": [
        {
          "title": "CloudTrail: Management vs Data Events and Trails to S3",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Event Types",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "CloudTrail records ==AWS API calls== from console, CLI and SDK",
                "**Event history**: last ==90 days==, management events, free, per region",
                "History {red:cannot be extended}"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "table",
              "headers": [
                "",
                "Management",
                "Data"
              ],
              "rows": [
                [
                  "Plane",
                  "Control",
                  "Data"
                ],
                [
                  "Examples",
                  "`RunInstances`, `CreateBucket`, `AttachRolePolicy`",
                  "S3 `GetObject`/`PutObject`, Lambda `Invoke`, DynamoDB item ops"
                ],
                [
                  "Default",
                  "{green:ON}",
                  "{red:OFF}"
                ],
                [
                  "Volume",
                  "Low",
                  "High, **billed**"
                ]
              ],
              "highlightRow": 2
            },
            {
              "type": "heading",
              "text": "2. Trail to S3",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "A ==trail== delivers events to S3 (optionally CloudWatch Logs)",
                "Use it for retention beyond ==90 days=="
              ],
              "style": "dot"
            },
            {
              "type": "code",
              "lang": "bash",
              "lines": [
                "aws cloudtrail create-trail --name org-trail \\",
                "  --s3-bucket-name my-logs --is-multi-region-trail",
                "aws cloudtrail start-logging --name org-trail"
              ]
            },
            {
              "type": "sidebox",
              "title": "Bucket policy",
              "items": [
                "Principal `cloudtrail.amazonaws.com`",
                "`s3:GetBucketAcl` on the bucket",
                "`s3:PutObject` on `AWSLogs/<account-id>/*`"
              ],
              "ink": "blue"
            },
            {
              "type": "heading",
              "text": "3. Harden and Scope",
              "ink": "purple"
            },
            {
              "type": "bullets",
              "items": [
                "==Log file validation==: digest files with SHA-256 hashes detect tampering",
                "==Multi-region== trail covers every region",
                "==Organization trail== covers all accounts",
                "==Advanced event selectors== limit data events to chosen buckets or Lambda functions"
              ],
              "style": "check"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Data events are off",
              "text": "No data events, no S3 `GetObject` history. Enable them only for the buckets and functions you need, to control cost."
            }
          ]
        }
      ]
    },
    {
      "title": "Who-Did-What Investigations and AWS Config",
      "role": "outline",
      "outlineIndex": 4,
      "pages": [
        {
          "title": "Who-Did-What Investigations and AWS Config",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Reading a CloudTrail event",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "Field",
                "Answers"
              ],
              "rows": [
                [
                  "`eventTime`",
                  "when"
                ],
                [
                  "`eventName` / `eventSource`",
                  "which call, which service"
                ],
                [
                  "`userIdentity`",
                  "who: type, arn, principalId, sessionContext"
                ],
                [
                  "`sourceIPAddress` / `userAgent`",
                  "from where, which tool"
                ],
                [
                  "`requestParameters`",
                  "inputs sent"
                ],
                [
                  "`errorCode`",
                  "why it failed"
                ]
              ]
            },
            {
              "type": "heading",
              "text": "2. Finding the actor",
              "ink": "purple"
            },
            {
              "type": "code",
              "lang": "bash",
              "lines": [
                "aws cloudtrail lookup-events \\",
                "  --lookup-attributes \\",
                "  AttributeKey=EventName,AttributeValue=TerminateInstances"
              ],
              "note": "recent management events"
            },
            {
              "type": "bullets",
              "items": [
                "Older or data events: query the ==S3 trail== with `Athena`",
                "An assumed role shows the {orange:role session}, not the person"
              ],
              "style": "dot"
            },
            {
              "type": "diagram",
              "kind": "chain",
              "spec": {
                "steps": [
                  {
                    "text": "Role session",
                    "note": "userIdentity",
                    "ink": "orange"
                  },
                  {
                    "text": "sessionContext",
                    "note": "sourceIdentity",
                    "ink": "blue"
                  },
                  {
                    "text": "AssumeRole event",
                    "note": "original call",
                    "ink": "purple"
                  },
                  {
                    "text": "Real user",
                    "note": "human or federated",
                    "ink": "green"
                  }
                ]
              }
            },
            {
              "type": "heading",
              "text": "3. AWS Config",
              "ink": "green"
            },
            {
              "type": "table",
              "headers": [
                "",
                "CloudTrail",
                "Config"
              ],
              "rows": [
                [
                  "Answers",
                  "**who** made the API call",
                  "what the resource looked like **before and after**"
                ],
                [
                  "Also",
                  "when, from where",
                  "is it compliant"
                ]
              ]
            },
            {
              "type": "bullets",
              "items": [
                "Stores ==configuration items== as a timeline per resource",
                "Config rules judge compliance, e.g. `s3-bucket-public-read-prohibited`",
                "Needs a ==recorder== and a ==delivery channel== (S3 bucket)",
                "{blue:Regional}; billed per configuration item recorded",
                "Remediation can run automatically via ==SSM Automation=="
              ],
              "style": "check"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Use both together",
              "text": "CloudTrail finds **who** changed it; Config shows **what** changed and whether it is compliant."
            }
          ]
        }
      ]
    },
