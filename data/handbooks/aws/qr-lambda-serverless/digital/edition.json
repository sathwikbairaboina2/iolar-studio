        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "A function has a 15 min timeout behind a default REST API. A job takes 40 s. What does the caller see?",
              "a_bullets": [
                "A ==504 at 29 s==: the API Gateway integration timeout, not the function timeout",
                "Fix: return 202 and queue the work (SQS)"
              ]
            },
            {
              "type": "qa",
              "q": "Spot the bug: a function triggered by S3 uploads writes its output into the same bucket.",
              "a_bullets": [
                "Each output fires the function again: a ==recursive loop== and runaway cost",
                "Fix: separate bucket or prefix filter, reserved concurrency, billing alarm"
              ]
            },
            {
              "type": "qa",
              "q": "A proxy handler returns {\"statusCode\":200,\"body\":{\"ok\":true}}. Why does the client get a 502?",
              "a_bullets": [
                "In proxy integration ==body must be a string==, so a dict is a malformed response",
                "Fix: `json.dumps` the body"
              ]
            }
          ]
        }
