        },
        {
          "type": "code",
          "lang": "python",
          "lines": [
            "from concurrent.futures import *",
            "with ThreadPoolExecutor(8) as ex:",
            "    out = list(ex.map(fn, urls))",
            "# threads share memory for free"
          ],
          "note": "GIL still caps pure-Python CPU work"
        },
        {
          "type": "code",
          "lang": "python",
          "lines": [
            "if __name__ == \"__main__\":",
            "  with ProcessPoolExecutor() as p:",
            "    r = p.map(f, xs, chunksize=64)",
            "# f top-level, args picklable"
          ],
          "note": "chunksize batches many tiny tasks"
        },
        {
          "type": "code",
          "lang": "python",
          "lines": [
            "sem = asyncio.Semaphore(10)",
            "async def main():",
            "  async with asyncio.timeout(5):",
            "    async with TaskGroup() as tg:",
            "      for u in urls:",
            "        tg.create_task(get(u,sem))"
          ],
          "note": "entry point: asyncio.run(main())"
        },
        {
          "type": "heading",
          "text": "3. Common Mistakes",
          "ink": "red"
        },
        {
          "type": "bullets",
          "items": [
            "Blocking `requests`/`time.sleep` inside ==async def== freezes the loop",
            "Mutating globals in workers: processes **don't** share memory",
            "No `__main__` guard: spawn re-imports and re-runs the script",
            "Threads for pure-Python CPU work on a ==GIL== build"
          ],
          "style": "cross",
          "frame": "dashed",
          "ink": "red"
        },
        {
          "type": "sidebox",
          "title": "Quick fixes",
          "items": [
            "blocking call → `await asyncio.to_thread(fn)`",
            "shared state → return results, or `Queue`",
            "CPU work → `ProcessPoolExecutor`"
          ],
          "ink": "green"
        },
        {
          "type": "heading",
          "text": "4. Measure First",
          "ink": "blue"
        },
        {
          "type": "code",
          "lang": "python",
          "lines": [
            "from time import perf_counter",
            "from time import process_time",
            "w0, c0 = perf_counter(), process_time()",
            "run_sequential()",
            "wall = perf_counter() - w0",
            "cpu = process_time() - c0"
          ],
          "note": "time the baseline before adding pools"
        },
        {
          "type": "bullets",
          "items": [
            "cpu ≈ wall → ==CPU-bound== → processes",
            "cpu ≪ wall → mostly **waiting** → threads / asyncio",
            "Re-measure after: overhead can make it slower"
          ],
          "style": "check",
          "frame": "dashed",
          "ink": "blue"
        },
        {
          "type": "callout",
          "style": "takeaway",
          "title": "5. Takeaway",
          "text": "**Measure** first: waiting → threads/asyncio, computing → processes."
        }
