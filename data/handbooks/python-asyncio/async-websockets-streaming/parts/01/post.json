          "type": "code",
          "lang": "python",
          "lines": [
            "@app.websocket(\"/ws/{room}\")",
            "async def ep(ws: WebSocket,",
            "    room: str, token: str = \"\"):",
            "  if not ok(token):  # pre-accept",
            "    raise WebSocketException(1008)",
            "  await ws.accept()"
          ],
          "note": "HTTPException does not apply here"
        },
