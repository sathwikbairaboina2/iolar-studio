      "page_title": "websockets: Rejecting Clients with process_request",
      "blocks": [
        {
          "type": "heading",
          "text": "☆ Auth Before the Upgrade",
          "ink": "orange"
        },
        {
          "type": "code",
          "lang": "python",
          "lines": [
            "def auth(connection, request):",
            "    if request.headers.get(\"X-Token\") != SECRET:",
            "        return connection.respond(401, \"bad token\\n\")",
            "    # returning None lets the upgrade continue",
            "serve(handler, \"\", 8765, process_request=auth)"
          ],
          "note": "rejects before the upgrade: 401/403"
        },
        {
          "type": "table",
          "headers": [
            "Hook returns",
            "Result"
          ],
          "rows": [
            [
              "`None`",
              "upgrade → ==101=="
            ],
            [
              "`respond(401, …)`",
              "missing / bad token"
            ],
            [
              "`respond(403, …)`",
              "valid user, **no** access"
            ]
          ],
          "frame": "dashed"
        },
        {
          "type": "bullets",
          "items": [
            "Runs **before** the handshake: no handler task is spawned",
            "Rejected clients get a plain HTTP error, not a close code",
            "Browsers can't set headers → read a token from `request.path`",
            "Keep the check fast: a slow hook delays every upgrade"
          ],
          "style": "check",
          "frame": "dashed",
          "ink": "orange"
        },
