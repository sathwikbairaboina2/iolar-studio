          "ink": "green"
        },
        {
          "type": "paragraph",
          "text": "`@app.websocket(\"/ws\")` + `async def ep(websocket: WebSocket)` opens a ==WebSocket route==. You **must** `await websocket.accept()` before any send.",
          "frame": "dashed",
          "ink": "green"
        },
        {
          "type": "code",
          "lang": "python",
          "lines": [
            "@app.websocket(\"/ws\")",
            "async def ep(ws: WebSocket):",
            "    await ws.accept()  # 1st!",
            "    async for m in ws.iter_text():",
            "        await ws.send_text(m)"
          ],
          "note": "no send before accept()"
        },
        {
          "type": "table",
          "headers": [
            "Op",
            "text",
