        {
          "type": "code",
          "lang": "python",
          "lines": [
            "from websockets.asyncio.server import serve",
            "async def echo(ws):                      # one arg only",
            "    async for m in ws: await ws.send(m)  # echo back",
            "async def main():",
            "    async with serve(echo, \"\", 8765) as s: await s.serve_forever()"
          ],
          "note": "5 lines; start with asyncio.run(main())"
