      "blocks": [
        {
          "type": "heading",
          "text": "☆ 6. Offloading Blocking Work",
          "ink": "blue"
        },
        {
          "type": "code",
          "lang": "python",
          "lines": [
            "async def handler(ws):",
            "  async for msg in ws:",
            "    # blocking → run in thread",
            "    r = await asyncio.to_thread(",
            "        slow_query, msg)",
            "    await ws.send(r)"
          ],
          "note": "never block the event loop"
        },
        {
          "type": "table",
          "headers": [
            "Blocking call",
            "Async fix"
          ],
          "rows": [
            [
              "`time.sleep(1)`",
              "`await asyncio.sleep(1)`"
            ],
            [
              "sync DB driver",
              "async driver / `to_thread`"
            ],
            [
              "`requests.get()`",
              "`aiohttp` / `httpx`"
            ],
            [
              "CPU-heavy loop",
              "`to_thread` / process pool"
            ]
          ],
          "frame": "dashed"
        },
        {
          "type": "bullets",
          "items": [
            "One blocked handler = **every** socket stalls",
            "Pings miss their timeout → peers see ==1011== closes",
            "Prefer native async libraries; `to_thread` is the fallback",
            "Heavy CPU work: a process pool avoids the GIL"
          ],
          "style": "checkbox",
          "frame": "dashed",
          "ink": "green"
        },
        {
          "type": "heading",
          "text": "☆ 7. Computing the Accept Key",
          "ink": "purple"
        },
        {
          "type": "code",
          "lang": "python",
          "lines": [
            "import base64, hashlib",
            "def accept(key: str) -> str:",
            "    raw = (key + GUID).encode()",
            "    h = hashlib.sha1(raw).digest()",
            "    return base64.b64encode(h)\\",
            "        .decode()"
          ],
          "note": "GUID is fixed by RFC 6455"
        },
