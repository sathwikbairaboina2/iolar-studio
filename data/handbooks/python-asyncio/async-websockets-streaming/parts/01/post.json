      "page_title": "websockets: Concurrency, Close Errors & Routing",
      "blocks": [
        {
          "type": "code",
          "lang": "python",
          "lines": [
            "async with connect(\"ws://host:8765\") as ws:",
            "    async with asyncio.TaskGroup() as tg:",
            "        tg.create_task(reader(ws))  # async for m in ws",
            "        tg.create_task(writer(ws))  # await ws.send(...)",
            "# block exit → connection closed"
          ],
          "note": "a TaskGroup runs read and write together"
        },
        {
          "type": "heading",
          "text": "☆ 4. Common Mistakes",
          "ink": "red"
        },
        {
          "type": "bullets",
          "items": [
            "`handler(ws, path)` → use `ws.request.path`",
            "`send()` and `recv()` in one loop block each other → use TaskGroup",
            "Checking auth after the upgrade → use ==process_request==",
            "Uncaught ConnectionClosedError from `async for`",
            "Sending over 1 MiB with the default max_size → the connection closes with 1009"
          ],
          "style": "cross",
          "frame": "dashed",
          "ink": "red"
