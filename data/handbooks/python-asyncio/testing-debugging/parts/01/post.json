              "pass",
              "pass"
            ],
            [
              "`m(1)` (no await)",
              "pass",
              "**FAIL**"
            ]
          ],
          "highlightRow": 1,
          "frame": "dashed"
        },
        {
          "type": "heading",
          "text": "7. side_effect in action",
          "ink": "purple"
        },
        {
          "type": "code",
          "lang": "python",
          "lines": [
            "m = AsyncMock(side_effect=[",
            "    TimeoutError(), {'id': 1}])",
            "got = await retry(m)  # 2nd try",
            "assert got == {'id': 1}",
            "assert m.await_count == 2"
          ],
          "note": "exceptions in the list are raised"
