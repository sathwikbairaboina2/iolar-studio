      "blocks": [
        {
          "type": "heading",
          "text": "1. Define, Run, Combine",
          "ink": "purple"
        },
        {
          "type": "code",
          "lang": "python",
          "lines": [
            "async def main():",
            "    await a(); await b()  # a+b",
            "    await asyncio.gather(a(), b())",
            "    # ↑ together: max(a, b)",
            "asyncio.run(main())  # once, top"
          ],
          "note": "asyncio.run called once, top level"
        },
        {
          "type": "table",
          "headers": [
            "Goal",
            "Use"
          ],
          "rows": [
            [
              "One after other",
              "`await a(); await b()`"
            ],
            [
              "Run together",
              "`gather(a(), b())`"
            ],
            [
              "Background job",
              "`create_task(coro())`"
            ],
            [
              "Structured (3.11+)",
              "`TaskGroup()`"
            ]
          ],
          "frame": "dashed"
        },
        {
          "type": "bullets",
          "items": [
            "Guard it: `if __name__ == '__main__': asyncio.run(main())`",
            "**Never** call `asyncio.run` per request or in a loop",
            "Loop already running (Jupyter)? Use ==`await main()`==",
            "3.11+: `asyncio.Runner()` reuses one loop for many runs"
          ],
          "style": "check",
          "frame": "dashed",
          "ink": "purple"
        },
        {
          "type": "heading",
          "text": "2. Tasks & TaskGroup",
          "ink": "purple"
        },
