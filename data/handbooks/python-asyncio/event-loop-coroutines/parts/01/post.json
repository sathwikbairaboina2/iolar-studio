            [
              "Runs",
              "sequential",
              "concurrent",
              "no code"
            ],
            [
              "Cancel?",
              "no",
              "`cancel()`",
              "`cancel()`"
            ],
            [
              "Made by",
              "`f()` call",
              "`create_task`",
              "library code"
            ],
            [
              "Await twice?",
              "{red:RuntimeError}",
              "{green:OK}",
              "{green:OK}"
            ]
