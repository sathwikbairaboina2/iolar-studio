          "type": "heading",
          "text": "7. Protocol that reports back"
        },
        {
          "type": "code",
          "lang": "python",
          "lines": [
            "class Proto(asyncio.Protocol):",
            "  def __init__(self, on_done):",
            "    self.on_done, self.buf = on_done, []",
            "  def data_received(self, d):",
            "    self.buf.append(d)  # chunks",
            "  def connection_lost(self, exc):",
            "    if not self.on_done.done():",
            "      self.on_done.set_result(",
            "        b''.join(self.buf))"
          ],
          "note": "connection_lost runs exactly once"
        },
