        {
          "type": "heading",
          "text": "3. Example: echo + result"
        },
        {
          "type": "code",
          "lang": "python",
          "lines": [
            "class Echo(asyncio.Protocol):",
            "  def connection_made(self, t):",
            "    self.transport = t  # keep it",
            "  def data_received(self, data):",
            "    self.transport.write(data)"
          ],
          "note": "write never blocks, it buffers"
        },
        {
          "type": "code",
          "lang": "python",
          "lines": [
            "fut = loop.create_future()",
            "await loop.create_connection(",
            "  lambda: Proto(on_done=fut),",
            "  host, port)",
            "result = await fut"
          ],
          "note": "connection_lost calls on_done.set_result(...)"
        },
