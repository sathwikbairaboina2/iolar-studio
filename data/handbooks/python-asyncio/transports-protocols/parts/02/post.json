          "type": "heading",
          "text": "1. Client: create_connection"
        },
        {
          "type": "code",
          "lang": "python",
          "lines": [
            "loop = asyncio.get_running_loop()",
            "cc = loop.create_connection",
            "transport, protocol = await cc(",
            "  lambda: MyProto(), host, port)"
          ],
          "note": "resolves once TCP handshake completes"
        },
        {
          "type": "bullets",
          "items": [
            "Arg 1 is a ==protocol factory==: a **callable**, not an instance",
            "Servers need a __fresh protocol__ per accepted connection",
            "Same signature on both sides; the loop calls `factory()`"
          ],
          "style": "dot",
          "frame": "dashed",
          "ink": "green"
        },
        {
          "type": "table",
          "headers": [
            "Option",
            "Purpose"
          ],
          "rows": [
            [
              "`ssl=`",
              "TLS context / True"
            ],
            [
              "`server_hostname=`",
              "SNI + cert name"
            ],
            [
              "`local_addr=`",
              "bind source addr"
            ],
            [
              "`happy_eyeballs_delay=`",
              "RFC 8305 v6/v4 race"
            ],
            [
              "`sock=`",
              "reuse existing socket"
            ]
          ],
          "frame": "dashed"
        },
        {
          "type": "heading",
          "text": "2. Server: create_server"
        },
        {
          "type": "code",
          "lang": "python",
          "lines": [
            "srv = await loop.create_server(",
            "  lambda: Echo(), '0.0.0.0', 8888)",
            "async with srv:   # closes on exit",
            "  await srv.serve_forever()",
            "srv.close()  # stop listening",
            "await srv.wait_closed()"
          ],
          "note": "returns asyncio.Server: one or more sockets"
        },
        {
          "type": "table",
          "headers": [
            "Option",
            "Effect"
