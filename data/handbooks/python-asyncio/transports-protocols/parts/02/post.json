            "fut = loop.create_future()",
            "if not fut.done():  # guard",
            "    fut.set_result(42)",
            "cb2 = partial(cb, tag='x')",
            "fut.add_done_callback(cb2)",
            "v = await fut  # parks the Task"
          ],
          "note": "cb(fut) gets the Future, via call_soon"
        },
        {
          "type": "sidebox",
          "title": "Future states",
          "items": [
            "==pending== → `result()` raises InvalidStateError",
            "==cancelled== → raises CancelledError",
            "==finished== → value or stored exception",
            "Second `set_result` → **InvalidStateError**"
          ],
          "ink": "purple"
