            "Action",
            "Ready queue",
            "Printed"
          ],
          "rows": [
            [
              "1",
              "call_soon A",
              "[A]",
              "—"
            ],
            [
              "2",
              "set_result",
              "[A, C]",
              "—"
            ],
            [
              "3",
              "print B",
              "[A, C]",
              "B"
