        {
          "type": "code",
          "lang": "python",
          "lines": [
            "try:",
            "  r = await c.get('/items')",
            "  r.raise_for_status()",
            "except httpx.HTTPStatusError as e:",
            "  log(e.response.status_code)",
            "except httpx.RequestError:",
            "  ...  # network / timeout"
          ],
          "note": "status errors ≠ transport errors"
        },
        {
          "type": "heading",
          "text": "8. Best practices",
          "ink": "green"
        },
        {
          "type": "bullets",
          "items": [
            "One client per app, opened in ==lifespan== or startup",
            "Put `base_url`, headers and auth on the client, not calls",
            "Always exit `async with` so the conn goes back",
            "Call `raise_for_status()` before trusting the body",
            "Close the client **once**, on shutdown"
          ],
          "style": "checkbox",
          "frame": "dashed",
          "ink": "green"
        },
        {
          "type": "callout",
          "style": "sticky",
          "title": "Remember",
          "text": "One app → one client → one close. For aiohttp's cleanup_ctx version, see page 8."
        }
      ],
