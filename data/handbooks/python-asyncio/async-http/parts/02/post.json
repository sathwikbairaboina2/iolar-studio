      "page_title": "Offloading Blocking Code & Shutdown Order",
      "blocks": [
        {
          "type": "heading",
          "text": "1. Spotting a Blocked Loop",
          "ink": "green"
        },
        {
          "type": "bullets",
          "items": [
            "==Blocked loop==: one sync call freezes **every** coroutine",
            "Symptom: latency spikes on __all endpoints at once__",
            "`PYTHONASYNCIODEBUG=1` logs callbacks slower than 100ms",
            "Usual culprits: `requests.get`, `time.sleep`, sync DB drivers"
          ],
          "style": "dot",
          "frame": "dashed",
          "ink": "green"
        },
        {
          "type": "heading",
          "text": "2. Offloading Blocking Work",
          "ink": "purple"
        },
        {
          "type": "table",
          "headers": [
            "Tool",
            "Runs in",
            "Use for"
          ],
          "rows": [
            [
              "`asyncio.to_thread(f, *a)`",
              "default executor",
              "blocking I/O (3.9+)"
            ],
            [
              "`loop.run_in_executor(pool, f)`",
              "own ThreadPoolExecutor",
              "cap `max_workers`"
            ],
            [
              "`ProcessPoolExecutor`",
              "worker processes",
              "**CPU** work (GIL)"
            ],
            [
              "`run_in_threadpool(f)` / `anyio.to_thread.run_sync(f)`",
              "anyio threadpool",
              "Starlette / FastAPI"
            ]
          ],
          "frame": "dashed"
        },
        {
          "type": "code",
          "lang": "python",
          "lines": [
            "# default executor (3.9+)",
            "rows = await asyncio.to_thread(",
            "    load_csv, path)",
            "pool = ThreadPoolExecutor(8)",
            "lp = asyncio.get_running_loop()",
            "await lp.run_in_executor(pool, f)"
          ],
          "note": "a timeout abandons the await, not the thread"
        },
        {
          "type": "heading",
          "text": "3. Graceful Shutdown Order",
          "ink": "blue"
        },
        {
          "type": "diagram",
