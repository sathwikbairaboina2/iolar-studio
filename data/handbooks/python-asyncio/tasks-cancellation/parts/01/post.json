      "blocks": [
        {
          "type": "heading",
          "text": "5. Common mistakes",
          "ink": "red"
        },
        {
          "type": "bullets",
          "items": [
            "`t.result()` inside the block before `t` is done",
            "`tg.create_task` on a finished group → `RuntimeError`",
            "Plain `except KeyError` misses the ExceptionGroup",
            "Swallowing CancelledError in a child stalls the group"
          ],
          "style": "cross",
          "frame": "dashed",
          "ink": "red"
        },
        {
          "type": "code",
          "lang": "python",
          "lines": [
            "try:",
            "  async with TaskGroup() as tg:",
            "    t = tg.create_task(get())",
            "except* KeyError:  # not except",
            "  t = None",
            "print(t.result() if t else '-')"
          ],
          "note": "read results only after the block"
        },
        {
          "type": "callout",
          "style": "tip",
          "title": "Pass the group down",
          "text": "Helpers take `tg` and call `tg.create_task(...)`, so ==every== task stays bound to one scope."
        }
      ],
      "hero": "python",
