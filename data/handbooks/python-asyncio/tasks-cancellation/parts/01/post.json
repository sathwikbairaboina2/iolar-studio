    {
      "page_title": "TaskGroup (Python 3.11+): Fail-Fast Scopes",
      "blocks": [
        {
          "type": "heading",
          "text": "1. What is it",
          "ink": "green"
        },
        {
          "type": "bullets",
          "items": [
            "`async with asyncio.TaskGroup() as tg:` opens a ==task scope==",
            "`t = tg.create_task(coro())` starts a child **bound** to the block",
            "Leaving the block waits for every child to finish",
            "No child task ever outlives the block"
          ],
          "frame": "dashed",
          "ink": "green"
        },
        {
          "type": "code",
          "lang": "python",
          "lines": [
            "from asyncio import TaskGroup",
            "async with TaskGroup() as tg:",
            "    a = tg.create_task(f(1))",
            "    b = tg.create_task(f(2))",
            "# exit waits: a, b both done",
            "print(a.result(), b.result())"
          ],
          "note": "each task object is the handle"
        },
        {
          "type": "heading",
          "text": "2. Mechanism",
          "ink": "purple"
        },
        {
          "type": "diagram",
          "kind": "flow",
          "spec": {
            "nodes": [
              {
                "text": "enter block",
                "sub": "group opens"
              },
              {
                "text": "tg.create_task",
                "sub": "children start"
              },
              {
                "text": "exit block",
                "sub": "waits for all",
                "ink": "purple"
              },
              {
                "text": "return or raise",
                "sub": "group closed"
              }
            ]
          }
        },
        {
          "type": "table",
          "headers": [
            "Event",
            "Group does"
          ],
          "rows": [
            [
              "Child raises Exception",
              "cancels rest **+ body**"
            ],
            [
              "Body raises",
              "cancels children"
            ],
            [
              "KeyboardInterrupt / SystemExit",
              "re-raised **directly**"
            ],
            [
              "create_task after finish",
              "`RuntimeError`"
            ]
          ],
          "frame": "dashed"
        },
        {
          "type": "sidebox",
          "title": "Errors are collected",
          "items": [
            "All child failures → one ==ExceptionGroup==",
            "A BaseException inside → `BaseExceptionGroup`",
            "Cancelled siblings do not count as failures",
            "Unpack with `except*` (see page 5)"
          ],
          "ink": "red"
        },
        {
          "type": "heading",
          "text": "3. Example: fail-fast",
          "ink": "blue"
        },
        {
          "type": "code",
          "lang": "python",
          "lines": [
            "try:",
            "  async with TaskGroup() as tg:",
            "    s = tg.create_task(slow())",
            "    tg.create_task(boom())",
            "except* KeyError as eg:",
            "  print(s.cancelled())  # True"
          ],
          "note": "slow() cancelled, never orphaned"
        },
        {
          "type": "bullets",
          "items": [
            "`boom()` raises KeyError",
            "Group cancels `slow()` and the body",
            "Exit waits for the cancellations to finish",
            "Raises `ExceptionGroup([KeyError()])`"
          ],
          "style": "number"
        },
