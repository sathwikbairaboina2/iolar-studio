        {
          "type": "heading",
          "text": "4. Example: TaskGroup retry"
        },
        {
          "type": "code",
          "lang": "python",
          "lines": [
            "try:",
            "    async with TaskGroup() as tg:",
            "        tg.create_task(fetch())",
            "except* TimeoutError: retry()",
            "except* ValueError: log()"
          ],
          "note": "both clauses may run for one group"
        },
