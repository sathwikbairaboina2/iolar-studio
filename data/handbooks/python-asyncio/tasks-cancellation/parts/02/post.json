          "lines": [
            "async with TaskGroup() as tg:",
            "    t = tg.create_task(c())",
            "    u = tg.create_task(d())",
            "# block exit = all children done",
            "print(t.result(), u.result())"
          ],
          "note": "read .result() only AFTER the block"
        },
        {
          "type": "code",
          "lang": "python",
          "lines": [
            "bg = set()",
            "t = asyncio.create_task(job())",
            "bg.add(t)  # strong ref",
            "t.add_done_callback(bg.discard)"
          ],
          "note": "fire-and-forget: loop keeps WEAK refs"
        },
