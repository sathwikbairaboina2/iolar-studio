            ]
          ],
          "highlightRow": 2,
          "frame": "dashed"
        },
        {
          "type": "callout",
          "style": "tip",
          "title": "WAL in one line",
          "text": "Readers stop blocking the ==writer==, but there is still **one** writer, so busy_timeout waits instead of failing."
        }
      ],
