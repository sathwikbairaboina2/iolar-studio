    {
      "page_title": "Shielding, Retries & Timeout Layers",
      "blocks": [
        {
          "type": "code",
          "lang": "python",
          "lines": [
            "try:",
            "    await conn.execute(q)",
            "except asyncio.CancelledError:",
            "    await log_abort()",
            "    raise  # never swallow"
          ],
          "note": "BaseException since 3.8: re-raise it"
        },
        {
          "type": "heading",
          "text": "3. Example: Shield and TaskGroup",
          "ink": "blue"
        },
        {
          "type": "code",
          "lang": "python",
          "lines": [
            "async with pool.acquire() as c:",
            "    await do_work(c)",
            "    await asyncio.shield(",
            "        final_commit(c))",
            "# inner finishes; outer await",
            "# still raises CancelledError"
          ],
          "note": "shield protects cleanup, not the caller"
        },
        {
          "type": "bullets",
          "items": [
            "==shield()== keeps the inner task running on cancel",
            "the outer `await` **still** raises CancelledError",
            "shield only short cleanup: commit, release, close",
            "TaskGroup: `pool.acquire()` **inside** each task"
          ],
          "style": "dot",
          "frame": "dashed",
          "ink": "blue"
        },
        {
          "type": "heading",
          "text": "6. Retry With Backoff",
          "ink": "green"
        },
        {
          "type": "code",
          "lang": "python",
          "lines": [
            "for n in range(3):",
            "  try:",
            "    async with c.transaction(",
            "        isolation=\"serializable\"):",
            "      await transfer(c)",
            "    break",
            "  except SerializationError:",
            "    await asyncio.sleep(0.1 * 2**n)"
          ],
          "note": "retry the WHOLE transaction"
        },
        {
          "type": "bullets",
          "items": [
            "Retry on ==40001== and on connection loss",
            "Back off: 0.1 s, 0.2 s, 0.4 s, then give up",
            "Re-run the **whole** transaction, not one statement",
            "Timed-out INSERT may have committed: use an idempotency key"
          ],
          "style": "check",
          "frame": "dashed",
          "ink": "green"
        },
        {
          "type": "heading",
          "text": "7. Which Timeout Layer?",
          "ink": "purple"
        },
        {
          "type": "table",
          "headers": [
            "Layer",
            "Set via",
            "On expiry"
          ],
          "rows": [
            [
              "asyncio",
              "`asyncio.timeout(5)`",
              "TimeoutError, task cancelled"
            ],
            [
              "asyncpg",
              "`command_timeout=`",
              "cancel request sent"
            ],
            [
              "Postgres",
              "`statement_timeout`",
              "query aborted"
            ],
            [
              "Postgres",
              "`idle_in_transaction…`",
              "session **closed**"
            ]
          ],
          "highlightRow": 1,
          "frame": "dashed"
        },
        {
          "type": "code",
          "lang": "python",
          "lines": [
            "pool = await create_pool(dsn,",
            "    command_timeout=10)",
            "# per-call override",
            "await conn.fetch(q, timeout=2)"
          ],
          "note": "expiry sends a Postgres cancel"
        },
        {
          "type": "callout",
          "style": "tip",
          "title": "Order the deadlines",
          "text": "Set `statement_timeout` a bit **below** the client timeout: the server error arrives first, with a clear message and a clean connection."
        }
      ],
      "hero": "postgresql",
