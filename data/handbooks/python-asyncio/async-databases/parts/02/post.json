    {
      "page_title": "Timeouts and Cancellation Safety",
      "blocks": [
        {
          "type": "heading",
          "text": "1. Mechanism: Set Deadlines",
          "ink": "green"
        },
        {
          "type": "code",
          "lang": "python",
          "lines": [
            "# client-side deadline",
            "async with asyncio.timeout(5):",
            "    rows = await conn.fetch(q)",
            "# pre-3.11 equivalent",
            "rows = await asyncio.wait_for(",
            "    conn.fetch(q), 5)"
          ],
          "note": "timeout() is 3.11+; raises TimeoutError"
        },
        {
          "type": "bullets",
          "items": [
            "`create_pool(dsn, command_timeout=10)`: default for every call",
            "per call: `await conn.fetch(q, timeout=2)`",
            "on expiry asyncpg sends a Postgres ==cancel request==",
            "so the server **stops** the query too"
          ],
          "style": "dot",
          "frame": "dashed",
          "ink": "green"
        },
        {
          "type": "table",
          "headers": [
            "Server guard",
            "Kills"
          ],
          "rows": [
            [
              "`statement_timeout`",
              "long query"
            ],
            [
              "`lock_timeout`",
              "lock wait"
            ],
            [
              "`idle_in_transaction_session_timeout`",
              "idle open txn"
            ]
          ],
          "frame": "dashed"
        },
        {
          "type": "code",
          "lang": "python",
          "lines": [
            "create_async_engine(url,",
            "  connect_args={",
            "    \"server_settings\": {",
            "      \"statement_timeout\": \"5s\",",
            "      \"lock_timeout\": \"2s\"}})"
          ],
          "note": "applied to every pooled connection"
        },
        {
          "type": "heading",
          "text": "2. How a Cancel Unwinds",
          "ink": "purple"
        },
        {
          "type": "diagram",
          "kind": "flow",
          "spec": {
            "nodes": [
              {
                "text": "task.cancel()",
                "sub": "or timeout",
                "ink": "orange"
              },
              {
                "text": "CancelledError",
                "sub": "at current await",
                "ink": "red"
              },
              {
                "text": "ROLLBACK",
                "sub": "conn.transaction()",
                "ink": "purple"
              },
              {
                "text": "pool resets",
                "sub": "or discards conn",
                "ink": "blue"
              },
              {
                "text": "re-raise",
                "sub": "caller sees it",
                "ink": "green"
              }
            ]
          }
        },
        {
          "type": "code",
          "lang": "python",
          "lines": [
            "async with TaskGroup() as tg:",
            "    tg.create_task(pool.fetch(A))",
            "    tg.create_task(pool.fetch(B))",
            "# one fails -> sibling cancelled"
          ],
          "note": "each task gets its own connection"
        },
        {
          "type": "heading",
          "text": "4. Mistakes",
          "ink": "red"
        },
        {
          "type": "bullets",
          "items": [
            "`except BaseException: pass` swallows ==CancelledError==",
            "reusing a conn cancelled **mid-read**: stale replies",
            "redis-py CVE-2023-28858/28859 (Mar 2023): replies leaked across users",
            "one conn or AsyncSession shared by TaskGroup tasks",
            "blindly re-running an INSERT after a timeout"
          ],
          "style": "cross",
          "frame": "dashed",
          "ink": "red"
        },
        {
          "type": "table",
          "headers": [
            "After...",
            "Retry?"
          ],
          "rows": [
            [
              "SerializationFailure 40001",
              "{green:yes}, backoff"
            ],
            [
              "connection lost",
              "{green:yes} if idempotent"
            ],
            [
              "timeout on INSERT",
              "**no**, may have committed"
            ]
          ],
          "highlightRow": 2,
          "frame": "dashed"
        },
        {
          "type": "heading",
          "text": "5. Summary",
          "ink": "black"
        },
        {
          "type": "bullets",
          "items": [
            "deadline on **both** sides: client timeout + server guards",
            "clean up, then __re-raise__ CancelledError",
            "shield() only for the final commit or release",
            "retry only ==idempotent== work, with backoff"
          ],
          "style": "checkbox",
          "frame": "dashed",
          "ink": "blue"
        }
