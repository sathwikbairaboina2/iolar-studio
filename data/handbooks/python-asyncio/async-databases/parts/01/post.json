      "page_title": "Finding Idle-in-Transaction Sessions",
      "blocks": [
        {
          "type": "heading",
          "text": "☆ Spot the leak",
          "ink": "orange"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "SELECT pid, xact_start, query",
            "FROM pg_stat_activity",
            "WHERE state =",
            "  'idle in transaction';"
          ],
          "note": "old xact_start = leaked transaction"
        },
        {
          "type": "bullets",
          "items": [
            "==idle in transaction==: tx open, no query running",
            "Row locks and a **pooled** conn stay held meanwhile",
            "Usual cause: `await` on HTTP inside the tx",
            "`pg_terminate_backend(pid)` ends a stuck session"
          ],
          "style": "check",
          "frame": "dashed",
          "ink": "orange"
        },
        {
          "type": "heading",
          "text": "☆ Bad vs good pattern",
          "ink": "red"
        },
        {
          "type": "code",
          "lang": "python",
          "lines": [
            "async with conn.transaction():",
            "  await conn.execute(upd)",
            "  r = await http.get(url)  # !!",
            "  await conn.execute(ins, r)"
          ],
          "note": "tx sits idle while HTTP waits"
        },
        {
          "type": "code",
          "lang": "python",
          "lines": [
            "r = await http.get(url)  # first",
            "async with conn.transaction():",
            "  await conn.execute(upd)",
            "  await conn.execute(ins, r)"
          ],
          "note": "external I/O stays outside the tx"
        },
        {
          "type": "heading",
          "text": "☆ Server-side guard",
          "ink": "red"
        },
        {
          "type": "code",
          "lang": "python",
          "lines": [
            "pool = await create_pool(dsn,",
            "  server_settings={",
            "    'idle_in_transaction_'",
            "    'session_timeout': '10s'})"
          ],
          "note": "server kills tx idle over 10 s"
        },
        {
          "type": "heading",
          "text": "☆ All three guards",
          "ink": "blue"
        },
        {
          "type": "table",
          "headers": [
            "Setting",
            "Stops"
          ],
          "rows": [
            [
              "`statement_timeout`",
              "runaway query"
            ],
            [
              "`lock_timeout`",
              "long lock waits"
            ],
            [
              "`idle_in_transaction_session_timeout`",
              "==leaked== tx"
            ]
          ],
          "frame": "dashed"
        },
