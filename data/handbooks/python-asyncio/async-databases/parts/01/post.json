          ],
          "note": "stmt lives on THIS connection only"
        },
        {
          "type": "table",
          "headers": [
            "status =",
            "rows",
            "best plan"
          ],
          "rows": [
            [
              "'rare'",
              "50",
              "index scan"
            ],
            [
              "'common'",
              "9 M",
              "seq scan"
            ],
            [
              "generic",
              "one for both",
              "**wrong** for one"
            ]
          ],
          "highlightRow": 2,
          "frame": "dashed"
        },
        {
          "type": "code",
          "lang": "python",
          "lines": [
