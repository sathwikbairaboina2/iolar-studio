      "page_title": "Prepared Statements",
      "blocks": [
        {
          "type": "heading",
          "text": "☆ 1. What is it"
        },
        {
          "type": "paragraph",
          "text": "A ==prepared statement== is parsed and planned **once** on the server. After that it runs many times with different `$1` values.",
          "frame": "dashed",
          "ink": "green"
        },
        {
          "type": "bullets",
          "items": [
            "asyncpg prepares **every** query for you",
            "Cached ==per connection==, not shared by the pool",
            "`statement_cache_size=100` by default, an __LRU__"
          ],
          "style": "check",
          "frame": "dashed",
          "ink": "green"
        },
        {
          "type": "heading",
          "text": "☆ 2. Mechanism: plans"
        },
        {
          "type": "table",
          "headers": [
            "Run / mode",
            "Plan used",
            "Why"
          ],
          "rows": [
            [
              "runs 1–5",
              "custom",
              "sees real $1"
            ],
            [
              "run 6+",
              "maybe generic",
              "if cost ≈ custom"
            ],
            [
              "force_custom_plan",
              "always custom",
              "skewed data"
            ],
            [
              "force_generic_plan",
              "always generic",
              "skip replanning"
            ]
          ],
          "frame": "dashed"
        },
        {
          "type": "heading",
