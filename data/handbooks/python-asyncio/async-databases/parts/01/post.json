    {
      "page_title": "Escaping Blocking Calls with to_thread",
      "blocks": [
        {
          "type": "callout",
          "style": "tip",
          "title": "Quick audit",
          "text": "Search `async def` bodies for `psycopg2`, `sqlite3`, `requests`: each one **blocks** the loop."
        },
        {
          "type": "heading",
          "text": "☆ 6. Escape hatch: to_thread",
          "ink": "orange"
        },
        {
          "type": "code",
          "lang": "python",
          "lines": [
            "def legacy(uid):  # sync lib",
            "    return sync_orm.get(uid)",
            "",
            "user = await asyncio.to_thread(",
            "    legacy, 42)  # off the loop"
          ],
          "note": "escape hatch for sync-only libraries"
        },
        {
          "type": "bullets",
          "items": [
            "`to_thread()` runs the call in the default ==thread pool==",
            "The loop stays free while the thread blocks",
            "The pool is small: not a fix for **hot** paths",
            "Prefer a real ==async driver== when one exists"
          ],
          "style": "check",
          "frame": "dashed",
          "ink": "orange"
        },
        {
          "type": "table",
          "headers": [
            "Need",
            "Use"
          ],
          "rows": [
            [
              "{icon:postgresql} Postgres",
              "`asyncpg`"
            ],
            [
              "{icon:sqlite} SQLite",
              "`aiosqlite`"
            ],
            [
              "{icon:redis} Redis",
              "`redis.asyncio`"
            ],
            [
              "sync-only lib",
              "`asyncio.to_thread`"
            ]
          ],
          "frame": "dashed"
        },
        {
          "type": "heading",
          "text": "☆ 7. Concurrency, not speed",
          "ink": "blue"
        },
        {
          "type": "code",
          "lang": "python",
          "lines": [
            "async def one(i):",
            "  return await pool.fetchval(q, i)",
            "",
            "vals = await asyncio.gather(",
            "  *(one(i) for i in range(1000)))"
          ],
          "note": "10 conns: 990 tasks queue"
        },
        {
          "type": "bullets",
          "items": [
            "`gather()` starts all 1000 tasks at once",
            "Only ==10== hold a connection; the rest await the pool",
            "Total time ≈ 100 rounds × **query** time",
            "Grow the pool only if the DB can take it"
          ],
          "style": "dot",
          "frame": "dashed",
          "ink": "blue"
        },
        {
          "type": "heading",
          "text": "☆ 8. Finding blocking calls",
          "ink": "red"
        },
        {
          "type": "code",
          "lang": "python",
          "lines": [
            "loop = asyncio.get_running_loop()",
            "loop.slow_callback_duration = 0.05",
            "# default 0.1 s: warn sooner",
            "# or env PYTHONASYNCIODEBUG=1"
          ],
          "note": "only active in debug mode"
        },
        {
          "type": "table",
          "headers": [
            "Blocking call",
            "Async swap"
          ],
          "rows": [
            [
              "`time.sleep()`",
              "`asyncio.sleep()`"
            ],
            [
              "`requests.get()`",
              "`httpx.AsyncClient`"
            ],
            [
              "`psycopg2`",
              "==asyncpg=="
            ],
            [
              "big file `open()`",
              "`to_thread()`"
            ]
          ],
          "frame": "dashed"
        },
        {
          "type": "heading",
          "text": "☆ 9. The right pattern",
          "ink": "green"
        },
        {
          "type": "code",
          "lang": "python",
          "lines": [
            "async def handler(uid):",
            "  async with pool.acquire() as c:",
            "    return await c.fetchrow(",
            "      q, uid)  # yields here"
          ],
          "note": "hold the conn only for the query"
        },
        {
          "type": "bullets",
          "items": [
            "Create the pool **once** at startup",
            "Acquire per request, release fast",
            "No sync I/O inside `async def`",
            "Load-test: unit tests hide ==loop stalls=="
          ],
          "style": "checkbox",
          "frame": "dashed",
          "ink": "green"
        },
        {
          "type": "callout",
          "style": "takeaway",
          "title": "Rule",
          "text": "Blocking call → `to_thread` or an async driver. Slow query → fix the ==query==, not the loop."
        }
      ],
      "hero": "python",
      "subtitle": "Don't block the loop"
    },
