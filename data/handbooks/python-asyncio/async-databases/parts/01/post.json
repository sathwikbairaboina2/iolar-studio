          "lines": [
            "async with Session() as s, s.begin():",
            "    s.add(User(name=\"ada\"))  # sync",
            "    res = await s.execute(",
            "        select(User).where(User.age > 30))",
            "    users = res.scalars().all()",
            "    u1 = await s.get(User, 1)  # PK lookup"
