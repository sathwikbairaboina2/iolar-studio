      "page_title": "SQLAlchemy 2.0 Async Engine and AsyncSession",
      "blocks": [
        {
          "type": "heading",
          "text": "☆ 1. Definition",
          "ink": "green"
        },
        {
          "type": "bullets",
          "items": [
            "==create_async_engine== builds an engine on the **asyncpg** dialect",
            "URL: `postgresql+asyncpg://user:pw@host/db`, `pool_size=5`",
            "==async_sessionmaker== is the session factory; build it **once** at startup",
            "`expire_on_commit=False` keeps loaded attributes after commit"
          ],
          "style": "dot",
          "frame": "dashed",
          "ink": "green"
        },
        {
          "type": "code",
          "lang": "python",
          "lines": [
            "engine = create_async_engine(",
            "    URL, pool_size=5)",
            "Session = async_sessionmaker(",
            "    engine,",
            "    expire_on_commit=False)"
          ],
          "note": "create both once, share app-wide"
        },
        {
          "type": "heading",
          "text": "☆ 2. Mechanism",
          "ink": "blue"
        },
        {
          "type": "diagram",
          "kind": "flow",
          "spec": {
            "nodes": [
              {
                "text": "AsyncSession",
                "sub": "await s.execute()",
                "ink": "blue"
              },
              {
                "text": "greenlet bridge",
                "sub": "switches sync ↔ async",
                "ink": "purple"
              },
              {
                "text": "sync ORM core",
                "sub": "unchanged 1.x code"
              },
              {
                "text": "asyncpg",
                "sub": "awaits the network",
                "ink": "green"
              }
            ]
          }
