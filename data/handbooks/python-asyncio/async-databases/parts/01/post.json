          "type": "bullets",
          "items": [
            "`statement_timeout` hit → ==QueryCanceledError==, tx aborted",
            "Idle timeout hit → server **closes** the connection",
            "Pool discards the dead conn; next checkout gets a fresh one",
            "Or per role: `ALTER ROLE app SET lock_timeout='2s'`"
          ],
          "style": "dot",
          "frame": "dashed",
          "ink": "blue"
        },
