        {
          "type": "code",
          "lang": "python",
          "lines": [
            "for attempt in range(3):",
            "  try:",
            "    async with c.transaction(",
            "        isolation='serializable'):",
            "      return await work(c)",
            "  except SerializationError:"
          ],
          "note": "40001: retry the WHOLE transaction"
        },
        {
          "type": "heading",
          "text": "☆ 4. Example: SQLAlchemy and row locks",
          "ink": "purple"
        },
        {
          "type": "code",
          "lang": "python",
          "lines": [
            "RR = 'REPEATABLE READ'",
            "e2 = engine.execution_options(",
            "  isolation_level=RR)",
            "async with s.begin_nested():",
            "  s.add(audit)  # SAVEPOINT"
          ],
          "note": "begin_nested() needs an outer begin()"
        },
        {
          "type": "bullets",
          "items": [
            "`execution_options()` returns a ==copy== of the engine; the original is unchanged",
            "Level applies to each **new** connection it checks out",
            "`begin_nested()` failure rolls back the ==savepoint== only",
            "The outer `s.begin()` can still commit the rest"
          ],
          "style": "check",
          "frame": "dashed",
          "ink": "purple"
