        {
          "type": "heading",
          "text": "☆ 4. Mistakes",
          "ink": "red"
        },
        {
          "type": "bullets",
          "items": [
            "**Sync** ORM inside `async def`: tests pass, server stalls under load",
            "One blocking `sqlite3` call delays **every** request",
            "Expecting async to speed up a slow query",
            "Treating 1000 tasks as 1000 parallel queries"
          ],
          "style": "cross",
          "frame": "dashed",
