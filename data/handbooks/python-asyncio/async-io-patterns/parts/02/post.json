      "page_title": "Async Iterator & Context Manager Protocols",
      "blocks": [
        {
          "type": "heading",
          "text": "1. Async iterator protocol",
          "ink": "green"
        },
        {
          "type": "bullets",
          "items": [
            "`__aiter__`: a **plain** def that returns `self`",
            "`async def __anext__`: returns the next item",
            "At the end it raises ==StopAsyncIteration==",
            "`async for x in it:` awaits `__anext__` on every step",
            "So it can do **I/O** between items (fetch, read, sleep)"
          ],
          "frame": "dashed",
          "ink": "green"
        },
        {
          "type": "code",
          "lang": "python",
          "lines": [
            "it = aiter(src)          # 3.10+",
            "a = await anext(it)",
            "b = await anext(it, None)",
            "# default → no StopAsyncIteration"
          ],
          "note": "anext(it, default) never raises at end"
        },
        {
          "type": "heading",
          "text": "2. Async context manager",
          "ink": "green"
        },
        {
          "type": "bullets",
          "items": [
            "`async def __aenter__(self)`: runs setup, returns the resource",
            "`async def __aexit__(self, exc_type, exc, tb)`",
            "Used with ==async with==, which awaits both ends",
            "A **truthy** return from `__aexit__` suppresses the exception",
            "Same rule as the sync `__exit__`"
          ],
          "frame": "dashed",
          "ink": "green"
        },
        {
          "type": "table",
          "headers": [
            "Sync",
            "Async"
          ],
          "rows": [
            [
              "`with`",
              "`async with`"
            ],
            [
              "`__enter__/__exit__`",
              "`__aenter__/__aexit__`"
            ],
            [
              "`for`",
              "`async for`"
            ],
            [
              "`__iter__/__next__`",
              "`__aiter__/__anext__`"
            ],
            [
              "`next(it, d)`",
              "`await anext(it, d)`"
            ]
          ],
          "frame": "solid"
        },
        {
          "type": "code",
          "lang": "python",
          "lines": [
            "@asynccontextmanager",
            "async def conn(url):",
            "    c = await connect(url) # setup",
            "    try: yield c           # body",
            "    finally: await c.close()"
          ],
          "note": "cleanup in finally runs on errors too"
        },
        {
          "type": "code",
          "lang": "python",
          "lines": [
            "async with AsyncExitStack() as s:",
            "  enter = s.enter_async_context",
            "  cs = [await enter(conn(u))",
            "        for u in urls]",
            "# on exit: closes all, LIFO"
          ],
          "note": "N context managers chosen at runtime"
        },
        {
          "type": "heading",
          "text": "4. Example: paginated API client",
          "ink": "blue"
        },
        {
          "type": "code",
          "lang": "python",
          "lines": [
            "async def __anext__(self):",
            "  if not self.buf and self.url:",
            "    await self._load_page()  # I/O",
            "  if not self.buf:",
            "    raise StopAsyncIteration",
            "  return self.buf.pop(0)"
          ],
          "note": "fetches only when the buffer is empty"
        },
        {
          "type": "table",
          "headers": [
            "Step",
            "buf",
            "url",
            "action"
