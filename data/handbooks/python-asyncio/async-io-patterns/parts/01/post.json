          "type": "code",
          "lang": "python",
          "lines": [
            "async def take(self):",
            "  while self.tokens < 1:",
            "    await asyncio.sleep(0.01)",
            "    self.refill()  # +rate*dt",
            "  self.tokens -= 1"
          ],
          "note": "allows bursts up to capacity"
        },
