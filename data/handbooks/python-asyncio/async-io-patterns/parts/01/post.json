            "    \"example.com\", 80)",
            "w.write(b\"PING\\n\")",
            "await w.drain()",
            "reply = await r.readline()",
            "w.close(); await w.wait_closed()"
          ],
          "note": "open_connection comes from asyncio"
        },
        {
          "type": "bullets",
          "items": [
            "One `(reader, writer)` pair per connection",
            "`readline()` returns `b''` once the peer closes",
            "Wrap reads in `asyncio.timeout()` so a ==dead peer== can't hang you"
          ],
          "style": "dot",
          "frame": "dashed",
          "ink": "blue"
