      "blocks": [
        {
          "type": "qa",
          "q": "My future returns `Pending` and never runs again. Why?",
          "a_bullets": [
            "It returned `Pending` without registering a waker",
            "Nothing will ever put the task back on the ready queue",
            "The classic lost-wakeup bug — hangs, silently, forever"
          ],
          "example_code": [
            "if !ready { return Poll::Pending; } // BUG"
          ]
