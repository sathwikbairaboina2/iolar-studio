          "type": "code",
          "lang": "rust",
          "lines": [
            "fn load(p: &str) -> Result<Config, CfgError> {",
            "    let text = read_to_string(p)?;",
            "    let cfg = parse(&text)?;",
            "    Ok(validate(cfg)?)",
            "}"
