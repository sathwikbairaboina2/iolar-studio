        {
          "type": "code",
          "lang": "rust",
          "lines": [
            "let port = env::var(\"PORT\")",
            "    .ok()                    // Result -> Option",
            "    .and_then(|s| s.parse().ok())",
            "    .unwrap_or(8080);        // Option -> value"
          ],
          "runnable": false
        },
        {
          "type": "bullets",
          "items": [
            "Combinator chains suit linear transforms",
            "Drop to `match` when arms differ structurally",
            "Or when an arm needs several statements"
