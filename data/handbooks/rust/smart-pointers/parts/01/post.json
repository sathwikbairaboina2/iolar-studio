        {
          "type": "bullets",
          "items": [
            "Struct that owns data and acts like a pointer",
            "Runs cleanup code when it drops",
            "`&T` borrows and never owns anything",
            "`Box<T>`, `Rc<T>`, `String`, `Vec<T>` own their heap buffer"
          ]
        },
