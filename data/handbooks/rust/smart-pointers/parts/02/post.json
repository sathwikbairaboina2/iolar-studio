          ]
        },
        {
          "type": "bullets",
          "items": [
            "Both are runtime panics, never compile errors",
            "Shrink the guard's scope with a block",
            "Or split into a read phase, then a write phase",
            "Clone the value out, drop the guard, write back"
          ]
        },
        {
          "type": "code",
          "lang": "rust",
          "lines": [
            "let v = self.c.borrow().clone();  // read",
            "let out = expensive(v);           // no guard",
            "*self.c.borrow_mut() = out;       // write",
            "// two short borrows beat one long one"
          ]
        }
      ]
