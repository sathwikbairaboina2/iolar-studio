            "Cost"
          ],
          "rows": [
            [
              "`&mut`",
              "compile time",
              "free"
            ],
            [
              "`Cell`",
              "no refs handed out",
              "~free"
            ],
            [
              "`RefCell`",
              "1 writer or N readers",
              "counter check"
            ],
            [
              "`Mutex`",
              "1 accessor at a time",
              "atomic + park"
            ],
            [
              "`RwLock`",
              "N readers or 1 writer",
              "atomic + park"
            ]
          ]
        },
        {
          "type": "heading",
          "text": "Every Error Has Three Lines",
          "ink": "red"
        },
        {
          "type": "bullets",
          "items": [
            "Line where the borrow starts.",
            "Line of the conflicting action.",
            "Line of the borrow's later use.",
            "Kill the third and it very often compiles."
          ]
        },
        {
          "type": "code",
          "lang": "rust",
          "lines": [
            "let first = &v[0];   // 1 starts",
            "v.push(4);           // 2 conflict",
            "println!(\"{first}\"); // 3 later use"
          ],
          "note": "E0502 — push may reallocate"
        },
        {
          "type": "callout",
          "style": "sticky",
          "title": "Why Push Is Rejected",
          "text": "`push` can ==reallocate== the buffer, leaving `first` dangling. In C that is a silent **use-after-free**; rustc refuses to compile it."
        }
      ]
    },
