      "blocks": [
        {
          "type": "heading",
          "text": "Clone Keeps The Source"
        },
        {
          "type": "code",
          "lang": "rust",
          "lines": [
            "let a = String::from(\"hi\");",
            "let b = a.clone(); // deep copy",
            "println!(\"{a} {b}\"); // both ok"
          ],
          "note": "allocates and copies every byte"
        },
        {
          "type": "bullets",
          "items": [
            "`clone()` is explicit, so the cost is visible in code.",
            "Copy types never need it — assignment already duplicates.",
            "Borrow first; clone only when you truly need two owners."
          ],
          "style": "checkbox"
        },
        {
          "type": "heading",
          "text": "What The Guarantee Costs"
        },
        {
          "type": "diagram",
          "kind": "cards",
          "spec": {
            "cards": [
