              "`f64` `&T` `[i32;4]`",
              "source stays valid"
            ],
            [
              "Move",
              "`String` `Vec<T>`",
              "source invalidated"
            ],
            [
              "Clone",
              "`a.clone()`",
              "explicit deep copy"
            ]
          ]
        },
        {
          "type": "heading",
          "text": "The Problem It Solves"
        },
        {
          "type": "bullets",
          "items": [
            "Passing a `String` to a function moves it away.",
            "Without borrows you return it back just to reuse it.",
            "Borrow = temporary access, no ownership taken.",
            "Owner keeps the job of dropping the value."
          ]
        },
        {
          "type": "code",
          "lang": "rust",
          "lines": [
            "fn len(s: &String) -> usize { s.len() }",
            "let owned = String::from(\"iolar\");",
            "let n = len(&owned); // borrow, not move",
            "println!(\"{owned} {n}\"); // owned still usable"
          ]
        },
        {
          "type": "heading",
          "text": "Syntax And Deref"
        },
        {
          "type": "bullets",
          "items": [
            "`&value` creates a reference to the value.",
            "`*r` dereferences it back to the referent.",
            "`.` auto-derefs, so `r.len()` works on `&String`.",
            "References are non-owning: dropping one frees nothing."
          ]
        },
        {
          "type": "sidebox",
          "title": "Three Bugs Killed At Compile Time",
          "items": [
            "Use-after-free: referent outlived by its reference.",
            "Double-free: two owners dropping one allocation.",
            "Data races: a writer aliased by any other access."
          ],
          "ink": "red"
        },
