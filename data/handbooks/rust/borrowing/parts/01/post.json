      "blocks": [
        {
          "type": "heading",
          "text": "Two At Once Is E0499"
        },
        {
          "type": "code",
          "lang": "rust",
          "lines": [
            "let a = &mut v;",
            "let b = &mut v;  // E0499: second mutable borrow",
            "a.push(1);       // <- a's later use is the proof"
          ]
        },
        {
          "type": "heading",
          "text": "Implicit Reborrows",
          "ink": "blue"
        },
        {
          "type": "code",
          "lang": "rust",
          "lines": [
            "fn bump(x: &mut Vec<i32>) {}",
            "let r = &mut v;",
            "bump(r);   // reborrows *r",
            "r.push(2); // r still usable"
          ],
          "note": "not a move: callee gets `&mut *r`"
        },
        {
          "type": "bullets",
          "items": [
            "Passing `r: &mut T` ==reborrows== `*r` instead of moving it.",
            "Generic targets may move `r`: write `&mut *r` explicitly.",
            "The reborrow ends when the callee returns."
          ]
        },
        {
          "type": "heading",
          "text": "Split Borrows",
          "ink": "green"
        },
        {
          "type": "code",
          "lang": "rust",
          "lines": [
            "let a = &mut s.x;",
            "let b = &mut s.y; // disjoint: ok",
            "let (l, r) = v.split_at_mut(2);",
            "l[0] += r[0]; // no overlap"
          ]
        },
        {
          "type": "bullets",
          "items": [
            "`fn x_mut(&mut self)` borrows **all** of `self`, not one field.",
            "`&mut v[0]` and `&mut v[1]` conflict via `IndexMut`.",
            "`split_at_mut` uses unsafe inside — checker can't prove it."
          ],
          "style": "cross"
        },
