      "blocks": [
        {
          "type": "heading",
          "text": "Ownership In Three Lines",
          "ink": "blue"
        },
        {
          "type": "bullets",
          "items": [
            "Each value has exactly one owner, always.",
            "Owner goes out of scope, value is dropped.",
            "`let b = a;` moves a non-Copy value out of `a`.",
            "Touching `a` after the move is E0382 use of moved value."
          ]
        },
        {
          "type": "code",
          "lang": "rust",
          "lines": [
            "let a = String::from(\"hi\");",
            "let b = a;        // a is moved out",
            "// println!(\"{a}\"); // E0382",
            "println!(\"{b}\"); // b owns the bytes now"
          ]
        },
        {
          "type": "heading",
          "text": "Copy Versus Clone",
          "ink": "green"
        },
        {
          "type": "table",
          "headers": [
            "Kind",
