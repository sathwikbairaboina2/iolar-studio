        },
        {
          "type": "code",
          "lang": "rust",
          "lines": [
            "let mut v = vec![1];",
            "let r = &mut v;",
            "*r = vec![9];   // write through the deref",
            "r.push(3);      // or call a &mut self method"
          ]
        },
        {
          "type": "heading",
          "text": "Why Exclusivity Pays",
