    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "In Spring Boot, application.properties sets server.port=8080, the environment sets SERVER_PORT=9090, and the app starts as shown. Which port does it listen on?",
              "example_code": [
                "# application.properties: server.port=8080",
                "export SERVER_PORT=9090",
                "java -jar app.jar --server.port=7070"
              ],
              "a_bullets": [
                "Answer: 7070.",
                "CLI args beat env vars, which beat file and server values."
              ]
            },
            {
              "type": "qa",
              "q": "Spot the bug: this gives a 25% rollout. Why does a user flip between variants?",
              "example_code": [
                "if (random() < 0.25) newCheckout()"
              ],
              "a_bullets": [
                "Answer: it is random per request, so there is no stable key.",
                "Hash user ID + flag key instead, so each user is sticky."
              ]
            },
            {
              "type": "qa",
              "q": "A pod reads LOG_LEVEL from a ConfigMap through an env var. You edit the ConfigMap to `debug`, but the pod still logs at `info`. Why, and what fixes it?",
              "a_bullets": [
                "Answer: env vars are fixed at container start.",
                "Run `kubectl rollout restart deploy/app` to pick up the new value."
              ]
            }
          ]
        }
