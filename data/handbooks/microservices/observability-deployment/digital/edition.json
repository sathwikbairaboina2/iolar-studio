    {
      "title": "Observability Mental Model",
      "role": "outline",
      "outlineIndex": 0,
      "pages": [
        {
          "title": "Observability Mental Model",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Three Pillars",
              "ink": "green"
            },
            {
              "type": "table",
              "headers": [
                "Pillar",
                "What it is",
                "Answers"
              ],
              "rows": [
                [
                  "{green:Logs}",
                  "discrete events",
                  "What happened?"
                ],
                [
                  "{blue:Metrics}",
                  "aggregated numbers over time",
                  "How much, how often?"
                ],
                [
                  "{purple:Traces}",
                  "one request's path across services",
                  "Where did time go?"
                ]
              ]
            },
            {
              "type": "bullets",
              "items": [
                "==Monitoring==: known questions, via dashboards and alerts",
                "==Observability==: ask **new** questions about unknown failures",
                "It needs rich telemetry: all three pillars together"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "heading",
              "text": "2. Logs and Metrics",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "Emit ==JSON== with **fixed keys**, not free text",
                "Keys: `timestamp`, `level`, `service`, `message`, `trace_id`",
                "Result: logs are queryable and filterable"
              ],
              "style": "check"
            },
            {
              "type": "code",
              "lang": "json",
              "lines": [
                "{\"timestamp\":\"2026-03-01T10:15:02Z\",\"level\":\"error\",\"service\":\"orders\",\"message\":\"payment timeout\",\"trace_id\":\"4bf92f35\"}"
              ]
            },
            {
              "type": "table",
              "headers": [
                "Type",
                "Behaviour",
                "Use"
              ],
              "rows": [
                [
                  "{blue:Counter}",
                  "only goes up",
                  "query with `rate()`"
                ],
                [
                  "{green:Gauge}",
                  "up and down",
                  "queue depth"
                ],
                [
                  "{purple:Histogram}",
                  "bucketed values",
                  "percentiles"
                ]
              ]
            },
            {
              "type": "heading",
              "text": "3. Choosing Signals",
              "ink": "purple"
            },
            {
              "type": "bullets",
              "items": [
                "==RED== for services: **R**ate, **E**rrors, **D**uration",
                "==USE== for resources: **U**tilization, **S**aturation, **E**rrors"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "purple"
            }
          ]
        }
      ]
    },
    {
      "title": "Tracing, Correlation IDs and Health Checks",
      "role": "outline",
      "outlineIndex": 1,
      "pages": [
        {
          "title": "Tracing, Correlation IDs and Health Checks",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Correlation ID and Traces",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "==Correlation ID==: unique ID made at the **edge**, or reused from the incoming header",
                "Passed on every downstream call and ==log line== to stitch one request together",
                "A {blue:trace} is a **tree of spans**",
                "Each span: `trace_id`, `span_id`, `parent_span_id`, ==start time==, ==duration=="
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "heading",
              "text": "2. Propagation and Log Link",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "Context travels in the W3C ==traceparent== header",
                "Format: `version-trace_id-parent_id-flags`",
                "**OpenTelemetry** = standard SDK and export format",
                "Put `trace_id` in every log line: jump from a log to its full trace"
              ],
              "style": "dot"
            },
            {
              "type": "code",
              "lang": "text",
              "lines": [
                "traceparent: 00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01"
              ]
            },
            {
              "type": "code",
              "lang": "json",
              "lines": [
                "{\"level\":\"error\",\"service\":\"orders\",",
                "\"trace_id\":\"4bf92f35\",\"msg\":\"payment timeout\"}"
              ]
            },
            {
              "type": "heading",
              "text": "3. Health Probes",
              "ink": "purple"
            },
            {
              "type": "table",
              "headers": [
                "Probe",
                "On failure"
              ],
              "rows": [
                [
                  "{red:Liveness}",
                  "container is **restarted**"
                ],
                [
                  "{orange:Readiness}",
                  "removed from **Service endpoints**"
                ],
                [
                  "{blue:Startup}",
                  "delays the other two until boot ends"
                ]
              ],
              "frame": "dashed"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Async hops break traces",
              "text": "Dropping the header on queues or threads **breaks the trace**. Copy the context into ==message headers==."
            }
          ]
        }
      ]
    },
    {
      "title": "Containers and Kubernetes Core",
      "role": "outline",
      "outlineIndex": 2,
      "pages": [
        {
          "title": "Containers and Kubernetes Core",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Containers and Objects",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "Container = ==isolated process== sharing the **host kernel**",
                "{blue:Namespaces} = isolation; {orange:cgroups} = resource limits",
                "==Image== = immutable layered filesystem; container = its running instance"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "table",
              "headers": [
                "Object",
                "Role"
              ],
              "rows": [
                [
                  "**Pod**",
                  "smallest unit, one or more containers"
                ],
                [
                  "**Deployment**",
                  "manages ReplicaSets and rolling updates"
                ],
                [
                  "**Service**",
                  "stable virtual IP and DNS for pods"
                ],
                [
                  "**Ingress**",
                  "HTTP routing in"
                ],
                [
                  "**ConfigMap / Secret**",
                  "config"
                ]
              ],
              "frame": "dashed"
            },
            {
              "type": "heading",
              "text": "2. Control Loop and Resources",
              "ink": "blue"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "Declare",
                    "sub": "desired state",
                    "ink": "blue"
                  },
                  {
                    "text": "Reconcile",
                    "sub": "controllers fix drift",
                    "ink": "green"
                  },
                  {
                    "text": "Schedule",
                    "sub": "nodes fit requests",
                    "ink": "purple"
                  }
                ]
              }
            },
            {
              "type": "table",
              "headers": [
                "",
                "Requests",
                "Limits"
              ],
              "rows": [
                [
                  "Used for",
                  "scheduling",
                  "runtime enforcement"
                ],
                [
                  "Memory exceeded",
                  "-",
                  "{red:OOMKilled}"
                ],
                [
                  "CPU exceeded",
                  "-",
                  "{orange:throttled}"
                ]
              ]
            },
            {
              "type": "heading",
              "text": "3. Rolling Update",
              "ink": "orange"
            },
            {
              "type": "bullets",
              "items": [
                "==Default== Deployment strategy: replace pods gradually",
                "`maxUnavailable` = pods allowed down; `maxSurge` = extra pods allowed above desired"
              ],
              "style": "check"
            },
            {
              "type": "code",
              "lang": "bash",
              "lines": [
                "kubectl set image deployment/web web=app:1.2",
                "kubectl rollout status deployment/web",
                "kubectl rollout undo deployment/web"
              ],
              "note": "undo reverts to the previous ReplicaSet"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Remember",
              "text": "Requests **schedule**, limits **enforce**. Over memory limit = ==OOMKilled==; over CPU limit = throttled, not killed."
            }
          ]
        }
      ]
    },
    {
      "title": "Release Strategies: Rolling, Blue-Green, Canary",
      "role": "outline",
      "outlineIndex": 3,
      "pages": [
        {
          "title": "Release Strategies: Rolling, Blue-Green, Canary",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Blue-Green and Canary",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "==Blue-green==: two identical environments, deploy to the idle one",
                "Test it, then flip the switch: Service `selector` or load balancer",
                "Rollback = flip back; cost = {red:double capacity}"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "==Canary==: send **1-5%** of traffic to the new version",
                "Watch {red:error rate} and {orange:latency}",
                "Step up to 100%, or abort"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "heading",
              "text": "2. Which One?",
              "ink": "purple"
            },
            {
              "type": "table",
              "headers": [
                "",
                "Cost",
                "Rollback",
                "Exposure"
              ],
              "rows": [
                [
                  "**Rolling**",
                  "{green:cheapest}",
                  "{red:slow}",
                  "mixed versions"
                ],
                [
                  "**Blue-green**",
                  "{red:2x capacity}",
                  "{green:instant flip}",
                  "all-or-nothing"
                ],
                [
                  "**Canary**",
                  "small extra",
                  "abort the slice",
                  "{green:smallest blast radius}, needs metrics"
                ]
              ],
              "highlightRow": 2
            },
            {
              "type": "heading",
              "text": "3. Automated Canary Analysis",
              "ink": "orange"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "Shift 5%",
                    "sub": "new version",
                    "ink": "blue"
                  },
                  {
                    "text": "Query metrics",
                    "sub": "vs thresholds",
                    "ink": "purple"
                  },
                  {
                    "text": "Pass: step up",
                    "sub": "to 100%",
                    "ink": "green"
                  },
                  {
                    "text": "Fail: rollback",
                    "sub": "no human",
                    "ink": "red"
                  }
                ]
              }
            },
            {
              "type": "bullets",
              "items": [
                "==Argo Rollouts==, ==Flagger==: thresholds decide, not human judgement"
              ],
              "style": "check"
            },
            {
              "type": "heading",
              "text": "4. Mistakes",
              "ink": "red"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Schema changes",
              "text": "A database schema change breaks one of the two live versions. Use ==expand-and-contract== migrations so old and new code both work."
            }
          ]
        }
      ]
    },
