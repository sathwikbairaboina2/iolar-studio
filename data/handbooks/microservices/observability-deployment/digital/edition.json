    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "A liveness probe calls `/health`, which pings the database. The database goes down for a minute. What happens to the pods?",
              "a_bullets": [
                "Every pod fails liveness at once, so Kubernetes restarts them all: a restart storm.",
                "Restarting fixes nothing. Check dependencies in readiness, and keep liveness to the process itself."
              ]
            },
            {
              "type": "qa",
              "q": "Service A calls B over HTTP with a `traceparent` header. B publishes to a queue. The consumer's logs show a new trace_id. Why?",
              "a_bullets": [
                "The context was dropped at the async hop.",
                "Copy the trace context into the message headers, and have the consumer read it back."
              ]
            },
            {
              "type": "qa",
              "q": "You deploy blue-green, and the migration renames column `name` to `full_name`. Green errors, so you flip back to blue. What happens?",
              "a_bullets": [
                "Blue still queries `name`, so it fails too. The flip is not a safe rollback.",
                "Use expand-and-contract: add the new column first, and drop the old one only after the cutover."
              ]
            }
          ]
        }
      ]
    }
  ]
