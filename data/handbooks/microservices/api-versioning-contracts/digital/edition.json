                  },
                  {
                    "text": "Data",
                    "sub": "corrupted silently",
                    "ink": "red"
                  }
                ]
              }
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Worst break",
              "text": "Same field name, ==new meaning==: no schema check fails. Add a new field instead of changing `amount`."
            }
          ]
        }
