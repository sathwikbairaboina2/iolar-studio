        {
          "title": "Compatibility Fundamentals and Mental Model",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Two Directions",
              "ink": "green"
            },
            {
              "type": "table",
              "headers": [
                "",
                "Reader",
                "Data from",
                "Upgrade first"
              ],
              "rows": [
                [
                  "==Backward==",
                  "new",
                  "old",
                  "consumers"
                ],
                [
                  "==Forward==",
                  "old",
                  "new",
                  "producers"
                ],
                [
                  "==Full==",
                  "both",
                  "any mix",
                  "any order"
                ]
              ]
            },
            {
              "type": "bullets",
              "items": [
                "==Full== = backward + forward at once",
                "Needed when producers and consumers **deploy independently**",
                "Rollout order is out of your control"
              ],
              "style": "check",
              "ink": "green"
            },
            {
              "type": "heading",
              "text": "2. Breaking vs Safe",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "Change",
                "Verdict"
              ],
              "rows": [
                [
                  "Remove or rename a field",
                  "{red:breaking}"
                ],
                [
                  "Change a type",
                  "{red:breaking}"
                ],
                [
                  "Optional becomes required",
                  "{red:breaking}"
                ],
                [
                  "Change semantics or error codes",
                  "{red:breaking}"
                ],
                [
                  "Add an optional field",
                  "{green:safe}"
                ],
                [
                  "Add a new endpoint",
                  "{green:safe}"
                ],
                [
                  "Add an enum value",
                  "{orange:safe only if consumers tolerate unknowns}"
                ]
              ]
            },
            {
              "type": "heading",
              "text": "3. The Silent Break",
              "ink": "red"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "Old amount",
                    "sub": "1999 = cents",
                    "ink": "blue"
                  },
                  {
                    "text": "New amount",
                    "sub": "19.99 = dollars",
                    "ink": "orange"
                  },
                  {
                    "text": "Schema check",
                    "sub": "passes",
