          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "A calls B, B calls C. Each layer makes 3 attempts per request. C is down. How many calls reach C per request to A?",
              "a_bullets": [
                "**9**: each of A's 3 attempts makes 3 attempts at B.",
                "Retry at one layer only, or the multiplication grows."
              ]
            },
            {
              "type": "qa",
              "q": "A breaker opens at 50% failures over 20 calls, minimum 10 calls. The first 3 calls fail. Open or closed?",
              "a_bullets": [
                "**Closed**: 3 calls is below the minimum volume.",
                "Without a minimum, one failure (100%) would trip it."
              ]
            },
            {
              "type": "qa",
              "q": "A service gets 100 req/s. Latency rises from 50 ms to 5 s. A pool of 50 threads was fine before. What now?",
              "a_bullets": [
                "In flight = rate x latency: 5 before, **500** now.",
                "The pool exhausts and callers queue. Slow is worse than down."
              ]
            }
          ]
        }
