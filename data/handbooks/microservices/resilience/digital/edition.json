                  },
                  "o": {
                    "text": "Open: fail fast",
                    "shape": "box",
                    "ink": "red"
                  },
                  "h": {
                    "text": "Half-Open: trial calls",
                    "shape": "box",
                    "ink": "orange"
                  }
