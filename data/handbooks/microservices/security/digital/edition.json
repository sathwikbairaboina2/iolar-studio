    {
      "title": "Service-to-Service Auth and mTLS",
      "role": "outline",
      "outlineIndex": 2,
      "pages": [
        {
          "title": "Service-to-Service Auth and mTLS",
          "blocks": [
            {
              "type": "heading",
              "text": "1. mTLS and Identity",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "A private network is ==not proof of identity==",
                "Options: mTLS, service JWT ({blue:Client Credentials}), or **both**",
                "One-way TLS authenticates only the server",
                "mTLS: ==both sides== present X.509 certs, checked against a trusted CA"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "Client hello",
                    "ink": "blue"
                  },
                  {
                    "text": "Server cert",
                    "sub": "client verifies CA",
                    "ink": "green"
                  },
                  {
                    "text": "Client cert",
                    "sub": "server verifies CA",
                    "ink": "purple"
                  },
                  {
                    "text": "Encrypted channel",
                    "ink": "orange"
                  }
                ]
              }
            },
            {
              "type": "bullets",
              "items": [
                "Identity lives in the cert: ==SPIFFE ID== `spiffe://prod/ns/payments/sa/api`",
                "Issued by **SPIRE** or the mesh CA"
              ],
              "style": "dot"
            },
            {
              "type": "heading",
              "text": "2. Mesh and Tokens",
              "ink": "purple"
            },
            {
              "type": "table",
              "headers": [
                "",
                "mTLS",
                "JWT"
              ],
              "rows": [
                [
                  "Proves",
                  "which **service** calls",
                  "which **user** it acts for"
                ],
                [
                  "Layer",
                  "transport",
                  "request"
                ],
                [
                  "Production",
                  "use ==both==",
                  "use ==both=="
                ]
              ]
            },
            {
              "type": "bullets",
              "items": [
                "Istio, Linkerd sidecars do mTLS transparently",
                "Short-lived certs, issued and rotated automatically"
              ],
              "style": "check"
            },
            {
              "type": "code",
              "lang": "yaml",
              "lines": [
                "kind: PeerAuthentication",
                "spec:",
                "  mtls:",
                "    mode: STRICT"
              ],
              "note": "STRICT rejects plaintext; PERMISSIVE allows both during migration"
            },
            {
              "type": "heading",
              "text": "3. Mistakes",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "Long-lived certs with no rotation",
                "Mesh left on PERMISSIVE forever",
                "Skipping cert chain and expiry checks"
              ],
              "style": "cross",
              "frame": "dashed",
              "ink": "red"
            }
          ]
        }
      ]
    },
