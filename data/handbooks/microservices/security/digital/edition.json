    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "A token has a valid signature and is unexpired, but its aud is 'payments'. The orders service receives it. What happens?",
              "a_bullets": [
                "It is rejected with 401, using the RFC 6750 error `invalid_token`.",
                "Some gateways answer 403, but the token is never accepted."
              ]
            },
            {
              "type": "qa",
              "q": "The orders service returns orders for the X-User-Id header that callers send. What is the bug?",
              "a_bullets": [
                "Headers are spoofable, so any caller can read another user's orders (BOLA).",
                "Strip it at the gateway and use the verified token `sub`."
              ]
            },
            {
              "type": "qa",
              "q": "Istio PeerAuthentication is PERMISSIVE. A pod with no sidecar calls payments in plaintext. Result?",
              "a_bullets": [
                "Allowed: PERMISSIVE accepts both plaintext and mTLS.",
                "STRICT would reject it."
              ]
            }
          ]
        }
      ]
    }
