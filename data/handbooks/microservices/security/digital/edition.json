          "blocks": [
            {
              "type": "heading",
              "text": "1. Zero Trust",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "Never trust ==network location==",
                "Authenticate + authorize ==every request==",
                "{red:Assume breach}",
                "Grant ==least privilege=="
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "blue"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "Identity",
                    "sub": "workload",
                    "ink": "blue"
                  },
                  {
                    "text": "mTLS",
                    "sub": "everywhere",
                    "ink": "green"
                  },
                  {
                    "text": "Policy",
                    "sub": "per request",
                    "ink": "purple"
                  },
                  {
                    "text": "NetworkPolicy",
                    "sub": "default-deny",
                    "ink": "orange"
                  },
                  {
                    "text": "Logging",
                    "sub": "continuous",
                    "ink": "black"
                  }
                ]
              }
            },
            {
              "type": "heading",
              "text": "2. Secrets",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "Keep in a ==secrets manager==: Vault, AWS Secrets Manager, K8s Secrets (encrypted at rest)",
                "Never in code, images or Git",
                "Prefer ==dynamic secrets==: short-lived DB creds per service",
                "Fetch at runtime with workload identity (IAM role, service account)",
                "==Rotate== regularly; never log secrets"
              ],
              "style": "check"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "Service account",
                    "sub": "identity",
                    "ink": "blue"
                  },
                  {
                    "text": "Vault",
                    "sub": "checks policy",
                    "ink": "purple"
                  },
                  {
                    "text": "DB creds",
                    "sub": "TTL + lease",
                    "ink": "green"
                  },
                  {
                    "text": "Revoked",
                    "sub": "on expiry",
                    "ink": "red"
                  }
                ]
              }
            },
            {
              "type": "heading",
              "text": "3. Mistakes",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "Secrets in env vars baked into images",
                "One shared secret for all services",
                "Committed `.env` files",
                "No rotation plan"
              ],
              "style": "cross",
              "frame": "dashed",
              "ink": "red"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "K8s Secrets",
              "text": "Only ==base64-encoded== by default, not encrypted. Enable encryption at rest."
            },
            {
              "type": "sidebox",
              "title": "Interview Point",
              "items": [
                "**Zero trust?** Verify every request, ignore network location.",
                "**Why dynamic secrets?** Short TTL, per-service, auto-revoked.",
                "**Where do secrets live?** Secrets manager, fetched at runtime."
              ],
              "ink": "orange"
            }
          ]
        }
      ]
    },
    {
