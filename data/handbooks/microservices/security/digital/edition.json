    {
      "title": "Auth Mental Model and Edge Authentication",
      "role": "outline",
      "outlineIndex": 0,
      "pages": [
        {
          "title": "Auth Mental Model and Edge Authentication",
          "blocks": [
            {
              "type": "heading",
              "text": "1. AuthN vs AuthZ",
              "ink": "green"
            },
            {
              "type": "table",
              "headers": [
                "",
                "authN",
                "authZ"
              ],
              "rows": [
                [
                  "Question",
                  "Who are you?",
                  "What may you do?"
                ],
                [
                  "Fails with",
                  "{red:401} Unauthorized",
                  "{red:403} Forbidden"
                ],
                [
                  "Caller state",
                  "unknown or bad credentials",
                  "known, but not allowed"
                ]
              ],
              "frame": "dashed"
            },
            {
              "type": "heading",
              "text": "2. Edge Authentication",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "==API gateway== = the single entry point",
                "Credentials validated **once**, bad traffic rejected before services",
                "Also: ==rate limiting== (429) and **TLS termination**",
                "Strips client-sent identity headers like `X-User-Id` so they can't be {red:spoofed}"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "blue"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "Signature",
                    "sub": "valid key",
                    "ink": "blue"
                  },
                  {
                    "text": "iss / aud",
                    "sub": "issuer, audience",
                    "ink": "purple"
                  },
                  {
                    "text": "exp / nbf",
                    "sub": "time window",
                    "ink": "orange"
                  },
                  {
                    "text": "Forward",
                    "sub": "identity attached",
                    "ink": "green"
                  }
                ]
              }
            },
            {
              "type": "heading",
              "text": "3. Example: Bearer JWT",
              "ink": "purple"
            },
            {
              "type": "bullets",
              "items": [
                "Client sends the JWT in the `Authorization` header",
                "Gateway checks it against the IdP's ==JWKS endpoint==",
                "Keys are **cached**, refreshed on an unknown `kid`"
              ],
              "style": "number"
            },
            {
              "type": "code",
              "lang": "http",
              "lines": [
                "GET /orders/42 HTTP/1.1",
                "Authorization: Bearer <JWT>"
              ],
              "note": "gateway validates, then forwards identity"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Never trust inbound identity headers",
              "text": "Strip `X-User-Id` from clients; only the gateway sets it, after the token is ==verified=="
            }
          ]
        }
      ]
    },
    {
      "title": "JWT and OAuth2 Token Propagation",
      "role": "outline",
      "outlineIndex": 1,
      "pages": [
        {
          "title": "JWT and OAuth2 Token Propagation",
          "blocks": [
            {
              "type": "heading",
              "text": "1. JWT and signing",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "==header.payload.signature==, base64url-encoded",
                "Payload is signed, {red:NOT encrypted}: no secrets in claims",
                "Claims: `sub` `iss` `aud` `exp` `iat` `scope`/roles",
                "Access token 5-15 min, plus a refresh token"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "",
                "HS256",
                "RS256 / ES256"
              ],
              "rows": [
                [
                  "Key",
                  "one shared secret",
                  "private signs, public (JWKS) verifies"
                ],
                [
                  "Services can mint?",
                  "{red:yes}",
                  "{green:no, verify only}"
                ]
              ]
            },
            {
              "type": "heading",
              "text": "2. Flows and propagation",
              "ink": "purple"
            },
            {
              "type": "bullets",
              "items": [
                "{green:Auth Code + PKCE}: users and SPAs",
                "{blue:Client Credentials}: machine-to-machine",
                "{red:Avoid} Implicit and Password flows"
              ],
              "style": "check"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "User token",
                    "sub": "aud=gateway",
                    "ink": "blue"
                  },
                  {
                    "text": "Token Exchange",
                    "sub": "RFC 8693",
                    "ink": "purple"
                  },
                  {
                    "text": "Narrow token",
                    "sub": "aud=orders",
                    "ink": "green"
                  }
                ]
              }
            },
            {
              "type": "table",
              "headers": [
                "",
                "Opaque",
                "JWT"
              ],
              "rows": [
                [
                  "Check",
                  "introspection (RFC 7662)",
                  "local signature"
                ],
                [
                  "Revoke",
                  "{green:instant}",
                  "{red:hard before exp}"
                ]
              ]
            },
            {
              "type": "heading",
              "text": "3. Mistakes",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "Accepting `alg=none`",
                "Skipping `aud` / `iss` checks",
                "Trusting a decoded, unverified token",
                "Long-lived tokens; tokens in localStorage"
              ],
              "style": "cross",
              "ink": "red"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Confused deputy",
              "text": "Forwarding one broad token to every hop lets any service replay it. ==Exchange== per hop for a narrow, audience-restricted token."
            }
          ]
        }
      ]
