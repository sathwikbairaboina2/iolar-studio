      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "A consumer runs `balance += 50` for each message from an at-least-once broker. It crashes before acking. What happens?",
              "a_bullets": [
                "The broker redelivers the message, so the balance is credited twice.",
                "Fix: save the message ID under a unique constraint in the same transaction, or use an idempotent write."
              ]
            },
            {
              "type": "qa",
              "q": "Three sync services each have 99.9% availability. Roughly how available is the chain?",
              "a_bullets": [
                "About 99.7% (0.999^3), which is worse than any single link.",
                "A broker lets the caller keep accepting work during a downstream outage."
              ]
            },
            {
              "type": "qa",
              "q": "Events for order 7 go to a 3-partition topic with random keys. Why can OrderPaid arrive before OrderPlaced?",
              "a_bullets": [
                "Kafka guarantees ordering only within one partition.",
                "Key by orderId so all events for that order share a partition."
              ]
            }
          ]
        }
      ]
