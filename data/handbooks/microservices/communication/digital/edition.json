      "pages": [
        {
          "title": "Sync vs Async Mental Model",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Two ways to talk",
              "ink": "green"
            },
            {
              "type": "table",
              "headers": [
                "",
                "Sync request/response",
                "Async messaging"
              ],
              "rows": [
                [
                  "Caller",
                  "**blocks** until reply",
                  "publishes to broker, ==moves on=="
                ],
                [
                  "Callee",
                  "must be up now",
                  "processes **later**"
                ],
                [
                  "Coupling",
                  "{red:time + availability}",
                  "{green:decoupled in time}"
                ]
              ],
              "frame": "dashed"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "Caller",
                    "sub": "waits",
                    "ink": "blue"
                  },
                  {
                    "text": "Callee",
                    "sub": "replies",
                    "ink": "green"
                  }
                ]
              }
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "Producer",
                    "sub": "publish",
                    "ink": "blue"
                  },
                  {
                    "text": "Broker",
                    "sub": "stores",
                    "ink": "orange"
                  },
                  {
                    "text": "Consumer",
                    "sub": "later",
                    "ink": "green"
                  }
                ]
              }
            },
            {
              "type": "heading",
              "text": "2. Availability math",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "Sync chain of N services at 99.9% each ≈ ==99.9%^N== overall",
                "10 services in a chain ≈ **99.0%**, so more downtime",
                "A ==broker absorbs== downstream outages: messages wait",
                "Latency of a sync chain ==adds up== hop by hop"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "blue"
            },
            {
              "type": "heading",
              "text": "3. Which one to pick",
              "ink": "purple"
            },
            {
              "type": "table",
              "headers": [
                "Pick",
                "When",
                "Examples"
              ],
              "rows": [
                [
                  "{blue:Sync}",
                  "caller needs the answer **now**",
                  "reads, auth checks"
                ],
                [
                  "{orange:Async}",
                  "work can finish **later**",
                  "emails, billing, fan-out"
                ]
              ],
              "highlightRow": 0
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Common mistake",
              "text": "Chaining sync calls across many services causes ==cascading failures== and added latency. Fix: **timeouts**, **circuit breakers**, or async events."
            }
          ]
        }
      ]
    },
