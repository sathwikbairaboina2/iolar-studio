    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "Orders and Payments share one database, each with its own deploy pipeline. Payments renames a column. What happens, and what is this called?",
              "a_bullets": [
                "Orders breaks, so the two must coordinate releases",
                "A **distributed monolith**: microservice costs, no independent deploys",
                "Fix: Payments owns its data; Orders uses its API or events"
              ]
            },
            {
              "type": "qa",
              "q": "Checkout calls Payments, which calls Inventory. Inventory fails after Payments charged the card. How do you restore consistency?",
              "a_bullets": [
                "No cross-service ACID transaction exists",
                "Use a **saga**: run a compensating action, such as a refund",
                "Orchestrate via a coordinator or choreograph via events"
              ]
            },
            {
              "type": "qa",
              "q": "A team of 4 engineers has an unclear domain. They plan 12 services. What is wrong, and what is the better start?",
              "a_bullets": [
                "Boundaries guessed early are wrong and costly to move",
                "More services than engineers: tracing and CI/CD overhead",
                "Start with a **modular monolith**, extract only on clear pain"
              ]
            }
          ]
        }
      ]
