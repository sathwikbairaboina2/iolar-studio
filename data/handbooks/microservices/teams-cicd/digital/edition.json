    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "A company has separate UI, backend and database teams. Adding one field to a form needs all three. What does Conway's law predict, and what is the fix?",
              "a_bullets": [
                "Layered architecture with hand-offs between the three teams, so every feature is slow.",
                "Reorganise into stream-aligned teams that each own a feature end to end (inverse Conway)."
              ]
            },
            {
              "type": "qa",
              "q": "Orders and Billing teams share one database. Billing renames a column in its own deploy. What happens?",
              "a_bullets": [
                "Orders breaks at runtime: hidden coupling, and the change needed cross-team coordination.",
                "Fix: each service owns its data and exposes an API."
              ]
            },
            {
              "type": "qa",
              "q": "A monorepo pipeline has `on: push` with no paths filter. A one-line change lands in `services/orders`. What runs?",
              "a_bullets": [
                "Every service's build and tests run, not just orders.",
                "Fix: `paths: ['services/orders/**']` so only the changed service builds."
              ]
            }
          ]
        }
      ]
