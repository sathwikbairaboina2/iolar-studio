          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "The SLO is 99.9%. For one hour, 1.44% of requests fail. What is the burn rate, and how much of the 30-day budget is gone?",
              "a_bullets": [
                "Burn rate = 0.0144 ÷ 0.001 = **14.4**",
                "One hour is 1/720 of 30 days, so 14.4/720 = **2%** of the budget"
              ]
            },
            {
              "type": "qa",
              "q": "At 3am a page fires for CPU above 90%, but users see no errors. What should change?",
              "a_bullets": [
                "It is a cause, not a symptom, and no human action is needed",
                "Move it to a dashboard or ticket, and page on SLO burn instead"
              ]
            },
            {
              "type": "qa",
              "q": "With a 99.9% SLO, a 20-minute outage and a 30-minute bad release happen in one month. What does the budget policy say?",
              "a_bullets": [
                "The budget is about 43 minutes, and 50 minutes were spent",
                "It is exhausted, so freeze feature releases and do reliability work"
              ]
            }
