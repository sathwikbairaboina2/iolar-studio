    {
      "title": "On-Call and Runbooks",
      "role": "outline",
      "outlineIndex": 3,
      "pages": [
        {
          "title": "On-Call and Runbooks",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Healthy Rotation",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "==Primary== plus ==secondary== on every shift",
                "Written **handoff notes** at each change",
                "{green:Follow-the-sun} if the team spans time zones",
                "Cap at about ==2 pages== per shift"
              ],
              "style": "check",
              "ink": "green"
            },
            {
              "type": "heading",
              "text": "2. Runbooks",
              "ink": "blue"
            },
            {
              "type": "diagram",
              "kind": "chain",
              "spec": {
                "title": "Every alert links to one",
                "steps": [
                  {
                    "text": "Meaning",
                    "ink": "blue"
                  },
                  {
                    "text": "Impact",
                    "ink": "orange"
                  },
                  {
                    "text": "Verify",
                    "ink": "purple"
                  },
                  {
                    "text": "Mitigate",
                    "ink": "green"
                  },
                  {
                    "text": "Escalate",
                    "note": "contact",
                    "ink": "red"
                  }
                ]
              }
            },
            {
              "type": "bullets",
              "items": [
                "Steps are ==copy-pasteable== commands",
                "Rehearse and test them in **game days**"
              ],
              "style": "dot"
            },
            {
              "type": "code",
              "lang": "bash",
              "lines": [
                "kubectl rollout undo deploy/api",
                "kubectl rollout status deploy/api"
              ],
              "note": "rollback, then confirm"
            },
            {
              "type": "heading",
              "text": "3. Mitigate, Then Reduce Toil",
              "ink": "purple"
            },
            {
              "type": "table",
              "headers": [
                "Mitigation",
                "Use when"
              ],
              "rows": [
                [
                  "==Rollback==",
                  "bad deploy"
                ],
                [
                  "==Failover==",
                  "zone or node down"
                ],
                [
                  "==Flag off==",
                  "new feature misbehaves"
                ]
              ]
            },
            {
              "type": "bullets",
              "items": [
                "Track **toil** and pages per engineer",
                "Recurring page: fix it or ==automate== the runbook step"
              ],
              "style": "dot"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Mitigate first",
              "text": "Rollback, failover or flag-off beats debugging live. ==Root cause later==."
            }
          ]
        }
      ]
    },
