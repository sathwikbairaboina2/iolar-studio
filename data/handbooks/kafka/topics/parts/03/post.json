          "lines": [
            "replication.factor=3",
            "min.insync.replicas=2   # refuse below 2 copies",
            "acks=all                # producer side",
            "enable.idempotence=true # default in 3.0+"
          ]
        },
        {
          "type": "heading",
          "text": "Picking min.insync"
        },
        {
          "type": "table",
          "headers": [
            "RF / min.isr",
            "One broker down"
          ],
          "rows": [
            [
              "3 / 1",
              "writes ok, durability theatre"
            ],
            [
              "3 / 2",
              "writes ok, 2 copies held"
            ],
            [
              "3 / 3",
              "topic stops accepting writes"
            ]
          ]
        },
        {
          "type": "callout",
          "style": "takeaway",
          "title": "Always True",
          "text": "Raising min.insync.replicas increases durability and decreases write availability. There is no setting where it does both."
        },
        {
          "type": "heading",
          "text": "Idempotent Producer"
        },
        {
          "type": "bullets",
          "items": [
            "Adds a producer id plus a per-partition sequence number.",
            "Retries then cannot duplicate or reorder a record.",
            "Requires `max.in.flight.requests.per.connection` <= 5.",
            "Without it, in-flight > 1 plus retries can reorder."
          ]
        },
        {
          "type": "heading",
          "text": "Group Anatomy",
          "ink": "blue"
        }
      ]
    },
    {
      "page_title": "ISR & The Durability Contract (cont.)",
      "blocks": [
        {
          "type": "bullets",
          "items": [
            "Group = consumers sharing a `group.id`.",
            "The group owns every partition exactly once.",
            "Group coordinator: a broker, tracks membership.",
            "Group leader: a consumer, computes the assignment."
          ]
        },
        {
