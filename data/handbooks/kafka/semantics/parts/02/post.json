    {
      "page_title": "Summary and Decision Cheat Sheet",
      "blocks": [
        {
          "type": "heading",
          "text": "Worked Example: Idempotent Sink"
        },
        {
          "type": "code",
          "lang": "java",
          "lines": [
            "var key = topic + \"-\" + part + \"-\" + off;",
            "db.upsert(key, payload); // replay safe",
            "// same key twice = one row, not two"
          ]
        },
        {
          "type": "bullets",
          "items": [
            "Deterministic key: (topic, partition, offset)",
            "Or any business key you already own",
            "A replay rewrites the same row",
            "No transaction needed at the sink"
          ]
        },
        {
          "type": "callout",
          "style": "tip",
          "title": "Shortest Correct Path",
          "text": "Kafka Streams wires producer, offsets and state stores together with `processing.guarantee=exactly_once_v2`. One line, brokers 2.5+."
        },
        {
          "type": "heading",
          "text": "The Three Config Sets"
        },
        {
          "type": "table",
