              "ledgers, billing"
            ]
          ]
        },
        {
          "type": "bullets",
          "items": [
            "At-least-once is the correct default",
            "Exactly-once only when the sink can't dedupe",
            "Idempotence kills producer-retry duplicates",
            "Transactions kill partial multi-partition writes",
            "`read_committed` kills aborted reads"
          ]
        },
        {
          "type": "heading",
          "text": "Worked Example: Outbox Relay"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "BEGIN;",
            "INSERT INTO orders VALUES (...);",
            "INSERT INTO outbox VALUES (...);",
            "COMMIT; -- relay ships outbox rows"
          ]
        },
        {
          "type": "sidebox",
          "title": "Monitor These Four",
          "items": [
            "Consumer lag and LSO lag",
            "Transaction abort rate",
            "Producer `record-error-rate`",
            "Rebalance rate per group"
          ]
        },
        {
          "type": "callout",
          "style": "takeaway",
          "title": "Final Principle",
          "text": "Pick the weakest guarantee your correctness needs allow, then make it airtight. Nothing Kafka offers makes a non-idempotent external side effect exactly-once."
        }
      ]
