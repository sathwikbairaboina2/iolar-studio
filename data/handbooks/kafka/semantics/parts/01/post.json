              "at-most-once",
              "highest",
              "lowest"
            ],
            [
              "at-least-once",
              "~95%",
              "no loss"
            ],
            [
              "exactly-once",
              "80-95%",
              "full"
            ]
          ]
        },
        {
          "type": "sidebox",
          "title": "Decision Guide",
          "items": [
            "Start with at-least-once plus an idempotent sink",
            "Reach for transactions only if the sink can't dedupe",
            "100ms commit interval is a sane starting size"
          ]
        },
        {
          "type": "qa",
          "q": "Why did EOS halve my throughput?",
          "a_bullets": [
            "Transactions too small: coordinator cost dominates",
            "Raise `linger.ms`, batch more per transaction",
            "Check rebalance rate — each abort replays work"
          ]
        },
        {
          "type": "heading",
          "text": "Durability Lies",
          "ink": "red"
        },
        {
          "type": "bullets",
          "items": [
            "`acks=all` with `min.insync.replicas=1` is not durable",
            "A single-replica window loses committed data",
            "`unclean.leader.election.enable=true` in an HA config",
            "It trades committed data for uptime"
          ]
        }
      ]
