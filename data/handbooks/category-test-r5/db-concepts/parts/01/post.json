    {
      "page_title": "Indexing",
      "blocks": [
        {
          "type": "concept",
          "number": 1,
          "title": "Indexing",
          "tagline": "a sorted shortcut to rows"
        },
        {
          "type": "labelrows",
          "rows": [
            {
              "icon": "database",
              "label": "What it is:",
              "text": "A sorted B-tree mapping column values to row locations."
            },
            {
              "icon": "zap",
              "label": "Why it exists:",
              "text": "Skips the full scan: O(n) becomes O(log n), ~3-4 page reads."
            },
            {
              "icon": "table",
              "label": "Used for:",
              "text": "WHERE, JOIN keys, ORDER BY, unique constraints, primary keys."
            }
          ]
        },
        {
          "type": "heading",
          "text": "How it works",
          "style": "ribbon"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "CREATE INDEX idx_orders_user_date",
            "  ON orders(user_id, created_at);",
            "SELECT * FROM orders",
            "WHERE user_id = 42",
            "ORDER BY created_at DESC",
            "LIMIT 10;"
          ],
          "note": "one tree walk, no sort step",
          "result": {
            "headers": [
              "step",
              "cost"
            ],
            "rows": [
              [
                "walk tree to 42",
                "3-4 reads"
              ],
              [
                "read entries",
                "10, pre-sorted"
              ],
              [
                "sort step",
                "none"
              ],
              [
                "10M-row scan",
                "avoided"
              ]
            ]
          }
        },
        {
          "type": "bullets",
          "items": [
            "==Reads== drop from seconds to milliseconds",
            "**Sorted** output comes for free",
            "A ==covering index== answers without touching the table"
          ],
          "style": "check",
          "frame": "solid",
          "ink": "green"
        },
        {
          "type": "bullets",
          "items": [
            "Every index slows **INSERT**/UPDATE/DELETE and uses disk",
            "Column order matters: __leftmost prefix__ rule",
            "Low-cardinality columns (boolean) gain little",
            "`LOWER(email)` on the column bypasses the index"
          ],
          "style": "cross",
          "frame": "solid",
          "ink": "red"
        },
        {
          "type": "callout",
          "style": "banner",
          "title": "Interview takeaway:",
          "text": "Index the columns you filter, join and sort on; put the most **selective** equality column first.\nSay it out loud: you pay for faster reads with slower writes."
        }
      ],
      "hero": "database",
      "aside": "read fast, write slow",
      "subtitle": "B-tree lookups"
    },
    {
      "page_title": "Transactions",
      "blocks": [
        {
          "type": "concept",
          "number": 3,
          "title": "Transactions",
          "tagline": "one unit of work"
        },
        {
          "type": "labelrows",
          "rows": [
            {
              "icon": "database",
              "label": "What it is:",
              "text": "Reads and writes applied as one unit: COMMIT or ROLLBACK"
            },
            {
              "icon": "zap",
              "label": "Why it exists:",
              "text": "A crash between two writes leaves money debited, never credited"
            },
            {
              "icon": "shield-check",
              "label": "Used for:",
              "text": "Payments, order plus inventory, any multi-row invariant"
            }
          ]
        },
        {
          "type": "heading",
          "text": "How it works",
          "style": "ribbon"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "BEGIN;",
            "UPDATE accounts SET bal = bal - 100",
            " WHERE id = 1;",
            "UPDATE accounts SET bal = bal + 100",
            " WHERE id = 2;",
            "COMMIT;"
          ],
          "note": "2nd UPDATE fails: ROLLBACK, bal restored",
          "result": {
            "headers": [
              "id",
              "bal before",
              "bal after"
            ],
            "rows": [
              [
                "1",
                "500",
                "400"
              ],
              [
                "2",
                "200",
                "300"
              ]
            ]
          }
        },
        {
          "type": "bullets",
          "items": [
            "==All-or-nothing== changes, never half-updated",
            "A consistent view of the data while you work",
            "The ==WAL== makes committed work survive a crash"
          ],
          "style": "check",
          "frame": "solid",
          "ink": "green"
        },
        {
          "type": "bullets",
          "items": [
            "Long transactions hold locks and bloat the log: keep them **short**, never wait on user input",
            "Spanning several services needs ==sagas or 2PC==, not one BEGIN",
            "Retry on deadlock or serialization errors"
          ],
          "style": "cross",
          "frame": "solid",
          "ink": "red"
        },
        {
          "type": "callout",
          "style": "banner",
          "title": "Interview takeaway:",
          "text": "Wrap every multi-step invariant in one short transaction.\nIt does not stretch across microservices."
        }
      ],
      "hero": "database",
      "aside": "keep it short!",
      "subtitle": "All or nothing"
    },
    {
      "page_title": "ACID",
      "blocks": [
        {
          "type": "concept",
          "number": 3,
          "title": "ACID",
          "tagline": "A, C, I, D"
        },
        {
          "type": "labelrows",
          "rows": [
            {
              "icon": "shield-check",
              "label": "What it is:",
              "text": "Four guarantees a transaction gives: **A**, **C**, **I**, **D**."
            },
            {
              "icon": "lightbulb",
              "label": "Why it exists:",
              "text": "Simple model: a transaction happens fully or not at all."
            },
            {
              "icon": "database",
              "label": "Used for:",
              "text": "Choosing a datastore: banking, orders, inventory need ACID."
            }
          ]
        },
        {
          "type": "heading",
          "text": "How it works",
          "style": "ribbon"
        },
        {
          "type": "table",
          "headers": [
            "Letter",
            "Guarantee",
            "Mechanism"
          ],
          "rows": [
            [
              "**A**tomicity",
              "all or nothing",
              "undo log (rollback)"
            ],
            [
              "**C**onsistency",
              "invariants hold",
              "CHECK bal >= 0, FK, UNIQUE"
            ],
            [
              "**I**solation",
              "no interference",
              "locks or MVCC"
            ],
            [
              "**D**urability",
              "survives crash",
              "WAL fsync before COMMIT"
            ]
          ],
          "frame": "solid"
        },
        {
          "type": "bullets",
          "items": [
            "Correct under failure",
            "DB enforces invariants, not app code",
            "Predictable under concurrency"
          ],
          "style": "check",
          "frame": "solid",
          "ink": "green"
        },
        {
          "type": "bullets",
          "items": [
            "Costs latency: fsync per commit, locks",
            "C in ACID is not C in CAP",
            "NoSQL trades it for scale (BASE)",
            "Isolation is a dial, not a switch"
          ],
          "style": "cross",
          "frame": "solid",
          "ink": "red"
        },
        {
          "type": "callout",
          "style": "banner",
          "title": "Interview takeaway:",
          "text": "Name each letter with a mechanism: undo log, constraints, MVCC/locks, WAL.\nSay when you would relax ACID: feed counters, caches."
        }
      ],
      "hero": "database",
      "aside": "all or nothing",
      "subtitle": "Four guarantees"
    },
    {
      "page_title": "Isolation Levels",
      "blocks": [
        {
          "type": "concept",
          "number": 4,
          "title": "Isolation Levels",
          "tagline": "a dial, not a switch"
        },
        {
          "type": "labelrows",
          "rows": [
            {
              "icon": "eye",
              "label": "What it is:",
              "text": "How much one transaction sees of other concurrent transactions' changes."
            },
            {
              "icon": "gauge",
              "label": "Why it exists:",
              "text": "Full isolation is slow, so weaker levels trade anomalies for throughput."
            },
            {
              "icon": "sliders",
              "label": "Used for:",
              "text": "Per workload: Read Committed for OLTP, Serializable for money."
            }
          ]
        },
        {
          "type": "heading",
          "text": "How it works",
          "style": "ribbon"
        },
        {
          "type": "diagram",
          "kind": "tables",
          "spec": {
            "tables": [
              {
                "title": "Setup: accounts, balance = 100",
                "headers": [
                  "Step",
                  "Session",
                  "Action"
                ],
                "rows": [
                  [
                    "1",
                    "T1",
                    "BEGIN; SELECT bal → 100"
                  ],
                  [
                    "2",
                    "T2",
                    "UPDATE bal = 50; COMMIT"
                  ],
                  [
                    "3",
                    "T1",
                    "SELECT bal again"
                  ]
                ]
              },
              {
                "title": "T1's second read at step 3",
                "headers": [
                  "Level",
                  "Returns",
                  "Anomaly"
                ],
                "rows": [
                  [
                    "Read Committed",
                    "**50**",
                    "non-repeatable read"
                  ],
                  [
                    "Repeatable Read",
                    "**100**",
                    "none, snapshot kept"
                  ]
                ]
              }
            ],
            "arrow": true
          }
        },
        {
          "type": "bullets",
          "items": [
            "{green:Read Committed} blocks dirty reads",
            "{green:Repeatable Read} blocks non-repeatable reads",
            "{green:Serializable} blocks every anomaly, even write skew",
            "A dial between ==speed== and ==safety=="
          ],
          "style": "check",
          "frame": "solid",
          "ink": "green"
        },
        {
          "type": "bullets",
          "items": [
            "Postgres defaults to Read Committed, InnoDB to Repeatable Read",
            "Stricter levels abort more: retry on SQLSTATE `40001`",
            "**Write skew** slips past Repeatable Read: two on-call doctors both leave"
          ],
          "style": "cross",
          "frame": "solid",
          "ink": "red"
        },
        {
          "type": "callout",
          "style": "banner",
          "title": "Interview takeaway:",
          "text": "Name the 3 anomalies: dirty read, non-repeatable read, phantom. Map each level to what it stops, then pick the weakest level that keeps your invariant safe."
        }
      ],
      "aside": "pick the weakest!",
      "subtitle": "The speed-safety dial"
    },
    {
      "page_title": "MVCC",
      "blocks": [
        {
          "type": "concept",
          "number": 6,
          "title": "MVCC",
          "tagline": "snapshots, not locks"
        },
        {
          "type": "labelrows",
          "rows": [
            {
              "icon": "database",
              "label": "What it is:",
              "text": "Keeps several row versions; each transaction reads from a snapshot"
            },
            {
              "icon": "zap",
              "label": "Why it exists:",
              "text": "Readers never block writers, writers never block readers"
            },
            {
              "icon": "lock",
              "label": "Used for:",
              "text": "Postgres, InnoDB, Oracle snapshot reads; Read Committed, Repeatable Read"
            }
          ]
        },
        {
          "type": "heading",
          "text": "How it works",
          "style": "ribbon"
        },
        {
          "type": "diagram",
          "kind": "tables",
          "spec": {
            "tables": [
              {
                "title": "users, after txn 120 runs UPDATE ... SET plan='pro' WHERE id=7",
                "headers": [
                  "id",
                  "plan",
                  "xmin",
                  "xmax"
                ],
                "rows": [
                  [
                    "7",
                    "free",
                    "90",
                    "**120**"
                  ],
                  [
                    "7",
                    "pro",
                    "**120**",
                    "-"
                  ]
                ],
                "caption": "Reader with snapshot before 120 sees plan='free'; txn 120 and later see 'pro'"
              }
            ],
            "arrow": false
          }
        },
        {
          "type": "bullets",
          "items": [
            "==Benefits==: no read locks, so high read concurrency",
            "Consistent point-in-time snapshots",
            "Long reports do not stall writers"
          ],
          "style": "check",
          "frame": "solid",
          "ink": "green"
        },
        {
          "type": "bullets",
          "items": [
            "==Things to consider==: dead tuples pile up; need VACUUM or purge",
            "Long transactions pin old versions and cause bloat",
            "Write-write conflicts on one row still need locks"
          ],
          "style": "cross",
          "frame": "solid",
          "ink": "red"
        },
        {
          "type": "callout",
          "style": "banner",
          "title": "Interview takeaway:",
          "text": "MVCC trades extra storage and cleanup for **non-blocking reads**.\nThat is why long transactions hurt even when they only read."
        }
      ],
      "hero": "database",
      "aside": "readers never wait",
      "subtitle": "Many row versions"
    },
    {
      "page_title": "Locking",
      "blocks": [
        {
          "type": "concept",
          "number": 7,
          "title": "Locking",
          "tagline": "who writes first?"
        },
        {
          "type": "labelrows",
          "rows": [
            {
              "icon": "lock",
              "label": "What it is:",
              "text": "A txn claims a row; **S** locks for reads, **X** for writes"
            },
            {
              "icon": "shield-check",
              "label": "Why it exists:",
              "text": "MVCC can't settle two writers on one row; locks serialize them"
            },
            {
              "icon": "database",
              "label": "Used for:",
              "text": "Lost updates, seat booking, job queues via `FOR UPDATE SKIP LOCKED`"
            }
          ]
        },
        {
          "type": "heading",
          "text": "How it works",
          "style": "ribbon"
        },
        {
          "type": "table",
          "headers": [
            "Step",
            "Txn A",
            "Txn B"
          ],
          "rows": [
            [
              "1",
              "`SELECT stock FROM items WHERE id=5 FOR UPDATE` (stock 1)",
              "waits"
            ],
            [
              "2",
              "stock=0, **COMMIT**",
              "same query: **blocks**, then sees 0"
            ],
            [
              "3",
              "Optimistic: `UPDATE items SET stock=stock-1, version=version+1 WHERE id=5 AND version=3`",
              "0 rows changed: **retry**"
            ]
          ],
          "highlightRow": 1,
          "frame": "solid"
        },
        {
          "type": "bullets",
          "items": [
            "Pessimistic locks stay safe under ==high contention==",
            "Optimistic version checks are cheap and lock-free when conflicts are rare",
            "Both prevent ==lost updates==, so stock 1 is never sold twice"
          ],
          "style": "check",
          "frame": "solid",
          "ink": "green"
        },
        {
          "type": "bullets",
          "items": [
            "==Deadlock==: opposite lock order, so lock in a **consistent** order",
            "DB aborts one victim: you must **retry** it",
            "Hold locks briefly; never wait on a user inside one",
            "Table locks and escalation kill concurrency"
          ],
          "style": "cross",
          "frame": "solid",
          "ink": "red"
        },
        {
          "type": "callout",
          "style": "banner",
          "title": "Interview takeaway:",
          "text": "Pessimistic locks for hot contended rows, optimistic versions for rare conflicts.\nAlways mention deadlock avoidance (fixed lock order) and retry."
        }
      ],
      "hero": "lock",
      "aside": "lock it, then leave",
      "subtitle": "Serialize the writers"
    },
    {
      "page_title": "Connection Pooling",
      "blocks": [
        {
          "type": "concept",
          "number": 8,
          "title": "Connection Pooling"
        },
        {
          "type": "labelrows",
          "rows": [
            {
              "icon": "database",
              "label": "What it is:",
              "text": "A cache of open connections the app borrows and returns"
            },
            {
              "icon": "zap",
              "label": "Why it exists:",
              "text": "Each new connection costs a handshake, auth and a Postgres process"
            },
            {
              "icon": "server",
              "label": "Used for:",
              "text": "Web services, PgBouncer, RDS Proxy and HikariCP"
            }
          ]
        },
        {
          "type": "heading",
          "text": "How it works",
          "style": "ribbon"
        },
        {
          "type": "diagram",
          "kind": "flow",
          "spec": {
            "nodes": [
              {
                "text": "App instances",
                "sub": "many requests",
                "ink": "blue"
              },
              {
                "text": "Pool of 20",
                "sub": "10 ms per query",
                "ink": "orange"
              },
              {
                "text": "Database",
                "sub": "≈2,000 qps",
                "ink": "green"
              }
            ]
          }
        },
        {
          "type": "bullets",
          "items": [
            "Benefits",
            "{icon:check} No per-request handshake cost",
            "A hard cap on DB load",
            "Lower latency, steadier memory"
          ],
          "style": "check",
          "frame": "solid",
          "ink": "green"
        },
        {
          "type": "bullets",
          "items": [
            "More connections is not faster: start at cores x 2 plus disks",
            "Instances x pool size must stay below `max_connections`",
            "PgBouncer transaction mode breaks prepared statements and `SET`",
            "Leaked connections drain the pool"
          ],
          "style": "cross",
          "frame": "solid",
          "ink": "red"
        },
        {
          "type": "callout",
          "style": "banner",
          "title": "Interview takeaway:",
          "text": "Size the pool small and check instances x pool size against the DB limit.\nAlways return connections in a `finally` block."
        }
      ],
      "hero": "database",
      "aside": "keep it small!",
      "subtitle": "Borrow, don't open"
    },
    {
      "page_title": "Partitioning",
      "blocks": [
        {
          "type": "concept",
          "number": 9,
          "title": "Partitioning",
          "tagline": "one table, many pieces"
        },
        {
          "type": "labelrows",
          "rows": [
            {
              "icon": "table",
              "label": "What it is:",
              "text": "One big table split into physical pieces by range, list or hash."
            },
            {
              "icon": "zap",
              "label": "Why it exists:",
              "text": "Huge tables make scans, vacuum and deletes slow; small pieces are cheap."
            },
            {
              "icon": "database",
              "label": "Used for:",
              "text": "Time-series, logs, retention drops, queries always filtering on one key."
            }
          ]
        },
        {
          "type": "heading",
          "text": "How it works",
          "style": "ribbon"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "CREATE TABLE events (",
            "  id bigint, created_at date,",
            "  payload jsonb",
            ") PARTITION BY RANGE (created_at);",
            "-- one partition per month: events_2026_03",
            "SELECT * FROM events",
            "WHERE created_at = '2026-03-05';"
          ],
          "note": "pruning reads only events_2026_03",
          "result": {
            "headers": [
              "Partition",
              "Scanned?"
            ],
            "rows": [
              [
                "events_2026_02",
                "no"
              ],
              [
                "events_2026_03",
                "yes"
              ],
              [
                "events_2026_04",
                "no"
              ]
            ]
          }
        },
        {
          "type": "bullets",
          "items": [
            "==Partition pruning== cuts the data scanned",
            "`DROP TABLE events_2025_01` removes a month instantly",
            "Smaller indexes per partition fit in memory"
          ],
          "style": "check",
          "frame": "solid",
          "ink": "green"
        },
        {
          "type": "bullets",
          "items": [
            "No partition key in WHERE scans **every** partition",
            "A poor key makes hot partitions: all today's data in one",
            "Create partitions ahead of time",
            "Adds no machines: that is sharding's job"
          ],
          "style": "cross",
          "frame": "solid",
          "ink": "red"
        },
        {
          "type": "callout",
          "style": "banner",
          "title": "Interview takeaway:",
          "text": "Partitioning splits data within one node for speed and manageability; sharding splits it across nodes to scale out.\nPick the partition key from your query pattern."
        }
      ],
      "hero": "database",
      "aside": "prune, don't scan!",
      "subtitle": "Split inside one node"
    },
    {
      "page_title": "Replication",
      "blocks": [
        {
          "type": "concept",
          "number": 9,
          "title": "Replication",
          "tagline": "same data, many servers"
        },
        {
          "type": "labelrows",
          "rows": [
            {
              "icon": "server",
              "label": "What it is:",
              "text": "One primary takes writes; replicas apply its changes."
            },
            {
              "icon": "shield-check",
              "label": "Why it exists:",
              "text": "Survive node failure, serve more reads, sit near users."
            },
            {
              "icon": "zap",
              "label": "Used for:",
              "text": "Read replicas, failover standby, cross-region disaster recovery."
            }
          ]
        },
        {
          "type": "heading",
          "text": "How it works",
          "style": "ribbon"
        },
        {
          "type": "diagram",
          "kind": "tables",
          "spec": {
            "tables": [
              {
                "title": "Primary (WAL)",
                "headers": [
                  "Time",
                  "Event"
                ],
                "rows": [
                  [
                    "0 ms",
                    "INSERT comment #88"
                  ],
                  [
                    "1 ms",
                    "WAL streamed out"
                  ]
                ],
                "caption": "write goes here"
              },
              {
                "title": "Replica (200 ms behind)",
                "headers": [
                  "Time",
                  "Event"
                ],
                "rows": [
                  [
                    "200 ms",
                    "applies comment #88"
                  ],
                  [
                    "50 ms",
                    "user reloads: #88 missing"
                  ]
                ],
                "caption": "stale read; fix: read own writes from primary for a few seconds"
              }
            ],
            "arrow": true
          }
        },
        {
          "type": "bullets",
          "items": [
            "==Synchronous== mode means **no data loss**",
            "==Asynchronous== keeps writes fast",
            "Read throughput scales with replica count",
            "Failover gives high availability"
          ],
          "style": "check",
          "frame": "solid",
          "ink": "green"
        },
        {
          "type": "bullets",
          "items": [
            "Replication ==lag== gives stale reads",
            "Async failover can lose the last commits",
            "Failover needs leader election; **split-brain** risk",
            "Scales reads, not writes; multi-leader needs conflict resolution"
          ],
          "style": "cross",
          "frame": "solid",
          "ink": "red"
        },
        {
          "type": "callout",
          "style": "banner",
          "title": "Interview takeaway:",
          "text": "Replication gives availability and read scale, not write scale.\nState sync vs async trade-off; handle read-your-writes explicitly."
        }
      ],
      "hero": "database",
      "aside": "reads scale, writes don't",
      "subtitle": "Copies for availability"
