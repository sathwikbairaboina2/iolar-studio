              "**0**",
              "clean exit"
            ],
            [
              "**1**",
              "app error"
            ],
            [
              "**137**",
              "SIGKILL or OOM killed"
            ],
            [
              "**139**",
              "segfault"
            ],
            [
              "**143**",
              "SIGTERM"
            ]
          ],
          "highlightRow": 2
        },
        {
          "type": "callout",
          "style": "tip",
          "title": "No shell inside?",
          "text": "Use `docker debug`, or a sidecar sharing --pid and --network."
        },
        {
          "type": "callout",
