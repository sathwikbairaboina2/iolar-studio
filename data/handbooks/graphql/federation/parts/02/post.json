        {
          "type": "callout",
          "style": "takeaway",
          "title": "Own The Join",
          "text": "If two subgraphs bounce a query back and forth, the domain boundary is wrong. Move the join into one service instead of tuning the hops."
        },
        {
          "type": "heading",
          "text": "Three Subgraphs",
          "ink": "blue"
        },
        {
          "type": "code",
          "lang": "graphql",
          "lines": [
            "# accounts",
            "type User @key(fields: \"id\") {",
            "  id: ID!  name: String! }",
            "type Query { me: User }"
          ],
          "runnable": false
        }
      ]
