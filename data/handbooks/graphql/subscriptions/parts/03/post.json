            [
              "per user",
              "concurrent connections"
            ],
            [
              "per subscriber",
              "events per second"
            ],
            [
              "per document",
              "cost times event rate"
            ]
          ]
        },
        {
          "type": "bullets",
          "items": [
            "Rate limiting moves from requests to connections",
            "A depth-5 selection set executes on EVERY event",
            "True cost is query cost multiplied by event rate"
          ]
        },
        {
          "type": "callout",
          "style": "takeaway",
          "title": "Denial of wallet",
          "text": "Thousands of cheap subscriptions to one high-volume topic turn your fan-out into your invoice. Cap subscriptions before an attacker finds the ceiling."
        },
        {
          "type": "heading",
          "text": "Fan-Out Is The Number",
          "ink": "blue"
        },
        {
          "type": "bullets",
          "items": [
            "One publish times N subscribers = N executions",
            "Plus N serializations of the same shape",
            "CPU grows with subscriber count, not with write rate"
          ]
        }
      ]
    },
