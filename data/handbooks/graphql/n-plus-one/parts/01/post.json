                "shape": "box"
              },
              "c0_0": {
                "text": "`.load(7)`",
                "shape": "box"
              },
              "c1_0": {
                "text": "`.load(7)`",
                "shape": "box"
              },
              "c2_0": {
                "text": "one fetch",
                "shape": "box"
              }
            },
            "edges": [
              {
                "from": "n0",
                "to": "b0"
              },
              {
                "from": "n0",
                "to": "b1"
              },
              {
                "from": "n0",
                "to": "b2"
              },
              {
                "from": "b0",
                "to": "c0_0"
              },
              {
                "from": "b1",
                "to": "c1_0"
              },
              {
                "from": "b2",
                "to": "c2_0"
              }
            ]
          }
        },
        {
          "type": "code",
          "lang": "js",
          "lines": [
            "// fresh loaders per request",
            "context: ({ req }) => ({",
            "  loaders: createLoaders(db, tenant(req))",
            "})"
          ]
        },
        {
          "type": "callout",
          "style": "tip",
          "title": "Never At Module Scope",
          "text": "A module-scope loader caches across requests, so viewer A's rows reach viewer B. A real security bug, not a style nit."
        },
        {
          "type": "heading",
          "text": "Keys Are Identity"
        },
        {
          "type": "bullets",
          "items": [
            "Keys compare with `===`, strict identity",
            "`{id:1} !== {id:1}` — object keys always miss",
            "`cacheKeyFn: k => JSON.stringify([k.tenant, k.id])`",
            "Any stable string works for composite keys"
          ]
        },
        {
          "type": "heading",
          "text": "Controls"
        },
        {
          "type": "table",
          "headers": [
            "Call",
            "Effect"
          ],
          "rows": [
            [
              "`cache: false`",
              "batch only, fresh rows"
            ],
            [
              "`clear(k)`",
              "refetch later this request"
            ],
            [
              "`prime(k,v)`",
              "seed from rows you have"
            ],
            [
              "`cacheMap`",
              "custom Map-like store"
            ]
          ]
        },
        {
          "type": "bullets",
          "items": [
            "`prime` is a no-op if the key already exists",
            "`clear(k)` then `prime(k,v)` to overwrite",
            "Rejections cache too — a bad load stays bad",
            "Clear in the batch catch to avoid poisoning",
            "`cacheMap` opens LRU or cross-request reuse"
          ]
        },
        {
          "type": "sidebox",
          "title": "Lifetime",
          "items": [
            "Scope is one request, by construction",
            "Dies with the response — no invalidation work",
            "`cache: false` fits mutations needing fresh rows",
            "Cross-request `cacheMap` reintroduces the leak risk"
          ]
        },
        {
          "type": "heading",
          "text": "The Factory Is The Pattern",
          "ink": "blue"
        },
        {
          "type": "code",
          "lang": "js",
          "lines": [
            "context: ({ req }) => ({",
            "  loaders: createLoaders(db, tenant(req))",
            "}) // fresh object of loaders per call",
            "author: (post, _, { loaders }) =>",
            "  loaders.userById.load(post.authorId)"
          ]
        }
      ]
    },
    {
      "page_title": "Wiring DataLoader Into a Real Server",
      "blocks": [
        {
          "type": "heading",
          "text": "One-To-Many Batching"
        },
        {
          "type": "code",
          "lang": "js",
          "lines": [
            "// SELECT ... WHERE author_id IN (ids)",
            "const m = new Map(ids.map(i => [i, []]))",
            "rows.forEach(r => m.get(r.authorId).push(r))",
            "return ids.map(i => m.get(i)) // [] if none"
          ]
        },
        {
          "type": "bullets",
          "items": [
            "Group rows by foreign key, one array per key",
            "Pass tenant scope into the loader factory",
            "Never let one `IN` query span tenants",
            "Batched SQL must stay scoped, always"
          ]
        },
        {
          "type": "heading",
          "text": "Authorization And Priming"
        },
        {
          "type": "bullets",
          "items": [
            "Re-check authorization per key, not per batch",
            "50 fetched rows can leak what the viewer cannot see",
            "After a list query: `users.forEach(u => prime(u.id, u))`",
            "Mutations: `clear(id)` so later reads see it"
          ]
        },
        {
          "type": "table",
          "headers": [
            "Loader lives",
            "Result"
          ],
          "rows": [
            [
              "module scope",
              "cross-request leak"
            ],
            [
              "inside a resolver",
              "no batch, no cache"
            ],
            [
              "context factory",
              "correct"
            ],
            [
              "per socket",
              "stale forever"
            ]
          ]
        },
        {
          "type": "sidebox",
          "title": "Prove It Works",
          "items": [
            "Assert batch-function call counts, not data",
            "Response shape passes while N+1 regresses",
            "Log `keys.length` on every batch call",
            "A histogram stuck at 1 means batching broke"
          ]
        },
        {
          "type": "heading",
          "text": "Beyond One Process"
        },
        {
          "type": "bullets",
          "items": [
            "Federation: batch the downstream HTTP call too",
            "One `POST /users/batch` beats 50 `GET`s",
            "Each service still needs its own loaders"
          ]
        },
        {
          "type": "code",
          "lang": "js",
          "lines": [
            "// downstream fetch, batched the same way",
            "const r = await post('/users/batch', { ids })",
            "return ids.map(i => r.byId[i] ?? null)"
          ]
        },
        {
          "type": "callout",
          "style": "takeaway",
          "title": "One Loader Per Event",
          "text": "In subscriptions a per-socket loader caches forever and goes stale. Build fresh loaders per delivered event."
        },
        {
          "type": "heading",
          "text": "The Options",
          "ink": "blue"
        },
        {
          "type": "table",
          "headers": [
            "Approach",
            "Trips",
            "Code cost",
            "Cache reuse"
          ],
          "rows": [
            [
              "naive",
              "N+1",
              "lowest",
              "none"
            ],
            [
              "DataLoader",
              "D (depth)",
              "medium",
              "per-request"
            ],
            [
              "JOIN lookahead",
              "1",
