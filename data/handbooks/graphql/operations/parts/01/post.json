  "series": "GRAPHQL OPERATIONS",
  "date": "07/09/2026",
  "slides": [
    {
      "page_title": "What an Operation Actually Is",
      "blocks": [
        {
          "type": "heading",
          "text": "Request Anatomy",
          "ink": "blue"
        },
        {
          "type": "bullets",
          "items": [
            "Document string + variables map + `operationName`",
            "Parsed into an AST before anything runs",
            "Transport is not in the spec — POST JSON is convention",
            "GET with query params works for cacheable reads"
          ]
        },
        {
          "type": "code",
          "lang": "json",
          "lines": [
            "{\"query\":\"query Ping { __typename }\",",
            "  \"variables\":{},",
            "  \"operationName\":\"Ping\"}"
          ]
        },
        {
          "type": "heading",
          "text": "Operation Types"
        },
        {
          "type": "table",
          "headers": [
            "Keyword",
            "Job",
            "Note"
          ],
          "rows": [
            [
              "`query`",
              "read",
              "parallel fields"
            ],
            [
              "`mutation`",
              "write",
              "serial at top"
            ],
            [
              "`subscription`",
              "stream",
              "long-lived events"
            ]
          ]
        },
        {
          "type": "code",
          "lang": "graphql",
          "lines": [
            "{ user { name } }  # anon: 1 query only",
            "query GetUser {    # keyword + name",
            "  user { name }    # selection set",
            "}"
          ]
        },
        {
          "type": "bullets",
          "items": [
            "Every non-leaf field MUST have a selection set",
            "Every leaf scalar/enum MUST NOT have one",
            "Shorthand legal only for a lone query in the doc"
          ]
        },
        {
          "type": "heading",
          "text": "Shape Contract"
        },
        {
          "type": "callout",
          "style": "takeaway",
          "title": "Query shape = response shape",
          "text": "No surprise fields, no missing fields. Ask for three fields, get exactly three keys back. That is the whole promise."
        },
        {
          "type": "code",
          "lang": "json",
          "lines": [
            "{ \"data\": { },        # may be partial",
            "  \"errors\": [ ],      # coexists with data",
            "  \"extensions\": { } }"
          ]
        },
        {
          "type": "heading",
          "text": "Document Rules"
        },
        {
          "type": "sidebox",
          "title": "Legal in a request",
          "items": [
            "Executable definitions: operations + fragments",
            "Type-system SDL definitions are rejected",
            "`#` comments run to end of line",
            "Commas are insignificant whitespace"
          ]
        },
        {
          "type": "bullets",
          "items": [
            "One document may hold many operations",
            "Exactly one runs — chosen by `operationName`",
            "Whole document validated BEFORE execution",
            "One bad field aborts it: zero resolvers run"
          ]
        },
        {
          "type": "code",
          "lang": "graphql",
          "lines": [
            "user(id: \"42\") {",
            "  posts(first: 10, orderBy: DATE) {",
            "    title            # args at depth",
            "  } }"
          ]
        },
        {
          "type": "code",
          "lang": "graphql",
          "lines": [
            "fragment F on T { fields }",
            "...F                 # spread",
            "... on T { fields }  # inline"
          ]
        },
        {
          "type": "heading",
          "text": "Traversal"
        },
        {
          "type": "code",
          "lang": "graphql",
          "lines": [
            "user { posts { comments {",
            "  author { name }   # arbitrary depth",
            "} } }              # still one request"
          ]
        }
      ]
    },
    {
      "page_title": "What an Operation Actually Is (cont.)",
      "blocks": [
        {
          "type": "code",
          "lang": "graphql",
          "lines": [
            "{ __schema { types { name } } }",
            "# how GraphiQL, codegen + clients",
            "# learn the schema at runtime"
          ]
        }
      ],
      "cont": true
    },
    {
      "page_title": "Nested Data in One Round Trip",
      "blocks": [
        {
          "type": "code",
          "lang": "graphql",
          "lines": [
            "query Feed($n: Int!) {",
            "  feed(first: $n) { id title",
            "    author { name } }   # one round trip",
            "}"
          ]
        }
      ]
    },
    {
      "page_title": "Entry Points & Field Arguments",
      "blocks": [
        {
          "type": "code",
          "lang": "graphql",
          "lines": [
            "key: field(args)          # alias",
            "field @include(if: $flag) # directive",
            "field @skip(if: $flag)    # inverse"
          ]
        },
        {
          "type": "qa",
          "q": "Why is `__typename` free?",
          "a_bullets": [
            "Meta-field on every object, interface, union",
            "The executor answers it — no resolver defined",
            "Client caches need it to discriminate types"
          ],
          "example_code": [
            "{ hero { __typename name } }"
          ]
        },
        {
          "type": "heading",
          "text": "Entry Points",
          "ink": "blue"
        },
        {
          "type": "bullets",
          "items": [
            "Root type is `type Query`; its fields are the doors",
            "`user`, `products`, `search` — nothing special about them",
            "Sibling fields execute in PARALLEL, reads are safe",
            "Deprecated fields still resolve; `@deprecated` is tooling-only"
          ]
        },
        {
          "type": "heading",
          "text": "Arguments"
        },
        {
          "type": "bullets",
          "items": [
            "Named, not positional — order is irrelevant",
            "`null` is a legal explicit argument value",
            "Arguments live at any depth, not just the root"
          ]
        },
        {
          "type": "table",
          "headers": [
            "Input kind",
            "Examples"
          ],
          "rows": [
            [
              "Scalars",
              "`Int` `Float` `String`"
            ],
            [
              "Identity",
              "`Boolean` `ID`"
            ],
            [
              "Composite",
              "enums, input objects"
            ],
            [
              "Lists",
              "`[ID!]` of the above"
            ]
          ]
        },
        {
          "type": "callout",
          "style": "tip",
          "title": "Same field twice is fine",
          "text": "Identical field with identical args merges into one response key. Not duplicated, not an error."
        },
        {
          "type": "heading",
          "text": "Cacheable Reads"
        },
        {
          "type": "code",
          "lang": "http",
          "lines": [
            "GET /graphql?query=...&variables=...",
            "# CDN + browser cache can hold it",
            "# POST is opaque to every cache"
          ]
        },
        {
          "type": "sidebox",
          "title": "Over-fetching is on you",
          "items": [
            "GraphQL cannot stop you asking for junk",
            "Unrendered fields still run resolvers",
            "Cost is real DB work, not just bytes"
          ]
        },
        {
          "type": "callout",
          "style": "tip",
          "title": "Non-null is contagious",
          "text": "One deep failure nulls an entire branch, sometimes all of `data`. Mark `!` only where a null is genuinely impossible."
        },
        {
          "type": "diagram",
          "kind": "flow",
          "spec": {
            "nodes": [
              "parse",
              "`a` runs",
              "`a` commits",
              "`b` runs",
              "`b` sees `a`"
            ]
          }
        }
      ]
    },
    {
      "page_title": "Nullability & the Mutation Root",
      "blocks": [
        {
          "type": "heading",
          "text": "Nullability"
        },
        {
          "type": "table",
          "headers": [
            "Type",
            "Means"
          ],
          "rows": [
            [
              "`String`",
              "null allowed"
            ],
            [
              "`String!`",
              "null nullifies parent"
            ],
            [
              "`[Post!]`",
              "list nullable, members not"
            ],
            [
              "`[Post!]!`",
              "neither nullable"
            ]
          ]
        },
        {
          "type": "heading",
          "text": "Mutation Root",
          "ink": "red"
        },
        {
          "type": "bullets",
          "items": [
            "Root type `type Mutation`; syntax identical to a query",
            "Only the keyword and the guarantees change",
            "Nothing enforces that mutations write and queries do not",
            "A write hidden in a query breaks parallelism assumptions"
          ]
        },
        {
          "type": "callout",
          "style": "takeaway",
          "title": "Top level runs serially",
          "text": "Top-level mutation fields execute one after another in document order. The second sees the first's writes — a real contract."
        },
        {
          "type": "code",
          "lang": "graphql",
          "lines": [
            "mutation Two {",
            "  a: rename(id:\"1\") { id }",
            "  b: publish(id:\"1\") { status }",
            "}   # b runs after a commits"
          ]
        },
        {
          "type": "bullets",
          "items": [
            "Serial applies ONLY to the top level",
            "Nested payload selections resolve in parallel",
            "So `updateUser { user { posts } }` fans out normally"
          ]
        },
        {
          "type": "heading",
          "text": "Payload Shape"
        },
        {
          "type": "bullets",
          "items": [
            "Return type is the read-back: write and re-read, one trip",
            "Convention: `{ entity, errors, clientMutationId }`",
            "Return the node `id` + changed fields, cache self-updates",
            "Bare entity returns give you nowhere to model failure"
          ]
        },
        {
          "type": "table",
          "headers": [
            "Return",
            "Failure model"
          ],
          "rows": [
            [
              "bare `User`",
              "only `errors[]`"
            ],
            [
              "`{ user, errors }`",
              "typed, renderable"
            ],
            [
              "union result",
              "non-null, exhaustive"
            ]
          ]
        }
      ]
    },
    {
      "page_title": "Input Objects & Errors as Data",
      "blocks": [
        {
          "type": "code",
          "lang": "graphql",
          "lines": [
            "mutation Publish($id: ID!) {",
            "  publishPost(id: $id) {",
            "    post { id status }   # read-back",
            "    errors { field message } } }"
          ]
        },
        {
          "type": "heading",
          "text": "Input Objects"
        },
        {
          "type": "code",
          "lang": "graphql",
          "lines": [
            "mutation Save($in: PostInput!) {",
            "  savePost(input: $in) { id }",
            "}   # one arg, signature stays stable"
          ]
        },
        {
          "type": "table",
          "headers": [
            "Feature",
            "`type`",
            "`input`"
          ],
          "rows": [
            [
              "Interfaces",
              "yes",
              "no"
            ],
            [
              "Union member",
              "yes",
              "no"
            ],
            [
              "Field args",
              "yes",
              "no"
            ],
            [
              "Recursive",
              "yes",
              "yes"
            ]
          ]
        },
        {
          "type": "heading",
          "text": "Errors as Data"
        },
        {
          "type": "code",
          "lang": "graphql",
          "lines": [
            "union UpdateResult = User | ValidationError",
            "# typed, non-nullable failure handling",
            "# beats grepping the errors[] array"
          ]
        },
        {
          "type": "callout",
          "style": "tip",
          "title": "Two error channels",
          "text": "Crashes and auth failures land in the top-level `errors[]`. Expected failures belong in the payload as typed data the client can render."
        },
        {
          "type": "sidebox",
          "title": "Non-negotiables",
          "items": [
            "Never expose a mutation over GET",
            "Caches and prefetchers would fire it",
            "Pass a client idempotency key on retries",
            "Double-charging is a retry bug, not user error"
          ]
        },
        {
          "type": "heading",
          "text": "Syntax",
          "ink": "blue"
        },
        {
          "type": "code",
          "lang": "graphql",
          "lines": [
            "query GetUserProfile {  # PascalCase id",
            "  viewer { id name }",
            "}       # unique per document"
          ]
        },
        {
          "type": "bullets",
          "items": [
            "The name is pure metadata — no effect on response shape",
            "No effect on execution semantics either",
            "Fine in GraphiQL and scratch work, never in shipped code"
          ]
        },
        {
          "type": "heading",
          "text": "When Required"
        },
        {
          "type": "bullets",
          "items": [
            "Mandatory once a document holds 2+ operations",
            "Request field `operationName` picks which one runs",
            "Subscriptions: named in practice, to correlate the socket"
          ]
        },
        {
          "type": "code",
          "lang": "text",
          "lines": [
            "# multi-op doc, no operationName:",
            "\"Must provide operation name if query",
            " contains multiple operations\""
          ]
        },
        {
          "type": "heading",
          "text": "Naming Rules"
        },
        {
          "type": "code",
          "lang": "text",
          "lines": [
            "GetUserProfile -> GetUserProfileQuery",
            "               -> ...QueryVariables",
            "GetUser  # not GetUserQuery"
          ]
        }
      ]
    },
    {
      "page_title": "What Operation Names Buy You",
      "blocks": [
        {
          "type": "callout",
          "style": "cloud",
          "title": "Silent merge trap",
          "text": "Two anonymous queries in one file, merged by a bundler, produce a runtime error — not a build error."
        },
        {
          "type": "heading",
          "text": "What Names Buy"
        },
        {
          "type": "table",
          "headers": [
            "System",
            "Anonymous cost"
          ],
          "rows": [
            [
              "APM trace",
              "opaque hash"
            ],
            [
              "Slow-query board",
              "blank row"
            ],
            [
              "Persisted allowlist",
              "no key"
            ],
            [
              "Rate limiting",
              "no budget"
            ],
            [
              "Codegen",
              "no type name"
            ]
          ]
        },
        {
          "type": "bullets",
          "items": [
            "Allowlists let prod accept only known operation IDs",
            "That blocks arbitrary client-authored queries",
            "Per-operation cost budgets are enforced by name"
          ]
        },
        {
          "type": "bullets",
          "items": [
            "Convention: verb + subject, prefix-free",
            "The keyword already says query — do not repeat it",
            "Name collisions across files break codegen"
          ]
        },
        {
          "type": "sidebox",
          "title": "graphql-eslint rules",
          "items": [
            "`no-anonymous-operations`",
            "`unique-operation-name`",
            "`naming-convention`",
            "Most teams enforce globally unique names"
          ]
        },
        {
          "type": "heading",
          "text": "Declaration",
          "ink": "blue"
        },
        {
          "type": "code",
          "lang": "graphql",
          "lines": [
            "query GetUser($id: ID!) {",
            "  user(id: $id) { name }",
            "}   # variables: {\"id\": \"42\"}"
          ]
        },
        {
          "type": "bullets",
          "items": [
            "`$` prefix, type annotation is required",
            "Values ride in a separate JSON map",
            "Never string-interpolated into the document"
          ]
        },
        {
          "type": "heading",
          "text": "Why It Matters"
        },
        {
          "type": "bullets",
          "items": [
            "Document stays byte-identical across every call",
            "Parses once, hits the validation cache, can be persisted",
            "Interpolation invites injection and breaks allowlists",
            "Same document + different variables = different cache entry"
          ]
        },
        {
          "type": "heading",
          "text": "Defaults & Null"
        },
        {
          "type": "code",
          "lang": "graphql",
          "lines": [
            "query Feed($n: Int = 10) {",
            "  feed(first: $n) { id } }",
            "# omit $n -> 10; $id: ID! -> always sent"
          ]
        }
      ]
    },
    {
      "page_title": "Variable Type Rules & Coercion",
      "blocks": [
        {
          "type": "table",
          "headers": [
            "You send",
            "Nullable var",
            "Non-null var"
          ],
          "rows": [
            [
              "omitted",
              "default applies",
              "error"
            ],
            [
              "`null`",
              "explicit erase",
              "error"
            ],
            [
              "a value",
              "used",
              "used"
            ]
          ]
        },
        {
          "type": "callout",
          "style": "tip",
          "title": "Omit is not null",
          "text": "Omitting falls back to the default. Explicit `null` is a deliberate erase. A non-null variable may never default to null."
        },
        {
          "type": "heading",
          "text": "Type Limits"
        },
        {
          "type": "bullets",
          "items": [
            "Only input types: scalars, enums, input objects, lists",
            "Never an output object type",
            "Unused declared variable is a validation error",
            "Undeclared variable used is a validation error too"
          ]
        },
        {
          "type": "heading",
          "text": "Coercion"
        },
        {
          "type": "table",
          "headers": [
            "Type",
            "Accepts"
          ],
          "rows": [
            [
              "`ID`",
              "Int or String"
            ],
            [
              "`Int`",
              "rejects floats"
            ],
            [
              "enum in doc",
              "bare name"
            ],
            [
              "enum in JSON",
              "quoted string"
            ]
          ]
        },
        {
          "type": "code",
          "lang": "graphql",
          "lines": [
            "mutation Save($in: PostInput!) {",
            "  savePost(input: $in) { id } }",
            "# {\"in\":{\"title\":\"Hi\",\"tags\":[\"a\"]}}"
          ]
        },
        {
          "type": "sidebox",
          "title": "Reach of a variable",
          "items": [
            "Nested field arguments at any depth",
            "Directive args: `@include(if: $showDetails)`",
            "Fragments use the operation's variables",
            "A fragment cannot declare its own"
          ]
        },
        {
          "type": "code",
          "lang": "graphql",
          "lines": [
            "query Row($deep: Boolean = false) {",
            "  user { name",
            "    posts @include(if: $deep) { id } } }",
            "}   # one doc, two shapes"
          ]
        },
        {
          "type": "heading",
          "text": "Definition",
          "ink": "green"
        },
        {
          "type": "code",
          "lang": "graphql",
          "lines": [
            "fragment UserFields on User {",
            "  id name avatarUrl",
            "}",
            "{ user { ...UserFields } }  # spread"
          ]
        },
        {
          "type": "bullets",
          "items": [
            "Name + `on` + type condition + selection set",
            "Spread is inlined at execution — costs nothing extra",
            "Names are document-global and must be unique",
            "Every declared fragment must actually be used"
          ]
        },
        {
          "type": "code",
          "lang": "graphql",
          "lines": [
            "fragment P on Post { title }",
            "{ user { ...P } }   # ERROR",
            "# User is not a possible type of Post"
          ]
        },
        {
          "type": "code",
          "lang": "graphql",
          "lines": [
            "search { __typename",
            "  ... on User { name }",
            "  ... on Post { title } }  # union"
          ]
        }
      ]
    },
    {
      "page_title": "Variable Type Rules & Coercion (cont.)",
      "blocks": [
        {
          "type": "table",
          "headers": [
            "Form",
            "Use"
          ],
          "rows": [
            [
              "`...F`",
              "named, reusable"
            ],
            [
              "`... on T`",
              "type-specific fields"
            ],
            [
              "`...F @include`",
              "conditional fetch"
            ]
          ]
        }
      ],
      "cont": true
    },
    {
      "page_title": "Conditional Fragment Spreads",
      "blocks": [
        {
          "type": "code",
          "lang": "graphql",
          "lines": [
            "{ user { ...Detail @include(if: $deep) } }",
            "# conditional fetch, no second trip",
            "# @skip(if:) is the inverse"
          ]
        }
      ]
    },
    {
      "page_title": "Fragment Composition & Colocation",
      "blocks": [
        {
          "type": "code",
          "lang": "graphql",
          "lines": [
            "query Page {",
            "  viewer { ...Header_user",
            "           ...Sidebar_user } }"
          ]
        },
        {
          "type": "heading",
          "text": "Type Conditions"
        },
        {
          "type": "bullets",
          "items": [
            "Condition must match the field type or be a possible type",
            "Otherwise validation fails before anything runs",
            "Fragments may spread fragments; any cycle is an error"
          ]
        },
        {
          "type": "diagram",
          "kind": "flowchart",
          "spec": {
            "title": "Abstract type",
            "rows": [
              [
                "n0"
              ],
              [
                "b0",
                "b1"
              ],
              [
                "c0_0",
                "c0_1"
              ],
              [
                "c1_0",
                "c1_1"
              ]
            ],
            "nodes": {
              "n0": {
                "text": "Abstract type",
                "shape": "diamond"
              },
              "b0": {
                "text": "union",
                "shape": "box"
              },
              "b1": {
                "text": "interface",
                "shape": "box"
              },
              "c0_0": {
                "text": "inline fragments only",
                "shape": "box"
              },
              "c0_1": {
                "text": "`__typename` sole common field",
                "shape": "box"
              },
              "c1_0": {
                "text": "shared fields direct",
                "shape": "box"
              },
              "c1_1": {
                "text": "inline for concrete extras",
                "shape": "box"
              }
            },
            "edges": [
              {
                "from": "n0",
                "to": "b0"
              },
              {
                "from": "n0",
                "to": "b1"
              },
              {
                "from": "b0",
                "to": "c0_0"
              },
              {
                "from": "b0",
                "to": "c0_1"
              },
              {
                "from": "b1",
                "to": "c1_0"
              },
              {
                "from": "b1",
                "to": "c1_1"
              }
            ]
          }
        },
        {
          "type": "heading",
          "text": "Colocation"
        },
        {
          "type": "bullets",
          "items": [
            "Each component declares the fragment it renders",
            "The page query just composes them",
            "The data requirement travels with the component",
            "This is the fix for REST's endpoint-per-screen problem"
          ]
        },
        {
          "type": "sidebox",
          "title": "Colocation rules",
          "items": [
            "Name it `Component_prop`",
            "One fragment per component",
            "The page query only composes them",
            "An unused fragment fails validation"
          ]
        },
        {
          "type": "heading",
          "text": "Merging"
        },
        {
          "type": "bullets",
          "items": [
            "Two spreads selecting `name` produce one `name`",
            "Conflicting arguments on one response key is an error",
            "Alias when the selections cannot merge"
          ]
        },
        {
          "type": "code",
          "lang": "graphql",
          "lines": [
            "{ user {",
            "    avatar(size: 32)",
            "    avatar(size: 64) } }  # ERROR",
            "# same key, conflicting args"
          ]
        },
        {
          "type": "heading",
          "text": "Execution Pipeline",
          "ink": "blue"
        },
        {
          "type": "diagram",
          "kind": "flow",
          "spec": {
            "nodes": [
              "lex",
              "parse AST",
              "validate",
              "coerce vars",
              "execute",
              "format"
            ]
          }
        }
      ]
    },
    {
      "page_title": "Execution Pipeline & the N+1 Trap",
      "blocks": [
        {
          "type": "bullets",
          "items": [
            "Parsing is pure syntax — a missing brace fails with line/column",
            "Validation checks fields, args, type conditions, cycles",
            "Validation is the expensive step, cached on document hash",
            "Coercion runs after it, failing with a `variables` path"
          ]
        },
        {
          "type": "code",
          "lang": "js",
          "lines": [
            "resolve(parent, args, context, info)",
            "// info holds the field AST node + path",
            "// resolver reads the sub-selection"
          ]
        },
        {
          "type": "callout",
          "style": "takeaway",
          "title": "Partial success is normal",
          "text": "A thrown resolver nulls its field and appends to `errors[]` with a `path`. If the field is non-null, that null bubbles to the nearest nullable ancestor."
        },
        {
          "type": "heading",
          "text": "Resolver Defaults"
        },
        {
          "type": "bullets",
          "items": [
            "No resolver? Executor returns `parent[fieldName]`",
            "Most schema fields need no explicit resolver",
            "Resolvers may return promises — the executor awaits",
            "`@skip`/`@include` are applied at collection time"
          ]
        },
        {
          "type": "heading",
          "text": "The N+1 Trap",
          "ink": "red"
        },
        {
          "type": "table",
          "headers": [
            "Shape",
            "DB hits"
          ],
          "rows": [
            [
              "100 users, naive",
              "101"
            ],
            [
              "Same + DataLoader",
              "2"
            ],
            [
              "Per tick",
              "batched once"
            ]
          ]
        },
        {
          "type": "code",
          "lang": "js",
          "lines": [
            "const loader = new DataLoader(batchFn)",
            "// 100 loads -> 1 query per tick",
            "loader.load(id) // dedupes keys too"
          ]
        },
        {
          "type": "callout",
          "style": "tip",
          "title": "Skip parse and validate",
          "text": "Persisted queries send a hash; the server looks up the document. No parse, no validation, and a tiny request body."
        },
        {
          "type": "sidebox",
          "title": "Client extensions",
          "items": [
            "Relay `@arguments` / `@argumentDefinitions`",
            "Give fragments local variables",
            "Compiler feature, not core spec"
          ]
        },
        {
          "type": "heading",
          "text": "Syntax",
          "ink": "blue"
        },
        {
          "type": "code",
          "lang": "graphql",
          "lines": [
            "smallPic: avatar(size: 32)",
            "bigPic:   avatar(size: 256)",
            "# key = alias, resolver unchanged"
          ]
        },
        {
          "type": "code",
          "lang": "graphql",
          "lines": [
            "{ hero:    character(id: \"1\") { name }",
            "  villain: character(id: \"2\") { name } }",
            "# two entities, one round trip"
          ]
        },
        {
          "type": "heading",
          "text": "Batching & Abuse",
          "ink": "red"
        },
        {
          "type": "code",
          "lang": "graphql",
          "lines": [
            "{ a: user(id:\"1\") { name }",
            "  b: user(id:\"2\") { name }",
            "  c: user(id:\"3\") { name } }  # fan-out"
          ]
        }
      ]
    },
    {
      "page_title": "Aliases, Response Keys & Fan-out",
      "blocks": [
        {
          "type": "bullets",
          "items": [
            "`alias: field` — the result lands under the alias key",
            "Does not change which resolver runs or the args sent",
            "Works on any field, including `kind: __typename`",
            "Cannot be used on fragment spreads — fields only"
          ]
        },
        {
          "type": "heading",
          "text": "Repeat A Field"
        },
        {
          "type": "bullets",
          "items": [
            "Primary purpose: same field, different args, one operation",
            "Without an alias that is a validation error",
            "Same response key + conflicting args cannot merge"
          ]
        },
        {
          "type": "heading",
          "text": "Other Uses"
        },
        {
          "type": "table",
          "headers": [
            "Goal",
            "Alias"
          ],
          "rows": [
            [
              "Client naming",
              "`user: viewer`"
            ],
            [
              "Nicer key",
              "`count: totalRecords`"
            ],
            [
              "Cache trick",
              "`kind: __typename`"
            ]
          ]
        },
        {
          "type": "bullets",
          "items": [
            "Two fragments may both select a differently-typed `status`",
            "Same key, unmergeable selections — alias one of them",
            "Codegen erases aliases: the alias becomes the property"
          ]
        },
        {
          "type": "heading",
          "text": "Response Keys"
        },
        {
          "type": "code",
          "lang": "graphql",
          "lines": [
            "{ small: avatar(size: 32) }",
            "# -> \"data\": { \"small\": \"...\" }",
            "# server still runs avatar(size:32)"
          ]
        },
        {
          "type": "table",
          "headers": [
            "Target",
            "Aliasable?"
          ],
          "rows": [
            [
              "`field`",
              "yes"
            ],
            [
              "`__typename`",
              "yes"
            ],
            [
              "`...Spread`",
              "no"
            ],
            [
              "fragment definition",
              "no"
            ]
          ]
        },
        {
          "type": "code",
          "lang": "graphql",
          "lines": [
            "fragment J on Job  { s: status }",
            "fragment T on Task { t: status }",
            "# alias inside, keys never clash"
          ]
        },
        {
          "type": "heading",
          "text": "Batching Fan-out"
        },
        {
          "type": "bullets",
          "items": [
            "Alias N copies of one lookup field",
            "One HTTP request fans out into N reads",
            "The trace still shows a single operation",
            "Cost analysis counts every copy separately"
          ]
        },
        {
          "type": "callout",
          "style": "tip",
          "title": "Bound the fan-out",
          "text": "Aliased duplicates multiply resolver work. Once N stops being small, prefer a list field with an `ids:` argument."
        }
      ]
    }
