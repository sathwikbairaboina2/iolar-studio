      "page_title": "Common Mistakes & Cheat Sheet",
      "blocks": [
        {
          "type": "code",
          "lang": "graphql",
          "lines": [
            "mutation Publish($id: ID!) {",
            "  publishPost(id: $id) {",
            "    post { id status }",
            "    errors { field message } } }"
          ],
          "runnable": false
        },
        {
          "type": "bullets",
          "items": [
            "Return the node `id` plus every changed field",
            "A normalized cache then updates with no refetch",
            "Pass a client key so a retry cannot double-charge"
          ]
        },
        {
          "type": "callout",
          "style": "tip",
          "title": "Omitted is not null",
          "text": "Leaving a variable out falls back to its default. Sending `null` is an explicit erase. Two different writes, one typo apart."
        },
