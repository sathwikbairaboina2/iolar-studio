        {
          "type": "callout",
          "style": "cloud",
          "title": "Status-code monitoring goes blind",
          "text": "GraphQL answers HTTP 200 on failure. An alert wired to 5xx will never fire on a broken resolver."
        },
        {
          "type": "heading",
          "text": "When Not To"
        },
        {
          "type": "bullets",
          "items": [
            "Simple CRUD with exactly one consumer",
            "File upload or download heavy APIs",
            "Where HTTP caching IS the whole strategy"
          ]
        },
        {
          "type": "sidebox",
          "title": "Client-side cost",
          "items": [
            "Apollo, Relay, urql are real complexity",
            "`fetch` + REST is simpler for small apps",
            "Normalized caches need invalidation thinking"
          ]
        },
        {
          "type": "heading",
          "text": "Worked Example"
        },
        {
          "type": "code",
          "lang": "graphql",
          "lines": [
            "query Feed($n: Int! = 10) {",
            "  feed(first: $n) {",
            "    id title author { name } } }"
          ],
          "runnable": false
        },
        {
          "type": "bullets",
          "items": [
            "Named, so it shows up in APM and the allowlist",
            "`$n` typed with a default: omit it and 10 applies",
            "Nesting `author` kills the second round trip"
          ]
        }
      ]
