        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "jsonb_path_query(data,",
            "  '$.items[*] ? (@.sku == $s)',",
            "  '{\"s\":\"A1\"}')",
            "-- 4th arg silent => true"
          ],
          "note": "vars beat string-built paths"
        }
      ]
