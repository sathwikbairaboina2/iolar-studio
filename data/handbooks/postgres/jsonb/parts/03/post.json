          ],
          "rows": [
            [
              "`jsonb_path_exists`",
              "bool, like `@?`"
            ],
            [
              "`jsonb_path_match`",
              "bool, like `@@`"
            ],
            [
              "`jsonb_path_query`",
              "set of items"
            ],
            [
              "`..._query_first`",
              "first or NULL"
            ],
            [
              "`..._query_array`",
              "one jsonb array"
