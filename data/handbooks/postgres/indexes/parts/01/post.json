        {
          "type": "heading",
          "text": "Full-Text Search"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "CREATE INDEX ON docs USING gin",
            "  (to_tsvector('english', body));",
            "SELECT id FROM docs",
            "WHERE to_tsvector('english', body)",
            "      @@ plainto_tsquery('vacuum');"
          ]
        },
        {
          "type": "heading",
          "text": "Opclasses That Matter"
        },
        {
          "type": "table",
          "headers": [
            "Opclass",
            "Stores",
            "Operators"
          ],
          "rows": [
            [
              "`jsonb_ops`",
              "every key + value",
              "`@>` `?` `?|` `?&`"
            ],
            [
              "`jsonb_path_ops`",
              "hashed paths",
              "`@>` only"
            ],
            [
              "`gin_trgm_ops`",
              "trigrams",
              "`LIKE '%x%'`"
            ]
          ]
        },
        {
          "type": "bullets",
          "items": [
            "`jsonb_path_ops` is much smaller and faster, containment only",
            "Arrays: `WHERE tags @> ARRAY['pg']` is GIN-accelerated",
            "So is `&&` overlap between two arrays",
            "`pg_trgm` also makes `ILIKE` and fuzzy `%` similarity indexable"
          ]
        },
        {
          "type": "heading",
          "text": "Write Cost"
        },
        {
          "type": "bullets",
          "items": [
            "One row touches many index keys, so writes are slow",
            "`fastupdate` buffers inserts in a pending list",
            "Flushed in batches, so an occasional query pays the cost",
            "A big pending list has to be scanned linearly"
          ]
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "ALTER INDEX idx SET (fastupdate = on);",
            "SET gin_pending_list_limit = '4MB';",
            "-- 4MB is the default; lower to flush often",
            "SET gin_fuzzy_search_limit = 5000;",
            "-- caps rows from very common terms"
          ]
        },
        {
          "type": "callout",
          "style": "takeaway",
          "title": "Lossy, Always",
          "text": "GIN results are rechecked against the heap every time, so index-only scans are impossible with GIN."
        },
        {
          "type": "bullets",
          "items": [
            "Not for range queries and not for sorting",
            "Reach for it on containment, overlap and text search"
          ]
        },
        {
          "type": "sidebox",
          "title": "Before A Big Build",
          "items": [
            "Raise `maintenance_work_mem` first",
            "It dominates GIN build speed",
            "Restore it after the build finishes"
          ]
        },
        {
          "type": "sidebox",
          "title": "Methods The Type Supplies",
          "items": [
            "`consistent` and `union`",
            "`penalty` and `picksplit`",
            "`same`"
          ]
        },
        {
          "type": "bullets",
          "items": [
            "`@>` range contains a point or a range",
            "`&&` two ranges ==overlap==",
            "`<<` / `>>` strictly left or right of"
          ]
        }
      ]
