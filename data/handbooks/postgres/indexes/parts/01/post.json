          }
        },
        {
          "type": "bullets",
          "items": [
            "Fanout ~ page_size / entry_size",
            "8 KB pages, 3 levels, billions of keys addressed",
            "So a lookup costs about 4 page reads"
          ]
        },
        {
          "type": "table",
          "headers": [
            "Operation",
            "Cost"
          ],
          "rows": [
            [
              "Search",
              "O(log n)"
            ],
            [
              "Insert",
              "O(log n)"
            ],
            [
              "Range scan",
              "O(log n + k)"
            ],
            [
              "Ordered output",
              "free, no Sort node"
            ]
          ]
        },
        {
          "type": "heading",
          "text": "B-link Leaves"
        },
        {
          "type": "bullets",
          "items": [
            "Leaf pages are doubly linked left to right (Lehman & Yao)",
            "Range and backward scans walk siblings, never revisit the root",
            "Right-links let readers proceed during a page split",
            "No tree-wide locks needed for concurrency"
          ]
        },
        {
          "type": "heading",
          "text": "Splits And Free Space"
        },
        {
          "type": "bullets",
          "items": [
            "A full page splits about 50/50",
            "Rightmost inserts split 90/10 for monotonic keys",
            "`serial` and `now()` hit that path constantly",
            "`fillfactor` default 90 leaves 10% for HOT-friendly growth",
            "Lower it on heavily updated indexes"
          ]
        },
        {
          "type": "sidebox",
          "title": "Modern Shrinkage",
          "items": [
            "PG 13+ deduplication: one key, a posting list of TIDs",
            "Low-cardinality indexes shrink dramatically",
            "PG 14+ bottom-up deletion reclaims dead entries before splitting",
            "Fights version churn from non-HOT updates"
          ]
        },
        {
          "type": "heading",
          "text": "No Visibility In The Index"
        },
        {
          "type": "bullets",
          "items": [
            "Index tuples carry no `xmin` / `xmax`",
            "So heap or visibility map must be consulted",
            "Entries exist for dead tuples too",
            "Only `VACUUM` removes them"
          ]
        }
      ]
    },
    {
      "page_title": "B-tree Operators, Ordered Scans & pageinspect",
      "blocks": [
        {
          "type": "heading",
          "text": "Operators Served"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "WHERE a BETWEEN 1 AND 9  -- < <= = >= >",
            "WHERE a IN (1, 2, 3)",
            "WHERE a IS NULL          -- yes, indexed",
            "WHERE s LIKE 'pre%'      -- C collation",
            "-- or a text_pattern_ops index"
          ]
        },
        {
          "type": "callout",
          "style": "tip",
          "title": "2704 Bytes Max",
          "text": "Entries cap at ~1/3 of a page; long text raises `index row size exceeds maximum`. Hash the value or index an expression instead."
        },
        {
          "type": "bullets",
          "items": [
            "`LIKE '%foo'` leading wildcard: btree cannot help",
            "`WHERE date(ts) = ...` hides the key behind a function",
            "Comparing an int column to a text param skips the index"
          ],
          "style": "cross",
          "frame": "dashed",
          "ink": "red"
        },
        {
          "type": "heading",
          "text": "Ordered Output For Free"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "CREATE INDEX ON orders (ts);",
            "SELECT id FROM orders",
            "ORDER BY ts DESC LIMIT 10;",
            "-- backward index scan, no Sort"
          ],
          "note": "LIMIT stops after ten leaf entries"
        },
        {
          "type": "bullets",
          "items": [
            "==Backward scans== walk the leaf left-links",
            "Top-N queries stop early, no full sort",
            "Plan shows `Index Scan Backward`"
          ]
        },
        {
          "type": "heading",
          "text": "Peek Inside: pageinspect"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "CREATE EXTENSION pageinspect;",
            "SELECT level, root",
            "FROM bt_metap('idx');",
            "SELECT live_items, dead_items",
            "FROM bt_page_stats('idx', 1);"
          ]
        },
        {
          "type": "bullets",
          "items": [
            "Leaves are level 0, so `level = 2` means **3** levels",
            "`dead_items` = entries waiting for `VACUUM`",
            "`btpo_prev` / `btpo_next` are the sibling links"
          ]
        },
        {
          "type": "heading",
          "text": "Measure Deduplication"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "CREATE INDEX ON t (status)",
            "WITH (deduplicate_items = off);",
            "SELECT pg_size_pretty(",
            "  pg_relation_size('idx'));",
            "-- compare with the default: on"
          ]
        },
        {
          "type": "table",
          "headers": [
            "Knob",
            "Default"
          ],
          "rows": [
            [
              "page size",
              "8 KB"
            ],
            [
              "`fillfactor`",
              "90"
            ],
            [
              "`deduplicate_items`",
              "on (PG 13+)"
            ],
            [
              "max entry",
              "~2704 B"
            ]
          ]
        },
        {
          "type": "callout",
          "style": "sticky",
          "title": "Height Barely Grows",
          "text": "With fanout in the hundreds, going from 1M to 1B rows adds only about one level."
        }
      ]
    },
    {
      "page_title": "Multicolumn B-trees: Prefix, Sort Order & Keysets",
      "blocks": [
        {
          "type": "heading",
          "text": "Leftmost Prefix Rule",
          "ink": "accent"
        },
        {
          "type": "bullets",
          "items": [
            "Multicolumn keys are compared left to right",
            "Only a leftmost prefix can become an `Index Cond`",
            "A skipped leading column ends index usability"
          ]
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "CREATE INDEX ON t (a, b, c);",
            "WHERE a=1                -- served",
            "WHERE a=1 AND b=2        -- served",
            "WHERE a=1 AND b=2 AND c=3 -- served",
            "WHERE b=2                -- NOT served"
          ]
        },
        {
          "type": "heading",
          "text": "Equality First, Range Last"
        },
        {
          "type": "bullets",
          "items": [
            "For `WHERE a = 1 AND b > 5 ORDER BY c`, two candidates exist",
            "Index `(a, b)` stops the scan at `b`",
            "Index `(a, c)` bounds `a` and gives the sort for free",
            "Measure both, do not guess"
          ]
        },
        {
          "type": "bullets",
          "items": [
            "A range predicate ends usable index ordering",
            "Columns after the first inequality become filters, not bounds"
          ]
        },
        {
          "type": "diagram",
          "kind": "cards",
          "spec": {
            "cards": [
              {
                "title": "two single-col indexes",
                "lines": [
                  "column order irrelevant",
                  "bitmap AND of both",
                  "extra bitmap step"
                ]
              },
              {
                "title": "one composite index",
                "lines": [
                  "prefix order matters",
                  "single index scan",
                  "nearly always faster"
                ]
              }
            ]
          }
        },
        {
          "type": "heading",
          "text": "Sort Direction"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "CREATE INDEX ON t (a DESC, b ASC);",
            "-- ORDER BY a DESC, b ASC : no Sort node",
            "-- default: ASC is NULLS LAST",
            "-- default: DESC is NULLS FIRST"
          ]
        },
        {
          "type": "bullets",
          "items": [
            "`NULLS FIRST` / `NULLS LAST` must match the query's `ORDER BY`",
            "B-tree does store NULLs, unlike Oracle",
            "So `WHERE col IS NULL` can use an index scan"
          ]
        },
        {
          "type": "heading",
          "text": "Keyset Pagination"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "WHERE (created_at, id) < ($1, $2)",
            "ORDER BY created_at DESC, id DESC",
            "LIMIT 20;  -- index (created_at, id)",
            "-- OFFSET 100000 walks 100k rows first"
          ]
        },
        {
          "type": "bullets",
          "items": [
            "Row comparison `(a, b) > (1, 2)` maps to a composite bound",
            "The expanded `OR` rewrite usually does not"
          ]
        },
        {
          "type": "sidebox",
          "title": "Housekeeping",
          "items": [
            "Index `(a)` is redundant beside `(a, b)`",
            "Drop the narrow one unless small and hot",
            "`CREATE UNIQUE INDEX` enforces uniqueness",
            "NULLs are distinct; `NULLS NOT DISTINCT` (PG 15+) forbids repeats"
          ]
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "CREATE INDEX ON users",
            "  (name text_pattern_ops);",
            "WHERE name LIKE 'abc%'  -- served",
            "ORDER BY name  -- NOT served"
          ],
          "note": "pattern ops compare byte by byte"
        }
      ]
    },
    {
      "page_title": "Text Pattern Ops & Collation Upgrades",
      "blocks": [
        {
          "type": "heading",
          "text": "Text And Collation"
        },
        {
          "type": "bullets",
          "items": [
            "`text_pattern_ops` / `varchar_pattern_ops` enable `LIKE 'abc%'`",
            "Needed whenever the collation is not C",
            "`COLLATE \"C\"` on the column achieves the same",
            "A glibc upgrade changing `lc_collate` silently corrupts text ordering",
            "`REINDEX` after any collation version change"
          ]
        },
        {
          "type": "callout",
          "style": "tip",
          "title": "Keep Both If Needed",
          "text": "A `text_pattern_ops` index cannot serve locale `<`, `>` or `ORDER BY`. Keep a regular index too when you need sorting."
        },
        {
          "type": "heading",
          "text": "After An OS Upgrade"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "-- glibc / ICU version changed",
            "REINDEX INDEX CONCURRENTLY idx;",
            "ALTER DATABASE app",
            "  REFRESH COLLATION VERSION;",
            "-- PG 15+"
          ],
          "note": "refresh only AFTER reindexing"
        }
      ]
    },
    {
      "page_title": "Hash Indexes: Equality-Only Lookups",
      "blocks": [
        {
          "type": "heading",
          "text": "One Operator Only",
          "ink": "accent"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "CREATE INDEX ON pages USING hash (url);",
            "WHERE url = $1   -- the only served op",
            "-- no <, >, LIKE, ORDER BY, UNIQUE"
          ]
        },
        {
          "type": "bullets",
          "items": [
            "Stores a 32-bit hash code, never the value itself",
            "Index size is independent of the column's data width",
            "A 4 KB URL and a 20-byte slug cost the same"
          ]
        },
        {
          "type": "heading",
          "text": "Structure"
        },
        {
          "type": "diagram",
          "kind": "flowchart",
          "spec": {
            "title": "hash index",
            "rows": [
              [
                "n0"
              ],
              [
                "b0",
                "b1",
                "b2"
              ],
              [
                "c0_0"
              ],
              [
                "c1_0",
                "c1_1"
              ],
              [
                "c2_0"
              ]
            ],
            "nodes": {
              "n0": {
                "text": "hash index",
                "shape": "diamond"
              },
              "b0": {
                "text": "meta page",
                "shape": "box"
              },
              "b1": {
                "text": "buckets",
                "shape": "box"
              },
              "b2": {
                "text": "bitmap pages",
                "shape": "box"
              },
              "c0_0": {
                "text": "bucket count",
                "shape": "box"
              },
              "c1_0": {
                "text": "primary page",
                "shape": "box"
              },
              "c1_1": {
                "text": "overflow chain",
                "shape": "box"
              },
              "c2_0": {
                "text": "free overflow pages",
                "shape": "box"
              }
            },
            "edges": [
              {
                "from": "n0",
                "to": "b0"
              },
              {
                "from": "n0",
                "to": "b1"
              },
              {
                "from": "n0",
                "to": "b2"
              },
              {
                "from": "b0",
                "to": "c0_0"
              },
              {
                "from": "b1",
                "to": "c1_0"
              },
              {
                "from": "b1",
                "to": "c1_1"
              },
              {
                "from": "b2",
                "to": "c2_0"
              }
            ]
          }
        },
        {
          "type": "bullets",
          "items": [
            "Lookup is O(1) expected: hash, jump to bucket, scan the page",
            "Bucket splits happen incrementally as the index grows",
            "No single giant rehash pause"
          ]
        },
        {
          "type": "heading",
          "text": "Crash Safety"
        },
        {
          "type": "bullets",
          "items": [
            "Before PG 10 hash indexes were not WAL-logged",
            "Unsafe after a crash and never replicated",
            "PG 10+ made them crash-safe and replicable"
          ]
        },
        {
          "type": "heading",
          "text": "Cannot Do"
        },
        {
          "type": "bullets",
          "items": [
            "No `ORDER BY`, ranges or `LIKE`",
            "No uniqueness, primary keys or exclusion constraints",
            "One column only, never multicolumn",
            "No index-only scan: the value is unrecoverable from the hash"
          ]
        },
        {
          "type": "table",
          "headers": [
            "Feature",
            "hash",
            "btree"
          ],
          "rows": [
            [
              "Equality",
              "yes",
              "yes"
            ],
            [
              "Range / sort",
              "no",
              "yes"
            ],
            [
              "Wide key size",
              "flat",
              "grows"
            ],
            [
              "Index-only scan",
              "no",
              "yes"
            ]
          ]
        },
        {
          "type": "callout",
          "style": "tip",
          "title": "Always Rechecked",
          "text": "Hash collisions are possible, so Postgres compares the real value against the heap tuple on every hit."
        },
        {
          "type": "heading",
          "text": "Verdict"
        },
        {
          "type": "bullets",
          "items": [
            "Real win: very long equality keys, URLs, long text ids",
            "Exactly where a btree entry is huge or breaks the size limit",
            "Otherwise btree lands within a few percent and stays flexible"
          ]
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "-- portable alternative, any version",
            "CREATE INDEX ON t (md5(long_col));",
            "SELECT * FROM t",
            "WHERE md5(long_col) = md5($1);"
          ]
        }
      ]
    },
    {
      "page_title": "GIN Basics: jsonb Containment & Trigram Search",
      "blocks": [
        {
          "type": "sidebox",
          "title": "Same Trick, Cheaper Hash",
          "items": [
            "`hashtext(long_col)` also works as an expression index",
            "Query predicate must repeat the function exactly",
            "Gives ordering and index-only scans that hash cannot"
          ]
        },
        {
          "type": "heading",
          "text": "Inverted By Design",
          "ink": "accent"
        },
        {
          "type": "bullets",
          "items": [
            "GIN = Generalized Inverted Index",
            "For column types holding many elements",
            "Arrays, `jsonb`, `tsvector`, trigrams",
            "Answers 'which rows contain this element'",
            "Exact inverse of btree's 'which rows equal this value'"
          ]
        },
        {
          "type": "heading",
          "text": "Btree vs GIN Questions"
        },
        {
          "type": "table",
          "headers": [
            "Question",
            "btree",
            "GIN"
          ],
          "rows": [
            [
              "`a = 5`",
              "yes",
              "no"
            ],
            [
              "`tags @> {pg}`",
              "no",
              "yes"
            ],
            [
              "`ORDER BY a`",
              "yes",
              "no"
            ],
            [
              "`a > 5`",
              "yes",
              "no"
            ]
          ]
        },
        {
          "type": "heading",
          "text": "jsonb Containment"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "CREATE INDEX ON events USING gin",
            "  (payload jsonb_path_ops);",
            "WHERE payload @>",
            "  '{\"type\": \"click\"}';"
          ],
          "note": "path_ops serves @> only"
        },
        {
          "type": "bullets",
          "items": [
            "Default `jsonb_ops` also serves key-exists `?`",
            "`jsonb_path_ops` hashes whole paths, so it is ==smaller==",
            "`payload->>'type' = 'click'` is **not** served by either"
          ]
        },
        {
          "type": "heading",
          "text": "Substring Search"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "CREATE EXTENSION pg_trgm;",
            "CREATE INDEX ON users USING gin",
            "  (name gin_trgm_ops);",
            "WHERE name ILIKE '%ann%';"
          ],
          "note": "patterns under 3 chars barely filter"
        },
        {
          "type": "bullets",
          "items": [
            "Arrays searched by element or overlap",
            "`jsonb` documents filtered by containment",
            "Full-text `tsvector` with `@@`",
            "`LIKE '%x%'` where btree gives up"
          ],
          "style": "check"
        }
      ]
    },
    {
      "page_title": "GIN Internals: Full-Text, Opclasses & Write Cost",
      "blocks": [
