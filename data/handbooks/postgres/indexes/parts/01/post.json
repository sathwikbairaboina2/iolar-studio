              "fast",
              "slow",
              "big"
            ],
            [
              "GiST",
              "medium",
              "fast",
              "small"
            ],
            [
              "GiST extras",
              "KNN",
              "exclusion",
              "-"
            ]
          ]
        },
        {
          "type": "heading",
          "text": "Which Tree?"
        },
        {
          "type": "bullets",
          "items": [
            "Ranges, geometry, KNN, exclusion: **GiST**",
            "Points, IPs, text prefixes: **SP-GiST**",
            "Read-heavy text or `jsonb`: **GIN**"
          ],
          "style": "check"
        },
        {
          "type": "callout",
          "style": "takeaway",
          "title": "Overlap Decides",
          "text": "Data that can overlap needs GiST; data that splits cleanly into disjoint regions suits SP-GiST."
        }
      ]
