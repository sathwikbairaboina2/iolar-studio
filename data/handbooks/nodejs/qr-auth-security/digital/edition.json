                "Same generic error for bad email or password",
                "Cookies: ==httpOnly== + ==secure== + ==sameSite=lax==",
                "JWT: short expiry, pin the algorithm"
              ],
              "style": "check",
              "frame": "dashed",
              "ink": "green"
            },
