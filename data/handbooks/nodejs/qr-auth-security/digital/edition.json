    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "Login does `if (hash === await bcrypt.hash(pw, 12))`. Valid passwords are always rejected. Why?",
              "a_bullets": [
                "bcrypt adds a ==random salt== each call, so the same password gives a different hash",
                "Use `await bcrypt.compare(pw, hash)`; it reads the salt from the stored hash"
              ]
            },
            {
              "type": "qa",
              "q": "The server reads the user id with `jwt.decode(token).sub`. What can an attacker do?",
              "a_bullets": [
                "`decode` skips the signature check, so a forged token with any `sub` is accepted",
                "Use `jwt.verify` with pinned `algorithms`"
              ]
            },
            {
              "type": "qa",
              "q": "An Express app behind nginx limits 100 requests per window. Without `trust proxy`, what happens?",
              "a_bullets": [
                "Every client appears to have the proxy's IP and shares one bucket",
                "After 100 total requests, everyone gets 429; fix with `app.set('trust proxy', 1)`"
              ]
            }
          ]
        }
      ]
    }
