                  "Wait for exp"
                ],
                [
                  "Scaling",
                  "Shared store",
                  "No lookup"
                ],
                [
                  "Verify",
                  "Session ID",
                  "`algorithms: ['HS256']`"
                ]
              ]
            },
            {
              "type": "heading",
              "text": "2. Hardening and Input",
              "ink": "blue"
            },
            {
              "type": "code",
              "lang": "javascript",
              "lines": [
                "app.use(helmet());",
                "app.set('trust proxy', 1);",
