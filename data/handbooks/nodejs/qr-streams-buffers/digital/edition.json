          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "A loop calls `w.write(line)` a million times on a file stream and ignores the result. What goes wrong?",
              "a_bullets": [
                "Memory balloons: `write()` returns false when full, but data keeps queueing.",
                "Fix: when false, await `events.once(w, 'drain')`."
              ]
            },
            {
              "type": "qa",
              "q": "What does this print?",
              "example_code": [
                "const b = Buffer.from('hello');",
                "const s = b.subarray(0, 2);",
                "s[0] = 72;",
                "console.log(b.toString());"
              ],
              "a_bullets": [
                "`Hello`: subarray shares memory, no copy.",
                "72 is the code for 'H'."
              ]
            },
            {
              "type": "qa",
              "q": "In `src.pipe(gzip).pipe(dest)`, dest fails with an error. What happens to src and gzip?",
              "a_bullets": [
                "They stay open, leaking file descriptors: pipe forwards no errors.",
                "Use `pipeline`, which destroys every stage."
              ]
            }
          ]
        }
