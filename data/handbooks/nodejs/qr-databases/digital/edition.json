      "role": "outline",
      "outlineIndex": 3,
      "pages": [
        {
          "title": "ORMs vs Query Builders: Prisma and Drizzle",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Builder vs ORM",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "{blue:Query builder} (Knex, Kysely): chained methods build SQL, stays close to SQL",
                "{green:ORM}: maps tables to models, with relations and a schema layer"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "blue"
            },
            {
              "type": "heading",
              "text": "2. Prisma vs Drizzle",
              "ink": "purple"
            },
            {
              "type": "table",
              "headers": [
                "",
                "Prisma",
                "Drizzle"
              ],
              "rows": [
                [
                  "Schema",
                  "==schema.prisma== is the source of truth",
                  "Defined in TypeScript"
                ],
                [
                  "Client",
                  "`prisma generate` makes a typed client",
                  "No codegen step"
                ],
                [
                  "Migrations",
                  "`prisma migrate dev`",
                  "`drizzle-kit` generates them"
                ],
                [
                  "Style",
                  "Models, `include`",
                  "SQL-like API"
                ]
              ]
            },
            {
              "type": "code",
              "lang": "ts",
              "lines": [
                "prisma.user.findMany({ where: { active: true },",
                "  include: { posts: true } })",
                "db.select().from(users).where(eq(users.active, true))"
              ],
              "note": "Prisma, then Drizzle"
            },
            {
              "type": "heading",
              "text": "3. Trade-offs and N+1",
              "ink": "orange"
            },
            {
              "type": "bullets",
              "items": [
                "==Prisma==: best DX and relation loading, heavier client, less SQL control",
                "==Drizzle/builders==: lighter, more explicit, more manual joins",
                "Complex query: `prisma.$queryRaw` tagged template, or the `sql` tag in Drizzle"
              ],
              "style": "check"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "N+1 queries",
              "text": "Looping and fetching relations per row fires **1+N** queries. Use ==include/with== or a join instead."
            }
          ]
        }
      ]
    },
