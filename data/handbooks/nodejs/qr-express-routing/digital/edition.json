    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "You register `app.get('/users/:id', a)` and then `app.get('/users/me', b)`. Which handler runs for GET /users/me?",
              "a_bullets": [
                "Handler `a`, with `req.params.id === 'me'`",
                "First match wins, so put `/users/me` first"
              ]
            },
            {
              "type": "qa",
              "q": "`app.post('/items', h)` reads `req.body.name`, but `app.use(express.json())` comes after it. What happens?",
              "a_bullets": [
                "`req.body` is still undefined, so reading `.name` throws a TypeError",
                "Register the body parser before the routes"
              ]
            },
            {
              "type": "qa",
              "q": "What is wrong here?",
              "example_code": [
                "if (!user) res.status(404).json({ error: 'none' });",
                "res.json(user);"
              ],
              "a_bullets": [
                "With no user, it responds twice and throws 'Cannot set headers after they are sent'",
                "Fix: `return res.status(404).json(...)`"
              ]
            }
          ]
        }
