    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "This test stays green even when getUser(0) resolves instead of rejecting. Why?",
              "a_bullets": [
                "`assert.rejects` returns a promise, and nothing awaits it.",
                "The test ends first, so the check can't fail it.",
                "Fix: make the test `async` and `await` the call."
              ],
              "example_code": [
                "test('bad id', () => {",
                "  assert.rejects(getUser(0), TypeError);",
                "});"
              ]
            },
            {
              "type": "qa",
              "q": "Does `expect({a:1}).toBe({a:1})` pass?",
              "a_bullets": [
                "It fails: `toBe` uses `Object.is`, and these are two different objects.",
                "`toEqual` passes because it compares deeply."
              ]
            },
            {
              "type": "qa",
              "q": "With fake timers, `setTimeout(cb, 1000)` is set and you call `advanceTimersByTime(999)`. Is cb called?",
              "a_bullets": [
                "No. A fake clock moves only when you advance it.",
                "After 1 more ms, cb has run exactly once."
              ]
            }
          ]
        }
      ]
