          "blocks": [
            {
              "type": "heading",
              "text": "1. Testing Handlers with supertest",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "Export `app` ==without listen()==; supertest binds an ephemeral port itself",
                "Assert ==status==, ==headers==, then check `res.body`",
                "Test the {red:400}, {red:401} and {red:404} paths, not only the happy path"
              ],
              "style": "check",
              "frame": "dashed",
              "ink": "blue"
            },
            {
              "type": "code",
              "lang": "javascript",
              "lines": [
                "const res = await request(app)",
                "  .post('/users').send({ name: 'a' })",
                "  .set('Authorization', 'Bearer t')",
                "  .expect(201)",
                "  .expect('Content-Type', /json/);",
                "assert.equal(res.body.name, 'a');"
              ]
            },
            {
              "type": "heading",
              "text": "2. Database Test Doubles",
              "ink": "purple"
            },
            {
              "type": "bullets",
              "items": [
                "==Inject== the repository as a dependency; the handler then needs no real DB"
              ],
              "style": "dot"
            },
            {
              "type": "table",
              "headers": [
                "Double",
                "Does",
                "Example"
              ],
              "rows": [
                [
                  "**Fake**",
                  "keeps real behavior",
                  "in-memory repo, SQLite `:memory:`"
                ],
                [
                  "**Stub**",
                  "returns canned rows",
                  "fixed list from `findAll`"
                ],
                [
                  "**Mock**",
                  "verifies calls",
                  "`toHaveBeenCalledWith`"
                ]
              ]
            },
            {
              "type": "heading",
              "text": "3. Real DB and Coverage",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "Throwaway test DB or ==Testcontainers==; run migrations once",
                "Per test: ==roll back== a transaction, or truncate in `beforeEach`",
                "Tests stay independent and order-free"
              ],
              "style": "check",
              "ink": "green"
            },
            {
              "type": "table",
              "headers": [
                "Runner",
                "Coverage command"
              ],
              "rows": [
                [
                  "node:test",
                  "`node --test --experimental-test-coverage`"
                ],
                [
                  "Jest",
                  "`jest --coverage`"
                ],
                [
                  "Vitest",
                  "`vitest run --coverage` (v8 or istanbul)"
                ]
              ]
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Coverage is not correctness",
              "text": "It counts executed ==line, branch, function, statement==. Set CI thresholds, but weak assertions make high coverage prove little."
            }
