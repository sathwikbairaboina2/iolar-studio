          "blocks": [
            {
              "type": "qa",
              "q": "A CommonJS file schedules `setTimeout(t, 0)`, `setImmediate(i)`, `Promise.resolve().then(p)` and `process.nextTick(n)`, then logs `s`. What prints, in order?",
              "a_bullets": [
                "`s`, then `n`, then `p`.",
                "`t` and `i` come after, in no fixed order from the main module."
              ]
            },
            {
              "type": "qa",
              "q": "Inside an `fs.readFile` callback you schedule `setTimeout(t, 0)` and `setImmediate(i)`. Which runs first?",
              "a_bullets": [
                "`i`, every time.",
                "The callback runs in poll, and check comes next. Timers wait for the next turn."
              ]
            },
            {
              "type": "qa",
              "q": "A handler calls `fs.readFileSync` on a 200 MB file. One user hits it, yet everyone stalls. Why, and what fixes it?",
              "a_bullets": [
                "The sync call holds the only JS thread, so no other callback runs.",
                "Use a stream or async read. For CPU work, use a worker thread."
              ]
            }
