    {
      "page_title": "Error Codes, Signals & pipe vs pipeline",
      "blocks": [
        {
          "type": "bullets",
          "items": [
            "Unhandled `error` event **crashes** the process",
            "HTTP mid-stream: headers sent, no 500 — destroy the socket",
            "Throwing from an async callback — nothing catches it"
          ],
          "style": "cross"
        },
        {
          "type": "callout",
          "style": "tip",
          "title": "Leak check",
          "text": "Rising ==writableLength== / ==readableLength== over time means one side is ignoring the signal."
        },
        {
          "type": "callout",
          "style": "sticky",
          "title": "finished()",
          "text": "`stream.finished(s)` detects end, error or close on ONE stream — no piping needed."
        },
        {
          "type": "heading",
          "text": "7. Errors To Recognise",
          "ink": "red"
        },
