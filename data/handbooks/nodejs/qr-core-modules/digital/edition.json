              "type": "heading",
              "text": "1. os and process",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "`os.cpus().length` cores; `os.totalmem()` and `os.freemem()` in bytes",
                "`os.platform()` gives ==linux==, ==win32== or ==darwin==",
                "`os.homedir()`, `os.tmpdir()`, `os.EOL` (line ending)"
              ],
              "style": "dot"
            },
            {
              "type": "table",
              "headers": [
                "process",
                "Gives"
              ],
              "rows": [
                [
                  "`argv.slice(2)`",
                  "your args (first two: node, script)"
                ],
                [
                  "`env.NAME`",
                  "a **string**, or undefined"
                ],
                [
                  "`cwd()` / `pid`",
                  "working dir / process id"
