                [
                  "`exit(code)`",
                  "stops at once"
                ]
              ]
            },
            {
              "type": "code",
              "lang": "javascript",
              "lines": [
                "const port = Number(process.env.PORT ?? 3000);"
              ],
              "note": "env values are always strings: convert, default with ??"
            },
            {
              "type": "heading",
              "text": "2. URL and URLSearchParams",
              "ink": "green"
            },
            {
              "type": "code",
              "lang": "javascript",
              "lines": [
                "const u = new URL(req.url, 'http://localhost');",
                "u.pathname;                // '/users'",
                "u.searchParams.get('id');  // '7', or null",
                "const p = new URLSearchParams();",
                "p.append('a', '1');",
                "p.has('a');                // true",
                "p.toString();              // 'a=1'"
              ]
            },
            {
              "type": "bullets",
              "items": [
                "`querystring.parse` and `url.parse` are {orange:legacy}; use ==URL== in new code"
              ],
              "style": "star"
            },
            {
              "type": "heading",
              "text": "3. Mistakes",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "`new URL('/path')` throws: it needs a ==base==",
                "`searchParams` values are strings: cast with `Number()`"
              ],
              "style": "cross",
              "ink": "red"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Exit cleanly",
              "text": "`process.exit()` cuts off pending I/O. Set ==process.exitCode== and let the process end."
            }
          ]
        }
      ]
    },
    {
      "title": "Node Core Modules Cheat Sheet",
      "role": "outline",
      "outlineIndex": 5,
      "pages": [
        {
          "title": "Node Core Modules Cheat Sheet",
          "blocks": [
            {
              "type": "heading",
              "text": "1. fs and path",
              "ink": "green"
            },
            {
              "type": "table",
              "headers": [
                "Module",
                "Remember"
              ],
              "rows": [
                [
                  "fs",
                  "==promises== for servers, `Sync` only at startup"
                ],
                [
                  "fs",
                  "always pass `'utf8'`; `mkdir` with `recursive: true`; `rm` with `force: true`"
                ],
                [
                  "path",
                  "`join` concatenates; `resolve` gives an absolute path from cwd"
                ]
              ]
            },
            {
              "type": "code",
              "lang": "javascript",
              "lines": [
                "const __dirname = dirname(fileURLToPath(import.meta.url));"
              ],
              "note": "ESM replacement for __dirname"
            },
            {
              "type": "heading",
              "text": "2. http, process, URL",
              "ink": "blue"
            },
            {
              "type": "code",
              "lang": "javascript",
              "lines": [
                "createServer((req, res) => {",
                "  res.writeHead(200, { 'Content-Type': 'application/json' });",
                "  res.end(JSON.stringify({ ok: true }));",
                "}).listen(3000);"
              ]
            },
            {
              "type": "table",
              "headers": [
                "Module",
                "Remember"
              ],
              "rows": [
                [
                  "http",
                  "always `res.end()`; status and Content-Type via `writeHead`"
                ],
                [
                  "process",
                  "`argv.slice(2)`; env values are strings; set `exitCode`, not `exit()`"
                ],
                [
                  "URL",
                  "`new URL(req.url, base)`, then `searchParams.get()`; `querystring`, `url.parse` are legacy"
                ]
              ]
            },
            {
              "type": "heading",
              "text": "3. Interview Point",
              "ink": "purple"
            },
            {
              "type": "bullets",
              "items": [
                "**Sync fs and the loop?** Sync blocks the event loop; async runs on the thread pool",
                "**join vs resolve?** `join('/a','/b')` is `/a/b`; `resolve` gives `/b`",
                "**ESM `__dirname`?** Only CommonJS has it; derive it from `import.meta.url`",
                "**Request body?** Collect `req.on('data')` chunks, parse in `req.on('end')`"
              ],
              "style": "dot"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Handler rule",
              "text": "Never `readFileSync` in a handler: it stalls every request."
            }
          ]
        }
      ]
