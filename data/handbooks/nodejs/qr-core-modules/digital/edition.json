    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "On Linux, what do `path.join('/a', '/b')` and `path.resolve('/a', '/b')` return?",
              "a_bullets": [
                "`join` gives `'/a/b'`: it only concatenates.",
                "`resolve` gives `'/b'`: an absolute segment resets the path."
              ]
            },
            {
              "type": "qa",
              "q": "A file in a `type: module` project calls `path.join(__dirname, 'data.json')`. What happens, and what is the fix?",
              "a_bullets": [
                "ReferenceError: `__dirname` exists only in CommonJS.",
                "Use `path.dirname(fileURLToPath(import.meta.url))`."
              ]
            },
            {
              "type": "qa",
              "q": "With `PORT=3000` set, what does `process.env.PORT + 1` evaluate to?",
              "a_bullets": [
                "`'30001'`: env values are strings, so `+` concatenates.",
                "Use `Number(process.env.PORT) + 1` to get 3001."
              ]
            }
          ]
        }
      ]
    }
