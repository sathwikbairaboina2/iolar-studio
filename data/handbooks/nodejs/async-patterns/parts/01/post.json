    {
      "page_title": "Combinator Picks & async/await",
      "blocks": [
        {
          "type": "table",
          "headers": [
            "Pick",
            "Meaning"
          ],
          "rows": [
            [
              "all",
              "every-or-nothing"
            ],
            [
              "allSettled",
              "report card"
            ],
            [
              "race",
              "first settled"
            ],
            [
