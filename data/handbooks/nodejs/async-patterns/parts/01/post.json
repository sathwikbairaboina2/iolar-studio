          "ink": "red"
        },
        {
          "type": "bullets",
          "items": [
            "Errors don't compose — every level forwards by hand.",
            "One missed forward silently swallows the failure.",
            "No return value — you can't build pipelines.",
            "Control flow is manual: parallel needs your own latch."
          ]
        },
        {
          "type": "code",
          "lang": "js",
          "lines": [
            "let n = 3, out = [];",
            "const done = i => (e, v) => {",
            "  out[i] = v;",
            "  if (--n === 0) final(null, out);  // the latch",
            "};"
          ],
          "runnable": false
        },
