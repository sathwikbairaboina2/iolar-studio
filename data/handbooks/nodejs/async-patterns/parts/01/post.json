        {
          "type": "heading",
          "text": "3. Promise States",
          "ink": "green"
        },
        {
          "type": "diagram",
          "kind": "flow",
          "spec": {
            "nodes": [
              "pending",
              "fulfilled (value) | rejected (reason)",
              "settled — permanent"
            ]
          }
        },
        {
          "type": "bullets",
          "items": [
            "Transitions are one-way and irreversible.",
            "Settled = fulfilled or rejected.",
            "A promise is an OBJECT for a future value.",
            "So it can be returned, stored, passed — a callback can't."
          ]
        }
      ],
