        {
          "type": "heading",
          "text": "5. Where They Come From",
          "ink": "blue"
        },
        {
          "type": "bullets",
          "items": [
            "#1 fire-and-forget: `doWork()` with no await, no catch.",
            "#2 async callbacks to APIs that ignore return values.",
            "e.g. `emitter.on('data', async …)`, forEach, Express 4.",
            "#3 losers of `all` / `race` rejecting after it settled."
          ]
        }
      ]
