    {
      "title": "Diagnosing Memory Leaks and Graceful Shutdown",
      "role": "outline",
      "outlineIndex": 4,
      "pages": [
        {
          "title": "Diagnosing Memory Leaks and Graceful Shutdown",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Hunting a Leak",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "==heapUsed== from `process.memoryUsage()` keeps climbing after GC",
                "Healthy: a sawtooth that stays {green:level}",
                "Leak: the sawtooth floor {red:never returns} to baseline"
              ],
              "style": "dot"
            },
            {
              "type": "diagram",
              "kind": "chain",
              "spec": {
                "title": "Three-snapshot technique (DevTools Memory tab)",
                "steps": [
                  {
                    "text": "Snapshot 1",
                    "ink": "blue"
                  },
                  {
                    "text": "Run workload",
                    "ink": "orange"
                  },
                  {
                    "text": "Snapshot 2",
                    "ink": "blue"
                  },
                  {
                    "text": "Run again",
                    "ink": "orange"
                  },
                  {
                    "text": "Snapshot 3",
                    "ink": "blue"
                  }
                ]
              }
            },
            {
              "type": "bullets",
              "items": [
                "Filter: ==Objects allocated between Snapshot 1 and 2==, sort by **Retained Size**",
                "==Retainers== pane shows what holds the object",
                "Culprits: unbounded `Map` or cache, global arrays, closures",
                "Culprit: `emitter.on` in a request handler, never removed"
              ],
              "style": "check"
            },
            {
              "type": "heading",
              "text": "2. Signals",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "Signal",
                "Sent by",
                "Catchable"
              ],
              "rows": [
                [
                  "==SIGTERM==",
                  "Docker, k8s, systemd (polite stop)",
                  "{green:yes}: `process.on('SIGTERM', shutdown)`"
                ],
                [
                  "SIGINT",
                  "Ctrl+C",
                  "{green:yes}"
                ],
                [
                  "SIGKILL",
                  "forced kill",
                  "{red:never}"
                ]
              ]
            },
            {
              "type": "heading",
              "text": "3. Graceful Shutdown",
              "ink": "green"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "server.close()",
                    "sub": "stop accepting",
                    "ink": "red"
                  },
                  {
                    "text": "In-flight",
                    "sub": "let them finish",
                    "ink": "orange"
                  },
                  {
                    "text": "Close DB, queues",
                    "ink": "blue"
                  },
                  {
                    "text": "exit(0)",
                    "ink": "green"
                  }
                ]
              }
            },
            {
              "type": "code",
              "lang": "javascript",
              "lines": [
                "process.on('SIGTERM', shutdown);",
                "function shutdown() {",
                "  setTimeout(() => process.exit(1), 10000).unref();",
                "  server.close(async () => {",
                "    await db.end(); process.exit(0);",
                "  });",
                "}"
              ],
              "note": "unref'd force-exit timer"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Grace period",
              "text": "Force-exit timer must be ==shorter== than the platform grace period (k8s default **30s**). No SIGTERM handler means SIGKILL."
            }
          ]
        }
      ]
    },
