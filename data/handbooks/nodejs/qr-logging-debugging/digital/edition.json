    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "Logger level is `info`. Which of these lines print: `debug`, `info`, `warn`?",
              "a_bullets": [
                "`info` and `warn` print.",
                "A level logs itself and everything above it; `debug` (20) is below `info` (30)."
              ],
              "example_code": [
                "logger.debug('a')",
                "logger.info('b')",
                "logger.warn('c')"
              ]
            },
            {
              "type": "qa",
              "q": "Spot the bug: why does this drop in-flight requests on deploy?",
              "a_bullets": [
                "`process.exit(0)` runs first, so the process dies before `server.close()` can finish anything.",
                "Correct order: `server.close()`, finish in-flight requests, close the DB, then exit."
              ],
              "example_code": [
                "process.on('SIGTERM', () => {",
                "  process.exit(0);",
                "  server.close();",
                "});"
              ]
            },
            {
              "type": "qa",
              "q": "`heapUsed` keeps rising after GC. Each request runs `bus.on('tick', fn)`. What is the leak?",
              "a_bullets": [
                "Listeners are never removed, so `bus` retains every closure.",
                "The Retainers pane in a heap snapshot shows `bus` holding them."
              ]
            }
          ]
        }
      ]
    }
