            [
              "BEAST / POODLE",
              "CBC mode",
              "AEAD only"
            ],
            [
              "FREAK / Logjam",
              "export / custom DH",
              "removed"
            ],
            [
              "ROBOT",
              "RSA key transport",
              "removed"
