      "blocks": [
        {
          "type": "heading",
          "text": "What It Actually Controls",
          "ink": "blue"
        },
        {
          "type": "bullets",
          "items": [
            "Whether a cookie rides on CROSS-SITE requests",
            "The browser-level CSRF mitigation",
            "'Site' means eTLD+1, the registrable domain",
            "`a.example.com` to `b.example.com` is same-site"
          ]
        },
        {
          "type": "table",
          "headers": [
            "Value",
            "Sent cross-site?",
            "Needs"
          ],
          "rows": [
            [
              "`Strict`",
              "never",
              "—"
            ],
            [
              "`Lax`",
              "top-level GET only",
              "—"
            ],
            [
              "`None`",
              "always",
              "`Secure`"
            ]
          ]
        },
        {
          "type": "heading",
          "text": "Same-Site Or Cross-Site?"
        },
        {
          "type": "table",
          "headers": [
            "From",
            "To",
            "Relation"
          ],
          "rows": [
            [
              "`a.example.com`",
              "`b.example.com`",
              "same-site"
            ],
            [
              "`example.com`",
              "`evil.com`",
              "**cross-site**"
            ],
            [
              "`me.github.io`",
              "`you.github.io`",
              "**cross-site** (PSL)"
            ]
          ]
        },
        {
          "type": "heading",
          "text": "Lax In Detail",
          "ink": "red"
        },
        {
          "type": "bullets",
          "items": [
            "Sent on link clicks and `window.location` navigations",
            "Blocked on POST, iframe, `fetch`, `img`, XHR",
            "Omitted attribute = `Lax` on modern Chrome, Firefox, Edge",
            "Older browsers treated the omission as `None`"
          ]
        },
        {
          "type": "heading",
          "text": "The Attack Lax Blocks"
        },
        {
          "type": "code",
          "lang": "html",
          "lines": [
            "<!-- page on evil.com -->",
            "<form method=\"POST\"",
            "  action=\"https://bank.com/pay\">",
            "</form>  <!-- auto-submitted -->"
          ],
          "note": "Lax/Strict: session cookie not sent"
        },
        {
          "type": "callout",
          "style": "cloud",
          "title": "Strict's Real Cost",
          "text": "Click your app's link from Gmail or a search result and the first page renders logged OUT. Users read that as a broken login."
        },
        {
          "type": "sidebox",
          "title": "Browser Quirks",
          "items": [
            "`None` without `Secure` = cookie rejected entirely",
            "Chrome once gave new cookies a 2-minute POST grace window",
            "Never build on that grace window",
            "Safari/ITP blocked third-party cookies regardless — test it separately"
          ]
        },
        {
          "type": "bullets",
          "items": [
            "`None`+`Secure` only for genuine third-party embeds",
            "SSO iframes, payment widgets, embedded chat",
            "Never as a shortcut to 'make it work'"
          ]
        }
      ]
    },
    {
      "page_title": "SameSite Policies (cont.)",
      "blocks": [
        {
          "type": "heading",
          "text": "Choosing A Value",
          "ink": "green"
        },
        {
          "type": "diagram",
          "kind": "cards",
          "spec": {
            "cards": [
              {
                "title": "Strict",
                "lines": [
                  "banking-grade actions",
                  "admin panels",
                  "no smooth link entry"
                ]
              },
              {
                "title": "Lax",
                "lines": [
                  "normal app sessions",
                  "default choice",
                  "links still work"
                ]
              }
            ]
          }
        },
        {
          "type": "table",
          "headers": [
            "Context",
            "Value"
          ],
          "rows": [
            [
              "first-party app",
              "`Lax`"
            ],
            [
              "admin panel",
              "`Strict`"
            ],
            [
              "SSO iframe",
              "`None; Secure`"
            ],
            [
              "chat widget",
              "`None; Secure; Partitioned`"
            ]
          ]
        },
        {
          "type": "callout",
          "style": "takeaway",
          "title": "Lax Still Allows GET",
          "text": "A GET that mutates state, like `/delete?id=5`, is CSRF-able even under `Lax`. Never mutate on GET — the attribute cannot save you."
        },
        {
          "type": "sidebox",
          "title": "CHIPS / Partitioned",
          "items": [
            "For third-party contexts only",
            "One cookie jar per top-level site",
            "The cookie cannot track across sites"
          ]
        },
        {
          "type": "heading",
          "text": "Redirect Flows Break",
          "ink": "red"
        },
        {
          "type": "bullets",
          "items": [
            "OAuth callbacks and payment returns arrive cross-site",
            "`form_post` returns are cross-site POSTs — `Lax` drops them",
            "`Strict` drops even the GET return hop",
            "Symptom: 'state mismatch' or a logged-out landing page"
          ],
          "style": "cross"
        },
        {
          "type": "heading",
          "text": "Layering It"
        },
        {
          "type": "bullets",
          "items": [
            "Two-cookie pattern: `Lax` read session for smooth entry",
            "Plus a `Strict` cookie required on state-changing routes",
            "SameSite is defence in depth, not a CSRF replacement",
            "Keep tokens for old browsers and same-site XSS"
          ]
        },
        {
          "type": "code",
          "lang": "http",
          "lines": [
            "Set-Cookie: __Host-sid=r1; Secure;",
            "  HttpOnly; SameSite=Lax; Path=/",
            "Set-Cookie: __Host-act=w1; Secure;",
            "  HttpOnly; SameSite=Strict; Path=/"
          ],
          "note": "writes demand the Strict cookie"
        },
        {
          "type": "callout",
          "style": "tip",
          "title": "Cookie Missing? Ask Chrome",
          "text": "Network tab → request → Cookies pane lists each blocked cookie with the reason, including SameSite. Check it before blaming the server."
        }
      ],
      "cont": true
