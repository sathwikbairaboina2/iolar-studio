          "ink": "blue"
        },
        {
          "type": "code",
          "lang": "http",
          "lines": [
            "Date: 10:00:00 GMT",
            "Cache-Control: max-age=600",
            "Age: 450      # sat at the edge",
            "# browser gets 600 - 450 = 150s"
          ],
          "note": "clock starts at Date, not arrival"
        },
