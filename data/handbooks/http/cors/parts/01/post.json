        {
          "type": "bullets",
          "items": [
            "Public read-only API: `ACAO: *`, no `Vary` needed",
            "Allowlist: exact-match a config set, echo it back",
            "Rejection = omit ACAO entirely",
            "Do NOT return `ACAO: null` or a 403 with CORS headers"
          ]
        },
