  "series": "HTTP FIELD MANUAL",
  "date": "07/09/2026",
  "slides": [
    {
      "page_title": "Anatomy of a Method",
      "blocks": [
        {
          "type": "heading",
          "text": "Request Line Shape",
          "ink": "blue"
        },
        {
          "type": "code",
          "lang": "http",
          "lines": [
            "GET /users/42 HTTP/1.1",
            "Host: api.example.com",
            "# METHOD SP request-target SP version"
          ]
        },
        {
          "type": "bullets",
          "items": [
            "Three tokens, one space each, then headers",
            "Methods are case-sensitive, uppercase by convention",
            "`get` is not `GET` — servers must reject it",
            "Method is the semantic verb, not the implementation"
          ]
        },
        {
          "type": "heading",
          "text": "The Standard Set",
          "ink": "red"
        },
        {
          "type": "diagram",
          "kind": "chain",
          "spec": {
            "title": "HTTP methods",
            "steps": [
              {
                "text": "reads",
                "note": "GET · HEAD · OPTIONS · TRACE"
              },
              {
                "text": "writes",
                "note": "POST · PUT · PATCH · DELETE"
              },
              {
                "text": "tunnel",
                "note": "CONNECT"
              }
            ]
          }
        },
        {
          "type": "table",
          "headers": [
            "Method",
            "Intent"
          ],
          "rows": [
            [
              "GET",
              "fetch representation"
            ],
            [
              "HEAD",
              "GET minus body"
            ],
            [
              "POST",
              "server processes data"
            ],
            [
              "PUT",
              "client replaces resource"
            ],
            [
              "DELETE",
              "remove resource"
            ]
          ]
        },
        {
          "type": "bullets",
          "items": [
            "GET: the only verb an address bar issues",
            "HEAD keeps `Content-Length` — size before download",
            "POST: the server decides what and where",
            "PUT: the client picks the URL, full replace"
          ]
        },
        {
          "type": "heading",
          "text": "PATCH and the Rest",
          "ink": "blue"
        },
        {
          "type": "bullets",
          "items": [
            "PATCH applies a patch document, partial edit",
            "JSON Patch RFC 6902, JSON Merge Patch RFC 7386",
            "OPTIONS asks what a resource supports",
            "OPTIONS answers with `Allow:`, and drives CORS preflight"
          ]
        },
        {
          "type": "sidebox",
          "title": "Rarely Seen, Still Spec",
          "items": [
            "TRACE echoes the request for loopback debugging",
            "TRACE is off everywhere — Cross-Site Tracing (XST)",
            "CONNECT opens a TCP tunnel through a proxy",
            "That is how HTTPS crosses an HTTP proxy"
          ]
        },
        {
          "type": "callout",
          "style": "tip",
          "title": "Not Every Verb Fits Every URL",
          "text": "405 Method Not Allowed exists for exactly this case: the resource is real, the method is not defined for it."
        }
      ]
    },
    {
      "page_title": "Safe, Idempotent, Cacheable",
      "blocks": [
        {
          "type": "bullets",
          "items": [
            "Extension methods are legal: WebDAV `PROPFIND`, `MKCOL`, `LOCK`",
            "Only registered methods get generic intermediary handling"
          ]
        },
        {
          "type": "heading",
          "text": "Three Independent Axes",
          "ink": "blue"
        },
        {
          "type": "bullets",
          "items": [
            "Safe = read-only semantics, no intended state change",
            "Safe set: GET, HEAD, OPTIONS, TRACE",
            "Safe is not zero side effects — logs, analytics, counters are fine",
            "The client just isn't responsible for that change"
          ]
        },
        {
          "type": "heading",
          "text": "Idempotence",
          "ink": "red"
        },
        {
          "type": "bullets",
          "items": [
            "N identical requests = same server state as 1",
            "Idempotent: GET, HEAD, OPTIONS, TRACE, PUT, DELETE",
            "It is about server state, never the response body"
          ]
        },
        {
          "type": "code",
          "lang": "http",
          "lines": [
            "DELETE /users/42   -> 204 No Content",
            "DELETE /users/42   -> 404 Not Found",
            "# different answers, same final state"
          ]
        },
        {
          "type": "callout",
          "style": "takeaway",
          "title": "Safe Implies Idempotent",
          "text": "The reverse is false: PUT and DELETE change state, but repeating them changes nothing further."
        },
        {
          "type": "heading",
          "text": "Cacheability",
          "ink": "green"
        },
        {
          "type": "bullets",
          "items": [
            "GET and HEAD cacheable by default",
            "POST only with explicit freshness headers",
            "PUT, DELETE, PATCH: never cacheable"
          ]
        },
        {
          "type": "table",
          "headers": [
            "Method",
            "Safe",
            "Idem",
            "Cache"
          ],
          "rows": [
            [
              "GET",
              "yes",
              "yes",
              "yes"
            ],
            [
              "POST",
              "no",
              "no",
              "conditional"
            ],
            [
              "PUT",
              "no",
              "yes",
              "no"
            ],
            [
              "PATCH",
              "no",
              "no",
              "no"
            ],
            [
              "DELETE",
              "no",
              "yes",
              "no"
            ]
          ]
        },
        {
          "type": "heading",
          "text": "Reading The Grid",
          "ink": "purple"
        },
        {
          "type": "bullets",
          "items": [
            "Every ==safe== method is also idempotent",
            "PUT and DELETE: idempotent, **not** safe",
            "POST is none of safe, idempotent, cacheable by default",
            "PATCH idempotence depends on the patch document"
          ],
          "style": "checkbox"
        },
        {
          "type": "callout",
          "style": "sticky",
          "title": "Unknown Method?",
          "text": "A server that doesn't recognize the verb at all answers `501 Not Implemented` — server-wide, unlike per-resource 405."
        }
      ]
    },
    {
      "page_title": "Retry Bugs, GET Bodies and Ranges",
      "blocks": [
        {
          "type": "heading",
          "text": "PATCH Is The Odd One",
          "ink": "blue"
        },
        {
          "type": "bullets",
          "items": [
            "POST is neither safe nor idempotent",
            "Hence the browser's Confirm Form Resubmission on reload",
            "An append op grows the array on every call",
            "An absolute merge patch is idempotent"
          ]
        },
        {
          "type": "code",
          "lang": "json",
          "lines": [
            "{\"op\":\"add\",\"path\":\"/tags/-\",\"value\":\"x\"}",
            "// runs twice = two tags",
            ""
          ]
        },
        {
          "type": "heading",
          "text": "Why It Ships Bugs",
          "ink": "red"
        },
        {
          "type": "bullets",
          "items": [
            "Proxies and clients auto-retry idempotent requests on connection failure",
            "Crawlers and prefetchers follow GET links freely",
            "Never hide a destructive action behind a GET"
          ]
        },
        {
          "type": "sidebox",
          "title": "`GET /posts/42/delete`",
          "items": [
            "A prefetcher or antivirus scanner opens the link",
            "The database is wiped and no user ever clicked",
            "Use POST or DELETE — never a bare href"
          ]
        },
        {
          "type": "sidebox",
          "title": "`Idempotency-Key: <uuid>`",
          "items": [
            "Stripe and PayPal pattern for retryable POST",
            "Server stores the key, replays the first response",
            "Same key twice bills the customer once"
          ]
        },
        {
          "type": "heading",
          "text": "Bodies and URL Limits",
          "ink": "blue"
        },
        {
          "type": "bullets",
          "items": [
            "GET must carry no semantically meaningful body",
            "RFC 9110: a body may cause implementations to reject it",
            "Complex queries go in the query string",
            "Or POST to `/search` and accept losing cacheability"
          ]
        },
        {
          "type": "bullets",
          "items": [
            "URL length is not spec-limited, only practically capped",
            "~2 KB by IE legacy behaviour",
            "~8 KB by nginx `large_client_header_buffers`"
          ]
        },
        {
          "type": "heading",
          "text": "Conditional and Range",
          "ink": "red"
        },
        {
          "type": "code",
          "lang": "http",
          "lines": [
            "If-None-Match: \"a1b2\"   -> 304, no body",
            "Range: bytes=0-1023     -> 206 Partial",
            "Content-Range: bytes 0-1023/5000"
          ]
        },
        {
          "type": "bullets",
          "items": [
            "`If-Modified-Since: <date>` also yields 304",
            "206 powers resumable downloads and video seeking"
          ]
        }
      ]
    },
    {
      "page_title": "HEAD, OPTIONS and CORS Preflight",
      "blocks": [
        {
          "type": "heading",
          "text": "HEAD Rules",
          "ink": "green"
        },
        {
          "type": "bullets",
          "items": [
            "Must return exactly the headers GET would",
            "MUST NOT return a body, ever",
            "A server sending `Content-Length: 0` on HEAD is broken",
            "Uses: link checkers, cache probes, size before a big download"
          ]
        },
        {
          "type": "heading",
          "text": "OPTIONS and Preflight",
          "ink": "blue"
        },
        {
          "type": "bullets",
          "items": [
            "`OPTIONS * HTTP/1.1` asks about the server, not a resource",
            "Preflight sends `Access-Control-Request-Method` and `-Request-Headers`"
          ]
        },
        {
          "type": "code",
          "lang": "http",
          "lines": [
            "Access-Control-Allow-Methods: PUT, DELETE",
            "Access-Control-Allow-Headers: Authorization",
            "Access-Control-Max-Age: 600  # cache preflight"
          ]
        },
        {
          "type": "bullets",
          "items": [
            "Triggered by PUT, PATCH or DELETE",
            "Or by non-simple headers: `Authorization`, custom `X-*`",
            "Or by `Content-Type: application/json`"
          ]
        },
        {
          "type": "diagram",
          "kind": "flow",
          "spec": {
            "nodes": [
              "browser",
              "OPTIONS preflight",
              "204 + Allow-*",
              "real PUT",
              "200 OK"
            ]
          }
        },
        {
          "type": "callout",
          "style": "tip",
          "title": "Preflight Runs Unauthenticated",
          "text": "Your OPTIONS handler must answer 200 or 204 without a token. Requiring auth on preflight breaks every browser client."
        },
        {
          "type": "callout",
          "style": "takeaway",
          "title": "Never Mutate On GET",
          "text": "A convenience endpoint like `/api/refresh-cache` behind GET is a bug waiting for a crawler."
        },
        {
          "type": "heading",
          "text": "Who Names The URL",
          "ink": "blue"
        },
        {
          "type": "diagram",
          "kind": "cards",
          "spec": {
            "cards": [
              {
                "title": "POST",
                "lines": [
                  "server picks the URL",
                  "201 + `Location`",
                  "not idempotent",
                  "create, or any action"
                ]
              },
              {
                "title": "PUT",
                "lines": [
                  "client picks the URL",
                  "creates or replaces",
                  "idempotent",
                  "full representation"
                ]
              }
            ]
          }
        },
        {
          "type": "code",
          "lang": "http",
          "lines": [
            "POST /orders",
            "-> 201 Created",
            "-> Location: /orders/8812"
          ]
        }
      ]
    },
    {
      "page_title": "Picking the Write Verb",
      "blocks": [
        {
          "type": "bullets",
          "items": [
            "`PUT /users/42` writes exactly at that URL",
            "If you can't name the URL first, it's a POST"
          ]
        },
        {
          "type": "heading",
          "text": "Pick The Verb",
          "ink": "red"
        },
        {
          "type": "table",
          "headers": [
            "Situation",
            "Verb"
          ],
          "rows": [
            [
              "server names URL",
              "POST"
            ],
            [
              "client names URL",
              "PUT"
            ],
            [
              "some fields only",
              "PATCH"
            ],
            [
              "non-CRUD action",
              "POST"
            ]
          ]
        },
        {
          "type": "code",
          "lang": "http",
          "lines": [
            "PUT /users/42  -> 201 Created",
            "# nothing was there: created",
            "PUT /users/42  -> 204 No Content",
            "# replaced, client has the state"
          ],
          "note": "same request, idempotent final state"
        }
      ]
    },
    {
      "page_title": "PUT vs PATCH: Replace, Modify, Guard",
      "blocks": [
        {
          "type": "heading",
          "text": "Replace vs Modify",
          "ink": "red"
        },
        {
          "type": "bullets",
          "items": [
            "PUT is a full replacement — omitted fields are deleted",
            "Sending `{\"name\":\"Ada\"}` wipes that user's email",
            "PATCH changes only the described fields"
          ]
        },
        {
          "type": "table",
          "headers": [
            "Format",
            "Media type"
          ],
          "rows": [
            [
              "Merge Patch",
              "`application/merge-patch+json`"
            ],
            [
              "JSON Patch",
              "`application/json-patch+json`"
            ]
          ]
        },
        {
          "type": "code",
          "lang": "json",
          "lines": [
            "{\"email\": null}      // merge: deletes field",
            "// missing keys stay untouched",
            "[{\"op\":\"replace\",\"path\":\"/email\",\"value\":\"a@b.c\"}]"
          ]
        },
        {
          "type": "bullets",
          "items": [
            "JSON Patch is an ordered op array — expressive but verbose",
            "Never send bare `application/json` on PATCH and expect interop",
            "Declare the patch format or nothing interoperates"
          ]
        },
        {
          "type": "callout",
          "style": "takeaway",
          "title": "Merge Patch Can Be Idempotent",
          "text": "An absolute document like `{\"status\":\"paid\"}` lands the same state every time; a JSON Patch `add` op does not."
        },
        {
          "type": "heading",
          "text": "Shapes To Avoid",
          "ink": "green"
        },
        {
          "type": "bullets",
          "items": [
            "`PUT /users` means replace the whole collection",
            "Almost never what anyone actually wants",
            "RPC over HTTP loses caching, retry safety, intermediary understanding"
          ]
        },
        {
          "type": "bullets",
          "items": [
            "POST is the escape hatch for non-CRUD actions",
            "`POST /orders/8812/cancel`",
            "`POST /jobs/9/retry`"
          ]
        },
        {
          "type": "heading",
          "text": "Concurrency Guards",
          "ink": "blue"
        },
        {
          "type": "bullets",
          "items": [
            "Guard PUT/PATCH with `If-Match: \"etag\"`",
            "Stale etag returns 412 Precondition Failed — no lost update",
            "`If-None-Match: *` makes a create-only PUT"
          ]
        },
        {
          "type": "code",
          "lang": "http",
          "lines": [
            "PUT /articles/77",
            "If-Match: \"v3\"",
            "-> 412 Precondition Failed",
            "# someone saved v4 first"
          ],
          "note": "re-GET, merge, retry with new ETag"
        }
      ]
    },
    {
      "page_title": "Write-Path Checklist",
      "blocks": [
        {
          "type": "table",
          "headers": [
            "Verb",
            "Meaning",
            "Idem",
            "Codes"
          ],
          "rows": [
            [
              "POST",
              "server URL",
              "no",
              "201"
            ],
            [
              "PUT",
              "full replace",
              "yes",
              "200/201/204"
            ],
            [
              "PATCH",
              "partial change",
              "usually no",
              "200/204"
            ]
          ]
        },
        {
          "type": "heading",
          "text": "Write-Path Checklist",
          "ink": "purple"
        },
        {
          "type": "bullets",
          "items": [
            "PUT with a partial body — silently wipes fields",
            "PATCH sent as bare `application/json`",
            "POST for every write — ==RPC over HTTP==",
            "`PUT /users` replacing the whole collection"
          ],
          "style": "cross"
        },
        {
          "type": "bullets",
          "items": [
            "Create returns **201** + `Location`",
            "Guard updates with `If-Match` → 412 on conflict",
            "Declare `merge-patch+json` or `json-patch+json`",
            "Keep POST for actions: `/cancel`, `/retry`"
          ],
          "style": "checkbox"
        }
      ]
    },
    {
      "page_title": "DELETE: Repeats, Soft Deletes, Refusals",
      "blocks": [
        {
          "type": "heading",
          "text": "The Happy Path",
          "ink": "blue"
        },
        {
          "type": "bullets",
          "items": [
            "`DELETE /users/42` requests removal",
            "204 No Content when there is nothing to return",
            "200 with a body describing what was deleted also fine",
            "202 Accepted when the deletion is queued"
          ]
        },
        {
          "type": "bullets",
          "items": [
            "On 202, return `Location` to a status resource",
            "The client polls that URL for the outcome"
          ]
        },
        {
          "type": "heading",
          "text": "Deleting Twice",
          "ink": "red"
        },
        {
          "type": "code",
          "lang": "http",
          "lines": [
            "DELETE /users/42 -> 204",
            "DELETE /users/42 -> 404 or 410",
            "# state unchanged, still idempotent"
          ]
        },
        {
          "type": "bullets",
          "items": [
            "Some APIs answer 204 on repeat to keep clients simple",
            "Both are defensible — document which you chose",
            "410 Gone asserts it existed and was intentionally removed",
            "Search engines drop 410 URLs faster than 404"
          ]
        },
        {
          "type": "heading",
          "text": "Shapes That Bite",
          "ink": "green"
        },
        {
          "type": "bullets",
          "items": [
            "Soft delete (`deleted_at`) is business logic, not HTTP",
            "Over the wire it should still look like DELETE",
            "Not `POST /users/42/soft-delete`",
            "DELETE with a body is legal but proxies drop it — never rely on it"
          ]
        },
        {
          "type": "bullets",
          "items": [
            "Bulk delete has no clean HTTP shape",
            "`DELETE /users?ids=1,2,3` is one pragmatic choice",
            "`POST /users/bulk-delete` is the other"
          ]
        },
        {
          "type": "heading",
          "text": "Refusing To Delete",
          "ink": "blue"
        },
        {
          "type": "table",
          "headers": [
            "Situation",
            "Code"
          ],
          "rows": [
            [
              "has dependents",
              "409 Conflict"
            ],
            [
              "you may not",
              "403 Forbidden"
            ],
            [
              "never deletable",
              "405 Method Not Allowed"
            ]
          ]
        },
        {
          "type": "callout",
          "style": "tip",
          "title": "405 Without `Allow:` Is Malformed",
          "text": "The spec says a 405 MUST list what is allowed. Most frameworks forget the header, and clients guess."
        },
        {
          "type": "heading",
          "text": "Reading A Status Line",
          "ink": "blue"
        },
        {
          "type": "code",
          "lang": "http",
          "lines": [
            "HTTP/1.1 404 Not Found",
            "# 3 digits + reason phrase",
            "# clients MUST ignore the phrase"
          ]
        }
      ]
    },
    {
      "page_title": "Async Operations, Status Classes, 1xx",
      "blocks": [
        {
          "type": "heading",
          "text": "Long-Running Operations",
          "ink": "red"
        },
        {
          "type": "diagram",
          "kind": "flow",
          "spec": {
            "nodes": [
              "request",
              "202 + Location",
              "poll /operations/abc",
              "200 status",
              "303 See Other"
            ]
          }
        },
        {
          "type": "code",
          "lang": "http",
          "lines": [
            "DELETE /reports/9",
            "-> 202 Location: /operations/abc",
            "GET /operations/abc",
            "-> 200 {\"status\":\"running\"}",
            "-> 303 See Other when done"
          ],
          "note": "202 promises nothing about the outcome"
        },
        {
          "type": "bullets",
          "items": [
            "Name the blocking children in a 409 body",
            "Return `Cache-Control: no-store` on the DELETE",
            "A 2xx from an unsafe method invalidates that URL in shared caches"
          ]
        },
        {
          "type": "heading",
          "text": "Status Code Classes",
          "ink": "green"
        },
        {
          "type": "bullets",
          "items": [
            "The first digit is the class",
            "An unrecognized `418` MUST be treated as `400`",
            "x00 is the generic fallback of every class"
          ]
        },
        {
          "type": "table",
          "headers": [
            "Class",
            "Means"
          ],
          "rows": [
            [
              "1xx",
              "informational"
            ],
            [
              "2xx",
              "success"
            ],
            [
              "3xx",
              "redirection"
            ],
            [
              "4xx",
              "client error"
            ],
            [
              "5xx",
              "server error"
            ]
          ]
        },
        {
          "type": "heading",
          "text": "1xx Rare But Real",
          "ink": "red"
        },
        {
          "type": "bullets",
          "items": [
            "100 Continue: client sends `Expect: 100-continue` and waits",
            "Saves uploading a huge body the server would reject",
            "101 Switching Protocols: the WebSocket handshake",
            "With `Upgrade: websocket` and `Connection: Upgrade`"
          ]
        },
        {
          "type": "code",
          "lang": "http",
          "lines": [
            "HTTP/1.1 101 Switching Protocols",
            "Upgrade: websocket",
            "Connection: Upgrade",
            "# now frames, not HTTP"
          ]
        },
        {
          "type": "bullets",
          "items": [
            "103 Early Hints ships before the real response",
            "`Link: </style.css>; rel=preload` starts assets early"
          ]
        },
        {
          "type": "code",
          "lang": "http",
          "lines": [
            "HTTP/1.1 103 Early Hints",
            "Link: </style.css>; rel=preload",
            "",
            "HTTP/1.1 200 OK  # the real answer"
          ]
        },
        {
          "type": "callout",
          "style": "takeaway",
          "title": "Interim, Not Final",
          "text": "A 100 or 103 never ends the exchange — the real final response always follows it."
        }
      ]
    },
    {
      "page_title": "2xx Success and 301 vs 302",
      "blocks": [
        {
          "type": "heading",
          "text": "2xx By Intent",
          "ink": "green"
        },
        {
          "type": "bullets",
          "items": [
            "200 OK: generic success, body carries the representation",
            "Right for GET, and for POST/PUT/PATCH returning the entity",
            "201 Created: a new resource exists, MUST include `Location:`",
            "202 Accepted: valid and queued, outcome not guaranteed"
          ]
        },
        {
          "type": "code",
          "lang": "http",
          "lines": [
            "HTTP/1.1 201 Created",
            "Location: /orders/8812",
            "# body: the created representation"
          ]
        },
        {
          "type": "bullets",
          "items": [
            "204 No Content: success, deliberately no body",
            "Right for DELETE, and PUT/PATCH when the client knows the state"
          ]
        },
        {
          "type": "heading",
          "text": "Small Codes Worth Knowing",
          "ink": "blue"
        },
        {
