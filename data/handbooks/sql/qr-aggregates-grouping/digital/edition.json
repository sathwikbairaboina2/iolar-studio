        {
          "title": "Aggregates and the Grouping Mental Model",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Aggregates and groups",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "An ==aggregate== collapses many rows into **one value**",
                "`COUNT`, `SUM`, `AVG`, `MIN`, `MAX`",
                "No `GROUP BY`: the whole table is ==one group==, exactly one row",
                "`GROUP BY` splits rows into buckets: ==one output row== per bucket"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "code",
              "lang": "sql",
              "lines": [
                "SELECT dept, COUNT(*)",
                "FROM emp GROUP BY dept;"
              ],
              "note": "one row per dept",
              "result": {
                "headers": [
                  "dept",
                  "COUNT(*)"
                ],
                "rows": [
                  [
                    "Sales",
                    "3"
                  ],
                  [
                    "HR",
                    "2"
                  ]
                ]
              }
            },
            {
              "type": "heading",
              "text": "2. Ungrouped columns",
              "ink": "purple"
            },
            {
              "type": "table",
              "headers": [
                "Engine",
                "Column not in GROUP BY"
              ],
              "rows": [
                [
                  "SQL Server",
                  "{red:error} (strict)"
                ],
                [
                  "PostgreSQL, MySQL 5.7+",
                  "ok if functionally dependent on the key"
                ],
                [
                  "SQLite",
                  "bare column accepted"
                ]
              ],
              "frame": "dashed"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Portable rule",
              "text": "Every non-aggregated SELECT column goes in ==GROUP BY==, or inside an aggregate. Not an error in every engine, but safe in all."
            },
            {
              "type": "heading",
              "text": "3. Logical order",
              "ink": "blue"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "FROM",
                    "ink": "green"
                  },
                  {
                    "text": "WHERE",
                    "sub": "rows",
                    "ink": "blue"
                  },
                  {
                    "text": "GROUP BY",
                    "ink": "purple"
                  },
                  {
                    "text": "HAVING",
                    "sub": "groups",
                    "ink": "orange"
                  },
                  {
                    "text": "SELECT",
                    "ink": "red"
                  },
                  {
                    "text": "ORDER BY",
                    "ink": "black"
                  }
                ]
              }
            }
          ]
        }
      ]
