    {
      "title": "Core Aggregate Functions",
      "role": "outline",
      "outlineIndex": 1,
      "pages": [
        {
          "title": "Core Aggregate Functions",
          "blocks": [
            {
              "type": "heading",
              "text": "1. What each one does",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "`COUNT(*)` counts ==rows==; `COUNT(col)` counts ==non-NULL== values",
                "`SUM` and `AVG` ignore NULLs",
                "`AVG` = `SUM` / `COUNT(col)`, not the row count",
                "`MIN` and `MAX` work on numbers, strings and dates, and ignore NULLs"
              ],
              "style": "check"
            },
            {
              "type": "table",
              "headers": [
                "Function",
                "NULL values",
                "Zero rows"
              ],
              "rows": [
                [
                  "`COUNT(*)`",
                  "counted",
                  "{green:0}"
                ],
                [
                  "`COUNT(col)`",
                  "skipped",
                  "{green:0}"
                ],
                [
                  "`SUM`, `AVG`",
                  "skipped",
                  "{red:NULL}"
                ],
                [
                  "`MIN`, `MAX`",
                  "skipped",
                  "{red:NULL}"
                ]
              ]
            },
            {
              "type": "heading",
              "text": "2. Gotchas",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "Over zero rows only ==COUNT== returns 0; `SUM`, `AVG`, `MAX` return ==NULL=="
              ],
              "style": "cross"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "AVG skips NULLs",
              "text": "Values 10, 20, NULL give `AVG` = {green:15} (30 / 2), not 10 (30 / 3)."
            },
            {
              "type": "heading",
              "text": "3. Example",
              "ink": "purple"
            },
            {
              "type": "bullets",
              "items": [
                "One output row per `dept`: row count, average and max salary"
              ],
              "style": "dot"
            },
            {
              "type": "code",
              "lang": "sql",
              "lines": [
                "SELECT dept, COUNT(*), AVG(salary), MAX(salary)",
                "FROM emp",
                "GROUP BY dept;"
              ],
              "result": {
                "headers": [
                  "dept",
                  "COUNT(*)",
                  "AVG(salary)",
                  "MAX(salary)"
                ],
                "rows": [
                  [
                    "IT",
                    "3",
                    "60000",
                    "80000"
                  ],
                  [
                    "HR",
                    "2",
                    "50000",
                    "55000"
                  ]
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "title": "WHERE vs HAVING",
      "role": "outline",
      "outlineIndex": 2,
      "pages": [
        {
          "title": "WHERE vs HAVING",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Row filter vs group filter",
              "ink": "blue"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "FROM",
                    "ink": "black"
                  },
                  {
                    "text": "WHERE",
                    "sub": "filters rows",
                    "ink": "green"
                  },
                  {
                    "text": "GROUP BY",
                    "sub": "makes groups",
                    "ink": "blue"
                  },
                  {
                    "text": "HAVING",
                    "sub": "filters groups",
                    "ink": "orange"
                  },
                  {
                    "text": "SELECT",
                    "ink": "black"
                  }
                ]
              }
            },
            {
              "type": "table",
              "headers": [
                "",
                "WHERE",
                "HAVING"
              ],
              "rows": [
                [
                  "Filters",
                  "rows",
                  "groups"
                ],
                [
                  "Runs",
                  "before GROUP BY",
                  "after aggregation"
                ],
                [
                  "Aggregates",
                  "{red:not allowed}",
                  "{green:allowed}"
                ]
              ]
            },
            {
              "type": "heading",
              "text": "2. Example",
              "ink": "purple"
            },
            {
              "type": "bullets",
              "items": [
                "Keep ==active== rows first, then keep depts with **more than 5** of them"
              ],
              "style": "dot"
            },
            {
              "type": "code",
              "lang": "sql",
              "lines": [
                "SELECT dept, COUNT(*) FROM emp",
                "WHERE active = 1",
                "GROUP BY dept",
                "HAVING COUNT(*) > 5;"
              ]
            },
            {
              "type": "heading",
              "text": "3. Rules",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "Non-aggregate condition goes in ==WHERE==: shrinks data before grouping, faster",
                "`WHERE COUNT(*) > 5` is an {red:error}: no groups exist yet",
                "`HAVING` without `GROUP BY` treats the whole table as ==one group=="
              ],
              "style": "dot"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Remember",
              "text": "Row condition? ==WHERE==. Aggregate condition? ==HAVING==."
            }
          ]
        }
      ]
    },
    {
      "title": "DISTINCT and Counting with NULLs",
      "role": "outline",
      "outlineIndex": 3,
      "pages": [
        {
          "title": "DISTINCT and Counting with NULLs",
          "blocks": [
            {
              "type": "heading",
              "text": "1. DISTINCT",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "`SELECT DISTINCT a, b` dedupes the ==whole row==, not just `a`",
                "`COUNT(DISTINCT col)` counts unique ==non-NULL== values"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "heading",
              "text": "2. Three counts, three numbers",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "On 5, 5, NULL, 7",
                "Counts",
                "Result"
              ],
              "rows": [
                [
                  "`COUNT(*)`",
                  "all rows",
                  "{blue:4}"
                ],
                [
                  "`COUNT(col)`",
                  "non-NULL",
                  "{blue:3}"
                ],
                [
                  "`COUNT(DISTINCT col)`",
                  "unique non-NULL",
                  "{blue:2}"
                ]
              ],
              "frame": "dashed"
            },
            {
              "type": "heading",
              "text": "3. NULL rules",
              "ink": "purple"
            },
            {
              "type": "bullets",
              "items": [
                "`NULL = NULL` is ==not true==: use `IS NULL`",
                "`DISTINCT` and `GROUP BY` treat all NULLs as ==one group==",
                "Count NULLs with a `CASE` sum or `COUNT(*) - COUNT(col)`"
              ],
              "style": "dot"
            },
            {
              "type": "code",
              "lang": "sql",
              "lines": [
                "SELECT SUM(CASE WHEN col IS NULL",
                "  THEN 1 ELSE 0 END) AS n1,",
                "  COUNT(*) - COUNT(col) AS n2",
                "FROM t;"
              ]
            },
            {
              "type": "heading",
              "text": "4. Interview Point",
              "ink": "orange"
            },
            {
              "type": "bullets",
              "items": [
                "**Why do the three counts differ?** `COUNT(col)` skips NULLs, `DISTINCT` drops repeats",
                "**Is NULL = NULL true?** No; use `IS NULL`",
                "**What does `DISTINCT a, b` dedupe?** The `(a, b)` pair"
              ],
              "style": "check"
            }
          ]
        }
      ]
    },
    {
      "title": "CASE Expressions and Conditional Aggregation",
      "role": "outline",
      "outlineIndex": 4,
      "pages": [
        {
          "title": "CASE Expressions and Conditional Aggregation",
          "blocks": [
            {
              "type": "heading",
              "text": "1. CASE Basics",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "`CASE WHEN c1 THEN x WHEN c2 THEN y ELSE z END`",
                "==First matching== branch wins; later ones are skipped",
                "No `ELSE`: unmatched rows return ==NULL=="
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "heading",
              "text": "2. Conditional Aggregation",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "Conditional count: `SUM(CASE WHEN status = 'paid' THEN 1 ELSE 0 END)`",
                "Pivot-style: one aggregate per output column",
                "Without `ELSE`, non-matches are NULL and `SUM` skips them"
              ],
              "style": "dot"
            },
            {
              "type": "code",
              "lang": "sql",
              "lines": [
                "SELECT cust,",
                "  SUM(CASE WHEN year = 2024 THEN amt END) AS y2024,",
                "  SUM(CASE WHEN year = 2025 THEN amt END) AS y2025",
                "FROM sales GROUP BY cust;"
              ],
              "note": "one row per cust, one column per year"
            },
            {
              "type": "heading",
              "text": "3. Where CASE Fits",
              "ink": "purple"
            },
            {
              "type": "table",
              "headers": [
                "Place",
                "Use"
              ],
              "rows": [
                [
                  "`SELECT`",
                  "Label or bucket a value"
                ],
                [
                  "`ORDER BY`",
                  "Custom sort order"
                ],
                [
                  "`GROUP BY`",
                  "Group by a computed bucket"
                ],
                [
                  "Inside aggregate",
                  "Conditional `SUM` / `COUNT`"
                ]
              ]
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Empty pivot cell",
              "text": "A cell with no matching rows is ==NULL==, not 0. Use `ELSE 0` or `COALESCE` for zero."
            },
            {
              "type": "bullets",
              "items": [
                "**Why CASE inside SUM?** One pass gives several filtered totals",
                "**Missing ELSE?** Unmatched rows become NULL"
              ],
              "style": "check",
              "ink": "orange"
            }
          ]
        }
      ]
    },
    {
      "title": "Aggregates Cheat Sheet",
      "role": "outline",
