  "sections": [
    {
      "title": "Tables and Column Definitions",
      "role": "outline",
      "outlineIndex": 0,
      "pages": [
        {
          "title": "Tables and Column Definitions",
          "blocks": [
            {
              "type": "heading",
              "text": "1. What a Table Is",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "A ==table== is a named set of **typed columns**",
                "Each ==row== is one record",
                "The schema (names, types, constraints) lives in the {blue:database catalog}"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "blue"
            },
            {
              "type": "heading",
              "text": "2. CREATE TABLE",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "`CREATE TABLE name (col type [constraints], ..., [table constraints])`",
                "`IF NOT EXISTS` skips the error when the table already exists",
                "{green:Column constraints} sit inline after the type",
                "{purple:Table constraints} sit at the end; ==required for multi-column keys=="
              ],
              "style": "dot"
            },
            {
              "type": "code",
              "lang": "sql",
              "lines": [
                "CREATE TABLE users (",
                "  id INT PRIMARY KEY,",
                "  email VARCHAR(255) NOT NULL,",
                "  created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP",
                ");"
              ],
              "note": "all three are inline column constraints"
            },
            {
              "type": "heading",
              "text": "3. DROP vs TRUNCATE",
              "ink": "red"
            },
            {
              "type": "table",
              "headers": [
                "Command",
                "Structure",
                "Rows"
              ],
              "rows": [
                [
                  "`DROP TABLE t`",
                  "{red:removed}",
                  "{red:removed}"
                ],
                [
                  "`DROP TABLE IF EXISTS t`",
                  "{red:removed}",
                  "no error if missing"
                ],
                [
                  "`TRUNCATE TABLE t`",
                  "{green:kept}",
                  "{red:removed}"
                ]
              ],
              "highlightRow": 2
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Remember",
              "text": "==DROP== removes structure **and** data. ==TRUNCATE== empties rows but keeps the table."
            }
          ]
        }
      ]
    },
    {
      "title": "Choosing Data Types",
      "role": "outline",
      "outlineIndex": 1,
      "pages": [
        {
          "title": "Choosing Data Types",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Numbers",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "Type",
                "Size",
                "Use"
              ],
              "rows": [
                [
                  "`SMALLINT`",
                  "2 bytes",
                  "small counts"
                ],
                [
                  "`INT`",
                  "4 bytes, ~2.1 billion max",
                  "default id"
                ],
                [
                  "`BIGINT`",
                  "8 bytes",
                  "ids that may outgrow INT"
                ],
                [
                  "`DECIMAL(p,s)`",
                  "exact",
                  "money: `NUMERIC(10,2)`"
                ],
                [
                  "`FLOAT`/`DOUBLE`",
                  "approximate",
                  "measurements"
                ]
              ],
              "highlightRow": 3
            },
            {
              "type": "bullets",
              "items": [
                "{red:FLOAT} is approximate: `0.1+0.2` is not exactly `0.3`",
                "Money ==DECIMAL(10,2)==, never FLOAT"
              ],
              "style": "dot"
            },
            {
              "type": "heading",
              "text": "2. Text, Dates, Flags",
              "ink": "green"
            },
            {
              "type": "table",
              "headers": [
                "Type",
                "Meaning"
              ],
              "rows": [
                [
                  "`CHAR(n)`",
                  "fixed length, space-padded"
                ],
                [
                  "`VARCHAR(n)`",
                  "variable, max n"
                ],
                [
                  "`TEXT`",
                  "unbounded"
                ],
                [
                  "`DATE` / `TIME`",
                  "day only / time only"
                ],
                [
                  "`TIMESTAMP`",
                  "date + time, store in ==UTC=="
                ],
                [
                  "`BOOLEAN`",
                  "true/false flag"
                ]
              ]
            },
            {
              "type": "code",
              "lang": "sql",
              "lines": [
                "CREATE TABLE orders (",
                "  id BIGINT,",
                "  total DECIMAL(10,2),",
                "  placed_at TIMESTAMP,",
                "  paid BOOLEAN",
                ");"
              ]
            },
            {
              "type": "heading",
              "text": "3. Mistakes",
              "ink": "red"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Wrong type",
              "text": "Money in ==FLOAT== or dates in ==VARCHAR== breaks sorting, comparison and date arithmetic."
            },
            {
              "type": "bullets",
              "items": [
                "**When BIGINT over INT?** Ids that may pass ~2.1 billion.",
                "**Why DECIMAL for money?** It is exact; FLOAT rounds."
              ],
              "style": "check"
            }
          ]
        }
      ]
    },
    {
      "title": "PRIMARY KEY, UNIQUE and NOT NULL",
      "role": "outline",
      "outlineIndex": 2,
      "pages": [
        {
          "title": "PRIMARY KEY, UNIQUE and NOT NULL",
          "blocks": [
            {
              "type": "heading",
              "text": "1. PRIMARY KEY",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "`PRIMARY KEY` = ==UNIQUE + NOT NULL==",
                "It **identifies each row**; a table has ==at most one==",
                "The database builds an {green:index} for it automatically"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "blue"
            },
            {
              "type": "code",
              "lang": "sql",
              "lines": [
                "CREATE TABLE order_items (",
                "  order_id   INT,",
                "  product_id INT,",
                "  qty        INT NOT NULL,",
                "  PRIMARY KEY (order_id, product_id)",
                ");"
              ],
              "note": "composite key: a table constraint, unique as a pair"
            },
            {
              "type": "bullets",
              "items": [
                "Uniqueness applies to the ==combination==, not each column",
                "`(1, 7)` and `(1, 8)` are both allowed; a second `(1, 7)` fails"
              ],
              "style": "check"
            },
            {
              "type": "heading",
              "text": "2. UNIQUE and Auto Ids",
              "ink": "purple"
            },
            {
              "type": "table",
              "headers": [
                "",
                "PRIMARY KEY",
                "UNIQUE"
              ],
              "rows": [
                [
                  "Per table",
                  "**one**",
                  "**many**"
                ],
                [
                  "NULL",
                  "{red:never}",
                  "{green:allowed}"
                ]
              ],
              "highlightRow": 1
            },
            {
              "type": "bullets",
              "items": [
                "Many NULLs are fine in `UNIQUE` (most databases): NULL is **not equal** to NULL",
                "Postgres / standard: `id INT GENERATED ALWAYS AS IDENTITY`",
                "MySQL: `AUTO_INCREMENT`; SQLite: `AUTOINCREMENT`"
              ],
              "style": "dot"
            },
            {
              "type": "heading",
              "text": "3. NOT NULL",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "`NOT NULL` rejects missing values on insert and update",
                "Forgot it on a required column: it silently accepts ==NULL==, even if the app assumes otherwise"
              ],
              "style": "cross",
              "ink": "red"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Remember",
              "text": "PK = UNIQUE + NOT NULL. Plain UNIQUE still allows NULL, so add ==NOT NULL== to required columns."
            }
          ]
        }
      ]
    },
    {
      "title": "FOREIGN KEY and ON DELETE",
      "role": "outline",
      "outlineIndex": 3,
      "pages": [
        {
          "title": "FOREIGN KEY and ON DELETE",
          "blocks": [
            {
              "type": "heading",
              "text": "1. The Rule",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "`FOREIGN KEY (user_id) REFERENCES users(id)`: child value must match a parent key or be ==NULL==",
                "Referenced column must be a ==PRIMARY KEY== or ==UNIQUE==",
                "Both columns need the ==same data type=="
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "blue"
            },
            {
              "type": "code",
              "lang": "sql",
              "lines": [
                "CREATE TABLE orders (",
                "  id INT PRIMARY KEY,",
                "  user_id INT,",
                "  FOREIGN KEY (user_id) REFERENCES users(id)",
                "    ON DELETE CASCADE",
                ");"
              ],
              "note": "ON DELETE is set on the child table"
            },
            {
              "type": "heading",
              "text": "2. ON DELETE Actions",
              "ink": "purple"
            },
            {
              "type": "table",
              "headers": [
                "Action",
                "When the parent is deleted"
              ],
              "rows": [
                [
                  "{red:CASCADE}",
                  "Child rows are deleted too"
                ],
                [
                  "SET NULL",
                  "Child column becomes NULL (must be nullable)"
                ],
                [
                  "SET DEFAULT",
                  "Child column takes its column default"
                ],
                [
                  "RESTRICT",
                  "Delete blocked {red:at once}"
                ],
                [
                  "NO ACTION",
                  "Default; blocked at statement end, deferral in some databases"
                ]
              ],
              "highlightRow": 4
            },
            {
              "type": "heading",
              "text": "3. Mistakes",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "CASCADE on important data ==silently wipes== related rows",
                "SQLite ignores FKs unless `PRAGMA foreign_keys = ON`",
                "==Index== the FK column: joins and parent deletes scan it"
              ],
              "style": "cross",
              "frame": "dashed",
              "ink": "red"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Default",
              "text": "Omit ON DELETE and you get ==NO ACTION==: the parent delete is refused."
            }
          ]
        }
      ]
    },
    {
      "title": "CHECK, DEFAULT and ALTER TABLE",
      "role": "outline",
      "outlineIndex": 4,
      "pages": [
        {
          "title": "CHECK, DEFAULT and ALTER TABLE",
          "blocks": [
            {
              "type": "heading",
              "text": "1. CHECK and DEFAULT",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "`CHECK` ==rejects== any row where the condition is false",
                "A {red:NULL} result passes, so pair it with ==NOT NULL==",
                "`DEFAULT` fills the column when `INSERT` omits it",
                "`DEFAULT CURRENT_TIMESTAMP` is common",
                "**Name** constraints: clear errors, easy drops"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "code",
              "lang": "sql",
              "lines": [
                "CREATE TABLE products (",
                "  price DECIMAL(10,2) NOT NULL,",
                "  status VARCHAR(20) DEFAULT 'active',",
                "  CONSTRAINT chk_price CHECK (price >= 0)",
                ");"
              ],
              "note": "named CHECK, DEFAULT on status"
            },
            {
              "type": "heading",
              "text": "2. ALTER TABLE",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "ALTER TABLE t ...",
                "Syntax"
              ],
              "rows": [
                [
                  "Add column",
                  "`ADD COLUMN c type`"
                ],
                [
                  "Drop column",
                  "`DROP COLUMN c`"
                ],
                [
                  "Rename column",
                  "`RENAME COLUMN a TO b`"
                ],
                [
                  "Change type",
                  "`ALTER COLUMN c TYPE type` (Postgres)"
                ],
                [
                  "Change type",
                  "`MODIFY COLUMN c type` (MySQL)"
                ],
                [
                  "Add constraint",
                  "`ADD CONSTRAINT name ...`"
                ],
                [
                  "Drop constraint",
                  "`DROP CONSTRAINT name`"
                ]
              ]
            },
            {
              "type": "heading",
              "text": "3. Mistakes",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "`ADD COLUMN ... NOT NULL` on a populated table with no ==DEFAULT== fails",
                "Adding a constraint can ==lock== a large table"
              ],
              "style": "cross",
              "frame": "dashed",
              "ink": "red"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Remember",
              "text": "CHECK passes on NULL. Name every constraint so `DROP CONSTRAINT` works."
            }
          ]
        }
      ]
    },
    {
      "title": "Sample Schema and Cheat Sheet",
      "role": "outline",
      "outlineIndex": 5,
      "pages": [
        {
          "title": "Sample Schema and Cheat Sheet",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Three Linked Tables",
              "ink": "blue"
            },
            {
              "type": "diagram",
              "kind": "schema",
              "spec": {
                "tables": [
                  {
                    "name": "users",
                    "columns": [
                      "id PK identity",
                      "email UNIQUE NOT NULL",
                      "created_at DEFAULT CURRENT_TIMESTAMP"
                    ]
                  },
                  {
                    "name": "orders",
                    "columns": [
                      "id PK",
                      "user_id FK CASCADE",
                      "total DECIMAL(10,2) CHECK >= 0",
                      "status DEFAULT 'pending'"
                    ]
                  },
                  {
                    "name": "order_items",
                    "columns": [
                      "order_id FK CASCADE",
                      "product_id FK RESTRICT",
                      "qty INT CHECK > 0",
                      "PK (order_id, product_id)"
                    ]
                  },
                  {
                    "name": "products",
                    "columns": [
                      "id PK"
                    ]
                  }
                ],
                "links": [
                  {
                    "from": "orders",
                    "to": "users"
                  },
                  {
                    "from": "order_items",
                    "to": "orders"
                  },
                  {
                    "from": "order_items",
                    "to": "products"
                  }
                ]
              }
            },
            {
              "type": "heading",
              "text": "2. Order Matters",
              "ink": "orange"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "users",
                    "sub": "create first",
                    "ink": "green"
                  },
                  {
                    "text": "orders",
                    "sub": "needs users",
                    "ink": "blue"
                  },
                  {
                    "text": "order_items",
                    "sub": "create last",
                    "ink": "purple"
                  }
                ]
              }
            },
            {
              "type": "bullets",
              "items": [
                "{green:Create} parents before children; {red:drop} children before parents",
                "Wrong order: the ==FK blocks== the statement",
                "Composite PK is a table constraint, listed last; on MySQL, use a table-level `FOREIGN KEY`"
              ],
              "style": "cross",
              "ink": "orange"
            },
            {
              "type": "code",
              "lang": "sql",
              "lines": [
                "CREATE TABLE order_items (",
                "  order_id INT REFERENCES orders(id) ON DELETE CASCADE,",
                "  product_id INT REFERENCES products(id) ON DELETE RESTRICT,",
                "  qty INT CHECK (qty > 0),",
                "  PRIMARY KEY (order_id, product_id)",
                ");"
              ]
            },
            {
              "type": "heading",
              "text": "3. Cheat Sheet",
              "ink": "purple"
            },
            {
              "type": "table",
              "headers": [
                "Topic",
                "Rule"
              ],
              "rows": [
                [
                  "PK",
                  "==UNIQUE + NOT NULL=="
                ],
                [
                  "UNIQUE",
                  "allows **NULL**"
                ],
                [
                  "FK",
                  "target must be PK or UNIQUE"
                ],
                [
                  "ON DELETE",
                  "CASCADE deletes, SET NULL nulls, RESTRICT blocks"
                ],
                [
                  "CHECK",
                  "passes on **NULL**"
                ],
                [
                  "Money",
                  "`DECIMAL`, never FLOAT"
                ]
              ],
              "highlightRow": 3
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Remember",
              "text": "CHECK passes on NULL, so pair it with ==NOT NULL== when the value is required."
            }
          ]
        }
      ]
    },
    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "`email VARCHAR(255) UNIQUE` has no NOT NULL. You insert two rows with email NULL. What happens?",
              "a_bullets": [
                "Both succeed in most databases.",
                "NULL is not equal to NULL, so no duplicate is found."
              ]
            },
            {
              "type": "qa",
              "q": "`total DECIMAL(10,2) CHECK (total >= 0)`. Does inserting total NULL fail?",
              "a_bullets": [
                "No. The check evaluates to unknown, and unknown passes.",
                "Add NOT NULL to block it."
              ]
            },
            {
              "type": "qa",
              "q": "order_items.product_id is `ON DELETE RESTRICT`. You delete a product that appears in an order item. Result?",
              "a_bullets": [
                "The delete fails at once with an error.",
                "The item rows stay, and nothing is cascaded."
              ]
            }
          ]
        }
      ]
    }
  ]
