      "title": "SELECT Query Mental Model",
      "role": "outline",
      "outlineIndex": 0,
      "pages": [
        {
          "title": "SELECT Query Mental Model",
          "blocks": [
            {
              "type": "heading",
              "text": "1. What a query is",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "`SELECT` picks ==columns==, `FROM` names the ==table==",
                "A query describes the **result** you want",
                "The engine chooses **how** to fetch it",
                "Avoid `SELECT *` in production code"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "blue"
            },
            {
              "type": "code",
              "lang": "sql",
              "lines": [
                "SELECT name, city",
                "FROM users;"
              ],
              "note": "only the columns you need"
            },
            {
              "type": "heading",
              "text": "2. Logical order",
              "ink": "purple"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "FROM / JOIN",
                    "ink": "blue"
                  },
                  {
                    "text": "WHERE",
                    "ink": "blue"
                  },
                  {
                    "text": "GROUP BY",
                    "ink": "green"
                  },
                  {
                    "text": "HAVING",
                    "ink": "green"
                  },
                  {
                    "text": "SELECT",
                    "ink": "orange"
                  },
                  {
                    "text": "DISTINCT",
                    "ink": "orange"
                  },
                  {
                    "text": "ORDER BY",
                    "ink": "purple"
                  },
                  {
                    "text": "LIMIT",
                    "ink": "purple"
                  }
                ]
              }
            },
            {
              "type": "bullets",
              "items": [
                "A SELECT alias works in ==ORDER BY== (runs after SELECT)",
                "A SELECT alias fails in ==WHERE== (runs before SELECT)"
              ],
              "style": "check"
            },
            {
              "type": "heading",
              "text": "3. Result is a table",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "Every SELECT returns ==rows and columns==",
                "So it can feed another query as a **subquery**"
              ],
              "style": "dot"
            },
            {
              "type": "code",
              "lang": "sql",
              "lines": [
                "SELECT name",
                "FROM (SELECT name, city FROM users) AS u",
                "WHERE city = 'Pune';"
              ]
            }
          ]
        }
      ]
    },
    {
      "title": "Filtering, Sorting and Limiting",
      "role": "outline",
      "outlineIndex": 1,
      "pages": [
        {
          "title": "Filtering, Sorting and Limiting",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Filtering Rows",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "`WHERE` filters rows ==before grouping==",
                "`AND` binds tighter than `OR`: add ==parentheses==",
                "`BETWEEN` includes **both** ends"
              ],
              "style": "dot"
            },
            {
              "type": "table",
              "headers": [
                "Operator",
                "Meaning"
              ],
              "rows": [
                [
                  "`=` / `<>`",
                  "equal / not equal"
                ],
                [
                  "`IN (1,2,3)`",
                  "any value in the list"
                ],
                [
                  "`BETWEEN 10 AND 20`",
                  "10 to 20, inclusive"
                ],
                [
                  "`LIKE 'A%'`",
                  "`%` any chars, `_` one char"
                ]
              ]
            },
            {
              "type": "code",
              "lang": "sql",
              "lines": [
                "SELECT name, city FROM users",
                "WHERE age >= 18 AND city = 'Pune'",
                "  AND (plan = 'pro' OR plan = 'team')",
                "ORDER BY age DESC, name ASC",
                "LIMIT 10 OFFSET 20;"
              ],
              "note": "filter, sort on two keys, then page"
            },
            {
              "type": "heading",
              "text": "2. Sorting and Limiting",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "`ORDER BY col DESC, col2 ASC` sorts by ==multiple keys==",
                "No `ORDER BY`: row order is {red:not guaranteed}",
                "`LIMIT` without `ORDER BY` returns ==arbitrary rows=="
              ],
              "style": "dot"
            },
            {
              "type": "table",
              "headers": [
                "Engine",
                "Row limit",
                "ISO standard"
              ],
              "rows": [
                [
                  "PostgreSQL, MySQL, SQLite",
                  "`LIMIT 10 OFFSET 20`",
                  "no"
                ],
                [
                  "SQL Server",
                  "`TOP 10`",
                  "no"
                ],
                [
                  "Oracle",
                  "`OFFSET 20 ROWS FETCH FIRST 10 ROWS ONLY`",
                  "{green:yes} (SQL:2008)"
                ]
              ],
              "highlightRow": 2
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Sort before you page",
              "text": "`OFFSET` on unsorted rows can skip or repeat rows between pages."
            }
          ]
        }
      ]
    },
    {
      "title": "NULL Handling",
      "role": "outline",
      "outlineIndex": 2,
      "pages": [
        {
          "title": "NULL Handling",
          "blocks": [
            {
              "type": "heading",
              "text": "1. What NULL means",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "NULL = ==unknown==, not 0 or empty string",
                "Any comparison with NULL yields {orange:UNKNOWN}",
                "`col = NULL` never matches any row",
                "Use `IS NULL` / `IS NOT NULL`"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "heading",
              "text": "2. Filtering with NULL",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "`WHERE` keeps only rows that are ==TRUE==",
                "UNKNOWN rows are dropped",
                "`NOT IN (1, NULL)` returns {red:no rows}"
              ],
              "style": "dot"
            },
            {
              "type": "heading",
              "text": "3. Functions and aggregates",
              "ink": "purple"
            },
            {
              "type": "bullets",
              "items": [
                "`COALESCE(col, 'n/a')` = first non-NULL argument",
                "`NULLIF(a, 0)` = NULL when a is 0, so no divide-by-zero"
              ],
              "style": "dot"
            },
            {
              "type": "code",
              "lang": "sql",
              "lines": [
                "SELECT COALESCE(phone, 'n/a'),",
                "       total / NULLIF(qty, 0)",
                "FROM orders;"
              ]
            },
            {
              "type": "bullets",
              "items": [
                "`COUNT(col)` skips NULLs; `COUNT(*)` counts every row",
                "ORDER BY NULL placement differs by engine: `NULLS FIRST` / `NULLS LAST`"
              ],
              "style": "dot"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Mistake",
              "text": "`WHERE col = NULL` returns nothing. Write `col IS NULL`."
            },
            {
              "type": "sidebox",
              "title": "Interview Point",
              "items": [
                "**Why does NOT IN return nothing with a NULL?** Comparing to NULL is UNKNOWN, so no row is TRUE.",
                "**COUNT(*) vs COUNT(col)?** The first counts all rows; the second skips NULLs."
              ],
              "ink": "orange"
            }
          ]
        }
      ]
    },
    {
      "title": "INNER, LEFT, RIGHT and FULL Joins",
      "role": "outline",
      "outlineIndex": 3,
      "pages": [
        {
          "title": "INNER, LEFT, RIGHT and FULL Joins",
          "blocks": [
            {
              "type": "heading",
              "text": "1. What a join does",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "A join combines rows from two tables ==on a condition==",
                "`ON` names the matching columns; aliases keep them short"
              ],
              "style": "dot"
            },
            {
              "type": "code",
              "lang": "sql",
              "lines": [
                "SELECT o.id, u.name",
                "FROM orders o",
                "JOIN users u ON o.user_id = u.id;"
              ]
            },
            {
              "type": "heading",
              "text": "2. Join types",
              "ink": "purple"
            },
            {
              "type": "table",
              "headers": [
                "Join",
                "Keeps",
                "No match"
              ],
              "rows": [
                [
                  "**INNER**",
                  "matches on both sides",
                  "row dropped"
                ],
                [
                  "**LEFT**",
                  "all left rows",
                  "right cols = NULL"
                ],
                [
                  "**RIGHT**",
                  "all right rows (mirror of LEFT)",
                  "left cols = NULL"
                ],
                [
                  "**FULL OUTER**",
                  "all rows, both sides",
                  "NULL on missing side; {red:not in MySQL}"
                ]
              ]
            },
            {
              "type": "heading",
              "text": "3. Anti-join",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "Rows with ==no match==: LEFT JOIN, then keep the NULL right key"
              ],
              "style": "check"
            },
            {
              "type": "code",
              "lang": "sql",
              "lines": [
                "SELECT a.*",
                "FROM a",
                "LEFT JOIN b ON a.id = b.a_id",
                "WHERE b.a_id IS NULL;"
              ]
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Remember",
              "text": "Test `IS NULL` on a right column that is never NULL otherwise, like the join key."
            },
            {
              "type": "sidebox",
              "title": "Interview Point",
              "items": [
                "**INNER vs LEFT?** LEFT keeps unmatched left rows, right columns NULL",
                "**Rows in A with no B?** LEFT JOIN, `WHERE b.a_id IS NULL`"
              ],
              "ink": "orange"
            }
          ]
        }
      ]
    },
    {
      "title": "CROSS Joins, Self Joins and Join Mistakes",
      "role": "outline",
