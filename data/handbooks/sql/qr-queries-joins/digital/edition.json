    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "Table t has ids 1, 2, 3. What does `SELECT id FROM t WHERE id NOT IN (1, NULL)` return?",
              "a_bullets": [
                "None",
                "Row 1 fails id <> 1; rows 2 and 3 give UNKNOWN against NULL, so all are dropped."
              ]
            },
            {
              "type": "qa",
              "q": "Asha has no orders, Ben has a paid one. Who does this return?",
              "example_code": [
                "FROM users u LEFT JOIN orders o",
                "  ON o.user_id = u.id",
                "WHERE o.status = 'paid'"
              ],
              "a_bullets": [
                "Only Ben",
                "Asha's o.status is NULL, so WHERE is UNKNOWN and drops her",
                "Put the status test in ON to keep her"
              ]
            },
            {
              "type": "qa",
              "q": "Asha has 3 orders. What does `SELECT COUNT(*) FROM users u JOIN orders o ON o.user_id = u.id WHERE u.id = 1` return?",
              "a_bullets": [
                "3, not 1",
                "The join gives one row per order (fan-out)",
                "Use COUNT(DISTINCT u.id) to count users"
              ]
            },
            {
              "type": "qa",
              "q": "Why does `SELECT price * qty AS total FROM items WHERE total > 100` fail?",
              "a_bullets": [
                "WHERE runs before SELECT, so the alias does not exist yet",
                "Repeat the expression in WHERE; ORDER BY total works"
              ]
            }
          ]
        }
      ]
    }
