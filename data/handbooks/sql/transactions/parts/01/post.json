              "{green:no}",
              "{green:no}",
              "{red:allowed}"
            ],
            [
              "SERIALIZABLE",
              "{green:no}",
              "{green:no}",
              "{green:no}"
            ]
          ],
          "highlightRow": 3,
          "frame": "solid"
        },
        {
          "type": "heading",
          "text": "4. Reading It Back",
          "ink": "blue"
        },
        {
          "type": "table",
          "headers": [
            "Engine",
            "Check current level"
          ],
          "rows": [
            [
              "{icon:postgresql} Postgres",
              "`SHOW transaction_isolation`"
            ],
            [
              "{icon:mysql} MySQL",
              "`SELECT @@transaction_isolation`"
            ],
            [
              "SQL Server",
              "`DBCC USEROPTIONS`"
            ]
          ],
          "frame": "solid"
        },
        {
          "type": "heading",
          "text": "5. Engines May Be Stricter",
          "ink": "blue"
        },
        {
          "type": "bullets",
          "items": [
            "Assuming RR permits phantoms **everywhere** — Postgres RR is __snapshot isolation__ and blocks them",
            "Trusting MySQL RR against phantoms for `SELECT ... FOR UPDATE` — only __gap locks__ stop those",
            "Comparing two engines by level name instead of by anomaly"
          ],
          "style": "cross",
          "frame": "dashed",
          "ink": "red"
        },
        {
          "type": "sidebox",
          "title": "Same name, different guarantee",
          "items": [
            "{green:PG RR} = snapshot; **no** phantoms",
            "{orange:MySQL RR} = MVCC snapshot for plain SELECT",
            "MySQL locking reads escape the snapshot",
            "Defaults: PG/Oracle/MSSQL = RC, MySQL = RR"
          ],
          "ink": "purple"
        },
        {
          "type": "callout",
          "style": "cloud",
          "title": "The key rule",
          "text": "ANSI sets the **floor**, not the ceiling: a level forbids at least those anomalies, and an engine is free to forbid more. Always test the level on ==your== engine."
        },
        {
          "type": "paragraph",
          "text": "__Multi-Version Concurrency Control__: a writer never overwrites a row — it writes a ==new version==. So {green:readers never block writers} and {green:writers never block readers}.",
          "frame": "dashed",
          "ink": "green"
        }
      ],
      "hero": "postgresql",
      "subtitle": "ANSI dial, engine reality"
    },
    {
      "page_title": "MVCC: How Snapshots Are Built",
      "blocks": [
        {
          "type": "heading",
          "text": "1. Postgres row header",
          "ink": "blue"
        },
        {
          "type": "bullets",
          "items": [
            "`xmin` = XID that **created** this version",
            "`xmax` = XID that **deleted** it (0 = alive)",
            "UPDATE = insert new tuple + set old `xmax`",
            "Both live in the page, beside the row"
          ],
          "style": "number"
        },
        {
          "type": "heading",
          "text": "2. The snapshot test",
          "ink": "blue"
        },
        {
          "type": "paragraph",
          "text": "At snapshot time a transaction records the set of ==in-flight XIDs== plus the XID horizon.",
          "frame": "none"
        },
        {
          "type": "bullets",
          "items": [
            "Visible if `xmin` committed __before__ snapshot",
            "AND `xmin` not in the in-flight set",
            "AND `xmax` is 0, aborted, or still in-flight"
          ],
          "style": "check",
          "frame": "dashed",
          "ink": "purple"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "SELECT xmin, xmax, * FROM acct;",
            "-- xmin=812 xmax=0    visible",
            "-- xmin=790 xmax=812  old ver",
            "SELECT txid_current_snapshot();",
            "-- 810:814:811,813  (in-flight)"
          ],
          "note": "xmax set does not mean gone"
        },
        {
          "type": "heading",
          "text": "3. InnoDB: undo + roll pointer",
          "ink": "blue"
        },
        {
          "type": "diagram",
          "kind": "chain",
          "spec": {
            "title": "Rebuilding an old version",
            "steps": [
              {
                "text": "Row in clustered index",
                "note": "newest value, DB_ROLL_PTR"
              },
              {
                "text": "Undo log record",
                "note": "holds prior column values"
              },
              {
                "text": "Older undo record",
                "note": "walk back until visible"
              }
            ]
          }
        },
        {
          "type": "heading",
          "text": "4. Snapshot lifetime per level",
          "ink": "blue"
        },
        {
          "type": "table",
          "headers": [
            "Level",
            "Snapshot taken",
            "Effect"
          ],
          "rows": [
            [
              "READ COMMITTED",
              "per statement",
              "fresh each query"
            ],
            [
              "REPEATABLE READ",
              "once per txn",
              "one frozen view"
            ],
            [
              "Postgres RC",
              "stmt start",
              "re-eval on UPDATE"
            ],
            [
              "InnoDB RR",
              "first read",
              "consistent read view"
            ]
          ],
          "highlightRow": 1,
          "frame": "solid"
        }
      ],
      "hero": "postgresql",
      "subtitle": "Versions, not overwrites"
    },
    {
      "page_title": "Bloat, VACUUM & the Cost of Long Txns",
      "blocks": [
        {
          "type": "heading",
          "text": "5. Example: idle in transaction",
          "ink": "blue"
        },
        {
          "type": "paragraph",
          "text": "Example : a `psql` session runs `BEGIN; SELECT ...` then sits ==idle in transaction== for 6 hours. Its snapshot pins the XID horizon, so **VACUUM** cannot remove any dead tuple newer than it. A hot 2 GB table churned all day grows to **11 GB** — same live rows, 9 GB of dead versions.",
