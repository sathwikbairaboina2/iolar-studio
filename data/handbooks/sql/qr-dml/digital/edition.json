    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "PostgreSQL: `UPDATE orders o SET status = c.tier FROM customers c;` What does it do?",
              "a_bullets": [
                "The join condition is missing, so it is a cross join.",
                "Every order row is rewritten with an arbitrary customer's tier.",
                "Fix: add `WHERE o.customer_id = c.id`, and preview with SELECT first."
              ]
            },
            {
              "type": "qa",
              "q": "In MySQL the last id was 100. What id does the next INSERT get after DELETE FROM t, and after TRUNCATE TABLE t?",
              "a_bullets": [
                "After DELETE: 101, because the counter is kept.",
                "After TRUNCATE: 1, because the counter resets.",
                "MySQL TRUNCATE also cannot be rolled back."
              ]
            },
            {
              "type": "qa",
              "q": "What happens in PostgreSQL? `INSERT INTO t (id,qty) VALUES (1,5),(1,9) ON CONFLICT (id) DO UPDATE SET qty = EXCLUDED.qty;`",
              "a_bullets": [
                "It errors: one statement cannot update the same key twice.",
                "The whole statement is rolled back, so neither row is saved.",
                "Fix: dedupe the source rows first."
              ]
            }
          ]
        }
      ]
    }
