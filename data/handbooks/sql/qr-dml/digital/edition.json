      "pages": [
        {
          "title": "Data Modification Mental Model",
          "blocks": [
            {
              "type": "heading",
              "text": "1. What a write does",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "{green:INSERT}, {blue:UPDATE}, {red:DELETE} are the DML statements that change rows",
                "Each runs as ==one atomic statement==: one bad row rolls back the whole statement",
                "No `WHERE` means ==every row== is picked"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "Target",
                    "sub": "one table",
                    "ink": "green"
                  },
                  {
                    "text": "Pick rows",
                    "sub": "WHERE or SELECT source",
                    "ink": "blue"
                  },
                  {
                    "text": "Set values",
                    "sub": "SET or VALUES",
                    "ink": "purple"
                  }
                ]
              }
            },
            {
              "type": "heading",
              "text": "2. Transactions and constraints",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "Writes stay ==invisible== to others until `COMMIT`",
                "`ROLLBACK` undoes them, so `BEGIN` first when unsure",
                "Constraints are checked ==per row==: PK, UNIQUE, NOT NULL, FK, CHECK",
                "A violation {red:aborts} the statement"
              ],
              "style": "check",
              "ink": "blue"
            },
            {
              "type": "heading",
              "text": "3. Workflow habit",
              "ink": "orange"
            },
            {
              "type": "bullets",
              "items": [
                "Preview with the ==same WHERE==, check the row count, then run the write"
              ],
              "style": "number"
            },
            {
              "type": "code",
              "lang": "sql",
              "lines": [
                "SELECT count(*) FROM orders WHERE status = 'new';",
                "BEGIN;",
                "UPDATE orders SET status = 'old' WHERE status = 'new';",
                "-- affected rows must equal the count",
                "COMMIT;  -- or ROLLBACK;"
              ],
              "note": "count differs from the preview? ROLLBACK"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Mistake",
              "text": "A write with no `WHERE` hits ==every row==. Preview first, `BEGIN` first."
            }
          ]
        }
      ]
    },
    {
      "title": "INSERT with Multiple Rows and SELECT",
      "role": "outline",
      "outlineIndex": 1,
      "pages": [
        {
          "title": "INSERT with Multiple Rows and SELECT",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Multi-row INSERT",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "==One statement==, one round trip: far faster than 3 separate inserts",
                "Always ==list the columns==; table order breaks when a column is added"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "code",
              "lang": "sql",
              "lines": [
                "INSERT INTO t (a, b)",
                "VALUES (1, 'x'),",
                "       (2, 'y'),",
                "       (3, 'z');"
              ]
            },
            {
              "type": "heading",
              "text": "2. INSERT ... SELECT",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "==INSERT ... SELECT== copies rows from a query",
                "SELECT ==column count and types== must match the column list",
                "Omitted columns get their ==DEFAULT== or {orange:NULL}"
              ],
              "style": "dot"
            },
            {
              "type": "code",
              "lang": "sql",
              "lines": [
                "INSERT INTO archive (id, total)",
                "SELECT id, total",
                "FROM orders",
                "WHERE created < '2025-01-01';"
              ]
            },
            {
              "type": "heading",
              "text": "3. Mistakes",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "`INSERT INTO t VALUES (...)` with no column list",
                "Mismatched column count or type between list and SELECT"
              ],
              "style": "cross",
              "ink": "red"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "All or nothing",
              "text": "Multi-row VALUES is ==atomic==: **one bad row** fails the whole statement and no rows are inserted."
            }
          ]
        }
      ]
    },
    {
      "title": "UPDATE with Joins and Safe Updates",
      "role": "outline",
      "outlineIndex": 2,
      "pages": [
        {
          "title": "UPDATE with Joins and Safe Updates",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Join Updates by Dialect",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "Same goal in each: ==set orders.status from customers.tier==",
                "Only the place the join goes changes"
              ],
              "style": "dot"
            },
            {
              "type": "table",
              "headers": [
                "Dialect",
                "Join rule"
              ],
              "rows": [
                [
                  "PostgreSQL",
                  "Join in `WHERE`"
                ],
                [
                  "MySQL",
                  "`JOIN` before `SET`"
                ],
                [
                  "SQL Server",
                  "`FROM` + `JOIN`"
                ]
              ]
            },
            {
              "type": "code",
              "lang": "sql",
              "lines": [
                "-- PostgreSQL",
                "UPDATE orders o SET status = c.tier FROM customers c WHERE o.customer_id = c.id;",
                "-- MySQL",
                "UPDATE orders o JOIN customers c ON o.customer_id = c.id SET o.status = c.tier;",
                "-- SQL Server",
                "UPDATE o SET o.status = c.tier FROM orders o JOIN customers c ON o.customer_id = c.id;"
              ]
            },
            {
              "type": "heading",
              "text": "2. PostgreSQL Cross Join",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "No `o.customer_id = c.id` in `WHERE` → ==cross join==",
                "Every order pairs with every customer",
                "Each row gets an ==arbitrary match==: all rows rewritten"
              ],
              "style": "cross",
              "ink": "red"
            },
            {
              "type": "heading",
              "text": "3. Safe Write Routine",
              "ink": "blue"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "SELECT",
                    "sub": "preview",
                    "ink": "blue"
                  },
                  {
                    "text": "BEGIN",
                    "ink": "purple"
                  },
                  {
                    "text": "Run write",
                    "ink": "orange"
                  },
                  {
                    "text": "Check count",
                    "sub": "affected rows",
                    "ink": "green"
                  },
                  {
                    "text": "COMMIT",
                    "sub": "or ROLLBACK",
                    "ink": "green"
                  }
                ]
              }
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "No WHERE = every row",
              "text": "`UPDATE` and `DELETE` without `WHERE` hit ==every row==. MySQL: `SET sql_safe_updates=1` blocks them."
            }
          ]
        }
      ]
