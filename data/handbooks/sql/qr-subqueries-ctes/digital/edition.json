    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "`orders.cust_id` contains one NULL. What does `SELECT name FROM customers WHERE id NOT IN (SELECT cust_id FROM orders)` return?",
              "a_bullets": [
                "Zero rows.",
                "`id <> NULL` is unknown, so no row passes.",
                "Fix: use `NOT EXISTS`."
              ]
            },
            {
              "type": "qa",
              "q": "A recursive CTE uses `UNION ALL` and `lvl+1` on data with a cycle. What happens?",
              "a_bullets": [
                "It loops forever.",
                "Fix: add `WHERE t.lvl < 10`.",
                "`UNION` would not help, because `lvl` makes every row distinct."
              ]
            },
            {
              "type": "qa",
              "q": "Table a holds 1, 1 and table b holds 1. How many rows do `UNION` and `UNION ALL` return?",
              "a_bullets": [
                "`UNION`: 1 row, duplicates removed.",
                "`UNION ALL`: 3 rows, everything kept."
              ]
            }
          ]
        }
      ]
