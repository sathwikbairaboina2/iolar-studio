                ],
                [
                  "`EXISTS (SELECT 1 ... WHERE i.k = o.k)`",
                  "true/false per outer row"
                ],
                [
                  "`FROM (SELECT ...) d`",
                  "table; alias in most engines"
                ],
                [
                  "`WITH n AS (...) SELECT ... FROM n`",
                  "named, reusable table"
                ]
              ]
            },
            {
