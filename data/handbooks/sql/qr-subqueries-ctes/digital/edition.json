                "  UNION ALL",
                "  SELECT e.id, lvl+1 FROM emp e JOIN r ON e.boss_id=r.id WHERE lvl<10",
                ") SELECT * FROM r;"
              ]
            },
            {
              "type": "heading",
              "text": "3. Set operators",
              "ink": "purple"
            },
            {
              "type": "table",
              "headers": [
                "",
                "UNION",
                "UNION ALL"
              ],
              "rows": [
                [
                  "Duplicates",
