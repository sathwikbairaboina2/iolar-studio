    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "An index on `(country, city, age)` and the query `WHERE country = 'IN' AND age = 30`. How much of the index narrows the seek?",
              "a_bullets": [
                "Only ==country==, the leftmost prefix.",
                "`city` is skipped, so `age` is only checked on the entries read."
              ]
            },
            {
              "type": "qa",
              "q": "`phone` is an indexed VARCHAR. Spot the bug: `WHERE phone = 5551234`.",
              "a_bullets": [
                "MySQL, SQL Server: the column is cast on every row, so the index is skipped.",
                "PostgreSQL: it fails with `operator does not exist: character varying = integer`.",
                "Fix: compare with a string, `'5551234'`."
              ]
            },
            {
              "type": "qa",
              "q": "In Postgres, `orders.customer_id` is a foreign key to `customers`. Deleting a customer is slow. Why?",
              "a_bullets": [
                "Postgres does not auto-index the child FK column, so each delete scans `orders`.",
                "Fix: `CREATE INDEX` on `orders(customer_id)`."
              ]
            }
          ]
        }
      ]
