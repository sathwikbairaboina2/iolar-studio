          "title": "EXPLAIN and Sargable Queries",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Reading a Plan",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "`EXPLAIN`: plan only, query ==not run==",
                "`EXPLAIN ANALYZE` (Postgres, MySQL 8): **runs it**, adds actual time and rows"
              ],
              "style": "dot"
            },
            {
              "type": "table",
              "headers": [
                "Check",
                "Reads as"
              ],
              "rows": [
                [
                  "Access type",
                  "Seq Scan / `type=ALL` = full scan; Index Scan / Seek / `ref` / `range` = index"
                ],
                [
                  "Chosen key",
                  "index picked"
                ],
                [
                  "Estimated rows",
                  "compare with actual"
                ],
                [
                  "Join order",
                  "which table drives"
                ]
              ]
            },
            {
              "type": "heading",
              "text": "2. Red Flags",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "{red:Seq Scan} on a large table",
                "Estimated rows far from actual: ==stale stats==",
                "`Sort` / `Using filesort` a better index could remove"
              ],
              "style": "cross",
              "ink": "red"
            },
            {
              "type": "heading",
              "text": "3. Sargable Predicates",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "==Sargable== = can seek an index: keep the **bare column** on one side"
              ],
              "style": "dot"
            },
            {
              "type": "code",
              "lang": "sql",
              "lines": [
                "-- slow: function on column",
                "WHERE YEAR(created_at) = 2025",
                "-- seeks the index",
                "WHERE created_at >= '2025-01-01'",
                "  AND created_at < '2026-01-01'"
              ]
            },
            {
              "type": "table",
              "headers": [
                "Slow",
                "Sargable"
              ],
              "rows": [
                [
                  "`amount + 10 > 100`",
                  "`amount > 90`"
                ],
                [
                  "`LIKE '%x'`",
                  "prefix `LIKE 'x%'` or full-text index"
                ],
                [
                  "`varchar_col = 5`",
                  "`varchar_col = '5'`"
                ]
              ]
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Covering",
              "text": "`SELECT *` blocks a ==covering index==; name only the columns you need."
            }
          ]
        }
      ]
