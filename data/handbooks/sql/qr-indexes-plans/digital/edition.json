                  "clustered or unique index"
                ],
                [
                  "UNIQUE",
                  "NULLs allowed (count varies)",
                  "creates an index"
                ],
                [
                  "FOREIGN KEY",
                  "ON DELETE CASCADE / SET NULL / RESTRICT",
                  "not auto in Postgres, SQL Server"
                ],
                [
