    {
      "page_title": "Choosing & Converting Records",
      "blocks": [
        {
          "type": "heading",
          "text": "1. Which one to choose",
          "ink": "green"
        },
        {
          "type": "bullets",
          "items": [
            "==NamedTuple==: small immutable record, returned from functions, needs unpacking",
            "==dataclass==: mutable state, validation hooks, richer behaviour",
            "`__slots__` class: custom `__init__` logic and full control",
            "`TypedDict`: typed JSON-like dicts, no methods"
          ],
          "style": "check",
          "frame": "dashed",
          "ink": "green"
        },
        {
          "type": "heading",
          "text": "2. Converting between them",
          "ink": "purple"
        },
        {
          "type": "code",
          "lang": "python",
          "lines": [
            "p = P(1, 2)",
            "d = D(*p)        # tuple -> dataclass",
            "astuple(d)       # (1, 2)",
            "p._asdict()      # {'x': 1, 'y': 2}",
            "p._replace(x=9)  # new P(9, 2)"
          ],
          "note": "star-unpack to convert"
        },
        {
          "type": "bullets",
          "items": [
            "`P._make([1, 2])` builds from any iterable",
            "`P._fields` lists the field names",
            "`P._replace(x=9)` is NamedTuple's `replace`"
          ],
          "style": "dot",
          "frame": "dashed",
          "ink": "purple"
        },
        {
          "type": "heading",
          "text": "3. Same job, two APIs",
          "ink": "blue"
        },
        {
          "type": "table",
          "headers": [
            "Task",
            "NamedTuple",
            "dataclass"
          ],
          "rows": [
            [
              "Update copy",
              "_replace",
              "replace()"
            ],
            [
              "To dict",
              "_asdict",
              "asdict()"
            ],
            [
              "Field names",
              "_fields",
              "fields()"
            ],
            [
              "From iterable",
              "_make",
              "cls(*it)"
            ]
          ],
          "frame": "dashed"
        },
        {
          "type": "callout",
          "style": "tip",
          "title": "Migrating?",
          "text": "Add `__iter__` to a dataclass if callers still unpack it like a tuple."
        },
        {
          "type": "heading",
          "text": "4. Conversion gotchas",
          "ink": "red"
        },
        {
          "type": "bullets",
          "items": [
