          "type": "table",
          "headers": [
            "Fix",
            "How",
            "Effect"
          ],
          "rows": [
            [
              "1. Default",
              "`z: int = 0`",
              "Keeps declared order"
            ],
            [
              "2. kw_only",
              "`@dataclass(kw_only=True)`",
              "Moved to end of init"
            ],
            [
              "3. Sentinel",
              "`_: KW_ONLY`",
              "All later fields kw-only"
            ]
          ],
          "frame": "dashed"
        },
        {
          "type": "code",
          "lang": "python",
          "lines": [
            "from dataclasses import KW_ONLY",
            "@dataclass",
            "class Config:",
            "    name: str",
            "    _: KW_ONLY  # 3.10+",
            "    debug: bool = False",
            "    retries: int = 3"
          ],
          "note": "Config('app', debug=True) only"
        },
