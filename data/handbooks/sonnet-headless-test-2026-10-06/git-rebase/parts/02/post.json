        {
          "type": "heading",
          "text": "1. ☆ Sensible Defaults",
          "ink": "green"
        },
        {
          "type": "code",
          "lang": "bash",
          "lines": [
            "git config pull.rebase true",
            "git config rebase.autoSquash true",
