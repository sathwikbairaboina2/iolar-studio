    {
      "page_title": "Git Rebase Cheatsheet: Commands & Undo",
      "blocks": [
        {
          "type": "heading",
          "text": "1. ☆ Core Commands",
          "ink": "green"
        },
        {
          "type": "table",
          "headers": [
            "Command",
            "Does"
          ],
          "rows": [
            [
              "`git rebase main`",
              "replay branch onto ==main=="
            ],
            [
              "`git rebase -i HEAD~N`",
              "edit last **N** commits"
            ],
            [
              "`git rebase -i --autosquash <base>`",
              "fold fixup!/squash!"
            ],
            [
              "`git rebase --onto <new> <old> <br>`",
              "transplant a range"
            ]
          ],
          "frame": "dashed"
        },
        {
          "type": "heading",
          "text": "2. ☆ Paused Rebase",
          "ink": "blue"
        },
        {
          "type": "bullets",
          "items": [
            "`--continue` resumes after `git add`",
            "`--abort` restores the pre-rebase state",
            "`--skip` drops current commit (upstream has it)",
            "Never `git commit` mid-conflict"
          ],
          "style": "check",
          "frame": "dashed",
          "ink": "blue"
        },
        {
          "type": "heading",
          "text": "3. ☆ Todo Actions",
          "ink": "purple"
        },
        {
          "type": "table",
          "headers": [
            "Action",
            "Effect"
          ],
          "rows": [
            [
              "pick",
              "keep as is"
            ],
            [
              "reword / edit",
              "change message / stop to amend"
            ],
            [
              "squash / fixup",
              "meld (msg kept / dropped)"
            ],
            [
              "drop / exec",
              "delete commit / run command"
            ]
          ],
          "frame": "dashed"
        },
        {
          "type": "heading",
          "text": "4. ☆ Autosquash Flow",
          "ink": "purple"
        },
        {
          "type": "code",
          "lang": "bash",
          "lines": [
            "git commit --fixup=<sha>",
            "git rebase -i --autosquash \\",
            "  origin/main",
            "git push --force-with-lease"
          ],
          "note": "fixup! commit needs its target SHA"
        },
        {
          "type": "callout",
          "style": "sticky",
          "title": "Safe push",
          "text": "==--force-with-lease== fails if a teammate pushed meanwhile. Never plain --force."
        },
        {
          "type": "heading",
          "text": "5. ☆ Undo a Rebase",
          "ink": "red"
        },
        {
          "type": "code",
          "lang": "bash",
          "lines": [
            "git reflog                # find state",
            "git reset --hard ORIG_HEAD",
            "git reset --hard HEAD@{5}"
          ],
          "note": "old commits live until gc"
        },
        {
          "type": "heading",
          "text": "6. ☆ Rescue Lost Commits",
