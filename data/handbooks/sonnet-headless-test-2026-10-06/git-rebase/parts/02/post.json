          ],
          "note": "rerere replays saved resolutions"
        },
        {
          "type": "heading",
          "text": "2. ☆ Rebase vs Merge",
          "ink": "orange"
        },
        {
          "type": "table",
          "headers": [
            "Trait",
            "Rebase",
            "Merge"
          ],
          "rows": [
            [
              "History",
              "linear",
              "true DAG"
            ],
            [
              "Commits",
              "new SHAs",
              "preserved"
            ],
            [
              "Context",
              "lost",
              "kept"
            ],
