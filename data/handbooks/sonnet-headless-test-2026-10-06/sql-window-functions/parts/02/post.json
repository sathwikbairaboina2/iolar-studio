  "slides": [
    {
      "page_title": "Running Totals and Moving Averages",
      "blocks": [
        {
          "type": "heading",
          "text": "1. Running vs Moving",
          "ink": "green"
        },
        {
          "type": "bullets",
          "items": [
            "==Running== aggregate: the frame starts at row 1 and grows",
            "==Moving== aggregate: a fixed-width frame slides along",
            "Write the frame as **ROWS** so the intent is explicit",
            "`PARTITION BY` restarts the total in each group"
          ],
          "style": "star",
          "frame": "dashed",
          "ink": "green"
        },
        {
          "type": "heading",
          "text": "2. Templates",
          "ink": "purple"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "SUM(amount) OVER (",
            "  ORDER BY day",
            "  ROWS UNBOUNDED PRECEDING)",
            "-- per group: add above ORDER BY",
            "--   PARTITION BY account"
          ],
          "note": "running total, restarts per account"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "AVG(v) OVER (ORDER BY day",
            "  ROWS BETWEEN 2 PRECEDING",
            "  AND CURRENT ROW) -- trailing 3",
            "-- centered: BETWEEN 1 PRECEDING",
            "--   AND 1 FOLLOWING"
          ],
          "note": "3 rows, always"
        },
        {
          "type": "table",
          "headers": [
            "Frame",
            "Rows seen",
            "Use"
          ],
          "rows": [
            [
              "UNBOUNDED PRECEDING..CURRENT",
              "all so far",
              "running total"
            ],
            [
              "2 PRECEDING..CURRENT",
              "3",
              "trailing avg"
            ],
            [
              "1 PRECEDING..1 FOLLOWING",
              "3",
              "centered avg"
            ],
            [
              "RANGE '6 days' PRECEDING",
              "by date",
              "7-day avg"
            ]
          ]
        },
        {
          "type": "paragraph",
          "text": "Example : account balance after each transaction.",
          "frame": "dashed",
          "ink": "pink"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "SELECT ts, amt,",
            "  SUM(amt) OVER (",
            "    PARTITION BY acct",
            "    ORDER BY ts, id",
            "    ROWS UNBOUNDED PRECEDING)",
            "    AS balance",
            "FROM txns;"
          ],
          "note": "id breaks timestamp ties"
        },
        {
          "type": "bullets",
          "items": [
            "Deposits are positive, withdrawals negative",
            "Last row of each account = its **current** balance",
            "Tiebreaker `id` keeps the steps stable"
          ],
          "style": "check",
          "frame": "dashed",
          "ink": "green"
        },
        {
          "type": "heading",
          "text": "3. Common mistakes",
          "ink": "red"
        },
        {
          "type": "bullets",
          "items": [
            "Ties in ORDER BY with default `RANGE` repeat the running total",
            "First rows average fewer than N rows; mask with a row count",
            "ROWS averages over date gaps distort a \"7-day\" window"
          ],
          "style": "cross",
          "frame": "dashed",
          "ink": "red"
        },
        {
          "type": "callout",
          "style": "tip",
          "title": "Window reuse",
          "text": "Name the frame once: WINDOW w AS (ORDER BY day ROWS UNBOUNDED PRECEDING)."
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "SELECT d, x,",
            "  SUM(x) OVER (ORDER BY d",
            "    ROWS UNBOUNDED PRECEDING)",
            "  / SUM(x) OVER () AS share",
            "FROM t;"
          ],
          "note": "cumulative share of the total"
        },
        {
          "type": "bullets",
          "items": [
            "Sliding frames use ==inverse transition== functions where available",
            "`SUM` and `COUNT` slide in **O(1)** per row",
            "Share ends at 1.0 on the last row of the partition"
          ],
          "style": "check",
          "frame": "dashed",
          "ink": "blue"
        }
      ],
      "hero": "postgresql",
      "subtitle": "Cumulative and sliding"
    },
    {
      "page_title": "Running Extremes and Calendar Averages",
      "blocks": [
        {
          "type": "table",
