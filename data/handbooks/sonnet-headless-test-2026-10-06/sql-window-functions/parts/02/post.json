        {
          "type": "heading",
          "text": "1. Running extremes",
          "ink": "blue"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "SELECT day, price,",
            "  MAX(price) OVER (",
            "    ORDER BY day",
            "    ROWS UNBOUNDED PRECEDING)",
            "    AS all_time_high",
            "FROM prices;"
          ],
          "note": "all-time high so far"
        },
        {
          "type": "heading",
          "text": "2. Running count and share",
          "ink": "purple"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "SELECT ts, COUNT(*) OVER (",
            "  ORDER BY ts",
            "  ROWS UNBOUNDED PRECEDING)",
            "  AS orders_so_far",
            "FROM orders;"
          ],
          "note": "running count, one step per row"
        },
        {
          "type": "callout",
          "style": "sticky",
          "title": "Pair two windows",
          "text": "OVER (ORDER BY d ...) for the running part, OVER () for the grand total."
        },
        {
          "type": "heading",
          "text": "3. Calendar-true average",
          "ink": "green"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "SELECT day, AVG(v) OVER (",
            "  ORDER BY day",
            "  RANGE BETWEEN INTERVAL",
            "  '6 days' PRECEDING",
            "  AND CURRENT ROW) AS avg7",
            "FROM daily;"
          ],
          "note": "RANGE follows real dates"
        },
        {
          "type": "bullets",
          "items": [
            "==RANGE== offsets look at **values**, not row counts",
            "Missing days shrink the frame instead of shifting it",
            "Needs one numeric, date or interval ORDER BY column"
          ],
          "style": "star",
          "frame": "dashed",
          "ink": "green"
        },
        {
          "type": "heading",
          "text": "4. Mask the warm-up rows",
          "ink": "purple"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "SELECT day,",
            "  CASE WHEN rn >= 3",
            "    THEN avg3 END AS avg3",
            "FROM stats;",
            "-- rn = ROW_NUMBER() OVER (...)"
          ],
          "note": "hide averages of fewer than N rows"
        },
        {
          "type": "paragraph",
          "text": "Example : row 1 of a 3-row average is just itself, so show NULL instead.",
          "frame": "dashed",
          "ink": "pink"
        },
        {
          "type": "heading",
          "text": "5. Ties and peers",
          "ink": "red"
        },
        {
          "type": "table",
          "headers": [
            "Frame",
            "Tied rows get",
            "Steps?"
          ],
          "rows": [
            [
              "Default RANGE",
              "same total",
              "no, repeats"
            ],
            [
              "ROWS",
              "own total",
              "yes, per row"
            ],
            [
              "GROUPS 1 PRECEDING",
              "by peer group",
              "per group"
            ]
          ],
          "highlightRow": 1,
          "frame": "dashed"
        },
        {
          "type": "bullets",
          "items": [
            "Default frame includes all ==peers== of the current row",
            "Tied ORDER BY values show the same running total",
            "Add a unique tiebreaker like `id` to the ORDER BY"
          ],
          "style": "cross",
          "frame": "dashed",
          "ink": "red"
        },
        {
          "type": "paragraph",
          "text": "Example : both d = 2 rows are peers, so r jumps to 20 on each, while s steps 15 then 20.",
          "frame": "dashed",
          "ink": "pink"
        }
      ],
      "hero": "postgresql",
      "subtitle": "Cumulative and sliding"
