    {
      "page_title": "Frame Bounds, GROUPS and EXCLUDE",
      "blocks": [
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "SELECT d, x,",
            "  SUM(x) OVER (ORDER BY d) AS r,",
            "  SUM(x) OVER (ORDER BY d",
            "    ROWS UNBOUNDED PRECEDING) s",
            "FROM t;"
          ],
          "note": "r repeats on ties, s steps"
        },
        {
          "type": "callout",
          "style": "tip",
          "title": "Pick the frame",
          "text": "ROWS for steady running totals and speed; RANGE only when real dates or peers matter."
        },
        {
          "type": "heading",
          "text": "1. Tie effect, worked",
          "ink": "orange"
        },
        {
          "type": "table",
          "headers": [
            "d",
            "x",
            "r (RANGE)",
            "s (ROWS)"
          ],
          "rows": [
            [
              "1",
              "10",
              "10",
              "10"
            ],
            [
              "2",
              "5",
              "20",
              "15"
            ],
            [
              "2",
              "5",
              "20",
              "20"
            ],
            [
              "3",
              "20",
              "40",
              "40"
            ]
          ],
          "highlightRow": 1,
          "frame": "dashed"
        },
        {
          "type": "heading",
          "text": "2. Frame bounds",
          "ink": "purple"
        },
        {
          "type": "table",
          "headers": [
            "Bound",
            "Meaning"
          ],
          "rows": [
            [
              "UNBOUNDED PRECEDING",
              "partition start"
            ],
            [
              "N PRECEDING",
              "N before current"
            ],
            [
              "CURRENT ROW",
              "this row (+ peers)"
            ],
            [
              "N FOLLOWING",
              "N after current"
            ],
            [
              "UNBOUNDED FOLLOWING",
              "partition end"
            ]
          ],
          "frame": "dashed"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "-- these two are identical:",
            "ROWS UNBOUNDED PRECEDING",
            "ROWS BETWEEN UNBOUNDED",
            "  PRECEDING AND CURRENT ROW"
          ],
          "note": "short form ends at CURRENT ROW"
        },
        {
          "type": "heading",
          "text": "3. GROUPS frames",
          "ink": "green"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "SELECT d, x, SUM(x) OVER (",
            "  ORDER BY d",
            "  GROUPS BETWEEN 1 PRECEDING",
            "  AND CURRENT ROW) AS two_days",
            "FROM t;"
          ],
          "note": "counts peer groups, PostgreSQL 11+"
        },
        {
          "type": "bullets",
          "items": [
            "==GROUPS== counts peer groups, not rows or values",
            "Rows with equal ORDER BY value form one group",
            "`1 PRECEDING` means the previous distinct value"
          ],
          "style": "check",
          "frame": "dashed",
          "ink": "green"
        },
        {
          "type": "paragraph",
          "text": "Example : d = 3 sees groups 2 and 3, so 5 + 5 + 20 = 30.",
          "frame": "dashed",
          "ink": "pink"
        },
        {
          "type": "heading",
          "text": "4. Trim the frame",
          "ink": "blue"
        },
        {
          "type": "table",
          "headers": [
            "Option",
            "Removes"
          ],
          "rows": [
            [
              "EXCLUDE CURRENT ROW",
              "the row itself"
            ],
            [
              "EXCLUDE GROUP",
              "row and its peers"
            ],
            [
              "EXCLUDE TIES",
              "peers, keeps row"
            ],
            [
              "EXCLUDE NO OTHERS",
              "nothing (default)"
            ]
          ],
          "frame": "dashed"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "AVG(x) OVER (ORDER BY d",
            "  ROWS BETWEEN 1 PRECEDING",
            "  AND 1 FOLLOWING",
            "  EXCLUDE CURRENT ROW)"
          ],
          "note": "neighbours only, self skipped"
        },
        {
          "type": "callout",
          "style": "sticky",
          "title": "Why ROWS is faster",
          "text": "RANGE and GROUPS must track peers on every row; ROWS just counts."
        },
        {
          "type": "bullets",
          "items": [
            "RANGE offsets on a text column raise an error",
            "RANGE offsets on two ORDER BY columns also fail",
            "Keep GROUPS and EXCLUDE for peer-aware logic"
          ],
          "style": "cross",
          "frame": "dashed",
          "ink": "red"
        }
      ],
      "hero": "postgresql",
