          "ink": "green"
        },
        {
          "type": "bullets",
          "items": [
            "EXPLAIN shows a ==WindowAgg== node fed by a Sort",
            "Sort key is (PARTITION BY cols, ORDER BY cols)",
            "A btree on (partition_col, order_col) skips the sort",
            "Planner uses an Incremental Sort or index scan",
            "Match index column order and **direction** to the window"
          ],
          "style": "star",
          "frame": "dashed",
          "ink": "green"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "CREATE INDEX ON emp",
            "  (dept, salary DESC);",
            "EXPLAIN SELECT RANK() OVER (",
            "  PARTITION BY dept",
            "  ORDER BY salary DESC) FROM emp;",
            "-- WindowAgg <- Index Scan"
          ],
          "note": "column order and direction must match"
        },
