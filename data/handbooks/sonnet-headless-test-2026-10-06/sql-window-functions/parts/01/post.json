                "caption": "3 rows in, 3 rows out"
              }
            ],
            "arrow": true
          }
        },
        {
          "type": "heading",
          "text": "4. Worked examples",
          "ink": "pink"
        },
        {
          "type": "paragraph",
          "text": "Example : each row beside the global average.",
          "frame": "dashed",
          "ink": "pink"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "SELECT name, salary,",
            "  AVG(salary) OVER ()",
            "    AS company_avg",
            "FROM emp;"
          ]
        },
        {
          "type": "paragraph",
          "text": "Example : gap versus own department.",
          "frame": "dashed",
          "ink": "pink"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "SELECT name,",
            "  salary - AVG(salary)",
            "    OVER (PARTITION BY dept)",
            "    AS gap",
            "FROM emp;"
          ],
          "note": "Positive gap = above dept average"
        },
        {
          "type": "heading",
          "text": "5. Where windows may appear",
          "ink": "red"
        },
        {
          "type": "bullets",
          "items": [
            "**Not** allowed in WHERE, GROUP BY, HAVING or FROM",
            "Allowed only in the SELECT list and ORDER BY",
            "Filtered-out rows never enter a window: it sees rows after WHERE and HAVING"
          ],
          "style": "cross",
          "frame": "dashed",
          "ink": "red"
        },
        {
          "type": "diagram",
          "kind": "flow",
          "spec": {
            "nodes": [
              "FROM",
              "WHERE",
              "GROUP BY",
              "HAVING",
              {
                "text": "WINDOW",
                "ink": "red"
              },
              "SELECT",
              "DISTINCT",
              "ORDER BY",
              "LIMIT"
            ]
          }
        }
      ],
      "hero": "postgresql",
      "subtitle": "Rows stay, columns grow"
    },
    {
      "page_title": "Use Cases, Filtering and Pitfalls",
      "blocks": [
        {
          "type": "heading",
          "text": "1. Summary: use cases",
          "ink": "blue"
        },
        {
          "type": "bullets",
          "items": [
            "Ranking and top-N per group",
            "Running totals",
            "Period-over-period change",
            "Percent of total, gaps and islands"
          ],
          "style": "star",
          "frame": "dashed",
          "ink": "blue"
        },
        {
          "type": "callout",
          "style": "cloud",
          "title": "Key rule",
          "text": "GROUP BY **collapses** rows; OVER **keeps** them and adds a column."
        },
        {
          "type": "paragraph",
          "text": "Example : rank staff inside each department.",
          "frame": "dashed",
          "ink": "pink"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "SELECT name, dept, salary,",
            "  RANK() OVER (",
            "    PARTITION BY dept",
            "    ORDER BY salary DESC) AS rk",
            "FROM emp;"
          ],
          "note": "rank restarts in each dept"
        },
        {
          "type": "heading",
          "text": "2. Windows see filtered rows",
          "ink": "purple"
        },
        {
          "type": "bullets",
          "items": [
            "WHERE and HAVING run **before** windows",
            "Removed rows never count in a window",
            "A filter after the window needs a subquery",
            "Windows run after GROUP BY: they can wrap aggregates"
          ],
          "style": "dot",
          "frame": "dashed",
          "ink": "purple"
        },
        {
          "type": "table",
          "headers": [
            "Clause",
            "Before window?"
          ],
          "rows": [
            [
              "WHERE",
              "yes"
            ],
            [
              "GROUP BY",
              "yes"
            ],
            [
              "HAVING",
              "yes"
            ],
            [
              "DISTINCT",
              "no, after"
            ],
            [
              "ORDER BY / LIMIT",
              "no, after"
            ]
          ],
          "highlightRow": 0,
          "frame": "dashed"
        },
        {
          "type": "bullets",
          "items": [
            "Rank over aggregates: `RANK() OVER (ORDER BY SUM(x) DESC)`",
            "PostgreSQL has no `QUALIFY`; use a subquery or CTE"
          ],
          "style": "check",
          "frame": "dashed",
          "ink": "purple"
        },
        {
          "type": "heading",
          "text": "3. Mistakes",
          "ink": "red"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "SELECT * FROM emp",
            "WHERE ROW_NUMBER() OVER () = 1;",
            "-- ERROR: not allowed in WHERE"
          ],
          "note": "windows are illegal in WHERE"
        },
        {
          "type": "bullets",
          "items": [
            "Using GROUP BY when you still need detail columns",
            "Filtering on a window result in WHERE directly",
            "Forgetting empty `OVER ()` means one big window"
          ],
          "style": "cross",
          "frame": "dashed",
          "ink": "red"
        },
        {
          "type": "sidebox",
          "title": "Function families",
          "items": [
            "Ranking: ROW_NUMBER, RANK",
            "Offset: LAG, LEAD",
            "Value: FIRST_VALUE, NTH_VALUE",
            "Aggregates: SUM, AVG with OVER"
          ],
          "ink": "blue"
        },
        {
          "type": "callout",
          "style": "tip",
          "title": "Filter a window",
          "text": "Compute it in a subquery or CTE, then WHERE on the outside."
        },
        {
          "type": "callout",
          "style": "sticky",
          "title": "Filter order",
          "text": "Filter inside the subquery changes the window; outside does not."
        }
      ],
      "hero": "postgresql",
      "subtitle": "Rows stay, columns grow"
    },
    {
      "page_title": "OVER, PARTITION BY, ORDER BY",
      "blocks": [
        {
          "type": "heading",
          "text": "1. What each part does",
          "ink": "green"
        },
        {
          "type": "bullets",
          "items": [
            "==PARTITION BY== splits rows into independent groups",
            "The function **restarts** in each partition",
            "No PARTITION BY: the whole result is one partition",
            "==ORDER BY== inside OVER sorts rows per partition",
            "It defines what 'previous' and 'current' mean"
          ],
          "style": "star",
          "frame": "dashed",
          "ink": "green"
        },
        {
          "type": "heading",
          "text": "2. How the window is built",
          "ink": "purple"
        },
        {
          "type": "diagram",
          "kind": "flow",
          "spec": {
            "nodes": [
              {
                "text": "All rows",
                "sub": "after WHERE"
              },
              {
                "text": "PARTITION BY",
                "sub": "split groups"
              },
              {
                "text": "ORDER BY",
                "sub": "sort inside"
              },
              {
                "text": "Function",
                "sub": "per row"
              }
            ]
          }
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "SELECT region, product, amt,",
            "SUM(amt) OVER (",
            "  PARTITION BY region, product",
            "  ORDER BY sold_on",
            ") AS run",
            "FROM sales;"
          ],
          "note": "one window per region+product"
        },
        {
          "type": "bullets",
          "items": [
            "Several columns: one window per **combination**",
            "Expressions work: `PARTITION BY date_trunc('month', created_at)`",
            "Window ORDER BY is not the query's ORDER BY"
          ],
          "style": "dot",
          "frame": "dashed",
          "ink": "purple"
        },
        {
          "type": "heading",
          "text": "3. Example: group total vs running",
          "ink": "blue"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "SUM(x) OVER (PARTITION BY g)",
            "-- group total on every row",
            "SUM(x) OVER (PARTITION BY g",
            "            ORDER BY d)",
            "-- running total in each group"
          ],
          "note": "ORDER BY flips total to running"
        },
        {
          "type": "diagram",
          "kind": "tables",
          "spec": {
            "tables": [
              {
                "title": "PARTITION BY g",
                "headers": [
                  "g",
                  "d",
                  "x",
                  "sum"
                ],
                "rows": [
                  [
                    "A",
                    "1",
                    "10",
                    "30"
                  ],
                  [
                    "A",
                    "2",
                    "20",
                    "30"
                  ],
                  [
                    "B",
                    "1",
                    "5",
                    "5"
                  ]
                ]
              },
              {
                "title": "+ ORDER BY d",
                "headers": [
                  "g",
                  "d",
                  "x",
                  "sum"
                ],
                "rows": [
                  [
                    "A",
                    "1",
                    "10",
                    "10"
                  ],
                  [
                    "A",
                    "2",
                    "20",
                    "30"
                  ],
                  [
                    "B",
                    "1",
                    "5",
                    "5"
                  ]
                ]
              }
            ],
            "arrow": false
          }
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "SELECT id, amount,",
            "amount / SUM(amount) OVER ()",
            "  * 100 AS pct",
            "FROM orders;"
          ],
          "note": "percent of total: empty OVER ()"
        },
        {
          "type": "heading",
          "text": "4. ORDER BY options",
          "ink": "blue"
        },
        {
          "type": "table",
          "headers": [
            "Option",
            "Effect"
          ],
          "rows": [
            [
              "ASC / DESC",
              "low→high / high→low"
            ],
            [
              "NULLS FIRST",
              "NULLs before values"
            ],
            [
              "NULLS LAST",
              "NULLs after values"
            ],
            [
              "Default ASC",
              "NULLs sort **last**"
            ]
          ],
          "highlightRow": 3,
          "frame": "dashed"
        },
        {
          "type": "table",
          "headers": [
            "Window has",
            "Aggregate gives"
          ],
          "rows": [
            [
              "no ORDER BY",
              "whole-partition value"
            ],
            [
              "ORDER BY",
              "**running** value (default frame)"
            ],
            [
              "Ranking, no ORDER BY",
              "arbitrary numbers"
            ]
          ],
          "highlightRow": 1,
          "frame": "dashed"
        },
        {
          "type": "callout",
          "style": "sticky",
          "title": "Remember",
          "text": "OVER sorts for the calculation only. Sort the output yourself."
        }
      ],
      "hero": "postgresql",
      "subtitle": "Windows in detail"
    },
    {
      "page_title": "ORDER BY Mistakes and Fixes",
      "blocks": [
        {
          "type": "heading",
          "text": "1. Common mistakes",
          "ink": "red"
        },
        {
          "type": "bullets",
          "items": [
            "Assuming rows return in window order: add an **outer ORDER BY**",
            "Inner OVER ORDER BY does not guarantee output order",
            "Adding ORDER BY and not noticing the total became **running**",
            "ROW_NUMBER() OVER () numbers rows arbitrarily"
          ],
          "style": "cross",
          "frame": "dashed",
          "ink": "red"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "SELECT id, SUM(x) OVER (",
            "  ORDER BY d) AS run",
            "FROM t",
            "ORDER BY d;  -- outer sort"
          ],
          "note": "always add the outer ORDER BY"
        },
        {
          "type": "heading",
          "text": "2. Fixes",
          "ink": "green"
        },
        {
          "type": "bullets",
          "items": [
            "Sort the final output with a query-level ORDER BY",
            "Want a group total? Drop the ORDER BY inside OVER",
            "Want a running total? Keep it, and say ROWS",
            "Number rows with a real ORDER BY, never empty OVER"
          ],
          "style": "check",
          "frame": "dashed",
          "ink": "green"
        },
        {
          "type": "table",
          "headers": [
            "Mistake",
            "Symptom",
            "Fix"
          ],
          "rows": [
            [
              "No outer ORDER BY",
              "random output",
              "add it"
            ],
            [
              "ORDER BY in OVER",
              "total turns running",
              "remove it"
            ],
            [
              "Empty OVER ranking",
              "arbitrary numbers",
              "order it"
            ],
            [
              "No tiebreaker",
              "unstable ranks",
              "add id"
            ]
          ],
          "highlightRow": 1,
          "frame": "dashed"
        },
        {
          "type": "paragraph",
          "text": "Example : numbering orders per customer, newest first.",
          "frame": "dashed",
          "ink": "pink"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "ROW_NUMBER() OVER (",
            "  PARTITION BY cust_id",
            "  ORDER BY ts DESC, id",
            ") AS nth_order"
          ],
          "note": "id makes ties repeatable"
        },
        {
          "type": "heading",
          "text": "3. NULLs in the sort",
          "ink": "blue"
        },
        {
          "type": "bullets",
          "items": [
            "ASC puts NULLs **last** in PostgreSQL by default",
            "DESC puts NULLs **first** by default",
            "Override with `NULLS FIRST` or `NULLS LAST`",
            "NULLs count as peers of each other"
          ],
          "style": "dot",
          "frame": "dashed",
          "ink": "blue"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "SELECT id, score,",
            "  RANK() OVER (",
            "    ORDER BY score DESC",
            "    NULLS LAST) AS rk",
            "FROM results;"
          ],
          "note": "unscored rows rank at the end"
        },
        {
          "type": "table",
          "headers": [
            "ORDER BY",
            "NULLs land"
          ],
          "rows": [
            [
              "score ASC",
              "last"
            ],
            [
              "score DESC",
              "first"
            ],
            [
              "DESC NULLS LAST",
              "last"
            ],
            [
              "ASC NULLS FIRST",
              "first"
            ]
          ],
          "highlightRow": 1,
          "frame": "dashed"
        },
        {
          "type": "callout",
          "style": "tip",
          "title": "Rank without NULLs",
          "text": "Add NULLS LAST to DESC rankings so missing scores never rank first."
        },
        {
          "type": "callout",
          "style": "sticky-pink",
          "title": "Check",
          "text": "Does my OVER have ORDER BY on purpose? Is the output sorted?"
        }
      ],
      "hero": "postgresql",
      "subtitle": "Windows in detail"
    },
    {
      "page_title": "Ranking Functions",
      "blocks": [
        {
          "type": "heading",
          "text": "1. What They Do",
          "ink": "green"
        },
        {
          "type": "bullets",
          "items": [
            "`ROW_NUMBER()` gives ==unique== integers 1,2,3... even for ties",
            "`RANK()` ties share a rank, then **skip**: 1,2,2,4",
            "`DENSE_RANK()` ties share a rank, **no gaps**: 1,2,2,3",
            "`ROW_NUMBER` takes no arguments"
          ],
          "style": "star",
          "frame": "dashed",
          "ink": "green"
        },
        {
          "type": "heading",
          "text": "2. Side by Side",
          "ink": "blue"
        },
        {
          "type": "table",
          "headers": [
            "score",
            "ROW_NUMBER",
            "RANK",
            "DENSE_RANK"
          ],
          "rows": [
            [
              "90",
              "1",
              "1",
              "1"
            ],
            [
              "85",
              "2",
              "2",
              "2"
            ],
            [
              "85",
              "3",
              "2",
              "2"
            ],
            [
              "70",
              "4",
              "4",
              "3"
            ]
          ],
          "highlightRow": 2,
          "frame": "dashed"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "SELECT score,",
            "ROW_NUMBER() OVER w rn,",
            "RANK() OVER w rk,",
            "DENSE_RANK() OVER w dr",
            "FROM t WINDOW w AS (ORDER BY score DESC);"
          ],
          "note": "ties show up on row 3"
        },
        {
          "type": "heading",
          "text": "3. Deterministic Order",
          "ink": "purple"
        },
        {
          "type": "bullets",
          "items": [
            "Ties get numbered ==arbitrarily== without a tiebreaker",
            "Make it repeatable with a unique column last",
            "`ORDER BY score DESC, id`",
            "Ranking ignores the frame clause; only partition and `ORDER BY` count"
          ],
          "style": "number",
          "frame": "dashed",
          "ink": "purple"
        },
        {
          "type": "heading",
          "text": "4. Top-N per Group",
          "ink": "purple"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "SELECT * FROM (",
            "SELECT *, ROW_NUMBER() OVER (",
            "PARTITION BY dept",
            "ORDER BY salary DESC) rn",
            "FROM emp) s WHERE rn <= 3;"
          ],
          "note": "filter needs a subquery"
        },
        {
          "type": "table",
          "headers": [
            "Need",
            "Use"
          ],
          "rows": [
            [
              "Exactly N rows",
              "ROW_NUMBER"
            ],
            [
              "Ties all qualify",
              "RANK"
            ],
            [
              "Top N distinct values",
              "DENSE_RANK"
            ]
          ],
          "frame": "dashed"
        },
        {
          "type": "heading",
          "text": "5. Dedup and Percentiles",
          "ink": "blue"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "ROW_NUMBER() OVER (",
            "PARTITION BY key",
            "ORDER BY updated_at DESC",
            ") AS rn  -- keep rn = 1"
          ],
          "note": "latest row per key"
        },
        {
          "type": "bullets",
          "items": [
            "`PERCENT_RANK()` = (rank - 1) / (rows - 1)",
            "`CUME_DIST()` = rows at or before / total rows",
            "Scores 90,85,85,70: PERCENT_RANK 0, .33, .33, 1"
          ],
          "style": "dot",
          "frame": "dashed",
          "ink": "blue"
        },
        {
          "type": "heading",
          "text": "6. Mistakes",
          "ink": "red"
        },
        {
          "type": "bullets",
          "items": [
            "**ROW_NUMBER** for 'top 3 salaries' silently drops tied people",
            "No tiebreaker, so results change between runs",
            "Expecting a frame to change a rank"
          ],
          "style": "cross",
          "frame": "dashed",
          "ink": "red"
        },
        {
          "type": "callout",
          "style": "cloud",
          "title": "Pick by tie behaviour",
          "text": "ROW_NUMBER = exactly N rows. RANK/DENSE_RANK = ties all qualify."
        },
        {
          "type": "bullets",
          "items": [
            "PERCENT_RANK starts at **0** and ends at 1",
            "CUME_DIST never reaches 0; ties share the top share",
            "Both are ordered by the window `ORDER BY`"
          ],
          "style": "check",
          "frame": "dashed",
          "ink": "purple"
        }
      ],
      "hero": "postgresql",
      "subtitle": "ROW_NUMBER, RANK, DENSE"
    },
    {
      "page_title": "PERCENT_RANK vs CUME_DIST",
      "blocks": [
        {
          "type": "heading",
          "text": "1. PERCENT_RANK vs CUME_DIST",
          "ink": "purple"
        },
        {
          "type": "table",
          "headers": [
            "score",
            "PERCENT_RANK",
            "CUME_DIST"
          ],
          "rows": [
            [
              "90",
              "0",
              "0.25"
            ],
            [
              "85",
              "0.33",
              "0.75"
            ],
            [
              "85",
              "0.33",
              "0.75"
            ],
            [
              "70",
              "1",
              "1"
            ]
          ],
          "highlightRow": 1,
          "frame": "dashed"
        },
        {
          "type": "bullets",
          "items": [
            "`PERCENT_RANK` = (rank - 1) / (rows - 1)",
            "`CUME_DIST` = rows at or before / total rows",
            "Both return a fraction between 0 and 1",
            "Both need an `ORDER BY` inside OVER"
          ],
          "style": "dot",
          "frame": "dashed",
          "ink": "purple"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "SELECT score,",
            "  PERCENT_RANK() OVER w AS pr,",
            "  CUME_DIST() OVER w AS cd",
            "FROM t",
            "WINDOW w AS (ORDER BY score DESC);"
          ],
          "note": "same window, two measures"
        },
        {
          "type": "paragraph",
          "text": "Example : 0.75 in CUME_DIST means 75% of rows score at or above this one.",
          "frame": "dashed",
          "ink": "pink"
        },
        {
          "type": "bullets",
          "items": [
            "PERCENT_RANK: first row is always **0**, last is 1",
            "CUME_DIST: first row is above 0, last is always 1",
            "Tied rows share one value in both functions",
            "Single-row partition: PERCENT_RANK returns 0"
          ],
          "style": "check",
          "frame": "dashed",
          "ink": "green"
        },
        {
          "type": "heading",
          "text": "2. Pitfalls",
          "ink": "red"
        },
        {
          "type": "bullets",
          "items": [
            "Treating PERCENT_RANK as 'percent of rows below'",
            "Ignoring that ties inflate CUME_DIST past the row's own position",
            "Using either one without `ORDER BY`",
            "Expecting a frame clause to change the result"
          ],
          "style": "cross",
          "frame": "dashed",
          "ink": "red"
        },
        {
          "type": "callout",
          "style": "cloud",
          "title": "Pick one",
          "text": "PERCENT_RANK counts rows strictly before. CUME_DIST counts ties too."
        }
      ],
      "hero": "postgresql",
      "subtitle": "ROW_NUMBER, RANK, DENSE"
    },
    {
      "page_title": "LAG, LEAD and Offset Navigation",
      "blocks": [
        {
          "type": "heading",
          "text": "1. What is it?",
          "ink": "green"
        },
        {
          "type": "bullets",
          "items": [
            "==LAG(expr, offset, default)== reads a value from a **previous** row",
            "==LEAD== reads from a **following** row of the same partition",
            "Defaults: offset `1`, default `NULL` if the row is missing",
            "`LAG(price, 1, 0)` gives `0` on the first row, not NULL"
          ],
          "style": "star",
          "frame": "dashed",
          "ink": "green"
        },
        {
          "type": "heading",
          "text": "2. Template",
          "ink": "purple"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "SELECT day, price,",
            "  price - LAG(price)",
            "  OVER (ORDER BY day) AS chg",
            "FROM prices;"
          ],
          "note": "first row change is NULL"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "SELECT (rev - LAG(rev)",
            "  OVER (ORDER BY m))",
            "  / NULLIF(LAG(rev)",
            "  OVER (ORDER BY m), 0) AS g"
          ],
          "note": "NULLIF avoids divide by zero"
        },
        {
          "type": "table",
          "headers": [
            "Call",
            "Reads",
            "Use"
          ],
          "rows": [
            [
              "LAG(x)",
              "1 row back",
              "day-over-day"
            ],
            [
              "LAG(x, 7)",
              "7 rows back",
              "same weekday"
            ],
            [
              "LEAD(x, 3)",
              "3 rows ahead",
              "peek ahead"
            ],
            [
              "LAG(x, 1, 0)",
              "prev or 0",
              "no NULL start"
            ]
          ],
          "frame": "dashed"
        },
        {
          "type": "heading",
          "text": "3. How it counts",
          "ink": "blue"
        },
        {
          "type": "diagram",
          "kind": "array",
          "spec": {
            "cells": [
              "10",
              "12",
              "15",
              "11",
              "18",
              "20",
              "19"
            ],
            "indices": true,
            "pointers": [
              {
                "index": 2,
                "label": "LAG 1",
                "ink": "red"
              },
              {
                "index": 3,
                "label": "current",
                "ink": "black"
              },
              {
                "index": 5,
                "label": "LEAD 2",
                "ink": "green"
              }
            ],
            "highlight": [
              3
            ],
            "dim": [],
            "caption": "offsets count rows, not values"
          }
        },
        {
          "type": "bullets",
          "items": [
            "LAG and LEAD **ignore the frame**; they count from the current row",
            "Counting stays inside the partition only",
            "Add ==PARTITION BY== when data holds many entities"
          ],
          "style": "dot",
          "frame": "dashed",
          "ink": "blue"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "ts - LAG(ts) OVER (",
            "  PARTITION BY user_id",
            "  ORDER BY ts",
            ") AS gap -- time between events"
          ],
          "note": "restarts for each user"
        },
        {
          "type": "heading",
          "text": "4. Example: islands",
          "ink": "purple"
        },
        {
          "type": "table",
          "headers": [
            "id",
            "rn",
            "id - rn"
          ],
          "rows": [
            [
              "1",
              "1",
              "0"
            ],
            [
              "2",
              "2",
              "0"
            ],
            [
              "3",
              "3",
              "0"
            ],
            [
              "7",
              "4",
              "3"
            ],
            [
              "8",
              "5",
              "3"
            ]
          ],
          "highlightRow": 3
        },
        {
          "type": "paragraph",
          "text": "`id - ROW_NUMBER() OVER (ORDER BY id)` is constant inside a run. {purple:GROUP BY} it to get __consecutive islands__.",
          "frame": "dashed",
          "ink": "purple"
        },
        {
          "type": "heading",
          "text": "5. Mistakes",
          "ink": "red"
        },
        {
          "type": "bullets",
          "items": [
            "No `PARTITION BY`: LAG **leaks** across customers",
            "No `ORDER BY` inside OVER: LAG is **nondeterministic**",
            "Missing dates: previous row is not previous day",
            "Fix: `generate_series` a calendar, then LEFT JOIN"
          ],
          "style": "cross",
          "frame": "dashed",
          "ink": "red"
        },
        {
          "type": "callout",
          "style": "sticky",
          "title": "Revise",
          "text": "LAG back, LEAD forward. Pick the offset, set a default, partition, always ORDER BY."
        }
      ],
      "hero": "postgresql",
      "subtitle": "Peek at other rows"
    },
    {
      "page_title": "Frames: ROWS, RANGE and GROUPS",
      "blocks": [
        {
          "type": "heading",
          "text": "1. What is a frame?",
          "ink": "green"
        },
        {
          "type": "paragraph",
          "text": "A ==frame== is the subset of the partition, **relative to the current row**, that an aggregate or value function sees.",
          "frame": "dashed",
          "ink": "green"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "{ROWS | RANGE | GROUPS}",
            "BETWEEN frame_start",
            "AND frame_end"
          ],
          "note": "pick one mode, two bounds"
        },
        {
          "type": "heading",
          "text": "2. Bounds, defaults, EXCLUDE",
          "ink": "purple"
        },
        {
          "type": "table",
          "headers": [
            "Bound",
            "Reaches"
          ],
          "rows": [
            [
              "UNBOUNDED PRECEDING",
              "partition start"
            ],
            [
              "N PRECEDING",
              "N back"
            ],
            [
              "CURRENT ROW",
              "this row"
            ],
            [
              "N FOLLOWING",
              "N ahead"
            ],
            [
              "UNBOUNDED FOLLOWING",
              "partition end"
            ]
          ],
          "frame": "dashed"
        },
        {
          "type": "bullets",
          "items": [
            "With ORDER BY: default is `RANGE BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW`",
            "Without ORDER BY: the **whole partition**",
            "Shorthand: `ROWS UNBOUNDED PRECEDING` = `BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW`"
          ],
          "style": "dot",
          "frame": "dashed",
          "ink": "purple"
        },
        {
          "type": "table",
          "headers": [
            "EXCLUDE",
            "Trims"
          ],
          "rows": [
            [
              "NO OTHERS (default)",
              "nothing"
            ],
            [
              "CURRENT ROW",
              "this row"
            ],
            [
              "GROUP",
              "row + its peers"
            ],
            [
              "TIES",
              "peers, keeps row"
            ]
          ],
          "frame": "dashed"
        },
        {
          "type": "heading",
          "text": "3. ROWS vs RANGE vs GROUPS",
          "ink": "blue"
        },
        {
          "type": "table",
          "headers": [
            "Mode",
            "Counts",
            "Peers",
            "Offset needs"
          ],
          "rows": [
            [
              "ROWS",
              "physical rows",
              "can split",
              "any ORDER BY"
            ],
            [
              "RANGE",
              "ORDER BY values",
              "all included",
              "1 numeric/date/interval"
            ],
            [
              "GROUPS",
              "peer groups",
              "whole groups",
              "PostgreSQL 11+"
            ]
          ],
          "frame": "dashed"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "ROWS BETWEEN 2 PRECEDING",
            "  AND CURRENT ROW -- 3 rows",
            "GROUPS BETWEEN 1 PRECEDING",
            "  AND CURRENT ROW -- 2 groups"
          ],
          "note": "ROWS counts rows, GROUPS counts ties"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "AVG(v) OVER (ORDER BY day",
            "  RANGE BETWEEN",
            "  INTERVAL '7 days' PRECEDING",
            "  AND CURRENT ROW)"
          ],
          "note": "one date ORDER BY column only"
        },
        {
          "type": "heading",
          "text": "4. Dry run: the peer effect",
          "ink": "purple"
        },
        {
          "type": "table",
          "headers": [
            "d",
            "amt",
            "ROWS run",
            "RANGE run"
          ],
          "rows": [
            [
              "1",
              "10",
              "10",
              "10"
            ],
            [
              "2",
              "20",
              "30",
              "50"
            ],
            [
              "2",
              "20",
              "50",
              "50"
            ],
            [
              "3",
              "5",
              "55",
              "55"
            ]
          ],
          "highlightRow": 1,
          "frame": "dashed"
        },
        {
          "type": "callout",
          "style": "sticky",
          "title": "Ties share a total",
          "text": "Default RANGE gives tied rows the same running total. Use ROWS for a predictable running total, and for speed: RANGE must track peers."
        }
      ],
      "hero": "postgresql",
      "subtitle": "Which rows count"
    },
    {
      "page_title": "Frame Pitfalls and Safe Patterns",
      "blocks": [
        {
          "type": "heading",
          "text": "1. Common mistakes",
          "ink": "red"
        },
        {
          "type": "bullets",
          "items": [
            "RANGE with offsets on a **text** ORDER BY: error",
            "RANGE with offsets on a **multi-column** ORDER BY: error",
            "Expecting ROWS behaviour from the default frame",
            "Using GROUPS on PostgreSQL older than 11"
          ],
          "style": "cross",
          "frame": "dashed",
          "ink": "red"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "SUM(x) OVER (ORDER BY name",
            "  RANGE BETWEEN 1 PRECEDING",
            "  AND CURRENT ROW)"
          ],
          "note": "offset needs numeric or date key"
        },
        {
          "type": "bullets",
          "items": [
            "Offsets in RANGE are **values**, not row counts",
            "Offsets in ROWS and GROUPS are whole numbers",
            "The offset itself can never be negative or NULL"
          ],
          "style": "cross",
          "frame": "dashed",
          "ink": "red"
        },
        {
          "type": "heading",
          "text": "2. Safe patterns",
          "ink": "green"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "SUM(x) OVER (ORDER BY d",
            "  ROWS UNBOUNDED PRECEDING)"
          ],
          "note": "explicit frame, no peer surprise"
        },
        {
          "type": "table",
          "headers": [
            "Window has",
            "Default frame"
          ],
          "rows": [
            [
              "ORDER BY",
              "RANGE to CURRENT ROW"
            ],
            [
              "no ORDER BY",
              "whole partition"
            ],
            [
              "Ranking function",
              "frame ignored"
            ],
            [
              "LAG / LEAD",
              "frame ignored"
            ]
          ],
          "highlightRow": 0,
          "frame": "dashed"
        },
        {
          "type": "table",
          "headers": [
            "Task",
            "Frame to write"
          ],
          "rows": [
            [
              "Running total",
              "ROWS UNBOUNDED PRECEDING"
            ],
            [
              "Centered average",
              "ROWS BETWEEN 1 PRECEDING AND 1 FOLLOWING"
            ],
            [
              "Last 7 calendar days",
              "RANGE INTERVAL '6 days'"
            ],
            [
              "Last 2 tie groups",
              "GROUPS 1 PRECEDING"
            ]
          ],
          "highlightRow": 0,
          "frame": "dashed"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "AVG(v) OVER (ORDER BY d",
            "  ROWS BETWEEN 3 PRECEDING",
            "  AND 1 PRECEDING)"
          ],
          "note": "prior 3 rows, excludes current"
        },
        {
          "type": "bullets",
          "items": [
            "`EXCLUDE CURRENT ROW` trims the row from any frame",
            "`EXCLUDE TIES` keeps the row, drops its peers",
            "Peers = rows with an equal ORDER BY value"
          ],
          "style": "dot",
          "frame": "dashed",
          "ink": "green"
        },
        {
          "type": "paragraph",
          "text": "Example : compare each day to the average of the other days in the week.",
          "frame": "dashed",
          "ink": "pink"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "AVG(v) OVER (",
            "  ORDER BY d",
            "  ROWS BETWEEN 3 PRECEDING",
            "  AND 3 FOLLOWING",
            "  EXCLUDE CURRENT ROW)"
          ],
          "note": "seven-row frame minus self"
        },
        {
          "type": "paragraph",
          "text": "Example : sum the current tie group and the one before it.",
          "frame": "dashed",
          "ink": "pink"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "SUM(amt) OVER (ORDER BY d",
            "  GROUPS BETWEEN 1 PRECEDING",
            "  AND CURRENT ROW)"
          ],
          "note": "ties never split across frames"
        },
        {
          "type": "sidebox",
          "title": "Frame checklist",
          "items": [
            "Is there an ORDER BY inside OVER?",
            "Do I want rows, values or ties?",
            "Is the frame written out?",
            "Does the function even use a frame?"
          ],
          "ink": "green"
        },
        {
          "type": "callout",
          "style": "tip",
          "title": "Running totals",
          "text": "Write ROWS UNBOUNDED PRECEDING so tied rows still step up one by one."
        }
      ],
      "hero": "postgresql",
      "subtitle": "Which rows count"
    },
    {
      "page_title": "LAST_VALUE Trap and NTILE Buckets",
      "blocks": [
        {
          "type": "heading",
          "text": "1. LAST_VALUE trap",
          "ink": "blue"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "LAST_VALUE(price) OVER (",
            "  PARTITION BY product",
            "  ORDER BY day)"
          ],
          "note": "returns the current row's price"
        },
        {
          "type": "bullets",
          "items": [
            "Default frame ends at **CURRENT ROW**",
            "So the last row of the frame is the row itself",
            "`NTH_VALUE` has the same default-frame trap",
            "Frame is not ignored for value functions"
          ],
          "style": "cross",
          "frame": "dashed",
          "ink": "red"
        },
        {
          "type": "heading",
          "text": "2. Fixing it",
          "ink": "green"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "LAST_VALUE(price) OVER (",
            "  PARTITION BY product",
            "  ORDER BY day",
            "  ROWS BETWEEN UNBOUNDED",
            "  PRECEDING AND UNBOUNDED",
            "  FOLLOWING)"
          ],
          "note": "full frame sees the true last row"
        },
        {
          "type": "table",
          "headers": [
            "Goal",
            "Write"
          ],
          "rows": [
            [
              "Launch price",
              "FIRST_VALUE(price)"
            ],
            [
              "Latest price",
              "LAST_VALUE + full frame"
            ],
            [
              "Latest, no frame",
              "FIRST_VALUE + ORDER BY DESC"
            ],
            [
              "Second highest",
              "NTH_VALUE(x, 2) + full frame"
            ]
          ],
          "highlightRow": 2,
          "frame": "dashed"
        },
        {
          "type": "bullets",
          "items": [
            "Small frame than partition: NTH_VALUE returns **NULL**",
            "`IGNORE NULLS` arrived in PostgreSQL 19",
            "Before 19, emulate it with a subquery, not a frame option"
          ],
          "style": "check",
          "frame": "dashed",
          "ink": "green"
        },
        {
          "type": "callout",
          "style": "tip",
          "title": "Value function rule",
          "text": "FIRST_VALUE is safe by default. LAST_VALUE and NTH_VALUE need an explicit full frame."
        },
        {
          "type": "heading",
          "text": "3. NTILE buckets",
          "ink": "purple"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "SELECT id, score,",
            "  NTILE(4) OVER (",
            "    ORDER BY score DESC) AS q",
            "FROM results;"
          ],
          "note": "q = 1..4, quartile 1 is top"
        },
        {
          "type": "table",
          "headers": [
            "Rows",
            "Buckets",
            "Sizes"
          ],
          "rows": [
            [
              "10",
              "4",
              "3, 3, 2, 2"
            ],
            [
              "8",
              "4",
              "2, 2, 2, 2"
            ],
            [
              "7",
              "3",
              "3, 2, 2"
            ]
          ],
          "highlightRow": 0,
          "frame": "dashed"
        },
        {
          "type": "bullets",
          "items": [
            "`NTILE(n)` splits an ordered partition into **n** buckets",
            "Bucket sizes differ by at most one row",
            "`NTILE(100)` approximates percentiles",
            "Ties can land in **different** buckets"
          ],
          "style": "dot",
          "frame": "dashed",
          "ink": "purple"
        },
        {
          "type": "callout",
          "style": "cloud",
          "title": "True median",
          "text": "NTILE only buckets. Use PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY x) for a median."
        },
        {
          "type": "callout",
          "style": "takeaway",
          "title": "Frame cheatsheet",
          "text": "ROWS for counts, RANGE for values, GROUPS for ties. State the frame explicitly."
        }
      ],
      "hero": "postgresql",
      "subtitle": "Which rows count"
    }
