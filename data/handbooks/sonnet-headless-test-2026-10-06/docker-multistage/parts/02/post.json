      "page_title": "--target: Dev Stage and Bind Mounts",
      "blocks": [
        {
          "type": "heading",
          "text": "1. The dev loop",
          "ink": "blue"
        },
        {
          "type": "bullets",
          "items": [
            "`dev` adds hot-reload tooling and ==devDependencies==",
            "Bind-mount the source so edits show up instantly",
            "Compose sets `target: dev` locally, `prod` in release"
          ],
          "style": "dot",
          "frame": "dashed",
          "ink": "blue"
        },
        {
          "type": "code",
          "lang": "bash",
          "lines": [
            "docker build --target dev -t app:dev .",
            "docker run -v $PWD:/app -p 3000:3000 \\",
            "  app:dev"
          ],
          "note": "bind mount enables hot reload"
        },
        {
          "type": "heading",
          "text": "5a. The dev stage itself",
          "ink": "green"
        },
        {
          "type": "code",
          "lang": "dockerfile",
          "lines": [
            "FROM deps AS dev",
            "ENV NODE_ENV=development",
            "COPY . .",
            "EXPOSE 3000",
            "CMD [\"npm\",\"run\",\"dev\"]"
          ],
          "note": "extends deps, keeps devDependencies"
        },
        {
          "type": "bullets",
          "items": [
            "`FROM deps AS dev` reuses installed packages from cache",
            "`COPY . .` is a fallback if no bind mount",
            "`CMD` starts the watcher, not the built app"
          ],
          "style": "star",
          "frame": "dashed",
          "ink": "green"
        },
        {
          "type": "heading",
          "text": "5b. docker run flags",
          "ink": "purple"
        },
        {
          "type": "table",
          "headers": [
            "Flag",
            "Effect"
          ],
          "rows": [
            [
              "`-v $PWD:/app`",
              "mounts host source"
            ],
            [
              "`-p 3000:3000`",
              "publishes the port"
            ],
            [
              "`--rm`",
              "removes container on exit"
            ],
            [
              "`-it`",
              "interactive terminal"
            ]
          ],
          "frame": "dashed"
        },
        {
          "type": "callout",
          "style": "sticky",
          "title": "Mind node_modules",
          "text": "A bind mount hides the image's `node_modules`. Add an anonymous volume at `/app/node_modules`."
        },
        {
          "type": "heading",
          "text": "5c. Same thing in Compose",
          "ink": "orange"
        },
        {
          "type": "code",
          "lang": "yaml",
          "lines": [
            "services:",
            "  web:",
            "    build:",
            "      target: dev",
            "    volumes:",
            "      - .:/app",
            "      - /app/node_modules"
          ],
          "note": "second volume protects node_modules"
        },
        {
          "type": "code",
          "lang": "dockerfile",
          "lines": [
            "FROM build AS test",
            "RUN npm test"
          ],
          "note": "failing test fails the build"
        }
      ],
      "hero": "docker",
