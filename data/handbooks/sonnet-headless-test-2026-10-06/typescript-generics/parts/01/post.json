      "blocks": [
        {
          "type": "heading",
          "text": "1. keyof and T[K]",
          "ink": "green"
        },
        {
          "type": "bullets",
          "items": [
            "`keyof T` = union of T's known property names",
            "`keyof {a: 1, b: 2}` is =='a' | 'b'==",
            "`T[K]` is the type of property K on T: `Person['name']`",
            "`T[keyof T]` gives the union of all ==value types=="
          ],
          "style": "star",
          "frame": "dashed",
          "ink": "green"
        },
        {
          "type": "heading",
          "text": "2. typeof in a type position",
          "ink": "green"
        },
        {
          "type": "bullets",
          "items": [
            "`typeof value` captures a value's type",
            "`type Cfg = typeof config`",
            "`keyof typeof obj` = union of the object's keys",
            "`keyof any` is `string | number | symbol`"
          ],
          "style": "star",
          "frame": "dashed",
          "ink": "green"
        },
        {
          "type": "heading",
          "text": "3. Mechanism: lookups",
          "ink": "purple"
        },
        {
          "type": "code",
          "lang": "ts",
          "lines": [
            "function getProp<T, K extends keyof T>(",
            "  obj: T, key: K",
            "): T[K] {",
            "  return obj[key];",
            "}",
            "getProp({a: 1}, 'b'); // error"
          ],
          "note": "K is tied to T's real keys"
        },
        {
          "type": "table",
          "headers": [
            "Expression",
            "Result"
          ],
          "rows": [
            [
              "`getProp({a: 1}, 'b')`",
              "**error**: 'b' not keyof"
            ],
            [
              "`string[][number]`",
              "`string`"
            ],
            [
              "`typeof tuple[number]`",
              "union of elements"
            ],
            [
              "`keyof {[k: string]: X}`",
              "`string | number`"
            ]
          ],
          "frame": "dashed"
        },
        {
          "type": "heading",
          "text": "4. Example: literal unions",
          "ink": "blue"
        },
        {
          "type": "code",
          "lang": "ts",
          "lines": [
            "const dirs = ['up', 'down'] as const;",
            "type Dir = (typeof dirs)[number];",
            "// 'up' | 'down'",
            "const cfg = { port: 80, host: 'x' };",
            "type Key = keyof typeof cfg;",
            "// 'port' | 'host'"
          ],
          "note": "as const keeps literals"
        },
        {
          "type": "diagram",
          "kind": "flow",
          "spec": {
            "nodes": [
