                "ink": "purple"
              },
              {
                "text": "[number]",
                "sub": "element union",
                "ink": "green"
              },
              {
                "text": "Dir",
                "sub": "'up' | 'down'",
                "ink": "blue"
              }
            ]
          }
        },
        {
          "type": "heading",
          "text": "5. Common mistakes",
          "ink": "red"
        },
        {
          "type": "bullets",
          "items": [
            "`keyof T` returns property **keys**, not values; use `T[keyof T]`",
            "`Object.keys(obj)` is `string[]`, not `(keyof T)[]`",
            "Forgetting `as const`: `typeof dirs` widens to `string[]`"
          ],
          "style": "cross",
          "frame": "dashed",
          "ink": "red"
        },
        {
          "type": "callout",
          "style": "sticky",
          "title": "Remember",
          "text": "keyof = names, T[K] = values, typeof = value to type."
        },
        {
          "type": "heading",
          "text": "6. Values vs keys",
          "ink": "blue"
        },
        {
          "type": "code",
          "lang": "ts",
          "lines": [
            "type P = { id: number; n: string };",
            "type K = keyof P; // 'id' | 'n'",
            "type V = P[keyof P];",
            "// number | string",
            "const ks = Object.keys(p) as K[];"
          ],
          "note": "cast Object.keys at one boundary"
        },
        {
          "type": "bullets",
          "items": [
            "`keyof P` lists names, `P[keyof P]` lists value types",
            "`Object.keys` is `string[]`: cast once, near the edge",
            "`keyof` on a `string` index signature adds `number`"
          ],
          "style": "check",
          "frame": "dashed",
          "ink": "blue"
        }
      ],
      "hero": "typescript",
      "subtitle": "Types from types"
    },
    {
      "page_title": "Defaults and Inference",
      "blocks": [
        {
          "type": "heading",
          "text": "1. What a default is",
          "ink": "green"
        },
        {
          "type": "bullets",
          "items": [
            "`interface Response<T = unknown>`: bare `Response` means `Response<unknown>`",
            "Defaults go **after** required params: `<T, U = string>` is valid",
            "`<T = string, U>` is an error: required after default",
            "A default can use earlier params: `<T, U = T[]>`",
            "A default is not a bound: `<T extends string = 'a'>` sets ==both=="
          ],
          "style": "star",
          "frame": "dashed",
          "ink": "green"
        },
        {
          "type": "code",
          "lang": "ts",
          "lines": [
            "type Res<T = unknown> = { d: T };",
            "let a: Res; // Res<unknown>",
            "type P<T, U = T[]> = [T, U];",
            "type S<T extends string='a'>=T;"
          ],
          "note": "bound and default are two settings"
        },
        {
          "type": "heading",
          "text": "2. Where T comes from",
          "ink": "purple"
        },
        {
          "type": "table",
          "headers": [
            "Source",
            "Example",
            "T"
          ],
          "rows": [
            [
              "Argument",
              "f(1)",
              "number"
            ],
            [
              "Return context",
              "const s: string = make()",
              "string"
            ],
            [
              "Callback",
              "[1].map(x => x * 2)",
              "x: number"
            ]
          ],
          "frame": "dashed"
        },
        {
          "type": "diagram",
          "kind": "flow",
          "spec": {
            "nodes": [
              {
                "text": "explicit <T>",
                "sub": "wins",
                "ink": "blue"
              },
              {
                "text": "inferred candidates",
                "sub": "args, context",
                "ink": "green"
              },
              {
                "text": "default",
                "sub": "T = D",
                "ink": "purple"
              },
              {
                "text": "unknown",
                "sub": "or the bound",
                "ink": "red"
              }
            ]
          }
        },
        {
          "type": "bullets",
          "items": [
            "Default applies only with **no** candidate and no explicit arg",
            "Candidates from arguments, return context, callback typing"
          ],
          "style": "check"
        },
        {
          "type": "code",
          "lang": "ts",
          "lines": [
            "function f<T extends string>(",
            "  i: T[], d: NoInfer<T>) {}",
            "f(['a', 'b'], 'c'); // error"
          ],
          "note": "d adds no candidate (TS 5.4)"
        },
        {
          "type": "code",
          "lang": "ts",
          "lines": [
            "declare function make<A>():",
            "  <B>(b: B) => [A, B];",
            "make<string>()(1); // ok",
            "function k<const T>(x: T) {",
            "  return x; }",
            "k({ a: [1] }); // readonly literals"
          ],
          "note": "currying splits partial inference"
        },
        {
          "type": "heading",
          "text": "4. Common mistakes",
          "ink": "red"
        },
        {
          "type": "bullets",
          "items": [
            "`<T = string, U>`: a default before a required param",
            "`function make<T>(): T` with no hint gives `unknown`",
            "`g<string>(...)`: expecting B to be inferred anyway",
            "T only in a callback return that needs an annotation: no candidate",
            "Thinking a default ==restricts== T"
          ],
          "style": "cross",
          "frame": "dashed",
          "ink": "red"
        },
        {
          "type": "callout",
          "style": "sticky",
          "title": "Fix it with",
          "text": "Curry for partial inference, `satisfies` to check, `NoInfer<T>` to block a position, `<const T>` for literals."
        },
        {
          "type": "bullets",
          "items": [
            "Two candidates for one T must agree, or the call errors",
            "A looser signature `<A, B>` lets each arg keep its type",
            "Partial explicit args are not allowed: write all or none"
          ],
          "style": "check",
          "frame": "dashed",
          "ink": "blue"
        }
      ],
      "hero": "typescript",
      "subtitle": "T when nobody says"
