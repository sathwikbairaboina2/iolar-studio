    {
      "page_title": "Casts, Cost & Readable Errors",
      "blocks": [
        {
          "type": "heading",
          "text": "1. T Is Not a Value",
          "ink": "red"
        },
        {
          "type": "code",
          "lang": "ts",
          "lines": [
            "function bad<T>(): T {",
            "  return new T(); // error",
            "}",
            "function ok<T>(c: new () => T): T {",
            "  return new c();",
            "}"
          ],
          "note": "T is erased: pass a constructor"
        },
        {
          "type": "heading",
          "text": "2. Casts Hide Bugs",
          "ink": "red"
        },
        {
          "type": "code",
          "lang": "ts",
          "lines": [
            "function make<T>(): T {",
            "  return {} as T; // compiles",
            "}",
            "const n = make<number>();",
            "// n is {} at runtime, not a number"
          ],
          "note": "the cast silences a real bug"
        },
        {
          "type": "heading",
          "text": "3. Cost and Readability",
          "ink": "blue"
        },
        {
          "type": "table",
          "headers": [
            "Problem",
            "Sign",
            "Fix"
          ],
          "rows": [
            [
              "Deep recursion",
              "'excessively deep' error",
              "tail-recursive form"
            ],
            [
              "Heavy mapped types",
              "slow `tsc`, slow editor",
              "`--generateTrace`"
            ],
            [
              "Unreadable errors",
              "giant type dump",
              "`Simplify<T>` wrapper"
            ]
          ],
          "highlightRow": 2,
          "frame": "dashed"
        },
        {
          "type": "heading",
          "text": "4. Recursion Limits",
          "ink": "purple"
        },
        {
          "type": "bullets",
          "items": [
            "Error: 'Type instantiation is excessively deep and possibly infinite'",
            "Plain recursion gives up at about ==50== levels",
            "Tail-recursive conditionals reach about ==1000== levels"
          ],
          "style": "dot",
          "frame": "dashed",
          "ink": "purple"
        },
        {
          "type": "code",
          "lang": "ts",
          "lines": [
            "type Rep<T, N extends number,",
            "  A extends T[] = []> =",
            "  A['length'] extends N ? A",
            "  : Rep<T, N, [...A, T]>;",
            "type R = Rep<0, 3>; // [0, 0, 0]"
          ],
          "note": "accumulator makes it tail-recursive"
        },
        {
          "type": "heading",
          "text": "5. Readable Errors",
          "ink": "green"
        },
        {
          "type": "code",
          "lang": "ts",
          "lines": [
            "type Simplify<T> =",
            "  { [K in keyof T]: T[K] } & {};",
            "type A = { a: 1 } & { b: 2 };",
            "type S = Simplify<A>;",
            "// hover S: { a: 1; b: 2 }"
          ],
          "note": "hover shows one flat object"
        },
        {
          "type": "bullets",
          "items": [
            "Deep generics print giant, unreadable error messages",
            "Wrap the type in `Simplify<T>` to flatten it",
            "Hover a type alias to see the expanded shape"
          ],
          "style": "check",
          "frame": "dashed",
          "ink": "green"
        },
        {
          "type": "callout",
          "style": "tip",
          "title": "Measure first",
          "text": "Run `tsc --generateTrace dir` to find which types slow the compiler."
        },
        {
          "type": "callout",
          "style": "sticky",
          "title": "Remember",
          "text": "Keep generics simple: heavy type-level code costs `tsc` time and readers."
        }
      ],
