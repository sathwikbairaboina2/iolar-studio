    {
      "page_title": "Worked Examples & Return-Only T",
      "blocks": [
        {
          "type": "heading",
          "text": "1. Worked examples",
          "ink": "blue"
        },
        {
          "type": "code",
          "lang": "ts",
          "lines": [
            "function f<T>(a: T, b: T) {}",
            "f(1, 'x'); // error: clash",
            "function g<A, B>(a: A, b: B) {}",
            "g(1, 'x'); // A=number, B=string",
            "g<string>(1, 'x'); // error",
            "g<string, string>(1, 'x'); // ok"
          ],
          "note": "explicit args: all or none"
        },
        {
          "type": "table",
          "headers": [
            "Call",
            "Result"
          ],
          "rows": [
            [
              "`f(1, 2)`",
              "T = number"
            ],
            [
              "`f(1, 'x')`",
              "**error**: no common T"
            ],
            [
              "`g(1, 'x')`",
              "A = number, B = string"
            ],
            [
              "`g<string>(1, 'x')`",
              "**error**: B missing"
            ]
          ],
          "highlightRow": 1,
          "frame": "dashed"
        },
        {
          "type": "heading",
          "text": "2. Return-only T",
          "ink": "purple"
        },
        {
          "type": "code",
          "lang": "ts",
          "lines": [
            "declare function make<T>(): T;",
            "const a = make(); // unknown",
            "const b = make<number>(); // number",
            "const c: string = make();",
            "// c: T inferred from context"
          ],
          "note": "no argument means no candidate"
        },
        {
          "type": "bullets",
          "items": [
            "T only in the return type: nothing to infer from",
            "Return context can supply it: `const c: string = make()`",
            "Otherwise pass the type by hand or add a parameter"
          ],
          "style": "dot",
          "frame": "dashed",
          "ink": "purple"
        },
        {
          "type": "callout",
          "style": "tip",
          "title": "Debug tip",
          "text": "Hover the call in your editor: it shows the T the compiler picked, or `unknown`."
        },
        {
          "type": "heading",
          "text": "3. Give T a Source",
          "ink": "green"
        },
        {
          "type": "code",
          "lang": "ts",
          "lines": [
            "function mk<T>(c: new () => T)",
            "  : T {",
            "  return new c();",
            "}",
            "const d = mk(Date); // Date"
          ],
          "note": "a constructor argument is a candidate"
        },
        {
          "type": "table",
          "headers": [
            "Fix",
            "Code",
            "T becomes"
          ],
          "rows": [
            [
              "Add a param",
              "`make(x: T)`",
              "from argument"
            ],
            [
              "Pass a constructor",
              "`mk(Date)`",
              "`Date`"
            ],
            [
              "Explicit type",
              "`make<number>()`",
              "`number`"
            ],
            [
              "Add a default",
              "`<T = string>`",
              "`string`, no hint"
            ]
          ],
          "highlightRow": 1,
          "frame": "dashed"
        },
