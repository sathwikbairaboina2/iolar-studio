      "blocks": [
        {
          "type": "heading",
          "text": "1. Infer positions",
          "ink": "orange"
        },
        {
          "type": "code",
          "lang": "ts",
          "lines": [
            "type El<T> = T extends",
            "  (infer A)[] ? A : never;",
            "type Arg<F> = F extends",
            "  (x: infer P) => any ? P : never;",
            "type E = El<string[]>; // string",
            "type N = Arg<(n: 1) => 0>; // 1"
          ],
          "note": "infer reads array and param types"
        },
        {
          "type": "table",
          "headers": [
            "Type",
            "Input",
            "Result"
          ],
          "rows": [
            [
              "`El<T>`",
              "`string[]`",
              "string"
            ],
            [
              "`El<T>`",
              "`number`",
              "never"
            ],
            [
              "`El<T>`",
              "`string[] | number[]`",
              "string | number"
            ],
            [
              "`Arg<F>`",
              "`(n: 1) => 0`",
              "1"
            ]
          ],
          "highlightRow": 2,
          "frame": "dashed"
        },
        {
          "type": "heading",
          "text": "2. Own ReturnType",
          "ink": "green"
        },
        {
          "type": "code",
          "lang": "ts",
          "lines": [
            "type RT<F> =",
            "  F extends (...a: any[])",
            "    => infer R ? R : never;",
            "type S = RT<() => string>;",
            "// string"
          ],
          "note": "infer R captures the return"
        },
        {
          "type": "bullets",
          "items": [
            "`infer` only works inside an ==extends== clause",
            "A non-matching input falls to the `never` branch",
            "Naked `T` over a union **distributes** each member",
            "One `infer` per position you want to read"
          ],
          "style": "dot",
          "frame": "dashed",
          "ink": "green"
        },
        {
          "type": "callout",
          "style": "tip",
          "title": "Infer tip",
          "text": "Name each captured piece (`A`, `P`, `R`) so the result type reads like a sentence."
        },
        {
          "type": "heading",
          "text": "3. Own Parameters",
          "ink": "purple"
        },
        {
          "type": "code",
          "lang": "ts",
          "lines": [
            "type Params<F> = F extends",
            "  (...a: infer P) => any",
            "    ? P : never;",
            "type T = Params<(a: 1) => 0>;",
            "// [a: 1]"
          ],
          "note": "infer P captures the whole tuple"
