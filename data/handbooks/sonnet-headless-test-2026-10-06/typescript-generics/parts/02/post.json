          "ink": "purple"
        },
        {
          "type": "code",
          "lang": "ts",
          "lines": [
            "type A = { x: 1; a: 1 };",
            "type B = { x: 1; b: 2 };",
            "type Bad = Omit<A | B, 'x'>;",
            "// {}  nothing shared is left"
          ],
          "note": "union collapses before the drop"
        },
        {
          "type": "heading",
          "text": "3. Typed Factory",
          "ink": "orange"
        },
        {
          "type": "code",
          "lang": "ts",
          "lines": [
            "type Ctor<T> =",
            "  new (...a: any[]) => T;",
            "function make<T>(C: Ctor<T>): T {",
            "  return new C();",
            "}",
            "const d = make(Date); // Date"
          ],
          "note": "T is inferred from the constructor"
        },
        {
          "type": "bullets",
          "items": [
            "`InstanceType<C>` needs `typeof Class`, not the class name",
            "`ReturnType<typeof Class>` is an error: use `InstanceType`",
            "`abstract new (...a: any) => any` also accepts abstract classes",
            "`Ctor<T>` keeps the exact instance type for the caller"
          ],
          "style": "dot",
          "frame": "dashed",
          "ink": "orange"
        },
        {
          "type": "heading",
          "text": "4. Which Utility?",
