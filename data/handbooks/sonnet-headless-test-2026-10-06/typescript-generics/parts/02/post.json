          "type": "code",
          "lang": "ts",
          "lines": [
            "type L = Awaited<Promise<1>[]>;",
            "// Promise<1>[]  not unwrapped",
            "type M = Awaited<Promise<1>>[];",
            "// 1[]  unwrap each item first"
          ],
          "note": "Awaited acts on the promise itself"
        },
        {
          "type": "callout",
          "style": "sticky",
          "title": "Remember",
          "text": "`Awaited` peels promises, never containers: arrays and objects stay as they are."
        }
      ],
      "hero": "typescript",
      "subtitle": "The standard toolbox"
    },
    {
      "page_title": "Typo-Safe Omit & Constructor Checks",
      "blocks": [
        {
          "type": "heading",
          "text": "1. Typo-Safe Omit",
          "ink": "green"
        },
        {
          "type": "code",
          "lang": "ts",
          "lines": [
            "type SafeOmit<T, K extends",
            "  keyof T> = Pick<T,",
            "    Exclude<keyof T, K>>;",
            "type U = SafeOmit<User, 'emial'>;",
            "// error: not in keyof User"
          ],
          "note": "K extends keyof T catches the typo"
        },
        {
          "type": "bullets",
          "items": [
            "Constrain `K extends keyof T` to catch typos",
            "Use `Pick<T, Exclude<keyof T, K>>` as the body",
            "Wrap it in a conditional if `T` may be a union"
          ],
          "style": "checkbox",
          "frame": "dashed",
          "ink": "green"
        },
        {
          "type": "heading",
          "text": "2. Three Omit Versions",
          "ink": "blue"
        },
        {
          "type": "table",
          "headers": [
            "Version",
            "Typo key",
            "Union input"
          ],
          "rows": [
            [
              "`Omit`",
              "compiles",
              "collapses"
            ],
            [
              "`SafeOmit`",
              "error",
              "collapses"
            ],
            [
              "`DOmit`",
              "compiles",
              "distributes"
            ]
          ],
          "highlightRow": 2,
          "frame": "dashed"
        },
        {
          "type": "heading",
          "text": "3. NonNullable and Awaited",
          "ink": "purple"
        },
        {
          "type": "code",
          "lang": "ts",
          "lines": [
            "type M = string | null;",
            "type A = Awaited<Promise<M>>;",
            "// string | null  (null stays)",
            "type C = NonNullable<A>;",
            "// string"
          ],
          "note": "Awaited keeps null; strip it after"
        },
        {
          "type": "bullets",
          "items": [
            "`NonNullable<T>` strips `null` and `undefined` only",
            "`Exclude<T, null>` would leave `undefined` behind",
            "Compose it with `Awaited` for async lookups"
          ],
          "style": "dot",
          "frame": "dashed",
          "ink": "purple"
        },
        {
          "type": "heading",
          "text": "4. Constructor Dry Run",
          "ink": "orange"
        },
        {
          "type": "code",
          "lang": "ts",
          "lines": [
            "class User {",
            "  constructor(n: string) {}",
            "}",
            "type I = InstanceType<",
            "  typeof User>; // User",
            "type A = ConstructorParameters<",
            "  typeof User>; // [n: string]"
          ],
          "note": "labels survive in the args tuple"
        },
        {
          "type": "callout",
          "style": "tip",
          "title": "Union probe",
          "text": "Hover an `Omit` result on a union: one flat object type means it collapsed."
        },
        {
          "type": "bullets",
          "items": [
            "`Omit<User, 'emial'>` compiles and drops nothing",
            "`InstanceType<User>` is an error: use `typeof User`",
            "`Awaited<ReturnType<F>>` needs the `typeof` on `F`"
          ],
          "style": "cross",
          "frame": "dashed",
          "ink": "red"
        }
      ],
      "hero": "typescript",
      "subtitle": "The standard toolbox"
