            {
              "type": "bullets",
              "items": [
                "`<Link href>` is the ==primary API== for internal routes",
                "It enables prefetching and client transitions",
                "Navigation is wrapped in a ==React transition==",
                "Old UI stays visible until the new one is ready or `loading.js` shows"
              ],
              "style": "check"
