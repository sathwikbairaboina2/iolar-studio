        {
          "title": "Client Router Cache and Staleness",
          "blocks": [
            {
              "type": "heading",
              "text": "1. What It Is",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "==In-memory==, per-session cache of **RSC payloads** by route segment",
                "Separate from the server Data Cache and Full Route Cache",
                "Cleared on a ==hard refresh==",
                "Each **tab** has its own cache"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "blue"
            },
            {
              "type": "heading",
              "text": "2. Staleness Window",
              "ink": "purple"
            },
            {
              "type": "table",
              "headers": [
                "Page",
                "Stale time"
              ],
              "rows": [
                [
                  "Dynamic (`staleTimes.dynamic`)",
                  "==0s== default"
                ],
                [
                  "Static",
                  "==5 min=="
                ],
                [
                  "Dynamic + `prefetch={true}`",
                  "5 min"
                ]
              ],
              "frame": "dashed"
            },
            {
              "type": "bullets",
              "items": [
                "Tune with `experimental.staleTimes` in next.config"
              ],
              "style": "dot"
            },
            {
              "type": "code",
              "lang": "javascript",
              "lines": [
                "experimental: {",
                "  staleTimes: { dynamic: 30, static: 180 },",
                "}"
              ],
              "note": "seconds, in next.config"
            },
            {
              "type": "heading",
              "text": "3. Fixing Stale UI",
              "ink": "orange"
            },
            {
              "type": "table",
              "headers": [
                "Mutation made in",
                "Cache refresh"
              ],
              "rows": [
                [
                  "Server action",
                  "`revalidatePath` / `revalidateTag` / `cookies.set` / `delete` invalidate it"
                ],
                [
                  "Route handler or external API",
                  "Call ==router.refresh()=="
                ]
              ]
            },
            {
              "type": "bullets",
              "items": [
                "`router.refresh()` re-fetches the route from the server",
                "Keeps ==client state==; URL does **not** change"
              ],
              "style": "check"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Stale after a mutation?",
              "text": "Outside a server action nothing invalidates the cache: call ==router.refresh()=="
            }
          ]
        }
      ]
