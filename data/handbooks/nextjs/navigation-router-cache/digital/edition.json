    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "A layout holds a client counter at 3. The user clicks a plain `<a href=\"/about\">`. What does the counter show on the new page, and what if it were `<Link>`?",
              "a_bullets": [
                "Plain `<a>` is a **hard navigation**: full load, counter resets to 0",
                "`<Link>` is a soft navigation: layout stays mounted, counter stays 3"
              ]
            },
            {
              "type": "qa",
              "q": "Spot the bug: why does a missing post never show the 404 page?",
              "a_bullets": [
                "`notFound()` works by throwing, so the `catch` swallows it",
                "Call it outside the try block, or rethrow in the catch"
              ],
              "example_code": [
                "try {",
                "  const p = await getPost(id)",
                "  if (!p) notFound()",
                "} catch (e) { return <Oops /> }"
              ]
            },
            {
              "type": "qa",
              "q": "A route handler adds an item. Going back to a static `/items` page via `<Link>` still shows the old list. Why, and what fixes it?",
              "a_bullets": [
                "The client router cache holds the static page for 5 min; only server actions invalidate it",
                "Call `router.refresh()` after the mutation"
              ]
            }
          ]
        }
      ]
    }
