              "type": "heading",
              "text": "3. Cache and Hard Navigation",
              "ink": "purple"
            },
            {
              "type": "bullets",
              "items": [
                "Router cache stale time: ==dynamic 0s==, ==static 5 min==",
                "Refresh with `router.refresh()`",
                "Or `revalidatePath` / `revalidateTag` in a server action",
                "Plain `<a>`, `window.location`, refresh = ==hard navigation==: resets all client state"
              ],
              "style": "check",
              "ink": "purple"
            }
          ]
        }
