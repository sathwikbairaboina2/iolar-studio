            {
              "type": "heading",
              "text": "3. Setting and Deleting",
              "ink": "purple"
            },
            {
              "type": "bullets",
              "items": [
                "==Server Action==: login, logout, theme, consent",
                "==Route Handler==: `cookies()` or a raw `Set-Cookie` header"
              ],
              "style": "dot"
            },
            {
              "type": "code",
              "lang": "ts",
              "lines": [
                "(await cookies()).set('session', token,",
                "  { httpOnly: true, secure: true, path: '/' })",
                "return new Response(null, {",
                "  headers: { 'Set-Cookie': '...' } })"
              ]
            },
            {
              "type": "bullets",
              "items": [
                "Delete: `store.delete('name')` or set `maxAge: 0`"
              ],
              "style": "check"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Delete needs a match",
              "text": "==path== and ==domain== must equal the original cookie, or it is **not** removed."
            }
          ]
        }
