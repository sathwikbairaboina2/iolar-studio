    {
      "title": "Common Mistakes",
      "role": "outline",
      "outlineIndex": 4,
      "pages": [
        {
          "title": "Common Mistakes",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Await, Render and Dynamic",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "No `await`: `cookies()` is a ==Promise==, so `store.get` is not a function (TypeError)",
                "`cookies().set()` in a Server Component or during render ==throws==",
                "Move writes to a {green:Server Action} or {green:Route Handler}",
                "`cookies()` in a layout or page makes the ==whole route dynamic==: static caching is lost"
              ],
              "style": "cross",
              "ink": "red"
            },
            {
              "type": "code",
              "lang": "typescript",
              "lines": [
                "const bad = cookies().get('s')?.value // Promise",
                "const store = await cookies()",
                "const ok = store.get('s')?.value"
              ],
              "note": "await first, then read with ?.value"
            },
            {
              "type": "bullets",
              "items": [
                "Isolate the read in a small component inside `<Suspense>`"
              ],
              "style": "check",
              "ink": "green"
            },
            {
              "type": "heading",
              "text": "2. Auth Cookie Flags",
              "ink": "orange"
            },
            {
              "type": "code",
              "lang": "typescript",
              "lines": [
                "'use server'",
                "(await cookies()).set('session', token, {",
                "  httpOnly: true, secure: true,",
                "  sameSite: 'lax', path: '/'",
                "})"
              ],
              "note": "set in a Server Action"
            },
            {
              "type": "bullets",
              "items": [
                "`httpOnly`: hides it from JavaScript",
                "`secure`: sent over HTTPS only",
                "`sameSite`: blocks cross-site CSRF"
              ],
              "style": "check"
            },
            {
              "type": "heading",
              "text": "3. Edge Runtime",
              "ink": "purple"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Node-only in Edge",
              "text": "Importing `fs` in a route with `runtime = 'edge'` ==fails the build==. Edge has Web APIs only; stay on `'nodejs'`."
            }
          ]
        }
      ]
    },
