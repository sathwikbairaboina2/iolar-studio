          "title": "cookies() and headers() Mental Model",
          "blocks": [
            {
              "type": "heading",
              "text": "1. What They Are",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "Both come from `next/headers` and are ==async==: they return Promises",
                "**Request-time APIs**: they read the incoming HTTP request",
                "Work in Server Components, Route Handlers, Server Actions, middleware/proxy",
                "{red:Never} in Client Components"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "code",
              "lang": "typescript",
              "lines": [
                "import { cookies, headers } from 'next/headers'",
                "",
                "const store = await cookies()",
                "const theme = store.get('theme')?.value",
                "const ua = (await headers()).get('user-agent')"
              ],
              "note": "always await first"
            },
            {
              "type": "heading",
              "text": "2. The Two Return Values",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "",
                "cookies()",
                "headers()"
              ],
              "rows": [
                [
                  "Returns",
                  "cookie store",
                  "read-only Web `Headers`"
                ],
                [
                  "Methods",
                  "`get` `getAll` `has` `set` `delete`",
                  "`get(name)`"
                ],
                [
                  "Missing",
                  "`get` gives undefined",
                  "`get` gives null"
                ]
              ],
              "frame": "dashed"
            },
            {
              "type": "bullets",
              "items": [
                "`store.get(name)` returns `{ name, value }` or undefined: use ==?.value==",
                "Header names are **case-insensitive**",
                "You cannot set response headers through `headers()`"
              ],
              "style": "check"
            },
            {
              "type": "heading",
              "text": "3. Read vs Write",
              "ink": "orange"
            },
            {
              "type": "table",
              "headers": [
                "Where",
                "Read",
                "Write cookies"
              ],
              "rows": [
                [
                  "Server Component",
                  "{green:yes}",
                  "{red:no}"
                ],
                [
                  "Route Handler",
                  "{green:yes}",
                  "{green:yes}"
                ],
                [
                  "Server Action",
                  "{green:yes}",
                  "{green:yes}"
                ]
              ],
              "highlightRow": 0
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Remember",
              "text": "Reading works everywhere on the server. ==Writing cookies== only in Server Actions and Route Handlers."
            }
          ]
        }
      ]
    },
