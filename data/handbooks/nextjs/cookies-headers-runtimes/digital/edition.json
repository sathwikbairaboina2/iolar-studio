          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "Spot the bug: `const store = cookies(); const t = store.get('theme')?.value;`",
              "a_bullets": [
                "`store` is a Promise, not a cookie store, so `.get` is not available on it.",
                "Fix: `const store = await cookies()`."
              ]
            },
            {
              "type": "qa",
              "q": "A Server Component calls `(await cookies()).set('visited', '1')`. What happens, and where should it move?",
              "a_bullets": [
                "It throws: the response is already streaming, so `Set-Cookie` can no longer be sent.",
                "Move it to a Server Action or Route Handler."
              ]
            },
            {
              "type": "qa",
              "q": "A layout reads `cookies()` to pick a theme. Which pages stay static?",
              "a_bullets": [
                "None under it: the whole route becomes dynamic, rendered per request.",
                "Isolate the read in a component wrapped in `<Suspense>`."
              ]
            }
          ]
        }
