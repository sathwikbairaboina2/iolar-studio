    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "`lib/db.ts` has `export const prisma = new PrismaClient()`. After many saves in `next dev`, the database says \"too many connections\". Why?",
              "a_bullets": [
                "Each hot reload re-runs the module, so it builds a new client and pool.",
                "Fix: cache it on `globalThis`, only when `NODE_ENV` is not production."
              ]
            },
            {
              "type": "qa",
              "q": "You set `NEXT_PUBLIC_DATABASE_URL` so a Client Component can read it. What is the bug?",
              "a_bullets": [
                "The `NEXT_PUBLIC_` prefix inlines the value into the browser bundle, so the credentials leak.",
                "Keep `DATABASE_URL` unprefixed and query only in server-only code."
              ]
            },
            {
              "type": "qa",
              "q": "Your locale middleware has no `matcher`. A request for `/_next/static/app.js` arrives. What happens?",
              "a_bullets": [
                "It has no locale, so it is redirected to `/en/_next/static/app.js`, which returns 404.",
                "The matcher must exclude `_next`, static files and api routes."
              ]
            }
          ]
        }
      ]
    }
  ]
