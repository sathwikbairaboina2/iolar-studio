                  },
                  {
                    "text": "generateStaticParams",
                    "sub": "pre-render locales",
                    "ink": "green"
                  }
                ]
              }
            },
            {
              "type": "bullets",
              "items": [
                "`await params` in recent Next.js (a ==Promise==)",
                "Dictionary loader wrapped in `server-only`"
              ],
              "style": "dot"
            },
            {
              "type": "callout",
              "style": "sticky",
