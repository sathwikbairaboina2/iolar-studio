                "`page.tsx` makes a route ==public=="
              ],
              "style": "dot"
            },
            {
              "type": "heading",
              "text": "2. Special Files",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "Name",
                "Role"
              ],
              "rows": [
                [
                  "`layout` / `page`",
                  "shell / route UI"
                ],
                [
                  "`loading` / `error`",
                  "fallback / boundary"
                ],
                [
                  "`not-found`",
                  "404 UI"
                ],
                [
                  "`(group)`",
                  "hidden from URL"
                ],
                [
                  "`_private`",
                  "not routed"
                ],
                [
                  "`[slug]`",
                  "dynamic segment"
                ]
              ]
            },
            {
              "type": "heading",
              "text": "3. Config, TypeScript, Env",
              "ink": "purple"
            },
            {
              "type": "bullets",
              "items": [
                "`next.config.ts` typed `NextConfig`; ==restart== on change",
                "`typedRoutes: true`, `images.remotePatterns`, `output: 'standalone'`",
                "tsconfig `paths`: `\"@/*\": [\"./src/*\"]`",
                "Never edit `next-env.d.ts`",
                "ESLint: `eslint.config.mjs` extends `next/core-web-vitals`"
              ],
              "style": "check"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "process env",
                    "sub": "wins",
                    "ink": "green"
                  },
                  {
                    "text": ".env.$(NODE_ENV).local",
                    "ink": "blue"
                  },
                  {
                    "text": ".env.local",
                    "ink": "purple"
                  },
                  {
                    "text": ".env.$(NODE_ENV)",
                    "ink": "orange"
                  },
                  {
                    "text": ".env",
                    "sub": "loses",
                    "ink": "red"
                  }
                ]
              }
            },
            {
              "type": "bullets",
              "items": [
                "Only ==NEXT_PUBLIC_== reaches the browser, inlined at ==build== time",
                "Secrets in `NEXT_PUBLIC_`",
                "Committing `.env.local`"
              ],
              "style": "cross"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "SSR leak",
              "text": "A plain variable in a Client Component still renders into the server HTML. Read secrets only in ==server code==."
            }
          ]
        }
      ]
    },
    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "`.env` has NEXT_PUBLIC_API=a and `.env.local` has NEXT_PUBLIC_API=b. What does `npm run dev` use?",
              "a_bullets": [
                "==b==: `.env.local` ranks above `.env`",
                "Order: process env, `.env.development.local`, `.env.local`, `.env.development`, `.env`"
              ]
            },
            {
              "type": "qa",
              "q": "`app/blog/` holds only `Post.tsx` and `Card.tsx`. Why does /blog return 404?",
              "a_bullets": [
                "No `page.tsx` or `route.ts`, so the folder is not a public route",
                "Add `app/blog/page.tsx`"
              ]
            },
            {
              "type": "qa",
              "q": "A Client Component runs `process.env[name]` with name set to \"NEXT_PUBLIC_URL\". Why is it undefined in the browser?",
              "a_bullets": [
                "Next.js inlines only literal reads at build time",
                "Write `process.env.NEXT_PUBLIC_URL` directly, then rebuild"
              ]
            }
          ]
        }
      ]
    }
