    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "A component uses `className={`bg-${color}-500`}` with color set to 'red'. The element has no background. Why?",
              "a_bullets": [
                "Tailwind scans source for **complete** class strings; `bg-red-500` never appears, so no CSS is generated",
                "Fix: map to literal names, e.g. `{red: 'bg-red-500'}`"
              ]
            },
            {
              "type": "qa",
              "q": "A module-level Zustand store holds the logged-in user. Two users hit the server together. What goes wrong?",
              "a_bullets": [
                "The module is created once per server process, so **all requests share one store**",
                "One user's data can leak to another",
                "Fix: create the store per request in a provider"
              ]
            },
            {
              "type": "qa",
              "q": "The saved theme is dark, but each page load flashes light first. Why, and what fixes it?",
              "a_bullets": [
                "The server cannot read localStorage, so it renders the default theme",
                "Fix: a blocking inline script in `<head>` sets the theme on `<html>` before first paint",
                "Add `suppressHydrationWarning` on `<html>`"
              ]
            }
          ]
        }
      ]
    }
