              "type": "heading",
              "text": "2. How It Works",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "`cache()` dedupes cookie decrypt + DB lookup to ==once per render pass=="
              ],
              "style": "dot"
            },
            {
              "type": "code",
              "lang": "typescript",
              "lines": [
                "export const verifySession = cache(async () => {",
                "  const session = await getSession()",
                "  if (!session) redirect('/login')",
                "  return session",
                "})"
              ],
              "note": "call it from every DAL function"
            },
            {
              "type": "bullets",
              "items": [
                "Return ==DTOs==: only fields the caller may see",
                "Admin gets the full row; others get `{ name }`",
                "{red:passwordHash} and email never reach client props"
