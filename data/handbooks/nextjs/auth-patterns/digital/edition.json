        {
          "title": "Auth in Server Components and Actions",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Server Components",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "Cannot ==set cookies== or ==redirect== once streaming starts",
                "Read the session: `await cookies()` (async in recent versions)",
                "Missing session: `redirect('/login')` from `next/navigation`"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "Layouts do **not** re-render on client navigation",
                "A layout-only check can be {red:skipped}",
                "Check in ==every page== or in the data fetch itself"
              ],
              "style": "cross",
              "ink": "red"
            },
            {
              "type": "heading",
              "text": "2. Server Actions",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "Actions are ==public POST endpoints==",
                "Anyone can call them with `fetch`, form or no form",
                "Verify session and authorization **inside every action**"
              ],
              "style": "dot",
              "ink": "blue"
            },
            {
              "type": "code",
              "lang": "javascript",
              "lines": [
                "async function deletePost(id) {",
                "  'use server'",
                "  const session = await verifySession()",
                "  if (!session) throw new Error('Unauthorized')",
                "  // check ownership or role",
                "  // then mutate",
                "}"
              ],
              "note": "the check lives in the action, not the form"
            },
            {
              "type": "heading",
              "text": "3. Inputs",
              "ink": "purple"
            },
            {
              "type": "bullets",
              "items": [
                "Validate every input, e.g. with ==Zod==",
                "Never trust hidden form fields or a client-sent `userId`",
                "Derive the user from the **session** instead"
              ],
              "style": "check",
              "ink": "purple"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Where to check",
              "text": "Showing the form only in the UI is not security. Check in the ==page==, the ==data fetch== and the ==action==."
            }
          ]
        }
