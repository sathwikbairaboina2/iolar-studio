    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "RTL `render(<Page />)` fails when `Page` is an async Server Component. What do you do?",
              "a_bullets": [
                "RTL can't render async Server Components.",
                "Extract the fetch into a plain async function and unit test it with mocked fetch.",
                "Cover the page itself with Playwright."
              ]
            },
            {
              "type": "qa",
              "q": "A Server Action ends with `redirect('/done')`. You call it in a unit test with `vi.mock('next/navigation')`. What do you assert?",
              "a_bullets": [
                "The real `redirect` throws NEXT_REDIRECT.",
                "With the mock, assert `redirect` was called with '/done'."
              ]
            },
            {
              "type": "qa",
              "q": "`app/dashboard/layout.tsx` throws. `app/dashboard/error.tsx` exists. Does it catch it?",
              "a_bullets": [
                "No. error.tsx wraps its children, not the same-level layout.",
                "The parent segment's error.tsx or global-error.tsx catches it."
              ]
            }
          ]
        }
      ]
    }
