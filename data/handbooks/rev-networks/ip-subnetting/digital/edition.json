                  "Static NAT",
                  "1:1 fixed",
                  "inbound servers"
                ],
                [
                  "Dynamic NAT",
                  "pool of public IPs",
                  "outbound hosts"
                ],
                [
                  "==PAT==",
                  "many:1 via ports",
                  "home-router default"
                ]
              ],
              "highlightRow": 2
            },
            {
              "type": "heading",
              "text": "3. Costs",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "Breaks ==end-to-end== addressing",
                "Complicates **inbound** connections"
              ],
              "style": "cross"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "PAT",
              "text": "One public IP; translated **source ports** tell hosts apart."
            },
            {
              "type": "sidebox",
              "title": "Interview Point",
              "items": [
                "**Is 172.32.1.1 private?** No, only 172.16-172.31.",
                "**How does PAT share one IP?** It translates source ports too.",
                "**What is 169.254.x.x?** APIPA, DHCP failed."
              ],
              "ink": "orange"
            }
          ]
        }
      ]
