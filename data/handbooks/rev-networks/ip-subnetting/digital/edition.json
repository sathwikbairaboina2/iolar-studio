    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "Host 192.168.1.200/26: what are its network and broadcast addresses?",
              "a_bullets": [
                "Block size is 256-192 = 64, so .200 falls in the .192 block",
                "Network 192.168.1.192, broadcast 192.168.1.255",
                "Usable hosts .193-.254 (62)"
              ]
            },
            {
              "type": "qa",
              "q": "A host has 172.32.5.9. Is it a private address?",
              "a_bullets": [
                "No: RFC 1918 covers only 172.16.0.0 to 172.31.255.255 (/12)",
                "172.32.x.x is public and routable"
              ]
            },
            {
              "type": "qa",
              "q": "You need 50 hosts. Why /26 and not /27?",
              "a_bullets": [
                "/27 has 5 host bits: 2^5 - 2 = 30, too few",
                "/26 has 6 host bits: 2^6 - 2 = 62, enough"
              ]
            },
            {
              "type": "qa",
              "q": "Spot the bug in the IPv6 address 2001:db8::1::5.",
              "a_bullets": [
