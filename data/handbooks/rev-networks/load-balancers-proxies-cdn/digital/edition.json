                ],
                [
                  "Reverse proxy",
                  "servers",
                  "TLS, routing, cache"
                ],
                [
                  "Load balancer",
                  "a pool",
                  "reverse proxy spreading load"
                ]
              ]
            },
            {
              "type": "table",
              "headers": [
                "",
                "L4",
                "L7"
              ],
              "rows": [
                [
                  "Sees",
                  "TCP/UDP connection",
                  "host, path, header"
                ],
                [
                  "Trait",
                  "fast, blind to HTTP",
                  "TLS termination, rewriting"
                ]
              ],
              "highlightRow": 1
            },
            {
              "type": "heading",
              "text": "2. Algorithms and Health",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "==Round robin==: uniform requests",
                "==Least connections==: uneven or long requests",
                "==Consistent hash==: cache or affinity needs"
              ],
              "style": "dot"
            },
            {
              "type": "bullets",
              "items": [
                "Probe a real `/healthz`, not just the port",
                "Set ==fall/rise== thresholds",
                "==Drain== connections on deploy",
                "Sessions outside the server: no stickiness needed"
              ],
              "style": "check"
            },
            {
              "type": "heading",
              "text": "3. CDN and Anycast",
              "ink": "purple"
            },
            {
              "type": "bullets",
              "items": [
                "`s-maxage` + versioned URLs + minimal cache key",
                "Anycast: one IP from many sites, ==nearest route wins==",
                "Failover by ==route withdrawal=="
              ],
              "style": "dot"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "One balancer",
              "text": "A single load balancer is a single point of failure: run a pair."
            }
          ]
        }
      ]
    },
    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "You add the rule \"/api goes to pool A\" on an L4 balancer. Every request still lands on the same pool. Why?",
              "a_bullets": [
                "L4 sees only IPs and ports, never the URL",
                "Use an L7 balancer (ALB, nginx `http` block) for path rules"
              ]
            },
            {
              "type": "qa",
              "q": "`/healthz` always returns 200, even when the database is down. What happens during a DB outage?",
              "a_bullets": [
                "The balancer keeps sending users to broken backends",
                "Make the check reflect real readiness, with fall/rise thresholds"
              ]
            },
            {
              "type": "qa",
              "q": "A CDN caches a response that has `Set-Cookie` and `Cache-Control: public, s-maxage=3600`. What goes wrong?",
              "a_bullets": [
                "Other users can receive that user's personalized response and session cookie",
                "Use `private` or `no-store` for personalized responses"
              ]
            }
          ]
        }
      ]
    }
  ]
