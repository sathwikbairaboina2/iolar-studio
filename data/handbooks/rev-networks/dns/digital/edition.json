    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "TTL was 86400. At 10:00 you set 300, at 10:05 you changed the IP. Why do some users see the old IP tomorrow?",
              "a_bullets": [
                "Resolvers that cached before 10:00 keep the 86400 s copy",
                "The new TTL applies only after they refetch",
                "Lower TTL one old TTL (24 h) before the change"
              ]
            },
            {
              "type": "qa",
              "q": "dig @ns1 new.example.com works, but your resolver says NXDOMAIN right after you create it. Why?",
              "a_bullets": [
                "It cached the earlier NXDOMAIN",
                "Negative TTL comes from the SOA",
                "Wait it out, or flush your own cache"
              ]
            },
            {
              "type": "qa",
              "q": "Spot the bug: example.com has CNAME lb.host.net. and MX 10 mail.example.com.",
              "a_bullets": [
                "A CNAME cannot coexist with other records at its name",
                "The apex also holds SOA and NS",
                "Use A records or ALIAS/ANAME instead"
              ]
            }
          ]
        }
      ]
    }
  ]
