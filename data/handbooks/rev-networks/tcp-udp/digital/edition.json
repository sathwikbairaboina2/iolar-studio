                  "41"
                ],
                "indices": true,
                "pointers": [
                  {
                    "index": 3,
                    "label": "ssthresh"
                  },
                  {
                    "index": 6,
                    "label": "loss"
                  }
                ],
                "highlight": [
                  3
                ],
                "caption": "cwnd in MSS per RTT: doubling, then +1, then drop"
              }
            },
            {
              "type": "bullets",
              "items": [
                "{green:Slow start}: cwnd ~==10 MSS==, doubles every RTT until ssthresh",
                "{blue:AIMD}: ==+1 MSS== per RTT (additive increase)",
                "{red:Multiplicative decrease}: on loss, ==ssthresh = cwnd/2==",
                "Example: loss at cwnd 82 gives ssthresh = 41"
              ],
              "style": "dot",
              "frame": "dashed"
            },
            {
              "type": "heading",
              "text": "3. Loss Reaction",
              "ink": "purple"
            },
            {
              "type": "diagram",
              "kind": "flowchart",
              "spec": {
                "rows": [
                  [
                    "q"
                  ],
                  [
                    "a",
                    "b"
                  ]
                ],
                "nodes": {
                  "q": {
                    "text": "Loss signal?",
                    "shape": "diamond"
                  },
                  "a": {
                    "text": "cwnd = 1 MSS, slow start",
                    "shape": "box",
                    "ink": "red"
                  },
                  "b": {
                    "text": "cwnd halves, fast recovery",
                    "shape": "box",
                    "ink": "green"
                  }
                },
                "edges": [
                  {
                    "from": "q",
                    "to": "a",
                    "label": "timeout"
                  },
                  {
                    "from": "q",
                    "to": "b",
                    "label": "3 dup ACKs (Reno)"
                  }
                ]
              }
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Common mistake",
              "text": "==rwnd== is the receiver limit; ==cwnd== is the network limit. Never swap them."
            },
            {
              "type": "heading",
              "text": "4. Interview Point",
              "ink": "orange"
            },
            {
              "type": "bullets",
              "items": [
                "**Why double in slow start?** It probes capacity fast; the window grows by ACKs received.",
                "**rwnd vs cwnd?** Receiver limit vs network limit; the sender uses the smaller.",
                "**Timeout vs 3 dup ACKs?** Timeout resets to 1 MSS; dup ACKs only halve cwnd."
              ],
              "style": "dot"
            }
          ]
        }
      ]
    },
    {
      "title": "TCP vs UDP Cheat Sheet",
      "role": "outline",
