    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "Each segment carries 500 bytes. seq=1000 arrives, seq=1500 is lost, then seq=2000, 2500 and 3000 arrive. What ACKs come back?",
              "a_bullets": [
                "seq=1000 gives ack=1500, the next expected byte",
                "seq=2000, 2500 and 3000 each give ack=1500 again (duplicates 1, 2, 3)",
                "Three duplicates trigger fast retransmit of seq=1500, with no RTO wait"
              ]
            },
            {
              "type": "qa",
              "q": "rwnd=8000, cwnd=20000, 5000 bytes unacknowledged. How many more bytes can be sent?",
              "a_bullets": [
                "Limit is min(rwnd, cwnd) = 8000",
                "8000 - 5000 = 3000 more bytes",
                "cwnd is the network limit, rwnd the receiver limit"
              ]
            },
            {
              "type": "qa",
              "q": "A server restarts and bind() fails with 'Address already in use'. Why, and what fixes it?",
              "a_bullets": [
                "Old connections sit in TIME_WAIT on that port",
                "Set SO_REUSEADDR before bind()"
              ]
            },
            {
              "type": "qa",
              "q": "Can 1000 clients connect to one server listening on port 443?",
              "a_bullets": [
                "Yes, each connection has a different 4-tuple",
                "The listening socket is shared; connections are not"
              ]
            }
          ]
        }
      ]
    }
