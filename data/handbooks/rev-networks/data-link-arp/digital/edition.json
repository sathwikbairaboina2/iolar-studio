    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "The MAC table is empty. A (port 1) sends to B (port 2), then C (port 3) sends to A. Where does C's frame go?",
              "a_bullets": [
                "Only out port 1.",
                "A's first frame taught the switch A = port 1, because it learns from the source MAC."
              ]
            },
            {
              "type": "qa",
              "q": "Host 10.0.0.2/24 with gateway 10.0.0.1 pings 8.8.8.8. Which MAC and IP are in the frame's destination fields?",
              "a_bullets": [
                "Dst MAC is the gateway's, found by ARPing 10.0.0.1.",
                "Dst IP stays 8.8.8.8, since only the MAC pair is rewritten per hop."
              ]
            },
            {
              "type": "qa",
              "q": "Two PCs on one switch share 10.0.0.0/24, but one is in VLAN 10 and the other in VLAN 20. Does ping work?",
              "a_bullets": [
                "No. Each VLAN is its own broadcast domain.",
                "The ARP request never reaches the other PC, so no reply comes back."
              ]
            }
          ]
        }
      ]
    }
