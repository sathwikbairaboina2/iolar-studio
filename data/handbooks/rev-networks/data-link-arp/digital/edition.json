              "text": "1. Frame and Switch Rules",
              "ink": "blue"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "Dst MAC",
                    "sub": "6B",
                    "ink": "blue"
                  },
                  {
                    "text": "Src MAC",
                    "sub": "6B",
                    "ink": "green"
                  },
                  {
                    "text": "EtherType",
                    "sub": "2B",
                    "ink": "purple"
                  },
                  {
                    "text": "Payload",
                    "sub": "46-1500B",
                    "ink": "orange"
                  },
                  {
                    "text": "FCS",
                    "sub": "4B",
                    "ink": "red"
                  }
                ]
              }
            },
            {
              "type": "bullets",
              "items": [
                "Broadcast MAC = ==FF:FF:FF:FF:FF:FF==",
                "{green:Learn} from the ==source MAC==",
                "{blue:Forward} by the ==destination MAC==",
                "{orange:Flood} unknown unicast and broadcast",
                "Table entries age out after ==300 s== (Cisco default)",
                "{red:ARP} request is broadcast"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "blue"
            },
            {
              "type": "heading",
              "text": "2. ARP",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "Request is ==broadcast==, reply is ==unicast==",
                "Off-subnet traffic ARPs for the **gateway**, not the destination",
                "Cache holds IP to MAC entries"
              ],
              "style": "dot"
            },
            {
              "type": "code",
              "lang": "bash",
              "lines": [
                "arp -a",
                "ip neigh show"
              ],
              "note": "show the ARP cache"
            },
            {
              "type": "heading",
              "text": "3. VLANs",
              "ink": "purple"
            },
            {
              "type": "table",
              "headers": [
                "Port",
                "VLANs",
                "Tag"
              ],
              "rows": [
                [
                  "Access",
