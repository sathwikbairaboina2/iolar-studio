                  "untagged"
                ],
                [
                  "Trunk",
                  "many",
                  "==802.1Q== tagged"
                ]
              ]
            },
            {
              "type": "bullets",
              "items": [
                "Each VLAN = ==one broadcast domain==",
                "Reaching another VLAN needs a ==router=="
              ],
              "style": "check"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Mistakes to avoid",
              "text": "Native VLAN mismatch. Assuming switches stop broadcasts. Expecting different VLANs to ping without routing. Trusting ARP replies blindly."
            }
