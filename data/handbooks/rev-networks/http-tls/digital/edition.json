      "pages": [
        {
          "title": "Methods and Status Codes",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Methods",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "Method",
                "Use",
                "Idempotent"
              ],
              "rows": [
                [
                  "`GET`",
                  "reads",
                  "{green:yes}"
                ],
                [
                  "`POST`",
                  "creates or triggers",
                  "{red:no}"
                ],
                [
                  "`PUT`",
                  "replaces whole resource",
                  "{green:yes}"
                ],
                [
                  "`PATCH`",
                  "changes part",
                  "{red:no}"
                ],
                [
                  "`DELETE`",
                  "removes",
                  "{green:yes}"
                ]
              ]
            },
            {
              "type": "bullets",
              "items": [
                "==Safe== (no state change): `GET`, `HEAD`, `OPTIONS`",
                "==Idempotent==: repeating gives the same result",
                "`POST` is **neither** safe nor idempotent"
              ],
              "style": "dot"
            },
            {
              "type": "heading",
              "text": "2. Status Codes",
