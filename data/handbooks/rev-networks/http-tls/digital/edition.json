            {
              "type": "callout",
              "style": "sticky",
              "title": "Fragment",
              "text": "The ==#fragment== is never sent to the server."
            },
            {
              "type": "sidebox",
              "title": "Interview Point",
              "items": [
                "**Is HTTP stateful?** No; cookies and tokens add state",
                "**What is on the start line?** Method, path, version",
                "**Is the fragment sent?** No, browser only"
              ],
              "ink": "orange"
            }
          ]
        }
      ]
    },
    {
      "title": "Methods and Status Codes",
      "role": "outline",
