    {
      "title": "HTTP/1.1 vs HTTP/2 vs HTTP/3",
      "role": "outline",
      "outlineIndex": 3,
      "pages": [
        {
          "title": "HTTP/1.1 vs HTTP/2 vs HTTP/3",
          "blocks": [
            {
              "type": "heading",
              "text": "1. HTTP/1.1",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "Text protocol over ==TCP==",
                "One request at a time per connection: ==head-of-line blocking==",
                "Browsers open ~==6 parallel connections== per host",
                "==Keep-alive== reuses a connection"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "heading",
              "text": "2. HTTP/2 and HTTP/3",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "",
                "1.1",
                "2",
                "3"
              ],
              "rows": [
                [
                  "Runs on",
                  "TCP",
                  "TCP",
                  "QUIC on UDP"
                ],
                [
                  "Format",
                  "text",
                  "binary frames",
                  "binary frames"
                ],
                [
                  "Requests",
                  "serial",
                  "multiplexed",
                  "multiplexed"
                ],
                [
                  "HOL blocking",
                  "per connection",
                  "{red:TCP level}",
                  "{green:own stream only}"
                ]
              ],
              "highlightRow": 3
            },
            {
              "type": "bullets",
              "items": [
                "HTTP/2: many streams on one connection, ==HPACK== header compression",
                "HTTP/3: TLS 1.3 built in, faster handshake, ==connection migration=="
              ],
              "style": "dot"
            },
            {
              "type": "heading",
              "text": "3. Negotiation and Trade-off",
              "ink": "purple"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "TLS handshake",
                    "sub": "ALPN picks h2",
                    "ink": "blue"
                  },
                  {
                    "text": "Response",
                    "sub": "Alt-Svc: h3",
                    "ink": "purple"
                  },
                  {
                    "text": "QUIC connection",
                    "sub": "HTTP/3 next",
                    "ink": "green"
                  }
                ]
              }
            },
            {
              "type": "bullets",
              "items": [
                "Semantics unchanged: methods, status codes, headers",
                "1.1 needs ==bundling== and ==domain sharding== for speed",
                "HTTP/2 and HTTP/3 make both unnecessary"
              ],
              "style": "check"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Remember",
              "text": "HTTP/2 stays stuck on TCP-level blocking; only ==HTTP/3== on QUIC isolates packet loss per stream."
            }
          ]
        }
      ]
    },
