        {
          "title": "HTTP Mental Model",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Stateless request/response",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "==Text-based==: client sends one request, server returns one response",
                "Server keeps ==no memory== between requests",
                "{red:Stateless} is why cookies and tokens exist"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "heading",
              "text": "2. Message shape",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "",
                "Request",
                "Response"
              ],
              "rows": [
                [
                  "Start line",
                  "`GET /path HTTP/1.1`",
                  "`HTTP/1.1 200 OK`"
                ],
                [
                  "Next",
                  "headers",
                  "headers"
                ],
                [
                  "Then",
                  "==blank line==",
                  "==blank line=="
                ],
                [
                  "End",
                  "optional body",
                  "optional body"
                ]
              ],
              "frame": "dashed"
            },
            {
              "type": "code",
              "lang": "http",
              "lines": [
                "GET /users?id=7 HTTP/1.1",
                "Host: example.com",
                "Accept: application/json",
                ""
              ],
              "note": "a request with no body"
            },
            {
              "type": "heading",
              "text": "3. URL and ports",
              "ink": "purple"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "https://",
                    "sub": "scheme",
                    "ink": "blue"
                  },
                  {
                    "text": "example.com",
                    "sub": "host",
                    "ink": "green"
                  },
                  {
                    "text": ":443",
                    "sub": "port",
                    "ink": "orange"
                  },
                  {
                    "text": "/users",
                    "sub": "path",
                    "ink": "purple"
                  },
                  {
                    "text": "?id=7",
                    "sub": "query",
                    "ink": "pink"
                  },
                  {
                    "text": "#top",
                    "sub": "fragment",
                    "ink": "red"
                  }
                ]
              }
            },
            {
              "type": "bullets",
              "items": [
                "Default ports: HTTP ==80==, HTTPS ==443=="
