    {
      "title": "HTTP Cheat Sheet",
      "role": "outline",
      "outlineIndex": 5,
      "pages": [
        {
          "title": "HTTP Cheat Sheet",
          "blocks": [
            {
              "type": "heading",
              "text": "1. curl essentials",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "`-i` shows response headers, `-v` shows the TLS handshake and headers",
                "`-L` follows redirects, `--http2` / `--http3` pick the protocol"
              ],
              "style": "dot"
            },
            {
              "type": "code",
              "lang": "bash",
              "lines": [
                "curl -i URL",
                "curl -X POST -H 'Content-Type: application/json' -d '{\"a\":1}' URL",
                "curl -v URL",
                "curl -L URL",
                "curl --http2 URL   # or --http3"
              ]
            },
            {
              "type": "heading",
              "text": "2. Methods and status",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "Method",
                "Meaning",
                "Idempotent"
              ],
              "rows": [
                [
                  "GET",
                  "read",
                  "{green:yes}"
                ],
                [
                  "POST",
                  "create",
                  "{red:no}"
                ],
                [
                  "PUT",
                  "replace",
                  "{green:yes}"
                ],
                [
                  "PATCH",
                  "partial update",
                  "{red:no}"
                ],
                [
                  "DELETE",
                  "remove",
                  "{green:yes}"
                ]
              ]
            },
            {
              "type": "bullets",
              "items": [
                "==2xx== ok, ==3xx== go elsewhere, ==4xx== your fault, ==5xx== server's fault",
                "==401== = who are you? ==403== = not allowed"
              ],
              "style": "check"
            },
