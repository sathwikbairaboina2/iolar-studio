    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "A user sends a valid token, but GET /admin fails. Is it 401 or 403?",
              "a_bullets": [
                "**403**: the server knows who you are, but you aren't allowed.",
                "401 means missing or invalid credentials."
              ]
            },
            {
              "type": "qa",
              "q": "`Set-Cookie: sid=abc; Secure; SameSite=Lax`. Can an injected script read it with `document.cookie`?",
              "a_bullets": [
                "**Yes**: `HttpOnly` is missing.",
                "`Secure` and `SameSite` don't hide a cookie from JavaScript."
              ]
            },
            {
              "type": "qa",
              "q": "One packet is lost on an HTTP/2 connection carrying 10 streams. What stalls?",
              "a_bullets": [
                "**All 10 streams**: TCP delivers bytes in order, so everything waits for the retransmit.",
                "HTTP/3 over QUIC stalls only the stream that lost the packet."
              ]
            },
            {
              "type": "qa",
              "q": "The same PUT is sent three times, then the same POST three times. What differs?",
              "a_bullets": [
                "PUT is idempotent: the state after three calls equals the state after one.",
                "POST may create three resources, so it is not safe to retry blindly."
              ]
            }
          ]
        }
      ]
    }
  ]
