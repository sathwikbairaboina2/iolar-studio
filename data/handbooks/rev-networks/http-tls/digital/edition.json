            {
              "type": "heading",
              "text": "2. Cookies",
              "ink": "orange"
            },
            {
              "type": "bullets",
              "items": [
                "Server sends ==Set-Cookie==; browser returns ==Cookie== on every matching request"
              ],
              "style": "dot"
            },
            {
              "type": "code",
              "lang": "http",
              "lines": [
                "Set-Cookie: id=abc; HttpOnly; Secure; SameSite=Lax; Max-Age=3600",
                "Cookie: id=abc"
              ]
            },
            {
              "type": "bullets",
              "items": [
                "==HttpOnly==: hidden from JavaScript",
                "==Secure==: HTTPS only",
                "==SameSite=Lax/Strict==: limits cross-site sending, defends against CSRF",
                "`Max-Age` / `Expires`: lifetime; `Path` / `Domain`: scope"
              ],
              "style": "check",
              "frame": "dashed",
              "ink": "orange"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Common mistakes",
              "text": "Session token in a cookie without **HttpOnly + Secure + SameSite**, or credentials in a URL ==query string==."
            }
          ]
        }
      ]
