    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "A host sends a packet through one router to a server on another network, with no NAT. Which of MAC, IP and port change?",
              "a_bullets": [
                "Only the ==MAC addresses== change: each L2 header spans one link",
                "IP and port stay ==end to end==",
                "TTL also drops by 1, but it was not one of the three"
              ]
            },
            {
              "type": "qa",
              "q": "Ping to a server succeeds, but its website times out. Where do you look next?",
              "a_bullets": [
                "Ping is ICMP at L3, so IP and routing work",
                "Check L4 next: port 443 open, firewall rules",
                "Then L7: app logs"
              ]
            },
            {
              "type": "qa",
              "q": "PC A sends a frame to PC B. Who else sees it on a hub, and on a switch?",
              "a_bullets": [
                "Hub: every other port, since it repeats all bits",
                "Switch: only B's port once it has learned B's MAC",
                "Unknown destination MAC: the switch floods it"
              ]
            }
          ]
        }
      ]
