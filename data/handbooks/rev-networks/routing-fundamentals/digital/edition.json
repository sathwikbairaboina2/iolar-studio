                ],
                [
                  "Windows",
                  "`route print`"
                ],
                [
                  "Cisco",
                  "`show ip route`"
                ],
                [
                  "Any",
                  "`traceroute` shows each hop (Windows: `tracert`)"
                ]
              ]
            },
            {
              "type": "heading",
              "text": "3. Protocol Picks",
              "ink": "purple"
            },
            {
              "type": "bullets",
              "items": [
                "{green:Static}: small or stub networks",
                "{blue:OSPF}: inside one organisation",
                "{orange:BGP}: between ASes and multihoming to ISPs"
              ],
              "style": "check"
            },
            {
              "type": "heading",
              "text": "4. Quick Fixes",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "No access outside the subnet → ==default gateway==",
                "One-way traffic → ==return route==",
                "OSPF neighbour stuck → area, timers, MTU, authentication",
                "BGP not Established → TCP 179 reachability, `remote-as`, ACLs"
              ],
              "style": "check",
              "frame": "dashed",
              "ink": "red"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Interview point",
              "text": "**/24 with AD 110 or /16 with AD 1?** The /24 wins: ==prefix length== is checked before AD and metric."
            }
          ]
        }
