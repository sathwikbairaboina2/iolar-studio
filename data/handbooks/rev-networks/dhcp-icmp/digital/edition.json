    {
      "title": "Traceroute and TTL",
      "role": "outline",
      "outlineIndex": 3,
      "pages": [
        {
          "title": "Traceroute and TTL",
          "blocks": [
            {
              "type": "heading",
              "text": "1. TTL Stops Loops",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "==TTL== is an **IP header** field",
                "Each router subtracts ==1==",
                "At 0 the router {red:drops} the packet",
                "It sends ICMP ==Time Exceeded== (type 11) to the source",
                "This stops packets circling in ==routing loops=="
              ],
              "style": "check",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "heading",
              "text": "2. How Traceroute Works",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "Probes go out with TTL ==1, 2, 3...==",
                "Each Time Exceeded reveals {blue:one hop}"
              ],
              "style": "dot"
            },
            {
              "type": "diagram",
              "kind": "chain",
              "spec": {
                "steps": [
                  {
                    "text": "TTL 1",
                    "note": "Router 1: Time Exceeded",
                    "ink": "blue"
                  },
                  {
                    "text": "TTL 2",
                    "note": "Router 2: Time Exceeded",
                    "ink": "blue"
                  },
                  {
                    "text": "TTL n",
                    "note": "Final host replies, trace ends",
                    "ink": "green"
                  }
                ]
              }
            },
            {
              "type": "table",
              "headers": [
                "",
                "Linux traceroute",
                "Windows tracert"
              ],
              "rows": [
                [
                  "Probe",
                  "UDP, high ports",
                  "ICMP Echo"
                ],
                [
                  "Hop reply",
                  "Time Exceeded (11)",
                  "Time Exceeded (11)"
                ],
                [
                  "Final reply",
                  "Port Unreachable (3/3)",
                  "Echo Reply"
                ]
              ],
              "highlightRow": 2
            },
            {
              "type": "heading",
              "text": "3. Commands and Gotcha",
              "ink": "purple"
            },
            {
              "type": "code",
              "lang": "bash",
              "lines": [
                "traceroute host     # Linux, UDP probes",
                "traceroute -I host  # force ICMP",
                "tracert host        # Windows",
                "mtr host            # live, loss per hop"
              ]
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "`* * *` is not a broken path",
              "text": "That router did not reply: ==rate-limited or filtered==. If later hops answer, traffic is **passing**."
            }
          ]
        }
      ]
    },
    {
      "title": "MTU, Fragmentation and Path MTU Discovery",
      "role": "outline",
      "outlineIndex": 4,
      "pages": [
        {
          "title": "MTU, Fragmentation and Path MTU Discovery",
          "blocks": [
            {
              "type": "heading",
              "text": "1. MTU and Fragmentation",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "==MTU== = largest IP packet a link carries",
                "Ethernet MTU = ==1500== bytes",
                "TCP ==MSS 1460== = 1500 - 20 IP - 20 TCP"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "table",
              "headers": [
                "DF bit",
                "Packet bigger than MTU"
              ],
              "rows": [
                [
                  "Not set",
                  "Router ==fragments== it"
                ],
                [
                  "Set",
                  "Router {red:drops} it, returns ICMP ==3/4== with next-hop MTU"
                ]
              ],
              "highlightRow": 1
            },
            {
              "type": "heading",
              "text": "2. Path MTU Discovery",
              "ink": "purple"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "Send + DF",
                    "sub": "full-size packet",
                    "ink": "blue"
                  },
                  {
                    "text": "Router drops",
                    "sub": "too big",
                    "ink": "red"
                  },
                  {
                    "text": "ICMP 3/4",
                    "sub": "next-hop MTU",
                    "ink": "orange"
                  },
                  {
                    "text": "Shrink",
                    "sub": "resend smaller",
                    "ink": "green"
                  }
                ]
              }
            },
            {
              "type": "bullets",
              "items": [
                "Sender repeats until packets fit: that size is the ==PMTU==",
                "IPv6: routers **never** fragment; they send ICMPv6 ==Packet Too Big=="
              ],
              "style": "dot"
            },
            {
              "type": "code",
              "lang": "bash",
              "lines": [
                "ping -M do -s 1472 host   # Linux",
                "ping -f -l 1472 host      # Windows"
              ],
              "note": "1472 payload + 28 header bytes = 1500"
            },
            {
              "type": "heading",
              "text": "3. Gotchas",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "VPN or tunnel overhead ==lowers MTU==",
                "Fix: ==MSS clamping== or a lower interface MTU"
              ],
              "style": "cross",
              "frame": "dashed",
              "ink": "red"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "PMTU black hole",
              "text": "Firewall blocks all ICMP: small requests work, large transfers ==hang==."
            }
          ]
        }
      ]
    },
