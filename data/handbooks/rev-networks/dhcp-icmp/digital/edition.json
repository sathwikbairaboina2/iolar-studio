    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "A tunnel on the path has MTU 1400. You run `ping -M do -s 1472 host`. What comes back?",
              "a_bullets": [
                "ICMP type 3 code 4 (Fragmentation Needed) carrying MTU 1400",
                "1472 + 28 = 1500 is over 1400, and DF forbids fragmenting",
                "If a firewall drops ICMP, you get silence: a PMTU black hole"
              ]
            },
            {
              "type": "qa",
              "q": "Traceroute shows hop 4 as `* * *`, but hops 5 and 6 reply. Is the path broken?",
              "a_bullets": [
                "No: hop 4 just did not answer (filtered or rate-limited)",
                "Traffic crossed it, because later hops respond"
              ]
            },
            {
              "type": "qa",
              "q": "A client holds a 24h lease. When does it renew, and who does it ask?",
              "a_bullets": [
                "At 12h (50%): unicast Request to the same server",
                "At 21h (87.5%): broadcast Request to any server"
              ]
            }
          ]
        }
      ]
    }
