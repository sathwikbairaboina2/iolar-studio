      "pages": [
        {
          "title": "Cheat Sheet: DHCP, ICMP and Path Tools",
          "blocks": [
            {
              "type": "heading",
              "text": "1. DORA and Leases",
              "ink": "green"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "Discover",
                    "sub": "broadcast",
                    "ink": "blue"
                  },
                  {
                    "text": "Offer",
                    "sub": "server proposes",
                    "ink": "green"
                  },
                  {
                    "text": "Request",
                    "sub": "broadcast",
                    "ink": "purple"
                  },
                  {
                    "text": "Ack",
                    "sub": "lease starts",
                    "ink": "orange"
                  }
                ]
              }
            },
            {
              "type": "bullets",
              "items": [
                "==UDP 67== server, ==68== client",
                "Renew (T1) at ==50%== of lease, unicast to the same server",
                "Rebind (T2) at ==87.5%==, broadcast to any server"
              ],
              "style": "dot"
            },
            {
              "type": "heading",
              "text": "2. ICMP Types and TTL",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "Type",
                "Meaning"
              ],
              "rows": [
                [
                  "0",
                  "Echo reply"
                ],
                [
                  "3",
                  "Unreachable"
                ],
                [
                  "3/4",
                  "==Fragmentation needed==, DF set"
                ],
                [
                  "5",
                  "Redirect"
                ],
                [
                  "8",
                  "Echo request"
                ],
                [
                  "11",
                  "Time exceeded"
                ]
              ]
            },
            {
              "type": "bullets",
              "items": [
                "TTL drops by 1 per router; at 0 the router sends ==Time Exceeded== (11)",
                "Traceroute raises TTL one at a time: 1, 2, 3..."
              ],
              "style": "dot"
            },
            {
              "type": "heading",
              "text": "3. Commands and Fixes",
              "ink": "purple"
            },
            {
              "type": "code",
              "lang": "bash",
              "lines": [
                "ping -c 4 host   # Windows: ping -n 4 host",
                "traceroute host  # Windows: tracert host",
                "mtr host",
                "ping -M do -s 1472 host  # 1472+28=1500"
              ],
              "note": "last line is the MTU test"
            },
            {
              "type": "bullets",
              "items": [
                "{red:169.254.x.x} address means ==DHCP failed==",
                "Ping the ==gateway==, then a ==remote IP==, then a ==name==",
                "Large transfers hang: check ==MTU== and ICMP filtering"
              ],
              "style": "number"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Mistake",
              "text": "No ping reply does not mean the host is down. Firewalls often drop ICMP echo."
            }
          ]
        }
      ]
