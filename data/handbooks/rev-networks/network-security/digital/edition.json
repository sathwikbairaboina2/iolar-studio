    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "heading",
              "text": "Check yourself",
              "ink": "blue"
            },
            {
              "type": "qa",
              "q": "A stateless NACL allows inbound TCP 443 and outbound TCP 443 only. Clients connect to your web server. What happens?",
              "a_bullets": [
                "Connections time out: replies leave from port 443 to the client's ==ephemeral port==.",
                "Outbound must allow 1024-65535; a stateful firewall would auto-allow the reply."
              ]
            },
            {
              "type": "qa",
              "q": "This rule is being debugged: `iptables -t nat -A PREROUTING -p tcp --dport 8080 -j DNAT --to 192.168.1.10:80`. It times out. Why?",
              "a_bullets": [
                "`net.ipv4.ip_forward` is 0, so the host never routes the packet.",
                "The FORWARD allow must match the translated target `192.168.1.10` port 80, not port 8080."
              ]
            },
            {
              "type": "qa",
              "q": "Peer A has AllowedIPs 10.0.0.0/24. You add peer B with the same range. Where does traffic for 10.0.0.5 go?",
              "a_bullets": [
                "Only to B: the last configured peer takes the range, so A silently loses it.",
                "A's packets with 10.0.0.x sources are dropped on arrival."
              ]
            }
          ]
        }
      ]
    }
