              ]
            },
            {
              "type": "bullets",
              "items": [
                "VPN = ==encrypted tunnel== over an untrusted network",
                "{blue:Full tunnel}: ==all traffic== goes through the VPN",
                "{green:Split tunnel}: only corporate subnets, rest direct",
                "Split = less load, ==weaker control=="
              ],
              "style": "dot",
              "ink": "green"
            },
            {
              "type": "heading",
