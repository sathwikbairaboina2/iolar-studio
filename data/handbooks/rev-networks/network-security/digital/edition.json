                  "L4-L7"
                ],
                [
                  "Ports",
                  "UDP 500, UDP 4500 (NAT-T), ESP",
                  "TCP/UDP 443"
                ],
                [
                  "Firewall/NAT",
                  "Needs NAT-T",
                  "Passes easily"
                ],
                [
                  "Best for",
                  "Site-to-site",
                  "Remote access"
                ],
                [
                  "Needs",
