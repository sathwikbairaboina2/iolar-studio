    {
      "title": "Firewalls: Stateless vs Stateful",
      "role": "outline",
      "outlineIndex": 0,
      "pages": [
        {
          "title": "Firewalls: Stateless vs Stateful",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Rule Matching",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "Rules are checked ==top to bottom==; the {green:first match wins}",
                "Nothing matches → ==default policy== applies (usually {red:deny})"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "Packet",
                    "ink": "blue"
                  },
                  {
                    "text": "Rule 1",
                    "sub": "match? act",
                    "ink": "green"
                  },
                  {
                    "text": "Rule 2",
                    "sub": "match? act",
                    "ink": "green"
                  },
                  {
                    "text": "Default",
                    "sub": "usually deny",
                    "ink": "red"
                  }
                ]
              }
            },
            {
              "type": "heading",
              "text": "2. Stateless vs Stateful",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "",
                "Stateless",
                "Stateful"
              ],
              "rows": [
                [
                  "Judges",
                  "each packet alone",
                  "connection state"
                ],
                [
                  "Looks at",
                  "src/dst IP, port, protocol, flags",
                  "5-tuple + NEW, ESTABLISHED, RELATED"
                ],
                [
                  "Replies",
                  "need an **explicit rule**",
                  "auto-allowed"
                ],
                [
                  "Cost",
                  "fast, simple, weak",
                  "smarter, more memory"
                ],
                [
                  "Used in",
                  "router ACLs, AWS NACLs",
                  "iptables/nftables conntrack, AWS security groups"
                ]
              ],
              "highlightRow": 2
            },
            {
              "type": "bullets",
              "items": [
                "Stateful keeps a ==conntrack table==",
                "Allowed outbound flow → its reply is let in"
              ],
              "style": "check"
            },
            {
              "type": "heading",
              "text": "3. Mistakes",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "Stateless: inbound `443` allowed, no outbound ephemeral ports `1024-65535` → replies dropped",
                "Allow rule placed after a broad deny → ==never matches=="
              ],
              "style": "cross",
              "frame": "dashed",
              "ink": "red"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Remember",
              "text": "Stateless needs a **return rule**; stateful tracks the connection. Order rules specific first, broad last."
            }
          ]
        }
      ]
    },
    {
      "title": "NAT and Port Forwarding",
      "role": "outline",
      "outlineIndex": 1,
      "pages": [
        {
          "title": "NAT and Port Forwarding",
          "blocks": [
            {
              "type": "heading",
              "text": "1. What NAT Does",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "==NAT== rewrites IP addresses in packet headers",
                "Private RFC1918: `10/8`, `172.16/12`, `192.168/16`",
                "Private hosts reach the internet via public IPs"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "table",
              "headers": [
                "Type",
                "Mapping"
              ],
              "rows": [
                [
                  "**Static NAT**",
                  "1:1, one private to one public"
                ],
                [
                  "**Dynamic NAT**",
                  "pool of public IPs"
                ],
                [
                  "**PAT / overload**",
                  "many hosts, one public IP, split by ==source port=="
                ]
              ]
            },
            {
              "type": "heading",
              "text": "2. SNAT and DNAT",
              "ink": "blue"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "Inside host",
                    "sub": "192.168.1.10",
                    "ink": "blue"
                  },
                  {
                    "text": "SNAT",
                    "sub": "source rewritten",
                    "ink": "orange"
                  },
                  {
                    "text": "NAT table",
                    "sub": "remembers mapping",
                    "ink": "purple"
                  },
                  {
                    "text": "Reply",
                    "sub": "translated back",
                    "ink": "green"
                  }
                ]
              }
            },
            {
              "type": "bullets",
              "items": [
                "{orange:SNAT / masquerade}: rewrites the source on outbound",
                "Port forwarding = {blue:DNAT}: `public_ip:8080` becomes `192.168.1.10:80`",
                "Also needs a FORWARD allow and ==ip_forward=1=="
              ],
              "style": "dot"
            },
            {
              "type": "code",
              "lang": "bash",
              "lines": [
                "iptables -t nat -A PREROUTING -p tcp --dport 8080 \\",
                "  -j DNAT --to 192.168.1.10:80",
                "sysctl -w net.ipv4.ip_forward=1"
              ]
            },
            {
              "type": "heading",
              "text": "3. Mistakes",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "Treating NAT as security: the ==stateful filter== protects",
                "Forgetting `net.ipv4.ip_forward=1`",
                "No hairpin NAT: inside clients miss the public IP",
                "NAT breaks end-to-end protocols such as IPsec AH"
              ],
              "style": "cross",
              "frame": "dashed",
              "ink": "red"
            }
          ]
        }
      ]
    },
    {
      "title": "DMZ and Network Segmentation",
      "role": "outline",
      "outlineIndex": 2,
      "pages": [
        {
          "title": "DMZ and Network Segmentation",
          "blocks": [
            {
              "type": "heading",
              "text": "1. What a DMZ is",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "==DMZ== = separate subnet for **public-facing** servers",
                "Holds web, mail, reverse proxy",
                "A compromise stays there, not in the {green:internal LAN}"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "heading",
              "text": "2. Designs and rules",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "Design",
                "Layout",
                "Trade-off"
              ],
              "rows": [
                [
                  "**Three-legged**",
                  "One firewall: outside, DMZ, inside",
                  "Cheaper, single point"
                ],
                [
                  "**Dual firewall**",
                  "External FW, DMZ, internal FW",
                  "Stronger, costs more"
                ]
              ],
              "frame": "dashed"
            },
            {
              "type": "table",
              "headers": [
                "From → To",
                "Rule"
              ],
              "rows": [
                [
                  "Internet → DMZ",
                  "{green:Only needed ports}"
                ],
                [
                  "Inside → DMZ",
                  "{green:Allowed}"
                ],
                [
                  "DMZ → Inside",
                  "{red:Denied} or one port (app → DB)"
                ],
                [
                  "DMZ → Internet",
                  "{orange:Restricted}"
                ]
              ],
              "highlightRow": 2
            },
            {
              "type": "heading",
              "text": "3. Mistakes",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "Database placed **in** the DMZ",
                "Broad DMZ-to-LAN rules",
                "Flat DMZ: no isolation between DMZ servers",
                "Home-router 'DMZ host' forwards ==all ports== to one device"
              ],
              "style": "cross",
              "frame": "dashed",
              "ink": "red"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Remember",
              "text": "Router 'DMZ host' is **not** a real DMZ: no segmentation. The database stays ==inside==."
            }
          ]
        }
      ]
    },
