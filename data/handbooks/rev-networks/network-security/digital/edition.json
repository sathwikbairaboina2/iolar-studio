    {
      "title": "WireGuard Basics",
      "role": "outline",
      "outlineIndex": 4,
      "pages": [
        {
          "title": "WireGuard Basics",
          "blocks": [
            {
              "type": "heading",
              "text": "1. What It Is",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "Small, fast ==L3 VPN== in the Linux kernel",
                "Runs over ==UDP==; fixed crypto: Curve25519, ChaCha20-Poly1305",
                "{green:No cipher negotiation}, so no proposals to mismatch"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "heading",
              "text": "2. Keys and AllowedIPs",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "Keypair: `wg genkey | tee private.key | wg pubkey > public.key`",
                "Peers trust each other by swapping ==public keys== only",
                "Never share the **private key**",
                "==AllowedIPs== = outgoing routing table + incoming source filter",
                "`0.0.0.0/0` means a ==full tunnel=="
              ],
              "style": "dot"
            },
            {
              "type": "heading",
              "text": "3. Config and Commands",
              "ink": "purple"
            },
            {
              "type": "code",
              "lang": "ini",
              "lines": [
                "[Interface]",
                "PrivateKey = <private key>",
                "Address = 10.0.0.2/24",
                "ListenPort = 51820"
              ]
            },
            {
              "type": "code",
              "lang": "ini",
              "lines": [
                "[Peer]",
                "PublicKey = <peer public key>",
                "Endpoint = host:51820",
                "AllowedIPs = 10.0.0.0/24",
                "PersistentKeepalive = 25"
              ],
              "note": "keepalive 25: use it behind NAT"
            },
            {
              "type": "bullets",
              "items": [
                "`wg-quick up wg0` and `wg-quick down wg0`",
                "`wg show`: check the ==latest handshake=="
              ],
              "style": "check"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Mistakes",
              "text": "Overlapping ==AllowedIPs== between peers, UDP port closed, wrong public key, no `ip_forward` on a gateway."
            }
          ]
        }
      ]
    },
