              ],
              "style": "dot"
            },
            {
              "type": "heading",
              "text": "3. Common Mistakes",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "Mismatched IKE or phase-2 proposals, or pre-shared keys",
                "Overlapping subnets at both sites",
                "Blocking ESP or UDP 500/4500",
                "MTU/MSS problems"
              ],
              "style": "cross",
              "ink": "red"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "MTU fix",
              "text": "Tunnel overhead shrinks packets: ==lower the MTU== or **clamp MSS**."
            }
          ]
        }
      ]
