                "to": "c2_0"
              }
            ]
          }
        },
        {
          "type": "callout",
          "style": "tip",
          "title": "Not The Same As Replication",
          "text": "A replica protects against host loss; persistence protects against restart amnesia. Production wants both."
        },
        {
          "type": "sidebox",
          "title": "Replicas Copy Bugs Too",
          "items": [
            "A stray `FLUSHALL` replicates instantly",
            "An hour-old `dump.rdb` still holds the data",
            "Backups beat replicas for human error"
          ]
        },
        {
          "type": "heading",
          "text": "Reading The State"
        },
        {
          "type": "code",
          "lang": "bash",
          "lines": [
            "redis-cli INFO persistence",
            "# rdb_*  aof_*  loading",
            "# rdb_last_bgsave_status, aof_last_write_status",
            "# one command, every state in this handbook"
          ]
        },
        {
          "type": "callout",
          "style": "takeaway",
          "title": "Pick By Need",
          "text": "RDB for backups and fast restarts, AOF for a low RPO, both for production."
        }
      ]
    },
    {
      "page_title": "Zero Persistence, Guards & Myths",
      "blocks": [
        {
          "type": "sidebox",
          "title": "Zero Persistence Is Legit",
          "items": [
            "`save \"\"` plus `appendonly no`",
            "Cache-only nodes are rebuildable by design",
            "Only when a real system of record sits behind"
          ]
        },
        {
          "type": "qa",
          "q": "\"We run an AOF, so we're durable\" — true?",
          "a_bullets": [
            "False until you also state `appendfsync`",
            "`appendfsync no` can lose ~30s on a host crash",
            "A durability claim needs a policy plus a failure class"
          ]
        },
        {
          "type": "heading",
          "text": "Which Guard Stops Which Loss"
        },
        {
          "type": "table",
          "headers": [
            "Guard",
            "Process crash",
            "Host crash",
            "Disk loss"
          ],
          "rows": [
            [
              "`write()` only",
              "safe",
              "lost",
              "lost"
            ],
            [
              "`fsync()`",
              "safe",
              "safe",
              "lost"
            ],
            [
              "Replica",
              "safe",
              "safe",
              "safe"
            ],
            [
              "Offsite RDB",
              "to snapshot",
              "to snapshot",
              "to snapshot"
            ]
          ]
        },
        {
          "type": "heading",
          "text": "Cache-Only Config"
        },
        {
          "type": "code",
          "lang": "conf",
          "lines": [
            "save \"\"          # no snapshots",
            "appendonly no    # no command log",
            "# restart = empty, warm from DB"
          ],
          "note": "only with a real system of record"
        },
        {
          "type": "heading",
          "text": "Myths To Kill Early"
        },
        {
          "type": "bullets",
          "items": [
            "\"A replica is a backup\" — it copies mistakes too",
            "\"The reply means it's on disk\" — ACK comes first",
            "\"AOF means zero loss\" — only with a stated fsync"
          ],
          "style": "cross"
        }
      ]
    },
    {
      "page_title": "RDB Snapshots: What & How",
      "blocks": [
        {
          "type": "heading",
          "text": "What An RDB Is",
          "ink": "blue"
        },
        {
          "type": "bullets",
          "items": [
            "Compact binary dump of the whole keyspace",
            "Point-in-time: one instant, one file",
            "Default `dump.rdb`, written inside `dir`",
            "Versioned, self-describing, CRC64 trailer"
          ]
        },
        {
          "type": "code",
          "lang": "conf",
          "lines": [
            "dbfilename dump.rdb   # names the file",
            "dir /var/lib/redis    # Redis chdir()s here",
            "rdbcompression yes    # LZF strings, cheap CPU",
            "rdbchecksum yes       # CRC64, independent knob"
          ]
        },
        {
          "type": "heading",
          "text": "SAVE vs BGSAVE"
        },
        {
          "type": "diagram",
          "kind": "cards",
          "spec": {
            "cards": [
              {
                "title": "`SAVE`",
                "lines": [
                  "Main thread",
                  "Blocks every client",
                  "Scripts, shutdown only"
                ]
              },
              {
                "title": "`BGSAVE`",
                "lines": [
                  "Forks a child",
                  "Parent keeps serving",
                  "The normal path"
                ]
              }
            ]
          }
        },
        {
          "type": "heading",
          "text": "Automatic Triggers"
        },
        {
          "type": "code",
          "lang": "conf",
          "lines": [
            "save 900 1       # 1 change in 15 min",
            "save 300 10      # 10 changes in 5 min",
            "save 60 10000    # 10k changes in 1 min",
            "save \"\"          # disables all of them"
          ]
        },
        {
          "type": "bullets",
          "items": [
            "`CONFIG SET save \"\"` does it at runtime",
            "Implicit BGSAVE on `SHUTDOWN` if saves configured",
            "Also on `DEBUG RELOAD` and full replica sync"
          ]
        },
        {
          "type": "heading",
          "text": "Atomic On Disk"
        },
        {
          "type": "diagram",
          "kind": "flow",
          "spec": {
            "nodes": [
              "fork child",
              "write temp file",
              "checksum",
              "rename() over dump.rdb"
            ]
          }
        },
        {
          "type": "callout",
          "style": "tip",
          "title": "Never A Half File",
          "text": "Readers see the old snapshot or the new one. `rename()` is atomic, so a backup copy needs no locking."
        },
        {
          "type": "heading",
          "text": "Watching A Save Land"
        },
        {
          "type": "code",
          "lang": "bash",
          "lines": [
            "redis-cli LASTSAVE     # unix ts of last success",
            "redis-cli INFO persistence",
            "# rdb_bgsave_in_progress, rdb_last_save_time",
            "# rdb_last_bgsave_status, rdb_changes_since_last_save"
          ]
        }
      ]
    },
    {
      "page_title": "Validating & Backing Up RDB Files",
      "blocks": [
        {
          "type": "sidebox",
          "title": "Backup Recipe",
          "items": [
            "Poll `LASTSAVE` until it advances",
            "`redis-check-rdb dump.rdb` before trusting it",
            "`cp dump.rdb snap-2026-09-07.rdb`",
            "One immutable file — ship it anywhere"
          ]
        },
        {
          "type": "heading",
          "text": "Validate Before You Ship"
        },
        {
          "type": "code",
          "lang": "bash",
          "lines": [
            "redis-check-rdb dump.rdb",
            "# checks format + CRC64 trailer",
            "# fails loudly on a bad file"
          ],
          "note": "a corrupt RDB never partially loads"
        },
        {
          "type": "callout",
          "style": "sticky",
          "title": "Copy The Right File",
          "text": "Copy `dump.rdb`, never the `temp-*.rdb` a running child is still writing."
        }
      ]
    },
    {
      "page_title": "Fork, Copy-on-Write & Snapshot Cost",
      "blocks": [
        {
          "type": "heading",
          "text": "What fork() Actually Does",
          "ink": "blue"
        },
        {
          "type": "bullets",
          "items": [
            "Child gets a logical copy of parent memory",
            "Pages are shared and marked read-only",
            "No data bytes copied — only page tables"
          ]
        },
        {
          "type": "heading",
          "text": "The Copy-On-Write Tax"
        },
        {
          "type": "diagram",
          "kind": "array",
          "spec": {
            "cells": [
              "r/o",
              "r/o",
              "WRITE",
              "copied 4KB",
              "r/o",
              "r/o"
            ],
            "indices": true,
            "pointers": [],
            "highlight": [],
            "dim": [],
            "caption": "shared pages after fork"
          }
        },
        {
          "type": "bullets",
          "items": [
            "Parent mutates a shared page: kernel copies 4KB",
            "Memory grows with write rate, not dataset size",
            "Worst case a BGSAVE doubles RSS — keep headroom",
            "`rdb_last_cow_size` = bytes copied last BGSAVE"
          ]
        },
        {
          "type": "heading",
          "text": "The Fork Stall"
        },
        {
          "type": "table",
          "headers": [
            "Dataset",
            "Page table copy",
            "Felt as"
          ],
          "rows": [
            [
              "1 GB",
              "~10-20 ms",
              "latency spike"
            ],
            [
              "8 GB",
              "~80-160 ms",
              "p99 blowup"
            ],
            [
              "THP on",
              "2 MB per copy",
              "hundreds of ms"
            ]
          ]
        },
        {
          "type": "bullets",
          "items": [
            "Stall scales with dataset size, not write rate",
            "`INFO stats` `latest_fork_usec` = exact last stall",
            "Alert on it — that number is your fork budget"
          ]
        },
        {
          "type": "heading",
          "text": "Host Prep, Two Lines"
        },
        {
          "type": "code",
          "lang": "bash",
          "lines": [
            "echo never > /sys/kernel/mm/transparent_hugepage/enabled",
            "sysctl -w vm.overcommit_memory=1",
            "# THP off: COW copies 4KB pages, not 2MB",
            "# overcommit 1: fork() survives RSS+COW > RAM"
          ]
        },
        {
          "type": "callout",
          "style": "cloud",
          "title": "Redis Warns You At Boot",
          "text": "The THP warning in the log is not cosmetic. Leaving it on is the classic source of mystery spikes during saves."
        },
        {
          "type": "sidebox",
          "title": "When Fork Fails",
          "items": [
            "`rdb_last_bgsave_status:err` appears",
            "`stop-writes-on-bgsave-error yes` then rejects writes",
            "Client sees `MISCONF`, not silent loss"
          ]
        },
        {
          "type": "heading",
          "text": "One Child At A Time"
        },
        {
          "type": "bullets",
          "items": [
            "BGSAVE, AOF rewrite and disk replica sync all fork",
            "Same COW tax applies to all three",
            "A BGSAVE asked for during a rewrite is deferred",
            "Watch `rdb_bgsave_scheduled:1`"
          ]
        },
        {
          "type": "sidebox",
          "title": "Lowering The Bill",
          "items": [
            "Shard into smaller instances",
            "Fewer `save` points",
            "Run snapshots on a replica, not the primary",
            "Keep `maxmemory` well under RAM"
          ]
        }
      ]
    },
    {
      "page_title": "AOF: The Append-Only Log",
      "blocks": [
        {
          "type": "heading",
          "text": "A Log Of Mutations",
          "ink": "blue"
        },
        {
          "type": "bullets",
          "items": [
            "Every write command appended in RESP wire format",
            "Logged after execution — only successful mutations",
            "Append-only: no seeks, no in-place edits",
            "So a truncated tail is the only realistic corruption"
          ]
        },
        {
          "type": "code",
          "lang": "conf",
          "lines": [
            "appendonly yes",
            "appendfilename \"appendonly.aof\"",
            "appenddirname \"appendonlydir\"   # Redis 7+"
          ]
        },
        {
          "type": "heading",
          "text": "Commands Get Normalised"
        },
        {
          "type": "table",
          "headers": [
            "You ran",
            "AOF stores",
            "Why"
          ],
          "rows": [
            [
              "`SPOP s`",
              "`SREM s m`",
              "random pick"
            ],
            [
              "`EXPIRE k 60`",
              "`PEXPIREAT k <ms>`",
              "absolute time"
            ],
            [
              "`INCRBYFLOAT k .1`",
              "`SET k <result>`",
              "float drift"
            ]
          ]
        },
        {
          "type": "callout",
          "style": "tip",
          "title": "Replay Must Be Deterministic",
          "text": "Rewriting non-deterministic commands before logging is what makes a replay land on the exact same dataset."
        },
        {
          "type": "heading",
          "text": "Two Writes Per Command"
        },
        {
          "type": "diagram",
          "kind": "flow",
          "spec": {
            "nodes": [
              "command",
              "AOF buffer",
              "write() page cache",
              "fsync() platter"
            ]
          }
        },
        {
          "type": "bullets",
          "items": [
            "Buffer flushes once per event-loop pass (`beforeSleep`)",
            "Not once per command — the batching is deliberate",
            "`write()` and `fsync()` are separate steps",
            "That split is the whole durability story"
          ]
        },
        {
          "type": "heading",
          "text": "Recovery Is A Replay"
        },
        {
          "type": "bullets",
          "items": [
            "Redis starts a fake client on boot",
            "Feeds the log back command by command",
            "`aof-load-truncated yes` (default) tolerates a cut tail",
            "It warns and keeps appending instead of refusing"
          ]
        },
        {
          "type": "heading",
          "text": "Keeping It From Growing"
        },
        {
          "type": "code",
          "lang": "conf",
          "lines": [
            "auto-aof-rewrite-percentage 100  # doubled since base",
            "auto-aof-rewrite-min-size 64mb   # and past this floor",
            "# manual kick: redis-cli BGREWRITEAOF"
          ]
        },
        {
          "type": "callout",
          "style": "sticky-pink",
          "title": "The Empty-Boot Trap",
          "text": "Flip `appendonly yes` in the file and restart with no AOF: Redis ignores `dump.rdb` and boots empty."
        }
      ]
    },
    {
      "page_title": "AOF Replay Cost, Repair & Safe Enable",
      "blocks": [
        {
          "type": "heading",
          "text": "Replay Has A Price"
        },
        {
          "type": "bullets",
          "items": [
            "Plain AOF re-runs every command through the dispatcher",
            "So restart is far slower than an RDB load",
            "Hybrid RDB base fixes most of that cost"
          ]
        },
        {
          "type": "sidebox",
          "title": "INFO Keys To Know",
          "items": [
            "`aof_enabled`, `aof_rewrite_in_progress`",
            "`aof_last_bgrewrite_status`, `aof_last_write_status`",
            "`aof_current_size` vs `aof_base_size`"
          ]
        },
        {
          "type": "qa",
          "q": "Safe to switch AOF on in a live server?",
          "a_bullets": [
            "`CONFIG SET appendonly yes` — it does not block",
            "It kicks off a background rewrite to build the base",
            "`redis-check-aof --fix` truncates a bad trailing command"
          ]
        },
        {
          "type": "heading",
          "text": "Where The Damage Sits"
        },
        {
          "type": "table",
          "headers": [
            "Damage",
            "On boot",
            "Fix"
          ],
          "rows": [
            [
              "Cut tail",
              "loads, warns",
              "none needed"
            ],
            [
              "Bad middle",
              "Redis exits",
              "`--fix`"
            ],
            [
              "After `--fix`",
              "loads",
              "data past cut lost"
            ]
          ]
        },
        {
          "type": "heading",
          "text": "Enable AOF Safely"
        },
        {
          "type": "bullets",
          "items": [
            "Boot with RDB only so `dump.rdb` loads",
            "`CONFIG SET appendonly yes` at runtime",
            "Wait for `aof_rewrite_in_progress:0`",
            "`CONFIG REWRITE` to persist the change"
          ],
          "style": "number"
        }
      ]
    },
    {
      "page_title": "fsync Policies: The Durability Dial",
      "blocks": [
        {
          "type": "heading",
          "text": "Exactly Three Settings",
          "ink": "blue"
        },
        {
          "type": "table",
          "headers": [
            "`appendfsync`",
            "Loss window",
            "Throughput"
          ],
          "rows": [
            [
              "`always`",
              "~1 command",
              "<10k ops/s"
            ],
            [
              "`everysec`",
              "~1-2 s",
              "near full"
            ],
            [
              "`no`",
              "~30 s",
              "fastest"
            ]
          ]
        },
        {
          "type": "bullets",
          "items": [
            "`everysec` is the default and the sane one",
            "`always` fsyncs before replying to the client",
            "`no` leaves it to kernel dirty-page writeback"
          ]
        },
        {
          "type": "heading",
          "text": "The Distinction That Matters"
        },
        {
          "type": "diagram",
          "kind": "cards",
          "spec": {
            "cards": [
              {
                "title": "`write()` saves you from",
                "lines": [
                  "redis-server crash",
                  "`kill -9`",
                  "OOM killer"
                ]
              },
              {
                "title": "`fsync()` saves you from",
                "lines": [
                  "kernel panic",
                  "power cut",
                  "host loss"
                ]
              }
            ]
          }
        },
        {
          "type": "callout",
          "style": "takeaway",
          "title": "Process Kill Is Cheap",
          "text": "Even `appendfsync no` loses nothing when only redis-server dies — the kernel still owns the buffer."
        },
        {
          "type": "heading",
          "text": "everysec Is Really 2s"
        },
        {
          "type": "bullets",
          "items": [
            "A background thread fsyncs once a second",
            "If that thread is still busy, the main thread waits",
            "Documented delay of up to another second",
            "Budget 2s of loss, not 1s"
          ]
        },
        {
          "type": "heading",
          "text": "Rewrites Fight The Disk"
        },
        {
          "type": "code",
          "lang": "conf",
          "lines": [
            "no-appendfsync-on-rewrite yes",
            "# main AOF fsync paused while a child writes",
            "# = appendfsync no for the whole rewrite window",
            "# buys latency, sells durability. Know it first."
          ]
        },
        {
          "type": "sidebox",
          "title": "Hardware Tells Lies",
          "items": [
            "fsync hits the platter only if write cache is off",
            "...or battery / capacitor backed",
            "Consumer SSDs report success early",
            "EBS and PD fsync sits in the low milliseconds"
          ]
        },
        {
          "type": "callout",
          "style": "cloud",
          "title": "One Node Is Never Enough",
          "text": "`always` on a single box still dies with the box. Cross-machine durability needs a replica plus `WAITAOF`."
        },
        {
          "type": "callout",
          "style": "takeaway",
          "title": "Pay For always Selectively",
          "text": "Run `everysec` globally and add `WAITAOF 1 1 <ms>` only on writes that truly cannot be lost."
        }
      ]
    },
    {
      "page_title": "WAITAOF, the Durability Ladder & Disks",
      "blocks": [
        {
          "type": "heading",
          "text": "Per-Write Durability"
        },
        {
          "type": "code",
          "lang": "bash",
          "lines": [
            "SET order:9 paid",
            "WAITAOF 1 1 100   # 1 local fsync, 1 replica, 100ms",
            "WAIT 1 100        # replication only, NOT fsync",
            "# 7.2+; confusing the two is a real outage"
          ]
        },
        {
          "type": "heading",
          "text": "The Durability Ladder"
        },
        {
          "type": "diagram",
          "kind": "chain",
          "spec": {
            "title": "weakest → strongest",
            "steps": [
              {
                "text": "no persistence",
                "note": "restart = empty"
              },
              {
                "text": "RDB",
                "note": "minutes lost"
              },
              {
                "text": "AOF everysec",
                "note": "~1-2 s lost"
              },
              {
                "text": "AOF always",
                "note": "~1 command"
              },
              {
                "text": "always + WAITAOF",
                "note": "survives host loss",
                "ink": "green"
              }
            ]
          }
        },
        {
          "type": "heading",
