              "Codis",
              "in the proxy",
              "extra hop, extra ops"
            ],
            [
              "Cluster",
              "in the server",
              "cross-slot ops"
            ]
          ]
        },
        {
          "type": "paragraph",
          "text": "Cluster is shared-nothing: each master owns a disjoint subset of the keyspace. A write needs zero cross-node coordination."
        },
        {
          "type": "heading",
          "text": "Sizing The Minimum"
        },
        {
          "type": "bullets",
          "items": [
            "3 masters + 3 replicas = 6 nodes, minimum",
            "3 masters alone cannot survive one failure",
            "Failure detection needs > half the masters alive",
            "2 masters give no majority after one dies"
          ]
        },
        {
          "type": "code",
          "lang": "bash",
          "lines": [
            "redis-cli --cluster create \\",
            "  10.0.0.{1,2,3,4,5,6}:6379 \\",
            "  --cluster-replicas 1   # 3 M + 3 R"
          ],
          "runnable": false
        },
        {
          "type": "callout",
          "style": "takeaway",
          "title": "CAP Position",
          "text": "Cluster keeps the majority partition available and can lose acknowledged writes. It is NOT a CP store — do not treat it as one."
        },
        {
          "type": "sidebox",
          "title": "What Cluster Takes Away",
          "items": [
            "No multi-key ops across slots",
            "No SELECT, database 0 only",
            "No cross-slot transactions",
            "Cluster-aware client mandatory"
