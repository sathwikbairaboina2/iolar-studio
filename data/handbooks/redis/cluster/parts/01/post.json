          "type": "heading",
          "text": "The Fixed Keyspace",
          "ink": "blue"
        },
        {
          "type": "bullets",
          "items": [
            "Keyspace splits into exactly 16384 slots, 0..16383",
            "`slot = CRC16(key) mod 16384`",
            "CRC16 variant is XMODEM/CCITT",
            "Polynomial `0x1021`, init `0x0000`"
          ]
        },
        {
          "type": "code",
          "lang": "bash",
          "lines": [
            "CLUSTER GETKEYSINSLOT 99 100",
            "MIGRATE h p \"\" 0 5000 KEYS k1 k2",
            "CLUSTER SETSLOT 99 NODE <dst-id>",
            "# run SETSLOT NODE on both, then peers"
          ],
          "runnable": false
        }
      ]
