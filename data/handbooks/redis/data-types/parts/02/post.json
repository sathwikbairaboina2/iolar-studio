      "page_title": "Decision Rules & Type Comparison",
      "blocks": [
        {
          "type": "bullets",
          "items": [
            "Need uniqueness? Yes → set or sorted set. No → list or string",
            "Need order? Insertion → list. Score → sorted set. None → set or hash",
            "Address parts independently? Yes → hash. No → string"
          ]
        },
        {
