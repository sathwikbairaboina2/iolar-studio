              "RDB snapshot",
              "recent writes"
            ],
            [
              "AOF everysec",
              "up to 1s"
            ],
            [
              "appendfsync always",
              "none, but slow"
            ]
          ]
        },
        {
          "type": "bullets",
          "items": [
            "A successful EXEC only means: ran in memory, on the primary",
            "Replication is async by default — failover can drop an acked EXEC",
            "`WAIT numreplicas timeout` improves the odds, is not consensus",
            "Cluster gives no cross-slot atomicity — plan hash tags up front"
          ]
        },
        {
          "type": "callout",
          "style": "cloud",
          "title": "Final Warning",
          "text": "Atomic is not durable, and single-node atomic is not distributed atomic."
