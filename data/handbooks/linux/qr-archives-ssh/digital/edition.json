    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "You run `tar -czf project/ backup.tar.gz`. What happens?",
              "a_bullets": [
                "tar tries to open `project/` as the archive and fails with `Is a directory`",
                "`backup.tar.gz` is then a member to add; it doesn't exist, so that fails too",
                "Real overwrite risk: if the misplaced name is a file, `tar -czf notes.txt backup.tar.gz` clobbers notes.txt"
              ]
            },
            {
              "q": "You run `gzip app.log`, then `grep ERROR app.log`. What do you get, and why?",
              "type": "qa",
              "a_bullets": [
                "`No such file`: gzip replaced app.log with `app.log.gz`",
                "Search it with `zgrep ERROR app.log.gz`, or use `gzip -k` to keep the original"
              ]
            },
            {
              "type": "qa",
              "q": "`src/` holds index.html. Where does it land with `rsync -avz src/ prod:/srv/app/`, and without the slash on `src`?",
              "a_bullets": [
                "With `src/`: `/srv/app/index.html`, because only the contents are copied",
                "Without it: `/srv/app/src/index.html`, because the folder itself is copied"
              ]
            }
          ]
        }
      ]
    }
  ]
