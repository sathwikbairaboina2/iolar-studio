    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "`f='my file.txt'; rm $f` — what does `rm` receive, and what is the fix?",
              "a_bullets": [
                "Two arguments: `my` and `file.txt`",
                "Unquoted expansion is word-split",
                "Fix: `rm \"$f\"`"
              ]
            },
            {
              "type": "qa",
              "q": "What does `false | true; echo $?` print without `pipefail`, and with it?",
              "a_bullets": [
                "`0` without: the pipeline takes the last stage's status",
                "`1` with `set -o pipefail`: any failing stage fails the pipe"
              ]
            },
            {
              "type": "qa",
              "q": "Under `set -e`, `[ -f nope ] && echo yes` is followed by `echo done`. Does the script stop?",
              "a_bullets": [
                "No, it prints `done`",
                "A failing non-last command in an `&&` list does not trigger `set -e`"
              ]
            }
          ]
        }
      ]
