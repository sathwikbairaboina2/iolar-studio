    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "What does this print?",
              "example_code": [
                "sleep 60 &",
                "kill -9 $!",
                "wait $!",
                "echo $?"
              ],
              "a_bullets": [
                "`137`",
                "128 + 9, because SIGKILL is signal 9"
              ]
            },
            {
              "type": "qa",
              "q": "You edited app.service and ran `systemctl restart app`, but the old behaviour remains. What did you miss?",
              "a_bullets": [
                "`systemctl daemon-reload`",
                "Without it, systemd keeps the old unit definition"
              ]
            },
            {
              "type": "qa",
              "q": "`ps aux | grep nginx` shows a line, yet nginx is not running. Why?",
              "a_bullets": [
                "grep matches its own command line",
                "Use `grep [n]ginx` or `pgrep -a nginx`"
              ]
            }
          ]
        }
      ]
