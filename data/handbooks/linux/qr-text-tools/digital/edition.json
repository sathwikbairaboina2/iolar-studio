                [
                  "`wc -w`",
                  "words"
                ],
                [
                  "`wc -c`",
                  "bytes"
                ],
                [
                  "`head -n 5`",
                  "first 5 lines"
                ],
                [
                  "`tail -n 5`",
                  "last 5 lines"
                ],
                [
                  "`tail -n +2`",
                  "skips the header"
                ],
                [
                  "`tail -f`",
                  "follows a growing file"
                ]
              ]
            },
            {
