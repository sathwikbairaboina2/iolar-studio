              "type": "bullets",
              "items": [
                "`cut -d, -f1,3` picks ==fields== 1 and 3, comma-delimited",
                "`cut -c1-5` picks ==characters== 1 to 5",
                "Default `cut` delimiter is a ==TAB=="
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "table",
              "headers": [
                "sort flag",
                "Effect"
