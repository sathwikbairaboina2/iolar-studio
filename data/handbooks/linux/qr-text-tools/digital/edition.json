              "rows": [
                [
                  "`-n`",
                  "numeric"
                ],
                [
                  "`-r`",
                  "reverse"
                ],
                [
                  "`-k2`",
                  "by field 2"
                ],
                [
                  "`-t,`",
                  "set delimiter"
                ],
                [
                  "`-u`",
                  "unique lines"
                ],
                [
                  "none",
                  "{red:lexical}: 10 before 2"
                ]
              ]
            },
            {
              "type": "heading",
              "text": "2. Collapse and count",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
