      "pages": [
        {
          "title": "Streams, Pipes and Redirection Model",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Streams and Pipes",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "{blue:stdin} = ==fd 0==, {green:stdout} = ==fd 1==, {red:stderr} = ==fd 2==",
                "A ==filter== reads stdin and writes stdout",
                "`a | b` wires a's stdout to b's stdin",
                "Both run ==at the same time==",
                "Only stdout travels; stderr still hits the terminal"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "heading",
              "text": "2. Redirection",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "Operator",
                "Effect"
              ],
              "rows": [
                [
                  "`>`",
                  "**truncate** and write a file"
                ],
                [
                  "`>>`",
                  "**append** to a file"
                ],
                [
                  "`<`",
                  "feed a file to stdin"
                ],
                [
                  "`2>file`",
                  "stderr to file"
                ],
                [
                  "`2>&1`",
                  "merge stderr into stdout"
                ],
                [
                  "`&>file`",
                  "both streams to file (bash)"
                ]
              ]
            },
            {
              "type": "code",
              "lang": "bash",
              "lines": [
                "cmd >f 2>&1   # works: both in f",
                "cmd 2>&1 >f   # stderr stays on screen"
              ],
              "note": "order matters"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Left to right",
              "text": "`2>&1` copies where stdout points ==at that moment==."
            },
            {
              "type": "heading",
              "text": "3. Gotcha",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "`sort f > f` ==empties f== before sort reads it"
              ],
              "style": "cross",
              "ink": "red"
            },
            {
              "type": "code",
              "lang": "bash",
              "lines": [
                "sort -o f f",
                "sort f > tmp && mv tmp f"
              ],
              "note": "safe: -o or a temp file"
            }
          ]
        }
      ]
    },
    {
      "title": "Searching with grep and Regex Basics",
      "role": "outline",
      "outlineIndex": 1,
      "pages": [
        {
          "title": "Searching with grep and Regex Basics",
          "blocks": [
            {
              "type": "heading",
              "text": "1. grep Basics",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "`grep PATTERN file` prints ==matching lines=="
              ],
              "style": "dot"
            },
            {
              "type": "table",
              "headers": [
                "Flag",
                "Effect"
              ],
              "rows": [
                [
                  "`-i`",
                  "ignore case"
                ],
                [
                  "`-v`",
                  "invert: non-matching lines"
                ],
                [
                  "`-n`",
                  "line numbers"
                ],
                [
                  "`-c`",
                  "count matching lines"
                ],
                [
                  "`-r`",
                  "recursive"
                ],
                [
                  "`-l`",
                  "filenames only"
                ]
              ]
            },
            {
              "type": "heading",
              "text": "2. Regex Building Blocks",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "Token",
                "Matches"
              ],
              "rows": [
                [
                  "`^` / `$`",
                  "start / end of line"
                ],
                [
                  "`.`",
                  "any one character"
                ],
                [
                  "`*`",
                  "zero or more of the previous item"
                ],
                [
                  "`[abc]`",
                  "one of a, b, c"
                ],
                [
                  "`[^abc]`",
                  "none of a, b, c"
                ],
                [
                  "`[0-9]`, `[[:digit:]]`",
                  "a digit (POSIX class)"
                ]
              ]
            },
            {
              "type": "bullets",
              "items": [
                "`\\d`-style shortcuts work only with {red:-P}",
                "Plain grep (BRE) needs `\\+ \\? \\| \\( \\)`",
                "==grep -E== takes `+ ? | ( )` unescaped: use it by default"
              ],
              "style": "check",
              "ink": "blue"
            },
            {
              "type": "heading",
              "text": "3. Gotchas",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "`-F` literal text, `-w` whole words, `-o` only the match"
              ],
              "style": "cross",
              "ink": "red"
            },
            {
              "type": "code",
              "lang": "bash",
              "lines": [
                "grep -E 'ab+|cd' f",
                "grep -F 'a.b' f",
                "grep -w 'cat' f",
                "grep -o '[0-9]*' f"
              ]
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Quote the pattern",
              "text": "Unquoted `*` is expanded by the ==shell== before grep sees it."
            }
          ]
        }
      ]
    },
