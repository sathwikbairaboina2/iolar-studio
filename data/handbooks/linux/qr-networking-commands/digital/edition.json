                [
                  "`-v`",
                  "DNS, connect, TLS, headers"
                ],
                [
                  "`-I`",
                  "headers only"
                ],
                [
                  "`-s`",
                  "no progress meter"
                ],
                [
                  "`-o file`",
                  "save to file"
                ],
