    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "`ss -tulpn` shows `127.0.0.1:5432` LISTEN. A client on another host connects to port 5432. What happens, and what is the fix?",
              "a_bullets": [
                "**Connection refused**: nothing listens on the server's external IP",
                "Rebind to `0.0.0.0`, then check the firewall"
              ]
            },
            {
              "type": "qa",
              "q": "`ping 8.8.8.8` works but `ping example.com` fails. Which layer is broken, and what do you run next?",
              "a_bullets": [
                "**DNS resolution**, since routing and internet access work",
                "Run `dig example.com` and compare with `dig @8.8.8.8 example.com`"
              ]
            },
            {
              "type": "qa",
              "q": "Spot the bug: `scp -p 2222 app.tar user@host:/tmp`. Why does it fail?",
              "a_bullets": [
                "Lowercase `-p` preserves timestamps, so `2222` is read as a file name",
                "scp needs capital `-P 2222` for the port"
              ]
            }
          ]
        }
      ]
    }
