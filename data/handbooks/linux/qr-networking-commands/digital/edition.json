          "title": "ssh, scp and Firewall Basics",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Connect with ssh",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "Custom port and key: `-p 2222 -i key`",
                "Private key must be ==chmod 600==, or ssh refuses it",
                "`~/.ssh/config` entries let you type `ssh web`",
                "Add ==ProxyJump bastion== to hop via a jump host"
              ],
              "style": "dot"
            },
            {
              "type": "code",
              "lang": "bash",
              "lines": [
                "chmod 600 ~/.ssh/key",
                "ssh user@host -p 2222 -i ~/.ssh/key"
              ]
            },
            {
              "type": "code",
              "lang": "text",
              "lines": [
                "Host web",
                "  HostName 10.0.0.5",
                "  User deploy",
                "  Port 2222",
                "  IdentityFile ~/.ssh/key",
                "  ProxyJump bastion"
              ],
              "note": "~/.ssh/config"
            },
            {
              "type": "heading",
              "text": "2. Copy and tunnel",
              "ink": "purple"
            },
            {
              "type": "table",
              "headers": [
                "Task",
                "Command"
              ],
              "rows": [
                [
                  "Up",
                  "`scp file user@host:/path`"
                ],
                [
                  "Down",
                  "`scp user@host:/path/file .`"
                ],
                [
                  "Directory",
                  "`scp -r`"
                ],
                [
                  "Port",
                  "==-P== capital (ssh uses `-p`)"
                ],
                [
                  "Repeat sync",
                  "`rsync -av`"
                ]
              ]
            },
            {
              "type": "bullets",
              "items": [
                "Tunnel: `ssh -L 8080:localhost:80 user@host`",
                "`ssh -v` debugs auth failures",
                "Prefer ==key auth==: server holds the public key, you sign a challenge"
              ],
              "style": "check"
            },
            {
              "type": "heading",
              "text": "3. Firewall basics",
              "ink": "orange"
            },
            {
              "type": "table",
              "headers": [
                "Tool",
                "What it is"
              ],
              "rows": [
                [
                  "ufw",
                  "Ubuntu front end: `ufw allow 22/tcp`"
                ],
                [
                  "firewalld",
                  "RHEL zones: `firewall-cmd`"
                ],
                [
                  "iptables/nftables",
                  "Kernel rules, first match wins"
                ]
              ]
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Timeout vs refused",
              "text": "==Timeout== = packets dropped (firewall). ==Refused== = host answered, nothing listens on that port."
            }
          ]
        }
      ]
