    {
      "title": "Common Mistakes",
      "role": "outline",
      "outlineIndex": 4,
      "pages": [
        {
          "title": "Common Mistakes",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Timeout vs Refused",
              "ink": "red"
            },
            {
              "type": "table",
              "headers": [
                "Symptom",
                "Means",
                "Check"
              ],
              "rows": [
                [
                  "{red:Refused}",
                  "Host answered, nothing listens",
                  "`ss -tulpn`"
                ],
                [
                  "{orange:Timeout}",
                  "Firewall or security group drops packets, or bad route",
                  "`ip route get IP`"
                ]
              ]
            },
            {
              "type": "heading",
              "text": "2. Layers, Lockouts, DNS",
              "ink": "orange"
            },
            {
              "type": "bullets",
              "items": [
                "`ufw allow 8080` alone: cloud security group or router still blocks",
                "Bound to `127.0.0.1`: unreachable either way",
                "Default deny before `ufw allow 22` locks you out",
                "iptables is ==first-match==, lost on reboot unless saved",
                "Cached DNS answer: check `dig @8.8.8.8` and the TTL",
                "Ping by name works, port may still be closed"
              ],
              "style": "cross"
            },
            {
              "type": "heading",
              "text": "3. Small Slips",
              "ink": "purple"
            },
            {
              "type": "table",
              "headers": [
                "Wrong",
                "Right"
              ],
              "rows": [
                [
                  "`scp -p 2222`",
                  "`scp -P 2222`"
                ],
                [
                  "`ss` without sudo",
                  "`sudo ss`: shows process names"
                ],
                [
                  "`curl -k` in prod",
                  "Testing only; fix the cert"
                ]
              ]
            },
            {
              "type": "code",
              "lang": "bash",
              "lines": [
                "nc -zv host 22"
              ]
            },
            {
              "type": "code",
              "lang": "output",
              "lines": [
                "Connection to host 22 port [tcp/ssh] succeeded!"
              ]
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Open port?",
              "text": "Use `nc -zv host port`, not ping."
            }
          ]
        }
      ]
    },
