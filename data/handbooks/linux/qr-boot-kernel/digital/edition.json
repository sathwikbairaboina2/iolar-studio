    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "GRUB menu shows and the kernel starts, then you land in a dracut emergency shell with 'cannot mount root'. Which stage failed, and what is the fix?",
              "a_bullets": [
                "The **initramfs** stage: it lacks the disk, LVM or LUKS driver needed to find root",
                "Boot a working kernel or rescue, then run `dracut -f --kver <version>`"
              ]
            },
            {
              "type": "qa",
              "q": "You set `GRUB_TIMEOUT=2` in /etc/default/grub and rebooted, but the menu still waits 5 seconds. Why?",
              "a_bullets": [
                "grub.cfg is generated, so the edit has no effect yet",
                "Run `update-grub` (or `grub2-mkconfig -o /boot/grub2/grub.cfg` on RHEL)"
              ]
            },
            {
              "type": "qa",
              "q": "After a kernel update, `modprobe` says module not found, though the module exists. Why?",
              "a_bullets": [
                "The running kernel is still the old one until reboot",
                "`/lib/modules/$(uname -r)` was removed with the old kernel, so reboot"
              ]
            }
          ]
        }
      ]
    }
