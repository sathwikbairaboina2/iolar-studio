  "sections": [
    {
      "title": "Boot Chain: The Mental Model",
      "role": "outline",
      "outlineIndex": 0,
      "pages": [
        {
          "title": "Boot Chain: The Mental Model",
          "blocks": [
            {
              "type": "heading",
              "text": "1. The Boot Order",
              "ink": "green"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "Firmware",
                    "sub": "BIOS / UEFI",
                    "ink": "orange"
                  },
                  {
                    "text": "GRUB",
                    "sub": "bootloader",
                    "ink": "blue"
                  },
                  {
                    "text": "Kernel + initramfs",
                    "sub": "hardware",
                    "ink": "purple"
                  },
                  {
                    "text": "systemd",
                    "sub": "PID 1",
                    "ink": "green"
                  },
                  {
                    "text": "Target",
                    "sub": "boot goal reached",
                    "ink": "black"
                  }
                ]
              }
            },
            {
              "type": "bullets",
              "items": [
                "Each stage ==only loads the next one== and hands over control",
                "A failure points to the {red:stage that never finished}"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "heading",
              "text": "2. Firmware: BIOS vs UEFI",
              "ink": "orange"
            },
            {
              "type": "bullets",
              "items": [
                "==POST== (power-on self-test) runs in firmware first",
                "Then firmware picks the **boot device** from its boot order"
              ],
              "style": "number"
            },
            {
              "type": "table",
              "headers": [
                "",
                "BIOS",
                "UEFI"
              ],
              "rows": [
                [
                  "Reads",
                  "==MBR==: first 512 bytes of the disk",
                  "`.efi` files from the ==ESP=="
                ],
                [
                  "Runs",
                  "boot code inside the MBR",
                  "the `.efi` bootloader"
                ],
                [
                  "ESP format",
                  "none",
                  "**FAT32**"
                ]
              ],
              "frame": "dashed"
            },
            {
              "type": "heading",
              "text": "3. Kernel and systemd",
              "ink": "purple"
            },
            {
              "type": "bullets",
              "items": [
                "The ==kernel== is the first OS layer to drive hardware",
                "==systemd== is the first userspace process: **PID 1**",
                "It is the ancestor of all other userspace processes"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "purple"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Debug rule",
              "text": "Find the last stage that ran: no GRUB menu means firmware or bootloader; a kernel panic or dracut shell means kernel or initramfs; no login means systemd."
            }
          ]
        }
      ]
    },
    {
      "title": "Firmware and GRUB",
      "role": "outline",
      "outlineIndex": 1,
      "pages": [
        {
          "title": "Firmware and GRUB",
          "blocks": [
            {
              "type": "heading",
              "text": "1. BIOS vs UEFI",
              "ink": "green"
            },
            {
              "type": "table",
              "headers": [
                "",
                "BIOS",
                "UEFI"
              ],
              "rows": [
                [
                  "Disk layout",
                  "MBR",
                  "GPT + ESP"
                ],
                [
                  "Boot code",
                  "legacy 16-bit",
                  "`.efi` files"
                ],
                [
                  "Disk size",
                  "up to 2 TB (MBR limit)",
                  "any size, including above 2 TB"
                ],
                [
                  "Secure Boot",
                  "no",
                  "{green:yes}"
                ]
              ],
              "frame": "dashed"
            },
            {
              "type": "bullets",
              "items": [
                "Check mode: ==ls /sys/firmware/efi== exists only when booted in {green:UEFI}",
                "Directory missing = {orange:BIOS} (legacy) mode"
              ],
              "style": "dot"
            },
            {
              "type": "heading",
              "text": "2. GRUB Config Is Generated",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "Never hand-edit `grub.cfg`; edit ==/etc/default/grub==",
                "`GRUB_TIMEOUT`: seconds the menu shows",
                "`GRUB_CMDLINE_LINUX_DEFAULT`: kernel args, e.g. `quiet splash`",
                "`GRUB_DEFAULT`: which entry boots"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "blue"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "Edit",
                    "sub": "/etc/default/grub",
                    "ink": "blue"
                  },
                  {
                    "text": "Regenerate",
                    "sub": "grub.cfg",
                    "ink": "purple"
                  },
                  {
                    "text": "Reboot",
                    "sub": "new menu",
                    "ink": "green"
                  }
                ]
              }
            },
            {
              "type": "code",
              "lang": "bash",
              "lines": [
                "update-grub",
                "grub2-mkconfig -o /boot/grub2/grub.cfg",
                "# UEFI on RHEL 8 or older: -o /boot/efi/EFI/redhat/grub.cfg"
              ],
              "note": "first: Debian/Ubuntu, second: RHEL"
            },
            {
              "type": "heading",
              "text": "3. Edit an Entry Once",
              "ink": "orange"
            },
            {
              "type": "bullets",
              "items": [
                "Press ==e== on a menu entry",
                "Append `single`, `init=/bin/bash` or `systemd.unit=rescue.target`",
                "Press ==Ctrl+X== to boot"
              ],
              "style": "number"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Not saved",
              "text": "Menu edits last for **one boot** only. To keep a change, edit `/etc/default/grub` and regenerate."
            }
          ]
        }
      ]
    },
    {
      "title": "Kernel and initramfs",
      "role": "outline",
      "outlineIndex": 2,
      "pages": [
        {
          "title": "Kernel and initramfs",
          "blocks": [
            {
              "type": "heading",
              "text": "1. What GRUB Loads",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "GRUB loads two files from ==/boot==",
                "`vmlinuz-<version>` = {blue:compressed kernel}",
                "`initramfs-<version>.img` (RHEL) or `initrd.img-<version>` (Debian, Ubuntu) = {purple:initrd}",
                "GRUB also passes the ==kernel command line==",
                "Inspect it: `cat /proc/cmdline`"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "code",
              "lang": "bash",
              "lines": [
                "cat /proc/cmdline"
              ],
              "note": "arguments the running kernel got"
            },
            {
              "type": "code",
              "lang": "output",
              "lines": [
                "BOOT_IMAGE=/vmlinuz-6.8.0 root=UUID=... ro quiet"
              ]
            },
            {
              "type": "heading",
              "text": "2. From initramfs to init",
              "ink": "blue"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "Kernel",
                    "sub": "starts",
                    "ink": "blue"
                  },
                  {
                    "text": "initramfs",
                    "sub": "temp root in RAM",
                    "ink": "purple"
                  },
                  {
                    "text": "Real root",
                    "sub": "found and mounted",
                    "ink": "green"
                  },
                  {
                    "text": "/sbin/init",
                    "sub": "symlink to systemd",
                    "ink": "orange"
                  }
                ]
              }
            },
            {
              "type": "bullets",
              "items": [
                "initramfs holds drivers: ==disk, LVM, RAID, LUKS==",
                "They are needed to find and mount the real root",
                "Then the kernel **switches** to the real root and runs `/sbin/init`"
              ],
              "style": "dot"
            },
            {
              "type": "heading",
              "text": "3. Rebuild initramfs",
              "ink": "red"
            },
            {
              "type": "table",
              "headers": [
                "Distro",
                "Command"
              ],
              "rows": [
                [
                  "Debian / Ubuntu",
                  "`update-initramfs -u`"
                ],
                [
                  "RHEL",
                  "`dracut -f`"
                ]
              ],
              "frame": "dashed"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Rebuild after driver or disk changes",
              "text": "A missing driver gives =='cannot mount root'== or a **dracut emergency shell**."
            }
          ]
        }
      ]
    },
    {
      "title": "systemd, Targets and Boot Logs",
      "role": "outline",
      "outlineIndex": 3,
      "pages": [
        {
          "title": "systemd, Targets and Boot Logs",
          "blocks": [
            {
              "type": "heading",
              "text": "1. What systemd Does",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "systemd is ==PID 1==, the ancestor of all userspace processes",
                "Starts **units** (services, mounts, sockets) in ==parallel==",
                "Order follows unit **dependencies**",
                "Reaps ==orphan== processes"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "blue"
            },
            {
              "type": "heading",
              "text": "2. Targets",
              "ink": "purple"
            },
            {
              "type": "table",
              "headers": [
                "Target",
                "Boot goal"
              ],
              "rows": [
                [
                  "`multi-user.target`",
                  "text, no GUI"
                ],
                [
                  "`graphical.target`",
                  "GUI"
                ],
                [
                  "`rescue.target`",
                  "single user"
                ],
                [
                  "`emergency.target`",
                  "minimal shell"
                ],
                [
                  "`poweroff.target`",
                  "shut down"
                ]
              ],
              "frame": "dashed"
            },
            {
              "type": "code",
              "lang": "bash",
              "lines": [
                "systemctl get-default",
                "sudo systemctl set-default multi-user.target",
                "sudo systemctl isolate rescue.target"
              ],
              "note": "read default, change default, switch live now"
            },
            {
              "type": "heading",
              "text": "3. Logs and Slow Boot",
              "ink": "orange"
            },
            {
              "type": "table",
              "headers": [
                "Command",
                "Shows"
              ],
              "rows": [
                [
                  "`dmesg`",
                  "kernel ring buffer: hardware, drivers"
                ],
                [
                  "`journalctl -b`",
                  "whole current boot"
                ],
                [
                  "`journalctl -b -1`",
                  "previous boot"
                ],
                [
                  "`journalctl -b -p err`",
                  "errors only"
                ]
              ]
            },
            {
              "type": "bullets",
              "items": [
                "`systemd-analyze` = ==total== boot time",
                "`systemd-analyze blame` = **slowest** units",
                "`systemctl --failed` = units that **failed**"
              ],
              "style": "check"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "set-default vs isolate",
              "text": "`set-default` applies at the **next boot**. `isolate` switches ==now== and stops units outside that target."
            }
          ]
        }
      ]
    },
    {
      "title": "Kernel Modules and uname",
      "role": "outline",
      "outlineIndex": 4,
      "pages": [
        {
          "title": "Kernel Modules and uname",
          "blocks": [
            {
              "type": "heading",
              "text": "1. What a Module Is",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "==Kernel module== = `.ko` driver, loaded or unloaded at runtime, {green:no reboot}",
                "Stored under `/lib/modules/$(uname -r)/`",
                "`lsmod` → loaded modules: size and ==used-by== count",
                "`modinfo <mod>` → description, parameters, dependencies"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "heading",
              "text": "2. Load, Unload, Persist",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "Command",
                "Does",
                "Dependencies"
              ],
              "rows": [
                [
                  "`modprobe <mod>`",
                  "loads module",
                  "{green:resolved}"
                ],
                [
                  "`modprobe -r <mod>`",
                  "unloads module",
                  "{green:resolved}"
                ],
                [
                  "`insmod` / `rmmod`",
                  "load / unload by file",
                  "{red:not resolved}"
                ]
              ],
              "highlightRow": 0
            },
            {
              "type": "bullets",
              "items": [
                "Prefer ==modprobe== over insmod/rmmod",
                "Load at boot: `/etc/modules-load.d/*.conf`",
                "Stop auto-loading a driver: `blacklist <mod>` in `/etc/modprobe.d/*.conf`",
                "A module with ==non-zero used-by== cannot be removed"
              ],
              "style": "check"
            },
            {
              "type": "heading",
              "text": "3. uname and the Stale Kernel",
              "ink": "purple"
            },
            {
              "type": "table",
              "headers": [
                "Command",
                "Shows"
              ],
              "rows": [
                [
                  "`uname -r`",
                  "kernel release"
                ],
                [
                  "`uname -a`",
                  "everything"
                ],
                [
                  "`uname -m`",
                  "architecture"
                ]
              ]
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Updated, not rebooted",
              "text": "After a kernel update the running kernel stays ==old== until reboot. Its `/lib/modules/$(uname -r)` may be gone, so modprobe fails: **module not found**."
            }
          ]
        }
      ]
    },
