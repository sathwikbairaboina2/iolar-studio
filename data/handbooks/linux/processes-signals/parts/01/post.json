          "type": "code",
          "lang": "c",
          "lines": [
            "sigset_t s; sigemptyset(&s);",
            "sigaddset(&s, SIGINT);",
            "sigprocmask(SIG_BLOCK, &s, NULL);",
            "// blocked signals stay pending"
          ]
