      "blocks": [
        {
          "type": "code",
          "lang": "c",
          "lines": [
            "signal(SIGPIPE, SIG_IGN);   // survive it",
            "if (write(fd,b,n) < 0 && errno == EPIPE)",
            "  drop_client();            // handle inline"
          ]
        },
        {
          "type": "bullets",
          "items": [
            "SIGCHLD's default action is to ignore",
            "SIGSTOP is uncatchable exactly like SIGKILL",
            "SIGTSTP is the polite variant you can trap"
          ]
        },
        {
          "type": "code",
          "lang": "bash",
          "lines": [
            "kill -l            # full name/number table",
            "kill -l 137        # KILL, decodes 128+N",
            "trap -l            # same list, shell side"
          ]
        },
        {
          "type": "callout",
          "style": "takeaway",
          "title": "Names, Never Numbers",
          "text": "Signal numbers differ across architectures — SIGBUS and friends move. Write kill -TERM, not kill -15, and check the local table with kill -l."
