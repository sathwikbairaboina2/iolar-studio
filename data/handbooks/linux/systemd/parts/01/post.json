        {
          "type": "table",
          "headers": [
            "command",
            "scope"
          ],
          "rows": [
            [
              "`start`",
              "runs now only"
            ],
            [
              "`enable`",
              "boot symlink only"
            ],
            [
              "`enable --now`",
              "both at once"
            ]
          ]
        },
        {
          "type": "code",
          "lang": "shell",
          "lines": [
            "$ systemctl status nginx.service",
            "● loaded / active (running) since boot",
            "  Main PID 4121 (nginx)",
            "  cgroup: workers included",
            "  + last 10 journal lines"
          ],
          "runnable": false
        },
        {
          "type": "bullets",
          "items": [
            "`status` shows load/active/sub, main PID, cgroup",
            "plus last journal lines, one screen",
            "`is-active` / `is-enabled` return clean exit codes"
          ]
        },
        {
          "type": "bullets",
          "items": [
            "`list-units` — loaded and active in memory",
            "`list-unit-files` — installed on disk + enabled state",
            "SysV init scripts still run; native units are the goal"
          ]
        },
        {
          "type": "heading",
          "text": "Search Path"
        },
        {
          "type": "diagram",
          "kind": "flow",
          "spec": {
            "nodes": [
              "`/etc` admin",
              "`/run` runtime",
              "`/usr/lib` vendor"
            ]
          }
        },
        {
          "type": "sidebox",
          "title": "daemon-reload habit",
          "items": [
            "after any edit or mask, reload PID 1",
            "v253+ detects changes itself",
            "older hosts run stale config silently"
          ],
          "ink": "red"
        },
        {
          "type": "callout",
          "style": "tip",
          "title": "One command",
          "text": "`systemctl cat foo.service` prints the effective unit plus every drop-in that applies to it."
        },
        {
          "type": "heading",
          "text": "Three Sections"
        },
        {
          "type": "table",
          "headers": [
            "section",
            "holds"
          ],
          "rows": [
            [
              "`[Unit]`",
              "metadata + relations"
            ],
            [
              "`[Service]`",
              "the real work"
            ],
            [
              "`[Install]`",
              "`enable` wiring"
            ]
          ]
        },
        {
          "type": "bullets",
          "items": [
            "keys and sections are case-sensitive",
            "`Key=` empty value resets to default",
            "`[Install]` read only by `enable`/`disable`",
            "`WantedBy=multi-user.target` picks the wants dir"
          ]
        }
      ]
    },
    {
      "page_title": "Anatomy of a Unit File",
      "blocks": [
        {
          "type": "code",
          "lang": "ini",
          "lines": [
            "[Unit]",
            "Description=metrics exporter",
            "After=network-online.target",
            "[Service]",
            "ExecStart=/usr/bin/exporter"
          ],
          "runnable": false
        },
        {
          "type": "heading",
          "text": "Exec Lines"
        },
        {
          "type": "bullets",
          "items": [
            "exec lines are `argv` lists",
            "quote args containing spaces",
            "trailing `\\` continues a line",
            "`#` starts a comment"
          ]
        },
        {
          "type": "code",
          "lang": "ini",
          "lines": [
            "ExecStart=/usr/bin/app --serve \\",
            "  --port 8080 --log /var/a.log",
            "# args with spaces need quotes"
          ],
          "runnable": false
        },
        {
          "type": "heading",
          "text": "Specifiers & Templates"
        },
        {
          "type": "table",
          "headers": [
            "spec",
            "expands to"
          ],
          "rows": [
            [
              "`%i`",
              "instance name"
            ],
            [
              "`%n`",
              "unit name"
            ],
            [
              "`%h`",
              "user home"
            ],
            [
              "`%t`",
              "runtime dir"
            ]
          ]
        },
        {
          "type": "bullets",
          "items": [
            "templates end in `@` — `sshd@.service`",
            "instances: `sshd@foo`, `sshd@bar`, each own `%i`",
            "one template, many instances — no copies"
          ]
        },
        {
          "type": "code",
          "lang": "ini",
          "lines": [
            "# sshd@.service — template",
            "ExecStart=/usr/sbin/sshd -i %i",
            "# sshd@web1 → %i=web1"
          ],
          "runnable": false
        },
        {
          "type": "sidebox",
          "title": "Environment",
          "items": [
            "`Environment=FOO=bar` sets inline",
            "`EnvironmentFile=/etc/app/env` loads KEY=value",
            "`$FOO` expands inside `ExecStart`"
          ],
          "ink": "green"
        },
        {
          "type": "bullets",
          "items": [
            "time: `90`, `90s`, `5min 30s` — bare = seconds",
            "booleans: `1/yes/true/on`",
            "commas separate most list-typed settings"
          ]
        },
        {
          "type": "callout",
          "style": "takeaway",
          "title": "Pre-flight",
          "text": "`systemd-analyze verify foo.service` flags unknown keys, bad paths, ordering cycles. Misplaced keys — `Restart=` under `[Unit]` — silently do nothing."
        },
        {
          "type": "heading",
          "text": "Boot Goals"
        },
        {
          "type": "paragraph",
          "text": "A target is a synchronization point: no `ExecStart`, it groups other units — systemd's runlevel replacement."
        },
        {
          "type": "diagram",
          "kind": "cards",
          "spec": {
            "cards": [
              {
                "title": "`multi-user.target`",
                "lines": [
                  "full text-mode system",
                  "old runlevel 3"
                ]
              },
              {
                "title": "`graphical.target`",
                "lines": [
                  "adds display manager",
                  "via `Wants=` on multi-user"
                ]
              }
            ]
          }
        },
        {
          "type": "table",
          "headers": [
            "runlevel",
            "target"
          ],
          "rows": [
            [
              "3",
              "`multi-user`"
            ],
            [
              "5",
              "`graphical`"
            ],
            [
              "1 / S",
              "`rescue`"
            ]
          ]
        },
        {
          "type": "code",
          "lang": "shell",
          "lines": [
            "$ systemctl get-default",
            "graphical.target",
            "$ systemctl set-default multi-user",
            "$ systemctl isolate rescue.target",
            "# isolate needs AllowIsolate=yes"
          ],
          "runnable": false
        }
      ]
    },
    {
      "page_title": "Targets: Boot Goals & Runlevels",
      "blocks": [
        {
          "type": "bullets",
          "items": [
            "`isolate foo.target` switches the running system now",
            "isolation stops everything the target doesn't want",
            "`IgnoreOnIsolate=yes` opts out of the kill",
            "boot converges on the `default.target` symlink"
          ]
        },
        {
          "type": "diagram",
          "kind": "cards",
          "spec": {
            "cards": [
              {
                "title": "`rescue.target`",
                "lines": [
                  "single-user shell",
                  "local fs mounted"
                ]
              },
              {
                "title": "`emergency.target`",
                "lines": [
                  "read-only root",
                  "for `fstab` damage"
                ]
              }
            ]
          }
        },
        {
          "type": "heading",
          "text": "Wiring & Speed"
        },
        {
          "type": "bullets",
          "items": [
            "`enable` symlinks into `multi-user.target.wants/`",
            "e.g. `…wants/nginx.service` → real unit file",
            "every `Wants=` member gains implicit `After=`"
          ]
        },
        {
          "type": "code",
          "lang": "ini",
          "lines": [
            "[Unit]",
            "Description=full app stack",
            "Wants=api.service db.service",
            "After=network-online.target"
          ],
          "runnable": false
        },
        {
          "type": "bullets",
          "items": [
            "`systemd-analyze blame` ranks per-unit boot time",
            "`critical-chain` shows the slow critical path",
            "fastest way to find slow starters"
          ]
        },
        {
          "type": "sidebox",
          "title": "Recovery drill",
          "items": [
            "append `systemd.unit=rescue.target` to kernel cmdline",
            "works when a normal boot fails"
          ],
          "ink": "red"
        },
        {
          "type": "callout",
          "style": "takeaway",
          "title": "Reached?",
          "text": "Members are up before the target counts as reached — targets gate boot milestones."
        },
        {
          "type": "heading",
          "text": "Strength Ladder"
        },
        {
          "type": "table",
          "headers": [
            "directive",
            "failure effect"
          ],
          "rows": [
            [
              "`Wants=`",
              "continue anyway"
            ],
            [
              "`Requires=`",
              "unit stops too"
            ],
            [
              "`BindsTo=`",
              "stops instantly"
            ],
            [
              "`Requisite=`",
              "fails if inactive"
            ],
            [
              "`Conflicts=`",
              "stops the other"
            ]
          ]
        },
        {
          "type": "bullets",
          "items": [
            "`After=`/`Before=` only sequence, pull nothing in",
            "always pair ordering with `Wants=`/`Requires=`",
            "`Requires=` + `After=`: failed dep blocks startup",
            "shutdown mirrors startup: `After=foo` stops first"
          ]
        },
        {
          "type": "diagram",
          "kind": "flow",
          "spec": {
            "nodes": [
              "`Wants=` pulls",
              "`After=` orders",
              "unit ready"
            ]
          }
        },
        {
          "type": "code",
          "lang": "ini",
          "lines": [
            "[Unit]",
            "Wants=a.service b.service",
            "After=a.service b.service",
            "# After orders but pulls nothing"
          ],
          "runnable": false
        },
        {
          "type": "bullets",
          "items": [
            "`BindsTo=` + `After=`: lifetime binding",
            "`PartOf=` shares stop/restart — reload groups",
            "`Requisite=` never starts anything",
            "`Conflicts=` is symmetric negative dependency"
          ]
        }
      ]
    },
    {
      "page_title": "Dependencies & Ordering",
      "blocks": [
        {
          "type": "heading",
          "text": "Cheap Wiring"
        },
        {
          "type": "bullets",
          "items": [
            "symlinks in `foo.service.wants/` add `Wants=`",
            "no file edit needed",
            "`DefaultDependencies=` adds implicit shutdown scaffolding"
          ]
        },
        {
          "type": "sidebox",
          "title": "Gates, not deps",
          "items": [
            "`ConditionPathExists=/etc/app` false → skip",
            "skipped, not failed — stays inactive",
            "zero dependency semantics"
          ],
          "ink": "green"
        },
        {
          "type": "code",
          "lang": "ini",
          "lines": [
            "[Unit]",
            "ConditionPathExists=/etc/app/enabled",
            "[Service]",
            "ExecStart=/usr/bin/agent",
            "# condition false → unit skipped"
          ],
          "runnable": false
        },
        {
          "type": "qa",
          "q": "Why does my dependency never start?",
          "a_bullets": [
            "`After=` orders, never pulls in",
            "add `Wants=`/`Requires=` beside it",
            "audit with `list-dependencies foo --after`"
          ]
        },
        {
          "type": "callout",
          "style": "takeaway",
          "title": "Rule of thumb",
          "text": "`Wants=` for launch, `After=` for order, `BindsTo=` for lifetime. One directive can list many: `Wants=a.service b.service`."
        },
        {
          "type": "heading",
          "text": "Service Types"
        },
        {
          "type": "table",
          "headers": [
            "Type",
            "started when"
          ],
          "rows": [
            [
              "`simple`",
              "`ExecStart` launches"
            ],
            [
              "`exec`",
              "`execve()` succeeds"
            ],
            [
              "`forking`",
              "`PIDFile=` read"
            ],
            [
              "`notify`",
              "`READY=1` sent"
            ],
            [
              "`oneshot`",
              "process exits"
            ]
          ]
        },
        {
          "type": "bullets",
          "items": [
            "`exec` catches 'binary not found' instead of hanging",
            "`forking`: classic daemons — prefer converting",
            "`oneshot` restart restricted — rerun via timer",
            "`RemainAfterExit=yes` stays active after exit"
          ]
        },
        {
          "type": "code",
          "lang": "ini",
          "lines": [
            "[Service]",
            "Type=notify",
            "ExecStart=/usr/bin/appd",
            "# daemon calls sd_notify('READY=1')",
            "# start-up completes only then"
          ],
          "runnable": false
        },
        {
          "type": "heading",
          "text": "Restarts & Limits"
        },
        {
          "type": "table",
          "headers": [
            "key",
            "effect"
          ],
          "rows": [
            [
              "`Restart=on-failure`",
              "crashes only"
            ],
            [
              "`Restart=always`",
              "clean exits too"
            ],
            [
              "`RestartSec=5s`",
              "gap between tries"
            ],
            [
              "`StartLimitBurst=5`",
              "rate-limits starts"
            ],
            [
              "`WatchdogSec=30s`",
              "notify liveness"
            ]
          ]
        },
        {
          "type": "bullets",
          "items": [
            "`StartLimitIntervalSec=` + burst stop crash loops",
            "'start request repeated too quickly' = you hit it",
            "`TimeoutStartSec=`/`TimeoutStopSec=` default `90s`"
          ]
        }
      ]
    },
    {
      "page_title": "Service Types, Restarts & Exec Lifecycle",
      "blocks": [
        {
          "type": "code",
          "lang": "ini",
          "lines": [
            "ExecStartPre=-/usr/bin/warm-cache",
            "ExecStartPost=/usr/bin/announce",
            "ExecStopPost=+/usr/bin/cleanup",
            "# '-' ignore failure, '+' root privs"
          ],
          "runnable": false
        },
        {
          "type": "heading",
          "text": "Kill & Harden"
        },
        {
          "type": "bullets",
          "items": [
            "stopping is cgroup-wide by default",
            "`KillMode=control-group` SIGTERMs every spawned process",
            "`process` kills only the main PID"
          ]
        },
        {
          "type": "bullets",
          "items": [
            "`User=` / `Group=` — avoid root",
            "`WorkingDirectory=` for relative paths",
            "`EnvironmentFile=` for app config"
          ]
        },
        {
          "type": "sidebox",
          "title": "Ship sandboxing",
          "items": [
            "`NoNewPrivileges=yes`",
            "`ProtectSystem=strict`",
            "`PrivateTmp=yes`",
            "`ProtectHome=yes`"
          ],
          "ink": "blue"
        },
        {
          "type": "callout",
          "style": "tip",
          "title": "Modern default",
          "text": "Prefer `Type=notify` — systemd verifies real readiness instead of guessing."
        },
        {
          "type": "heading",
          "text": "Pairing"
        },
        {
          "type": "bullets",
          "items": [
            "`backup.timer` fires `backup.service` — same basename",
            "`Unit=` overrides the pairing",
            "enable the timer, not the service",
            "timer-paired services often skip `[Install]`"
          ]
        },
        {
          "type": "code",
          "lang": "ini",
          "lines": [
            "[Timer]",
            "OnCalendar=Sun *-*-* 03:00:00",
            "Persistent=yes",
            "RandomizedDelaySec=10min",
            "# replays missed Sundays"
          ],
          "runnable": false
        },
        {
          "type": "heading",
          "text": "Calendar Syntax"
        },
        {
          "type": "table",
          "headers": [
            "expr",
            "fires"
          ],
          "rows": [
            [
              "`*:0/15`",
              "every 15 min"
            ],
            [
              "`daily`",
              "builtin shortcut"
            ],
            [
              "`Mon..Fri 09:00`",
              "weekday mornings"
            ],
            [
              "`Sun *-*-* 03:00`",
              "Sunday 03:00"
            ]
          ]
        },
        {
          "type": "code",
          "lang": "shell",
          "lines": [
            "$ systemd-analyze calendar 'daily'",
            "→ next: 2026-09-15 00:00:00",
            "# validates expr, previews runs"
          ],
          "runnable": false
        },
        {
          "type": "bullets",
          "items": [
            "expressions are DST-aware",
            "`Persistent=yes` replays missed calendar runs",
            "monotonic timers cannot be persistent",
            "`journalctl` replaces cron's mail for timer logs"
          ]
        },
        {
          "type": "diagram",
          "kind": "cards",
          "spec": {
            "cards": [
              {
                "title": "`OnCalendar=`",
                "lines": [
                  "wall-clock events",
                  "DST-aware",
                  "can be `Persistent=`"
                ]
              },
              {
                "title": "monotonic",
                "lines": [
                  "`OnBootSec=10min`",
                  "`OnUnitActiveSec=1h`",
                  "immune to clock changes"
                ]
              }
            ]
          }
        },
        {
          "type": "heading",
          "text": "Tuning & Ops"
        },
        {
          "type": "table",
          "headers": [
            "key",
            "purpose"
          ],
          "rows": [
            [
              "`AccuracySec=`",
              "coalesce wakeups"
            ],
            [
              "`RandomizedDelaySec=`",
              "spread fleet load"
            ],
            [
              "`WakeSystem=true`",
              "wake from suspend"
            ],
            [
              "`Persistent=`",
              "replay missed"
            ]
          ]
        },
        {
          "type": "code",
          "lang": "shell",
          "lines": [
            "$ journalctl -u backup.timer \\",
            "  -u backup.service --since today",
            "# both units in one view"
          ],
          "runnable": false
        }
      ]
    },
    {
      "page_title": "Timers: systemd's cron Replacement",
      "blocks": [
        {
          "type": "bullets",
          "items": [
            "`OnFailure=alert@%n.service` pushes a notice",
            "`%n` carries the failing unit's name",
            "`list-timers --all`: NEXT, LEFT, LAST, PASSED"
          ]
        },
        {
          "type": "sidebox",
          "title": "The classic bug",
          "items": [
            "weekly job skips closed weekends in downtime",
            "no `Persistent=yes`, no replay",
            "set it on every calendar timer"
          ],
          "ink": "red"
        },
        {
          "type": "callout",
          "style": "takeaway",
          "title": "vs cron",
          "text": "Prefer timers on systemd hosts: logs, dependencies, cgroup tracking, persistence. Cron wins only on tiny syntax and ubiquity."
        },
        {
          "type": "heading",
          "text": "Unit Filters"
        },
        {
          "type": "code",
          "lang": "shell",
          "lines": [
            "$ journalctl -u nginx.service -b",
            "$ journalctl -u app -u db -f",
            "# repeat -u for several units"
          ],
          "runnable": false
        },
        {
          "type": "table",
          "headers": [
            "flag",
            "does"
          ],
          "rows": [
            [
              "`-f`",
              "follow live"
            ],
            [
              "`-n 100`",
              "last 100 lines"
            ],
            [
              "`-e`",
              "jump to end"
            ],
            [
              "`-b -1`",
              "previous boot"
            ],
            [
              "`--list-boots`",
              "index all boots"
            ]
          ]
        },
        {
          "type": "bullets",
          "items": [
            "`-p err` filters syslog severity",
            "ranges like `-p warning..alert` cut noise",
            "structured indexed binary log from `systemd-journald`"
          ]
        },
        {
          "type": "code",
          "lang": "shell",
          "lines": [
            "$ journalctl --since 'yesterday' \\",
            "  --until 'now-30min'",
            "$ journalctl -p warning..alert -b"
          ],
          "runnable": false
        },
        {
          "type": "heading",
          "text": "Fields & Output"
        },
        {
          "type": "table",
          "headers": [
            "mode",
            "shows"
          ],
          "rows": [
            [
              "`-o json`",
              "machine-readable"
            ],
            [
              "`-o json-pretty`",
              "readable JSON"
            ],
            [
              "`-o verbose`",
              "trusted fields visible"
            ]
          ]
        },
        {
          "type": "bullets",
          "items": [
            "verbose shows `_PID`, `_COMM`, `_SYSTEMD_UNIT`",
            "`status` embeds last log lines for free",
            "field filters hit the index — no grep"
          ]
        },
        {
          "type": "code",
          "lang": "shell",
          "lines": [
            "$ journalctl _SYSTEMD_UNIT=ssh.service",
            "$ journalctl _COMM=cron _PID=1204",
            "# indexed fields, fast"
          ],
          "runnable": false
        },
        {
          "type": "sidebox",
          "title": "Make it persist",
          "items": [
            "`mkdir /var/log/journal`",
            "or `Storage=persistent` in `journald.conf`",
            "otherwise logs vanish at reboot"
          ],
          "ink": "red"
        },
        {
          "type": "code",
          "lang": "shell",
          "lines": [
            "$ journalctl --disk-usage",
            "$ journalctl --vacuum-size=500M",
            "# cap: SystemMaxUse=1G"
          ],
          "runnable": false
        },
        {
          "type": "qa",
          "q": "grep or field filter?",
          "a_bullets": [
            "`_SYSTEMD_UNIT=foo` queries indexed fields",
            "faster than piping to `grep`",
            "combine: `_COMM=cron` + time window"
          ]
        },
        {
          "type": "callout",
          "style": "tip",
          "title": "One tool",
          "text": "`-k` equals `dmesg` through the journal. `ForwardToSyslog=yes` keeps rsyslog text files flowing alongside."
        }
      ]
    },
    {
      "page_title": "Override Drop-ins & systemctl edit",
      "blocks": [
        {
          "type": "heading",
          "text": "Drop-ins"
        },
        {
          "type": "paragraph",
          "text": "`systemctl edit foo.service` opens `/etc/systemd/system/foo.service.d/override.conf` — the drop-in that survives package upgrades."
        },
        {
          "type": "code",
          "lang": "shell",
          "lines": [
            "$ systemctl edit nginx.service",
            "# editor opens this drop-in:",
            "# /etc/systemd/system/",
            "#   nginx.service.d/override.conf"
          ],
          "runnable": false
        },
        {
          "type": "diagram",
          "kind": "flow",
          "spec": {
            "nodes": [
              "vendor file",
              "`foo.d/*.conf`",
              "effective unit"
            ]
          }
        },
        {
          "type": "bullets",
          "items": [
            "every `*.conf` applies alphabetically over vendor",
            "`/etc` beats `/run` beats `/usr/lib`",
            "list keys append — they don't replace",
            "second `ExecStart=` is a load error unless `oneshot`"
          ]
        },
        {
          "type": "code",
          "lang": "ini",
          "lines": [
            "[Service]",
            "ExecStart=",
            "ExecStart=/usr/bin/app --new-flags",
            "# bare key clears list, then set"
          ],
          "runnable": false
        },
        {
          "type": "bullets",
          "items": [
            "keep section headers — `[Service]`, `[Unit]`",
            "directives outside a section are ignored",
            "`systemctl cat` shows vendor + drop-ins inlined"
          ]
        },
        {
          "type": "heading",
          "text": "Toolbox"
        },
        {
          "type": "table",
          "headers": [
            "command",
            "effect"
          ],
          "rows": [
            [
              "`edit`",
              "opens drop-in"
            ],
            [
              "`cat`",
              "vendor + drop-ins"
            ],
            [
              "`revert`",
              "restores vendor"
            ],
            [
              "`mask`",
              "symlink `/dev/null`"
            ],
            [
              "`daemon-reload`",
              "PID 1 rereads"
            ]
          ]
        },
        {
          "type": "bullets",
          "items": [
            "`mask` blocks manual, boot and dependency starts",
            "an old mask still wins over all config",
            "`unmask` reverses the symlink"
          ]
        },
        {
          "type": "sidebox",
          "title": "Generated units",
          "items": [
            "`/run/systemd/generator`, e.g. `fstab` mounts",
            "drop-ins are the only clean customization",
            "`sshd@.service.d/` template-wide, hits all",
            "instance `sshd@web1.service.d/` wins last"
          ],
          "ink": "green"
        },
        {
          "type": "bullets",
          "items": [
            "typical: bump `LimitNOFILE=`",
            "inject `Environment=`",
            "`Restart=on-failure`",
            "layer `ProtectHome=yes`"
          ]
        },
        {
          "type": "callout",
          "style": "takeaway",
          "title": "After editing",
          "text": "`daemon-reload` before restart — v253+ warns or auto-reloads, older hosts run stale config silently."
        },
        {
          "type": "heading",
          "text": "First Moves"
        },
        {
          "type": "code",
          "lang": "shell",
          "lines": [
            "$ systemctl --failed",
            "$ systemctl status app.service",
            "# result: 'exit-code, status=203/EXEC'"
          ],
          "runnable": false
        },
        {
          "type": "bullets",
          "items": [
            "exit `203/EXEC` = binary or interpreter wrong",
            "typo, missing shebang, denied executable",
            "the most common dead-on-arrival"
          ]
        }
      ]
    },
    {
      "page_title": "Troubleshooting Failed Units",
      "blocks": [
        {
          "type": "table",
          "headers": [
            "result line",
            "meaning"
          ],
          "rows": [
            [
              "`203/EXEC`",
              "bad binary path"
            ],
            [
              "`oom-kill`",
              "kernel killed it"
            ],
            [
              "`timeout`",
              "hung start/stop"
            ],
            [
              "`start-limit-hit`",
              "burst tripped"
            ]
          ]
        },
        {
          "type": "code",
          "lang": "shell",
          "lines": [
            "$ journalctl -u app.service -b --no-pager",
            "$ journalctl -u app -f",
            "# stderr lands here by default"
          ],
          "runnable": false
        },
        {
          "type": "bullets",
          "items": [
            "`coredumpctl list` finds the crash",
            "`coredumpctl info` prints a backtrace",
            "no `core_pattern` fiddling needed"
          ]
        },
        {
          "type": "heading",
          "text": "Decoding Death"
        },
        {
          "type": "paragraph",
          "text": "The status result line names the death: exit-code vs signal, oom-kill, timeout, or start-limit-hit."
        },
        {
          "type": "qa",
          "q": "'Active' but broken?",
          "a_bullets": [
            "check `Main PID` + cgroup in `status`",
            "forked-and-exited wrapper = wrong `Type=`",
            "`Type=notify` proves real readiness"
          ]
        },
        {
          "type": "code",
          "lang": "shell",
          "lines": [
            "$ systemctl reset-failed app.service",
            "# clears 'repeated too quickly' trip",
            "# fix the crash before restarting"
          ],
          "runnable": false
        },
        {
          "type": "bullets",
          "items": [
            "'Unit is masked' — check `is-enabled`",
            "a months-old mask still wins over config",
            "hung start + timeout? forking daemon, no `PIDFile=`"
          ]
        },
        {
          "type": "sidebox",
          "title": "Silent skip",
          "items": [
            "`Condition*=` false logs 'condition failed'",
            "unit left inactive by design",
            "not a failure — don't chase it"
          ],
          "ink": "green"
        },
        {
          "type": "bullets",
          "items": [
            "`list-dependencies foo` shows the wait chain",
            "add `--after` on newer systemd",
            "`systemd-analyze verify` catches cycles"
          ]
        },
        {
          "type": "callout",
          "style": "tip",
          "title": "New EPERM?",
          "text": "Just added sandboxing? `ProtectSystem`/`PrivateTmp` may block a write path — add `ReadWritePaths=` exceptions."
        }
      ]
    },
    {
      "page_title": "Trade-offs, Classic Mistakes & Cheat Sheet",
      "blocks": [
        {
          "type": "heading",
          "text": "Verdicts"
        },
        {
          "type": "diagram",
          "kind": "cards",
          "spec": {
            "cards": [
              {
                "title": "systemd timers",
                "lines": [
                  "structured journal logs",
                  "`Persistent=` replay",
                  "`After=` dependencies"
                ]
              },
              {
                "title": "cron",
                "lines": [
                  "tiny syntax",
                  "ubiquitous everywhere"
                ]
              }
            ]
          }
        },
        {
          "type": "bullets",
          "items": [
            "vs SysV: cgroup-tracked — no escaped PIDs",
            "parallel startup, explicit per-unit dependencies",
            "why units replaced init scripts"
          ]
        },
        {
          "type": "table",
          "headers": [
            "choice",
            "trade-off"
          ],
          "rows": [
            [
              "drop-ins",
              "indirection, upgrade-safe"
            ],
            [
              "`Restart=always`",
              "hides crashes"
            ],
            [
              "binary journal",
              "grep workflows break"
            ],
            [
              "`Requires=`",
              "failure chains"
            ]
          ]
        },
        {
          "type": "bullets",
          "items": [
            "journal is indexed and fast but binary",
            "no `/var/log/journal` or forwarding → tail breaks",
            "keep `ForwardToSyslog=` for old workflows"
          ]
        },
        {
          "type": "heading",
          "text": "Classic Mistakes"
        },
        {
          "type": "bullets",
          "items": [
            "editing `/usr/lib/systemd/system` — upgrades overwrite",
            "restart without `daemon-reload` — tested old config",
            "`After=` alone — ordering never pulls anything in"
          ]
        },
        {
          "type": "bullets",
          "items": [
            "drop-ins add indirection",
            "but `/etc` overrides survive every package upgrade",
            "forked vendor units would be lost"
          ]
        },
        {
          "type": "diagram",
          "kind": "flow",
          "spec": {
            "nodes": [
              "status",
              "journalctl -u",
              "verify",
              "cat",
              "edit",
              "reload + restart"
            ]
          }
        },
        {
          "type": "callout",
          "style": "takeaway",
          "title": "Hard deps",
          "text": "`Requires=` chains turn one failure into an outage. Default to `Wants=`; reserve hard deps for true correctness. Aggressive restarts need `OnFailure=` alerts or you get silent flapping."
        },
        {
          "type": "sidebox",
          "title": "Ship-it checklist",
          "items": [
            "`Description=` set, honest `Type=`",
            "deliberate `Restart=`",
            "sandbox keys on, `Persistent=yes`",
            "overrides as drop-ins"
          ],
          "ink": "blue"
        }
      ]
    }
  ],
