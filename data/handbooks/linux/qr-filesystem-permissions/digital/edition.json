  "sections": [
    {
      "title": "Filesystem Hierarchy and Paths",
      "role": "outline",
      "outlineIndex": 0,
      "pages": [
        {
          "title": "Filesystem Hierarchy and Paths",
          "blocks": [
            {
              "type": "heading",
              "text": "1. One Tree, Rooted at /",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "Everything hangs off ==one tree== rooted at `/`",
                "{red:No drive letters}: disks and devices are ==mounted== into the tree"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "table",
              "headers": [
                "Dir",
                "Holds"
              ],
              "rows": [
                [
                  "`/etc`",
                  "config files"
                ],
                [
                  "`/var`",
                  "logs, changing data"
                ],
                [
                  "`/home`",
                  "user files"
                ],
                [
                  "`/usr`",
                  "installed programs"
                ],
                [
                  "`/tmp`",
                  "scratch space"
                ],
                [
                  "`/dev`",
                  "devices"
                ],
                [
                  "`/proc`",
                  "kernel and process info"
                ]
              ],
              "highlightRow": 0
            },
            {
              "type": "heading",
              "text": "2. Paths and Shortcuts",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "{green:Absolute} starts with `/`: `/var/log/syslog`",
                "{blue:Relative} starts from the current directory: `../logs`"
              ],
              "style": "dot"
            },
            {
              "type": "table",
              "headers": [
                "Symbol",
                "Means"
              ],
              "rows": [
                [
                  "`.`",
                  "current dir"
                ],
                [
                  "`..`",
                  "parent dir"
                ],
                [
                  "`~`",
                  "your home"
                ],
                [
                  "`-`",
                  "previous dir (`cd -`)"
                ]
              ]
            },
            {
              "type": "heading",
              "text": "3. Common Mistakes",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "Paths are ==case-sensitive==: `Docs` is not `docs`",
                "A leading dot ==hides== a file: `.bashrc`"
              ],
              "style": "cross",
              "frame": "dashed",
              "ink": "red"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Spaces",
              "text": "Spaces need quotes or a backslash: `cd \"My Docs\"` or `cd My\\ Docs`"
            }
          ]
        }
      ]
    },
    {
      "title": "Everyday File Commands: ls, cd, cp, mv, rm, find",
      "role": "outline",
      "outlineIndex": 1,
      "pages": [
        {
          "title": "Everyday File Commands: ls, cd, cp, mv, rm, find",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Look Around",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "`ls -lah`: ==long== format, ==all== files incl. hidden, ==human-readable== sizes",
                "`pwd` prints where you are"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "heading",
              "text": "2. Copy, Move, Delete",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "Command",
                "Does",
                "Note"
              ],
              "rows": [
                [
                  "`cp -r src/ dest/`",
                  "copies directories",
                  "needs ==-r=="
                ],
                [
                  "`cp -a`",
                  "also keeps permissions, timestamps",
                  "archive copy"
                ],
                [
                  "`mv old.txt new.txt`",
                  "moves **and** renames",
                  "never needs -r"
                ],
                [
                  "`rm -r dir`",
                  "deletes recursively",
                  "{red:no trash, no undo}"
                ]
              ],
              "frame": "dashed"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "ls /path/",
                    "sub": "check the target",
                    "ink": "green"
                  },
                  {
                    "text": "rm -r /path/",
                    "sub": "no undo",
                    "ink": "red"
                  }
                ]
              }
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Danger line",
              "text": "`rm -rf /path/` is the one to fear. Run `ls` on the path first."
            },
            {
              "type": "heading",
              "text": "3. find",
              "ink": "purple"
            },
            {
              "type": "bullets",
              "items": [
                "`find` matches by ==name==, ==age== and ==type==",
                "Unlike `locate`, it walks the **live disk**",
                "Add `-exec rm {} \\;` to act on each result"
              ],
              "style": "dot"
            },
            {
              "type": "code",
              "lang": "bash",
              "lines": [
                "find /var -name \"*.log\" -mtime -1 -type f",
                "find /var -name \"*.log\" -mtime -1 -type f -exec rm {} \\;"
              ],
              "note": "-mtime -1 = changed within the last day"
            }
          ]
        }
      ]
    },
    {
      "title": "Permissions: rwx and Octal",
      "role": "outline",
      "outlineIndex": 2,
      "pages": [
        {
          "title": "Permissions: rwx and Octal",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Reading a Mode",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "`-rwxr-xr--` = {blue:type}, {green:owner}, {orange:group}, {red:others}",
                "==r=4, w=2, x=1==; rwx=7, r-x=5, rw-=6, r--=4",
                "`640` = owner rw, group r, others none"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "table",
              "headers": [
                "Bit",
                "File",
                "Directory"
              ],
              "rows": [
                [
                  "`r`",
                  "read contents",
                  "==list names=="
                ],
                [
                  "`w`",
                  "modify contents",
                  "create or delete entries"
                ],
                [
                  "`x`",
                  "==run it==",
                  "==cd into it=="
                ]
              ]
            },
            {
              "type": "heading",
              "text": "2. chmod",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "Octal sets **all** bits; symbolic changes only the bits named",
                "Symbolic: who `u g o a`, op `+ - =`, bits `rwx`"
              ],
              "style": "dot"
            },
            {
              "type": "code",
              "lang": "bash",
              "lines": [
                "chmod 755 script.sh",
                "chmod u+x file",
                "chmod g-w file",
                "chmod o=r file",
                "chmod a+r file"
              ],
              "note": "octal first, then symbolic"
            },
            {
              "type": "heading",
              "text": "3. Mistakes",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "`chmod 777` opens the file to ==everyone==; give the exact bit needed",
                "`chmod -R 755` gives plain files **x** too: the mode is applied as given"
              ],
              "style": "cross",
              "ink": "red"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Capital X",
              "text": "`chmod -R u=rwX,go=rX dir` adds x to ==directories only==."
            }
          ]
        }
      ]
    },
    {
      "title": "Users, Groups, chown and sudo",
      "role": "outline",
      "outlineIndex": 3,
      "pages": [
        {
          "title": "Users, Groups, chown and sudo",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Owners and accounts",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "Each file has ==one owner user== and ==one owner group==",
                "`id` and `whoami` show who you are",
                "Accounts: `/etc/passwd`; groups: `/etc/group`"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "heading",
              "text": "2. chown, chgrp, groups",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "Command",
                "Effect",
                "Who"
              ],
              "rows": [
                [
                  "`chown alice:devs f`",
                  "owner + group",
                  "{red:root} only"
                ],
                [
                  "`chown -R`",
                  "recurses",
                  "root only"
                ],
                [
                  "`chgrp devs f`",
                  "group only",
                  "owner, if member"
                ]
              ]
            },
            {
              "type": "code",
              "lang": "bash",
              "lines": [
                "sudo usermod -aG docker alice"
              ],
              "note": "without -a, other groups are dropped; log in again"
            },
            {
              "type": "heading",
              "text": "3. sudo",
              "ink": "purple"
            },
            {
              "type": "bullets",
              "items": [
                "`sudo cmd` runs as root with ==your== password",
                "Only if you are listed in `/etc/sudoers`",
                "`sudo -i` opens a root shell",
                "Edit the list only with `visudo`"
              ],
              "style": "dot"
            },
            {
              "type": "heading",
              "text": "4. Mistakes",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "`sudo` on everything leaves root-owned files in ~",
                "Fix ownership with `chown`, don't run as root"
              ],
              "style": "cross",
              "ink": "red"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Redirect runs as you",
              "text": "`sudo echo x > f` fails. Use `echo x | sudo tee f`"
            }
          ]
        }
      ]
    },
    {
      "title": "Links: Hard vs Symbolic",
      "role": "outline",
      "outlineIndex": 4,
      "pages": [
        {
          "title": "Links: Hard vs Symbolic",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Names and Inodes",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "Each file name points to an ==inode==",
                "Inode = **metadata** + pointers to the data blocks",
                "A link is another name or pointer to it"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "heading",
              "text": "2. Hard vs Symbolic",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "",
                "Hard link",
                "Symlink"
              ],
              "rows": [
                [
                  "Make",
                  "`ln target link`",
                  "`ln -s target link`"
                ],
                [
                  "Is",
                  "2nd name, same inode",
                  "small file holding a path"
                ],
                [
                  "Target deleted",
                  "data survives to last name",
                  "{red:dangling}"
                ],
                [
                  "Cross fs / dirs",
                  "{red:no}",
                  "{green:yes}"
                ],
                [
                  "`ls -l`",
                  "plain `-`",
                  "`l` and `->`"
                ]
              ],
              "highlightRow": 2
            },
            {
              "type": "code",
              "lang": "bash",
              "lines": [
                "ln a.txt hard.txt",
                "ln -s a.txt soft.txt",
                "ls -li"
              ],
              "note": "-i shows the inode number"
            },
            {
              "type": "heading",
              "text": "3. Common Mistakes",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "`ln -s` order: ==target first==, then link name",
                "Relative target resolves from the **link's folder**, not your cwd"
              ],
              "style": "cross",
              "frame": "dashed",
              "ink": "red"
            },
            {
              "type": "sidebox",
              "title": "Interview Point",
              "items": [
                "**Target deleted?** Hard link keeps data; symlink dangles",
                "**Why no cross-filesystem hard link?** Inodes are per filesystem"
              ],
              "ink": "orange"
            }
          ]
        }
      ]
    },
    {
      "title": "Cheat Sheet: Files, Permissions, Users and Links",
      "role": "outline",
      "outlineIndex": 5,
      "pages": [
        {
          "title": "Cheat Sheet: Files, Permissions, Users and Links",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Navigate and Manage",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "`pwd`, `cd -`, `ls -lah`, `tree -L 2`",
                "Paths: `/` ==absolute==, `../` parent, `~` home"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "code",
              "lang": "bash",
              "lines": [
                "cp -a src dst   # keeps perms, times",
                "mv old new      # move or rename",
                "rm -r dir       # no undo",
                "mkdir -p a/b/c",
                "touch f",
                "find . -name \"*.py\" -type f"
              ]
            },
            {
              "type": "heading",
              "text": "2. Octal Modes",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "Octal",
                "Bits"
              ],
              "rows": [
                [
                  "7",
                  "`rwx`"
                ],
                [
                  "6",
                  "`rw-`"
                ],
                [
                  "5",
                  "`r-x`"
                ],
                [
                  "4",
                  "`r--`"
                ],
                [
                  "0",
                  "`---`"
                ]
              ]
            },
            {
              "type": "bullets",
              "items": [
                "{green:644} files, {blue:755} scripts and dirs, {red:600} SSH keys, {purple:700} private dirs"
              ],
              "style": "check"
            },
            {
              "type": "heading",
              "text": "3. Access, Users and Links",
              "ink": "purple"
            },
            {
              "type": "bullets",
              "items": [
                "`chmod u+x f`; `chown user:group f` (new owner needs root)",
                "`usermod -aG group user`; `id` lists your groups",
                "`sudo -i` root shell; `visudo` edits sudoers",
                "Hard link: ==second name==, same inode. Symlink: a **path** pointer"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "purple"
            },
            {
              "type": "code",
              "lang": "bash",
              "lines": [
                "ln target hard",
                "ln -s target link",
                "ls -li            # inode numbers",
                "readlink -f link  # resolve symlink"
              ]
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Mistakes",
              "text": "`chmod -R 755` makes plain files executable: use `X`. `usermod` without `-a` drops other groups."
            }
          ]
        }
      ]
    },
    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "A file is `-rw-r----- alice devs`. Bob is in `devs`. Can Bob read it? Write to it?",
              "a_bullets": [
                "Read: ==yes==, group bits are `r--`.",
                "Write: ==no==, the group has no `w`."
              ]
            },
            {
              "type": "qa",
              "q": "`sudo echo x > /etc/motd` says permission denied. Why, and what fixes it?",
              "a_bullets": [
                "The redirect `>` is done by your shell, not by sudo.",
                "Fix: `echo x | sudo tee /etc/motd`."
              ]
            },
            {
              "type": "qa",
              "q": "After these commands, what do the two `cat` lines show?",
              "example_code": [
                "ln data.txt h",
                "ln -s data.txt s",
                "rm data.txt",
                "cat h; cat s"
              ],
              "a_bullets": [
                "`cat h` prints the contents: the inode lives on while a name remains.",
                "`cat s` fails with no such file: the symlink is dangling."
              ]
            }
          ]
        }
      ]
    }
  ]
}