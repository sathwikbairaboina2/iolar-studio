              "type": "heading",
              "text": "1. Linters vs Static Analysis",
              "ink": "green"
            },
            {
              "type": "table",
              "headers": [
                "Kind",
                "Finds, without running code",
                "Tools"
              ],
              "rows": [
                [
                  "==Linter==",
                  "style issues, likely bugs",
                  "ESLint, Ruff, Pylint, golangci-lint"
                ],
                [
                  "Formatter",
                  "layout only",
                  "Prettier, Black"
                ],
                [
                  "==Type checker==",
                  "type defects",
                  "tsc, mypy"
                ],
                [
                  "==Security scanner==",
                  "taint flows, unsafe patterns",
                  "Semgrep, CodeQL, Bandit"
                ]
              ],
              "frame": "dashed"
            },
            {
              "type": "heading",
              "text": "2. Everyday Commands",
              "ink": "blue"
            },
            {
              "type": "code",
              "lang": "bash",
              "lines": [
                "eslint . --fix",
                "ruff check .",
