              }
            },
            {
              "type": "heading",
              "text": "2. Mistake: Over-Mocking",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "Everything mocked: tests pass, ==production breaks==",
                "Asserting internal calls breaks on every refactor"
              ],
              "style": "cross",
              "ink": "red"
            },
            {
              "type": "code",
              "lang": "python",
              "lines": [
                "assert order.total == 42  # output: good",
                "db.save.assert_called_once()  # internal: avoid"
              ],
              "note": "check what the code returns or does"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Assert behaviour",
              "text": "Check ==behaviour and outputs==, not which internal calls were made."
            }
          ]
        }
      ]
