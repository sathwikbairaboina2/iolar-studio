    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "A function has `if vip: price *= 0.9` with no else. One test calls it with vip=True. What are line and branch coverage?",
              "a_bullets": [
                "Line coverage: 100%, every line ran",
                "Branch coverage: 50%, the vip=False path never ran",
                "Add a vip=False test"
              ]
            },
            {
              "type": "qa",
              "q": "A test does `sleep(1)` then asserts a job finished. It fails 1 run in 10 in CI. What is the fix?",
              "a_bullets": [
                "Timing flake: CI is sometimes slower than 1 second",
                "Wait on the condition with a timeout, not a fixed sleep",
                "Auto-retry would only hide it"
              ]
            },
            {
              "type": "qa",
              "q": "Every test mocks the database layer and is green, yet a renamed column breaks production. Why?",
              "a_bullets": [
                "Mocks never check the real schema",
                "Add an integration test against a real database"
              ]
            }
          ]
        }
