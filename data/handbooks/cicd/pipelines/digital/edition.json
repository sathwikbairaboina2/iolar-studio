  "sections": [
    {
      "title": "CI vs Delivery vs Deployment",
      "role": "outline",
      "outlineIndex": 0,
      "pages": [
        {
          "title": "CI vs Delivery vs Deployment",
          "blocks": [
            {
              "type": "heading",
              "text": "1. The Three Terms",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "{green:Continuous integration}: merge ==small changes== to main often; every push builds and runs tests",
                "{blue:Continuous delivery}: every passing build is ==releasable==; a human approves the production release",
                "{purple:Continuous deployment}: every passing build ==goes to production== automatically, no manual gate"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "heading",
              "text": "2. Where They Differ",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "",
                "CI",
                "Delivery",
                "Deployment"
              ],
              "rows": [
                [
                  "Build + test each push",
                  "yes",
                  "yes",
                  "yes"
                ],
                [
                  "Last step",
                  "Stops at **tested**",
                  "Waits for **approval**",
                  "**Auto-releases**"
                ],
                [
                  "Manual gate",
                  "none",
                  "{orange:before production}",
                  "none"
                ]
              ],
              "highlightRow": 1
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "Push",
                    "ink": "black"
                  },
                  {
                    "text": "Build + test",
                    "sub": "CI ends here",
                    "ink": "green"
                  },
                  {
                    "text": "Approve",
                    "sub": "delivery only",
                    "ink": "orange"
                  },
                  {
                    "text": "Production",
                    "sub": "deployment skips approval",
                    "ink": "purple"
                  }
                ]
              }
            },
            {
              "type": "heading",
              "text": "3. Fail Fast",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "A ==red stage== stops every stage after it",
                "A broken main branch is ==fixed first==, before new work"
              ],
              "style": "check"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Remember",
              "text": "The three differ only in the ==last step==: tested, approved, or auto-released."
            }
          ]
        }
      ]
    },
    {
      "title": "Pipeline Stages and Triggers",
      "role": "outline",
      "outlineIndex": 1,
      "pages": [
        {
          "title": "Pipeline Stages and Triggers",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Stage Order",
              "ink": "blue"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "Checkout",
                    "ink": "blue"
                  },
                  {
                    "text": "Install",
                    "ink": "blue"
                  },
                  {
                    "text": "Lint",
                    "ink": "green"
                  },
                  {
                    "text": "Test",
                    "ink": "green"
                  },
                  {
                    "text": "Build",
                    "ink": "purple"
                  },
                  {
                    "text": "Package",
                    "ink": "purple"
                  },
                  {
                    "text": "Staging",
                    "ink": "orange"
                  },
                  {
                    "text": "Production",
                    "ink": "red"
                  }
                ]
              }
            },
            {
              "type": "bullets",
              "items": [
                "==Cheap, fast checks== (lint, unit tests) run first",
                "Failures surface early, before slow build and deploy stages"
              ],
              "style": "dot"
            },
            {
              "type": "heading",
              "text": "2. Triggers",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "`push` and `pull_request`: code changes",
                "`schedule` (cron): nightly or periodic runs",
                "`workflow_dispatch`: manual run button",
                "`release`: a release is published",
                "Filter with ==branches==, ==tags==, ==paths==: docs-only changes skip the full pipeline"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "code",
              "lang": "yaml",
              "lines": [
                "on:",
                "  push:",
                "    branches: [main]",
                "    paths-ignore: ['docs/**']",
                "  pull_request:",
                "  schedule:",
                "    - cron: '0 2 * * *'",
                "  workflow_dispatch:"
              ],
              "note": "push runs only for main, and never for docs-only edits"
            },
            {
              "type": "heading",
              "text": "3. Gating Production",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "`needs:` ==orders jobs==; without it jobs run in parallel",
                "An `environment` with required reviewers pauses for ==approval=="
              ],
              "style": "check"
            },
            {
              "type": "code",
              "lang": "yaml",
              "lines": [
                "deploy-prod:",
                "  needs: [test, deploy-staging]",
                "  environment: production",
                "  runs-on: ubuntu-latest"
              ]
            }
          ]
        }
      ]
    },
    {
      "title": "GitHub Actions Workflow Anatomy",
      "role": "outline",
      "outlineIndex": 2,
      "pages": [
        {
          "title": "GitHub Actions Workflow Anatomy",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Anatomy",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "==Workflow== = YAML file in `.github/workflows/`",
                "Contains **jobs**; each job contains **steps**",
                "Jobs run ==in parallel==, each on its own runner (`runs-on: ubuntu-latest`)",
                "`needs:` chains jobs in order"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "heading",
              "text": "2. Steps and a minimal workflow",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "`uses:` = reusable action, pinned: `actions/checkout@v4`",
                "`run:` = shell command",
                "Trigger `on: [push]` → `jobs: test:` → steps"
              ],
              "style": "dot"
            },
            {
              "type": "code",
              "lang": "yaml",
              "lines": [
                "jobs:",
                "  test:",
                "    runs-on: ubuntu-latest",
                "    steps:",
                "      - uses: actions/checkout@v4",
                "      - uses: actions/setup-node@v4",
                "      - run: npm ci",
                "      - run: npm test"
              ],
              "note": "Add on: [push] above jobs:"
            },
            {
              "type": "heading",
              "text": "3. Passing config",
              "ink": "purple"
            },
            {
              "type": "table",
              "headers": [
                "Key",
                "Gives you",
                "Example"
              ],
              "rows": [
                [
                  "`env:`",
                  "plain variables",
                  "`NODE_ENV: test`"
                ],
                [
                  "`secrets.NAME`",
                  "encrypted values",
                  "`${{ secrets.NPM_TOKEN }}`"
                ],
                [
                  "`matrix:`",
                  "one job per combination",
                  "`node: [18, 20]`, `os: [ubuntu-latest, windows-latest]`"
                ]
              ],
              "highlightRow": 2
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Order",
              "text": "Jobs have no order unless you add ==needs:==. Steps always run top to bottom."
            }
          ]
        }
      ]
    },
    {
      "title": "Artifacts and Caching",
      "role": "outline",
      "outlineIndex": 3,
      "pages": [
        {
          "title": "Artifacts and Caching",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Artifacts pass outputs",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "==Artifacts== = build outputs (a binary, a test report)",
                "Save: `actions/upload-artifact`; fetch later: `download-artifact`",
                "Jobs run on {red:fresh runners} and share ==no files==",
                "Passing a build between jobs needs an artifact"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "build job",
                    "sub": "upload-artifact",
                    "ink": "green"
                  },
                  {
                    "text": "artifact store",
                    "sub": "kept for download",
                    "ink": "purple"
                  },
                  {
                    "text": "deploy job",
                    "sub": "download-artifact",
                    "ink": "blue"
                  }
                ]
              }
            },
            {
              "type": "heading",
              "text": "2. Cache speeds installs",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "`actions/cache` stores dependencies, needs `path:` and `key:`",
                "Key = ==lockfile hash==: `hashFiles('**/package-lock.json')`",
                "`restore-keys:` = fallback prefix when no exact match"
              ],
              "style": "check",
              "ink": "blue"
            },
            {
              "type": "code",
              "lang": "yaml",
              "lines": [
                "- uses: actions/cache@v4",
                "  with:",
                "    path: ~/.npm",
                "    key: npm-${{ hashFiles('**/package-lock.json') }}",
                "    restore-keys: npm-"
              ]
            },
            {
              "type": "heading",
              "text": "3. Artifact vs cache",
              "ink": "purple"
            },
            {
              "type": "table",
              "headers": [
                "",
                "Artifact",
                "Cache"
              ],
              "rows": [
                [
                  "Role",
                  "**output** of a run",
                  "**input** reused"
                ],
                [
                  "Goal",
                  "download, pass to jobs",
                  "save time"
                ],
                [
                  "Lifetime",
                  "kept",
                  "{red:can be evicted}"
                ]
              ],
              "frame": "dashed"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Key on the lockfile",
              "text": "No hash in the key: stale dependencies are restored, or the cache never updates."
            }
          ]
        }
      ]
    },
    {
      "title": "Common CI/CD Mistakes",
      "role": "outline",
      "outlineIndex": 4,
      "pages": [
        {
          "title": "Common CI/CD Mistakes",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Mistakes and Fixes",
              "ink": "red"
            },
            {
              "type": "table",
              "headers": [
                "Mistake",
                "Result",
                "Fix"
              ],
              "rows": [
                [
                  "Cache key, no lockfile hash",
                  "Stale deps, or cache never updates",
                  "`hashFiles('**/package-lock.json')`"
                ],
                [
                  "Secrets in YAML or logs",
                  "Leaked credentials",
                  "`secrets.NAME`; forked PRs get none"
                ],
                [
                  "`@main` action, `latest` runner",
                  "Build breaks unexpectedly",
                  "Pin a version or SHA"
                ],
                [
                  "Missing `needs:`",
                  "Deploy runs before tests pass",
                  "`needs: test`"
                ],
                [
                  "Missing `permissions:`",
                  "Token has too much access",
                  "Least privilege"
                ]
              ],
              "frame": "dashed"
            },
            {
              "type": "heading",
              "text": "2. Safer Job",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "Pin the runner and action, order with ==needs==, shrink the token with ==permissions=="
              ],
              "style": "check"
            },
            {
              "type": "code",
              "lang": "yaml",
              "lines": [
                "permissions:",
                "  contents: read",
                "jobs:",
                "  deploy:",
                "    needs: test",
                "    runs-on: ubuntu-24.04",
                "    steps:",
                "      - uses: actions/checkout@v4"
              ]
            },
            {
              "type": "heading",
              "text": "3. Slow and Flaky",
              "ink": "orange"
            },
            {
              "type": "bullets",
              "items": [
                "Slow, flaky pipelines get **ignored**",
                "==Parallelise== independent jobs",
                "==Cache== dependencies",
                "Fix or ==quarantine== flaky tests"
              ],
              "style": "cross"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Secrets",
              "text": "Never echo a secret into logs. Forked PRs do not receive secrets."
            }
          ]
        }
      ]
    },
    {
      "title": "CI/CD Cheat Sheet",
      "role": "outline",
      "outlineIndex": 5,
      "pages": [
        {
          "title": "CI/CD Cheat Sheet",
          "blocks": [
            {
              "type": "heading",
              "text": "1. CI vs Delivery vs Deployment",
              "ink": "green"
            },
            {
              "type": "table",
              "headers": [
                "",
                "Every push",
                "Production"
              ],
              "rows": [
                [
                  "**CI**",
                  "build + test",
                  "not covered"
                ],
                [
                  "**Delivery**",
                  "releasable",
                  "{orange:manual approval}"
                ],
                [
                  "**Deployment**",
                  "releasable",
                  "{green:auto-release}"
                ]
              ],
              "highlightRow": 2
            },
            {
              "type": "heading",
              "text": "2. Workflow File and Triggers",
              "ink": "blue"
            },
            {
              "type": "code",
              "lang": "yaml",
              "lines": [
                "on: [push, workflow_dispatch]",
                "jobs:",
                "  test:",
                "    runs-on: ubuntu-latest",
                "    steps:",
                "      - uses: actions/checkout@v4",
                "      - run: npm ci"
              ],
              "note": ".github/workflows/ci.yml: on → jobs → runs-on → steps"
            },
            {
              "type": "bullets",
              "items": [
                "Triggers: `push`, `pull_request`, `schedule`, `workflow_dispatch`",
                "Filter with ==branches==, ==tags== and ==paths==",
                "Step = `uses` (action) or `run` (shell)"
              ],
              "style": "dot"
            },
            {
              "type": "heading",
              "text": "3. Sharing and Safety",
              "ink": "purple"
            },
            {
              "type": "bullets",
              "items": [
                "`needs:` orders jobs",
                "==Artifacts== pass files between jobs",
                "`actions/cache` key from the ==lockfile hash==: faster installs"
              ],
              "style": "check"
            },
            {
              "type": "sidebox",
              "title": "Safety",
              "items": [
                "Secrets store, never YAML",
                "Pinned action versions",
                "Least-privilege `permissions:`",
                "Approval environment for production"
              ],
              "ink": "red"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Common mistake",
              "text": "No `needs:` means deploy can start before tests pass."
            }
          ]
        }
      ]
    },
    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "`deploy` has no `needs:` and `test` fails. What happens to `deploy`?",
              "a_bullets": [
                "Jobs run in ==parallel==, so `deploy` still starts",
                "Fix: add `needs: test`"
              ]
            },
            {
              "type": "qa",
              "q": "Cache key is the fixed string `npm-cache`. You add a dependency. What is restored?",
              "a_bullets": [
                "The ==old cache==, because the key still matches and is never updated",
                "Fix: add `hashFiles('**/package-lock.json')` to the key"
              ]
            },
            {
              "type": "qa",
              "q": "`build` writes `dist/`, then `deploy` (with `needs: build`) cannot find it. Why?",
              "a_bullets": [
                "Each job gets a ==fresh runner==, so no files are shared",
                "Fix: `upload-artifact` in `build`, `download-artifact` in `deploy`"
              ]
            }
          ]
        }
      ]
    }
  ]
}