      ]
    },
    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "A dashboard adds a `user_id` label to a request counter. You have 1 million users. What breaks?",
              "a_bullets": [
                "Each label value makes its own time series: about 1M series per metric.",
                "Storage and query cost explode. Put user_id in logs or traces."
              ]
            },
            {
              "type": "qa",
              "q": "The SLO is 99.9% over 30 days and you have already had 30 minutes of downtime. Budget left?",
              "a_bullets": [
                "Budget is about 43 min, so roughly 13 min remain.",
                "Another outage that long would exhaust it and trigger a release freeze."
              ]
            },
            {
              "type": "qa",
              "q": "A bad deploy shipped with a migration that dropped a column. Roll back or roll forward?",
              "a_bullets": [
                "Roll forward: the old version needs the dropped column, so rollback is unsafe.",
                "Mitigate first, for example by toggling a flag, then ship the fix."
              ]
            }
          ]
        }
      ]
    }
  ]
