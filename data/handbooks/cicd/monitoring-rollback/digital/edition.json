  "sections": [
    {
      "title": "Logs, Metrics and Traces: The Mental Model",
      "role": "outline",
      "outlineIndex": 0,
      "pages": [
        {
          "title": "Logs, Metrics and Traces: The Mental Model",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Observability vs Monitoring",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "==Observability==: explain {green:unknown failures} from outside, using emitted telemetry",
                "==Monitoring==: checks only {blue:known} failure conditions"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "heading",
              "text": "2. The Three Signals",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "",
                "Metrics",
                "Traces",
                "Logs"
              ],
              "rows": [
                [
                  "Is",
                  "Numeric time series",
                  "Spans sharing one **trace ID**",
                  "Timestamped event records"
                ],
                [
                  "Strength",
                  "Cheap, aggregatable",
                  "Follows one request across services",
                  "Detail on one event"
                ],
                [
                  "Answers",
                  "==THAT== it is wrong",
                  "==WHERE==",
                  "==WHY=="
                ],
                [
                  "Cost",
                  "Cheapest",
                  "–",
                  "Highest at volume"
                ]
              ],
              "highlightRow": 2
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "Metric alert",
                    "sub": "THAT",
                    "ink": "blue"
                  },
                  {
                    "text": "Trace",
                    "sub": "WHERE",
                    "ink": "purple"
                  },
                  {
                    "text": "Log line",
                    "sub": "WHY",
                    "ink": "orange"
                  }
                ]
              }
            },
            {
              "type": "heading",
              "text": "3. Cardinality Mistake",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "User ID or request ID as a ==metric label==",
                "Every value makes a new series: {red:series count and cost explode}",
                "Put them in {green:logs and traces} instead"
              ],
              "style": "cross",
              "frame": "dashed",
              "ink": "red"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Remember",
              "text": "Metrics **detect**, traces **locate**, logs **explain**. Keep ==high-cardinality== values out of labels."
            }
          ]
        }
      ]
    },
    {
      "title": "The Four Golden Signals",
      "role": "outline",
      "outlineIndex": 1,
      "pages": [
        {
          "title": "The Four Golden Signals",
          "blocks": [
            {
              "type": "heading",
              "text": "1. The Four Signals",
              "ink": "green"
            },
            {
              "type": "table",
              "headers": [
                "Signal",
                "Measures",
                "Example"
              ],
              "rows": [
                [
                  "{blue:Latency}",
                  "time to serve a request",
                  "p99 of `/checkout`"
                ],
                [
                  "{green:Traffic}",
                  "demand",
                  "requests per second"
                ],
                [
                  "{red:Errors}",
                  "rate of failed requests",
                  "5xx, wrong content, too slow"
                ],
                [
                  "{orange:Saturation}",
                  "how full the tightest resource is",
                  "CPU, memory, disk, pool, queue depth"
                ]
              ],
              "frame": "dashed"
            },
            {
              "type": "bullets",
              "items": [
                "==Minimum dashboard== for any user-facing service",
                "Track latency for **successes** and **failures** separately",
                "A fast error response hides real slowness"
              ],
              "style": "dot"
            },
            {
              "type": "heading",
              "text": "2. RED vs USE",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "Method",
                "Letters",
                "Suits"
              ],
              "rows": [
                [
                  "==RED==",
                  "rate, errors, duration",
                  "request-driven services"
                ],
                [
                  "==USE==",
                  "utilization, saturation, errors",
                  "resources: hosts, disks"
                ]
              ]
            },
            {
              "type": "heading",
              "text": "3. Average Latency Trap",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "Alerting on the mean: averages hide the slow tail",
                "Alert on ==p95== and ==p99== instead"
              ],
              "style": "cross",
              "ink": "red"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Mean 120ms, p99 3s",
              "text": "Still means **1 in 100 users** waits 3s."
            }
          ]
        }
      ]
    },
    {
      "title": "SLIs, SLOs and Error Budgets",
      "role": "outline",
      "outlineIndex": 2,
      "pages": [
        {
          "title": "SLIs, SLOs and Error Budgets",
          "blocks": [
            {
              "type": "heading",
              "text": "1. SLI, SLO, SLA",
              "ink": "green"
            },
            {
              "type": "table",
              "headers": [
                "Term",
                "Is",
                "Example"
              ],
              "rows": [
                [
                  "**SLI**",
                  "measured ==good / valid== events",
                  "successful requests ÷ total requests"
                ],
                [
                  "**SLO**",
                  "target for the SLI over a window",
                  "99.9% over 30 days"
                ],
                [
                  "**SLA**",
                  "contract with consequences",
                  "penalty if missed"
                ]
              ]
            },
            {
              "type": "heading",
              "text": "2. Error Budget and Burn Rate",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "Error budget = ==100% − SLO=="
              ],
              "style": "dot"
            },
            {
              "type": "table",
              "headers": [
                "SLO",
                "Downtime allowed per 30 days"
              ],
              "rows": [
                [
                  "99.9%",
                  "about **43 min**"
                ],
                [
                  "99.99%",
                  "about **4.3 min**"
                ]
              ]
            },
            {
              "type": "bullets",
              "items": [
                "==Burn rate== = how fast the budget is spent",
                "{green:Burn rate 1}: budget ends exactly at the window end",
                "{red:Burn rate 10}: budget empty in a tenth of the window"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "blue"
            },
            {
              "type": "heading",
              "text": "3. Policy and Mistakes",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "{green:Budget healthy}: ship features faster",
                "{red:Budget spent}: freeze risky releases, fix reliability",
                "Internal SLO ==tighter== than the SLA"
              ],
              "style": "check"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Never aim for 100%",
              "text": "Unachievable, and each extra nine costs far more. Pick SLIs users feel (errors, latency), not server CPU."
            }
          ]
        }
      ]
    },
    {
      "title": "Alerting That Pages the Right Human",
      "role": "outline",
      "outlineIndex": 3,
      "pages": [
        {
          "title": "Alerting That Pages the Right Human",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Page on Symptoms",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "Alert on {green:symptoms} users feel",
                "Error rate, latency, ==SLO burn==",
                "{red:Not causes}: CPU at 80%",
                "Page only if a human must **act now**",
                "Rest: ticket or dashboard"
              ],
              "style": "check",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "heading",
              "text": "2. Burn Rate vs Threshold",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "",
                "Threshold",
                "Burn rate"
              ],
              "rows": [
                [
                  "Tied to SLO",
                  "{red:No}",
                  "{green:Yes}"
                ],
                [
                  "Brief spike",
                  "Noisy",
                  "Tolerated"
                ]
              ],
              "frame": "dashed"
            },
            {
              "type": "bullets",
              "items": [
                "{red:Page}: 1h **and** 5m both above ==~14x== (~2% budget in 1h)",
                "{blue:Ticket}: ~1x slow burn over 3 days",
                "Short 5m window: resets fast after recovery",
                "`for:` stops a single blip firing"
              ],
              "style": "dot"
            },
            {
              "type": "code",
              "lang": "yaml",
              "lines": [
                "alert: HighErrorRate",
                "expr: sum(rate(http_requests_total{code=~\"5..\"}[5m])) / sum(rate(http_requests_total[5m])) > 0.01",
                "for: 5m",
                "annotations:",
                "  runbook: https://wiki.example.com/runbooks/high-errors"
              ]
            },
            {
              "type": "heading",
              "text": "3. Alert Fatigue",
              "ink": "red"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Noisy pages",
              "text": "Non-actionable pages get ignored. Every alert needs an ==owner== and a ==runbook==. Delete or demote what nobody acts on."
            },
            {
              "type": "sidebox",
              "title": "Interview Point",
              "items": [
                "**Why symptoms?** Users feel them; causes may be harmless",
                "**Multi-window?** Long and short burn rates both high",
                "**Actionable?** Owner, runbook, needs a human now",
                "**Fatigue?** Delete or demote unused alerts"
              ],
              "ink": "orange"
            }
          ]
        }
      ]
    },
    {
      "title": "Rollback vs Roll Forward and Incident Basics",
      "role": "outline",
      "outlineIndex": 4,
      "pages": [
        {
          "title": "Rollback vs Roll Forward and Incident Basics",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Rollback or Roll Forward",
              "ink": "green"
            },
            {
              "type": "table",
              "headers": [
                "",
                "Rollback",
                "Roll forward"
              ],
              "rows": [
                [
                  "Does",
                  "Redeploy last good version",
                  "Ship a fix on top"
                ],
                [
                  "Default when",
                  "Recent deploy caused it",
                  "Rollback is unsafe"
                ]
              ],
              "highlightRow": 0
            },
            {
              "type": "bullets",
              "items": [
                "Roll forward: ==irreversible== migration, or data in a new format",
                "Roll forward: one-line fix faster than a redeploy",
                "==Expand/contract== migrations and flags keep rollback possible"
              ],
              "style": "check",
              "ink": "green"
            },
            {
              "type": "heading",
              "text": "2. Incident Response",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "Role",
                "Job"
              ],
              "rows": [
                [
                  "Commander",
                  "Coordinates, decides"
                ],
                [
                  "Ops lead",
                  "Fixes"
                ],
                [
                  "Comms lead",
                  "Updates stakeholders"
                ],
                [
                  "Declare",
                  "SEV1 = full outage; one channel, one timeline"
                ]
              ]
            },
            {
              "type": "paragraph",
              "text": "Commands: undo rollout, check status, recent logs, revert commit."
            },
            {
              "type": "code",
              "lang": "bash",
              "lines": [
                "kubectl rollout undo deployment/api",
                "kubectl rollout status deployment/api",
                "kubectl logs deploy/api --since=15m",
                "git revert <sha>"
              ]
            },
            {
              "type": "heading",
              "text": "3. Postmortem and Mistakes",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "==Blameless==: timeline, impact, root cause, contributing factors, what went well",
                "Action items need ==owners and dates==; judge the system, not the person",
                "Track ==MTTD== detect, ==MTTA== acknowledge, ==MTTR== recover"
              ],
              "style": "dot",
              "ink": "red"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Mitigate first",
              "text": "Stop impact by rollback, failover or flag before debugging live. An untested rollback, or one skipping the schema change, fails."
            }
          ]
        }
      ]
    },
    {
      "title": "Cheat Sheet: Observability, SLOs and Incidents",
      "role": "outline",
      "outlineIndex": 5,
      "pages": [
        {
          "title": "Cheat Sheet: Observability, SLOs and Incidents",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Signals and SLO math",
              "ink": "green"
            },
            {
              "type": "table",
              "headers": [
                "Pillar",
                "Tells you"
              ],
              "rows": [
                [
                  "Metrics",
                  "{red:THAT} it broke"
                ],
                [
                  "Traces",
                  "{blue:WHERE}"
                ],
                [
                  "Logs",
                  "{green:WHY}"
                ]
              ]
