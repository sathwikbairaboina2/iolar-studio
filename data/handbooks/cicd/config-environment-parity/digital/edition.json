                "Feature flag"
              ],
              "rows": [
                [
                  "Set",
                  "per deploy",
                  "per request or user"
                ],
                [
                  "Change needs",
                  "==restart or redeploy==",
                  "{green:no deploy}"
                ]
              ]
            },
            {
              "type": "heading",
              "text": "2. Flag Types",
              "ink": "purple"
            },
            {
              "type": "table",
              "headers": [
                "Type",
                "Use",
                "Life"
              ],
              "rows": [
                [
                  "Release",
                  "hide unfinished code",
                  "short"
                ],
                [
                  "Ops",
                  "kill switch",
                  "varies"
                ],
                [
                  "Experiment",
                  "A/B test",
                  "short"
                ],
                [
                  "Permission",
                  "entitlement",
                  "==long-lived=="
                ]
              ]
            },
            {
              "type": "heading",
              "text": "3. Mechanism and Rollout",
              "ink": "blue"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "App",
                    "sub": "sends user context",
                    "ink": "blue"
                  },
                  {
                    "text": "Flag service",
                    "sub": "LaunchDarkly, Unleash, OpenFeature",
                    "ink": "purple"
                  },
                  {
                    "text": "Decision",
                    "sub": "new_flow or old_flow",
                    "ink": "green"
                  }
                ]
              }
            },
            {
              "type": "bullets",
              "items": [
                "`if flags.enabled('new-checkout', user)`: new_flow(), else old_flow()",
                "Ship **dark**, ramp ==1% → 10% → 100%==, then delete the flag",
                "Percentage rollout ==hashes the user ID==, so each user stays consistent"
              ],
              "style": "dot"
            },
            {
              "type": "code",
              "lang": "python",
              "lines": [
                "import hashlib, os",
                "def enabled(flag, user):",
                "    pct = int(os.environ.get('ROLLOUT_PCT', '10'))",
                "    h = int(hashlib.sha256(f'{flag}:{user}'.encode()).hexdigest(), 16)",
                "    return h % 100 < pct",
                "print(enabled('new-checkout', 'u42') == enabled('new-checkout', 'u42'))"
              ],
              "note": "same user, same answer"
            },
            {
              "type": "code",
              "lang": "output",
              "lines": [
                "True"
              ]
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Flag rot",
              "text": "Old flags become tech debt and untested paths. Give each an ==owner and expiry date==; default to the **safe value** if the flag service is down."
            }
          ]
        }
      ]
    },
    {
      "title": "Ephemeral Preview Environments and Migrations in the Pipeline",
      "role": "outline",
