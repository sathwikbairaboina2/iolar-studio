    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "Code reads `os.environ.get('DB_URL', 'postgres://localhost/app')`. Prod forgets to set DB_URL. What happens, and what's the fix?",
              "a_bullets": [
                "It boots with the default and points at localhost, not the real database.",
                "Use `os.environ['DB_URL']` so a missing var crashes at startup."
              ]
            },
            {
              "type": "qa",
              "q": "A release renames column `name` to `full_name` in a migration, then rolls out new pods gradually. What breaks?",
              "a_bullets": [
                "Old pods still run and query `name`, so they error mid-rollout.",
                "Expand/contract: add `full_name`, deploy, backfill, drop `name` in a later release."
              ]
            },
            {
              "type": "qa",
              "q": "The file sets LOG_LEVEL=info, the environment sets LOG_LEVEL=debug, and the command runs with `--log-level=warn`. Which wins?",
              "a_bullets": [
                "`warn`: precedence is defaults, file, env var, then CLI flag, with the flag highest."
              ]
            }
          ]
        }
      ]
