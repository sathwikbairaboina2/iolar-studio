            {
              "type": "heading",
              "text": "1. Preview Environments",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "==Preview env== = full short-lived copy of the app, one per **pull request**",
                "Own URL: `pr-123.preview.example.com`",
                "Destroyed on {red:PR close or merge}; a ==TTL job== is the fallback",
                "Data is {green:seeded or anonymised}, never a production copy",
                "Own database or schema per preview; small instance sizes cap cost"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "PR open",
                    "sub": "build image",
                    "ink": "blue"
                  },
                  {
                    "text": "Deploy",
                    "sub": "namespace pr-123",
                    "ink": "green"
                  },
                  {
                    "text": "Seed DB",
                    "sub": "fake data",
                    "ink": "purple"
                  },
                  {
                    "text": "Post URL",
                    "sub": "comment on PR",
                    "ink": "orange"
                  }
                ]
              }
            },
            {
              "type": "code",
              "lang": "python",
              "lines": [
                "import os",
                "os.environ[\"PR_NUMBER\"] = \"123\"",
                "pr = os.environ[\"PR_NUMBER\"]",
                "print(f\"pr-{pr}.preview.example.com\")",
                "print(f\"namespace: pr-{pr}\")"
              ],
              "note": "URL and namespace both derive from the PR number"
            },
            {
              "type": "code",
              "lang": "output",
              "lines": [
                "pr-123.preview.example.com",
                "namespace: pr-123"
              ]
            },
            {
              "type": "heading",
              "text": "2. Migrations in the Pipeline",
              "ink": "purple"
            },
            {
              "type": "bullets",
              "items": [
                "Run as a ==separate step== before the app rollout",
                "Use a Kubernetes `Job` or a release-phase command",
                "Never run from every instance at boot: {red:races}"
              ],
              "style": "dot",
              "ink": "purple"
            },
            {
              "type": "diagram",
              "kind": "chain",
              "spec": {
                "title": "Expand / contract",
                "steps": [
                  {
                    "text": "Expand",
                    "note": "add nullable column",
                    "ink": "blue"
                  },
                  {
                    "text": "Deploy",
                    "note": "old and new code both work",
                    "ink": "green"
                  },
                  {
                    "text": "Backfill",
                    "note": "fill old rows",
                    "ink": "purple"
                  },
                  {
                    "text": "Contract",
                    "note": "drop old column later",
                    "ink": "red"
                  }
                ]
              }
            },
            {
              "type": "sidebox",
              "title": "Migration rules",
              "items": [
                "Never rename or drop in the same release",
                "Forward-only migrations",
                "Rollback = a **new** migration"
              ],
              "ink": "red"
            }
          ]
        }
      ]
