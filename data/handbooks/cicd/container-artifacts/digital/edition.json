  "sections": [
    {
      "title": "Build Once, Deploy Many: The Mental Model",
      "role": "outline",
      "outlineIndex": 0,
      "pages": [
        {
          "title": "Build Once, Deploy Many: The Mental Model",
          "blocks": [
            {
              "type": "heading",
              "text": "1. The Rule",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "CI ==builds the image once==; every environment runs that exact artifact",
                "Rebuilding per environment gives {red:different bytes} for the same commit",
                "So staging proves ==nothing about prod==",
                "Differences live in **runtime config**, never baked into the image"
              ],
              "style": "check",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "table",
              "headers": [
                "",
                "Rebuild per env",
                "Build once"
              ],
              "rows": [
                [
                  "Bytes",
                  "differ per build",
                  "identical"
                ],
                [
                  "Staging proves",
                  "nothing about prod",
                  "prod's exact image"
                ]
              ],
              "highlightRow": 1
            },
            {
              "type": "heading",
              "text": "2. Image Identity",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "Image = stack of ==immutable layers== plus a **manifest**",
                "The ==manifest hash== (digest) is its identity",
                "Same digest = same bytes everywhere"
              ],
              "style": "dot",
              "ink": "blue"
            },
            {
              "type": "heading",
              "text": "3. Pipeline and Config",
              "ink": "purple"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "Build",
                    "sub": "once",
                    "ink": "blue"
                  },
                  {
                    "text": "Test",
                    "ink": "green"
                  },
                  {
                    "text": "Scan",
                    "ink": "orange"
                  },
                  {
                    "text": "Push",
                    "sub": "registry",
                    "ink": "purple"
                  },
                  {
                    "text": "Promote",
                    "sub": "dev → staging → prod",
                    "ink": "red"
                  }
                ]
              }
            },
            {
              "type": "code",
              "lang": "bash",
              "lines": [
                "docker run -e APP_ENV=staging \\",
                "  --env-file staging.env \\",
                "  -v ./cfg:/etc/app myapp@sha256:<digest>"
              ],
              "note": "same image; env vars, secrets, mounted config differ"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Remember",
              "text": "Promote the ==same digest==; change only the config."
            }
          ]
        }
      ]
    },
    {
      "title": "Tags vs Immutable Digests",
      "role": "outline",
      "outlineIndex": 1,
      "pages": [
        {
          "title": "Tags vs Immutable Digests",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Tag vs digest",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "",
                "Tag",
                "Digest"
              ],
              "rows": [
                [
                  "Looks like",
                  "`myapp:1.4`",
                  "`sha256:...`"
                ],
                [
                  "Points to",
                  "{red:mutable} pointer, can be re-pushed",
                  "hash of the manifest"
                ],
                [
                  "Identity",
                  "a label",
                  "content-addressed, {green:immutable}"
                ]
              ],
              "highlightRow": 2
            },
            {
              "type": "heading",
              "text": "2. Reference and tag",
              "ink": "purple"
            },
            {
              "type": "bullets",
              "items": [
                "Tag with the ==git SHA==: `myapp:3f9c2ab`",
                "{red:Avoid} `:latest` in any deployed manifest",
                "`tag@digest` pins the digest; the tag is only a label"
              ],
              "style": "dot"
            },
            {
              "type": "code",
              "lang": "bash",
              "lines": [
                "docker pull myapp@sha256:<digest>",
                "docker pull myapp:1.4@sha256:<digest>"
              ]
            },
            {
              "type": "heading",
              "text": "3. Read the digest, lock the tag",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "Read the ==digest after push== with either command"
              ],
              "style": "dot"
            },
            {
              "type": "code",
              "lang": "bash",
              "lines": [
                "docker buildx imagetools inspect myapp:3f9c2ab",
                "docker inspect --format '{{index .RepoDigests 0}}' myapp:3f9c2ab"
              ]
            },
            {
              "type": "bullets",
              "items": [
                "Enable ==tag immutability== on the registry (ECR immutable tags)",
                "Re-pushing an existing tag is {red:rejected}"
              ],
              "style": "check"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Remember",
              "text": "Tags move, **digests don't**. Deploy by digest."
            }
          ]
        }
      ]
    },
    {
      "title": "Multi-Stage Builds and Layer Caching in CI",
      "role": "outline",
      "outlineIndex": 2,
      "pages": [
        {
          "title": "Multi-Stage Builds and Layer Caching in CI",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Multi-stage builds",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "`FROM node:22 AS build` compiles the app",
                "Final `node:22-slim` copies only artifacts: `COPY --from=build /app/dist ./dist`",
                "Compilers and dev dependencies stay behind: ==smaller image==, ==smaller attack surface=="
              ],
              "style": "dot",
              "ink": "green"
            },
            {
              "type": "code",
              "lang": "dockerfile",
              "lines": [
                "FROM node:22 AS build",
                "WORKDIR /app",
                "COPY package*.json ./",
                "RUN npm ci",
                "COPY . .",
                "RUN npm run build",
                "FROM node:22-slim",
                "COPY --from=build /app/dist ./dist"
              ],
              "note": "deps layer sits before the source layer"
            },
            {
              "type": "heading",
              "text": "2. Layer order for cache hits",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "Base image",
                "`COPY package*.json`, then install deps",
                "`COPY` source ==last==",
                "A changed layer invalidates {red:every layer after it}, so slowest-changing steps go first"
              ],
              "style": "number",
              "ink": "blue"
            },
            {
              "type": "heading",
              "text": "3. Cache in CI",
              "ink": "purple"
            },
            {
              "type": "bullets",
              "items": [
                "CI runners are ephemeral: the ==local cache is empty== each run, so export it to a registry"
              ],
              "style": "dot",
              "ink": "purple"
            },
            {
              "type": "code",
              "lang": "bash",
              "lines": [
                "docker buildx build \\",
                "  --cache-from type=registry,ref=myapp:cache \\",
                "  --cache-to type=registry,ref=myapp:cache,mode=max \\",
                "  -t myapp:3f9c2ab --push ."
              ]
            },
            {
              "type": "table",
              "headers": [
                "Option",
                "Use"
              ],
              "rows": [
                [
                  "`type=registry`",
                  "cache stored in the registry, works in any CI"
                ],
                [
                  "`type=gha`",
                  "GitHub Actions cache"
                ],
                [
                  "`RUN --mount=type=cache,target=/root/.npm`",
                  "BuildKit cache mount for package managers"
                ]
              ]
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": ".dockerignore",
              "text": "List `node_modules`, `.git`, `.env`: keeps the build context small and stops ==secrets leaking into layers==."
            }
          ]
        }
      ]
    },
    {
      "title": "Registries, Retention and Image Scanning",
      "role": "outline",
      "outlineIndex": 3,
      "pages": [
        {
          "title": "Registries, Retention and Image Scanning",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Registry and Retention",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "Registry stores images by ==repository==, ==tag== and ==digest==",
                "Examples: ECR, GHCR, Docker Hub, Harbor",
                "CI pushes with a {green:short-lived credential}, not a personal password"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "Lifecycle policy expires **untagged** and old images",
                "ECR example: keep last ==30==, expire untagged after ==7 days=="
              ],
              "style": "dot"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Keep deployed digests",
              "text": "Never expire a digest running in any environment, or rollbacks and pod restarts fail with ==ImagePullBackOff==."
            },
            {
              "type": "heading",
              "text": "2. Scanning",
              "ink": "purple"
            },
            {
              "type": "code",
              "lang": "bash",
              "lines": [
                "trivy image --severity HIGH,CRITICAL \\",
                "  --exit-code 1 myapp:3f9c2ab"
              ],
              "note": "CI gate: non-zero exit fails the build"
            },
            {
              "type": "table",
              "headers": [
                "Where",
                "When"
              ],
              "rows": [
                [
                  "Trivy or Grype in CI",
                  "before push or promotion"
                ],
                [
                  "Registry scan (ECR basic or enhanced)",
                  "on push"
                ],
                [
                  "Periodic rescan",
                  "new CVEs hit deployed images"
                ]
              ]
            },
            {
              "type": "heading",
              "text": "3. Trust",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "Scan results attach to a ==digest==, not a tag",
                "A gate result is valid only for that **exact image**",
                "Sign with `cosign`; verify at deploy to prove the digest came from your pipeline"
              ],
              "style": "check"
            }
          ]
        }
      ]
    },
    {
      "title": "Promoting the Same Image Across Environments",
      "role": "outline",
      "outlineIndex": 4,
      "pages": [
        {
          "title": "Promoting the Same Image Across Environments",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Promote, Never Rebuild",
              "ink": "green"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "Dev",
                    "sub": "sha256:<digest>",
                    "ink": "green"
                  },
                  {
                    "text": "Staging",
                    "sub": "same digest",
                    "ink": "blue"
                  },
                  {
                    "text": "Prod",
                    "sub": "same digest",
                    "ink": "purple"
                  }
                ]
              }
            },
            {
              "type": "bullets",
              "items": [
                "Promotion moves the ==same digest== forward",
                "A rebuild is a **new image**, so never rebuild",
                "Retagging adds a tag to the existing manifest: ==no layers copied=="
              ],
              "style": "dot"
            },
            {
              "type": "code",
              "lang": "bash",
              "lines": [
                "docker buildx imagetools create \\",
                "  -t myapp:prod \\",
                "  myapp@sha256:<digest>"
              ]
            },
            {
              "type": "heading",
              "text": "2. Deploy by Digest, Promote by Git",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "Manifests pin the digest, not a tag",
                "GitOps: a pipeline or PR ==bumps the digest== in the env's manifest or Helm values",
                "Git history is the **audit trail**; rollback is a `git revert`"
              ],
              "style": "dot"
            },
            {
              "type": "code",
              "lang": "yaml",
              "lines": [
                "containers:",
                "  - name: myapp",
                "    image: myapp@sha256:<digest>"
              ],
              "note": "Kubernetes Deployment"
            },
            {
              "type": "heading",
              "text": "3. Gates, Config, Rollback",
              "ink": "orange"
            },
            {
              "type": "table",
              "headers": [
                "Concern",
                "Rule"
              ],
              "rows": [
                [
                  "Gate",
                  "Tests, scan result and approval, judged on the **digest** to be deployed"
                ],
                [
                  "Config",
                  "Env vars, ConfigMaps, Secrets or a secrets manager, injected at ==runtime=="
                ],
                [
                  "Rollback",
                  "Redeploy the previous digest; works only if **retention kept it**"
                ]
              ]
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Remember",
              "text": "Same digest, different config per environment. Image bytes never change between dev and prod."
            }
          ]
        }
      ]
    },
    {
      "title": "Common Mistakes and Cheat Sheet",
      "role": "outline",
      "outlineIndex": 5,
      "pages": [
        {
          "title": "Common Mistakes and Cheat Sheet",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Four Mistakes",
              "ink": "red"
            },
            {
              "type": "table",
              "headers": [
                "Mistake",
                "Result",
                "Fix"
              ],
              "rows": [
                [
                  "Rebuild per environment",
                  "Prod runs an image no test saw",
                  "Build once, promote the digest"
                ],
                [
                  "Deploy `:latest` or a mutable tag",
                  "Nodes run different code",
                  "Deploy by digest, immutable tags"
                ],
                [
                  "Secrets or env config in layers",
                  "Readable in image history",
                  "Inject at runtime"
                ],
                [
                  "No registry cache in CI",
                  "Every run reinstalls deps",
                  "`--cache-from` / `--cache-to`"
                ]
              ],
              "highlightRow": 0
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Layers are forever",
              "text": "Deleting a secret in a later layer ==still leaves it== in image history. Rotate it, then inject at runtime."
            },
            {
              "type": "code",
              "lang": "bash",
              "lines": [
                "docker buildx build -t myapp:3f9c2ab --push \\",
                "  --cache-from type=registry,ref=myapp:cache \\",
                "  --cache-to type=registry,ref=myapp:cache,mode=max ."
              ],
              "note": "CI runners are ephemeral: cache lives in the registry"
            },
            {
              "type": "heading",
              "text": "2. Cheat Sheet",
              "ink": "green"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "Build once",
                    "ink": "blue"
                  },
                  {
                    "text": "Tag git SHA",
                    "ink": "blue"
                  },
                  {
                    "text": "Push",
                    "ink": "purple"
                  },
                  {
                    "text": "Record digest",
                    "ink": "purple"
                  },
                  {
                    "text": "Scan",
                    "ink": "orange"
                  },
                  {
                    "text": "Deploy by digest",
                    "ink": "green"
                  },
                  {
                    "text": "Promote",
                    "sub": "retag or manifest bump",
                    "ink": "green"
                  },
                  {
                    "text": "Retain digests",
                    "ink": "red"
                  }
                ]
              }
            },
            {
              "type": "bullets",
              "items": [
                "Promote: `docker buildx imagetools create -t myapp:prod myapp@sha256:<digest>`",
                "Never expire deployed digests, or rollback fails with ==ImagePullBackOff=="
              ],
              "style": "check"
            }
          ]
        }
      ]
    },
    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "CI pushes `myapp:1.4` on Monday. A hotfix job pushes `myapp:1.4` again on Tuesday. A prod pod restarts on a new node. What runs?",
              "a_bullets": [
                "The Tuesday image on the new node; older nodes still run Monday's",
                "Same tag, different code, because a tag is a mutable pointer",
                "Fix: deploy by digest, and turn on tag immutability"
              ]
            },
            {
              "type": "qa",
              "q": "Why does a one-line README edit reinstall every dependency here?",
              "a_bullets": [
                "`COPY . .` changes, so that layer and all later layers are invalidated, including `npm ci`",
                "Fix: copy `package*.json`, run the install, then `COPY . .` last"
              ],
              "example_code": [
                "COPY . .",
                "RUN npm ci"
              ]
            },
            {
              "type": "qa",
              "q": "A lifecycle policy keeps the last 30 images. Prod's digest is 45 images old. What happens on a pod restart?",
              "a_bullets": [
                "The digest was expired, so the pull fails with `ImagePullBackOff`",
                "Rollbacks break too",
                "Never expire digests deployed in any environment"
              ]
            }
          ]
        }
      ]
    }
  ]
}