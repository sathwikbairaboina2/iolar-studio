              ],
              "style": "check",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "Canary: start at ==1-5%== of traffic",
                "Compare **error rate** and **p99** with baseline",
                "Automate abort, then promote in steps"
              ],
              "style": "check",
              "ink": "purple"
            },
            {
              "type": "heading",
              "text": "3. Flags and Migrations",
              "ink": "orange"
            },
            {
              "type": "bullets",
              "items": [
                "Flag: default ==off==, percentage ramp, kill switch",
                "Owner and expiry; remove after rollout"
              ],
              "style": "check",
              "ink": "orange"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "Expand",
                    "ink": "green"
                  },
                  {
                    "text": "Dual-write",
                    "ink": "blue"
                  },
                  {
                    "text": "Backfill",
                    "ink": "purple"
                  },
                  {
                    "text": "Switch reads",
                    "ink": "orange"
                  },
                  {
                    "text": "Contract",
                    "sub": "later release",
                    "ink": "red"
                  }
                ]
              }
            },
            {
              "type": "bullets",
              "items": [
                "`CREATE INDEX CONCURRENTLY`, batched backfill, `lock_timeout`"
              ],
              "style": "check",
              "ink": "orange"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Destructive DDL",
              "text": "Never ship `DROP COLUMN` with the code change. Contract in a ==later release==."
