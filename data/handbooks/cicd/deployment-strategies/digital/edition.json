    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "A rolling update ships v2 after running `RENAME COLUMN name TO full_name`. What happens mid-rollout?",
              "a_bullets": [
                "v1 pods still query `name`, so they fail at once",
                "Safe way: add `full_name`, dual-write, backfill, drop `name` in a later release"
              ]
            },
            {
              "type": "qa",
              "q": "A canary gets 1% of 100 req/min. After 5 minutes it shows zero errors. Promote it?",
              "a_bullets": [
                "No: only about 5 requests reached it",
                "That is too few to show an error rate; gate on error rate and p99 with enough traffic"
              ]
            },
            {
              "type": "qa",
              "q": "After a blue-green cutover, the release also ran `DROP COLUMN old_col`. Flipping back to blue now fails. Why?",
              "a_bullets": [
                "The database is shared, and blue still needs `old_col`",
                "Drop columns in a later release, once no running code uses them"
              ]
            }
          ]
        }
      ]
    }
