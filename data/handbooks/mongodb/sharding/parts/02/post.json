              "Multi-tenant",
              "{tenantId,_id}",
              "tenant-local reads"
            ],
            [
              "Time series",
              "{deviceId,ts}",
              "history contiguous"
            ],
            [
              "Raw logs",
              "{_id: hashed}",
              "pure write spread"
            ]
          ]
        },
        {
          "type": "bullets",
          "items": [
            "`_id` suffix splits a whale tenant into many chunks",
            "`deviceId` prefix spreads devices, keeps a device together",
            "Hashed logs accept scatter-gather reads on purpose"
          ]
        }
      ]
    },
    {
      "page_title": "Choosing a Shard Key: A Decision Framework",
      "blocks": [
        {
          "type": "heading",
          "text": "Keys That Burn",
          "ink": "red"
        },
        {
          "type": "table",
          "headers": [
            "Anti-key",
            "Failure",
            "Result"
          ],
          "rows": [
            [
              "{createdAt:1}",
              "max-key chunk",
              "one shard's speed"
            ],
            [
              "{status:1}",
              "low cardinality",
              "jumbo forever"
            ],
            [
              "random UUID",
              "no locality",
              "every read broadcast"
            ]
          ]
        },
        {
          "type": "heading",
          "text": "The Compound Trade"
        },
        {
          "type": "bullets",
          "items": [
            "Prefix controls locality and targeting",
            "Suffix controls splittability inside the prefix",
            "A prefix you never filter on buys you scatter-gather"
          ]
        },
        {
          "type": "callout",
          "style": "tip",
          "title": "Write The Choice Down",
          "text": "Record the key with its assumptions about traffic shape. When the shape changes, that note tells you whether it is time to reshard."
        },
        {
          "type": "heading",
          "text": "Process Errors",
          "ink": "red"
        },
        {
          "type": "bullets",
          "items": [
            "Sharding too early: one replica set carries more than you think",
            "Sharding too late: a full hot cluster has no I/O headroom",
            "Reading chunk counts as if they were bytes per shard",
            "Connecting straight to a shard's `mongod` for reads"
          ]
        },
        {
          "type": "bullets",
          "items": [
            "Expecting global unique indexes to exist",
            "Only shard-key-prefixed unique indexes work at all",
            "Leaving the balancer on during a snapshot backup",
            "That snapshot captures an inconsistent chunk map"
          ]
        },
        {
          "type": "heading",
          "text": "Symptom To Cause"
        },
        {
          "type": "table",
          "headers": [
            "What you see",
            "Root cause"
          ],
          "rows": [
            [
              "One shard 90% CPU, rest idle",
              "hot chunk, monotonic key"
            ],
            [
              "Jumbo chunks in `sh.status()`",
              "cardinality too low"
            ],
            [
              "Every query touches all shards",
              "key absent from hot path"
            ]
          ]
        },
        {
          "type": "heading",
          "text": "Repair Tools"
        },
        {
          "type": "bullets",
          "items": [
            "`refineCollectionShardKey` appends a high-cardinality suffix",
            "Appending `_id` breaks up jumbo chunks; build the index first",
            "`reshardCollection` (5.0+) rewrites under a whole new key",
            "It duplicates the data while running: plan disk headroom"
          ]
        }
      ]
    },
    {
      "page_title": "Common Mistakes, Diagnosis & Repair",
      "blocks": [
        {
          "type": "code",
          "lang": "js",
          "lines": [
            "db.adminCommand({",
            "  reshardCollection: \"app.orders\",",
            "  key: { tenantId: 1, orderId: 1 } })",
            "// online, but commit pauses writes"
          ],
          "runnable": false
        },
        {
          "type": "callout",
          "style": "cloud",
          "title": "Resharding Is Not Free",
          "text": "It runs online, yet the commit holds a short critical section. Expect a write pause at the very end of the operation."
        },
        {
          "type": "heading",
          "text": "Orphan Cleanup"
        },
        {
          "type": "bullets",
          "items": [
            "`cleanupOrphaned` and the range deleter remove strays",
            "4.4+ filters orphans automatically on shard reads",
            "Application logic still enforces non-prefixed uniqueness"
          ]
        },
        {
          "type": "heading",
          "text": "Watch These Five"
        },
        {
          "type": "sidebox",
          "title": "Monitoring Set",
          "items": [
            "Per-shard write ops and per-shard data size",
            "Chunk migration counts over time",
            "Balancer round failures",
            "Jumbo chunk count, alert on any increase"
          ],
          "ink": "green"
        },
        {
          "type": "qa",
          "q": "Cluster is slow. First command?",
          "a_bullets": [
            "`sh.status()` for keys, jumbo flags, balancer state",
            "`getShardDistribution()` for real bytes per shard",
            "`explain(\"executionStats\").shards` on the hot query"
          ]
        },
        {
          "type": "heading",
          "text": "The Whole Chain",
          "ink": "blue"
        },
        {
          "type": "diagram",
          "kind": "flow",
          "spec": {
            "nodes": [
              "shard key",
              "chunk",
              "shard",
              "one hop"
            ]
          }
        },
        {
          "type": "bullets",
          "items": [
            "Cluster = shards + config servers (CSRS) + `mongos`",
            "Only `mongos` holds the whole routing map",
            "Key to chunk to shard is the model; the rest is bookkeeping"
          ]
        },
        {
          "type": "heading",
          "text": "Key Quality"
        },
        {
          "type": "bullets",
          "items": [
            "High cardinality, flat frequency, non-monotonic",
            "And present in the queries you actually run",
            "Miss any one of the four and you pay for it daily"
          ]
        }
      ]
    },
    {
      "page_title": "Recap: The Sharding Cheat Sheet",
      "blocks": [
        {
          "type": "heading",
          "text": "Ranged Or Hashed"
        },
        {
          "type": "table",
          "headers": [
            "Mode",
            "Inserts",
            "Range reads"
          ],
          "rows": [
            [
              "Ranged",
              "hotspot risk",
              "targeted"
            ],
            [
              "Hashed",
              "even",
              "broadcast"
            ],
            [
              "Compound hashed",
              "even",
              "zone-able prefix"
            ]
          ]
        },
        {
          "type": "bullets",
          "items": [
            "`{ region: 1, userId: \"hashed\" }` is the middle path",
            "Shard key present = one shard = one hop",
            "Key absent = every shard = slowest-shard latency"
          ]
        },
        {
          "type": "heading",
          "text": "Balancer And Zones"
        },
        {
          "type": "bullets",
          "items": [
            "Chunk default 128 MB in 6.0+; jumbo means unsplittable",
            "Balancer runs on the config primary, sizes data in 6.0+",
            "Confine it with `activeWindow` during peak hours",
            "Migration blocks the moving range only, briefly",
            "Zones win before evenness: residency and tiered disks"
          ]
        },
        {
          "type": "heading",
          "text": "Escape Routes"
        },
        {
          "type": "bullets",
          "items": [
            "`refineCollectionShardKey`: append a suffix (4.4+)",
            "`reshardCollection`: full rewrite (5.0+)",
            "Neither is cheap, both beat living with a jumbo chunk"
          ]
        },
        {
          "type": "code",
          "lang": "js",
          "lines": [
            "sh.status()",
            "db.coll.getShardDistribution()",
            "db.currentOp({ desc: /Migration/ })",
            "use config; db.chunks.find({ jumbo: true })"
          ],
          "runnable": false
        },
        {
          "type": "callout",
          "style": "takeaway",
          "title": "Buy Hardware Last",
          "text": "Adding shards fixes capacity and never fixes a bad key. Get the key right, then scale the machine count."
        },
        {
          "type": "sidebox",
          "title": "Final Rule",
          "items": [
            "Pick the key for the query you run a million times a day",
            "Verify it against real data volumes and real skew",
            "Only then commit: the decision is close to permanent"
          ],
          "ink": "red"
        }
      ]
