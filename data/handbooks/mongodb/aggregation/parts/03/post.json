          "type": "bullets",
          "items": [
            "`from` collection must live in the same database",
            "Sharded targets allowed since 5.1, not before",
            "16 MB cap applies to the JOINED result inside the parent doc",
            "A hot key with 100k children overflows it — filter or `$limit` inside"
          ]
        },
