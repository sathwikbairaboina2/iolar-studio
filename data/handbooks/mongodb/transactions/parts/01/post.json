              "sharded clusters"
            ],
            [
              "standalone",
              "never supported"
            ]
          ]
        },
        {
          "type": "bullets",
          "items": [
            "Standalone `mongod` cannot: no oplog replication protocol",
            "Storage engine must be WiredTiger — supplies MVCC",
            "WiredTiger also gives document-level concurrency"
          ]
        },
        {
          "type": "heading",
          "text": "Before 4.0"
        },
        {
          "type": "bullets",
          "items": [
            "Workaround was two-phase commit written by hand",
            "Each doc carried a `pending` state field",
            "Application code drove every rollback step"
          ]
        },
        {
          "type": "diagram",
          "kind": "cards",
          "spec": {
            "cards": [
              {
                "title": "SQL engines",
