                "title": "MongoDB",
                "lines": [
                  "doc atomicity ~90%",
                  "embed related data",
                  "txn for the rest"
                ]
              }
            ]
          }
        },
        {
          "type": "sidebox",
          "title": "Cost Preview",
          "items": [
            "Holds a snapshot open for its whole life",
            "Pins storage-engine resources",
            "Adds one commit round-trip"
          ]
        },
        {
          "type": "callout",
          "style": "takeaway",
          "title": "Rule of thumb",
          "text": "If most operations need a transaction, the schema is relational-shaped and wants remodelling — not a bigger transaction budget."
        },
