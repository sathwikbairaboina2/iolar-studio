    {
      "title": "Credential Stuffing Defense Cheat Sheet",
      "role": "outline",
      "outlineIndex": 5,
      "pages": [
        {
          "title": "Credential Stuffing Defense Cheat Sheet",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Layer Order",
              "ink": "green"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "Edge limit",
                    "sub": "bot detection",
                    "ink": "green"
                  },
                  {
                    "text": "Counters",
                    "sub": "per IP, per account",
                    "ink": "blue"
                  },
                  {
                    "text": "Delay",
                    "sub": "progressive",
                    "ink": "purple"
                  },
                  {
                    "text": "CAPTCHA",
                    "sub": "conditional",
                    "ink": "orange"
                  },
                  {
                    "text": "MFA",
                    "sub": "second factor",
                    "ink": "pink"
                  },
                  {
                    "text": "Breach check",
                    "sub": "known-bad passwords",
                    "ink": "red"
                  }
                ]
              }
            },
            {
              "type": "heading",
              "text": "2. Defaults",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "Control",
                "Default"
              ],
              "rows": [
                [
                  "Per account",
                  "5 failures / 15 min"
                ],
                [
                  "Per IP",
                  "20 failures / 15 min"
                ],
                [
                  "Backoff",
                  "1s doubling, 15 min cap"
                ],
                [
                  "Reject with",
                  "`429` + `Retry-After`"
                ]
              ]
            },
            {
              "type": "heading",
              "text": "3. Lockout and Errors",
              "ink": "purple"
            },
            {
              "type": "bullets",
              "items": [
                "Use ==temporary soft locks== keyed on account + device or IP",
                "Wrong user or wrong password: same `Invalid credentials` and same timing"
              ],
              "style": "check"
            },
            {
              "type": "bullets",
              "items": [
                "Permanent hard locks: attackers lock victims out (lockout DoS)"
              ],
              "style": "cross"
            },
