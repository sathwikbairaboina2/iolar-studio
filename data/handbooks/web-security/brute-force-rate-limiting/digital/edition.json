    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "A bot tries 1 stolen pair on each of 50,000 accounts through rotating IPs. Limits are 5 failures per account and 20 per IP. Does anything trip?",
              "a_bullets": [
                "No. Every account and every IP stays under its threshold.",
                "Catch it with a high failure ratio, many usernames per device, breached-password checks and MFA."
              ]
            },
            {
              "type": "qa",
              "q": "Spot the bug: the limiter keys on the first X-Forwarded-For value. Why does it never block the attacker?",
              "a_bullets": [
                "The attacker sets that header themselves, so each request looks like a new IP.",
                "Read the IP from the hop your own trusted proxy appended."
              ]
            },
            {
              "type": "qa",
              "q": "An account is permanently disabled after 5 failed logins. What attack does this invite?",
              "a_bullets": [
                "An attacker submits 5 bad passwords for a victim and locks them out: a denial of service.",
                "Use a temporary soft lock keyed on account plus device or IP, with a CAPTCHA or email unlock."
              ]
            }
          ]
        }
      ]
    }
