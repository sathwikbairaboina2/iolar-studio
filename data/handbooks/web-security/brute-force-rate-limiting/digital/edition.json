                    "sub": "5 hex chars",
                    "ink": "orange"
                  },
                  {
                    "text": "Get suffixes",
                    "sub": "all matches",
                    "ink": "purple"
                  },
                  {
                    "text": "Compare",
                    "sub": "locally",
