          "title": "HTTP and Cookies Cheat Sheet",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Methods",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "Method",
                "Does",
                "Safe",
