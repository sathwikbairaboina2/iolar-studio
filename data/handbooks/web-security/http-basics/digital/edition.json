              ],
              "rows": [
                [
                  "Request",
                  "`Host` (==required== in HTTP/1.1), `User-Agent`, `Accept`, `Authorization: Bearer <token>`, `Cookie`, `Origin`"
                ],
                [
                  "Body",
                  "`Content-Type` = what the body is (`application/json`); `Content-Length` = size in **bytes**"
                ],
                [
                  "Response",
