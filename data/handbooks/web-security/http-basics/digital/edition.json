    {
      "title": "Cookies and Their Attributes",
      "role": "outline",
      "outlineIndex": 3,
      "pages": [
        {
          "title": "Cookies and Their Attributes",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Set-Cookie and Cookie",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "Server sets it with ==Set-Cookie==",
                "Browser stores it, returns {blue:Cookie: sid=abc123} on requests"
              ],
              "style": "dot"
            },
            {
              "type": "code",
              "lang": "http",
              "lines": [
                "Set-Cookie: sid=abc123; Path=/; Secure; HttpOnly; SameSite=Lax"
              ]
            },
            {
              "type": "heading",
              "text": "2. Security Attributes",
              "ink": "red"
            },
            {
              "type": "table",
              "headers": [
                "Attribute",
                "Effect"
              ],
              "rows": [
                [
                  "`Secure`",
                  "Sent over ==HTTPS== only"
                ],
                [
                  "`HttpOnly`",
                  "Hidden from `document.cookie`; still sent"
                ],
                [
                  "`SameSite=Strict`",
                  "Never sent cross-site"
                ],
                [
                  "`SameSite=Lax`",
                  "Chrome's default; top-level GET navigations only"
                ],
                [
                  "`SameSite=None`",
                  "Sent cross-site; requires `Secure`"
                ]
              ]
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "What each defends",
              "text": "==SameSite== is a strong defence against **CSRF**; keep CSRF tokens too. `HttpOnly` limits token theft via **XSS**."
            },
            {
              "type": "heading",
              "text": "3. Scope and Lifetime",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "Setting",
                "Result"
              ],
              "rows": [
                [
                  "`Domain=example.com`",
                  "Also sent to `api.example.com`"
                ],
                [
                  "`Domain` omitted",
                  "Host-only: that exact host"
                ],
                [
                  "`Path=/admin`",
                  "Sent for URLs under that prefix"
                ],
                [
                  "No `Expires`/`Max-Age`",
                  "Session cookie, gone when browser session ends"
                ],
                [
                  "`Max-Age=3600`",
                  "Lives 3600 s; beats `Expires`"
                ],
                [
                  "`Max-Age=0`",
                  "==Deletes== the cookie"
                ]
              ],
              "highlightRow": 5
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Path is not security",
              "text": "Other paths on the same origin can still read the cookie from JS."
            }
          ]
        }
      ]
    },
    {
      "title": "How Browsers Attach Cookies and Common Mistakes",
      "role": "outline",
      "outlineIndex": 4,
      "pages": [
        {
          "title": "How Browsers Attach Cookies and Common Mistakes",
          "blocks": [
            {
              "type": "heading",
              "text": "1. The Attach Rule",
              "ink": "green"
            },
            {
              "type": "diagram",
              "kind": "chain",
              "spec": {
                "title": "Per outgoing request, every stored cookie must pass",
                "steps": [
                  {
                    "text": "Domain",
                    "note": "matches host",
                    "ink": "green"
                  },
                  {
                    "text": "Path",
                    "note": "prefix of URL path",
                    "ink": "blue"
                  },
                  {
                    "text": "Not expired",
                    "note": "Max-Age / Expires",
                    "ink": "purple"
                  },
                  {
                    "text": "Secure",
                    "note": "HTTPS only",
                    "ink": "orange"
                  },
                  {
                    "text": "SameSite",
                    "note": "site check passes",
                    "ink": "pink"
                  }
                ]
              }
            },
            {
              "type": "table",
              "headers": [
                "Hosts",
                "Same-site?",
                "Why"
              ],
              "rows": [
                [
                  "`app.example.com` / `api.example.com`",
                  "{green:Yes}",
                  "same eTLD+1"
                ],
                [
                  "`example.com` / `example.org`",
                  "{red:No}",
                  "different eTLD+1"
                ],
                [
                  "`example.com:8443` / `example.com`",
                  "{green:Yes}",
                  "port ignored"
                ]
              ]
            },
            {
              "type": "heading",
              "text": "2. Cross-Origin Fetch",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "No cookies cross-origin ==by default==",
                "Client: `credentials: 'include'`",
                "Server: `Allow-Credentials: true` and a ==specific origin==, not `*`"
              ],
              "style": "dot"
            },
            {
              "type": "code",
              "lang": "javascript",
              "lines": [
                "fetch('https://api.example.com/me',",
                " { credentials: 'include' })",
                "// Access-Control-Allow-Origin: https://app.example.com",
                "// Access-Control-Allow-Credentials: true"
              ]
            },
            {
              "type": "heading",
              "text": "3. Common Mistakes",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "`SameSite=None` without `Secure`: ==silently dropped==",
                "Auth token in a cookie without `HttpOnly`, or in `localStorage`: ==XSS can read it==",
                "Overwrite with another `Domain` or `Path`: a **second cookie** appears; a delete does nothing"
              ],
              "style": "cross",
              "ink": "red"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Cookie identity",
              "text": "A cookie is ==name + Domain + Path==. Match all three to replace or delete it."
            }
          ]
        }
      ]
    },
    {
