              ],
              "rows": [
                [
                  "GET",
                  "read",
                  "yes",
                  "yes"
                ],
                [
                  "POST",
                  "create",
                  "no",
                  "no"
                ],
                [
                  "PUT",
                  "replace",
                  "no",
                  "yes"
                ],
                [
                  "PATCH",
                  "partial update",
                  "no",
                  "no"
                ],
                [
                  "DELETE",
                  "remove",
                  "no",
                  "yes"
                ],
                [
                  "HEAD, OPTIONS",
                  "headers, CORS",
                  "yes",
                  "yes"
                ]
              ],
              "frame": "dashed"
            },
            {
              "type": "heading",
              "text": "2. Status",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "{green:2xx} ok, {blue:3xx} redirect, {orange:4xx} client fault, {red:5xx} server fault",
                "==401== = not logged in",
                "==403== = logged in, not allowed"
              ],
              "style": "dot"
            },
            {
              "type": "heading",
              "text": "3. Set-Cookie",
              "ink": "purple"
            },
            {
              "type": "code",
              "lang": "http",
              "lines": [
                "Set-Cookie: name=value; Path=/; Domain=example.com;",
                "  Max-Age=3600; Secure; HttpOnly; SameSite=Lax"
              ],
              "note": "template"
            },
            {
              "type": "bullets",
              "items": [
                "Auth session default: ==Secure + HttpOnly + SameSite=Lax== (or Strict), short Max-Age",
                "Cross-site cookie: `SameSite=None; Secure`",
                "Cross-origin fetch: `credentials: 'include'`"
              ],
              "style": "check",
              "ink": "purple"
            },
            {
              "type": "heading",
              "text": "4. Debug",
              "ink": "orange"
            },
            {
              "type": "bullets",
              "items": [
                "DevTools {blue:Network} tab: Cookie and Set-Cookie headers",
                "{blue:Application} tab: stored cookies",
                "Replay one: `curl -i -b 'sid=abc' https://example.com`"
              ],
              "style": "dot"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Common mistake",
              "text": "`SameSite=None` without `Secure` is rejected, so the cookie is silently dropped."
            }
          ]
        }
      ]
    },
    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "A server sends `Set-Cookie: sid=abc; SameSite=None; HttpOnly`. The page is HTTPS and the user logs in. Is the cookie stored?",
              "a_bullets": [
                "No, the browser rejects it and drops it silently.",
                "`SameSite=None` requires `Secure`. Add `; Secure`."
              ]
            },
            {
              "type": "qa",
              "q": "A cookie has Domain=example.com; Path=/. Code on app.example.com calls fetch('https://api.example.com/me') with no options. Is the cookie sent?",
              "a_bullets": [
                "No. The sites match, so SameSite is not the blocker.",
                "Cross-origin fetch omits cookies by default.",
                "Need `credentials: 'include'`, plus `Access-Control-Allow-Credentials: true` and a specific origin, not `*`."
              ]
            },
            {
              "type": "qa",
              "q": "The server set `sid=1; Path=/app`. To log out it sends `Set-Cookie: sid=; Max-Age=0; Path=/`. Is the cookie deleted?",
              "a_bullets": [
                "No. A cookie is identified by name + Domain + Path.",
                "`Path=/` names a different cookie, so `Path=/app` stays.",
                "Resend with the same Path (and Domain)."
              ]
            }
          ]
        }
      ]
    }
  ]
