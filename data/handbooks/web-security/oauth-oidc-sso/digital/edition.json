    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "An attacker steals the `?code=` from a redirect URL. The token endpoint also requires a `code_verifier`. Can they get tokens?",
              "a_bullets": [
                "**No**: the verifier never left the client.",
                "Only its SHA256 `code_challenge` crossed the front channel, and a hash can't be reversed."
              ]
            },
            {
              "type": "qa",
              "q": "A callback handler reads `?code=` and calls `/token` without comparing `state`. What attack is open?",
              "a_bullets": [
                "**CSRF login**: the attacker's code gets redeemed in the victim's session.",
                "Fix: save a random `state` before redirecting, reject the callback on mismatch."
              ]
            },
            {
              "type": "qa",
              "q": "An API receives a JWT with a valid signature, `iss` and `exp`, but `aud` is the client's `client_id`. Accept it?",
              "a_bullets": [
                "**Reject**: `aud` must name this API.",
                "An `aud` of the client means an ID token, meant for the client only.",
                "A valid signature, `iss` and `exp` don't make it an access token."
              ]
            }
          ]
        }
      ]
    }
  ]
