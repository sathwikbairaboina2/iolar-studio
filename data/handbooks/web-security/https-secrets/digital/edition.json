    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "HSTS is set with max-age=31536000. A new user types http://shop.com. Is that first request protected?",
              "a_bullets": [
                "No: the browser only learns HSTS from an HTTPS response.",
                "The plain request can be stripped; the preload list closes that gap."
              ]
            },
            {
              "type": "qa",
              "q": "A key was pushed, then the commit was force-pushed away. Is it safe?",
              "a_bullets": [
                "No: clones, forks and caches may still hold it.",
                "Rotate the key first, then clean history."
              ]
            },
            {
              "type": "qa",
              "q": "Set-Cookie: sid=abc; Secure. Can an XSS script steal it?",
              "a_bullets": [
                "Yes: without HttpOnly, JS reads it via document.cookie.",
                "Add HttpOnly, and SameSite=Lax against CSRF."
              ]
            }
          ]
        }
      ]
    }
  ]
