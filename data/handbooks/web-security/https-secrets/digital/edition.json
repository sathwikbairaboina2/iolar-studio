              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "==IDOR==: change `/orders/7` to `/orders/8`, read another user's order",
                "Hash passwords with ==bcrypt== or ==argon2==, never MD5 or SHA-1",
                "Allowlist outbound URLs to block ==SSRF== to the metadata endpoint"
              ],
              "style": "dot"
            },
            {
              "type": "bullets",
              "items": [
                "Never string-concatenate user input into SQL"
              ],
              "style": "cross"
            },
            {
              "type": "code",
              "lang": "python",
              "lines": [
                "cur.execute(\"SELECT * FROM users WHERE id = %s\", (uid,))"
              ]
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Remember",
              "text": "==Authorize== on the server, on every request."
            }
          ]
        }
