                "openssl s_client -connect host:443 -servername host </dev/null | openssl x509 -noout -dates"
              ],
              "note": "curl -I: look for HSTS and CSP"
            },
            {
              "type": "heading",
              "text": "2. Header Baseline",
              "ink": "green"
            },
            {
              "type": "table",
              "headers": [
