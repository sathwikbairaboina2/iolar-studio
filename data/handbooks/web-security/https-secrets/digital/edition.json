                "Audit dependencies",
                "Minimal base images"
              ],
              "style": "dot"
            },
            {
              "type": "heading",
              "text": "4. Common Mistakes",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "Expired certs",
                "Mixed content",
                "HSTS preload before all subdomains support HTTPS",
                "Wildcard CORS with credentials",
