    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "`cur.execute('SELECT * FROM users ORDER BY %s', (col,))` runs with col = 'age'. Does it sort by the age column?",
              "a_bullets": [
                "No: the value is bound as the string literal 'age', so ORDER BY gets a constant, not a column",
                "MySQL silently sorts by that constant; PostgreSQL rejects it: non-integer constant in ORDER BY",
                "Either way the column is unused. Fix: allowlist column names in code"
              ]
            },
            {
              "type": "qa",
              "q": "What happens with `subprocess.run(f'ping -c 1 {host}', shell=True)` when host is `8.8.8.8; id`?",
              "a_bullets": [
                "The shell splits at `;` and runs ping, then id",
                "Fix: `subprocess.run(['ping','-c','1',host])` with shell=False"
              ]
            },
            {
              "type": "qa",
              "q": "A filter does `name.replace('../','')`. What path comes out for `....//etc/passwd`?",
              "a_bullets": [
                "`../etc/passwd`: removing the inner `../` leaves a new one",
                "Fix: realpath, then check it starts with the base directory"
              ]
            }
          ]
        }
      ]
    }
