    },
    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "A page runs `el.innerHTML = location.hash.slice(1)`. Which XSS type is this, and will server logs show the payload?",
              "a_bullets": [
                "DOM XSS: source `location.hash` flows into sink `innerHTML`.",
                "The fragment is never sent to the server, so logs see nothing.",
                "Fix: use `textContent`."
              ]
            },
            {
              "type": "qa",
              "q": "A user URL is HTML-escaped, then placed in `<a href=\"...\">`. The user submits `javascript:alert(1)`. Does it run?",
              "a_bullets": [
                "Yes, on click: that string has no characters that HTML-escaping changes.",
                "Allowlist the scheme (http/https only)."
              ]
            },
            {
              "type": "qa",
              "q": "The CSP is `script-src 'self' 'unsafe-inline'`. An attacker injects an inline `<script>`. Is it blocked?",
              "a_bullets": [
                "No: `'unsafe-inline'` lets injected inline script run.",
                "Use a per-response nonce with `'strict-dynamic'` instead."
              ]
            }
          ]
        }
      ]
    }
  ]
