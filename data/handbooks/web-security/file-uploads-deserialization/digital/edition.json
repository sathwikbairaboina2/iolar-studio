  "sections": [
    {
      "title": "Upload Threat Model and Mental Model",
      "role": "outline",
      "outlineIndex": 0,
      "pages": [
        {
          "title": "Upload Threat Model and Mental Model",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Untrusted in Four Places",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "An upload is ==untrusted input== in four places",
                "{blue:Filename}, {green:content}, {purple:declared Content-Type}, {orange:size}",
                "Validate all four ==server-side==; never trust the client"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "red"
            },
            {
              "type": "table",
              "headers": [
                "Attacker goal",
                "Vector"
              ],
              "rows": [
                [
                  "Run code",
                  "webshell `.php`/`.jsp` in a web-served dir"
                ],
                [
                  "Stored XSS",
                  "HTML/SVG/JS served from your origin"
                ],
                [
                  "DoS",
                  "huge or decompression-bomb files"
                ],
                [
                  "Overwrite/read files",
                  "path traversal"
                ]
              ]
            },
            {
              "type": "heading",
              "text": "2. Defense in Depth",
              "ink": "blue"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "Size cap",
                    "ink": "red"
                  },
                  {
                    "text": "Extension allowlist",
                    "ink": "orange"
                  },
                  {
                    "text": "Magic bytes",
                    "ink": "purple"
                  },
                  {
                    "text": "Random ID",
                    "ink": "blue"
                  },
                  {
                    "text": "Outside web root",
                    "ink": "green"
                  },
                  {
                    "text": "Safe headers",
                    "ink": "black"
                  }
                ]
              }
            },
            {
              "type": "heading",
              "text": "3. Allowlist, Not Blocklist",
              "ink": "green"
            },
            {
              "type": "table",
              "headers": [
                "Approach",
                "Rule"
              ],
              "rows": [
                [
                  "{green:Allowlist}",
                  "permit `.jpg` `.png` `.pdf` only"
                ],
                [
                  "{red:Blocklist}",
                  "misses `.phtml`, `.php5`, `.jspx`, `shell.php.jpg`, `.PhP`"
                ]
              ],
              "highlightRow": 0
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Client checks are UX only",
              "text": "The `accept` attribute and JS size checks are skipped when an attacker sends the ==raw HTTP request==. Enforce everything on the server."
            }
          ]
        }
      ]
    },
    {
      "title": "Validating Type and Size",
      "role": "outline",
      "outlineIndex": 1,
      "pages": [
        {
          "title": "Validating Type and Size",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Type Signals",
              "ink": "green"
            },
            {
              "type": "table",
              "headers": [
                "Signal",
                "Set by",
                "Trust"
              ],
              "rows": [
                [
                  "Extension",
                  "attacker",
                  "{red:weakest}"
                ],
                [
                  "Content-Type header",
                  "attacker",
                  "{red:weak}"
                ],
                [
                  "Magic bytes",
                  "file content",
                  "{green:strongest}"
                ]
              ]
            },
            {
              "type": "bullets",
              "items": [
                "PNG `89 50 4E 47`, JPEG `FF D8 FF`, PDF `%PDF-`, ZIP `50 4B 03 04`",
                "==Allowlist== extension AND magic bytes, and they must **agree**",
                "Mismatch: ==reject==, never fix up"
              ],
              "style": "check"
            },
            {
              "type": "heading",
              "text": "2. Size Limits",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "Layer",
                "Setting"
              ],
              "rows": [
                [
                  "nginx",
                  "`client_max_body_size 5m`"
                ],
                [
                  "Express",
                  "multer `limits.fileSize`"
                ],
                [
                  "Django",
                  "`DATA_UPLOAD_MAX_MEMORY_SIZE` (non-file body only)"
                ],
                [
                  "Spring",
                  "`spring.servlet.multipart.max-file-size`"
                ]
              ]
            },
            {
              "type": "bullets",
              "items": [
                "**Stream-count** bytes: abort mid-upload",
                "Read `MAX + 1` bytes: bounded, flags oversize, then sniff"
              ],
              "style": "dot"
            },
            {
              "type": "code",
              "lang": "python",
              "lines": [
                "data = f.read(MAX + 1)",
                "if len(data) > MAX: abort(413)",
                "kind = filetype.guess(data)",
                "if kind is None or kind.mime not in {",
                "    'image/png', 'image/jpeg'}:",
                "    abort(415)"
              ]
            },
            {
              "type": "heading",
              "text": "3. Images and Mistakes",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "Pillow `open` → `save` strips EXIF, hinders ==polyglots== (valid image and script)",
                "Cap `Image.MAX_IMAGE_PIXELS` against decompression bombs"
              ],
              "style": "check"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Never do",
              "text": "Trust `content_type`; check only the extension; size-check after buffering; allow SVG (XML with `<script>`); unpack archives without entry-count and expanded-size limits."
            }
          ]
        }
      ]
    },
    {
      "title": "Safe Storage and Serving",
      "role": "outline",
      "outlineIndex": 2,
      "pages": [
        {
          "title": "Safe Storage and Serving",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Where Files Live",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "Store in ==/var/app-data/uploads==, not `/var/www/html/uploads`",
                "Or use S3 with ==Block Public Access==",
                "Disk name = `uuid4().hex` + extension **you** chose from the validated type",
                "Original filename: ==database metadata== only"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "code",
              "lang": "python",
              "lines": [
                "ext = {'image/png': '.png'}[mime]",
                "stored = uuid4().hex + ext",
                "path = UPLOAD_DIR / stored",
                "db.save(original=filename, stored=stored)"
              ],
              "note": "the user filename never touches the disk"
            },
            {
              "type": "heading",
              "text": "2. Serving and Sniffing",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "Serve via an ==authenticated handler== that streams the file",
                "Or via ==short-lived pre-signed URLs==",
                "Browsers **sniff** a type when Content-Type is missing or wrong, and may run an upload as HTML/JS"
              ],
              "style": "dot"
            },
            {
              "type": "table",
              "headers": [
                "Header",
                "Effect"
              ],
              "rows": [
                [
                  "`Content-Type` from your allowlist",
                  "no guessing needed"
                ],
                [
                  "`X-Content-Type-Options: nosniff`",
                  "browser obeys the declared type"
                ],
                [
                  "`Content-Disposition: attachment`",
                  "downloads, never renders inline"
                ]
              ],
              "frame": "dashed"
            },
            {
              "type": "heading",
              "text": "3. Isolation and Mistakes",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "Serve user content from a separate site: ==example-usercontent.com==",
                "Then XSS cannot read your app's cookies"
              ],
              "style": "check",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "Serving uploads from the main origin",
                "`chmod 777` on upload dirs or execute bits on files",
                "PHP/CGI handlers left enabled in the upload dir"
              ],
              "style": "cross",
              "ink": "red"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Uploads are data, never code",
              "text": "Outside the web root, random name, correct type plus ==nosniff==, separate cookieless domain."
            }
          ]
        }
      ]
    },
    {
      "title": "Path Traversal",
      "role": "outline",
      "outlineIndex": 3,
      "pages": [
        {
          "title": "Path Traversal",
          "blocks": [
            {
              "type": "heading",
              "text": "1. What Escapes",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "==Attacker-controlled path pieces== escape the intended directory",
                "Forms: `../../etc/passwd`, absolute `/etc/passwd`, `..\\` on Windows",
                "Encoded: `%2e%2e%2f`, double-encoding, null byte",
                "Hits: upload filenames, `?file=` downloads, archive extraction (==zip slip==)"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "red"
            },
            {
              "type": "heading",
              "text": "2. Join Does Not Confine",
              "ink": "orange"
            },
            {
              "type": "bullets",
              "items": [
                "Joining a user name onto a base does not confine it: `open(os.path.join(UPLOAD_DIR, user_name))`",
                "An absolute user part ==discards the base== entirely"
              ],
              "style": "cross"
            },
            {
              "type": "code",
              "lang": "python",
              "lines": [
                "import posixpath",
                "print(posixpath.join('/up', '/etc/passwd'))"
              ]
            },
            {
              "type": "code",
              "lang": "output",
              "lines": [
                "/etc/passwd"
              ]
            },
            {
              "type": "heading",
              "text": "3. Fix and Zip Slip",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "{green:Best}: opaque ID → database lookup, so the client ==never supplies a path==",
                "Otherwise ==resolve first, then compare==; never check the raw string"
              ],
              "style": "check",
              "ink": "green"
            },
            {
              "type": "table",
              "headers": [
                "Stack",
                "Check after canonicalizing"
              ],
              "rows": [
                [
                  "Python",
                  "`(base / name).resolve()` + `is_relative_to(base.resolve())`"
                ],
                [
                  "Node",
                  "`path.resolve` + `startsWith(base + path.sep)`"
                ],
                [
                  "Java",
                  "`getCanonicalPath()` inside base"
                ],
                [
                  "Fallback only",
                  "`os.path.basename`, `secure_filename`"
                ]
              ]
            },
            {
              "type": "bullets",
              "items": [
                "Zip slip: check every entry's ==resolved destination== before extracting",
                "Stripping `../` once with `replace`: `....//` becomes `../`",
                "Checking before URL-decoding",
                "Ignoring symlinks in the archive that point outside base"
              ],
              "style": "cross",
              "frame": "dashed",
              "ink": "red"
            }
          ]
        }
      ]
    },
    {
      "title": "Insecure Deserialization and Safe Formats",
      "role": "outline",
      "outlineIndex": 4,
      "pages": [
        {
          "title": "Insecure Deserialization and Safe Formats",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Why Native Formats Are Unsafe",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "Object-rebuilding format + untrusted bytes: attacker picks the ==classes== → RCE",
                "Too late to check after load; the ==format== must be safe",
                "`__reduce__` → `(os.system, ('cmd',))`; `pickle.loads` runs it",
                "**Gadget chain**: classpath classes whose `readObject`/`readResolve` chain into code execution"
              ],
              "style": "dot",
              "ink": "red"
            },
            {
              "type": "table",
              "headers": [
                "Risky call",
                "Fix"
              ],
              "rows": [
                [
                  "`pickle.loads`",
                  "Never on user, cookie, writable cache, unsigned input"
                ],
                [
                  "`yaml.load`",
                  "`yaml.safe_load`"
                ],
                [
                  "`marshal`, `shelve`",
                  "Same as pickle: avoid"
                ],
                [
                  "`ObjectInputStream.readObject`",
                  "`ObjectInputFilter` allowlist (JEP 290); avoid Java serialization"
                ],
                [
                  "Jackson `enableDefaultTyping`",
                  "Drop default typing"
                ],
                [
                  "XStream",
                  "Allowlist types"
                ]
              ]
            },
            {
              "type": "code",
              "lang": "java",
              "lines": [
                "var f = ObjectInputFilter.Config.createFilter(\"com.app.dto.*;!*\");",
                "ois.setObjectInputFilter(f);"
              ],
              "note": "allow your DTO package, reject everything else"
            },
            {
              "type": "heading",
              "text": "2. Safe Formats",
              "ink": "green"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "Bytes",
                    "ink": "red"
                  },
                  {
                    "text": "JSON parse",
                    "sub": "data only",
                    "ink": "blue"
                  },
                  {
                    "text": "Schema check",
                    "ink": "purple"
                  },
                  {
                    "text": "Typed object",
                    "ink": "green"
                  }
                ]
              }
            },
            {
              "type": "bullets",
              "items": [
                "JSON, Protobuf, MessagePack, CBOR carry only ==data==",
                "Validate: JSON Schema, pydantic, protobuf",
                "Map to your own typed objects"
              ],
              "style": "check",
              "ink": "green"
            },
            {
              "type": "heading",
              "text": "3. If You Must Keep Native",
              "ink": "orange"
            },
            {
              "type": "bullets",
              "items": [
                "==HMAC== sign, verify BEFORE deserializing (integrity, not secrecy)",
                "Allowlist classes: override `Unpickler.find_class`",
                "Run in a sandboxed low-privilege process"
              ],
              "style": "check",
              "ink": "orange"
            },
            {
              "type": "bullets",
              "items": [
                "Encrypting without authenticating",
                "Trusting internal queues, Redis, caches",
                "Blocklisting known gadget classes"
              ],
              "style": "cross",
              "ink": "red"
            }
          ]
        }
      ]
    },
    {
      "title": "Cheat Sheet: Secure Uploads and Deserialization",
      "role": "outline",
      "outlineIndex": 5,
      "pages": [
        {
          "title": "Cheat Sheet: Secure Uploads and Deserialization",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Upload Checklist",
              "ink": "green"
            },
            {
              "type": "diagram",
              "kind": "chain",
              "spec": {
                "steps": [
                  {
                    "text": "Size cap",
                    "note": "proxy + app",
                    "ink": "blue"
                  },
                  {
                    "text": "Extension allowlist",
                    "ink": "blue"
                  },
                  {
                    "text": "Magic bytes",
                    "note": "must match",
                    "ink": "purple"
                  },
                  {
                    "text": "Re-encode images",
                    "ink": "purple"
                  },
                  {
                    "text": "Random name",
                    "note": "uuid4().hex",
                    "ink": "orange"
                  },
                  {
                    "text": "Outside web root",
                    "ink": "green"
                  },
                  {
                    "text": "Safe headers",
                    "ink": "green"
                  }
                ]
              }
            },
            {
              "type": "table",
              "headers": [
                "Header on served upload",
                "Value"
              ],
              "rows": [
                [
                  "Sniffing off",
                  "`X-Content-Type-Options: nosniff`"
                ],
                [
                  "Download, never render",
                  "`Content-Disposition: attachment`"
                ],
                [
                  "Lock down scripts",
                  "`Content-Security-Policy: sandbox` or `default-src 'none'`"
                ],
                [
                  "Isolation",
                  "Separate ==cookieless domain=="
                ]
              ]
            },
            {
              "type": "heading",
              "text": "2. Paths and Deserialization",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "Never concatenate user input into a path",
                "==Resolve== first, then check it is inside the base dir",
                "Best: an ==opaque ID== lookup, no client path at all",
                "Untrusted input gets {green:JSON / protobuf} plus schema validation",
                "Java needs an ==ObjectInputFilter== allowlist",
                "If you must keep a native format: ==HMAC-verify== before parsing"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "`pickle.loads` on untrusted data",
                "`yaml.load` (use `yaml.safe_load`)",
                "`ObjectInputStream.readObject` on untrusted bytes"
              ],
              "style": "cross"
            },
            {
              "type": "heading",
              "text": "3. Limits to Remember",
              "ink": "purple"
            },
            {
              "type": "table",
              "headers": [
                "Limit",
                "Stops"
              ],
              "rows": [
                [
                  "File / body size",
                  "Huge uploads, memory DoS"
                ],
                [
                  "Image pixel count",
                  "Decompression bomb"
                ],
                [
                  "Archive entries + expanded size",
                  "Zip bomb"
                ],
                [
                  "Request rate per user",
                  "Flooding, abuse"
                ]
              ]
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Remember",
              "text": "Validate ==after== canonicalizing, and pick a format that **cannot** build objects: safety is chosen before the load."
            }
          ]
        }
      ]
    },
    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "What does `os.path.join('/srv/up', '/etc/passwd')` return, and why does that matter for uploads?",
              "a_bullets": [
                "It returns `/etc/passwd`, because an absolute part discards the base.",
                "The user escapes the upload folder, so resolve first, then check `is_relative_to(base)`."
              ]
            },
            {
              "type": "qa",
              "q": "A filter removes `../` once with `replace`. What does `....//x` become?",
              "a_bullets": [
                "`../x`, because removing the inner `../` re-forms a traversal.",
                "Canonicalize the path, then verify it is inside the base."
              ]
            },
            {
              "type": "qa",
              "q": "The server only checks `content_type == 'image/png'` before saving. Why is a webshell upload still possible?",
              "a_bullets": [
                "The client sets that header, so the attacker sends any value.",
                "Check the extension allowlist and magic bytes, rename randomly, and store outside the web root."
              ]
            }
          ]
        }
      ]
    }
  ]
}
