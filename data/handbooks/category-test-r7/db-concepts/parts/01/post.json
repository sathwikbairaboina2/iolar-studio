      "page_title": "Indexing",
      "blocks": [
        {
          "type": "concept",
          "number": 1,
          "title": "Indexing"
        },
        {
          "type": "labelrows",
          "rows": [
            {
              "icon": "table",
              "label": "What it is:",
              "text": "A sorted ==B-tree== mapping column values to row locations, skipping full scans"
            },
            {
              "icon": "zap",
              "label": "Why it exists:",
              "text": "Scanning 10M rows is O(n); a B-tree is O(log n), ~3-4 page reads"
            },
            {
              "icon": "database",
              "label": "Used for:",
              "text": "WHERE filters, JOIN keys, ORDER BY, unique constraints"
            }
          ]
        },
        {
          "type": "heading",
          "text": "How it works",
          "style": "ribbon"
        },
        {
          "type": "table",
          "headers": [
            "orders, 10M rows",
            "Plan",
            "Time"
          ],
          "rows": [
            [
              "`WHERE user_id = 42`",
              "Seq Scan",
              "~800 ms"
            ],
            [
              "after `CREATE INDEX idx_orders_user ON orders(user_id)`",
              "Index Scan",
              "~1 ms"
            ],
            [
              "index (user_id, created_at): `WHERE user_id=42 ORDER BY created_at`",
              "Index Scan, no sort",
              "~1 ms"
            ],
            [
              "same index: `WHERE created_at` alone",
              "**Seq Scan** (leftmost-prefix rule)",
              "~800 ms"
            ]
          ],
          "highlightRow": 1
        },
        {
          "type": "bullets",
          "items": [
            "Reads get ==orders of magnitude== faster",
            "==Covering indexes== answer a query without touching the table",
            "Unique indexes enforce constraints cheaply"
          ],
          "style": "check",
          "frame": "solid",
          "ink": "green"
        },
        {
          "type": "bullets",
          "items": [
            "Every INSERT/UPDATE/DELETE updates each index: **slower** writes, more storage",
            "Low-cardinality columns (boolean, status) rarely benefit",
            "`LOWER(email)` wraps the column and skips the index"
          ],
          "style": "cross",
          "frame": "solid",
          "ink": "red"
        },
        {
          "type": "callout",
          "style": "banner",
          "title": "Interview takeaway:",
          "text": "Index for your ==read patterns== and name the write-cost trade-off.\nThen prove it with `EXPLAIN`."
        }
      ],
      "hero": "database",
      "aside": "think B-tree!",
      "subtitle": "Fast lookups"
    },
    {
      "page_title": "Partitioning",
      "blocks": [
        {
          "type": "concept",
          "number": 2,
          "title": "Partitioning",
          "tagline": "one table, many pieces"
        },
        {
          "type": "labelrows",
          "rows": [
            {
              "icon": "table",
              "label": "What it is:",
              "text": "One big table split into smaller physical partitions on one server"
            },
            {
              "icon": "lightbulb",
              "label": "Why it exists:",
              "text": "Huge tables slow scans, index upkeep and deletes; small pieces stay manageable"
            },
            {
              "icon": "database",
              "label": "Used for:",
              "text": "Time-series, logs, archival and fast bulk deletes of old data"
            }
          ]
        },
        {
          "type": "heading",
          "text": "How it works",
          "style": "ribbon"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "CREATE TABLE events (",
            "  id bigint, created_at date,",
            "  PRIMARY KEY (id, created_at)",
            ") PARTITION BY RANGE (created_at);",
            "-- events_2026_09 holds Sep 2026",
            "SELECT * FROM events",
            "WHERE created_at >= '2026-09-01'",
            "  AND created_at < '2026-10-01';"
          ],
          "note": "scans only events_2026_09 (pruning)",
          "result": {
            "headers": [
              "Partition",
              "Scanned?"
            ],
            "rows": [
              [
                "events_2026_08",
                "no"
              ],
              [
                "events_2026_09",
                "yes"
              ],
              [
                "events_2026_10",
                "no"
              ]
            ]
          }
        },
        {
          "type": "bullets",
          "items": [
            "**Range**: dates, e.g. monthly partitions",
            "**List**: region = 'EU'",
            "**Hash**: user_id mod 8 for even spread",
            "`DROP TABLE events_2026_01` removes a month in O(1), no slow DELETE"
          ],
          "style": "dot"
        },
        {
          "type": "bullets",
          "items": [
            "==Partition pruning== cuts the data scanned",
            "Old data dropped in **O(1)**",
            "Smaller per-partition indexes fit in memory"
          ],
          "style": "check",
          "frame": "solid",
          "ink": "green"
        },
        {
          "type": "bullets",
          "items": [
            "Queries without the partition key scan **every** partition",
            "Partition key must be in primary and unique keys",
            "Too many partitions slow query planning"
          ],
          "style": "cross",
          "frame": "solid",
          "ink": "red"
        },
        {
          "type": "callout",
          "style": "banner",
          "title": "Interview takeaway:",
          "text": "Partitioning splits a table inside ==one node== for manageability.\nSharding spreads data across nodes; they are not the same."
        }
      ],
      "aside": "not sharding!",
      "subtitle": "Split inside one node"
    },
    {
      "page_title": "Replication",
      "blocks": [
        {
          "type": "concept",
          "number": 3,
          "title": "Replication",
          "tagline": "one primary, many copies"
        },
        {
          "type": "labelrows",
          "rows": [
            {
              "icon": "database",
              "label": "What it is:",
              "text": "Copies of data on many servers; primary writes, replicas receive"
            },
            {
              "icon": "shield-check",
              "label": "Why it exists:",
              "text": "Survive a dead node, scale reads, serve users nearby"
            },
            {
              "icon": "globe",
              "label": "Used for:",
              "text": "Failover, read-heavy loads, analytics replicas, cross-region reads"
            }
          ]
        },
        {
          "type": "heading",
          "text": "How it works",
          "style": "ribbon"
        },
        {
          "type": "table",
          "headers": [
            "Time",
            "What happens",
            "Result"
          ],
          "rows": [
            [
              "0 ms",
              "User posts comment to ==primary==",
              "Committed"
            ],
            [
              "5 ms",
              "Primary streams WAL to replicas A, B",
              "Async: no wait"
            ],
            [
              "200 ms",
              "Same user reads replica A",
              "**Missing**: lag"
            ],
            [
              "200 ms",
              "Read-your-writes: read primary",
              "Comment found"
            ]
          ],
          "highlightRow": 2,
          "frame": "solid"
        },
        {
          "type": "bullets",
          "items": [
            "{icon:shield-check} ==High availability== through automatic failover",
            "{icon:zap} ==Read throughput== scales by adding replicas"
          ],
          "style": "check",
          "frame": "solid",
          "ink": "green"
        },
        {
          "type": "bullets",
          "items": [
            "==Replication lag== causes stale reads; pin a user to primary for a few seconds",
            "Failover can lose **async** writes or cause ==split-brain==",
            "==Sync== waits for ack (no loss, slower writes); async is fast, can lose writes",
            "Replicas scale reads only, **not** writes"
          ],
          "style": "cross",
          "frame": "solid",
          "ink": "red"
        },
        {
          "type": "callout",
          "style": "banner",
          "title": "Interview takeaway:",
          "text": "Topologies: single-leader is most common; multi-leader needs conflict resolution; leaderless uses quorum R + W > N. Say single-leader with async replicas, then name lag and failover as the trade-offs."
        }
      ],
      "hero": "database",
      "aside": "lag bites back!",
      "subtitle": "Copies of your data"
    },
    {
      "page_title": "Sharding",
      "blocks": [
        {
          "type": "concept",
          "number": 4,
          "title": "Sharding",
          "tagline": "one node is never enough"
        },
        {
          "type": "labelrows",
          "rows": [
            {
              "icon": "database",
              "label": "What it is:",
              "text": "Split rows horizontally across independent database nodes, called shards."
            },
            {
              "icon": "zap",
              "label": "Why it exists:",
              "text": "One machine hits storage, write and memory limits; replicas don't scale writes."
            },
            {
              "icon": "server",
              "label": "Used for:",
              "text": "Write-heavy, multi-terabyte data: users, messages, orders."
            }
          ]
        },
        {
          "type": "heading",
          "text": "How it works",
          "style": "ribbon"
        },
        {
          "type": "diagram",
          "kind": "tables",
          "spec": {
            "tables": [
              {
                "title": "shard = hash(user_id) % 4",
                "headers": [
                  "user_id",
                  "shard"
                ],
                "rows": [
                  [
                    "1001",
                    "1"
                  ],
                  [
                    "1002",
                    "2"
                  ],
                  [
                    "1003",
                    "3"
                  ],
                  [
                    "1004",
                    "0"
                  ]
                ],
                "caption": "each shard takes ~25% of writes"
              },
              {
                "title": "Pick a strategy",
                "headers": [
                  "Strategy",
                  "Win",
                  "Risk"
                ],
                "rows": [
                  [
                    "Hash",
                    "even load",
                    "no range scans"
                  ],
                  [
                    "Range",
                    "fast range scans",
                    "hotspots"
                  ],
                  [
                    "Directory",
                    "flexible",
                    "extra hop"
                  ]
                ],
                "caption": "directory = lookup table"
              }
            ],
            "arrow": false
          }
        },
        {
          "type": "bullets",
          "items": [
            "Scales ==writes and storage== nearly linearly",
            "Failures and load stay **isolated** to one shard",
            "Consistent hashing: add a node, move only ~1/N of keys"
          ],
          "style": "check",
          "frame": "solid",
          "ink": "green"
        },
        {
          "type": "bullets",
          "items": [
            "Cross-shard joins and transactions: **expensive** or unsupported",
            "Bad shard key = hotspot (a celebrity `user_id`)",
            "Resharding is painful"
          ],
          "style": "cross",
          "frame": "solid",
          "ink": "red"
        },
        {
          "type": "callout",
          "style": "banner",
          "title": "Interview takeaway:",
          "text": "Shard **last**; pick a high-cardinality key that matches your dominant query.\nReplication still runs inside each shard."
        }
      ],
      "hero": "database",
      "aside": "shard last!",
      "subtitle": "Split to scale writes"
    },
    {
      "page_title": "Transactions",
      "blocks": [
        {
          "type": "concept",
          "number": 5,
          "title": "Transactions",
          "tagline": "one unit of work"
        },
        {
          "type": "labelrows",
          "rows": [
            {
              "icon": "database",
              "label": "What it is:",
              "text": "Statements run as one unit: all commit or all roll back"
            },
            {
              "icon": "zap",
              "label": "Why it exists:",
              "text": "A crash or constraint error midway leaves data half-updated"
            },
            {
              "icon": "lock",
              "label": "Used for:",
              "text": "Money transfers, orders with stock decrement, multi-row invariants"
            }
          ]
        },
        {
          "type": "heading",
          "text": "How it works",
          "style": "ribbon"
        },
        {
          "type": "table",
          "headers": [
            "Step",
            "Statement",
            "Acct 1",
            "Acct 2"
          ],
          "rows": [
            [
              "1",
              "`BEGIN`",
              "500",
              "300"
            ],
            [
              "2",
              "`UPDATE` id=1, -100",
              "400",
              "300"
            ],
            [
              "3",
              "`UPDATE` id=2, +100 **fails**",
              "400",
              "300"
            ],
            [
              "4",
              "`ROLLBACK` (or `SAVEPOINT`)",
              "500",
              "300"
            ],
            [
              "5",
              "`COMMIT` if both succeed",
              "400",
              "400"
            ]
          ],
          "highlightRow": 3,
          "frame": "solid"
        },
        {
          "type": "bullets",
          "items": [
            "==No partial writes==: total money is **unchanged**, always",
            "Simpler app code: the DB cleans up, `SAVEPOINT` undoes part"
          ],
          "style": "check",
          "frame": "solid",
          "ink": "green"
        },
        {
          "type": "bullets",
          "items": [
            "Long transactions hold **locks** and bloat undo or dead rows",
            "Across shards or services you need ==2PC== or sagas"
          ],
          "style": "cross",
          "frame": "solid",
          "ink": "red"
        },
        {
          "type": "callout",
          "style": "banner",
          "title": "Interview takeaway:",
          "text": "Keep transactions short.\nAcross services, say you would use a saga."
        }
      ],
      "hero": "database",
      "aside": "all or nothing",
      "subtitle": "All or nothing"
    },
    {
      "page_title": "ACID",
      "blocks": [
        {
          "type": "concept",
          "number": 6,
          "title": "ACID",
          "tagline": "what 'correct' means"
        },
        {
          "type": "labelrows",
          "rows": [
            {
              "icon": "shield-check",
              "label": "What it is:",
              "text": "Four guarantees of a reliable transaction: A, C, I, D"
            },
            {
              "icon": "lightbulb",
              "label": "Why it exists:",
              "text": "Defines 'correct' when failures and concurrency happen"
            },
            {
              "icon": "database",
              "label": "Used for:",
              "text": "Judging if a store is safe for payments, inventory, bookings"
            }
          ]
        },
        {
          "type": "heading",
          "text": "How it works",
          "style": "ribbon"
        },
        {
          "type": "table",
          "headers": [
            "Letter",
            "Guarantee",
            "Mechanism"
          ],
          "rows": [
            [
              "**A**tomicity",
              "All or nothing",
              "Undo log / rollback"
            ],
            [
              "**C**onsistency",
              "Valid state to valid state",
              "`CHECK (balance >= 0)`, foreign keys"
            ],
            [
              "**I**solation",
              "No peeking at partial work",
              "Tunable isolation level"
            ],
            [
              "**D**urability",
              "Survives a crash after COMMIT",
              "WAL ==fsynced== before ack"
            ]
          ]
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "BEGIN;",
            "UPDATE acct SET bal = bal - 100",
            "  WHERE id = 'A'; -- 50 - 100 = -50",
            "-- CHECK (bal >= 0) fails",
            "ROLLBACK; -- A=50, C=0 unchanged"
          ],
          "note": "whole transaction aborts, no half-write"
        },
        {
          "type": "bullets",
          "items": [
            "**Predictable** correctness under crashes and concurrency",
            "Transfer of 100 from A (50) aborts, neither account changes (A + C)"
          ],
          "style": "check",
          "frame": "solid",
          "ink": "green"
        },
        {
          "type": "bullets",
          "items": [
            "Costs latency and throughput; NoSQL often relaxes to BASE (eventual consistency)",
            "The C is app-defined invariants, not the C in CAP theorem"
          ],
          "style": "cross",
          "frame": "solid",
          "ink": "red"
        },
        {
          "type": "callout",
          "style": "banner",
          "title": "Interview takeaway:",
          "text": "Explain each letter with one mechanism: undo log, constraints, isolation level, WAL.\nDurability means the WAL is fsynced to disk before COMMIT returns."
        }
      ],
      "aside": "every letter = a mechanism",
      "subtitle": "Four guarantees"
    },
    {
      "page_title": "Isolation Levels",
      "blocks": [
        {
          "type": "concept",
          "number": 7,
          "title": "Isolation Levels",
          "tagline": "how much can T2 leak into T1?"
        },
        {
          "type": "labelrows",
          "rows": [
            {
              "icon": "layers",
              "label": "What it is:",
              "text": "A setting for how much concurrent transactions see each other's changes"
            },
            {
              "icon": "scale",
              "label": "Why it exists:",
              "text": "Full isolation is costly, so you trade correctness for throughput"
            },
            {
              "icon": "shield-check",
              "label": "Used for:",
              "text": "Per-workload safety, like reports versus payments"
            }
          ]
        },
        {
          "type": "heading",
          "text": "How it works",
          "style": "ribbon"
        },
        {
          "type": "table",
          "headers": [
            "Level",
            "Blocks",
            "T1 re-reads (T2 set 50)"
          ],
          "rows": [
            [
              "Read Uncommitted",
              "nothing; ==dirty read== allowed",
              "50, even uncommitted"
            ],
            [
              "Read Committed (Postgres default)",
              "dirty read (sees uncommitted)",
              "50 = **non-repeatable** read"
            ],
            [
              "Repeatable Read",
              "non-repeatable (row changes)",
              "**100**, same as first read"
            ],
            [
              "Serializable",
              "phantom (new rows), write skew",
              "**100**, as if one at a time"
            ]
          ],
          "highlightRow": 2,
          "frame": "solid"
        },
        {
          "type": "bullets",
          "items": [
            "Lower levels give ==higher concurrency==, fewer blocks and retries",
            "Tune per workload: loose for reports, strict for payments"
          ],
          "style": "check",
          "frame": "solid",
          "ink": "green"
        },
        {
          "type": "bullets",
          "items": [
            "==Serializable== may abort, so the app must retry on failure",
            "Defaults differ: MySQL InnoDB Repeatable Read, Postgres Read Committed",
            "Postgres Repeatable Read is snapshot isolation: **write skew** slips through",
            "Write skew: two on-call doctors both see 2 on call, both leave"
          ],
          "style": "cross",
          "frame": "solid",
          "ink": "red"
        },
        {
          "type": "callout",
          "style": "banner",
          "title": "Interview takeaway:",
          "text": "Default to Read Committed and name the anomaly you are guarding against.\nEscalate to Serializable only where needed, and retry on serialization failure."
        }
      ],
      "hero": "database",
      "aside": "pick the weakest safe"
    },
    {
      "page_title": "MVCC",
      "blocks": [
        {
          "type": "concept",
          "number": 8,
          "title": "MVCC",
          "tagline": "many row versions"
        },
        {
          "type": "labelrows",
          "rows": [
            {
              "icon": "database",
              "label": "What it is:",
              "text": "Keeps several row versions so readers see a consistent snapshot."
            },
            {
              "icon": "lock",
              "label": "Why it exists:",
              "text": "Plain read/write locks make readers wait for writers."
            },
            {
              "icon": "server",
              "label": "Used for:",
              "text": "Snapshot isolation in Postgres, MySQL InnoDB and Oracle."
            }
          ]
        },
        {
          "type": "heading",
          "text": "How it works",
          "style": "ribbon"
        },
        {
          "type": "table",
          "headers": [
            "Row version",
            "xmin",
            "xmax",
            "T99 sees?",
            "T100+ sees?"
          ],
          "rows": [
            [
              "balance=100",
              "10",
              "100",
              "**yes** (old)",
              "no"
            ],
            [
              "balance=50",
              "100",
              "–",
              "no",
              "**yes** (new)"
            ]
          ],
          "highlightRow": 0
        },
        {
          "type": "paragraph",
          "text": "T100 updates the row: new version gets `xmin=100`, old one is marked `xmax=100`. T99's snapshot predates 100, so it still reads the ==old version==. Readers never block writers and writers never block readers; two writers on the same row still conflict. Postgres keeps old versions in the table (VACUUM reclaims dead tuples); InnoDB keeps them in undo logs."
        },
        {
          "type": "bullets",
          "items": [
            "High read concurrency with consistent snapshots",
            "Long read-only queries do not lock anyone"
          ],
          "style": "check",
          "frame": "solid",
          "ink": "green"
        },
        {
          "type": "bullets",
          "items": [
            "Bloat from dead rows if VACUUM lags",
            "Long-running transactions pin old versions",
            "Write-write conflicts still need locks or abort (first-updater-wins)"
          ],
          "style": "cross",
          "frame": "solid",
          "ink": "red"
        },
        {
          "type": "callout",
          "style": "banner",
          "title": "Interview takeaway:",
          "text": "Say \"readers don't block writers\".\nName the cost: vacuum or undo cleanup."
        }
      ],
      "aside": "readers never wait!",
      "subtitle": "Snapshots, no waiting"
    },
    {
      "page_title": "Locking",
      "blocks": [
        {
          "type": "concept",
          "number": 9,
          "title": "Locking",
          "tagline": "others wait their turn"
        },
        {
          "type": "labelrows",
          "rows": [
            {
              "icon": "lock",
              "label": "What it is:",
              "text": "Shared (read) or exclusive (write) claim on rows or tables"
            },
            {
              "icon": "shield-check",
              "label": "Why it exists:",
              "text": "Concurrent writers to the same data cause lost updates"
            },
            {
              "icon": "database",
              "label": "Used for:",
              "text": "Hot rows: inventory, seats, balances; prefer row over table locks"
            }
          ]
        },
        {
          "type": "heading",
          "text": "How it works",
          "style": "ribbon"
        },
        {
          "type": "table",
          "headers": [
            "Step",
            "Buyer A",
            "Buyer B",
            "Stock"
