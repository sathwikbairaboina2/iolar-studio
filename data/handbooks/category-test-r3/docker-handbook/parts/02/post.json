        {
          "type": "heading",
          "text": "4. Compose and Dockerfile",
          "ink": "purple"
        },
        {
          "type": "code",
          "lang": "bash",
          "lines": [
            "docker compose up -d --build",
            "docker compose down",
            "docker compose ps",
            "docker compose logs -f",
            "docker compose exec web sh",
            "docker compose config"
          ],
          "note": "config prints the merged file"
        },
        {
          "type": "code",
          "lang": "dockerfile",
          "lines": [
            "FROM node:22-slim",
            "WORKDIR /app",
            "COPY package*.json ./",
            "RUN npm ci",
            "COPY . .",
            "USER node",
            "EXPOSE 3000",
            "CMD [\"node\", \"server.js\"]"
          ],
          "note": "CMD in exec form, not shell"
        },
        {
          "type": "heading",
          "text": "5. Exit Codes and Security",
          "ink": "red"
        },
        {
          "type": "table",
          "headers": [
            "Code",
            "Meaning"
          ],
          "rows": [
            [
              "**137**",
              "killed / OOM (SIGKILL)"
            ],
            [
              "**143**",
              "SIGTERM (graceful stop)"
            ],
            [
              "**127**",
              "command not found"
            ]
          ],
          "highlightRow": 0,
          "frame": "dashed"
        },
        {
          "type": "bullets",
          "items": [
            "Run as non-root with `USER`",
            "`--cap-drop ALL`, add back only needs",
            "`--read-only` plus tmpfs for scratch",
            "Scan images and ==pin== tags or digests",
            "Never mount `docker.sock`"
          ],
          "style": "checkbox",
          "frame": "dashed",
