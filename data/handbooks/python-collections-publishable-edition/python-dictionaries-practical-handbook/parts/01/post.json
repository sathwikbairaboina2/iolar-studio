        {
          "type": "paragraph",
          "text": "Views are ==dynamic==, not copies. They reflect live changes to the dictionary.",
          "frame": "dashed",
          "ink": "purple"
        },
        {
          "type": "code",
          "lang": "python",
          "lines": [
            "d = {'a': 1}",
