      "blocks": [
        {
          "type": "callout",
          "style": "tip",
          "title": "depends_on is not readiness",
          "text": "Plain `depends_on` only orders startup. Add a healthcheck and `condition: service_healthy` so the app waits for the DB."
        },
        {
          "type": "table",
          "headers": [
            "Debug command",
            "Shows"
          ],
          "rows": [
            [
              "docker stats",
              "live CPU, RAM, I/O"
            ],
            [
              "docker top n",
              "processes inside"
            ],
            [
              "docker events",
              "die, oom, health"
            ],
            [
              "docker inspect n",
              "config, OOMKilled flag"
            ]
          ],
          "frame": "dashed"
        },
        {
          "type": "callout",
          "style": "sticky",
          "title": "Unreachable app?",
          "text": "Bind to `0.0.0.0`, not 127.0.0.1, or published ports reach nothing."
        },
