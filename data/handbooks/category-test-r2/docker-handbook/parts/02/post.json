    {
      "page_title": "Docker Cheatsheet",
      "blocks": [
        {
          "type": "heading",
          "text": "1. Containers",
          "ink": "blue"
        },
        {
          "type": "code",
          "lang": "bash",
          "lines": [
            "docker run -d --name n \\",
            "  -p 8080:80 img",
            "docker ps -a",
            "docker stop n && docker rm n",
            "docker logs -f n",
            "docker exec -it n sh"
          ],
          "note": "-p is host:container"
        },
        {
          "type": "callout",
          "style": "tip",
          "title": "stop vs kill",
          "text": "`docker stop` sends SIGTERM, waits 10s, then SIGKILL. `docker kill` sends SIGKILL at once."
        },
        {
          "type": "heading",
          "text": "2. Images and cleanup",
          "ink": "blue"
        },
        {
          "type": "code",
          "lang": "bash",
          "lines": [
            "docker build -t app:1.0 .",
            "docker images",
            "docker pull nginx:1.27",
            "docker tag app:1.0 app:stable",
            "docker history app:1.0",
            "docker image inspect app:1.0"
          ]
        },
        {
          "type": "code",
          "lang": "bash",
          "lines": [
            "docker rmi app:stable",
            "docker system df",
            "docker system prune",
            "docker volume prune",
            "docker image prune -a"
          ],
          "note": "prune -a deletes unused images"
        },
        {
          "type": "heading",
          "text": "3. Volumes and networks",
          "ink": "green"
        },
        {
          "type": "bullets",
          "items": [
            "`docker volume create/ls/inspect/rm`",
            "`-v data:/data` or `--mount type=volume,src=data,dst=/data`",
            "`docker network create/ls/inspect/connect`",
            "`--network appnet` joins a ==user-defined== network",
            "`-p 8080:80` publishes host:container"
          ],
          "style": "dot",
          "frame": "dashed",
          "ink": "green"
        },
        {
          "type": "code",
          "lang": "bash",
          "lines": [
            "docker volume create pgdata",
            "docker network create appnet",
            "docker run -d --network appnet \\",
            "  -v pgdata:/var/lib/postgresql/data \\",
            "  --name db postgres:16"
          ],
          "note": "volumes outlive containers"
        },
        {
          "type": "heading",
          "text": "4. Compose and Dockerfile order",
          "ink": "purple"
        },
        {
          "type": "code",
          "lang": "bash",
          "lines": [
            "docker compose up -d",
            "docker compose ps",
            "docker compose logs -f",
            "docker compose exec web sh",
            "docker compose build",
            "docker compose config"
          ],
          "note": "down -v also deletes volumes"
        },
        {
          "type": "bullets",
          "items": [
            "Services reach each other by ==service name==",
            "`depends_on` with `service_healthy` waits for health",
            "`.env` fills `${VAR:-default}` in the file",
            "`compose.override.yaml` loads automatically"
          ],
          "style": "dot",
          "frame": "dashed",
          "ink": "purple"
        },
        {
          "type": "table",
          "headers": [
            "Compose feature",
            "Use it for"
          ],
          "rows": [
            [
              "profiles",
              "optional debug services"
            ],
            [
              "env_file",
              "inject configuration"
            ],
            [
              "-f compose.prod.yaml",
              "merge prod settings"
            ],
            [
              "watch",
              "sync/rebuild on edit"
            ]
          ],
          "frame": "dashed"
        }
      ],
