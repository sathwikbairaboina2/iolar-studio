            },
            {
              "type": "heading",
              "text": "3. Streaming, Quality, Ethics",
              "ink": "purple"
            },
            {
              "type": "table",
              "headers": [
                "",
                "Streaming",
                "Batch"
              ],
              "rows": [
                [
                  "Output",
                  "Partial transcripts",
                  "Final transcript"
                ],
                [
                  "Latency",
                  "{green:Low}",
                  "{red:Higher}"
                ],
                [
                  "Accuracy",
                  "{red:Lower}",
                  "{green:Higher}, full context"
                ]
              ]
            },
            {
              "type": "bullets",
              "items": [
                "Voice agent = STT + LLM + TTS; their latencies ==add up==",
                "Judged on ==MOS== (naturalness) and intelligibility",
