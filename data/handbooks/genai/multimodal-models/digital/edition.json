    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "A ViT with 14x14 patches reads a 224x224 image. You switch to 448x448. How many image tokens now?",
              "a_bullets": [
                "224: 16x16 = 256 tokens. 448: 32x32 = ==1024== tokens.",
                "Doubling resolution gives 4x tokens, so attention costs far more."
              ]
            },
            {
              "type": "qa",
              "q": "A CLIP batch holds 8 image-caption pairs. How many negative pairs are in the similarity matrix?",
              "a_bullets": [
                "The matrix is 8x8 = 64 entries.",
                "8 diagonal positives leave 64 - 8 = ==56== negatives."
              ]
            },
            {
              "type": "qa",
              "q": "The prompt \"a street, no cars\" produces an image full of cars. Why, and what is the fix?",
              "a_bullets": [
                "The text encoder embeds the word \"cars\", so it pushes the image toward cars.",
                "Move it to the ==negative prompt== field instead."
              ]
            }
          ]
        }
      ]
    }
