          "title": "Refusal Calibration and Classifiers",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Two Ways to Be Wrong",
              "ink": "red"
            },
            {
              "type": "table",
              "headers": [
                "",
                "Over-refusal",
                "Under-refusal"
              ],
              "rows": [
                [
                  "Error",
                  "{orange:False positive}",
                  "{red:False negative}"
                ],
                [
                  "Effect",
                  "Blocks benign requests",
                  "Lets harmful ones through"
                ],
                [
                  "Example",
                  "'how do I kill a Python process'",
                  "Harmful request answered"
                ]
              ]
            },
            {
              "type": "bullets",
              "items": [
                "Track ==both rates== together, never just one"
              ],
              "style": "check"
            },
            {
              "type": "heading",
              "text": "2. Classifier and Threshold",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "==Policy classifier== labels input or output against a written taxonomy",
                "Taxonomy: hate, self-harm, violence, sexual, illegal, privacy",
                "Returns **category + confidence score**",
                "Set the threshold ==per category== and per severity",
                "Evaluate on a **labelled set**: precision, recall, F1"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "Threshold",
                "Recall",
                "Precision",
                "Cost"
              ],
              "rows": [
                [
                  "Lower",
                  "{green:up}",
                  "{red:down}",
                  "More over-refusal"
                ],
                [
                  "Higher",
                  "{red:down}",
                  "{green:up}",
                  "More misses"
                ]
              ]
            },
            {
              "type": "heading",
              "text": "3. Graded Response and Escalation",
              "ink": "green"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "Allow",
                    "sub": "clearly safe",
                    "ink": "green"
                  },
                  {
                    "text": "Safe-completion",
                    "sub": "answer the safe part",
                    "ink": "blue"
                  },
                  {
                    "text": "Clarify",
                    "sub": "ask a question",
                    "ink": "orange"
                  },
                  {
                    "text": "Refuse",
                    "sub": "short reason + alternative",
                    "ink": "red"
                  }
                ]
              }
            },
            {
              "type": "bullets",
              "items": [
                "Fast small classifier = ==first gate==",
                "Borderline cases go to a larger **LLM judge** or human review",
                "Measure ==drift==; re-tune after policy or model changes"
              ],
              "style": "number"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Remember",
              "text": "Prefer **graded responses** over a hard block: refusing is the last step, not the only one."
            }
          ]
        }
