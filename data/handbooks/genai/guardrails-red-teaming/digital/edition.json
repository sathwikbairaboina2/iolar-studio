          "title": "PII Handling",
          "blocks": [
            {
              "type": "heading",
              "text": "1. What counts as PII",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "{green:Direct}: name, email, phone, SSN, card number",
                "{orange:Quasi}: DOB + ZIP + gender ==re-identify== when combined"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "heading",
              "text": "2. Detect, tokenize, restore",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "Structured types: ==regex + checksum== (Luhn for cards)",
                "Names and addresses: **NER model**",
                "Run detection on ==input and output==",
                "`Priya, priya@x.com` → `<PERSON_1>`, `<EMAIL_1>`",
                "Mapping stays ==server-side==; restore after the response"
              ],
              "style": "dot"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "Detect",
                    "sub": "regex, Luhn, NER",
                    "ink": "blue"
                  },
                  {
                    "text": "Tokenize",
                    "sub": "<PERSON_1>",
                    "ink": "purple"
                  },
                  {
                    "text": "Model",
                    "sub": "sees tokens only",
                    "ink": "orange"
                  },
                  {
                    "text": "Restore",
                    "sub": "from mapping",
                    "ink": "green"
                  }
                ]
              }
            },
            {
              "type": "heading",
              "text": "3. Treatments and retention",
              "ink": "purple"
            },
            {
              "type": "table",
              "headers": [
                "Method",
                "Reversible?",
                "Example"
              ],
              "rows": [
                [
                  "Redaction",
                  "{red:No}",
                  "`[REDACTED]`"
                ],
                [
                  "Masking",
                  "{red:No}, partial",
                  "`****1234`"
                ],
                [
                  "Pseudonymization",
                  "{green:Yes}, with key",
                  "`<PERSON_1>`"
                ]
              ],
              "frame": "dashed"
            },
            {
              "type": "bullets",
              "items": [
                "Log only ==redacted text==",
                "Set ==retention limits==",
                "Keep PII out of prompts, embeddings and fine-tuning data",
                "Honor deletion requests in ==vector stores== too"
              ],
              "style": "check"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Not anonymous",
              "text": "==Pseudonymized== data is still **personal data** under GDPR."
            }
          ]
        }
