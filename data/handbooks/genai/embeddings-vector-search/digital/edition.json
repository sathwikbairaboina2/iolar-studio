            {
              "type": "qa",
              "q": "Query q=[1,0]. Docs x=[10,0] and y=[1,1]. Which wins under cosine, and which under L2 distance?",
              "a_bullets": [
                "Cosine: x = 1.0, y ≈ 0.71, so **x** wins",
                "L2: x is 9 away, y is 1 away, so **y** wins",
                "Cosine ignores length, L2 does not"
              ]
            },
            {
              "type": "qa",
              "q": "You ask for k=10 with a tenant filter applied after the search, but get only 2 rows. Why?",
              "a_bullets": [
                "Top 10 were found across all tenants first",
                "Only 2 of them matched the tenant",
                "Apply the filter with the vector search"
              ]
            },
            {
              "type": "qa",
              "q": "RRF with k=60. Doc A is rank 1 in BM25 and rank 3 in vectors. Doc B is rank 2 in both. Who wins?",
              "a_bullets": [
                "A: 1/61 + 1/63 ≈ 0.03227",
                "B: 2/62 ≈ 0.03226",
                "**A** wins, by a hair"
              ]
            },
            {
              "type": "qa",
              "q": "Pure vector search returns unrelated results for the query `ERR_4012`. Why, and what fixes it?",
              "a_bullets": [
                "Embeddings capture meaning, not exact strings",
                "BM25 matches the exact token",
                "Go hybrid: merge both lists with RRF"
