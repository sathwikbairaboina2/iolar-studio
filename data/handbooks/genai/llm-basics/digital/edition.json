    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "Logits for three tokens are 2, 1, 0. You drop temperature from 1.0 to 0.2. What happens to the top token's probability?",
              "a_bullets": [
                "It rises toward 1.",
                "Dividing logits by a small T widens the gaps before softmax.",
                "Sampling becomes near-greedy."
              ]
            },
            {
              "type": "qa",
              "q": "An 8k window, a 7.5k-token prompt, and you ask for a 2k-token answer. What goes wrong?",
              "a_bullets": [
                "Input and output share the window.",
                "Only about 500 tokens fit, so the answer is cut off or the call errors."
              ]
            },
            {
              "type": "qa",
              "q": "A chatbot sends only the newest user message each call, yet expects replies to use earlier turns. Why does it fail?",
              "a_bullets": [
                "The model has no memory between calls.",
                "Resend the whole conversation every turn.",
                "You pay for those resent tokens each time."
              ]
            },
            {
              "type": "qa",
              "q": "You prompt a base model with 'What is the capital of France?' and it replies with more quiz questions. Why?",
              "a_bullets": [
                "Pretraining only teaches continuing text.",
                "It never learned to follow instructions.",
                "Instruction tuning adds that; RLHF aligns preferences."
              ]
            }
          ]
        }
      ]
    }
