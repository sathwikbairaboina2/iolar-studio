              ]
            },
            {
              "type": "heading",
              "text": "3. Cost and When to Skip",
              "ink": "orange"
            },
            {
              "type": "bullets",
              "items": [
                "More ==tokens== and higher ==latency==",
                "Unneeded for **simple lookups**"
              ],
              "style": "cross",
              "ink": "orange"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Reasoning models",
              "text": "Many already think internally, so don't over-instruct them to reason step by step."
            }
          ]
        }
      ]
