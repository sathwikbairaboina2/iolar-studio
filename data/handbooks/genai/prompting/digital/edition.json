              "type": "heading",
              "text": "1. System Prompt vs User Message",
              "ink": "green"
            },
            {
              "type": "table",
              "headers": [
                "",
                "System prompt",
                "User message"
              ],
              "rows": [
                [
                  "Holds",
                  "==Role==, rules, tone, constraints",
                  "The **task** for this request"
                ],
                [
                  "Lifetime",
                  "Persistent, every turn",
                  "Per request"
                ]
              ]
            },
            {
              "type": "bullets",
              "items": [
                "Hard rules: ==short, specific, testable== statements",
                "{green:Good}: 'Answer in max 3 sentences'",
                "{red:Vague}: 'Be concise and helpful'"
              ],
              "style": "check",
              "ink": "green"
            },
            {
              "type": "heading",
              "text": "2. Chain-of-Thought (CoT)",
              "ink": "blue"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "Question",
                    "ink": "blue"
                  },
                  {
                    "text": "Reason step by step",
                    "ink": "purple"
                  },
                  {
                    "text": "Final answer",
                    "ink": "green"
                  }
                ]
              }
            },
            {
              "type": "bullets",
              "items": [
                "Helps ==math==, ==logic== and **multi-step** tasks"
              ],
              "style": "dot"
