          "title": "Prompt Injection and Common Mistakes",
          "blocks": [
            {
              "type": "heading",
              "text": "1. How Injection Works",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "==Prompt injection==: untrusted text overrides your instructions",
                "Sources: user input, web page, email, document",
                "==Indirect== injection hides orders in retrieved content",
                "Model can't tell **instructions from data**",
                "'Ignore attacks' in the system prompt is {red:not a defence}"
              ],
              "style": "cross",
              "ink": "red"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "Web page",
                    "sub": "hidden order",
                    "ink": "orange"
                  },
                  {
                    "text": "Retrieved",
                    "sub": "into context",
                    "ink": "blue"
                  },
                  {
                    "text": "Model",
                    "sub": "obeys it",
                    "ink": "purple"
                  },
                  {
                    "text": "Tool call",
                    "sub": "leaks data",
                    "ink": "red"
                  }
                ]
              }
            },
            {
              "type": "heading",
              "text": "2. Mitigations",
              "ink": "green"
            },
            {
              "type": "table",
              "headers": [
                "Defence",
                "How"
              ],
              "rows": [
                [
                  "==Delimit==",
                  "label untrusted data with tags"
                ],
                [
                  "==Least privilege==",
                  "tools get minimum rights"
                ],
                [
                  "==Human approval==",
                  "confirm sensitive actions"
                ],
                [
                  "==Validate output==",
                  "filter and check before use"
                ]
              ]
            },
            {
              "type": "sidebox",
              "title": "Never",
              "items": [
                "Secrets in prompts",
                "Model output run as code, SQL or shell unchecked"
              ],
              "ink": "red"
            },
            {
              "type": "heading",
              "text": "3. Common Mistakes",
              "ink": "orange"
            },
            {
              "type": "table",
              "headers": [
                "Mistake",
                "Fix"
              ],
              "rows": [
                [
                  "Vague instructions",
                  "specific, testable"
                ],
                [
                  "Too many examples",
                  "2-5 diverse ones"
                ],
                [
                  "Conflicting rules",
                  "one consistent set"
                ],
                [
                  "No test set",
                  "run 5-10 cases"
                ],
                [
                  "Several changes at once",
                  "change one thing"
                ]
              ]
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "External text is untrusted",
              "text": "==Least privilege== plus **validated output** limits the damage."
            }
          ]
        }
      ]
    },
