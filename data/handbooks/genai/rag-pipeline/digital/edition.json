    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "With k=60, doc A is rank 1 in BM25 and rank 3 in vector search. Doc B is rank 2 in both. Which wins under RRF?",
              "a_bullets": [
                "A: 1/61 + 1/63 ≈ 0.03227",
                "B: 2/62 ≈ 0.03226",
                "**A wins**, barely. Rank 1 in one list outweighs steady rank 2."
              ]
            },
            {
              "type": "qa",
              "q": "You upgrade the embedding model but only embed new documents with it. Queries use the new model. What breaks?",
              "a_bullets": [
                "Old and new vectors live in different spaces, so similarity scores are meaningless.",
                "Old documents rank randomly or never appear.",
                "Fix: re-embed the whole corpus with one model."
              ]
            },
            {
              "type": "qa",
              "q": "Searching for error code `E4021` returns unrelated pages, though one page contains it. Why, and what fixes it?",
              "a_bullets": [
                "Embeddings match meaning, and an exact ID token carries little of it.",
                "Add BM25 keyword search and fuse the two lists with RRF."
              ]
            }
          ]
        }
      ]
    }
