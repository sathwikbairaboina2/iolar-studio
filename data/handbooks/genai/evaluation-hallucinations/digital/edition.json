    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "You set temperature to 0, yet the model still states a wrong fact. Why?",
              "a_bullets": [
                "Temperature 0 only makes decoding (nearly) greedy, not true.",
                "It still picks the likeliest token, which can be wrong.",
                "Fix: ground the answer with retrieval."
              ]
            },
            {
              "type": "qa",
              "q": "Your LLM judge always prefers the longer answer. What is this, and how do you fix it?",
              "a_bullets": [
                "**Verbosity bias**.",
                "Use a rubric that penalizes padding, or compare length-matched answers. Calibrate against human labels.",
                "Swapping answer order fixes position bias only."
              ]
            },
            {
              "type": "qa",
              "q": "An answer cites [doc3], and doc3 exists. Is the claim verified?",
              "a_bullets": [
                "No. Check that the quoted span appears in doc3 and supports the claim.",
                "Bad retrieval can still give a confident wrong answer."
              ]
            }
          ]
        }
      ]
    }
