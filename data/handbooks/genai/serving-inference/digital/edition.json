          "blocks": [
            {
              "type": "qa",
              "q": "TTFT is 200 ms and TPOT is 30 ms. A reply has 101 output tokens. What is the total latency?",
              "a_bullets": [
                "200 + (101 − 1) × 30 = ==3200 ms==",
                "The first token comes out of prefill, so only 100 decode steps remain"
              ]
            },
            {
              "type": "qa",
              "q": "A 7B FP16 model (14 GB weights, 0.5 MB KV per token) runs on a 24 GB GPU. The plan is batch 32 at 4k context. What breaks?",
              "a_bullets": [
                "Each sequence needs about 2 GB of KV cache, so 32 need about 64 GB",
                "Only about 10 GB is free, so roughly 5 sequences fit",
                "The bug is sizing for weights only"
              ]
            },
            {
              "type": "qa",
              "q": "Speculative decoding gave a big speedup at batch 1 but almost none at batch 256. Why?",
              "a_bullets": [
                "At large batch the GPU is already busy, so the spare capacity it uses is gone",
                "Output quality stays lossless either way"
              ]
            }
          ]
