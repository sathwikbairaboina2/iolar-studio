      "page_title": "LEFT JOIN Filters and Ranking Ties",
      "blocks": [
        {
          "type": "heading",
          "text": "1. LEFT JOIN filter in WHERE",
          "ink": "green"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "SELECT d.name, e.name",
            "FROM departments d",
            "LEFT JOIN employees e",
            "  ON e.dept_id = d.id",
            "  AND e.salary > 60000;"
          ],
          "note": "WHERE on e.* makes it INNER"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "SELECT name FROM employees",
            "ORDER BY hire_date DESC, id",
            "LIMIT 5;",
            "-- no ORDER BY: any 5 rows"
          ],
          "note": "LIMIT needs ORDER BY"
        },
        {
          "type": "sidebox",
          "title": "Spot the trap",
          "items": [
            "0 rows back? Look for NULL",
            "Fewer rows after a join? Check WHERE",
            "Wrong counts? Check GROUP BY"
          ],
          "ink": "orange"
        },
        {
          "type": "callout",
          "style": "tip",
          "title": "Tip",
          "text": "Test every query on the planted NULL rows: Asha has no manager, Hana has no department."
        },
        {
          "type": "bullets",
          "items": [
            "`WHERE e.salary > 60000` drops the NULL-padded rows",
            "Put right-table filters in the ==ON== clause"
          ],
          "style": "cross",
          "ink": "red"
        },
        {
          "type": "heading",
          "text": "2. Ranking and windows",
          "ink": "purple"
        },
        {
          "type": "table",
          "headers": [
            "Salary",
            "ROW_NUMBER",
            "RANK",
            "DENSE_RANK"
          ],
          "rows": [
            [
              "90000",
              "1",
              "1",
              "1"
            ],
            [
              "90000",
              "2",
              "1",
              "1"
            ],
            [
              "80000",
              "3",
              "3",
              "2"
            ]
          ],
          "highlightRow": 2
        },
        {
          "type": "bullets",
          "items": [
            "ROW_NUMBER splits ties arbitrarily; use RANK to share",
            "RANK leaves gaps; use **DENSE_RANK** for gapless"
          ],
          "style": "cross",
          "ink": "red"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "SELECT order_date, amount,",
            "  SUM(amount) OVER (",
            "    ORDER BY order_date, id",
            "  ) AS running",
            "FROM orders;"
          ],
          "note": "No ORDER BY sums whole partition"
        },
        {
          "type": "heading",
          "text": "SUMMARY",
          "style": "ribbon"
        },
        {
          "type": "bullets",
          "items": [
            "`IS NULL`, not `= NULL`; `NOT EXISTS`, not `NOT IN`",
            "Aggregate filters go in HAVING, not WHERE",
            "Right-table filters go in ON after a LEFT JOIN",
            "Window ORDER BY and query ORDER BY before LIMIT"
          ],
          "style": "checkbox"
        },
        {
          "type": "callout",
          "style": "banner",
          "title": "INTERVIEW TAKEAWAY:",
          "text": "These bugs run without errors and return plausible but wrong rows, so check NULLs, ties and ordering first."
        }
      ],
      "hero": "lightbulb",
      "subtitle": "Eight traps"
    },
    {
      "page_title": "Clause Order, Joins and Window Cheatsheet",
      "blocks": [
        {
          "type": "heading",
          "text": "1. Clause order",
          "ink": "blue"
        },
        {
          "type": "bullets",
          "items": [
            "**Written:** SELECT, FROM, JOIN, WHERE, GROUP BY, HAVING, ORDER BY, LIMIT",
            "**Runs:** FROM, WHERE, GROUP BY, HAVING, SELECT, ORDER BY, LIMIT",
            "SELECT runs ==late==, so an alias works in ORDER BY but not in WHERE"
          ],
          "style": "dot"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "SELECT salary * 12 AS annual",
            "FROM employees",
            "ORDER BY annual DESC;",
            "-- WHERE annual > 0 would fail"
          ],
          "note": "alias visible in ORDER BY only"
        },
        {
          "type": "heading",
          "text": "2. JOINs and lookups",
          "ink": "green"
        },
        {
          "type": "table",
          "headers": [
            "JOIN",
            "Rows kept"
          ],
          "rows": [
            [
              "INNER",
              "only matching pairs"
            ],
            [
              "LEFT",
              "all left, NULL if no match"
            ],
            [
              "RIGHT",
              "all right, NULL if no match"
            ],
            [
              "FULL",
              "all rows from both sides"
            ],
            [
              "CROSS",
              "every left x right pair"
            ]
          ]
        },
        {
          "type": "table",
          "headers": [
            "Tool",
            "Use when"
          ],
          "rows": [
            [
              "EXISTS",
              "test presence; NOT EXISTS is NULL-safe"
            ],
            [
              "IN",
              "short list or simple subquery"
            ],
            [
              "JOIN",
              "you need right-side columns, may duplicate rows"
            ]
          ]
        },
        {
          "type": "callout",
          "style": "sticky",
          "title": "NOT IN trap",
          "text": "One NULL in the subquery makes NOT IN match no rows. Use NOT EXISTS."
        },
        {
          "type": "heading",
