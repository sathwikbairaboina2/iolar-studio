      "page_title": "Nth Highest, Date and NULL One-Liners",
      "blocks": [
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "SELECT salary FROM (",
            "  SELECT salary,",
            "    DENSE_RANK() OVER (",
            "      ORDER BY salary DESC) r",
            "  FROM employees) t",
            "WHERE r = 3;"
          ],
          "note": "ties share one rank"
        },
        {
          "type": "heading",
          "text": "1. Date and null one-liners",
          "ink": "pink"
        },
        {
          "type": "bullets",
          "items": [
            "`COALESCE(x, 0)` turns NULL into a default",
            "`COUNT(*) FILTER (WHERE ...)` counts conditionally",
            "`date_trunc('month', d)` buckets by month"
          ],
          "style": "dot"
        },
        {
          "type": "callout",
          "style": "tip",
          "title": "Tip",
          "text": "Read the logical order when a query errors: WHERE cannot see SELECT aliases."
        },
        {
          "type": "heading",
          "text": "2. Interview classics",
          "ink": "red"
        },
        {
          "type": "bullets",
          "items": [
            "**DENSE_RANK:** rank in a subquery, filter `r = n`; no row if missing",
            "**OFFSET n-1:** wrap in a scalar subquery to get NULL if missing"
          ],
          "style": "check"
        },
        {
          "type": "code",
          "lang": "sql",
          "lines": [
            "SELECT (SELECT DISTINCT salary",
            "  FROM employees",
            "  ORDER BY salary DESC",
            "  OFFSET 2 LIMIT 1) AS third;"
          ],
          "note": "3rd highest, NULL if absent"
        },
        {
          "type": "table",
