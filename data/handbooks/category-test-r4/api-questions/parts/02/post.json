        {
          "type": "heading",
          "text": "1. Pagination and rate limits",
          "ink": "orange"
        },
        {
          "type": "bullets",
          "items": [
            "**Offset**: small, stable data",
            "**Cursor/keyset**: large or live data",
            "==Token bucket==: refills steadily, allows bursts",
            "==Fixed window==: counter resets each interval",
            "==Sliding window==: counts the last N seconds, smoother",
            "Over the limit: `429` plus `Retry-After`"
          ],
          "style": "dot",
          "frame": "dashed",
          "ink": "orange"
