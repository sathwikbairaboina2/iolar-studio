      "page_title": "Scaling Mistakes and Interview Questions",
      "blocks": [
        {
          "type": "heading",
          "text": "1. Mistakes",
          "ink": "red"
        },
        {
          "type": "bullets",
          "items": [
            "Same TTL on every menu key: one expiry stampedes the DB",
            "No timeout on search: one slow call blocks every thread",
            "Retrying a payment without an idempotency key: double charge",
            "Promos and orders sharing capacity: promos starve checkout"
          ],
          "style": "cross",
          "frame": "dashed",
          "ink": "red"
        },
        {
          "type": "sidebox",
          "title": "Interview questions",
          "items": [
            "Design surge pricing",
            "Add scheduled orders",
            "Restaurant goes offline mid-order",
            "Prevent coupon abuse"
          ],
          "ink": "purple"
        },
        {
          "type": "callout",
          "style": "banner",
          "title": "INTERVIEW TAKEAWAY:",
          "text": "Shed promos first, time out slow calls, degrade browse, and keep orders and payments consistent and idempotent."
        },
        {
          "type": "callout",
          "style": "tip",
          "title": "Interview tip",
          "text": "For each question, name the **failure mode** first, then the fix."
        },
        {
          "type": "bullets",
          "items": [
            "Surge pricing: demand/supply ratio per zone",
            "Scheduled orders: delayed job releases at dispatch time"
          ],
          "style": "dot",
          "ink": "purple"
        }
      ],
      "hero": "shield-check",
      "subtitle": "(Food Delivery App)"
