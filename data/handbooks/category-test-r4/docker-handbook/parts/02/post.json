              }
            ]
          }
        },
        {
          "type": "bullets",
          "items": [
            "Sidecar: `--pid=container:app --network=container:app`",
            "It shares the target's processes and network stack",
            "Bring your own tools, such as curl or strace"
          ],
          "style": "dot",
          "ink": "purple"
        },
        {
          "type": "heading",
          "text": "4. Events and OOM",
          "ink": "red"
        },
        {
          "type": "bullets",
          "items": [
            "`docker events` streams ==die==, oom and health_status",
            "Exit 137 is not proof: confirm the cause",
            "`docker inspect --format '{{.State.OOMKilled}}' c`",
            "It prints `true` only for an out-of-memory kill"
          ],
          "style": "number",
          "ink": "red"
        }
      ],
      "hero": "docker",
      "aside": "state first, then logs",
      "subtitle": "Find, read, fix"
    },
    {
      "page_title": "Network, Disk and OOM Checks",
      "blocks": [
        {
          "type": "code",
          "lang": "bash",
          "lines": [
            "docker events --filter event=oom",
            "docker inspect c \\",
            "  --format '{{.State.OOMKilled}}'",
            "docker inspect c \\",
            "  --format '{{.State.ExitCode}}'"
          ],
          "note": "137 without OOMKilled means manual kill",
          "result": {
            "headers": [
              "Output",
              "Reads as"
            ],
            "rows": [
              [
                "true",
                "OOM kill"
              ],
              [
                "137",
                "SIGKILL"
              ]
            ]
          }
        },
