    {
      "page_title": "range-diff",
      "blocks": [
        {
          "type": "concept",
          "number": 10,
          "title": "range-diff",
          "tagline": "v1 vs v2, commit by commit"
        },
        {
          "type": "labelrows",
          "rows": [
            {
              "icon": "git",
              "label": "What it is:",
              "text": "Compares two versions of a commit series, commit by commit"
            },
            {
              "icon": "lightbulb",
              "label": "Why it exists:",
              "text": "Plain diff after force-push mixes your changes with rebase noise"
            },
            {
              "icon": "check",
              "label": "Used for:",
              "text": "Reviewing a v2 series; verifying a rebase changed nothing unintended"
            }
          ]
        },
        {
          "type": "heading",
          "text": "How it works",
          "style": "ribbon"
        },
        {
          "type": "code",
          "lang": "bash",
          "lines": [
            "# pairs commits by patch similarity",
            "git range-diff main old new",
            "# shorthand, e.g. after force-push",
            "git range-diff @{u}...@",
            "git range-diff A...B"
          ],
          "note": "needs the old tip reachable",
          "result": {
            "headers": [
              "Pair",
              "Mark",
              "Meaning"
            ],
            "rows": [
              [
                "1 → 1",
                "=",
                "unchanged"
              ],
              [
                "2 → 2",
                "!",
                "modified + inner diff"
              ],
              [
                "3 → -",
                "<",
                "dropped"
              ],
              [
                "- → 3",
                ">",
                "added"
              ]
            ]
          }
        },
        {
          "type": "bullets",
          "items": [
            "**Benefits:** it ==diffs the diff==, so only real changes appear",
            "Finds reordered or squashed commits",
            "Works after force-push using the reflog's old tip"
          ],
          "style": "check",
          "frame": "solid",
          "ink": "green"
        },
        {
          "type": "bullets",
          "items": [
            "**Things to consider:** you need the old tip (saved branch, reflog, `@{u}`)",
            "Heavily rewritten commits may fail to pair: drop + add",
            "Output is dense; read it in a pager"
          ],
          "style": "cross",
          "frame": "solid",
          "ink": "red"
        },
        {
          "type": "callout",
          "style": "banner",
          "title": "Interview takeaway:",
          "text": "range-diff compares **patch series**, not trees.\nReview a force-pushed PR without re-reading everything, and keep the old tip reachable."
        }
      ],
      "hero": "git",
      "aside": "diff the diff",
      "subtitle": "Compare patch series"
    },
    {
      "page_title": "Git Commands Cheatsheet",
      "blocks": [
        {
          "type": "heading",
          "text": "1. Switch and restore",
          "ink": "blue"
        },
        {
          "type": "code",
          "lang": "bash",
          "lines": [
            "git switch -c name origin/main",
            "git restore f",
            "git restore --staged f",
            "git restore --source=HEAD~2 f"
          ],
          "note": "restore drops edits for good"
        },
        {
          "type": "heading",
          "text": "2. Shelve work",
          "ink": "green"
        },
        {
          "type": "code",
          "lang": "bash",
          "lines": [
            "git stash push -m msg -u",
            "git stash apply",
            "git stash pop"
          ],
          "note": "apply keeps it, pop drops it"
        },
        {
          "type": "heading",
          "text": "3. Read history",
          "ink": "purple"
        },
        {
          "type": "code",
          "lang": "bash",
          "lines": [
            "git log --graph --oneline --decorate --all",
            "git blame -w -M -C -L 40,60 f"
          ],
          "note": "blame -w skips whitespace edits"
        },
        {
          "type": "heading",
          "text": "4. Backport and parallel",
          "ink": "orange"
        },
        {
          "type": "code",
          "lang": "bash",
          "lines": [
            "git cherry-pick -x sha",
            "git cherry-pick A^..B"
          ],
          "note": "-x leaves an audit trail"
        },
        {
          "type": "code",
          "lang": "bash",
          "lines": [
            "git worktree add ../dir -b name",
            "git worktree remove ../dir"
          ],
          "note": "one branch per worktree"
        },
        {
          "type": "heading",
          "text": "5. Clean up history",
          "ink": "pink"
        },
        {
          "type": "code",
          "lang": "bash",
          "lines": [
            "git rebase -i HEAD~4",
            "git commit --fixup sha",
            "git rebase -i --autosquash main",
            "git push --force-with-lease"
          ],
          "note": "never rebase shared commits"
        },
        {
          "type": "heading",
          "text": "6. Recover and debug",
          "ink": "red"
        },
        {
          "type": "code",
          "lang": "bash",
          "lines": [
            "git reflog",
            "git reset --hard HEAD@{1}",
            "git bisect start/bad/good/run",
            "git range-diff main old new"
          ],
          "note": "reflog is local, expires in time"
        },
        {
          "type": "callout",
          "style": "banner",
          "title": "INTERVIEW TAKEAWAY:",
          "text": "Git moves pointers, so ==reflog== rescues most mistakes. Only **uncommitted** edits are gone for good."
        }
      ],
      "hero": "git",
      "aside": "pin this page!",
      "subtitle": "Twelve commands, one page"
    }
