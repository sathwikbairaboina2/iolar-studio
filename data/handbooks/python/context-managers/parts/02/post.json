        {
          "type": "heading",
          "text": "Wrap Anything With close()"
        },
        {
          "type": "bullets",
          "items": [
            "==closing(obj)== calls `obj.close()` on exit",
            "`with closing(urlopen(url)) as page:`",
            "Fixes legacy objects that lack __exit__"
          ]
        },
        {
          "type": "heading",
          "text": "Manager as Decorator",
          "ink": "purple"
        },
        {
          "type": "code",
          "lang": "python",
          "lines": [
            "class timed(ContextDecorator):",
            "    def __enter__(self): ...",
            "    def __exit__(self, *exc): ...",
            "@timed()",
            "def run(): ...   # wrapped in with"
          ]
        },
        {
          "type": "callout",
          "style": "tip",
          "title": "Temp Files",
          "text": "`TemporaryDirectory()` and `NamedTemporaryFile()` delete themselves on exit — no manual cleanup code."
        }
