          "type": "code",
          "lang": "python",
          "lines": [
            "@contextmanager",
            "def txn(conn):",
            "    conn.execute('BEGIN')",
            "    try:",
            "        yield conn",
            "    except Exception:",
            "        conn.rollback(); raise",
            "    else:",
            "        conn.commit()"
