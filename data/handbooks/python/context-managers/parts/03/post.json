      "page_title": "ExitStack Patterns, async with",
      "blocks": [
        {
          "type": "heading",
          "text": "Capture and Scope",
          "ink": "blue"
        },
        {
          "type": "code",
          "lang": "python",
          "lines": [
            "buf = io.StringIO()",
            "with redirect_stdout(buf):",
            "    print('hi')",
            "buf.getvalue()   # 'hi\\n'"
          ]
        },
        {
          "type": "bullets",
          "items": [
            "`redirect_stderr(buf)` is the mirror image",
            "`contextlib.chdir(path)` (3.11+) — scoped cwd change",
            "No more manual getcwd/chdir pairs"
          ]
        },
        {
          "type": "code",
          "lang": "python",
          "lines": [
            "with warnings.catch_warnings():",
            "    warnings.simplefilter('error')",
            "    run()   # warnings become failures"
          ]
        },
        {
          "type": "bullets",
          "items": [
            "`multiprocessing.Pool` — `with` calls terminate/join",
            "`concurrent.futures.Executor` — `with` calls shutdown",
            "Never hand-roll the shutdown call again"
          ]
        },
        {
          "type": "heading",
          "text": "Use After Close",
          "ink": "red"
        },
        {
          "type": "code",
          "lang": "python",
          "lines": [
            "with open(p) as f:",
            "    pass",
            "f.read()  # ValueError: I/O operation on",
            "          # closed file"
          ]
        },
        {
          "type": "bullets",
          "items": [
            "`with open(a), open(b):` — second failing is SAFE",
            "The first is still closed properly",
            "The unsafe move is touching f after the block"
          ]
        }
      ]
    }
