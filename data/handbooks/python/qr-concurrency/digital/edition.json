    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "Four threads each run a pure-Python CPU loop on standard 3.12. Versus running them one after another, is it faster?",
              "a_bullets": [
                "No: about the same, often slower.",
                "The ==GIL== lets one thread run bytecode at a time, and switching adds overhead.",
                "Use `ProcessPoolExecutor` for CPU-bound work."
              ]
            },
            {
              "type": "qa",
              "q": "Two coroutines each call `time.sleep(1)`, run with `asyncio.gather`. How long does it take?",
              "a_bullets": [
                "About ==2 seconds==. `time.sleep` blocks the one thread, so the loop cannot switch tasks.",
                "With `await asyncio.sleep(1)` it takes about 1 second."
              ]
            },
            {
              "type": "qa",
              "q": "You `submit()` a worker that raises `ValueError` and never touch the future. What do you see?",
              "a_bullets": [
                "Nothing: the exception is stored in the `Future`.",
                "`future.result()` re-raises it; so does iterating `executor.map`."
              ]
            }
          ]
        }
      ]
