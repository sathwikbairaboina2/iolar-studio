          "title": "argparse and Stdlib Cheat Sheet",
          "blocks": [
            {
              "type": "heading",
              "text": "1. The Parser Pattern",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "`p.add_argument(...)`, then `args = p.parse_args()`",
                "==Positional== args are required",
                "`--flag` options are ==optional== by default",
                "`-h/--help` is automatic; `add_help=False` frees `-h`",
                "Bad input exits with code ==2=="
              ],
              "style": "dot"
            },
            {
              "type": "code",
              "lang": "python",
              "lines": [
                "import argparse",
                "p = argparse.ArgumentParser()",
                "p.add_argument(\"--dry-run\", action=\"store_true\")",
                "args = p.parse_args([\"--dry-run\"])",
                "print(args.dry_run)"
              ],
              "note": "--dry-run becomes args.dry_run"
            },
            {
              "type": "code",
              "lang": "output",
              "lines": [
                "True"
              ]
            },
            {
              "type": "heading",
              "text": "2. Options and Actions",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "Option",
                "Effect"
              ],
              "rows": [
                [
                  "`type=int`",
                  "convert value"
                ],
                [
                  "`default=` / `help=`",
                  "fallback / -h text"
                ],
                [
                  "`choices=[...]`",
                  "restrict values"
                ],
                [
                  "`required=True`",
                  "force an option"
                ],
                [
                  "`nargs='+'`",
                  "one or more values"
                ],
                [
                  "`dest=`",
                  "attribute name"
                ],
                [
                  "`store_true`",
                  "boolean flag"
                ],
                [
                  "`count`",
                  "`-vvv` gives 3"
                ],
                [
                  "`append`",
                  "repeat option, list"
                ],
                [
                  "`add_subparsers(dest='cmd')`",
                  "then `sp.add_parser('run')`"
                ]
              ]
            }
          ]
        }
