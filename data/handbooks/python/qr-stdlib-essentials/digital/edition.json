    {
      "title": "collections and itertools",
      "role": "outline",
      "outlineIndex": 4,
      "pages": [
        {
          "title": "collections and itertools",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Counter, defaultdict, deque",
              "ink": "green"
            },
            {
              "type": "table",
              "headers": [
                "Type",
                "Does",
                "Gotcha"
              ],
              "rows": [
                [
                  "`Counter(iterable)`",
                  "counts hashables; `.most_common(n)` gives (item, count) pairs",
                  "missing key → ==0==, no KeyError; supports `+` and `-`"
                ],
                [
                  "`defaultdict(list)`",
                  "factory builds value on first access; ideal for grouping",
                  "reading a missing key ==inserts== it; use `.get()`"
                ],
                [
                  "`deque(maxlen=n)`",
                  "O(1) append/popleft at both ends; drops old items",
                  "`list.pop(0)` is O(n); no fast middle index"
                ]
              ],
              "highlightRow": 0
            },
            {
              "type": "heading",
              "text": "2. itertools",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "Function",
                "Does"
              ],
              "rows": [
                [
                  "`chain(a, b)`",
                  "joins iterables"
                ],
                [
                  "`islice(it, n)`",
                  "slices any iterator"
                ],
                [
                  "`groupby(data, key)`",
                  "groups ==consecutive== items only"
                ],
                [
                  "`product` / `permutations` / `combinations(it, r)`",
                  "lazy combinatorics"
                ],
                [
                  "`accumulate`",
                  "running totals"
                ],
                [
                  "`zip_longest`",
                  "pads uneven inputs"
                ]
              ]
            },
            {
              "type": "code",
              "lang": "python",
              "lines": [
                "from itertools import groupby",
                "data = sorted([\"ant\", \"bee\", \"ape\", \"bat\"])",
                "for k, g in groupby(data, key=lambda w: w[0]):",
                "    print(k, list(g))"
              ],
              "note": "sort first, or equal keys split into many groups"
            },
            {
              "type": "code",
              "lang": "output",
              "lines": [
                "a ['ant', 'ape']",
                "b ['bat', 'bee']"
              ]
            },
            {
              "type": "heading",
              "text": "3. One pass only",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "itertools results are {red:one-shot} iterators, ==exhausted== after one pass",
                "Wrap in `list()` to reuse",
                "`groupby` on unsorted data splits equal keys"
              ],
              "style": "cross",
              "frame": "dashed",
              "ink": "red"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Remember",
              "text": "**Sort** before `groupby`; `list()` before reusing any iterator."
            }
          ]
        }
      ]
    },
    {
      "title": "argparse and Stdlib Cheat Sheet",
