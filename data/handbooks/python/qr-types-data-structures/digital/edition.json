          "blocks": [
            {
              "type": "heading",
              "text": "1. Objects and Names",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "`int` `float` `bool` `str` `bytes` `list` `tuple` `dict` `set` `frozenset` `NoneType`",
                "Every value is an object: ==id==, **type**, value",
                "Names are bound to objects, not boxes",
                "`b = a` gives ==two names==, one object"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "heading",
              "text": "2. Mutable vs Immutable",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "",
                "Mutable",
                "Immutable"
              ],
              "rows": [
                [
                  "Types",
                  "list, dict, set, bytearray",
                  "int, str, tuple, frozenset, bytes"
                ],
                [
                  "Change",
                  "in place",
                  "never: rebinds"
                ]
              ]
            },
            {
              "type": "code",
              "lang": "python",
              "lines": [
                "a = [1]",
                "b = a",
                "b.append(2)",
                "print(a, a is b)",
                "s = t = \"hi\"",
                "s += \"!\"",
                "print(s, t)"
              ],
              "note": "s += rebinds s; t keeps the old object"
            },
            {
              "type": "code",
              "lang": "output",
              "lines": [
                "[1, 2] True",
                "hi! hi"
              ]
            },
            {
              "type": "bullets",
              "items": [
                "`==` compares ==value==; `is` compares ==identity==",
                "Use `is` only for `None`, `True`, `False`"
              ],
              "style": "check"
            },
            {
              "type": "heading",
              "text": "3. Hashable",
              "ink": "purple"
            },
            {
              "type": "bullets",
              "items": [
                "==Hashable== = `__hash__` that **never changes** and agrees with `__eq__`",
                "Built-in immutables: {green:hashable}; built-in mutable containers: {red:not}",
                "User-class instances: hashable by ==identity== by default",
                "A tuple is hashable only if **all items** are",
                "Only hashable objects: dict keys, set members"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "purple"
            }
          ]
        }
      ]
