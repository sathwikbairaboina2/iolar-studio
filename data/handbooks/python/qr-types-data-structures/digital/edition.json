          "title": "Slicing and Comprehensions",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Slice Rules",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "`seq[start:stop:step]`, ==stop is exclusive==",
                "Negatives count from the end: `s[-1]` is the last item",
                "Out-of-range bounds are ==clamped==, never raise",
                "A list slice copies: ==O(k)== for k items"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "Idiom",
                "Gives"
              ],
              "rows": [
                [
                  "`s[::-1]`",
                  "reversed copy"
                ],
                [
                  "`s[:]`",
                  "shallow copy"
                ],
                [
                  "`s[-3:]`",
                  "last three"
                ],
                [
                  "`s[::2]`",
                  "every second item"
                ]
              ]
            },
            {
              "type": "heading",
              "text": "2. Assignment and Immutables",
              "ink": "purple"
            },
            {
              "type": "bullets",
              "items": [
                "`lst[1:3] = [9]` can ==resize== the list",
                "`str` and `tuple` slices return **new objects** (immutable)"
              ],
              "style": "dot"
            },
            {
              "type": "code",
              "lang": "python",
              "lines": [
                "lst = [1, 2, 3, 4]",
                "lst[1:3] = [9]",
                "print(lst)"
              ]
            },
            {
              "type": "code",
              "lang": "output",
              "lines": [
                "[1, 9, 4]"
              ]
            },
            {
              "type": "heading",
              "text": "3. Comprehensions",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "`[f(x) for x in it if cond]` builds a list",
                "`{k: v for ...}` dict, `{x for ...}` set",
                "`(x for x in it)` is a lazy ==generator==, **O(1) memory**",
                "Prefer it inside `sum()`, `any()`, `all()`: no temporary list"
              ],
              "style": "check",
              "ink": "green"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "if vs else",
              "text": "A lone `if` goes after the loop. With `else` it moves ==before== `for`: `[a if c else b for x in it]`"
            }
          ]
        }
