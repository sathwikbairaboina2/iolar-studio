          "title": "Copying and Truthiness",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Assignment vs Copies",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "`b = a` copies **nothing**: two names, ==one object==",
                "Mutating through either name shows through both",
                "`copy.deepcopy(a)`: recursive, slower, handles cycles"
              ],
              "style": "dot"
            },
            {
              "type": "table",
              "headers": [
                "Method",
                "Outer",
                "Inner"
              ],
              "rows": [
                [
                  "`b = a`",
                  "same",
                  "same"
                ],
                [
                  "`a.copy()`, `list(a)`, `a[:]`, `copy.copy(a)`",
                  "new",
                  "{red:shared}"
                ],
                [
                  "`copy.deepcopy(a)`",
                  "new",
                  "{green:new}"
                ]
              ],
              "highlightRow": 1
            },
            {
              "type": "heading",
              "text": "2. Truthiness",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "{red:Falsy}: `None`, `False`, `0`, `0.0`, `''`, `[]`, `()`, `{}`, `set()`, `range(0)`",
                "Everything else is truthy, even `'0'` and `[0]`"
              ],
              "style": "check"
            },
            {
              "type": "heading",
              "text": "3. Shared-State Traps",
              "ink": "red"
            },
            {
              "type": "bullets",
              "items": [
                "`def f(x=[])`: default built ==once==, shared by every call",
                "Fix: `x=None`, then `x = []` inside",
                "`[[0]*3]*3` repeats ==one inner row==",
                "Fix: `[[0]*3 for _ in range(3)]`"
              ],
              "style": "cross"
            },
            {
              "type": "code",
              "lang": "python",
              "lines": [
                "g = [[0]*3]*3",
                "g[0][0] = 1",
                "print(g[1][0])"
              ]
            },
            {
              "type": "code",
              "lang": "output",
              "lines": [
                "1"
              ]
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Remember",
              "text": "Copies are shallow by default; nested edits need ==deepcopy==."
            }
          ]
        }
      ]
