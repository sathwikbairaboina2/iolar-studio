              "expression",
              "per item"
            ]
          ]
        },
        {
          "type": "bullets",
          "items": [
            "Mutating the source list while the genexp runs.",
            "Expecting a closed-over name to be frozen.",
            "Assuming every error waits until consumption."
          ],
          "style": "cross"
        },
