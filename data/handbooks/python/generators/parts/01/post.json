        },
        {
          "type": "heading",
          "text": "30. Coroutine Lineage"
        },
        {
          "type": "table",
          "headers": [
            "Kind",
            "Driven by",
            "Protocol"
          ],
          "rows": [
            [
              "generator (PEP 342)",
              "next / send",
              "__next__"
            ],
            [
              "async def",
              "event loop",
              "__await__"
            ]
          ]
        },
        {
