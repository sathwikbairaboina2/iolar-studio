              "type": "heading",
              "text": "1. Functions Are Objects",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "`def` builds a ==function object== and binds it to a name",
                "Assign it, or store it in a list or dict",
                "Pass it as an argument, or return it"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "code",
              "lang": "python",
              "lines": [
                "def f(x): return x * 2",
                "g = f",
                "ops = {'dbl': f}",
                "del f",
                "print(g(2), ops['dbl'](3))"
              ],
              "note": "del f removes one name, not the object"
            },
            {
              "type": "code",
              "lang": "output",
              "lines": [
                "4 6"
              ]
            },
