              "rows": [
                [
                  "`sorted(words, key=len)`",
                  "`len` computes the sort key"
                ],
                [
                  "`map(str.upper, xs)`",
                  "`str.upper` applied to each item"
                ],
                [
                  "`filter(None, xs)`",
                  "`None` keeps only truthy items"
                ],
                [
                  "`def make(): return f`",
                  "returns a function"
                ]
