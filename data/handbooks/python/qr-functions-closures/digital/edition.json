    {
      "title": "Cheat Sheet: Functions, Scope and Decorators",
      "role": "outline",
      "outlineIndex": 5,
      "pages": [
        {
          "title": "Cheat Sheet: Functions, Scope and Decorators",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Arguments and defaults",
              "ink": "green"
            },
            {
              "type": "code",
              "lang": "python",
              "lines": [
                "def f(a, b=1, *args, kw, kw2=2, **kwargs): ...",
                "def g(a, /, b, *, c): ..."
              ],
              "note": "order: positional, default, *args, keyword-only, **kwargs"
            },
            {
              "type": "bullets",
              "items": [
                "`/` ends ==positional-only==; `*` or `*args` starts ==keyword-only==",
                "{red:Mutable default} like `acc=[]` is shared by every call",
                "Fix: `acc=None`, then create `acc = []` inside the body"
              ],
              "style": "dot",
              "ink": "green"
            },
            {
              "type": "heading",
              "text": "2. Scope and closures",
              "ink": "blue"
            },
            {
              "type": "diagram",
              "kind": "flow",
              "spec": {
                "nodes": [
                  {
                    "text": "Local",
                    "ink": "green"
                  },
                  {
                    "text": "Enclosing",
                    "ink": "blue"
                  },
                  {
                    "text": "Global",
                    "ink": "purple"
                  },
                  {
                    "text": "Built-in",
                    "ink": "orange"
                  }
                ]
              }
            },
            {
              "type": "bullets",
              "items": [
                "`nonlocal` or `global` only to ==rebind==; reading needs neither",
                "==Closure== = inner function + captured variables",
                "{red:Loop capture}: `lambda: i` sees the last i; fix with `lambda i=i: i`"
              ],
              "style": "dot",
              "ink": "blue"
            },
            {
              "type": "heading",
              "text": "3. Decorators",
              "ink": "purple"
            },
            {
              "type": "code",
              "lang": "python",
              "lines": [
                "def deco(fn):",
                "    @functools.wraps(fn)",
                "    def wrapper(*a, **kw):",
                "        return fn(*a, **kw)",
                "    return wrapper"
              ]
            },
            {
              "type": "bullets",
              "items": [
                "Stacked decorators apply ==bottom-up==: the one nearest `def` wraps first"
              ],
              "style": "dot",
              "ink": "purple"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Keep the identity",
              "text": "Skip `@functools.wraps` and the function loses its `__name__` and `__doc__`."
            }
          ]
        }
      ]
