        {
          "type": "table",
          "headers": [
            "Stack",
            "Effect"
          ],
          "rows": [
            [
              "`@cache` over `@log`",
              "repeats never log"
            ],
            [
              "`@log` over `@cache`",
              "logs hits too"
            ],
            [
              "`@timer` over `@retry`",
              "total elapsed"
            ],
            [
              "`@retry` over `@timer`",
              "per attempt"
            ]
          ]
        },
        {
          "type": "heading",
          "text": "5. Walking The Chain"
        },
        {
          "type": "code",
          "lang": "python",
          "lines": [
            "f.__wrapped__.__wrapped__  # two layers down",
            "inspect.unwrap(f)          # the raw function"
          ]
        },
        {
          "type": "callout",
          "style": "tip",
          "title": "Frame Tax",
          "text": "Each layer adds one Python frame per call. Deep stacks show up in profiles and clutter every traceback."
        },
        {
          "type": "heading",
          "text": "1. Cache And Clock",
          "ink": "green"
        },
        {
          "type": "code",
          "lang": "python",
          "lines": [
            "@functools.cache               # unbounded",
            "@functools.lru_cache(maxsize=128)",
            "f.cache_info(); f.cache_clear()"
          ]
        },
        {
          "type": "bullets",
          "items": [
            "Cached arguments must be hashable",
            "Time with `time.perf_counter()` deltas around the call",
            "Never `time.time()` for durations — the wall clock jumps"
          ]
        },
        {
          "type": "heading",
          "text": "2. Retry With Backoff"
        },
        {
          "type": "code",
          "lang": "python",
          "lines": [
            "for i in range(attempts):",
            "    try: return fn(*a, **kw)",
            "    except (IOError, Timeout):",
            "        if i == attempts - 1: raise",
            "        time.sleep(delay * 2**i)"
          ]
        },
        {
          "type": "heading",
