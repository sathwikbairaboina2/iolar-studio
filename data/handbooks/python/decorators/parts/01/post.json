              "`__qualname__`",
              "dotted path"
            ],
            [
              "`__doc__`",
              "docstring"
            ],
            [
              "`__module__`",
              "defining module"
            ],
            [
              "`__defaults__`",
              "default tuple"
            ]
          ]
        },
        {
          "type": "code",
          "lang": "python",
          "lines": [
            "greet.calls = 0     # legal: has __dict__",
            "greet.calls += 1    # arbitrary attrs stick",
            "greet.__dict__      # {'calls': 1}"
          ]
        },
        {
          "type": "heading",
          "text": "3. Higher-Order Builtins"
        },
