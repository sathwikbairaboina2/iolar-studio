        {
          "type": "heading",
          "text": "19. Stacking Factories"
        },
        {
          "type": "code",
          "lang": "python",
          "lines": [
            "@app.route('/users')",
            "@login_required",
            "@retry(times=3)",
            "def users(): ..."
          ],
          "note": "route outermost: registers final fn"
        },
        {
          "type": "bullets",
          "items": [
            "Applied **bottom-up**: `retry` wraps first",
            "Runs top-down: auth checks before any retry",
            "`@app.route` must see the fully decorated function"
          ]
        },
        {
          "type": "heading",
          "text": "20. Quick Self-Check",
          "ink": "purple"
