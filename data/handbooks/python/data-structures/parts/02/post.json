      "blocks": [
        {
          "type": "callout",
          "style": "tip",
          "title": "Why O(n)?",
          "text": "pop(0) removes the front, so every remaining element shifts one position left."
        },
        {
          "type": "heading",
          "text": "Common Queue Ops",
