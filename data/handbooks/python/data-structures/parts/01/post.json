          "ink": "blue"
        },
        {
          "type": "code",
          "lang": "python",
          "lines": [
            "s = {10,20,30,40}",
            "20 in s        # True",
            "999 in s       # False",
            "100 not in s   # True"
          ]
        },
        {
          "type": "callout",
          "style": "tip",
          "title": "Why So Fast?",
          "text": "Sets hash the element straight to its slot, so membership is O(1) on average — no scan."
        },
        {
          "type": "heading",
          "text": "5. Unordered Nature",
          "ink": "blue"
        },
        {
          "type": "code",
          "lang": "python",
          "lines": [
            "s1 = {1,2,3,4}",
            "s2 = {4,3,2,1}",
            "s1 == s2   # True — order irrelevant"
          ]
        },
        {
          "type": "callout",
