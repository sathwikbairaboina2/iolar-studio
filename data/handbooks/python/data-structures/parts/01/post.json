          "ink": "blue"
        },
        {
          "type": "diagram",
          "kind": "flow",
          "spec": {
            "nodes": [
              "cap 4 / size 4",
              "append(50): cap 8 / size 5",
              "append(60): size 6",
              "append(70): size 7",
              "append(80): cap 16 / size 8"
