        {
          "type": "table",
          "headers": [
            "Operator",
            "Method",
            "Result"
          ],
          "rows": [
            [
              "A | B",
              "A.union(B)",
              "{1,2,3,4,5}"
            ],
            [
              "A & B",
              "A.intersection(B)",
              "{3}"
            ],
            [
              "A - B",
              "A.difference(B)",
              "{1,2}"
            ],
            [
              "A ^ B",
              "A.symmetric_difference(B)",
              "{1,2,4,5}"
            ]
          ]
        },
        {
          "type": "callout",
          "style": "tip",
          "title": "Methods Take Any Iterable",
          "text": "`A.union([4,5])` works, but `A | [4,5]` raises **TypeError** — operators need both sides to be sets."
        },
        {
          "type": "code",
          "lang": "python",
          "lines": [
            "A |= B   # A.update(B)",
            "A &= B   # intersection_update",
            "A -= B   # difference_update",
            "fs = frozenset(A)  # hashable"
          ],
          "note": "in-place forms mutate A"
        }
      ]
    },
    {
      "page_title": "Set Membership & Complexity",
