    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "This test passes even though x is 2. Why?",
              "example_code": [
                "x = 2",
                "assert (x == 1, 'x must be 1')"
              ],
              "a_bullets": [
                "The parentheses build a non-empty tuple, which is always truthy",
                "Fix: `assert x == 1, 'x must be 1'`"
              ]
            },
            {
              "type": "qa",
              "q": "app.py does `from time import sleep`. A test patches `time.sleep`, yet the real sleep still runs. Why?",
              "a_bullets": [
                "`app.sleep` is its own name, bound at import time, so patching `time.sleep` misses it",
                "Patch where it is looked up: `app.sleep`"
              ]
            },
            {
              "type": "qa",
              "q": "A module-scoped fixture returns `[]`. Test A appends 1, then test B asserts the list is empty and fails. Why, and what is the fix?",
              "a_bullets": [
                "Module scope shares one list, so A's mutation leaks into B",
                "Use function scope, or have each test copy it"
              ]
            }
          ]
        }
      ]
    }
