            {
              "type": "heading",
              "text": "3. Pytest and Crashes",
              "ink": "orange"
            },
            {
              "type": "bullets",
              "items": [
                "`--pdb` opens pdb on failure; `-x --lf` stops at first failure, reruns last failures",
                "`--pdb` turns capture off itself, so the prompt shows without `-s`",
                "Post-mortem: run under pdb, or `pdb.pm()` after a crash"
              ],
              "style": "dot"
            },
            {
              "type": "code",
              "lang": "bash",
              "lines": [
                "pytest --pdb",
                "pytest -x --lf -s",
                "python -m pdb script.py",
                "python -i script.py  # then: import pdb; pdb.pm()"
              ]
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Unknown name runs as Python",
              "text": "A variable named `n`, `c` or `s` is read as a command. Print it with ==p n==."
