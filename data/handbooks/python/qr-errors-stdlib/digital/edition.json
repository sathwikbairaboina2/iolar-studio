                ]
              ]
            },
            {
              "type": "heading",
              "text": "3. Common Mistake",
              "ink": "red"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "GIL does not mean thread-safe",
              "text": "`counter += 1` is ==not atomic==. Guard shared state with `threading.Lock`."
            },
            {
              "type": "code",
