    {
      "title": "Imports, Packages, __main__, venv and pip",
      "role": "outline",
      "outlineIndex": 4,
      "pages": [
        {
          "title": "Imports, Packages, __main__, venv and pip",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Imports and `__main__`",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "Avoid `from m import *`: it ==hides where names come from==",
                "`__main__` guard runs only when **executed directly**, not on import",
                "Run modules with `python -m pkg.mod`"
              ],
              "style": "dot"
            },
            {
              "type": "code",
              "lang": "python",
              "lines": [
                "import m",
                "from m import x",
                "import m as alias",
                "if __name__ == '__main__':",
                "    main()"
              ]
            },
            {
              "type": "heading",
              "text": "2. Packages",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "Folder with `__init__.py` = ==regular package==",
                "`__init__.py` runs on import and can **re-export** names",
                "Relative import: `from . import util`"
              ],
              "style": "dot"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Classic import errors",
              "text": "==Circular imports==, and a local file named like a stdlib module (`random.py`) that shadows it."
            },
            {
              "type": "heading",
              "text": "3. venv and pip",
              "ink": "purple"
            },
            {
              "type": "bullets",
              "items": [
                "Create `.venv`, activate it, and **never commit** it",
                "Use `python -m pip` so it targets the ==right interpreter=="
              ],
              "style": "check"
            },
            {
              "type": "code",
              "lang": "bash",
              "lines": [
                "python -m venv .venv",
                ".venv\\Scripts\\activate  # Windows",
                "source .venv/bin/activate  # elsewhere"
              ]
            },
            {
              "type": "table",
              "headers": [
                "Command",
                "Does"
              ],
              "rows": [
                [
                  "`pip install pkg`",
                  "install a package"
                ],
                [
                  "`pip install -r requirements.txt`",
                  "install the listed set"
                ],
                [
                  "`pip freeze > requirements.txt`",
                  "save exact versions"
                ],
                [
                  "`pip list`",
                  "show installed"
                ]
              ]
            }
          ]
        }
      ]
