              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "`Path('data') / 'in.txt'` joins with ==/==",
                "The **right separator** is used on every OS",
                "`p.exists()`, `p.is_file()`, `p.is_dir()` inspect"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "table",
              "headers": [
                "Part",
                "Gives for data/in.txt"
              ],
              "rows": [
                [
                  "`p.name`",
                  "in.txt"
                ],
                [
                  "`p.stem`",
                  "in"
                ],
                [
                  "`p.suffix`",
                  "`.txt`"
                ],
                [
                  "`p.parent`",
                  "data"
                ]
              ]
            },
            {
              "type": "heading",
              "text": "2. Read, Write, Search",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "`read_text` and `write_text` replace `open` for ==small files==",
                "Pass `encoding='utf-8'` every time",
                "`mkdir(parents=True, exist_ok=True)` makes nested folders",
                "`glob` searches one folder; `rglob` recurses into subfolders"
              ],
              "style": "check"
            },
            {
              "type": "code",
              "lang": "python",
              "lines": [
                "p = Path('data') / 'in.txt'",
                "p.parent.mkdir(parents=True, exist_ok=True)",
                "p.write_text('hi', encoding='utf-8')",
                "s = p.read_text(encoding='utf-8')",
                "here = Path('.')",
                "list(here.glob('*.py'))",
                "list(here.rglob('*.py'))"
              ],
              "note": "glob and rglob return iterators"
            },
            {
              "type": "heading",
              "text": "3. pathlib vs os.path",
              "ink": "purple"
            },
            {
              "type": "table",
              "headers": [
                "",
                "pathlib",
                "os.path"
              ],
              "rows": [
                [
                  "Type",
                  "`Path` object",
                  "plain **str**"
                ],
                [
                  "Style",
                  "methods",
                  "functions"
                ],
                [
                  "Join",
                  "`a / b`",
                  "`os.path.join(a, b)`"
                ],
                [
                  "Anchor",
                  "`Path.cwd()`, `Path(__file__).parent`",
                  "`os.getcwd()`"
                ]
              ]
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Anchor your paths",
              "text": "A relative path depends on the ==current directory==. Build from `Path(__file__).parent` so it works from anywhere."
