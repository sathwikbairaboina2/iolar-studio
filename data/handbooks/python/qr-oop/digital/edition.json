    {
      "title": "Dataclasses and Abstract Base Classes",
      "role": "outline",
      "outlineIndex": 4,
      "pages": [
        {
          "title": "Dataclasses and Abstract Base Classes",
          "blocks": [
            {
              "type": "heading",
              "text": "1. Dataclasses",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "`@dataclass` writes ==`__init__`==, ==`__repr__`== and ==`__eq__`== from annotated fields",
                "Mutable default `tags: list = []` → {red:ValueError}; use `field(default_factory=list)`",
                "A field with a default must come after those without, else {red:TypeError}",
                "`frozen=True`: immutable and hashable; `order=True`: adds `<` `>`; `__post_init__` runs after `__init__`"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "code",
              "lang": "python",
              "lines": [
                "from dataclasses import dataclass, field",
                "@dataclass",
                "class P:",
                "    x: int",
                "    y: int = 0",
                "    tags: list = field(default_factory=list)",
                "print(P(1))",
                "print(P(1) == P(1))"
              ],
              "note": "each instance gets its own list"
            },
            {
              "type": "code",
              "lang": "output",
              "lines": [
                "P(x=1, y=0, tags=[])",
                "True"
              ]
            },
            {
              "type": "heading",
              "text": "2. Abstract Base Classes",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "`class Shape(ABC)` with `@abstractmethod`: a subclass must override ==every== abstract method",
                "Otherwise {red:TypeError} when you instantiate it"
              ],
              "style": "dot"
            },
            {
              "type": "table",
              "headers": [
                "",
                "ABC",
                "Plain base"
              ],
              "rows": [
                [
                  "Checked",
                  "at **instantiation**",
                  "only when **called**"
                ],
                [
                  "Error",
                  "`TypeError`",
                  "`NotImplementedError`"
                ]
              ],
              "frame": "dashed"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Interview Point",
              "text": "**frozen=True?** Immutable and hashable. **default_factory?** Fresh list per instance. **ABC vs plain base?** ABC fails early, at instantiation."
            }
          ]
        }
      ]
