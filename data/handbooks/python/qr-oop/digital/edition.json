          "title": "Dunder Methods and Properties",
          "blocks": [
            {
              "type": "heading",
              "text": "1. repr, str, eq, hash",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "`__repr__` = for ==developers==: unambiguous, ideally eval-able",
                "`__str__` = for **users**; `print` falls back to `__repr__` if missing",
                "`__eq__` defines `==`",
                "{red:`__eq__` without `__hash__`} sets `__hash__` to None: instances become unhashable"
              ],
              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "heading",
              "text": "2. Dunders as Behaviour",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "Dunder",
                "Enables"
              ],
              "rows": [
                [
                  "`__len__`",
                  "`len(x)`"
                ],
                [
                  "`__getitem__`",
                  "`x[i]`"
                ],
                [
                  "`__iter__`",
                  "`for a in x`"
                ],
                [
                  "`__contains__`",
                  "`a in x`"
                ],
                [
                  "`__call__`",
                  "`x()` like a function"
                ],
                [
                  "`__add__`",
                  "`a + b`"
                ],
                [
                  "`__lt__`",
                  "`a < b`"
                ]
              ],
              "frame": "dashed"
            },
            {
              "type": "heading",
              "text": "3. Properties",
              "ink": "purple"
            },
            {
              "type": "bullets",
              "items": [
                "`@property` turns a method into ==read-only== attribute access",
                "`@x.setter` validates on assignment",
                "Call site: `c.x` and `c.x = 5`, with ==no ()=="
              ],
              "style": "check"
            },
            {
              "type": "code",
              "lang": "python",
              "lines": [
                "class C:",
                "    @property",
                "    def x(self): return self._x",
                "    @x.setter",
                "    def x(self, v):",
                "        if v < 0: raise ValueError",
                "        self._x = v"
              ],
              "note": "store into the private name _x"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Setter recursion",
              "text": "Write `self._x = v`. Writing `self.x = v` inside the setter calls the setter again: ==infinite recursion==."
            }
          ]
        }
      ]
