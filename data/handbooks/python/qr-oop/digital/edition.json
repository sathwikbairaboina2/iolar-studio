          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "What does `print(b.items)` show?",
              "a_bullets": [
                "`[1]`: the list lives on the class, shared by all instances",
                "Fix: `self.items = []` in `__init__`"
              ],
              "example_code": [
                "class Bag:",
                "    items = []",
                "a, b = Bag(), Bag()",
                "a.items.append(1)",
                "print(b.items)"
              ]
            },
            {
              "type": "qa",
              "q": "Why does assigning `t.x = 5` crash?",
              "a_bullets": [
                "`RecursionError`: `self.x = v` calls the setter again",
                "Store in `self._x` instead"
              ],
              "example_code": [
                "@x.setter",
                "def x(self, v):",
                "    self.x = v"
              ]
            },
            {
              "type": "qa",
              "q": "What does `D().hi()` print?",
              "a_bullets": [
                "`D B C A`, one per line",
                "`super()` follows the MRO of D, not just the parent",
                "B's `super()` reaches C, not A"
              ],
              "example_code": [
                "class A:",
                "    def hi(self): print('A')",
                "class B(A):",
                "    def hi(self): print('B'); super().hi()",
                "class C(A):",
                "    def hi(self): print('C'); super().hi()",
                "class D(B, C):",
                "    def hi(self): print('D'); super().hi()",
                "D().hi()"
              ]
            }
          ]
