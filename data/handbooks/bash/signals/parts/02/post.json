              "EXIT trap",
              "reset"
            ],
            [
              "ERR + `set -E`",
              "inherited"
            ]
          ]
        },
        {
          "type": "callout",
          "style": "takeaway",
          "title": "Why $(...) Feels Broken",
          "text": "A trap set inside command substitution dies with that subshell, and the parent's EXIT trap does not run when a subshell exits."
        },
        {
          "type": "heading",
          "text": "Group Without Forking"
        },
        {
          "type": "table",
          "headers": [
            "Construct",
            "Forks?",
            "Parent sees"
          ],
          "rows": [
            [
              "`( cmd )`",
              "yes",
              "nothing"
            ],
            [
              "`{ cmd; }`",
              "**no**",
              "vars + traps"
            ],
            [
              "`$( cmd )`",
              "yes",
              "stdout only"
            ],
            [
              "`cmd &`",
              "yes",
              "`$!` only"
            ],
            [
              "`a | b`",
              "both",
              "nothing"
            ]
          ]
        },
        {
          "type": "heading",
          "text": "Portability Warning",
          "ink": "red"
        },
        {
          "type": "bullets",
          "items": [
            "ERR is a bash ==pseudo-signal==, not POSIX",
            "`dash` and `sh` ignore it silently — no warning",
            "So the shebang must be `#!/usr/bin/env bash`"
          ]
        },
        {
          "type": "heading",
          "text": "Strict Mode, Flag By Flag"
        },
        {
          "type": "table",
          "headers": [
            "Flag",
            "Turns on",
            "Bites when"
          ],
          "rows": [
            [
              "`-e`",
              "exit on error",
              "status is data"
            ],
            [
              "`-u`",
              "unset is fatal",
              "`$1` optional"
            ],
            [
              "`-o pipefail`",
              "pipe fails loud",
              "`grep` finds none"
            ],
            [
              "`-E`",
              "ERR inherits",
              "never"
            ]
          ]
        },
        {
          "type": "heading",
          "text": "Where set -e Lies"
        },
        {
          "type": "bullets",
          "items": [
            "Skipped inside `if`, `while`, `&&`, `||`, and after `!`",
            "A function called in a test context loses it entirely",
            "So `if big_fn; then` disarms it for the whole call tree",
            "Never ship `-e` as your only error handling"
          ],
          "style": "cross"
        },
        {
          "type": "code",
          "lang": "bash",
          "lines": [
            "set -o pipefail",
            "curl -s \"$url\" | jq .id",
            "rc=${PIPESTATUS[0]}  # curl's"
          ],
          "note": "read it before the next command"
        },
        {
          "type": "callout",
          "style": "tip",
          "title": "Functions Lose ERR",
          "text": "Without `set -E`, a failure inside a function, `$(...)` or subshell never fires your ERR trap — diagnostics vanish exactly where you need them."
        }
      ]
    },
    {
      "page_title": "Subshells: Where Traps Vanish",
      "blocks": [
        {
          "type": "heading",
          "text": "Inheritance Switches"
        },
        {
          "type": "bullets",
          "items": [
            "`set -E` (errtrace): ERR reaches functions, `$()`, subshells",
            "`set -T` (functrace): same for DEBUG and RETURN",
            "Neither switch exists for EXIT — it always resets"
          ]
        },
        {
          "type": "heading",
          "text": "Pipelines And Background"
        },
        {
          "type": "bullets",
          "items": [
            "Each pipeline element runs in its own subshell",
            "So `while read` in a pipe sets neither parent vars nor traps",
            "Unless `lastpipe` is on with job control off",
            "`cmd &` sets INT and QUIT to ignore without job control"
          ]
        },
        {
          "type": "sidebox",
          "title": "Background Survives Ctrl-C",
          "items": [
            "Ignored signals stay ignored across the fork",
            "So a background child can outlive your interrupt",
            "Track its PID and kill it from cleanup explicitly"
          ],
          "ink": "red"
        },
        {
          "type": "heading",
          "text": "Identity And Scope"
        },
        {
          "type": "code",
          "lang": "bash",
          "lines": [
            "echo $$ $BASHPID       # equal here",
            "( echo $$ $BASHPID )   # $$ unchanged!",
            "( trap 'rm -f \"$f\"' EXIT; work )  # scoped"
          ]
        },
        {
          "type": "bullets",
          "items": [
            "`$$` stays the parent PID inside a subshell",
            "Use `$BASHPID` to signal the actual current shell",
            "`exec cmd` replaces the image: no EXIT trap, no handlers",
            "A sourced file shares your trap table and can hijack EXIT"
          ]
        },
        {
          "type": "table",
          "headers": [
            "Feature",
            "Scope"
          ],
          "rows": [
            [
              "`set -e`",
              "shell + subshells"
            ],
            [
              "ERR trap",
              "this shell only"
            ],
            [
              "ERR + `set -E`",
              "shell + subshells"
            ]
          ]
        },
        {
          "type": "heading",
          "text": "Four That Bite Everyone",
          "ink": "red"
        },
        {
          "type": "table",
          "headers": [
            "Wrong",
            "Result",
            "Right"
          ],
          "rows": [
            [
              "trap before create",
              "unset var",
              "trap right after"
            ],
            [
              "`\"rm $tmp\"`",
              "frozen value",
              "single quotes"
            ],
            [
              "`rm -rf $tmpdir/*`",
              "wipes `/*`",
              "quote + guard"
            ],
            [
              "INT without re-raise",
              "reports 0",
              "`kill -INT $$`"
            ]
          ]
        },
        {
          "type": "bullets",
          "items": [
            "A failure between create and trap leaks the resource",
            "Double quotes expand at definition, before the value exists",
            "Empty `$tmpdir` plus `/*` expands to a root-level wipe",
            "Never rely on EXIT alone — `kill -9`, power loss, `exec` bypass it"
          ]
        }
      ]
    },
    {
      "page_title": "Trade-offs, Costs, and Failure Modes",
      "blocks": [
        {
          "type": "heading",
          "text": "Silent Teardown Failures"
        },
        {
          "type": "bullets",
          "items": [
            "A second `trap ... EXIT` silently overwrites the first",
            "One handler slot per signal — compose into one function",
            "Cleanup that fails under `set -e` skips the rest quietly",
            "Expensive work in a handler invites re-entry mid-run"
          ]
        },
        {
          "type": "callout",
          "style": "tip",
          "title": "Startup Sweep",
          "text": "Because SIGKILL leaves temp dirs behind, delete stale ones matching your `mktemp` template at launch. It is the only cure for uncatchable death."
        },
        {
          "type": "heading",
          "text": "Choosing Your Machinery"
        },
        {
          "type": "diagram",
          "kind": "cards",
          "spec": {
            "cards": [
              {
                "title": "single cleanup",
                "lines": [
                  "one function",
                  "trivial to read",
                  "not composable",
                  "edit for each resource"
                ]
              },
              {
                "title": "cleanup stack",
                "lines": [
                  "array of commands",
                  "pops in reverse",
                  "libraries can push",
                  "more machinery"
                ]
              }
            ]
          }
        },
        {
          "type": "heading",
          "text": "Costs Worth Naming"
        },
        {
          "type": "bullets",
          "items": [
            "Group kill is thorough but can hit the launching shell",
            "Only safe once you are group leader via `set -m`",
            "`set -euo pipefail` breaks scripts using non-zero as data",
            "Retrofit it one file at a time, not repo-wide"
          ]
        },
        {
          "type": "heading",
          "text": "Re-entrancy And Races"
        },
        {
          "type": "bullets",
          "items": [
            "A signal during cleanup can re-enter cleanup",
            "Disarm first: `trap - EXIT INT TERM` on entry",
            "Between `mktemp` and `trap` sits a microsecond leak window",
            "Small but real — the startup sweep covers it"
          ]
        },
        {
          "type": "sidebox",
          "title": "Tracing What Ran",
          "items": [
            "`set -x` inside the handler shows the teardown",
            "`trap 'echo D: $BASH_COMMAND' DEBUG` traces before the failure",
            "Turn both off before shipping — DEBUG is loud"
          ]
        },
        {
          "type": "heading",
          "text": "The Skeleton",
          "ink": "blue"
        },
        {
          "type": "code",
          "lang": "bash",
          "lines": [
            "set -Eeuo pipefail",
            "tmpdir=$(mktemp -d -t iolar.XXXXXX)",
            "trap cleanup EXIT INT TERM HUP",
            "main \"$@\"   # work goes after the trap"
          ]
        }
      ]
    },
    {
      "page_title": "Anatomy of the Cleanup Skeleton",
      "blocks": [
        {
          "type": "diagram",
          "kind": "flow",
          "spec": {
            "nodes": [
              "strict mode",
              "acquire",
              "trap",
              "work",
              "cleanup"
            ]
          }
        },
        {
          "type": "heading",
          "text": "Reading The Skeleton"
        },
        {
          "type": "bullets",
          "items": [
            "Order is the lesson: strict mode before anything runs",
            "Acquire, then trap on the **next** line — not later",
            "Work only starts once the safety net exists",
            "Cleanup then fires from any step, win or lose"
          ],
          "style": "number"
        },
        {
          "type": "code",
          "lang": "bash",
          "lines": [
            "cleanup() {",
            "  local rc=$?",
            "  trap - EXIT INT TERM",
            "  rm -rf -- \"${tmpdir:-}\" || true",
            "  exit \"$rc\"",
            "}"
          ],
          "note": "disarm first, status last"
        },
        {
          "type": "sidebox",
          "title": "Skip One Step",
          "items": [
            "Trap before acquire → handler reads an unset var",
            "Work before trap → the first failure leaks it",
            "No disarm → a signal re-enters cleanup mid-run"
          ],
          "ink": "red"
        }
      ]
    },
    {
      "page_title": "Production Handlers, Reaping & Locks",
      "blocks": [
        {
          "type": "heading",
          "text": "Handler Contract"
        },
        {
          "type": "bullets",
          "items": [
            "Disarm first: `trap - EXIT INT TERM` stops re-entry",
            "Preserve status: `local rc=$?` then `return $rc`",
            "Never let cleanup mask the real failure code",
            "Re-raise every caught signal: `trap - \"$sig\"; kill -\"$sig\" \"$$\"`",
            "Gives ==130== for INT, ==143== for TERM — without it, `main`'s status"
          ]
        },
        {
          "type": "heading",
          "text": "Reaping And Locking"
        },
        {
          "type": "bullets",
          "items": [
            "Collect child PIDs in an array as you spawn them",
            "TERM them all, sleep a grace period, KILL survivors, `wait`",
            "Lock via a file descriptor, not a PID file"
          ]
        },
        {
          "type": "code",
          "lang": "bash",
          "lines": [
            "{ kill -TERM \"${kids[@]}\"",
            "  sleep 2",
            "  kill -KILL \"${kids[@]}\"",
            "  wait \"${kids[@]}\"",
            "} 2>/dev/null"
          ],
          "note": "braces group without forking"
        },
        {
          "type": "code",
          "lang": "bash",
          "lines": [
            "exec 9>/var/lock/my.lock",
            "flock -n 9 || exit 1   # already running",
            "# fd closes on death — even on SIGKILL"
          ]
        },
        {
          "type": "callout",
          "style": "takeaway",
          "title": "Idempotency Rule",
          "text": "Every cleanup action must be safe to run twice and safe when the resource was never created. That single rule kills most trap bugs."
        },
        {
          "type": "heading",
          "text": "Reuse, Don't Reinvent"
        }
      ]
    },
