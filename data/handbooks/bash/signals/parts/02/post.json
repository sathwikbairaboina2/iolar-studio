        },
        {
          "type": "table",
          "headers": [
            "Parent state",
            "Child gets"
          ],
          "rows": [
            [
              "caught (`trap f INT`)",
              "default"
            ],
            [
              "ignored (`trap '' INT`)",
              "still ignored"
            ],
