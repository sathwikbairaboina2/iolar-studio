        {
          "type": "diagram",
          "kind": "cards",
          "spec": {
            "cards": [
              {
                "title": "\"$@\"",
                "lines": [
                  "each param a separate word",
                  "individually quoted",
                  "'hello world' stays one"
                ]
              },
              {
                "title": "\"$*\"",
                "lines": [
                  "all params one word",
                  "joined by `IFS` first char",
