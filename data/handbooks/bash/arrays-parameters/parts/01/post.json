        },
        {
          "type": "sidebox",
          "title": "Dynamic Scoping",
          "items": [
            "callee sees caller's locals",
            "inner reads outer's privates",
            "lookup walks the call chain"
          ]
        },
        {
          "type": "heading",
          "text": "Returning Data"
        },
        {
          "type": "table",
          "headers": [
            "Channel",
            "Carries"
          ],
          "rows": [
            [
              "`return N`",
              "status 0-255"
            ],
            [
              "stdout",
              "data via `$( )`"
            ],
            [
              "caller's var",
              "via nameref"
            ]
          ]
        },
        {
          "type": "code",
          "lang": "bash",
          "lines": [
            "dump() { local v=$(false); echo $?; }",
            "dump   # prints 0 — local masked it",
            "# split: local v; v=$(false)"
          ],
          "runnable": false
        },
        {
          "type": "bullets",
          "items": [
            "pass in: `sum \"${nums[@]}\"`",
            "rebuild: `local -a a=(\"$@\")`",
            "recursion: locals per frame",
            "no tail-calls → depth finite"
          ]
        }
      ]
    },
    {
      "page_title": "Functions, `local` & Variable Scope",
      "blocks": [
        {
          "type": "code",
          "lang": "bash",
          "lines": [
            "fill() { local -n ref=$1; ref=(a b c); }",
            "fill myarr  # myarr=(a b c)",
            "# 4.3+: arrays OUT via nameref"
          ],
          "runnable": false
        },
        {
          "type": "callout",
          "style": "takeaway",
          "title": "The Pipe Trap",
          "text": "`cmd | while read` runs the loop in a subshell — its writes vanish. Keep state with `done < <(cmd)`; `var=$(func)` likewise discards all writes."
        },
        {
          "type": "sidebox",
          "title": "`local` + Attributes",
          "items": [
            "`local -i n=0` integer",
            "`local -a` indexed",
            "`local -A` map",
            "combines like `declare`"
          ]
        },
        {
          "type": "heading",
          "text": "Hall of Bugs",
          "ink": "red"
        },
        {
          "type": "table",
          "headers": [
            "Bug",
            "Fix"
          ],
          "rows": [
            [
              "`arr=\"one two\"`",
              "use parens"
            ],
            [
              "`$arr[i]`",
              "`${arr[i]}`"
            ],
            [
              "`\"$*\"` forward",
              "use `$@`"
            ],
            [
              "`d[k]=v` no -A",
              "`declare -A` first"
            ],
            [
              "`${var:-4}` slice",
              "space: `${var: -4}`"
            ]
          ]
        },
        {
          "type": "code",
          "lang": "bash",
          "lines": [
            "arr=\"one two\"    # a string!",
            "arr=(one two)    # an array",
            "echo ${#arr[@]}  # 2 — parens won"
          ],
          "runnable": false
        },
        {
          "type": "bullets",
          "items": [
            "unquoted `$@` / `${arr[@]}`",
            "re-splits on `IFS`, expands globs",
            "'hello world' becomes two args"
          ]
        },
        {
          "type": "bullets",
          "items": [
            "`d[key]=v` without `-A` → indexed",
            "key read as arithmetic",
            "lands on `0` unless numeric var"
          ]
        },
        {
          "type": "diagram",
          "kind": "cards",
          "spec": {
            "cards": [
              {
                "title": "arr=()",
                "lines": [
                  "empties the array",
                  "keeps its type"
                ]
              },
              {
                "title": "unset arr",
                "lines": [
                  "destroys variable",
                  "drops `-A` attribute"
                ]
              }
            ]
          }
        },
        {
          "type": "sidebox",
          "title": "Subshell Traps",
          "items": [
            "pipes into `while` lose counters",
            "`$(...)` loses writes",
            "keep state: `done < <(cmd)`"
          ]
        },
        {
          "type": "bullets",
          "items": [
            "`\"${!caps[@]}\"` = hash order",
            "sort it or keep a key array",
            "`:-` vs `-`: is empty missing?"
          ]
        },
        {
          "type": "heading",
          "text": "Field Checklist"
        },
        {
          "type": "bullets",
          "items": [
            "quote every expansion",
            "`declare -A` before use",
            "`${ }` over sed/awk in loops",
            "`local` in every function"
          ]
        },
        {
          "type": "bullets",
          "items": [
            "`mapfile` / `while read`, not `$(cat)`",
            "develop with `set -u`",
            "run `shellcheck` before shipping"
          ]
        },
        {
          "type": "qa",
          "q": "Why never `for x in $(cat file)`?",
          "a_bullets": [
            "splits on every whitespace run",
            "globs inside lines expand",
            "use `mapfile` or `while read`"
          ]
        },
        {
          "type": "callout",
          "style": "takeaway",
          "title": "Three Habits",
          "text": "Parentheses make arrays, quotes keep words, braces reach elements. Those three prevent most bugs on this page."
        }
