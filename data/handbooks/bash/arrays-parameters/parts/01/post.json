                "title": "\"${arr[@]}\"",
                "lines": [
                  "each element its own word",
                  "'Ada Lovelace' stays intact",
                  "safe in loops"
                ]
              },
              {
                "title": "\"${arr[*]}\"",
                "lines": [
                  "one single word",
                  "joined by first `IFS` char",
                  "display / join only"
