        },
        {
          "type": "heading",
          "text": "Writing Elements"
        },
        {
          "type": "bullets",
          "items": [
            "`arr[3]=x` sets one slot",
            "subscript is arithmetic: `arr[i+1]=y`",
            "negative from end: `arr[-1]` (4.3+)",
            "append: `arr+=(orange)`"
          ]
        },
        {
          "type": "code",
          "lang": "bash",
          "lines": [
            "arr=(a b)",
            "arr+=(c)             # append",
            "arr+=(\"${other[@]}\") # merge"
          ],
          "runnable": false
        },
        {
          "type": "table",
          "headers": [
            "Operation",
            "Effect"
          ],
          "rows": [
            [
              "`arr=(a b)`",
              "replaces all"
            ],
            [
              "`arr[3]=x`",
              "sets slot"
            ],
            [
              "`arr+=(x)`",
              "appends"
            ],
            [
              "`unset arr[1]`",
              "leaves hole"
            ],
            [
              "`unset arr`",
              "kills variable"
            ]
          ]
        },
        {
          "type": "sidebox",
          "title": "Sparse Is Normal",
          "items": [
            "`arr[1000]=x` → count is 1",
            "holes cost nothing",
            "never auto-filled"
          ]
        },
        {
          "type": "heading",
          "text": "Elements Are Strings"
        },
        {
          "type": "bullets",
          "items": [
            "`nums=(42 3.14 hello)` stores text",
            "no numeric coercion at storage",
            "quote people: `\"Ada Lovelace\"`"
          ]
        },
        {
          "type": "code",
          "lang": "bash",
          "lines": [
            "crew=(\"Ada Lovelace\" \"Grace Hopper\")",
            "echo ${#crew[@]}  # stays 2 people"
          ],
          "runnable": false
        },
        {
          "type": "callout",
          "style": "takeaway",
          "title": "Replace vs Append",
          "text": "`arr=(a b)` discards every previous element; `arr+=` never renumbers existing slots."
        },
        {
          "type": "qa",
          "q": "`arr[1000]=x` — how many elements now?",
          "a_bullets": [
            "one — indices stay sparse",
            "`unset arr[1]` leaves a hole",
            "`${#arr[@]}` counts set slots only"
          ]
        },
        {
          "type": "heading",
          "text": "Read One Element",
          "ink": "blue"
        },
        {
          "type": "code",
          "lang": "bash",
          "lines": [
            "echo \"${arr[i]}\"   # element i",
            "echo \"$arr[i]\"     # $arr + \"[i]\"",
            "echo \"${#arr[@]}\"  # sparse-aware"
          ],
          "runnable": false
        },
        {
          "type": "bullets",
          "items": [
            "`${#arr[i]}` = length of element i",
            "`\"${!arr[@]}\"` lists subscripts",
            "ascending numeric order — hole-proof"
          ]
        },
