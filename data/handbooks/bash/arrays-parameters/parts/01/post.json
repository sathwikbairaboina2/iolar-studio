                "b2"
              ],
              [
                "c0_0"
              ],
              [
                "c1_0"
              ],
              [
                "c2_0"
              ]
            ],
            "nodes": {
              "n0": {
                "text": "Scope",
                "shape": "diamond"
              },
              "b0": {
                "text": "global"
              },
              "b1": {
                "text": "function"
              },
              "b2": {
