                  "persists for later lines"
                ]
              }
            ]
          }
        },
        {
          "type": "code",
          "lang": "bash",
          "lines": [
            ": \"${1:?need a file}\"  # assert",
            "out=${1:-output.txt}   # fallback",
            "dir=\"${1:-./my folder}\" # quoted"
          ],
          "runnable": false
        }
      ]
    },
    {
      "page_title": "Parameter Expansion I: Defaults & Alternates",
      "blocks": [
        {
          "type": "sidebox",
          "title": "State Surprises",
          "items": [
            "`:-` never mutates",
            "`:=` writes back",
            "wrong pick = spooky state"
          ]
        },
        {
          "type": "heading",
          "text": "Chain Fallbacks"
        },
        {
          "type": "code",
          "lang": "bash",
          "lines": [
            "A=\"\"; B=try",
            "v=${A:-${B:-fallback}}",
            "echo \"$v\"   # try"
          ],
          "runnable": true
        },
        {
          "type": "qa",
          "q": "Script needs a file arg — safest guard?",
          "a_bullets": [
            "assert required input early",
            "prints msg to stderr",
            "aborts before any work runs"
          ],
          "example_code": [
            ": \"${1:?need a file}\""
          ]
        },
        {
          "type": "heading",
          "text": "Trim Operators",
          "ink": "green"
        },
        {
          "type": "table",
          "headers": [
            "Op",
            "Side",
            "Length"
          ],
          "rows": [
            [
              "`${v#p}`",
              "front",
              "shortest"
            ],
            [
              "`${v##p}`",
              "front",
              "longest"
            ],
            [
              "`${v%p}`",
              "end",
              "shortest"
            ],
            [
              "`${v%%p}`",
              "end",
              "longest"
            ]
          ]
        },
        {
          "type": "callout",
          "style": "tip",
          "title": "Mnemonic",
          "text": "`#` comments the front, so it trims the front; `%` ends the line, so it trims the end. Doubled sign = longest match."
        },
        {
          "type": "code",
          "lang": "bash",
          "lines": [
            "path=/etc/nginx/app.conf",
            "file=${path##*/}  # app.conf",
            "dir=${path%/*}    # /etc/nginx"
          ],
          "runnable": false
        },
        {
          "type": "diagram",
          "kind": "flow",
          "spec": {
            "nodes": [
              "`$path`",
              "`${path##*/}`",
              "app.conf"
            ]
          }
        },
        {
          "type": "code",
          "lang": "bash",
          "lines": [
            "file=archive.tar.gz",
            "name=${file%.*}   # archive.tar",
            "ext=${file##*.}   # gz"
          ],
          "runnable": false
        },
        {
          "type": "bullets",
          "items": [
            "patterns are globs: `*` `?` `[abc]`",
            "no regex, no capture groups",
            "no alternation either",
            "no match → value returned untouched"
          ]
        },
        {
          "type": "heading",
          "text": "Replace"
        },
        {
          "type": "table",
          "headers": [
            "Op",
            "Scope"
          ],
          "rows": [
            [
              "`${v/o/n}`",
              "first only"
            ],
            [
              "`${v//o/n}`",
              "every one"
            ],
            [
              "`${v/#o/n}`",
              "pinned to start"
            ],
            [
              "`${v/%o/n}`",
              "pinned to end"
            ]
          ]
        },
        {
          "type": "code",
          "lang": "bash",
          "lines": [
            "dash=${var//-/}     # drop dashes",
            "slug=${var// /_}    # spaces to _",
            "one=${var/old/new}  # first only"
          ],
          "runnable": false
        },
        {
          "type": "sidebox",
          "title": "Versus External Tools",
          "items": [
            "`sed`/`awk`/`tr`/`cut` fork a process",
            "expansions run in-process",
            "loops: ms vs µs"
          ]
        },
        {
          "type": "qa",
          "q": "Strip the last extension — or keep just it?",
          "a_bullets": [
            "`${file%.*}` drops the last ext",
            "`${file##*.}` keeps only `gz`",
            "no match → original, safe to chain"
          ]
        },
        {
          "type": "heading",
          "text": "Substring Slices",
          "ink": "blue"
        },
        {
          "type": "code",
          "lang": "bash",
          "lines": [
            "s=abcdef",
            "echo ${s:0:3}   # abc",
            "echo ${s: -4}   # def (space!)",
            "echo ${s:2:-3}  # cd  (4.2+)"
          ],
          "runnable": true
        }
      ]
    },
    {
      "page_title": "Substrings, Indirection & the Cost Model",
      "blocks": [
        {
          "type": "sidebox",
          "title": "The -4 Trap",
          "items": [
            "`${var:-4}` = default operator",
            "`${var: -4}` = last 4 chars",
            "`${var:(-4)}` also works",
            "negative length: Bash 4.2+"
          ]
        },
        {
          "type": "bullets",
          "items": [
            "omit length → runs to end",
            "same operator slices arrays",
            "`\"${arr[@]:1:2}\"`: elems 1 and 2"
          ]
        },
        {
          "type": "heading",
          "text": "Indirection"
        },
        {
          "type": "code",
          "lang": "bash",
          "lines": [
            "n=color; color=blue",
            "echo ${!n}   # blue",
            "# value of n used as a NAME"
          ],
          "runnable": false
        },
        {
          "type": "bullets",
          "items": [
            "replaces most `eval` uses",
            "no double parsing",
            "no injection surface",
            "`\"${!prefix@}\"` lists var names"
          ]
        },
        {
          "type": "heading",
          "text": "Arithmetic Contexts"
        },
        {
          "type": "code",
          "lang": "bash",
          "lines": [
            "echo ${arr[i+1]}   # subscript math",
            "echo ${s:i*2:4}    # offset math",
            "# no extra $(( )) wrapping needed"
          ],
          "runnable": false
        },
        {
          "type": "callout",
          "style": "takeaway",
          "title": "No Nesting",
          "text": "`${${v#a}/x/y}` is a syntax error. Assign an intermediate: `t=${v#a}` then `${t/x/y}`."
        },
        {
          "type": "heading",
          "text": "Cost Model"
        },
        {
          "type": "diagram",
          "kind": "cards",
          "spec": {
            "cards": [
              {
                "title": "built-in ${ }",
                "lines": [
                  "in-process",
                  "microseconds",
                  "loop-friendly"
                ]
              },
              {
                "title": "sed / cut forks",
                "lines": [
                  "one process each",
                  "milliseconds",
                  "slow inside loops"
                ]
              }
            ]
          }
        },
        {
          "type": "paragraph",
          "text": "Inside loops, prefer built-ins. A fork costs roughly a thousand expansions."
        },
        {
          "type": "heading",
          "text": "Define & Call",
          "ink": "red"
        },
        {
          "type": "code",
          "lang": "bash",
          "lines": [
            "greet() { echo \"hi, $1\"; }",
            "greet world   # hi, world",
            "# POSIX-style def, called bare"
          ],
          "runnable": false
        },
        {
          "type": "bullets",
          "items": [
            "no `local`: writes overwrite globals",
            "`local x` vanishes at `return`",
            "`local x=0` inits + scopes"
          ]
        },
        {
          "type": "diagram",
          "kind": "flowchart",
          "spec": {
            "title": "Scope",
            "rows": [
              [
                "n0"
