                ]
              }
            ]
          }
        },
        {
          "type": "table",
          "headers": [
            "Form",
            "3 args →",
            "Use for"
          ],
          "rows": [
            [
              "`\"$@\"`",
              "3 words",
              "forwarding"
            ],
            [
              "`\"$*\"`",
              "1 word",
              "display"
            ],
            [
              "bare `$@`/`$*`",
              "re-split",
              "never"
            ]
          ]
        },
        {
          "type": "sidebox",
          "title": "Zero-Arg Edge",
          "items": [
            "`\"$@\"` → zero words",
            "`\"$*\"` → one empty word",
            "visible in loops, `[ ]` tests"
          ]
        },
        {
          "type": "heading",
          "text": "Forwarding Idiom"
        },
        {
          "type": "code",
          "lang": "bash",
          "lines": [
            "wrapper() { realcmd \"$@\"; }",
            "wrapper x \"y z\"   # 2 args arrive",
            "IFS=,; echo \"$*\"  # join: x,y z"
          ],
          "runnable": false
        },
        {
          "type": "heading",
          "text": "Worked Example"
        },
        {
          "type": "paragraph",
          "text": "args = (`\"hello world\"` `b`) — count the words each way:"
