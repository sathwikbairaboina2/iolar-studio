            "# both: split on \\n, keep empties"
          ],
          "runnable": false
        },
        {
          "type": "bullets",
          "items": [
            "`mapfile -t` (Bash 4+) on newlines",
            "strips them, keeps empty lines",
            "`while IFS= read -r` is portable"
          ]
        },
        {
          "type": "sidebox",
          "title": "Empty Array + set -u",
          "items": [
            "`\"${arr[@]}\"` errors pre-4.4",
            "guard: `${arr[@]+\"${arr[@]}\"}`",
            "fails only when array empty"
          ]
        },
        {
          "type": "callout",
          "style": "takeaway",
          "title": "The Unquoted Bug",
          "text": "`for x in ${arr[@]}` re-splits every element on whitespace and expands any globs inside. Quote it, always."
        },
        {
          "type": "heading",
          "text": "Declare First, Always",
          "ink": "red"
        },
        {
          "type": "paragraph",
          "text": "Bash demands `declare -A` before the first assignment. Skip it and `x[key]=v` silently builds an indexed array."
        },
        {
          "type": "code",
          "lang": "bash",
          "lines": [
            "declare -A caps          # FIRST",
            "caps[db]=postgres",
            "caps=( [web]=nginx [db]=postgres )",
            "ages[\"Ada Lovelace\"]=36  # quoted key"
          ],
          "runnable": false
        },
        {
          "type": "bullets",
          "items": [
            "keys are literal — no glob expansion",
            "read: `${caps[db]}`",
            "braces outside, brackets around key",
            "`${#caps[@]}` counts pairs"
          ]
        },
        {
          "type": "diagram",
          "kind": "cards",
          "spec": {
            "cards": [
              {
                "title": "Indexed -a",
                "lines": [
                  "ordered `0..n`",
                  "slices cleanly",
                  "integer subscripts"
                ]
              },
              {
                "title": "Associative -A",
                "lines": [
                  "named string keys",
                  "O(1) lookup",
                  "no order, no slicing"
                ]
              }
            ]
          }
        },
        {
          "type": "heading",
          "text": "Keys & Order"
        },
        {
          "type": "bullets",
          "items": [
            "`\"${!caps[@]}\"` lists keys",
            "hash order — never insertion",
            "sort for stable output"
          ]
        },
        {
          "type": "code",
          "lang": "bash",
          "lines": [
            "for k in \"${!caps[@]}\"; do",
