          ],
          "runnable": false
        },
        {
          "type": "sidebox",
          "title": "The Missing -A Trap",
          "items": [
            "`x[key]=v` without `-A`",
            "key evaluated as arithmetic",
            "lands on index `0`",
            "unless key names a numeric var"
          ]
        },
        {
          "type": "bullets",
          "items": [
            "one pair: `unset caps[db]`",
            "whole map: `unset caps`",
            "empty map: `caps=()` keeps `-A`"
          ]
        },
        {
          "type": "callout",
          "style": "takeaway",
          "title": "Replace the case-chain",
          "text": "Use maps as lookup tables — option flags, host-to-ip maps, grouping records by field. Named, constant-time, no if-ladder."
        },
        {
          "type": "heading",
          "text": "Positionals 101",
          "ink": "accent"
        },
        {
          "type": "bullets",
          "items": [
            "`$1`..`$9` direct; `${10}` beyond",
            "`$10` = `${1}` glued to `0`",
            "`$0` is the script name",
            "`$#` is the argument count"
          ]
        }
      ]
    },
    {
      "page_title": "Positional Parameters & the `$@` vs `$*` Split",
      "blocks": [
        {
          "type": "code",
          "lang": "bash",
          "lines": [
