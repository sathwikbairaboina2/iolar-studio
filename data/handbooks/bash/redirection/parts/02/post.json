  "slides": [
    {
      "page_title": "Exit Status, set -e and pipefail",
      "blocks": [
        {
          "type": "code",
          "lang": "bash",
          "lines": [
            "exec > log.txt 2>&1  # log it all",
            "exec 3>&1 > file     # save 1 in 3",
            "exec 1>&3 3>&-      # put it back"
          ]
        },
        {
          "type": "bullets",
          "items": [
            "`exec cmd` **with** a command replaces the shell.",
            "Same PID, no fork — no code after it ever runs.",
            "With no command it only retargets the shell's own fds."
          ]
        },
        {
          "type": "callout",
          "style": "cloud",
          "title": "The Stdin Thief",
          "text": "An `ssh` or `ffmpeg` inside `while read` eats the loop's stdin. Give it `< /dev/null`, or read the loop on `-u 3`."
        },
        {
          "type": "callout",
          "style": "tip",
          "title": "Coarse By Design",
          "text": "Block redirection is fast but blunt — every command inside `{ }` shares the log, so per-stage tagging needs its own redirect."
        },
        {
          "type": "heading",
          "text": "Two-Way With coproc"
        },
        {
          "type": "code",
          "lang": "bash",
          "lines": [
            "coproc BC { bc -l; }",
            "echo '2^10' >&\"${BC[1]}\"",
            "read -r out <&\"${BC[0]}\"",
            "echo \"$out\"   # 1024"
          ],
          "note": "unnamed coproc uses array COPROC"
        },
        {
          "type": "heading",
          "text": "Reading The Exit Status",
          "ink": "blue"
        },
        {
          "type": "table",
          "headers": [
            "Status",
            "Meaning"
          ],
          "rows": [
            [
              "`0`",
              "success"
            ],
            [
              "`1`-`125`",
              "the command failed"
            ],
            [
              "`126` / `127`",
              "not executable / not found"
            ],
            [
              "`128+N`",
              "killed by signal N"
            ],
            [
              "`143`",
              "SIGTERM, i.e. 128+15"
            ]
          ]
        },
        {
          "type": "heading",
          "text": "The Strict Header",
          "ink": "red"
        },
        {
          "type": "code",
          "lang": "bash",
          "lines": [
            "set -euo pipefail",
            "IFS=$'\\n\\t'",
            "# -e stop, -u unset, -o real status"
          ],
          "note": "worth memorizing, line for line"
        }
      ]
    },
    {
      "page_title": "Scope: Blocks, Loops, Functions, exec",
      "blocks": [
        {
          "type": "heading",
          "text": "Scope At A Glance",
          "ink": "green"
        },
        {
          "type": "table",
          "headers": [
            "Form",
            "Redirect covers"
          ],
          "rows": [
            [
              "`{ ...; } > f`",
              "whole block"
            ],
            [
              "`done < f`",
              "whole loop"
            ],
            [
              "`fn() {...} > f`",
              "every call"
            ],
            [
              "`exec > f`",
              "rest of shell"
            ],
            [
              "`exec cmd > f`",
              "replaces the shell"
            ]
          ]
        },
        {
          "type": "heading",
          "text": "exec With No Command",
          "ink": "red"
        },
        {
          "type": "code",
          "lang": "bash",
          "lines": [
            "exec > log.txt 2>&1   # shell itself retargeted",
            "exec 3>&1 > file      # save old stdout in 3",
            "exec 1>&3 3>&-        # restore and close"
          ]
        },
        {
          "type": "bullets",
          "items": [
            "Everything after the bare `exec` is logged.",
            "`exec cmd` WITH a command replaces the shell process.",
            "Same PID, no fork, no code after it ever runs."
          ]
        },
        {
          "type": "heading",
          "text": "Dedicated Read Descriptor"
        },
        {
          "type": "code",
          "lang": "bash",
          "lines": [
            "exec 3< data.txt",
            "read -u 3 line",
            "exec 3<&-"
          ]
        },
        {
          "type": "callout",
          "style": "cloud",
          "title": "The Stdin Thief",
          "text": "`ssh` or `ffmpeg` inside a `while read` loop eats the loop's stdin. Add `< /dev/null` to the inner command, or read the loop from fd 3."
        },
        {
          "type": "code",
          "lang": "bash",
          "lines": [
            "while read -u 3 host; do",
            "  ssh \"$host\" uptime",
            "done 3< hosts.txt"
          ],
          "note": "ssh cannot eat the loop's fd 3"
        },
        {
          "type": "heading",
          "text": "Log And Watch At Once"
        },
        {
          "type": "code",
          "lang": "bash",
          "lines": [
            "exec > >(tee -a run.log) 2>&1",
            "# on screen and on disk from here down"
          ]
        },
        {
          "type": "sidebox",
          "title": "Two-Way Wiring",
          "items": [
            "`coproc` backgrounds a command with both ends wired.",
            "`${COPROC[0]}` reads it, `${COPROC[1]}` writes to it.",
            "Useful for a running conversation with one process."
          ]
        },
        {
          "type": "callout",
          "style": "takeaway",
          "title": "Coarse By Design",
          "text": "Block redirection is cheap but blunt: one failing command inside `{ }` writes to the same log. Per-stage tagging needs separate redirects."
        }
      ]
    },
    {
      "page_title": "Wrong Turns: Order, Quoting and sudo",
      "blocks": [
        {
          "type": "bullets",
          "items": [
            "Duplication copies the CURRENT target, so order rules everything.",
            "`sort f > tmp && mv tmp f` works for tools without `-o`.",
            "Two opens make two independent offsets that overwrite.",
            "Process substitution also keeps the read out of a subshell."
          ]
        },
        {
          "type": "table",
          "headers": [
            "Written",
            "Result",
            "Repair"
          ],
          "rows": [
            [
              "`2>&1 > f`",
              "stderr on tty",
              "`> f 2>&1`"
            ],
            [
              "`sort f > f`",
              "file emptied",
              "`sort -o f f`"
            ],
            [
              "`> f 2> f`",
              "streams clash",
              "`> f 2>&1`"
            ],
            [
              "`echo x \\| read v`",
              "value lost",
              "`read v <<< x`"
            ]
          ]
        },
        {
          "type": "heading",
          "text": "Spacing And Quoting",
          "ink": "red"
        },
        {
          "type": "code",
          "lang": "bash",
          "lines": [
            "cmd 2 > file    # stdout redirected, '2' an argument",
            "cmd > $f        # word-splits on spaces",
            "cmd > \"$f\"      # correct"
          ]
        },
        {
          "type": "bullets",
          "items": [
            "An unquoted heredoc delimiter mangles `$var` and backticks.",
            "Quote it as `<<'EOF'` whenever the body must stay literal.",
            "Trailing whitespace after the terminator: `unexpected end of file`.",
            "`<<-` with space indentation strips nothing — TABs only."
          ]
        },
        {
          "type": "heading",
          "text": "sudo Does Not Own The Redirect",
          "ink": "blue"
        },
        {
          "type": "code",
          "lang": "bash",
          "lines": [
            "sudo echo x > /root/f   # your shell opens it: denied",
            "echo x | sudo tee /root/f   # tee runs as root"
          ]
        },
        {
          "type": "callout",
          "style": "tip",
          "title": "Truncation Comes First",
          "text": "The shell opens `> out.txt` before it even locates the command, so a typo'd name still leaves you an **empty** file."
        },
        {
          "type": "code",
          "lang": "bash",
          "lines": [
            "set -o noclobber",
            "echo x > kept    # refused",
            "echo x >| kept   # forced"
          ],
          "note": "makes every overwrite deliberate"
        },
        {
          "type": "heading",
          "text": "Leaks And Races"
        },
        {
          "type": "heading",
          "text": "Trusting A Quiet Pipeline"
        }
      ]
    },
    {
      "page_title": "Silent Failures: PIPESTATUS and ERR Traps",
      "blocks": [
        {
          "type": "code",
          "lang": "bash",
          "lines": [
            "curl bad | wc -l; echo $?  # 0",
            "set -o pipefail  # now it reports",
            "st=(\"${PIPESTATUS[@]}\")  # next line"
          ],
          "note": "any command in between resets PIPESTATUS"
        },
        {
          "type": "bullets",
          "items": [
            "`set -e` never fires inside `if`, `while`, `&&`, `||` or `!`.",
            "`set -e` alone ignores pipeline failures — add `pipefail`.",
            "`set -u` catches `rm -rf $DIR/` when `DIR` is empty."
          ],
          "style": "cross"
        },
        {
          "type": "heading",
          "text": "pipefail Bites Back",
          "ink": "red"
        },
        {
          "type": "code",
          "lang": "bash",
          "lines": [
            "set -eo pipefail",
            "grep x big.log | head -1  # 141",
            "# head quits -> producer SIGPIPE"
          ],
          "note": "141 is 128 + SIGPIPE"
        },
        {
          "type": "heading",
          "text": "Scoping And Deliberate Failure"
        },
        {
          "type": "code",
          "lang": "bash",
          "lines": [
            "( set -o pipefail; a | b )",
            "risky || true   # swallowed on purpose",
            "trap 'echo died $LINENO' ERR"
          ],
          "note": "needs set -E to reach functions"
        },
        {
          "type": "table",
          "headers": [
            "Setting",
            "What it catches"
          ],
          "rows": [
            [
              "none",
              "nothing, silent wrong results"
            ],
            [
              "`set -e`",
              "a simple command failing"
            ],
            [
              "`+pipefail`",
              "any stage of a pipeline"
            ],
            [
              "`PIPESTATUS`",
              "names the guilty stage"
            ]
          ]
        }
      ]
    },
    {
      "page_title": "The Whole Manual on One Page",
      "blocks": [
        {
          "type": "bullets",
          "items": [
            "Unclosed `exec 3<` leaks fds; long loops hit `EMFILE`.",
            "`>(cmd)` output may be incomplete when the script exits.",
            "Add `wait` before you read what the writer produced."
          ]
        },
        {
          "type": "callout",
          "style": "tip",
          "title": "Portability Check",
          "text": "`cmd &> file` under `#!/bin/sh` is not portable. Write `> file 2>&1` and it runs anywhere."
        },
