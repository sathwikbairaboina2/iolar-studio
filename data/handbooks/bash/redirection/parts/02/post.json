        {
          "type": "qa",
          "q": "Why does a broken pipeline report success?",
          "a_bullets": [
            "`$?` carries only the last stage's status.",
            "Enable `set -o pipefail` or read `PIPESTATUS`.",
            "Reading `PIPESTATUS` after any command shows THAT command."
          ],
          "example_code": [
            "cmd1 | cmd2",
            "st=(\"${PIPESTATUS[@]}\")   # next line, always"
