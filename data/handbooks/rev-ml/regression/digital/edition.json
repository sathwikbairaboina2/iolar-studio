              "style": "dot",
              "frame": "dashed",
              "ink": "green"
            },
            {
              "type": "table",
              "headers": [
                "",
                "L2 (Ridge)",
                "L1 (Lasso)"
              ],
              "rows": [
                [
                  "Penalty",
                  "`λ·Σw²`",
                  "`λ·Σ|w|`"
                ],
                [
                  "Effect",
                  "shrinks smoothly, **rarely** exactly 0",
                  "drives some weights ==exactly 0=="
                ],
                [
                  "Constraint shape",
                  "{blue:circle}: misses the axes",
                  "{orange:diamond}: hits the axes (sparse)"
                ],
                [
                  "Bonus",
                  "none",
                  "built-in ==feature selection=="
                ]
              ],
              "highlightRow": 1
            },
            {
              "type": "heading",
              "text": "2. Tuning λ",
              "ink": "blue"
            },
            {
              "type": "bullets",
              "items": [
                "Larger λ → more ==bias==, less ==variance==",
                "Choose λ by ==cross-validation==",
                "scikit-learn logistic regression uses `C = 1/λ`: small C = strong penalty"
              ],
              "style": "dot"
            },
            {
              "type": "code",
              "lang": "python",
              "lines": [
                "from sklearn.linear_model import Ridge, Lasso, LogisticRegression",
                "Ridge(alpha=1.0)  # L2, alpha = λ",
                "Lasso(alpha=0.1)  # L1",
                "LogisticRegression(C=0.1)  # C = 1/λ"
              ],
              "note": "alpha is λ; C is its inverse"
            },
            {
              "type": "heading",
              "text": "3. Rules and Elastic Net",
              "ink": "purple"
            },
            {
              "type": "sidebox",
              "title": "Before regularizing",
              "items": [
                "==Standardize== features first",
                "**Never** penalize the bias term b"
              ],
              "ink": "purple"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Elastic Net",
              "text": "Mixes ==L1 + L2==. Sparse like L1, and handles **correlated features** better than L1 alone."
            }
          ]
        }
      ]
