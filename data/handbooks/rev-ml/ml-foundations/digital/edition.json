          "blocks": [
            {
              "type": "qa",
              "q": "Train accuracy is 99%, test accuracy 70%. Diagnosis and one fix?",
              "a_bullets": [
                "Overfitting (high variance)",
                "The big train-test gap is the symptom",
                "Regularise, simplify or add data"
              ]
            },
            {
              "type": "qa",
              "q": "Spot the bug: the scaler is fitted before splitting. What breaks?",
              "a_bullets": [
                "Data leakage: test statistics shape the scaler",
                "The score looks better than reality",
                "Fit on train only, or use a Pipeline"
              ],
              "example_code": [
                "scaler = StandardScaler().fit(X)",
                "X_tr, X_te = train_test_split(scaler.transform(X))"
              ]
            },
            {
              "type": "qa",
              "q": "Train error 30%, validation error 31%. Will doubling the data help?",
              "a_bullets": [
                "No: both errors high and close means underfitting (high bias)",
                "Add capacity or better features instead"
              ]
            },
            {
              "type": "qa",
              "q": "Why is random k-fold wrong for daily sales data?",
              "a_bullets": [
                "Future rows land in training folds, so the model peeks ahead",
                "The score is too optimistic",
                "Use TimeSeriesSplit"
              ]
            }
