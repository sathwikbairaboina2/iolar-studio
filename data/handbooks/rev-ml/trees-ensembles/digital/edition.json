    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "A node has 5 positives and 5 negatives (Gini 0.5). A split gives (3,2) and (2,3). What is the gain?",
              "a_bullets": [
                "Each child: 1 - (0.36 + 0.16) = 0.48",
                "Weighted average is also 0.48",
                "Gain = 0.5 - 0.48 = 0.02, a weak split"
              ]
            },
            {
              "type": "qa",
              "q": "A forest keeps improving up to 500 trees, but boosting at 2000 rounds gets worse on validation. Why?",
              "a_bullets": [
                "Forest trees are averaged, so more trees only cut variance",
                "Boosting keeps fitting residuals, so it ends up fitting noise",
                "Fix: lower learning_rate, use early_stopping_rounds"
              ]
            },
            {
              "type": "qa",
              "q": "You bootstrap 1000 rows for one tree. About how many rows are left out, and what are they for?",
              "a_bullets": [
                "Each row is missed with chance (1 - 1/n)^n, about 36.8%",
                "So roughly 368 rows are out-of-bag",
                "They score the tree for free: oob_score=True"
              ]
            }
          ]
        }
      ]
    }
