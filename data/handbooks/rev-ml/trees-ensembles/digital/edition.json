              ],
              "style": "dot"
            },
            {
              "type": "code",
              "lang": "python",
              "lines": [
                "explainer = shap.TreeExplainer(model)",
                "sv = explainer.shap_values(X_test)"
              ],
              "note": "call-site fragment: needs import shap and a fitted tree model"
            },
            {
              "type": "heading",
              "text": "2. Which Model",
              "ink": "purple"
            },
            {
              "type": "table",
              "headers": [
                "Model",
                "Effect",
                "Trait"
              ],
              "rows": [
                [
                  "Single tree",
                  "{red:High variance}",
                  "Interpretable"
                ],
                [
                  "Random forest",
                  "Variance down",
                  "Robust defaults"
                ],
                [
                  "Boosting",
                  "Bias down",
                  "Best accuracy; tune, early stopping"
                ]
              ]
            },
            {
              "type": "heading",
              "text": "3. Formulas",
              "ink": "green"
            },
            {
              "type": "bullets",
              "items": [
                "Gini = `1 - sum(p^2)`",
                "Entropy = `-sum(p log2 p)`",
                "Gain = ==parent== minus **weighted children**",
                "OOB share = ==36.8%== of rows per bootstrap"
              ],
              "style": "check"
            },
            {
              "type": "callout",
              "style": "sticky",
              "title": "Remember",
              "text": "Trust ==permutation== or SHAP over impurity importance when features differ in cardinality."
            }
          ]
        }
      ]
