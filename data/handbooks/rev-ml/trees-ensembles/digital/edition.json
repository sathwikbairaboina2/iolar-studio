              "text": "1. Feature Importance",
              "ink": "blue"
            },
            {
              "type": "table",
              "headers": [
                "Method",
                "How",
                "Data",
                "Catch"
              ],
              "rows": [
                [
                  "`feature_importances_`",
                  "Sums impurity decrease per feature",
                  "{red:Train}",
                  "Biased to high-cardinality"
                ],
                [
                  "Permutation",
                  "Shuffle one feature, measure score drop",
                  "{green:Held-out}",
                  "Fails with correlated features"
