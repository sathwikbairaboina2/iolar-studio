    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "GridSearchCV has 4 values of C, 3 of gamma, cv=5, refit=True. How many model fits happen?",
              "a_bullets": [
                "4 x 3 x 5 = 60 fits during the search",
                "Plus 1 refit of the best config on all training data = 61"
              ]
            },
            {
              "type": "qa",
              "q": "Bug: scaler.fit_transform(X), then cross_val_score(model, X_scaled, y, cv=5). What is wrong?",
              "a_bullets": [
                "The scaler saw every validation fold's rows, so scores come out optimistic",
                "Fix: make_pipeline(StandardScaler(), model) so it refits inside each fold"
              ],
              "example_code": [
                "pipe = make_pipeline(StandardScaler(), model)",
                "cross_val_score(pipe, X, y, cv=5)"
              ]
            },
            {
              "type": "qa",
              "q": "A search reports best_score_=0.91, but nested CV gives 0.86. Which do you report?",
              "a_bullets": [
                "Report 0.86",
                "The 0.91 was picked as the maximum on the same folds that scored it, so it is biased"
              ]
            }
          ]
        }
      ]
