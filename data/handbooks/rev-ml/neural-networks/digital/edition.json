    {
      "title": "Check yourself",
      "role": "quiz",
      "pages": [
        {
          "title": "Check yourself",
          "blocks": [
            {
              "type": "qa",
              "q": "Three dense layers have no activation functions. Why is this no better than one layer?",
              "a_bullets": [
                "Each layer is linear: W x + b",
                "Composing linear maps gives one linear map",
                "A nonlinear activation such as ==ReLU== between layers fixes it"
              ]
            },
            {
              "type": "qa",
              "q": "A loop runs forward, loss, backward, step, but never zero_grad. What goes wrong?",
              "a_bullets": [
                "Gradients ==accumulate== across batches (PyTorch)",
                "Each update uses old plus new gradients, so training is erratic",
                "Zero the gradients before backward"
              ]
            },
            {
              "type": "qa",
              "q": "A dense layer has 4 inputs and 3 outputs. How many parameters?",
              "a_bullets": [
                "Weights: 4 × 3 = 12",
                "Biases: 3",
                "Total ==15==; W is shaped (3, 4)"
              ]
            },
            {
              "type": "qa",
              "q": "The same input gives different predictions on each inference call. Likely cause?",
              "a_bullets": [
                "Dropout is still active",
                "Call `model.eval()` to disable it",
                "Then the full network runs, so output is stable"
              ]
            }
          ]
        }
