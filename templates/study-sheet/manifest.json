{
  "name": "study-sheet",
  "displayName": "Study Sheet",
  "inks": {
    "blue": "#2b4ea8",
    "red": "#c62828",
    "green": "#2e7d32",
    "black": "#222222",
    "accent": "#c62828",
    "purple": "#5b3fa0",
    "orange": "#d97706"
