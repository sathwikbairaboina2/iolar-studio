  "supports": ["heading", "paragraph", "bullets", "sidebox", "table", "code", "diagram", "callout", "qa"],
  "contentSelector": "#content",
  "maxColumns": 2,
  "columnGap": "2.4vw",
  "defaults": { "frame": "dashed" },
  "codeFont": "hand"
}
