{
  "name": "armand",
  "displayName": "Armand Segall",
  "caption": {
    "font": "Inter, 'Segoe UI', system-ui, sans-serif",
    "weight": 800,
    "sizeVh": 1.9,
    "case": "none",
    "fg": "#ffffff",
    "pill": "#000000",
    "pillAlpha": 0.85,
    "radiusVh": 0.9,
    "padVh": [
      0.5,
      1.1
    ],
    "yPct": 84,
    "wordsPerBeat": [
      1,
      3
    ],
    "maxChars": 22
  },
  "pacing": {
    "shotSec": [
      1.5,
      2.6
    ],
    "captionBeatSec": [
      0.4,
      1.1
    ],
    "cutOnWordBoundary": true
  },
  "hook": {
    "layout": "title-over-broll",
    "durationSec": 1.6,
    "titleSizeVh": 6,
    "logoLockup": true
  },
  "shotMix": {
    "talkingHead": 0.35,
    "screen": 0.45,
    "broll": 0.2,
    "anchorEverySec": 10
  },
  "motion": {
    "default": "zoom-in",
    "strength": 0.12
  },
  "transitions": [
    "cut",
    "cut",
    "crossfade"
  ],
  "voice": {
    "rate": 1.0
  },
  "letterbox": {
    "bg": "#ffffff"
  }
}
